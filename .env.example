PORT=3100
NODE_ENV=production
AUTH_PASSPHRASE=change-me-to-something-secure
AUTH_SECRET=replace-with-random-secret-key-min-32-chars
COOKIE_MAX_AGE_HOURS=24

# Default repo for chat sessions (worktrees branch from this)
# Worktree sessions dir is created at ${REPO_PATH}-sessions/
REPO_PATH=/path/to/your/repo

# Worktree isolation (true by default, set to false to disable)
WORKTREE_ENABLED=true

# Stale worktree cleanup is report-only by default. Enabling execute permits
# Git mutation, rescue PR creation, inbox writes, and worktree removal.
MITZO_WORKTREE_CLEANUP_POLICY=report

# ntfy push notifications (optional)
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_AUTH_TOKEN=
BASE_URL=

# ContexGin Goal Registry (optional — tokens-to-goal tracking)
CONTEXGIN_URL=http://localhost:8321

# OpenShell production runtime. See infra/openshell/README.md and merge the
# reviewed values from infra/openshell/production.env.example.
MITZO_OPENSHELL_ENABLED=0
# Work OpenAI API uses OpenShell whenever it is enabled. Set this to 0 only
# as an emergency native-host bypass.
MITZO_OPENSHELL_OPENAI_API_ENABLED=1

# Operator-only Google credential recovery in Connections. Requires the existing
# google-workspace gateway provider and a working host gws sign-in. Secrets are
# imported into encrypted gateway refresh storage; never sent to a chat/browser.
MITZO_GOOGLE_WORKSPACE_MANAGEMENT_ENABLED=false
# Optional executable override (defaults to gws on the controller PATH).
# MITZO_GWS_CLI=/path/to/gws
