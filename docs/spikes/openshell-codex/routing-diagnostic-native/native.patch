+// SPDX-FileCopyrightText: Copyright (c) 2025-2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+// This focused harness can run with rustc --test without allocating a gateway.
+#[path = "routing_diagnostic.rs"]
+mod routing_diagnostic;
+
+use routing_diagnostic::{RoutingCapture, RoutingFailure};
+
+#[test]
+fn exact_account_check_only_and_no_private_values_retained() {
+    let capture = RoutingCapture::new(
+        "chatgpt.com",
+        443,
+        "GET",
+        "/backend-api/wham/accounts/check",
+        true,
+    )
+    .unwrap();
+    let event = capture.response(403).unwrap();
+    assert_eq!(event.kind(), "account_check");
+    assert_eq!(event.method(), "GET");
+    assert_eq!(event.outcome(), "response");
+    assert_eq!(event.status_code(), Some(403));
+    assert!(event.ordinal() > 0);
+    let output = format!("{event:?}");
+    for private in [
+        "chatgpt.com",
+        "backend-api",
+        "Authorization",
+        "secret-token",
+        "Cookie",
+    ] {
+        assert!(!output.contains(private));
+    }
+}
+
+#[test]
+fn reject_wrong_host_port_method_path_and_queries_without_an_event() {
+    for (host, port, method, path, no_query) in [
+        (
+            "other.example",
+            443,
+            "GET",
+            "/backend-api/wham/accounts/check",
+            true,
+        ),
+        (
+            "chatgpt.com.evil",
+            443,
+            "GET",
+            "/backend-api/wham/accounts/check",
+            true,
+        ),
+        (
+            "chatgpt.com",
+            80,
+            "GET",
+            "/backend-api/wham/accounts/check",
+            true,
+        ),
+        (
+            "chatgpt.com",
+            443,
+            "POST",
+            "/backend-api/wham/accounts/check",
+            true,
+        ),
+        ("chatgpt.com", 443, "GET", "/backend-api/models", true),
+        (
+            "chatgpt.com",
+            443,
+            "GET",
+            "https://chatgpt.com/backend-api/wham/accounts/check",
+            true,
+        ),
+        (
+            "chatgpt.com",
+            443,
+            "GET",
+            "/backend-api/wham/accounts/check?secret-token",
+            false,
+        ),
+        (
+            "chatgpt.com",
+            443,
+            "GET",
+            "/backend-api/wham/accounts/check",
+            false,
+        ),
+    ] {
+        assert!(RoutingCapture::new(host, port, method, path, no_query).is_none());
+    }
+}
+
+#[test]
+fn response_status_is_bounded_and_each_request_has_one_terminal_event() {
+    for status in [100, 200, 401, 403, 500, 599] {
+        let capture = RoutingCapture::new(
+            "chatgpt.com",
+            443,
+            "GET",
+            "/backend-api/wham/accounts/check",
+            true,
+        )
+        .unwrap();
+        assert_eq!(
+            capture.response(status).unwrap().status_code(),
+            Some(status)
+        );
+        assert!(capture.response(200).is_none());
+        assert!(capture.failure(RoutingFailure::Transport).is_none());
+    }
+    for status in [0, 99, 600, u16::MAX] {
+        let capture = RoutingCapture::new(
+            "chatgpt.com",
+            443,
+            "GET",
+            "/backend-api/wham/accounts/check",
+            true,
+        )
+        .unwrap();
+        assert!(capture.response(status).is_none());
+        assert_eq!(
+            capture
+                .failure(RoutingFailure::MalformedResponse)
+                .unwrap()
+                .outcome(),
+            "malformed_response"
+        );
+    }
+}
+
+#[test]
+fn finite_failure_does_not_accept_or_format_arbitrary_errors() {
+    for (kind, expected) in [
+        (RoutingFailure::Credential, "credential_unavailable"),
+        (RoutingFailure::Transport, "transport_failed"),
+        (RoutingFailure::Relay, "relay_failed"),
+        (RoutingFailure::MalformedResponse, "malformed_response"),
+    ] {
+        let capture = RoutingCapture::new(
+            "chatgpt.com",
+            443,
+            "GET",
+            "/backend-api/wham/accounts/check",
+            true,
+        )
+        .unwrap();
+        let event = capture.failure(kind).unwrap();
+        assert_eq!(event.outcome(), expected);
+        assert_eq!(event.status_code(), None);
+    }
+}
+
+#[test]
+fn distinct_requests_have_distinct_ordinals_and_do_not_share_terminal_state() {
+    let first = RoutingCapture::new(
+        "chatgpt.com",
+        443,
+        "GET",
+        "/backend-api/wham/accounts/check",
+        true,
+    )
+    .unwrap();
+    let second = RoutingCapture::new(
+        "chatgpt.com",
+        443,
+        "GET",
+        "/backend-api/wham/accounts/check",
+        true,
+    )
+    .unwrap();
+    let a = first.response(200).unwrap();
+    let b = second.failure(RoutingFailure::Transport).unwrap();
+    assert_ne!(a.ordinal(), b.ordinal());
+}
+
+#[test]
+fn ordinal_exhaustion_refuses_without_wrap_or_zero() {
+    use std::sync::atomic::{AtomicU64, Ordering};
+    let counter = AtomicU64::new(u64::MAX - 1);
+    assert_eq!(
+        routing_diagnostic::reserve_ordinal(&counter),
+        Some(u64::MAX - 1)
+    );
+    assert_eq!(routing_diagnostic::reserve_ordinal(&counter), None);
+    assert_eq!(counter.load(Ordering::Relaxed), u64::MAX);
+    assert_eq!(
+        routing_diagnostic::reserve_ordinal(&AtomicU64::new(0)),
+        None
+    );
+}
