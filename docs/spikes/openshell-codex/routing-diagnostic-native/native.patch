+// SPDX-FileCopyrightText: Copyright (c) 2025-2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+//! Opt-in account-check diagnostics. No request data survives endpoint recognition.
+
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+
+static NEXT_ORDINAL: AtomicU64 = AtomicU64::new(1);
+
+pub fn reserve_ordinal(counter: &AtomicU64) -> Option<u64> {
+    counter
+        .fetch_update(Ordering::Relaxed, Ordering::Relaxed, |value| {
+            if value == 0 {
+                None
+            } else {
+                value.checked_add(1)
+            }
+        })
+        .ok()
+}
+
+#[derive(Clone, Copy, Debug)]
+pub enum RoutingFailure {
+    Credential,
+    Transport,
+    Relay,
+    MalformedResponse,
+}
+
+impl RoutingFailure {
+    fn name(self) -> &'static str {
+        match self {
+            Self::Credential => "credential_unavailable",
+            Self::Transport => "transport_failed",
+            Self::Relay => "relay_failed",
+            Self::MalformedResponse => "malformed_response",
+        }
+    }
+}
+
+#[derive(Debug)]
+pub struct RoutingEvent {
+    ordinal: u64,
+    kind: &'static str,
+    method: &'static str,
+    outcome: &'static str,
+    status_code: Option<u16>,
+}
+
+impl RoutingEvent {
+    pub fn kind(&self) -> &'static str {
+        self.kind
+    }
+    pub fn method(&self) -> &'static str {
+        self.method
+    }
+    pub fn outcome(&self) -> &'static str {
+        self.outcome
+    }
+    pub fn status_code(&self) -> Option<u16> {
+        self.status_code
+    }
+    pub fn ordinal(&self) -> u64 {
+        self.ordinal
+    }
+}
+
+pub struct RoutingCapture {
+    ordinal: u64,
+    finished: AtomicBool,
+}
+
+impl RoutingCapture {
+    pub fn new(host: &str, port: u16, method: &str, target: &str, no_query: bool) -> Option<Self> {
+        if !host.eq_ignore_ascii_case("chatgpt.com")
+            || port != 443
+            || method != "GET"
+            || target != "/backend-api/wham/accounts/check"
+            || !no_query
+        {
+            return None;
+        }
+        let ordinal = reserve_ordinal(&NEXT_ORDINAL)?;
+        Some(Self {
+            ordinal,
+            finished: AtomicBool::new(false),
+        })
+    }
+
+    pub fn response(&self, status_code: u16) -> Option<RoutingEvent> {
+        if !(100..=599).contains(&status_code) || self.finished.swap(true, Ordering::Relaxed) {
+            return None;
+        }
+        Some(RoutingEvent {
+            ordinal: self.ordinal,
+            kind: "account_check",
+            method: "GET",
+            outcome: "response",
+            status_code: Some(status_code),
+        })
+    }
+
+    pub fn failure(&self, failure: RoutingFailure) -> Option<RoutingEvent> {
+        if self.finished.swap(true, Ordering::Relaxed) {
+            return None;
+        }
+        Some(RoutingEvent {
+            ordinal: self.ordinal,
+            kind: "account_check",
+            method: "GET",
+            outcome: failure.name(),
+            status_code: None,
+        })
+    }
+}
