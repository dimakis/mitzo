+#[tokio::test]
+async fn forced_guardian_and_callback_cancellation_cannot_be_default_user() -> anyhow::Result<()> {
+    for decision in [None, Some(ApprovalDecision::AskUser)] {
+        let (decision, calls) = route(Case {
+            decision,
+            forced_guardian: true,
+            ..Case::default()
+        })
+        .await?;
+        assert!(matches!(
+            decision,
+            ReviewDisposition::Decision(ReviewDecision::Denied { .. })
+        ));
+        assert_eq!(
+            *calls.reviews.lock().await,
+            vec![GuardianReviewReason::Policy]
+        );
+    }
+    let (decision, calls) = route(Case {
+        cancel_in_contributor: true,
+        ..Case::default()
+    })
+    .await?;
+    assert_eq!(decision, ReviewDisposition::Decision(ReviewDecision::Abort));
+    assert!(calls.reviews.lock().await.is_empty());
+    Ok(())
+}
