+#[tokio::test]
+async fn reviewed_and_cached_allow_decisions_preserve_legacy_results() -> anyhow::Result<()> {
+    for decision in [
+        ReviewDecision::Approved,
+        ReviewDecision::denied("contributor denial"),
+        ReviewDecision::Abort,
+    ] {
+        let (actual, calls) = route(Case {
+            decision: Some(ApprovalDecision::Reviewed(decision.clone())),
+            ..Case::default()
+        })
+        .await?;
+        assert_eq!(actual, ReviewDisposition::Decision(decision));
+        assert!(calls.reviews.lock().await.is_empty());
+    }
+    let (decision, calls) = route(Case {
+        decision: Some(ApprovalDecision::Allow),
+        ..Case::default()
+    })
+    .await?;
+    assert_eq!(
+        decision,
+        ReviewDisposition::Decision(ReviewDecision::Approved)
+    );
+    assert_eq!(calls.validations.load(Ordering::SeqCst), 1);
+    assert!(calls.reviews.lock().await.is_empty());
+    Ok(())
+}
