+#[tokio::test]
+async fn declined_contributor_and_explicit_ask_user_remain_distinct() -> anyhow::Result<()> {
+    let (decision, calls) = route(Case::default()).await?;
+    assert_eq!(
+        decision,
+        ReviewDisposition::UserPrompt(UserPromptDisposition::NoContributorDefaultUser {
+            fresh_review_required: false
+        })
+    );
+    assert!(calls.reviews.lock().await.is_empty());
+    for synchronous in [false, true] {
+        let (decision, calls) = route(Case {
+            decision: Some(ApprovalDecision::AskUser),
+            synchronous,
+            ..Case::default()
+        })
+        .await?;
+        assert_eq!(
+            decision,
+            ReviewDisposition::UserPrompt(UserPromptDisposition::ContributorAskUser)
+        );
+        assert!(calls.reviews.lock().await.is_empty());
+    }
+    Ok(())
+}
+
+#[tokio::test]
+async fn default_user_retains_each_existing_fresh_review_input() -> anyhow::Result<()> {
+    for case in [
+        Case {
+            synchronous: true,
+            ..Case::default()
+        },
+        Case {
+            model_required: true,
+            ..Case::default()
+        },
+        Case {
+            retried: true,
+            ..Case::default()
+        },
+        Case {
+            escalated: true,
+            ..Case::default()
+        },
+    ] {
+        let (decision, calls) = route(case).await?;
+        assert_eq!(
+            decision,
+            ReviewDisposition::UserPrompt(UserPromptDisposition::NoContributorDefaultUser {
+                fresh_review_required: true
+            })
+        );
+        assert!(calls.reviews.lock().await.is_empty());
+    }
+    let (decision, calls) = route(Case {
+        model_required: true,
+        async_enabled: true,
+        ..Case::default()
+    })
+    .await?;
+    assert_eq!(
+        decision,
+        ReviewDisposition::UserPrompt(UserPromptDisposition::NoContributorDefaultUser {
+            fresh_review_required: false
+        })
+    );
+    assert!(calls.reviews.lock().await.is_empty());
+    Ok(())
+}
