+#[derive(Default)]
+struct Calls {
+    contributors: AtomicUsize,
+    validations: AtomicUsize,
+    reviews: Mutex<Vec<GuardianReviewReason>>,
+    attempts: AtomicUsize,
+}
+
+struct Host {
+    calls: Arc<Calls>,
+    action: GuardianAssessmentAction,
+}
+
+impl ReviewHost for Host {
+    type Prepared = ();
+    type Evidence = ();
+
+    fn permissions(&self) -> Option<codex_guardian_context::PermissionContext> {
+        None
+    }
+
+    async fn servicing_turn(&self) -> Option<(String, Arc<ModelInfo>)> {
+        None
+    }
+
+    fn validate_action(&self) -> Result<(&str, Option<&str>), ReviewDecision> {
+        self.calls.validations.fetch_add(1, Ordering::SeqCst);
+        Ok(("turn", None))
+    }
+
+    async fn prepare(
+        &self,
+        approval_id: &str,
+        reason: GuardianReviewReason,
+        _deadline: Instant,
+        _cancellation: &CancellationToken,
+    ) -> Result<((), ReviewReport), ReviewDecision> {
+        self.calls.reviews.lock().await.push(reason);
+        Ok((
+            (),
+            ReviewReport::new(ReviewMetadata {
+                thread_id: "thread".into(),
+                turn_id: "turn".into(),
+                review_id: approval_id.into(),
+                target_item_id: None,
+                plugin_id: None,
+                script_path: None,
+                approval_request_source: GuardianApprovalRequestSource::MainTurn,
+                reviewed_action: GuardianReviewedAction::Execve {
+                    source: codex_protocol::approvals::GuardianCommandSource::UnifiedExec,
+                    additional_permissions: None,
+                },
+                action: self.action.clone(),
+                review_reason: reason,
+                model_context: ModelInvocationContext {
+                    model_slug: "routing-test".into(),
+                    reasoning_effort: None,
+                },
+            }),
+        ))
+    }
+
+    async fn attempt(
+        &self,
+        _prepared: &(),
+        _deadline: Instant,
+        _cancellation: &CancellationToken,
+    ) -> (
+        GuardianReviewOutcome,
+        GuardianReviewAnalyticsResult,
+        Option<()>,
+    ) {
+        self.calls.attempts.fetch_add(1, Ordering::SeqCst);
+        (
+            GuardianReviewOutcome::Error(GuardianReviewError::InputBudgetExceeded),
+            GuardianReviewAnalyticsResult::without_session(),
+            None,
+        )
+    }
+
+    async fn emit(&self, _event: EventMsg) {}
+    async fn record_evidence(
+        &self,
+        _prepared: &(),
+        _evidence: (),
+        _event: &GuardianAssessmentEvent,
+    ) {
+    }
+    async fn interrupt(&self, _turn_id: &str, _warning: EventMsg, _error: ErrorEvent) {}
+}
+
+struct Contributor {
+    calls: Arc<Calls>,
+    decision: Option<ApprovalDecision>,
+    cancel: Option<CancellationToken>,
+}
+
+impl ApprovalReviewContributor for Contributor {
+    fn decide<'a>(
+        &'a self,
+        input: &'a ApprovalDecisionInput<'_>,
+    ) -> ExtensionFuture<'a, Option<ApprovalDecision>> {
+        Box::pin(async move {
+            assert_eq!(input.action["program"], "/bin/cat");
+            assert_eq!(input.tool_call_id, None);
+            self.calls.contributors.fetch_add(1, Ordering::SeqCst);
+            if let Some(cancel) = &self.cancel {
+                cancel.cancel();
+            }
+            self.decision.clone()
+        })
+    }
+}
+
+#[derive(Default)]
+struct Case {
+    decision: Option<ApprovalDecision>,
+    synchronous: bool,
+    model_required: bool,
+    async_enabled: bool,
+    retried: bool,
+    escalated: bool,
+    forced_guardian: bool,
+    auto_review: bool,
+    cancel_in_contributor: bool,
+}
+
+enum EntryPoint {
+    Typed,
+    Legacy,
+}
+
+/// Exercises both real entry points with separate registries, without a model session.
+async fn route(case: Case) -> anyhow::Result<(ReviewDisposition, Arc<Calls>)> {
+    let model: ModelInfo = serde_json::from_value(json!({
+        "slug": "routing-test", "display_name": "Routing test",
+        "supported_reasoning_levels": [], "shell_type": "unified_exec",
+        "visibility": "none", "supported_in_api": false, "priority": 0,
+        "support_verbosity": false, "truncation_policy": {"mode": "bytes", "limit": 1000},
+        "experimental_supported_tools": []
+    }))?;
+    let cwd = std::env::current_dir()?;
+    let action = json!({"type": "execve", "source": "unified_exec",
+        "program": "/bin/cat", "argv": ["cat", "secret.env"], "cwd": cwd});
+    let thread_id = ThreadId::new();
+    let telemetry = SessionTelemetry::new(
+        thread_id,
+        "routing-test",
+        "routing-test",
+        /*account_id*/ None,
+        /*account_email*/ None,
+        /*auth_mode*/ None,
+        "routing-test".into(),
+        /*log_user_prompts*/ false,
+        "test".into(),
+        SessionSource::Exec,
+    );
+    let analytics = AnalyticsEventsClient::disabled();
+    let mut typed = None;
+    for entry in [EntryPoint::Typed, EntryPoint::Legacy] {
+        let calls = Arc::new(Calls::default());
+        let cancellation = CancellationToken::new();
+        let mut registry = ExtensionRegistryBuilder::<()>::new();
+        registry.approval_review_contributor(Arc::new(Contributor {
+            calls: Arc::clone(&calls),
+            decision: case.decision.clone(),
+            cancel: case.cancel_in_contributor.then(|| cancellation.clone()),
+        }));
+        let registry = registry.build();
+        let thread_store = ExtensionData::new(thread_id.to_string());
+        let request = ReviewRequest {
+            host: Host {
+                calls: Arc::clone(&calls),
+                action: serde_json::from_value(action.clone())?,
+            },
+            approval_id: "approval",
+            tool_call_id: None,
+            action: Some(&action),
+            thread_id,
+            thread_store: &thread_store,
+            category: GuardianScope::Shell,
+            approval_policy: AskForApproval::OnRequest,
+            approvals_reviewer: if case.auto_review {
+                ApprovalsReviewer::AutoReview
+            } else {
+                ApprovalsReviewer::User
+            },
+            require_guardian: case.forced_guardian,
+            require_synchronous_review: case.synchronous,
+            model_requires_review: case.model_required,
+            async_enabled: case.async_enabled,
+            retried: case.retried,
+            escalated_exec: case.escalated,
+            full_access: false,
+            cancellation,
+            model: &model,
+            telemetry: &telemetry,
+            log_assessments: false,
+            analytics: &analytics,
+            metrics: None,
+        };
+        match entry {
+            EntryPoint::Typed => {
+                typed = Some((
+                    request.decide_with_disposition(&registry).await,
+                    Arc::clone(&calls),
+                ))
+            }
+            EntryPoint::Legacy => {
+                let (disposition, typed_calls) = typed
+                    .as_ref()
+                    .ok_or_else(|| anyhow::anyhow!("typed entry must run first"))?;
+                assert_eq!(
+                    request.decide(&registry).await,
+                    disposition.clone().into_legacy_decision()
+                );
+                assert_eq!(
+                    *calls.reviews.lock().await,
+                    *typed_calls.reviews.lock().await
+                );
+                assert_eq!(
+                    calls.validations.load(Ordering::SeqCst),
+                    typed_calls.validations.load(Ordering::SeqCst)
+                );
+                assert_eq!(
+                    calls.attempts.load(Ordering::SeqCst),
+                    typed_calls.attempts.load(Ordering::SeqCst)
+                );
+            }
+        }
+        assert_eq!(calls.contributors.load(Ordering::SeqCst), 1);
+    }
+    typed.ok_or_else(|| anyhow::anyhow!("typed entry must produce a disposition"))
+}
