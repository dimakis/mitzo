+/// Retains why routing requests the user flow; it does not authorize execution.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum ReviewDisposition {
+    Decision(ReviewDecision),
+    UserPrompt(UserPromptDisposition),
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum UserPromptDisposition {
+    ContributorAskUser,
+    /// Only the actual registry-None, default user-routing arm produces this.
+    NoContributorDefaultUser {
+        fresh_review_required: bool,
+    },
+    ReviewerFallback,
+}
+
+impl ReviewDisposition {
+    /// Preserve the existing host contract: every user prompt projects to `None`.
+    pub fn into_legacy_decision(self) -> Option<ReviewDecision> {
+        match self {
+            Self::Decision(decision) => Some(decision),
+            Self::UserPrompt(_) => None,
+        }
+    }
+
+    fn from_review(decision: Option<ReviewDecision>) -> Self {
+        match decision {
+            Some(decision) => Self::Decision(decision),
+            None => Self::UserPrompt(UserPromptDisposition::ReviewerFallback),
+        }
+    }
+}
