+#[tokio::test]
+async fn review_fallback_is_not_a_declined_contributor() -> anyhow::Result<()> {
+    for (case, reason) in [
+        (
+            Case {
+                auto_review: true,
+                ..Case::default()
+            },
+            GuardianReviewReason::Policy,
+        ),
+        (
+            Case {
+                decision: Some(ApprovalDecision::Allow),
+                synchronous: true,
+                ..Case::default()
+            },
+            GuardianReviewReason::FreshRequired,
+        ),
+    ] {
+        let (decision, calls) = route(case).await?;
+        assert_eq!(
+            decision,
+            ReviewDisposition::UserPrompt(UserPromptDisposition::ReviewerFallback)
+        );
+        assert_eq!(*calls.reviews.lock().await, vec![reason]);
+        assert_eq!(calls.attempts.load(Ordering::SeqCst), 1);
+    }
+    Ok(())
+}
