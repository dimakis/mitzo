+//! Shared ordinary tool-mode selection on immutable resolved data.
+//! Availability is captured by the actual code-mode owner. This enum selects
+//! metadata/fallback only; it does not prove runtime or prepared-request custody.
+
+use crate::config::Config;
+use codex_features::Feature;
+use codex_protocol::openai_models::ModelInfo;
+use codex_protocol::openai_models::ToolMode;
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub(super) enum CodeModeAvailability {
+    Available,
+    Unavailable,
+}
+
+pub(super) fn requested_tool_mode(config: &Config, model_info: &ModelInfo) -> ToolMode {
+    model_info.tool_mode.unwrap_or_else(|| {
+        if config.features.enabled(Feature::CodeModeOnly) {
+            ToolMode::CodeModeOnly
+        } else if config.features.enabled(Feature::CodeMode) {
+            ToolMode::CodeMode
+        } else {
+            ToolMode::Direct
+        }
+    })
+}
+
+pub(super) fn effective_tool_mode(
+    config: &Config,
+    model_info: &ModelInfo,
+    availability: CodeModeAvailability,
+) -> ToolMode {
+    let requested_tool_mode = requested_tool_mode(config, model_info);
+    if availability == CodeModeAvailability::Unavailable
+        && requested_tool_mode == ToolMode::CodeMode
+        && !config.code_mode.disable_in_process_fallback
+    {
+        ToolMode::Direct
+    } else {
+        requested_tool_mode
+    }
+}
