+/// Compares the entire derived launch scope, not just its target or ready-filtered subset.
+#[cfg(unix)]
+fn same_ready_parent_environments(
+    original: &TurnEnvironmentSnapshot,
+    selected: &TurnEnvironmentSnapshot,
+) -> bool {
+    use crate::environment_selection::TurnEnvironmentState;
+    use codex_protocol::protocol::EnvironmentConfigState;
+    !original.environments.is_empty()
+        && original.environments.len() == selected.environments.len()
+        && original
+            .environments
+            .iter()
+            .zip(&selected.environments)
+            .all(|(original, selected)| {
+                let (TurnEnvironmentState::Ready(original), TurnEnvironmentState::Ready(selected)) =
+                    (original, selected)
+                else {
+                    return false;
+                };
+                matches!(original.selection.config, EnvironmentConfigState::Ready(_))
+                    && matches!(selected.selection.config, EnvironmentConfigState::Ready(_))
+                    && original.selection == selected.selection
+                    && original.config_origin == selected.config_origin
+                    && Arc::ptr_eq(&original.environment, &selected.environment)
+                    && original.executor_platform_os == selected.executor_platform_os
+                    && original.user_home_dir == selected.user_home_dir
+                    && original.temporary_directories == selected.temporary_directories
+            })
+}
+
+impl Session {
+    /// Holds existing selected owners through an opaque finish; no runtime/lifetime admission.
+    #[cfg(unix)]
+    #[expect(clippy::too_many_arguments)]
+    #[expect(
+        clippy::await_holding_invalid_type,
+        reason = "retain the actual selected owners together"
+    )]
+    pub(crate) async fn with_current_parent_resolution(
+        self: &Arc<Self>,
+        issuer: &InitialExecApprovalIssuer,
+        original_action: &ApprovalAction,
+        selected: &InterceptedApprovalSelection,
+        used_config: &Arc<Config>,
+        evaluated_policy: &Arc<Policy>,
+        hooks: &crate::hook_runtime::PermissionRequestHookObservation,
+        finish: impl FnOnce() -> Option<crate::tools::ApprovalResolution> + Send,
+    ) -> Option<crate::tools::ApprovalResolution> {
+        let active = self.active_turn.lock().await;
+        let active = active.as_ref()?;
+        let task = active.task.as_ref()?;
+        let session_state = self.state.lock().await;
+        let turn_state = active.turn_state.lock().await;
+        let settings = task.turn_context.next_step_settings.load_full();
+        let config = &session_state
+            .session_configuration
+            .original_config_do_not_use;
+        let ApprovalAction::ExecCommand {
+            id: parent_id,
+            environment_id: parent_env,
+            ..
+        } = original_action
+        else {
+            return None;
+        };
+        let ApprovalAction::Execve {
+            id,
+            approval_id,
+            environment_id,
+            source,
+            program,
+            argv,
+            command,
+            additional_permissions,
+            ..
+        } = &selected.action
+        else {
+            return None;
+        };
+        let normalized = std::iter::once(program.to_string_lossy().into_owned())
+            .chain(argv.iter().skip(1).cloned())
+            .collect::<Vec<_>>();
+        let live_ignore = config
+            .config_layer_stack
+            .requirements_toml()
+            .auto_review
+            .as_ref()
+            .and_then(|review| review.ignore_rules.as_ref());
+        let frozen_ignore = task
+            .turn_context
+            .config
+            .config_layer_stack
+            .requirements_toml()
+            .auto_review
+            .as_ref()
+            .and_then(|review| review.ignore_rules.as_ref());
+        if parent_id != id
+            || id != &selected.context.call_id
+            || parent_env != environment_id
+            || environment_id != &selected.environment_id
+            || approval_id.is_empty()
+            || *source != codex_protocol::protocol::GuardianCommandSource::UnifiedExec
+            || *command != normalized
+            || additional_permissions.is_some()
+            || ![&issuer.session, &selected.session]
+                .into_iter()
+                .all(|owner| {
+                    owner
+                        .upgrade()
+                        .is_some_and(|owner| Arc::ptr_eq(&owner, self))
+                })
+            || !Arc::ptr_eq(&task.done, &issuer.task_done)
+            || !Arc::ptr_eq(&task.done, &selected.task_done)
+            || !Arc::ptr_eq(&task.turn_context, &issuer.turn)
+            || !Arc::ptr_eq(&task.turn_context, selected.context.review_context.turn())
+            || !Arc::ptr_eq(&settings, &issuer.settings)
+            || !Arc::ptr_eq(&settings, &selected.settings)
+            || settings.approval_policy() != AskForApproval::OnRequest
+            || settings.approvals_reviewer() != ApprovalsReviewer::User
+            || selected.context.review_context.approval_policy != AskForApproval::OnRequest
+            || selected.context.review_context.approvals_reviewer != ApprovalsReviewer::User
+            || !Arc::ptr_eq(&settings.model_info, task.turn_context.model_info())
+            || !Arc::ptr_eq(
+                &settings.model_info,
+                &selected.context.review_context.model_info,
+            )
+            || live_ignore != frozen_ignore
+            || task.turn_context.allow_prefix_rules() != crate::exec_policy::AllowPrefixRules::Honor
+            || turn_state.strict_auto_review_enabled()
+            || selected.context.strict_auto_review
+            || task.cancellation_token.is_cancelled()
+            || issuer.task_cancellation.is_cancelled()
+            || issuer.call_cancellation.is_cancelled()
+            || selected.task_cancellation.is_cancelled()
+            || selected
+                .context
+                .cancellation_token
+                .as_ref()
+                .is_some_and(CancellationToken::is_cancelled)
+            || ![&issuer.live_config, &selected.config, used_config]
+                .into_iter()
+                .all(|expected| Arc::ptr_eq(expected, config))
+            || ![
+                &issuer.base_exec_policy,
+                &selected.manager_policy,
+                &selected._evaluated_policy,
+            ]
+            .into_iter()
+            .all(|expected| Arc::ptr_eq(expected, evaluated_policy))
+            || !same_ready_parent_environments(
+                &issuer.environments,
+                selected.environments.snapshot(),
+            )
+            || issuer
+                .environments
+                .turn_environments()
+                .filter(|ready| ready.selection.environment_id == *environment_id)
+                .count()
+                != 1
+            || session_state.granted_permissions(environment_id).is_some()
+            || turn_state.granted_permissions(environment_id).is_some()
+            || hooks.matching_handler_count() != 0
+            || !hooks.matches_current(&self.hooks())
+        {
+            return None;
+        }
+        self.services
+            .exec_policy
+            .with_matching_parent_policy(evaluated_policy, || {
+                self.services
+                    .turn_environments
+                    .with_current_parent_environment(&selected.environments, environment_id, finish)
+            })
+    }
+}
+
 pub(crate) struct InitialExecApprovalIssuer {
     session: Weak<Session>,
     task_done: Arc<Notify>,
