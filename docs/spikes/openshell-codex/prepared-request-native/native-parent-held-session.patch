+//! Held Session/Fresh observations only. Every finish returns None; no child grant.
+use super::*;
+use crate::hook_runtime::PermissionRequestHookObservation;
+use crate::hook_runtime::run_permission_request_hooks_with_metadata;
+use crate::tools::ApprovalResolution;
+use codex_guardian_reviewer::ReviewDisposition;
+use codex_guardian_reviewer::UserPromptDisposition;
+use codex_protocol::protocol::GuardianCommandSource;
+use codex_utils_absolute_path::AbsolutePathBuf;
+use pretty_assertions::assert_eq;
+use std::future::Future;
+use std::time::Duration;
+
+const CALL: &str = "held-parent";
+struct Case {
+    fixture: Fixture,
+    _cancel: Option<tokio_util::sync::DropGuard>,
+}
+struct Packet {
+    selected: InterceptedApprovalSelection,
+    used: Arc<Config>,
+    policy: Arc<Policy>,
+    hooks: PermissionRequestHookObservation,
+}
+// Panic cleanup is best effort: a busy active-turn lock can prevent current-task cancellation.
+impl Drop for Case {
+    fn drop(&mut self) {
+        if let Ok(active) = self.fixture.session.active_turn.try_lock()
+            && let Some(task) = active.as_ref().and_then(|active| active.task.as_ref())
+        {
+            task.cancellation_token.cancel();
+        }
+    }
+}
+async fn bounded(body: impl Future<Output = anyhow::Result<()>>) -> anyhow::Result<()> {
+    tokio::time::timeout(Duration::from_secs(15), body).await?
+}
+impl Case {
+    async fn new() -> anyhow::Result<Self> {
+        let fixture = tokio::time::timeout(Duration::from_secs(15), Fixture::new(None)).await??;
+        let mut case = Self {
+            fixture,
+            _cancel: None,
+        };
+        let setup = bounded(async {
+            let cancellation = case
+                .fixture
+                .session
+                .active_turn
+                .lock()
+                .await
+                .as_ref()
+                .unwrap()
+                .task
+                .as_ref()
+                .unwrap()
+                .cancellation_token
+                .clone();
+            case._cancel = Some(cancellation.drop_guard());
+            case.synchronize().await;
+            Ok(())
+        })
+        .await;
+        match setup {
+            Ok(()) => Ok(case),
+            Err(error) => {
+                case.finish(Err(error)).await?;
+                unreachable!("failed setup returned success")
+            }
+        }
+    }
+    async fn synchronize(&mut self) {
+        self.fixture
+            .session
+            .services
+            .turn_environments
+            .snapshot()
+            .await;
+        let (turn, settings, environments, strict) = self
+            .fixture
+            .session
+            .active_turn_context_and_strict_auto_review()
+            .await
+            .unwrap();
+        assert!(!strict);
+        assert!(Arc::ptr_eq(&turn, &self.fixture.step.turn));
+        assert!(environments.primary().is_some());
+        let step = Arc::get_mut(&mut self.fixture.step).unwrap();
+        step.settings = settings;
+        step.environments = environments;
+    }
+    async fn finish(self, result: anyhow::Result<()>) -> anyhow::Result<()> {
+        let cleanup = tokio::time::timeout(
+            Duration::from_secs(5),
+            self.fixture
+                .session
+                .abort_all_tasks(TurnAbortReason::Interrupted),
+        )
+        .await;
+        match (result, cleanup) {
+            (Ok(()), Ok(())) => Ok(()),
+            (Err(error), Ok(())) => Err(error),
+            (Ok(()), Err(cleanup)) => Err(cleanup.into()),
+            (Err(error), Err(cleanup)) => {
+                Err(error.context(format!("task cleanup also timed out: {cleanup}")))
+            }
+        }
+    }
+    async fn fresh(&self) -> anyhow::Result<InitialExecApproval> {
+        let result = self
+            .fixture
+            .approve(CALL, ReviewDecision::Approved, Drift::None)
+            .await?;
+        assert_eq!(result.decision, ReviewDecision::Approved);
+        assert!(result.parent_approval.is_some());
+        Ok(result)
+    }
+    async fn packet(&self) -> anyhow::Result<Packet> {
+        let policy = self.fixture.session.services.exec_policy.current();
+        let ready = self.fixture.step.environments.primary().unwrap();
+        let program = AbsolutePathBuf::current_dir()?.join("q4a-not-executed");
+        let command = vec![program.to_string_lossy().into_owned(), "argument".into()];
+        let selected = self
+            .fixture
+            .session
+            .capture_intercepted_approval_selection(
+                ApprovalAction::Execve {
+                    id: CALL.into(),
+                    approval_id: "actual-child-request".into(),
+                    environment_id: ready.selection.environment_id.clone(),
+                    source: GuardianCommandSource::UnifiedExec,
+                    program,
+                    argv: command.clone(),
+                    command,
+                    cwd: ready.cwd().to_abs_path()?,
+                    additional_permissions: None,
+                },
+                CALL,
+                &ToolName::plain("exec_command"),
+                &GuardianReviewContext::from(&self.fixture.step),
+                Arc::clone(&policy),
+            )
+            .await
+            .map_err(|error| anyhow::anyhow!("capture: {error:?}"))?;
+        let (action, context) = selected.approval_request();
+        let (decision, hooks) = run_permission_request_hooks_with_metadata(
+            &self.fixture.session,
+            &context.review_context,
+            "held-hooks",
+            action.permission_request_payload(),
+        )
+        .await
+        .into_parts();
+        assert_eq!(decision, None);
+        let routing = self
+            .fixture
+            .session
+            .request_guardian_approval_with_routing(action, &context)
+            .await;
+        assert_eq!(
+            routing.disposition(),
+            &ReviewDisposition::UserPrompt(UserPromptDisposition::NoContributorDefaultUser {
+                fresh_review_required: false
+            })
+        );
+        let used = Arc::clone(
+            routing
+                .used_config()
+                .expect("actual pre-callback selection"),
+        );
+        Ok(Packet {
+            selected,
+            used,
+            policy,
+            hooks,
+        })
+    }
+    async fn entries(&self, approval: &InitialExecApproval, packet: &Packet) -> usize {
+        let count = AtomicUsize::new(0);
+        let result = approval
+            .parent_approval
+            .as_ref()
+            .unwrap()
+            .with_current_parent_resolution(
+                &self.fixture.session,
+                &packet.selected,
+                &packet.used,
+                &packet.policy,
+                &packet.hooks,
+                || {
+                    count.fetch_add(1, Ordering::SeqCst);
+                    None
+                },
+            )
+            .await;
+        assert!(result.is_none());
+        count.load(Ordering::SeqCst)
+    }
+}
+
+#[tokio::test]
+async fn actual_fresh_delegation_holds_all_existing_owners_until_none_finish() -> anyhow::Result<()>
+{
+    let case = Case::new().await?;
+    let result = bounded(async {
+        let approval = case.fresh().await?;
+        let packet = case.packet().await?;
+        let turn_state = Arc::clone(
+            &case
+                .fixture
+                .session
+                .active_turn
+                .lock()
+                .await
+                .as_ref()
+                .unwrap()
+                .turn_state,
+        );
+        let count = AtomicUsize::new(0);
+        let result = approval
+            .parent_approval
+            .as_ref()
+            .unwrap()
+            .with_current_parent_resolution(
+                &case.fixture.session,
+                &packet.selected,
+                &packet.used,
+                &packet.policy,
+                &packet.hooks,
+                || {
+                    assert!(case.fixture.session.active_turn.try_lock().is_err());
+                    assert!(case.fixture.session.state.try_lock().is_err());
+                    assert!(turn_state.try_lock().is_err());
+                    assert!(
+                        case.fixture
+                            .session
+                            .services
+                            .exec_policy
+                            .with_matching_parent_policy(&packet.policy, || panic!(
+                                "policy permit escaped"
+                            ),)
+                            .is_none()
+                    );
+                    assert!(
+                        case.fixture
+                            .session
+                            .services
+                            .turn_environments
+                            .with_current_parent_environment(
+                                &packet.selected.environments,
+                                &packet.selected.environment_id,
+                                || panic!("environment mutex escaped"),
+                            )
+                            .is_none()
+                    );
+                    count.fetch_add(1, Ordering::SeqCst);
+                    None::<ApprovalResolution>
+                },
+            )
+            .await;
+        assert!(result.is_none());
+        assert_eq!(count.load(Ordering::SeqCst), 1);
+        assert_eq!(case.fixture.calls.load(Ordering::SeqCst), 2);
+        assert!(
+            !std::iter::from_fn(|| case.fixture.events.try_recv().ok())
+                .any(|event| matches!(event.msg, EventMsg::ExecApprovalRequest(_)))
+        );
+        Ok(())
+    })
+    .await;
+    case.finish(result).await
+}
+
+#[tokio::test]
+async fn actual_owner_drift_never_enters_an_already_approved_parent_finish() -> anyhow::Result<()> {
+    for drift in [
+        Drift::Settings,
+        Drift::Config,
+        Drift::Policy,
+        Drift::Task,
+        Drift::Strict,
+        Drift::Cancel,
+    ] {
+        let case = Case::new().await?;
+        let result = bounded(async {
+            let approval = case.fresh().await?;
+            let packet = case.packet().await?;
+            let mut replacement_cancellation = None;
+            match drift {
+                Drift::Settings => assert!(matches!(
+                    case.fixture
+                        .session
+                        .apply_turn_settings(
+                            &case.fixture.step.turn.sub_id,
+                            TurnSettingsUpdate {
+                                approvals_reviewer: Some(ApprovalsReviewer::User),
+                                ..Default::default()
+                            }
+                        )
+                        .await,
+                    TurnSettingsUpdateOutcome::Applied
+                )),
+                Drift::Config => {
+                    let config = case.fixture.session.get_config().await;
+                    case.fixture
+                        .session
+                        .refresh_runtime_config(config.as_ref().clone())
+                        .await;
+                }
+                Drift::Policy => {
+                    let home = tempfile::tempdir()?;
+                    case.fixture
+                        .session
+                        .services
+                        .exec_policy
+                        .append_amendment_and_update(
+                            home.path(),
+                            &codex_protocol::protocol::ExecPolicyAmendment {
+                                command: vec!["changed-parent-policy".into()],
+                            },
+                        )
+                        .await?;
+                }
+                Drift::Task => {
+                    case.fixture
+                        .session
+                        .abort_all_tasks(TurnAbortReason::Replaced)
+                        .await;
+                    case.fixture
+                        .session
+                        .start_task(Arc::clone(&case.fixture.step.turn), Vec::new(), PendingTask)
+                        .await;
+                    let active = case.fixture.session.active_turn.lock().await;
+                    let task = active.as_ref().unwrap().task.as_ref().unwrap();
+                    assert!(!Arc::ptr_eq(&task.done, &packet.selected.task_done));
+                    assert!(!task.cancellation_token.is_cancelled());
+                    replacement_cancellation = Some(task.cancellation_token.clone().drop_guard());
+                }
+                Drift::Strict => {
+                    let state = Arc::clone(
+                        &case
+                            .fixture
+                            .session
+                            .active_turn
+                            .lock()
+                            .await
+                            .as_ref()
+                            .unwrap()
+                            .turn_state,
+                    );
+                    state.lock().await.enable_strict_auto_review();
+                }
+                Drift::Cancel => case
+                    .fixture
+                    .session
+                    .active_turn
+                    .lock()
+                    .await
+                    .as_ref()
+                    .unwrap()
+                    .task
+                    .as_ref()
+                    .unwrap()
+                    .cancellation_token
+                    .cancel(),
+                Drift::None => unreachable!(),
+            }
+            assert_eq!(approval.decision, ReviewDecision::Approved);
+            assert_eq!(case.entries(&approval, &packet).await, 0);
+            drop(replacement_cancellation);
+            Ok(())
+        })
+        .await;
+        case.finish(result).await?;
+    }
+    let case = Case::new().await?;
+    let result = bounded(async {
+        let approval = case.fresh().await?;
+        let packet = case.packet().await?;
+        case.fixture
+            .session
+            .abort_all_tasks(TurnAbortReason::Interrupted)
+            .await;
+        assert_eq!(case.entries(&approval, &packet).await, 0);
+        Ok(())
+    })
+    .await;
+    case.finish(result).await
+}
+
+#[tokio::test]
+async fn unsupported_preissuer_model_and_requirements_inputs_only_narrow_optional_delegation()
+-> anyhow::Result<()> {
+    for replace_model in [true, false] {
+        let mut case = Case::new().await?;
+        let result = bounded(async {
+            // Unsupported owner-state input, NOT apply_turn_settings or runtime refresh.
+            let active = case.fixture.session.active_turn.lock().await;
+            let mut state = case.fixture.session.state.lock().await;
+            let task = active.as_ref().unwrap().task.as_ref().unwrap();
+            if replace_model {
+                let mut settings = task
+                    .turn_context
+                    .next_step_settings
+                    .load_full()
+                    .as_ref()
+                    .clone();
+                settings.model_info = Arc::new(settings.model_info.as_ref().clone());
+                assert_eq!(
+                    settings.model_info.slug,
+                    task.turn_context.model_info().slug
+                );
+                task.turn_context
+                    .next_step_settings
+                    .store(Arc::new(settings));
+            } else {
+                let original = Arc::clone(&state.session_configuration.original_config_do_not_use);
+                let stack = &original.config_layer_stack;
+                let mut raw = stack.requirements_toml().clone();
+                raw.auto_review
+                    .get_or_insert_with(Default::default)
+                    .ignore_rules = Some(vec!["q4a-unrelated-not-selected-model".into()]);
+                let mut config = original.as_ref().clone();
+                config.config_layer_stack = codex_config::ConfigLayerStack::new(
+                    stack.all_layers_low_to_high().cloned().collect(),
+                    stack.requirements().clone(),
+                    raw,
+                )?;
+                state.session_configuration.original_config_do_not_use = Arc::new(config);
+            }
+            drop(state);
+            drop(active);
+            case.synchronize().await;
+            let approval = case.fresh().await?;
+            let packet = case.packet().await?;
+            assert!(Arc::ptr_eq(
+                &packet.selected.settings,
+                &case.fixture.step.settings
+            ));
+            assert!(Arc::ptr_eq(&packet.selected.config, &packet.used));
+            assert!(Arc::ptr_eq(
+                &packet.used,
+                &case.fixture.session.get_config().await
+            ));
+            if replace_model {
+                assert!(!Arc::ptr_eq(
+                    &packet.selected.settings.model_info,
+                    case.fixture.step.turn.model_info()
+                ));
+                assert_eq!(
+                    packet.selected.settings.model_info.slug,
+                    case.fixture.step.turn.model_info().slug
+                );
+            } else {
+                assert!(Arc::ptr_eq(
+                    &packet.selected.settings.model_info,
+                    case.fixture.step.turn.model_info()
+                ));
+                let live = packet
+                    .used
+                    .config_layer_stack
+                    .requirements_toml()
+                    .auto_review
+                    .as_ref()
+                    .and_then(|review| review.ignore_rules.as_ref());
+                let frozen = case
+                    .fixture
+                    .step
+                    .turn
+                    .config
+                    .config_layer_stack
+                    .requirements_toml()
+                    .auto_review
+                    .as_ref()
+                    .and_then(|review| review.ignore_rules.as_ref());
+                assert_ne!(live, frozen);
+                assert!(
+                    !live
+                        .unwrap()
+                        .contains(&packet.selected.settings.model_info.slug)
+                );
+                assert_eq!(
+                    packet.used.config_layer_stack.requirements(),
+                    case.fixture
+                        .step
+                        .turn
+                        .config
+                        .config_layer_stack
+                        .requirements()
+                );
+            }
+            assert_eq!(case.entries(&approval, &packet).await, 0);
+            assert_eq!(approval.decision, ReviewDecision::Approved);
+            Ok(())
+        })
+        .await;
+        case.finish(result).await?;
+    }
+    Ok(())
+}
