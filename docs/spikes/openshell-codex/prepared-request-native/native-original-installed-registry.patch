+#[derive(Debug)]
+struct UnexpectedContributor(Arc<AtomicUsize>);
+impl ThreadLifecycleContributor<Config> for UnexpectedContributor {
+    fn on_thread_start<'a>(
+        &'a self,
+        _input: ThreadStartInput<'a, Config>,
+    ) -> ExtensionFuture<'a, ()> {
+        self.0.fetch_add(1, Ordering::SeqCst);
+        Box::pin(async {})
+    }
+}
+impl ModelRequestContributor for UnexpectedContributor {
+    fn request(&self, _input: ModelRequestInput<'_>) -> Option<Box<dyn ModelResponseInterceptor>> {
+        self.0.fetch_add(1, Ordering::SeqCst);
+        None
+    }
+}
