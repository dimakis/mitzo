+#[tokio::test]
+async fn actual_installed_manager_registry_and_objects_are_retained_without_starting()
+-> anyhow::Result<()> {
+    let (_home, config, auth, manager, installed) = fixture(/*registry_override*/ None).await?;
+    let mut created = manager.subscribe_thread_created();
+    let mut options = codex_core::StartThreadOptions::new(config);
+    options
+        .thread_extension_init
+        .insert(codex_core::CodexResponsesHeaders {
+            model: "gpt-6-luna".to_string(),
+            headers: http::HeaderMap::new(),
+        });
+    let mut selected = manager.prepare_selected_start(options).await?;
+    manager.capture_selected_start_api_mcp(
+        &mut selected,
+        auth.capture_cached_api_key_credentials().unwrap(),
+    )?;
+    let sources = selected.mcp_sources().unwrap();
+    let headers = sources
+        .start_options()
+        .thread_extension_init
+        .get::<codex_core::CodexResponsesHeaders>()
+        .unwrap();
+    let routing = sources
+        .start_options()
+        .thread_extension_init
+        .get::<codex_model_provider::WorkspaceRoutingContext>()
+        .unwrap();
+    let observed = installed
+        .observe(&manager, sources)
+        .map_err(|error| anyhow::anyhow!("{error:?}"))?;
+    observed
+        .renew_provenance()
+        .map_err(|error| anyhow::anyhow!("{error:?}"))?;
+    let actual = manager.pre_session_extension_registry(sources)?;
+    assert!(same_objects(
+        &installed.thread_lifecycle,
+        actual.thread_lifecycle_contributors()
+    ));
+    assert!(same_objects(
+        &installed.model_requests,
+        actual.model_request_contributors()
+    ));
+    assert!(Arc::ptr_eq(
+        &headers,
+        &sources
+            .start_options()
+            .thread_extension_init
+            .get::<codex_core::CodexResponsesHeaders>()
+            .unwrap()
+    ));
+    assert!(Arc::ptr_eq(
+        &routing,
+        &sources
+            .start_options()
+            .thread_extension_init
+            .get::<codex_model_provider::WorkspaceRoutingContext>()
+            .unwrap()
+    ));
+    assert!(manager.list_thread_ids().await.is_empty());
+    assert!(matches!(
+        created.try_recv(),
+        Err(tokio::sync::broadcast::error::TryRecvError::Empty)
+    ));
+    Ok(())
+}
