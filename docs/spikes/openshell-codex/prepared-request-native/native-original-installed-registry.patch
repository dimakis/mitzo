+#[tokio::test]
+async fn foreign_custom_derived_and_extra_contributors_never_inherit_provenance()
+-> anyhow::Result<()> {
+    let (_home, config, auth, manager, installed) = fixture(/*registry_override*/ None).await?;
+    let sources = manager.capture_pre_session_api_key_mcp_sources(
+        codex_core::StartThreadOptions::new(config),
+        auth.capture_cached_api_key_credentials().unwrap(),
+    )?;
+    // A DIFFERENT actual native manager using the SAME installed registry Arc
+    // cannot inherit the original builder's manager provenance.
+    let (_foreign_home, _config, _auth, foreign, _foreign_installed) =
+        fixture(Some(installed.registry())).await?;
+    assert_eq!(
+        installed.observe(&foreign, &sources).err(),
+        Some(InstalledRegistryProvenanceError::ManagerChanged)
+    );
+    // The retained object comparison rejects missing or reordered ORIGINAL
+    // lifecycle objects without invoking either original or custom callbacks.
+    let mut changed = installed.thread_lifecycle.clone();
+    assert!(changed.len() > 1);
+    changed.swap(0, 1);
+    assert!(!same_objects(&installed.thread_lifecycle, &changed));
+    changed.pop();
+    assert!(!same_objects(&installed.thread_lifecycle, &changed));
+    let derived = installed.registry.to_builder().build();
+    assert_eq!(
+        installed.assert_registry(&derived),
+        Err(InstalledRegistryProvenanceError::RegistryChanged)
+    );
+    let custom = ExtensionRegistryBuilder::<Config>::new().build();
+    assert_eq!(
+        installed.assert_registry(&custom),
+        Err(InstalledRegistryProvenanceError::RegistryChanged)
+    );
+    let calls = Arc::new(AtomicUsize::new(0));
+    let extra = Arc::new(UnexpectedContributor(Arc::clone(&calls)));
+    let mut builder = installed.registry.to_builder();
+    builder.thread_lifecycle_contributor(extra.clone());
+    builder.model_request_contributor(extra);
+    assert_eq!(
+        installed.assert_registry(&builder.build()),
+        Err(InstalledRegistryProvenanceError::RegistryChanged)
+    );
+    assert_eq!(calls.load(Ordering::SeqCst), 0);
+    assert!(manager.list_thread_ids().await.is_empty());
+    assert!(foreign.list_thread_ids().await.is_empty());
+    Ok(())
+}
