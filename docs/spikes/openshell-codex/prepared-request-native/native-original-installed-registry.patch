+//! Provenance of the ORIGINAL installed composition, not callback behavior.
+//! Registry Arc and object inventories remain private. Contributor data may be
+//! mutable; this is no header/context/tool finality, lease, eligibility or Ready.
+#![cfg_attr(
+    not(test),
+    allow(dead_code, reason = "Fresh client composition is being connected.")
+)]
+use codex_core::PreSessionMcpError;
+use codex_core::PreSessionMcpSources;
+use codex_core::ThreadManager;
+use codex_core::config::Config;
+use codex_extension_api::ExtensionRegistry;
+use codex_extension_api::ModelRequestContributor;
+use codex_extension_api::ThreadLifecycleContributor;
+use std::sync::Arc;
+use std::sync::Weak;
+
+pub(crate) struct InstalledThreadExtensions {
+    registry: Arc<ExtensionRegistry<Config>>,
+    manager: Weak<ThreadManager>,
+    thread_lifecycle: Vec<Arc<dyn ThreadLifecycleContributor<Config>>>,
+    model_requests: Vec<Arc<dyn ModelRequestContributor>>,
+}
+
+#[derive(Debug, PartialEq, Eq)]
+pub(crate) enum InstalledRegistryProvenanceError {
+    NativeMcp(PreSessionMcpError),
+    ManagerGone,
+    ManagerChanged,
+    RegistryChanged,
+    ContributorsChanged,
+}
+
+/// Borrows the actual installed composition and native owner packet. This
+/// observation does not permit callbacks or certify their contents/currentness.
+pub(crate) struct InstalledRegistryObservation<'a> {
+    installed: &'a InstalledThreadExtensions,
+    manager: &'a ThreadManager,
+    sources: &'a PreSessionMcpSources,
+}
+
+fn same_objects<T: ?Sized>(retained: &[Arc<T>], actual: &[Arc<T>]) -> bool {
+    retained.len() == actual.len() && retained.iter().zip(actual).all(|(a, b)| Arc::ptr_eq(a, b))
+}
+
+impl InstalledThreadExtensions {
+    // Only the ORIGINAL parent composition owner can mint this wrapper. No
+    // general constructor or caller classification accepts custom registries.
+    pub(super) fn from_original_registry(
+        registry: Arc<ExtensionRegistry<Config>>,
+        manager: Weak<ThreadManager>,
+    ) -> Self {
+        Self {
+            manager,
+            thread_lifecycle: registry.thread_lifecycle_contributors().to_vec(),
+            model_requests: registry.model_request_contributors().to_vec(),
+            registry,
+        }
+    }
+
+    pub(crate) fn registry(&self) -> Arc<ExtensionRegistry<Config>> {
+        Arc::clone(&self.registry)
+    }
+
+    fn assert_registry(
+        &self,
+        actual: &ExtensionRegistry<Config>,
+    ) -> Result<(), InstalledRegistryProvenanceError> {
+        if !std::ptr::eq(self.registry.as_ref(), actual) {
+            return Err(InstalledRegistryProvenanceError::RegistryChanged);
+        }
+        if !same_objects(
+            &self.thread_lifecycle,
+            actual.thread_lifecycle_contributors(),
+        ) || !same_objects(&self.model_requests, actual.model_request_contributors())
+        {
+            return Err(InstalledRegistryProvenanceError::ContributorsChanged);
+        }
+        Ok(())
+    }
+
+    pub(crate) fn observe<'a>(
+        &'a self,
+        manager: &'a ThreadManager,
+        sources: &'a PreSessionMcpSources,
+    ) -> Result<InstalledRegistryObservation<'a>, InstalledRegistryProvenanceError> {
+        let observed = InstalledRegistryObservation {
+            installed: self,
+            manager,
+            sources,
+        };
+        observed.renew_provenance()?;
+        Ok(observed)
+    }
+}
+
+impl InstalledRegistryObservation<'_> {
+    /// Renews ONLY provenance at this point using the original native source
+    /// validator. No publisher lease or mutable contributor-data currency follows.
+    pub(crate) fn renew_provenance(&self) -> Result<(), InstalledRegistryProvenanceError> {
+        let owner = self
+            .installed
+            .manager
+            .upgrade()
+            .ok_or(InstalledRegistryProvenanceError::ManagerGone)?;
+        if !std::ptr::eq(owner.as_ref(), self.manager) {
+            return Err(InstalledRegistryProvenanceError::ManagerChanged);
+        }
+        let registry = self
+            .manager
+            .pre_session_extension_registry(self.sources)
+            .map_err(InstalledRegistryProvenanceError::NativeMcp)?;
+        self.installed.assert_registry(registry)
+    }
+}
