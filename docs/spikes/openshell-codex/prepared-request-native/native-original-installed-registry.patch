+    assert!(config.model_provider.aws.is_none());
+    assert!(!config.model_provider.is_amazon_bedrock());
+    let auth = codex_login::AuthManager::from_auth_for_testing(
+        codex_login::CodexAuth::from_api_key("synthetic-registry-provenance"),
+    );
+    let state = codex_core::init_state_db(&config)
