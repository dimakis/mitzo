+        .ok_or_else(|| anyhow::anyhow!("original test state database unavailable"))?;
+    let store = codex_core::thread_store_from_config(&config, Some(state.clone()));
+    let environments = Arc::new(codex_exec_server::EnvironmentManager::default_for_tests());
+    let sink: Arc<dyn codex_extension_api::ExtensionEventSink> = Arc::new(NoopExtensionEventSink);
+    let queue_store: Arc<dyn codex_thread_store::QueueStore> =
