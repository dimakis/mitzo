diff --git a/codex-rs/ext/goal/tests/goal_extension_backend.rs b/codex-rs/ext/goal/tests/goal_extension_backend.rs
index e0a952d..e204dd0 100644
--- a/codex-rs/ext/goal/tests/goal_extension_backend.rs
+++ b/codex-rs/ext/goal/tests/goal_extension_backend.rs
@@ -51,6 +51,71 @@ use pretty_assertions::assert_eq;
 use serde_json::json;
 use tempfile::TempDir;
 
+#[tokio::test]
+async fn disabled_goal_capture_tracks_ordinary_configuration() -> anyhow::Result<()> {
+    use codex_extension_api::PreSessionToolInventoryError;
+
+    let runtime = test_runtime().await?;
+    let thread_id = test_thread_id()?;
+    let mut builder = ExtensionRegistryBuilder::<bool>::new();
+    install_with_backend(
+        &mut builder,
+        runtime,
+        AnalyticsEventsClient::disabled(),
+        /*metrics_client*/ None,
+        Weak::new(),
+        Arc::new(GoalService::new()),
+        |enabled| GoalExtensionConfig {
+            enabled: *enabled,
+            max_goal_token_budget: None,
+        },
+    );
+    let registry = builder.build();
+    let capture = registry.capture_pre_session_tools_for_config(&false)?;
+    assert!(capture.definitions().is_empty());
+    let session_store = ExtensionData::new(thread_id.to_string());
+    let thread_store = ExtensionData::new(thread_id.to_string());
+    for contributor in registry.thread_lifecycle_contributors() {
+        contributor
+            .on_thread_start(ThreadStartInput {
+                config: &false,
+                session_source: &SessionSource::Cli,
+                persistent_thread_state_available: true,
+                environments: &[],
+                mcp_resource_client: None,
+                extension_metrics: None,
+                session_store: &session_store,
+                thread_store: &thread_store,
+            })
+            .await;
+    }
+    let tools = || {
+        registry
+            .tool_contributors()
+            .iter()
+            .flat_map(|contributor| contributor.tools(&session_store, &thread_store))
+            .map(|tool| tool.tool_name())
+            .collect::<Vec<_>>()
+    };
+    assert!(tools().is_empty());
+    assert_eq!(
+        registry.renew_pre_session_tools_for_config(&capture, &true),
+        Err(PreSessionToolInventoryError::StateBoundContributors {
+            registration_indexes: vec![0],
+        })
+    );
+    for contributor in registry.config_contributors() {
+        contributor.on_config_changed(&session_store, &thread_store, &false, &true);
+    }
+    assert_eq!(tools().len(), 3);
+    for contributor in registry.config_contributors() {
+        contributor.on_config_changed(&session_store, &thread_store, &true, &false);
+    }
+    assert!(tools().is_empty());
+    registry.renew_pre_session_tools_for_config(&capture, &false)?;
+    Ok(())
+}
+
 #[tokio::test]
 async fn installed_goal_tools_create_goal_and_fill_empty_preview() -> anyhow::Result<()> {
     let runtime = test_runtime().await?;
