+/// Installs the ordinary goal owners and their config-only absence plan.
+/// `goal_config` must project only the supplied configuration without effects or
+/// mutable external reads; preparation and ordinary lifecycle share that source.
 pub fn install_with_backend<C>(
     registry: &mut ExtensionRegistryBuilder<C>,
     state_dbs: Arc<codex_state::StateRuntime>,
@@ -609,7 +613,17 @@ pub fn install_with_backend<C>(
     registry.turn_lifecycle_contributor(extension.clone());
     registry.token_usage_contributor(extension.clone());
     registry.tool_lifecycle_contributor(extension.clone());
-    registry.tool_contributor(extension);
+    let goal_config = Arc::clone(&extension.goal_config);
+    registry.tool_contributor_with_pre_session_plan(
+        extension,
+        Arc::new(move |config| {
+            if goal_config(config).enabled {
+                ToolPreSessionSelection::Unresolved
+            } else {
+                ToolPreSessionSelection::NoTools
+            }
+        }),
+    );
 }
 
