+//! Original registry provenance only. These identities and complete sets do not
+//! attest any context partition's observed data, currency or request readiness.
+//! Concrete host composition must retain its source-owned observations beside
+//! this set and settle thread/turn/world-state partitions independently.
+use super::ContextSourceRegistrationError;
+use super::ExtensionRegistry;
+use super::RegisteredContextSource;
+use super::RegisteredPromptContextSource;
+use crate::ContextContributor;
+use crate::ToolContributor;
+use crate::TurnInputContributor;
+use std::sync::Arc;
+
+/// Opaque identity minted from one validated original typed registration.
+#[derive(Clone)]
+pub struct ContextSourceIdentity {
+    registry_identity: Arc<()>,
+    context_index: usize,
+    source: Arc<dyn ContextContributor>,
+}
+
+/// Complete original registration membership, ordered by the actual registry.
+/// This proves provenance/coverage of allocations, never observed context data.
+pub struct BoundContextSourceRegistrations {
+    registry_identity: Arc<()>,
+    sources: Vec<ContextSourceIdentity>,
+}
+
+impl BoundContextSourceRegistrations {
+    pub fn registration_indexes(&self) -> impl Iterator<Item = usize> + '_ {
+        self.sources.iter().map(|source| source.context_index)
+    }
+}
+
+impl<C: Sync> ExtensionRegistry<C> {
+    pub fn prompt_source_identity<T>(
+        &self,
+        registration: &RegisteredPromptContextSource<T>,
+    ) -> Result<ContextSourceIdentity, ContextSourceRegistrationError>
+    where
+        T: ContextContributor + 'static,
+    {
+        self.borrow_prompt_context_source(registration)?;
+        Ok(ContextSourceIdentity {
+            registry_identity: Arc::clone(&self.tool_inventory_identity),
+            context_index: registration.context_index,
+            source: Arc::clone(&self.context_contributors[registration.context_index]),
+        })
+    }
+
+    pub fn context_source_identity<T>(
+        &self,
+        registration: &RegisteredContextSource<T>,
+    ) -> Result<ContextSourceIdentity, ContextSourceRegistrationError>
+    where
+        T: ContextContributor + TurnInputContributor + ToolContributor + 'static,
+    {
+        self.assert_context_source_registration(registration)?;
+        Ok(ContextSourceIdentity {
+            registry_identity: Arc::clone(&self.tool_inventory_identity),
+            context_index: registration.context_index,
+            source: Arc::clone(&self.context_contributors[registration.context_index]),
+        })
+    }
+
+    /// Rejects missing, duplicated, foreign and unknown/legacy registrations.
+    /// Callers cannot replace actual indices or allocation pointers with names.
+    /// Successful binding does not qualify any initial context partition.
+    pub fn bind_context_source_registrations(
+        &self,
+        mut sources: Vec<ContextSourceIdentity>,
+    ) -> Result<BoundContextSourceRegistrations, ContextSourceRegistrationError> {
+        sources.sort_by_key(|source| source.context_index);
+        let bound = BoundContextSourceRegistrations {
+            registry_identity: Arc::clone(&self.tool_inventory_identity),
+            sources,
+        };
+        self.assert_bound_context_source_registrations(&bound)?;
+        Ok(bound)
+    }
+
+    pub fn assert_bound_context_source_registrations(
+        &self,
+        bound: &BoundContextSourceRegistrations,
+    ) -> Result<(), ContextSourceRegistrationError> {
+        if !Arc::ptr_eq(&self.tool_inventory_identity, &bound.registry_identity) {
+            return Err(ContextSourceRegistrationError::RegistryChanged);
+        }
+        for source in &bound.sources {
+            if !Arc::ptr_eq(&self.tool_inventory_identity, &source.registry_identity) {
+                return Err(ContextSourceRegistrationError::RegistryChanged);
+            }
+        }
+        if bound.sources.len() != self.context_contributors.len()
+            || bound.sources.iter().enumerate().any(|(index, source)| {
+                source.context_index != index
+                    || !Arc::ptr_eq(&source.source, &self.context_contributors[index])
+            })
+        {
+            return Err(ContextSourceRegistrationError::ContributorsChanged);
+        }
+        Ok(())
+    }
+}
