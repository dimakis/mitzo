diff --git a/codex-rs/core/src/thread_manager/selected_start.rs b/codex-rs/core/src/thread_manager/selected_start.rs
new file mode 100644
index 0000000000000000000000000000000000000000..245fe1e641ededf1cfa3acc7fe609d60be8667fc
--- /dev/null
+++ b/codex-rs/core/src/thread_manager/selected_start.rs
@@ -0,0 +1,196 @@
+//! One-use selected ordinary start custody. No Session, identity reservation,
+//! count, State record or Ready is created. Configuration authority remains with
+//! the original app-server loader; external source renewal is not an atomic lease.
+use super::*;
+use crate::PreSessionMcpSources;
+use crate::exec_policy::SelectedStartPolicy;
+use std::io;
+
+enum Inputs {
+    Options(StartThreadOptions),
+    Mcp(PreSessionMcpSources),
+}
+
+/// Opaque non-Clone/non-Serialize custody of the actual options and strict policy.
+pub struct SelectedStartInputs {
+    owner: Arc<ThreadManagerState>,
+    inputs: Option<Inputs>,
+    invalidated: AtomicBool,
+    policy: Arc<SelectedStartPolicy>,
+}
+
+/// One-use ordinary adoption; not a dispatch/admission authorization.
+pub struct SelectedStartAdoption {
+    owner: Arc<ThreadManagerState>,
+    options: StartThreadOptions,
+    policy: Arc<SelectedStartPolicy>,
+}
+
+impl SelectedStartInputs {
+    pub fn start_options(&self) -> io::Result<&StartThreadOptions> {
+        match self.inputs.as_ref() {
+            Some(Inputs::Options(options)) => Ok(options),
+            Some(Inputs::Mcp(sources)) => Ok(sources.start_options()),
+            None => Err(io::Error::other(
+                "selected start was consumed or capture failed",
+            )),
+        }
+    }
+    pub fn mcp_sources(&self) -> Option<&PreSessionMcpSources> {
+        match self.inputs.as_ref() {
+            Some(Inputs::Mcp(sources)) => Some(sources),
+            _ => None,
+        }
+    }
+    pub fn policy(&self) -> &Arc<codex_execpolicy::Policy> {
+        self.policy.policy()
+    }
+}
+
+impl ThreadManager {
+    pub async fn prepare_selected_start(
+        &self,
+        mut options: StartThreadOptions,
+    ) -> io::Result<SelectedStartInputs> {
+        let source = options
+            .session_source
+            .clone()
+            .unwrap_or_else(|| self.state.session_source.clone());
+        if !matches!(&options.initial_history, InitialHistory::New)
+            || options.internal_parent.is_some()
+            || options.inherited_environments.is_some()
+            || options.reserved_thread_id.is_some()
+            || session_isolation(&options.thread_extension_init, &source)
+                == codex_extension_api::SessionIsolation::Isolated
+        {
+            return Err(io::Error::other(
+                "selected start requires fresh ordinary inherited inputs",
+            ));
+        }
+        options.session_source = Some(source);
+        if options.environments.is_none() {
+            options.environments = Some(self.default_environment_selections(
+                &options.config.cwd,
+                &options.config.workspace_roots,
+            ));
+        }
+        let policy = Arc::new(SelectedStartPolicy::load(&options.config).await?);
+        Ok(SelectedStartInputs {
+            owner: Arc::clone(&self.state),
+            inputs: Some(Inputs::Options(options)),
+            invalidated: AtomicBool::new(false),
+            policy,
+        })
+    }
+
+    /// Existing genuine API MCP capture retains the SAME private start options.
+    /// Failure burns this custody rather than returning partially changed inputs.
+    pub fn capture_selected_start_api_mcp(
+        &self,
+        selected: &mut SelectedStartInputs,
+        credentials: codex_login::auth::CapturedApiKeyCredentials,
+    ) -> io::Result<()> {
+        self.with_current_selected_start(selected, || ())?;
+        let Some(Inputs::Options(options)) = selected.inputs.take() else {
+            return Err(io::Error::other(
+                "selected start is not awaiting MCP capture",
+            ));
+        };
+        let sources = self
+            .capture_pre_session_api_key_mcp_sources(options, credentials)
+            .map_err(io::Error::other)?;
+        selected.inputs = Some(Inputs::Mcp(sources));
+        self.with_current_selected_start(selected, || ())
+    }
+
+    pub async fn renew_selected_start(&self, selected: &SelectedStartInputs) -> io::Result<()> {
+        self.with_current_selected_start(selected, || ())?;
+        if let Err(error) = selected
+            .policy
+            .renew(&selected.start_options()?.config)
+            .await
+        {
+            selected.invalidated.store(true, Ordering::Release);
+            return Err(error);
+        }
+        self.with_current_selected_start(selected, || ())
+    }
+
+    /// Actual policy publisher guard only. Other source owners must nest their
+    /// own guards around final synchronous association, with no I/O/await/reentry.
+    pub fn with_current_selected_start<R>(
+        &self,
+        selected: &SelectedStartInputs,
+        associate: impl FnOnce() -> R,
+    ) -> io::Result<R> {
+        if !Arc::ptr_eq(&self.state, &selected.owner)
+            || selected.inputs.is_none()
+            || selected.invalidated.load(Ordering::Acquire)
+        {
+            return Err(io::Error::other(
+                "selected start owner changed or custody consumed",
+            ));
+        }
+        if let Some(sources) = selected.mcp_sources() {
+            self.validate_pre_session_mcp_sources(sources)
+                .map_err(io::Error::other)?;
+        }
+        selected.policy.with_current(associate)
+    }
+
+    /// Consumes retained options without reconstructing Config or policy. A
+    /// second adoption (also after uncertainty) cannot recover this custody.
+    pub fn adopt_selected_start(
+        &self,
+        selected: &mut SelectedStartInputs,
+    ) -> io::Result<SelectedStartAdoption> {
+        self.with_current_selected_start(selected, || ())?;
+        let policy = Arc::clone(&selected.policy);
+        policy.with_current(|| {
+            let inputs = selected
+                .inputs
+                .take()
+                .ok_or_else(|| io::Error::other("selected start already consumed"))?;
+            let options = match inputs {
+                Inputs::Options(options) => options,
+                Inputs::Mcp(sources) => sources.into_start_options(),
+            };
+            Ok(SelectedStartAdoption {
+                owner: Arc::clone(&self.state),
+                options,
+                policy: Arc::clone(&policy),
+            })
+        })?
+    }
+
+    pub async fn start_selected_start(
+        &self,
+        adoption: SelectedStartAdoption,
+    ) -> CodexResult<NewThread> {
+        if !Arc::ptr_eq(&self.state, &adoption.owner) {
+            return Err(CodexErr::InvalidRequest(
+                "foreign selected start adoption".to_string(),
+            ));
+        }
+        adoption
+            .policy
+            .renew(&adoption.options.config)
+            .await
+            .map_err(|error| CodexErr::InvalidRequest(error.to_string()))?;
+        adoption
+            .policy
+            .with_current(|| ())
+            .map_err(|error| CodexErr::InvalidRequest(error.to_string()))?;
+        Box::pin(self.start_thread_inner_with_policy(
+            adoption.options,
+            /*forked_from_thread_id*/ None,
+            /*startup*/ None,
+            Some(Arc::clone(&adoption.policy.manager)),
+        ))
+        .await
+    }
+}
+
+#[cfg(test)]
+#[path = "selected_start_tests.rs"]
+mod tests;
