+    /// Runs bounded synchronous association under the SAME semaphore used by
+    /// both real policy writers. The action must not await, reenter this owner
+    /// or perform file/loader effects. The guard ends when this call returns.
+    pub(crate) fn with_current<R>(
+        &self,
+        associate: impl FnOnce() -> R,
+    ) -> Result<R, ExecPolicySourceError> {
+        let _permit = self
+            .manager
+            .update_lock
+            .try_acquire()
+            .map_err(|_| ExecPolicySourceError::Busy)?;
+        if !Arc::ptr_eq(&self.source, &self.manager.current()) {
+            return Err(ExecPolicySourceError::Changed);
+        }
+        Ok(associate())
+    }
