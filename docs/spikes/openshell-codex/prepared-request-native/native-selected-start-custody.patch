+/// Read-only outcome of the ORIGINAL migration. Absence of a marker is supported
+/// only when its exact original filter proves no effective policy change.
+/// This is source data, not a filesystem lease or permission to create a marker.
+#[derive(Debug, PartialEq, Eq)]
+pub struct PrefixRuleMigrationObservation {
+    marker_present: bool,
+    unchanged_policy: Option<String>,
+}
+
+pub async fn observe_prefix_rule_migration(
+    codex_home: &Path,
+    policy_path: &Path,
+    banned_prefixes: &[&[&str]],
+) -> io::Result<PrefixRuleMigrationObservation> {
+    let marker_present = tokio::fs::try_exists(codex_home.join(MIGRATION_MARKER_FILENAME)).await?;
+    let unchanged_policy = if marker_present {
+        None
+    } else {
+        let file = match tokio::fs::File::open(policy_path).await {
+            Ok(file) => Some(file),
+            Err(error) if error.kind() == io::ErrorKind::NotFound => None,
+            Err(error) => return Err(error),
+        };
+        match file {
+            None => None,
+            Some(file) => {
+                const MAX_BYTES: u64 = 1024 * 1024;
+                let mut bytes = Vec::new();
+                file.take(MAX_BYTES + 1).read_to_end(&mut bytes).await?;
+                if bytes.len() as u64 > MAX_BYTES {
+                    return Err(io::Error::other("migration policy exceeds capture limit"));
+                }
+                let contents = String::from_utf8(bytes).map_err(io::Error::other)?;
+                if strip_banned_allow_rules(&contents, banned_prefixes) != contents {
+                    return Err(io::Error::other(
+                        "prefix rule migration would change selected policy",
+                    ));
+                }
+                Some(contents)
+            }
+        }
+    };
+    Ok(PrefixRuleMigrationObservation {
+        marker_present,
+        unchanged_policy,
+    })
+}
