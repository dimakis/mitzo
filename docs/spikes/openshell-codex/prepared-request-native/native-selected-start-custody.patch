+
+fn section(id: &'static str, role: &'static str, text: &str) -> ResolvedInitialSection {
+    ResolvedInitialSection {
+        id,
+        origin: WorldStateSectionOrigin::Extension,
+        fragments: vec![ResolvedInitialFragment {
+            rendered: RenderedFragment::new(
+                role,
+                AnnotatedContent::input_text(text, ContentItemKind(format!("{id}.instructions"))),
+            ),
+            start_marker: "",
+            requires_separate_message: false,
+        }],
+    }
+}
+
+fn render(data: ResolvedInitialWorldState) -> Vec<ResponseItem> {
+    render_initial_context(InitialContextRenderInput {
+        world_state: data,
+        developer_sections: Vec::new(),
+        contextual_user_sections: Vec::new(),
+        separate_developer_sections: Vec::new(),
+        recommended_plugins: None,
+        separate_guardian_developer_message: false,
+        developer_instructions: None,
+        turn_id: "ordinary-turn",
+    })
+}
+
+#[test]
+fn plain_sections_share_ordinary_skill_placement_and_never_reenter_callbacks() {
+    let calls = Arc::new(AtomicUsize::new(0));
+    let mut ordinary = WorldState::default();
+    let mut sections = Vec::new();
+    for (id, role, text) in [
+        ("permissions", "developer", "Original permission bytes\n"),
+        ("environment", "user", "Original environment λ\n  "),
+        ("host_skills", "developer", "Original skill bytes\n"),
+        ("ignored", "assistant", "Original unsupported role"),
+    ] {
+        let observed = Arc::clone(&calls);
+        ordinary.add_extension_section(WorldStateSectionContribution::new(
+            id,
+            serde_json::json!({"version": 1}),
+            move |_| {
+                observed.fetch_add(1, Ordering::SeqCst);
+                Some(RenderedWorldStateFragment::new(role, ("", ""), text))
+            },
+        ));
+        sections.push(section(id, role, text));
+    }
+    let ordinary_items = render(collect_initial_world_state(&ordinary));
+    assert_eq!(calls.load(Ordering::SeqCst), 4);
+    let data = ResolvedInitialWorldState::from_sections(sections);
+    assert_eq!(render(data.clone()), ordinary_items);
+    assert_eq!(render(data), ordinary_items);
+    assert_eq!(calls.load(Ordering::SeqCst), 4);
+    let first = serde_json::to_string(&ordinary_items[0]).expect("developer item");
+    assert!(
+        first.find("Original skill bytes").unwrap()
+            < first.find("Original permission bytes").unwrap()
+    );
+}
