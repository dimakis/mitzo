@@ -0,0 +1,68 @@
+//! Passive observation of the original in-memory policy publisher only.
+//!
+//! This does not lease policy files, effective configuration or selection, run
+//! startup migration, or create a policy owner for a fresh thread. A future
+//! consumer must retain/adopt this same original manager and settle those other
+//! sources separately before it can associate a native request.
+use super::AllowPrefixRules;
+use super::ExecPolicyManager;
+use super::model_policy::project_for_prefix_rules;
+use codex_execpolicy::Policy;
+use std::sync::Arc;
+
+pub(crate) struct ExecPolicySourceObservation<'a> {
+    manager: &'a ExecPolicyManager,
+    source: Arc<Policy>,
+    projected: Arc<Policy>,
+}
+
+#[derive(Debug, PartialEq, Eq)]
+pub(crate) enum ExecPolicySourceError {
+    Busy,
+    Changed,
+}
+
+impl ExecPolicyManager {
+    /// Captures the original publication before the ordinary model projection.
+    /// Equal filtered bytes cannot hide a replacement of that publication.
+    pub(crate) fn observe_for_prefix_rules(
+        &self,
+        selection: AllowPrefixRules,
+    ) -> ExecPolicySourceObservation<'_> {
+        let source = self.current();
+        let projected = project_for_prefix_rules(Arc::clone(&source), selection);
+        ExecPolicySourceObservation {
+            manager: self,
+            source,
+            projected,
+        }
+    }
+}
+
+impl ExecPolicySourceObservation<'_> {
+    pub(crate) fn policy(&self) -> &Arc<Policy> {
+        &self.projected
+    }
