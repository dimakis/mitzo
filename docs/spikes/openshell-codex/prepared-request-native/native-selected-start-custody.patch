+#[test]
+fn complete_context_registration_binding_orders_actual_heterogeneous_sources() {
+    let mut builder = ExtensionRegistryBuilder::<()>::new();
+    builder.prompt_context_source(Arc::new(AllContributors));
+    builder.coupled_context_contributor(Arc::new(AllContributors));
+    let registry = builder.build();
+    let prompt = registry.registered_prompt_context_sources::<AllContributors>();
+    let coupled = registry.registered_context_sources::<AllContributors>();
+    let bound = registry
+        .bind_context_source_registrations(vec![
+            registry.context_source_identity(&coupled[0]).unwrap(),
+            registry.prompt_source_identity(&prompt[0]).unwrap(),
+        ])
+        .unwrap();
+    assert_eq!(bound.registration_indexes().collect::<Vec<_>>(), vec![0, 1]);
+    assert_eq!(
+        registry.assert_bound_context_source_registrations(&bound),
+        Ok(())
+    );
+    let copied = registry.to_builder().build();
+    assert_eq!(
+        copied.assert_bound_context_source_registrations(&bound),
+        Err(codex_extension_api::ContextSourceRegistrationError::RegistryChanged),
+    );
+    assert_eq!(
+        copied.prompt_source_identity(&prompt[0]).err(),
+        Some(codex_extension_api::ContextSourceRegistrationError::RegistryChanged),
+    );
+}
+
+#[test]
+fn context_registration_binding_refuses_missing_duplicate_or_legacy_sources() {
+    let mut builder = ExtensionRegistryBuilder::<()>::new();
+    builder.prompt_context_source(Arc::new(AllContributors));
+    builder.prompt_context_source(Arc::new(AllContributors));
+    let registry = builder.build();
+    let prompt = registry.registered_prompt_context_sources::<AllContributors>();
+    for identities in [
+        Vec::new(),
+        vec![registry.prompt_source_identity(&prompt[0]).unwrap()],
+        vec![
+            registry.prompt_source_identity(&prompt[0]).unwrap(),
+            registry.prompt_source_identity(&prompt[0]).unwrap(),
+        ],
+    ] {
+        assert_eq!(
+            registry.bind_context_source_registrations(identities).err(),
+            Some(codex_extension_api::ContextSourceRegistrationError::ContributorsChanged),
+        );
+    }
+    let mut with_legacy = registry.to_builder();
+    with_legacy.prompt_contributor(Arc::new(AllContributors));
+    let with_legacy = with_legacy.build();
+    let identities = with_legacy
+        .registered_prompt_context_sources::<AllContributors>()
+        .iter()
+        .map(|source| with_legacy.prompt_source_identity(source).unwrap())
+        .collect();
+    assert_eq!(
+        with_legacy
+            .bind_context_source_registrations(identities)
+            .err(),
+        Some(codex_extension_api::ContextSourceRegistrationError::ContributorsChanged),
+    );
+}
