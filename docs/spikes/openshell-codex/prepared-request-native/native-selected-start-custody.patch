+use super::*;
+use crate::config::ConfigBuilder;
+use codex_config::LoaderOverrides;
+use codex_exec_server::EnvironmentManager;
+use pretty_assertions::assert_eq;
+
+async fn fixture() -> (tempfile::TempDir, Config, ThreadManager) {
+    let home = tempfile::tempdir().unwrap();
+    let config = ConfigBuilder::default()
+        .codex_home(home.path().to_path_buf())
+        .loader_overrides(LoaderOverrides::with_managed_config_path_for_tests(
+            home.path().join("managed.toml"),
+        ))
+        .fallback_cwd(Some(home.path().to_path_buf()))
+        .build()
+        .await
+        .unwrap();
+    let manager = ThreadManager::with_models_provider_and_home_for_tests(
+        CodexAuth::from_api_key("synthetic-no-network"),
+        config.model_provider.clone(),
+        home.path().to_path_buf(),
+        Arc::new(EnvironmentManager::default_for_tests()),
+    );
+    (home, config, manager)
+}
+
+#[tokio::test]
+async fn selected_start_restores_actual_options_and_same_strict_policy_once_without_session() {
+    let (home, config, manager) = fixture().await;
+    let mut options = StartThreadOptions::new(config.clone());
+    options.metrics_service_name = Some("retained-source".to_string());
+    options.disabled_plugin_ids = Some(vec!["retained-selection".to_string()]);
+    let mut created = manager.state.thread_created_tx.subscribe();
+    let mut selected = manager.prepare_selected_start(options).await.unwrap();
+    assert_eq!(&selected.start_options().unwrap().config, &config);
+    let policy = Arc::clone(&selected.policy.manager);
+    let publication = Arc::clone(selected.policy());
+    manager.renew_selected_start(&selected).await.unwrap();
+    let adopted = manager.adopt_selected_start(&mut selected).unwrap();
+    assert!(Arc::ptr_eq(&policy, &adopted.policy.manager));
+    assert!(Arc::ptr_eq(&publication, &adopted.policy.manager.current()));
+    assert_eq!(adopted.options.config, config);
+    assert_eq!(
+        adopted.options.metrics_service_name.as_deref(),
+        Some("retained-source")
+    );
+    assert_eq!(
+        adopted.options.disabled_plugin_ids,
+        Some(vec!["retained-selection".to_string()])
+    );
+    assert!(adopted.options.environments.is_some());
+    assert!(adopted.options.reserved_thread_id.is_none());
+    assert!(manager.adopt_selected_start(&mut selected).is_err());
+    assert!(manager.state.threads.read().await.is_empty());
+    assert!(matches!(
+        created.try_recv(),
+        Err(tokio::sync::broadcast::error::TryRecvError::Empty)
+    ));
+    assert!(!home.path().join(".sandbox_migration").exists());
+}
+
+#[tokio::test]
+async fn strict_parse_and_migration_changes_refuse_without_writes_or_fallback() {
+    let (home, config, manager) = fixture().await;
+    let rules = home.path().join("rules");
+    std::fs::create_dir_all(&rules).unwrap();
+    let path = rules.join("default.rules");
+    let invalid = "prefix_rule(not valid";
+    std::fs::write(&path, invalid).unwrap();
+    assert!(
+        manager
+            .prepare_selected_start(StartThreadOptions::new(config.clone()))
+            .await
+            .is_err()
+    );
+    assert_eq!(std::fs::read_to_string(&path).unwrap(), invalid);
+    let migration = "prefix_rule(pattern=[\"git\"], decision=\"allow\")\n";
+    std::fs::write(&path, migration).unwrap();
+    assert!(
+        manager
+            .prepare_selected_start(StartThreadOptions::new(config))
+            .await
+            .is_err()
+    );
+    assert_eq!(std::fs::read_to_string(&path).unwrap(), migration);
+    assert!(!home.path().join(".sandbox_migration").exists());
+}
+
+#[tokio::test]
+async fn foreign_owner_changed_files_and_real_policy_writer_refuse() {
+    let (home, config, manager) = fixture().await;
+    let (_, _, foreign) = fixture().await;
+    let mut selected = manager
+        .prepare_selected_start(StartThreadOptions::new(config.clone()))
+        .await
+        .unwrap();
+    assert!(foreign.adopt_selected_start(&mut selected).is_err());
+    std::fs::create_dir_all(home.path().join("rules")).unwrap();
+    std::fs::write(
+        home.path().join("rules/added.rules"),
+        "prefix_rule(pattern=[\"echo\"], decision=\"prompt\")\n",
+    )
+    .unwrap();
+    assert!(manager.renew_selected_start(&selected).await.is_err());
+    // A newly selected packet isolates the actual writer rejection from the
+    // preceding external-file invalidation.
+    let mut selected = manager
+        .prepare_selected_start(StartThreadOptions::new(config))
+        .await
+        .unwrap();
+    selected
+        .policy
+        .manager
+        .append_network_rule_and_update(
+            home.path(),
+            "example.invalid",
+            codex_execpolicy::NetworkRuleProtocol::Https,
+            codex_execpolicy::Decision::Forbidden,
+            /*justification*/ None,
+        )
+        .await
+        .unwrap();
+    let mut associated = false;
+    assert!(
+        manager
+            .with_current_selected_start(&selected, || associated = true)
+            .is_err()
+    );
+    assert!(!associated);
+    assert!(manager.adopt_selected_start(&mut selected).is_err());
+}
