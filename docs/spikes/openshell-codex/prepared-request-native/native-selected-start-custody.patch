@@ -0,0 +1,89 @@
+//! Selected original System clock data at the genuine fresh-start boundary.
+//!
+//! This observes the environment-date partition only. It is not a wall-clock,
+//! timezone or configuration lease, and cannot count, associate, release effects
+//! or make a request Ready. A completed factory must retain the exact rendered
+//! bytes and renew/adopt its original selection at the final operation; a TTL
+//! cannot establish currency. Reminder and nonfatal-error history partitions
+//! remain separate. No Session, synthetic ThreadId or External callback runs.
+
+use chrono::DateTime;
+use chrono::Utc;
+use codex_features::CurrentTimeSource;
+
+use super::ThreadManager;
+use crate::PreSessionMcpError;
+use crate::PreSessionMcpSources;
+use crate::current_time::SystemTimeProvider;
+use crate::current_time::environment_date;
+use crate::current_time::selected_clock_source;
+
+/// Plain original date/timezone data, retaining the actual selected start packet.
+/// Successful observation grants no subsequent source-currentness authority.
+pub struct PreSessionSystemClockObservation<'a> {
+    sources: &'a PreSessionMcpSources,
+    observed_time: DateTime<Utc>,
+    environment_date: String,
+    timezone: String,
+}
+
+#[derive(Debug, PartialEq, Eq)]
+pub enum PreSessionClockError {
+    NativeMcp(PreSessionMcpError),
+    ExternalRequiresThreadBoundary,
+}
+
+impl ThreadManager {
+    /// Reads only the actual selected System source, using the same read and
+    /// date/timezone projection as ordinary startup. An installed External clock
+    /// does not change the configured default, and an explicitly selected one
+    /// must never be replaced with System or addressed through a fake thread.
+    pub fn observe_pre_session_system_clock<'a>(
+        &self,
+        sources: &'a PreSessionMcpSources,
+    ) -> Result<PreSessionSystemClockObservation<'a>, PreSessionClockError> {
+        self.validate_pre_session_mcp_sources(sources)
+            .map_err(PreSessionClockError::NativeMcp)?;
+        match selected_clock_source(
+            sources
+                .start_options()
+                .config
+                .current_time_reminder
+                .as_ref(),
+        ) {
+            CurrentTimeSource::System => {}
+            CurrentTimeSource::External => {
+                return Err(PreSessionClockError::ExternalRequiresThreadBoundary);
+            }
+        }
+        let observed_time = SystemTimeProvider.read_current_time();
+        // Ordinary environment context takes its DATE from the selected clock,
+        // but its TIMEZONE from the independent original local-time selection.
+        // Do not substitute that selection's incidental date for the clock read.
+        let (_, timezone) = crate::session::turn_context::local_time_context();
+        Ok(PreSessionSystemClockObservation {
+            sources,
+            observed_time,
+            environment_date: environment_date(observed_time),
+            timezone,
+        })
+    }
+}
+
+impl<'a> PreSessionSystemClockObservation<'a> {
+    pub fn start_sources(&self) -> &'a PreSessionMcpSources {
+        self.sources
+    }
+
+    pub fn observed_time(&self) -> DateTime<Utc> {
+        self.observed_time
+    }
+
+    pub fn environment_date(&self) -> &str {
+        &self.environment_date
+    }
+
+    pub fn timezone(&self) -> &str {
+        &self.timezone
+    }
+}
