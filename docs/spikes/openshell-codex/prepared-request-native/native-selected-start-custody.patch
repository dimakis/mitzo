@@ -0,0 +1,100 @@
+//! Strict original policy custody, with bounded source fences and no migration.
+use super::*;
+use codex_execpolicy::PrefixRuleMigrationObservation;
+use codex_execpolicy::observe_prefix_rule_migration;
+use std::io;
+use tokio::io::AsyncReadExt;
+
+pub(crate) struct SelectedStartPolicy {
+    pub(crate) manager: Arc<ExecPolicyManager>,
+    publication: Arc<Policy>,
+    files: Vec<(PathBuf, String)>,
+    migration: Option<PrefixRuleMigrationObservation>,
+}
+
+async fn files(config: &Config) -> io::Result<Vec<(PathBuf, String)>> {
+    const MAX_FILE_BYTES: u64 = 1024 * 1024;
+    const MAX_TOTAL_BYTES: usize = 8 * 1024 * 1024;
+    let mut sources = Vec::new();
+    let mut total = 0;
+    let paths = selected_policy_paths(&config.config_layer_stack)
+        .await
+        .map_err(io::Error::other)?;
+    if paths.len() > 128 {
+        return Err(io::Error::other("too many selected policy files"));
+    }
+    for path in paths {
+        let file = fs::File::open(&path).await?;
+        let mut bytes = Vec::new();
+        file.take(MAX_FILE_BYTES + 1)
+            .read_to_end(&mut bytes)
+            .await?;
+        total += bytes.len();
+        if bytes.len() as u64 > MAX_FILE_BYTES || total > MAX_TOTAL_BYTES {
+            return Err(io::Error::other("selected policy exceeds capture limit"));
+        }
+        sources.push((path, String::from_utf8(bytes).map_err(io::Error::other)?));
+    }
+    Ok(sources)
+}
+
+async fn migration(config: &Config) -> io::Result<Option<PrefixRuleMigrationObservation>> {
+    if config
+        .config_layer_stack
+        .ignore_user_and_project_exec_policy_rules()
+    {
+        return Ok(None);
+    }
+    observe_prefix_rule_migration(
+        &config.codex_home,
+        &default_policy_path(&config.codex_home),
+        BANNED_PREFIX_SUGGESTIONS,
+    )
+    .await
+    .map(Some)
+}
+
+impl SelectedStartPolicy {
+    pub(crate) async fn load(config: &Config) -> io::Result<Self> {
+        // Follow the original migration participation flag. Never create its
+        // marker or edit rules during selected-start preparation.
+        let migration = migration(config).await?;
+        let sources = files(config).await?;
+        let policy = Arc::new(
+            parse_selected_policy(&config.config_layer_stack, &sources)
+                .map_err(io::Error::other)?,
+        );
+        let selected = Self {
+            manager: Arc::new(ExecPolicyManager::new(Arc::clone(&policy))),
+            publication: policy,
+            files: sources,
+            migration,
+        };
+        selected.renew(config).await?;
+        Ok(selected)
+    }
+
+    pub(crate) async fn renew(&self, config: &Config) -> io::Result<()> {
+        let migration = migration(config).await?;
+        if migration != self.migration || files(config).await? != self.files {
+            return Err(io::Error::other("selected policy sources changed"));
+        }
+        self.with_current(|| ())
+    }
+
+    pub(crate) fn policy(&self) -> &Arc<Policy> {
+        &self.publication
+    }
+
+    pub(crate) fn with_current<R>(&self, associate: impl FnOnce() -> R) -> io::Result<R> {
+        let _permit = self
+            .manager
+            .update_lock
+            .try_acquire()
+            .map_err(|_| io::Error::other("selected policy writer busy"))?;
+        if !Arc::ptr_eq(&self.publication, &self.manager.current()) {
+            return Err(io::Error::other("selected policy publication changed"));
+        }
+        Ok(associate())
+    }
+}
