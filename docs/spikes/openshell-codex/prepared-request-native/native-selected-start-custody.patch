+//! Native section placement shared by ordinary and resolved-data collection.
+//! This is ordering only, not contributor coverage or source authority.
+use super::PermissionsState;
+use super::WorldStateSection;
+use indexmap::IndexMap;
+
+#[derive(Clone, Copy, Debug)]
+pub(crate) enum WorldStateSectionOrigin {
+    Native,
+    Extension,
+}
+
+pub(crate) fn insert_ordered_section<T>(
+    sections: &mut IndexMap<&'static str, T>,
+    id: &'static str,
+    section: T,
+    origin: WorldStateSectionOrigin,
+) {
+    assert!(
+        !sections.contains_key(id),
+        "duplicate world-state section ID: {id}"
+    );
+    if matches!(origin, WorldStateSectionOrigin::Extension)
+        && id == "host_skills"
+        && let Some(index) = sections.get_index_of(PermissionsState::ID)
+    {
+        sections.shift_insert(index, id, section);
+    } else {
+        sections.insert(id, section);
+    }
+}
