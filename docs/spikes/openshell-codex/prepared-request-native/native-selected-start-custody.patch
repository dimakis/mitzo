+#[should_panic(expected = "duplicate world-state section ID: permissions")]
+fn plain_sections_reject_duplicate_ids_even_when_the_first_has_no_fragment() {
+    let mut first = section("permissions", "developer", "");
+    first.fragments.clear();
+    ResolvedInitialWorldState::from_sections(vec![
+        first,
+        section("permissions", "developer", "replacement"),
+    ]);
+}
