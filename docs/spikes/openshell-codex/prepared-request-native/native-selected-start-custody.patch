diff --git a/codex-rs/app-server/src/runtime_feature_source.rs b/codex-rs/app-server/src/runtime_feature_source.rs
new file mode 100644
index 0000000000000000000000000000000000000000..de759148d3c42ec1de5b9fba4ad073a25055ca9f
--- /dev/null
+++ b/codex-rs/app-server/src/runtime_feature_source.rs
@@ -0,0 +1,79 @@
+//! The actual ConfigManager runtime-feature input publisher, not a second epoch.
+//!
+//! Each real writer replaces its immutable DATA Arc under the existing lock.
+//! This guards that input partition only. It does not cover materialized Config,
+//! permissions, files, managed/cloud inputs or a selected start, and grants no
+//! whole-factory/count/State/admission authority. Ordinary projection is unchanged.
+#![cfg_attr(
+    not(test),
+    allow(dead_code, reason = "Fresh selected configuration is being connected.")
+)]
+
+use super::ConfigManager;
+use std::collections::BTreeMap;
+use std::sync::Arc;
+use std::sync::TryLockError;
+
+pub(crate) struct RuntimeFeatureSourceObservation<'a> {
+    manager: &'a ConfigManager,
+    publication: Arc<BTreeMap<String, bool>>,
+}
+
+#[derive(Debug, PartialEq, Eq)]
+pub(crate) enum RuntimeFeatureSourceError {
+    Busy,
+    Poisoned,
+    Changed,
+}
+
+impl ConfigManager {
+    /// Observes the original immutable published input. No loader or external
+    /// callback runs, and no lock survives into asynchronous source work.
+    pub(crate) fn observe_runtime_feature_source(
+        &self,
+    ) -> Result<RuntimeFeatureSourceObservation<'_>, RuntimeFeatureSourceError> {
+        let current = self
+            .runtime_feature_enablement
+            .try_read()
+            .map_err(lock_error)?;
+        Ok(RuntimeFeatureSourceObservation {
+            manager: self,
+            publication: Arc::clone(&current),
+        })
+    }
+}
+
+fn lock_error<T>(error: TryLockError<T>) -> RuntimeFeatureSourceError {
+    match error {
+        TryLockError::WouldBlock => RuntimeFeatureSourceError::Busy,
+        TryLockError::Poisoned(_) => RuntimeFeatureSourceError::Poisoned,
+    }
+}
+
+impl RuntimeFeatureSourceObservation<'_> {
+    pub(crate) fn features(&self) -> &BTreeMap<String, bool> {
+        &self.publication
+    }
+
+    /// Orders only this input's real writer with a bounded synchronous action.
+    /// Do not await, perform loader/file work or reenter this publisher inside
+    /// the action. All remaining configuration owners must be fenced separately.
+    pub(crate) fn with_current<R>(
+        &self,
+        associate: impl FnOnce() -> R,
+    ) -> Result<R, RuntimeFeatureSourceError> {
+        let current = self
+            .manager
+            .runtime_feature_enablement
+            .try_read()
+            .map_err(lock_error)?;
+        if !Arc::ptr_eq(&current, &self.publication) {
+            return Err(RuntimeFeatureSourceError::Changed);
+        }
+        Ok(associate())
+    }
+}
+
+#[cfg(test)]
+#[path = "runtime_feature_source_tests.rs"]
+mod tests;
