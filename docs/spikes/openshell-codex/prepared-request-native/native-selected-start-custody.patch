@@ -0,0 +1,116 @@
+use super::*;
+use pretty_assertions::assert_eq;
+use std::sync::mpsc;
+use std::time::Duration;
+
+#[tokio::test]
+async fn the_original_config_loader_uses_the_actual_published_runtime_feature_data() {
+    let home = tempfile::tempdir().unwrap();
+    let manager = ConfigManager::without_managed_config_for_tests(home.path().to_path_buf());
+    manager
+        .extend_runtime_feature_enablement([("apps".to_string(), false)])
+        .unwrap();
+    let observed = manager.observe_runtime_feature_source().unwrap();
+    let load = || {
+        manager.load_for_cwd(
+            /*request_overrides*/ None,
+            codex_core::config::ConfigOverrides::default(),
+            Some(home.path().to_path_buf()),
+        )
+    };
+    let first = load().await.unwrap();
+    assert!(!first.features.enabled(codex_features::Feature::Apps));
+    assert_eq!(
+        observed.with_current(|| observed.features().clone()),
+        Ok(BTreeMap::from([("apps".to_string(), false)])),
+    );
+    manager
+        .extend_runtime_feature_enablement([("apps".to_string(), true)])
+        .unwrap();
+    let second = load().await.unwrap();
+    assert!(second.features.enabled(codex_features::Feature::Apps));
+    assert_eq!(
+        observed.with_current(|| ()),
+        Err(RuntimeFeatureSourceError::Changed),
+    );
+}
+
+#[test]
+fn actual_runtime_writer_restoring_equal_values_invalidates_the_original_publication() {
+    let home = tempfile::tempdir().unwrap();
+    let manager = ConfigManager::without_managed_config_for_tests(home.path().to_path_buf());
+    manager
+        .extend_runtime_feature_enablement([("apps".to_string(), true)])
+        .unwrap();
+    let observed = manager.observe_runtime_feature_source().unwrap();
+    manager
+        .extend_runtime_feature_enablement([("apps".to_string(), false)])
+        .unwrap();
+    manager
+        .extend_runtime_feature_enablement([("apps".to_string(), true)])
+        .unwrap();
+    assert_eq!(
+        observed.features(),
+        &manager.current_runtime_feature_enablement()
+    );
+    let mut associated = false;
+    assert_eq!(
+        observed.with_current(|| associated = true),
+        Err(RuntimeFeatureSourceError::Changed),
+    );
+    assert!(!associated);
+}
+
+#[test]
+fn association_holds_the_actual_runtime_writer_lock_through_its_bounded_action() {
+    let home = tempfile::tempdir().unwrap();
+    let manager = Arc::new(ConfigManager::without_managed_config_for_tests(
+        home.path().to_path_buf(),
+    ));
+    let observed = manager.observe_runtime_feature_source().unwrap();
+    let (started_tx, started_rx) = mpsc::channel();
+    let (done_tx, done_rx) = mpsc::channel();
+    let mut writer = None;
+    assert_eq!(
+        observed.with_current(|| {
+            assert!(matches!(
+                manager.runtime_feature_enablement.try_write(),
+                Err(std::sync::TryLockError::WouldBlock),
+            ));
+            let manager = Arc::clone(&manager);
+            writer = Some(std::thread::spawn(move || {
+                started_tx.send(()).unwrap();
+                manager
+                    .extend_runtime_feature_enablement([("apps".to_string(), false)])
+                    .unwrap();
+                done_tx.send(()).unwrap();
+            }));
+            started_rx.recv_timeout(Duration::from_secs(5)).unwrap();
+            assert_eq!(done_rx.try_recv(), Err(mpsc::TryRecvError::Empty));
+            42
+        }),
+        Ok(42),
+    );
+    writer.unwrap().join().unwrap();
+    done_rx.recv_timeout(Duration::from_secs(5)).unwrap();
+    assert_eq!(
+        observed.with_current(|| ()),
+        Err(RuntimeFeatureSourceError::Changed),
+    );
+}
+
+#[test]
+fn a_busy_original_writer_refuses_before_the_action_without_blocking_or_reentry() {
+    let home = tempfile::tempdir().unwrap();
+    let manager = ConfigManager::without_managed_config_for_tests(home.path().to_path_buf());
+    let observed = manager.observe_runtime_feature_source().unwrap();
+    let writer = manager.runtime_feature_enablement.write().unwrap();
+    let mut associated = false;
+    assert_eq!(
+        observed.with_current(|| associated = true),
+        Err(RuntimeFeatureSourceError::Busy),
+    );
+    assert!(!associated);
+    drop(writer);
+    assert_eq!(observed.with_current(|| 42), Ok(42));
+}
diff --git a/codex-rs/app-server/src/selected_start_config.rs b/codex-rs/app-server/src/selected_start_config.rs
new file mode 100644
index 0000000000000000000000000000000000000000..06a3cfc6959bb35fc9b3fc7f12cd883e5dedd63b
--- /dev/null
+++ b/codex-rs/app-server/src/selected_start_config.rs
@@ -0,0 +1,293 @@
+//! Original selected-start configuration custody. External files/MDM are renewed
+//! by bounded load fences, not an atomic filesystem lease. No Session or Ready.
+#![cfg_attr(
+    not(test),
+    allow(
+        dead_code,
+        reason = "Original selected-start custody awaits the complete factory."
+    )
+)]
+
+use super::ConfigManager;
+use super::runtime_feature_source::RuntimeFeatureSourceObservation;
+use codex_config::loader::project_trust_key;
+use codex_core::SelectedStartInputs;
+use codex_core::StartThreadOptions;
+use codex_core::ThreadManager;
+use codex_core::config::Config;
+use codex_core::config::ConfigOverrides;
+use codex_exec_server::LOCAL_FS;
+use codex_git_utils::resolve_root_git_project_for_trust;
+use codex_protocol::config_types::TrustLevel;
+use std::collections::HashMap;
+use std::io;
+use std::sync::atomic::AtomicBool;
+use std::sync::atomic::Ordering;
+use toml::Value as TomlValue;
+use tracing::warn;
+
+enum TrustPersistence {
+    Ordinary,
+    RefuseChange,
+}
+
+/// Minted only by this ConfigManager's actual ordinary loader. Not serializable,
+/// cloneable or constructible from caller-provided Config/readiness data.
+pub(crate) struct SelectedStartConfig<'a> {
+    manager: &'a ConfigManager,
+    invalidated: AtomicBool,
+    runtime: RuntimeFeatureSourceObservation<'a>,
+    config: Config,
+    request: Option<HashMap<String, serde_json::Value>>,
+    overrides: ConfigOverrides,
+}
+
+pub(crate) struct SelectedConfiguredStart<'a> {
+    source: SelectedStartConfig<'a>,
+    start: SelectedStartInputs,
+}
+
+impl ConfigManager {
+    pub(crate) async fn finish_ordinary_thread_start_config(
+        &self,
+        config: Config,
+        trust_home: &std::path::Path,
+        config_overrides: Option<HashMap<String, serde_json::Value>>,
+        typesafe_overrides: ConfigOverrides,
+    ) -> io::Result<Config> {
+        self.finish_thread_start_config(
+            config,
+            trust_home,
+            config_overrides,
+            typesafe_overrides,
+            TrustPersistence::Ordinary,
+        )
+        .await
+    }
+
+    async fn finish_thread_start_config(
+        &self,
+        mut config: Config,
+        trust_home: &std::path::Path,
+        config_overrides: Option<HashMap<String, serde_json::Value>>,
+        typesafe_overrides: ConfigOverrides,
+        trust: TrustPersistence,
+    ) -> io::Result<Config> {
+        let requested_cwd = typesafe_overrides.cwd.clone();
+        // Project-local config can launch host processes, so only the effective
+        // permissions after managed constraints can imply project trust.
+        let effective_permission_profile = config.permissions.effective_permission_profile();
+        let effective_permissions_trust_project = match &effective_permission_profile {
+            codex_protocol::models::PermissionProfile::Disabled
+            | codex_protocol::models::PermissionProfile::External { .. } => true,
+            codex_protocol::models::PermissionProfile::Managed { .. } => {
+                effective_permission_profile
+                    .file_system_sandbox_policy()
+                    .can_write_local_path_with_cwd(config.cwd.as_path(), config.cwd.as_path())
+            }
+        };
+
+        if requested_cwd.is_some()
+            && config.active_project.trust_level.is_none()
+            && !config.config_layer_stack.is_projectless()
+            && effective_permissions_trust_project
+        {
+            if matches!(trust, TrustPersistence::RefuseChange) {
+                return Err(std::io::Error::other(
+                    "selected start requires unresolved project trust persistence",
+                ));
+            }
+            let trust_target = resolve_root_git_project_for_trust(LOCAL_FS.as_ref(), &config.cwd)
+                .await
+                .unwrap_or_else(|| config.cwd.clone());
+            let current_cli_overrides = self.current_cli_overrides();
+            let cli_overrides_with_trust;
+            let cli_overrides_for_reload = if let Err(err) =
+                codex_core::config::set_project_trust_level(
+                    trust_home,
+                    trust_target.as_path(),
+                    TrustLevel::Trusted,
+                ) {
+                warn!(
+                    "failed to persist trusted project state for {}; continuing with in-memory trust for this thread: {err}",
+                    trust_target.display()
+                );
+                let mut project = toml::map::Map::new();
+                project.insert(
+                    "trust_level".to_string(),
+                    TomlValue::String("trusted".to_string()),
+                );
+                let mut projects = toml::map::Map::new();
+                projects.insert(
+                    project_trust_key(trust_target.as_path()),
+                    TomlValue::Table(project),
+                );
+                cli_overrides_with_trust = current_cli_overrides
+                    .iter()
+                    .cloned()
+                    .chain(std::iter::once((
+                        "projects".to_string(),
+                        TomlValue::Table(projects),
+                    )))
+                    .collect::<Vec<_>>();
+                cli_overrides_with_trust.as_slice()
+            } else {
+                current_cli_overrides.as_slice()
+            };
+
+            config = self
+                .load_with_cli_overrides(
+                    cli_overrides_for_reload,
+                    config_overrides,
+                    typesafe_overrides,
+                    /*fallback_cwd*/ None,
+                )
+                .await?;
+        }
+
+        Ok(config)
+    }
+
+    pub(crate) async fn load_selected_start_config(
+        &self,
+        request: Option<HashMap<String, serde_json::Value>>,
+        overrides: ConfigOverrides,
+    ) -> io::Result<SelectedStartConfig<'_>> {
+        let runtime = self
+            .observe_runtime_feature_source()
+            .map_err(|_| io::Error::other("runtime feature publication unavailable"))?;
+        let loaded = self
+            .load_with_overrides(request.clone(), overrides.clone())
+            .await?;
+        let config = self
+            .finish_thread_start_config(
+                loaded,
+                &self.codex_home,
+                request.clone(),
+                overrides.clone(),
+                TrustPersistence::RefuseChange,
+            )
+            .await?;
+        let selected = SelectedStartConfig {
+            manager: self,
+            invalidated: AtomicBool::new(false),
+            runtime,
+            config,
+            request,
+            overrides,
+        };
+        selected.renew().await?;
+        Ok(selected)
+    }
+}
+
+impl<'a> SelectedStartConfig<'a> {
+    pub(crate) fn config(&self) -> &Config {
+        &self.config
+    }
+
+    /// Reuses the real loader and exact selectors. A successful bounded before/
+    /// after comparison is not a lease over uncoordinated external writers.
+    async fn renew(&self) -> io::Result<()> {
+        if self.invalidated.load(Ordering::Acquire) {
+            return Err(io::Error::other("selected start source was invalidated"));
+        }
+        let result = async {
+            let current = self
+                .manager
+                .load_with_overrides(self.request.clone(), self.overrides.clone())
+                .await?;
+            if current != self.config {
+                return Err(io::Error::other("selected start configuration changed"));
+            }
+            self.runtime
+                .with_current(|| ())
+                .map_err(|_| io::Error::other("runtime feature publication changed"))
+        }
+        .await;
+        if result.is_err() {
+            self.invalidated.store(true, Ordering::Release);
+        }
+        result
+    }
+
+    pub(crate) async fn capture(
+        self,
+        manager: &ThreadManager,
+        mut options: StartThreadOptions,
+    ) -> io::Result<SelectedConfiguredStart<'a>> {
+        if options.config != self.config {
+            return Err(io::Error::other(
+                "selected start configuration was replaced",
+            ));
+        }
+        // The equality gate refuses caller changes; use the original owner's
+        // materialized data rather than treating an equal caller Config as custody.
+        options.config = self.config.clone();
+        let start = manager
+            .prepare_selected_start(options)
+            .await
+            .map_err(io::Error::other)?;
+        self.renew().await?;
+        Ok(SelectedConfiguredStart {
+            source: self,
+            start,
+        })
+    }
+}
+
+impl SelectedConfiguredStart<'_> {
+    pub(crate) fn start(&self) -> &SelectedStartInputs {
+        &self.start
+    }
+    pub(crate) fn capture_api_mcp(
+        &mut self,
+        manager: &ThreadManager,
+        credentials: codex_login::auth::CapturedApiKeyCredentials,
+    ) -> io::Result<()> {
+        manager.capture_selected_start_api_mcp(&mut self.start, credentials)
+    }
+
+    pub(crate) async fn renew(&self, manager: &ThreadManager) -> io::Result<()> {
+        self.source.renew().await?;
+        manager
+            .renew_selected_start(&self.start)
+            .await
+            .map_err(io::Error::other)?;
+        self.source.renew().await
+    }
+
+    pub(crate) fn adopt(
+        &mut self,
+        manager: &ThreadManager,
+    ) -> io::Result<codex_core::SelectedStartAdoption> {
+        if self.source.invalidated.load(Ordering::Acquire) {
+            return Err(io::Error::other("selected start source was invalidated"));
+        }
+        self.source
+            .runtime
+            .with_current(|| manager.adopt_selected_start(&mut self.start))
+            .map_err(|_| io::Error::other("runtime feature publication changed"))?
+    }
+
+    /// Only original controlled publications are locked here. Call renew first;
+    /// no loader/I/O/await/reentry is permitted inside the synchronous action.
+    pub(crate) fn with_current<R>(
+        &self,
+        manager: &ThreadManager,
+        associate: impl FnOnce() -> R,
+    ) -> io::Result<R> {
+        if self.source.invalidated.load(Ordering::Acquire) {
+            return Err(io::Error::other("selected start source was invalidated"));
+        }
+        self.source
+            .runtime
+            .with_current(|| manager.with_current_selected_start(&self.start, associate))
+            .map_err(|_| io::Error::other("runtime feature publication changed"))?
+            .map_err(io::Error::other)
+    }
+}
+
