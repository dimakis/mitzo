+use std::sync::Arc;
+use std::sync::atomic::AtomicUsize;
+use std::sync::atomic::Ordering;
+
+struct UnknownContext(Arc<AtomicUsize>);
+impl ContextContributor for UnknownContext {
+    fn contribute_thread_context<'a>(
+        &'a self,
+        _session: &'a ExtensionData,
+        _thread: &'a ExtensionData,
+    ) -> ExtensionFuture<'a, Vec<PromptFragment>> {
+        Box::pin(async move {
+            self.0.fetch_add(1, Ordering::SeqCst);
+            Vec::new()
+        })
+    }
+}
+
+enum RegistryFixture {
+    Installed,
+    AdditionalUnknown,
+    ExternalClock,
+}
+
+struct UnexpectedExternalClock;
+impl codex_core::TimeProvider for UnexpectedExternalClock {
+    fn current_time(&self, _thread_id: codex_protocol::ThreadId) -> codex_core::TimeFuture<'_> {
+        panic!("threadless System capture must not invoke the installed External clock")
+    }
+
+    fn sleep(
+        &self,
+        _thread_id: codex_protocol::ThreadId,
+        _duration: std::time::Duration,
+    ) -> codex_core::SleepFuture<'_> {
+        panic!("threadless capture must not wait on the installed External clock")
+    }
+}
+
+async fn original_manager(
+    base_url: &str,
+    fixture: RegistryFixture,
+) -> (
+    tempfile::TempDir,
+    Config,
+    Arc<AuthManager>,
+    Arc<ThreadManager>,
+    Arc<AtomicUsize>,
+) {
+    let home = tempfile::tempdir().unwrap();
+    let clock_config = if matches!(&fixture, RegistryFixture::ExternalClock) {
+        "[features.current_time_reminder]\nenabled = true\nclock_source = 'external'\n"
+    } else {
+        ""
+    };
+    std::fs::write(
+        home.path().join(codex_config::CONFIG_TOML_FILE),
+        format!("model = 'gpt-6-luna'\nchatgpt_base_url = '{base_url}'\n{clock_config}"),
+    )
+    .unwrap();
+    let config = ConfigManager::without_managed_config_for_tests(home.path().to_path_buf())
+        .load_for_cwd(
+            /*request_overrides*/ None,
+            ConfigOverrides::default(),
+            Some(home.path().to_path_buf()),
+        )
+        .await
+        .unwrap();
+    // Observe original enabled defaults, never clear them to qualify capture.
+    assert!(config.features.enabled(Feature::Apps));
+    assert!(config.features.enabled(Feature::Plugins));
+    let auth = AuthManager::from_auth_for_testing(CodexAuth::from_api_key("offline-no-model-call"));
+    let state_db = codex_core::init_state_db(&config).await.unwrap();
+    let thread_store = codex_core::thread_store_from_config(&config, Some(state_db.clone()));
+    let environments = Arc::new(EnvironmentManager::default_for_tests());
+    let executor = Arc::new(
+        codex_skills_extension::ExecutorSkillProvider::new_with_restriction_product(
+            Arc::clone(&environments),
+            SessionSource::Exec.restriction_product(),
+        ),
+    );
+    let calls = Arc::new(AtomicUsize::new(0));
+    let manager = Arc::new_cyclic(|manager| {
+        let registry = thread_extensions(ThreadExtensionDependencies {
+            event_sink: Arc::new(NoopExtensionEventSink),
+            auth_manager: Arc::clone(&auth),
+            state_db: Some(state_db.clone()),
+            analytics_events_client: codex_analytics::AnalyticsEventsClient::disabled(),
+            thread_manager: manager.clone(),
+            goal_service: Arc::new(codex_goal_extension::GoalService::new()),
+            environment_manager: Arc::clone(&environments),
+            executor_skill_provider: Arc::clone(&executor),
+            git_attribution_base_url: config.chatgpt_base_url.clone(),
+            http_client_factory: config.http_client_factory(),
+            queue_service: None,
+            turn_start_admission: None,
+        });
+        let registry = match fixture {
+            RegistryFixture::Installed | RegistryFixture::ExternalClock => registry,
+            RegistryFixture::AdditionalUnknown => {
+                let mut builder = registry.to_builder();
+                builder.prompt_contributor(Arc::new(UnknownContext(Arc::clone(&calls))));
+                Arc::new(builder.build())
+            }
+        };
+        ThreadManager::new(
+            &config,
+            Arc::clone(&auth),
+            codex_core::build_models_manager(&config, Arc::clone(&auth)),
+            codex_core::CodexAppsToolsCache::default(),
+            SessionSource::Exec,
+            Arc::clone(&environments),
+            registry,
+            Arc::new(CodexHomeUserInstructionsProvider::new(
+                config.codex_home.clone(),
+            )),
+            /*analytics_events_client*/ None,
+            codex_core::passthrough_image_store(),
+            Arc::clone(&thread_store),
+            codex_core::local_agent_graph_store_from_state_db(Some(&state_db)),
+            "11111111-1111-4111-8111-111111111111".to_string(),
+            /*attestation_provider*/ None,
+            Some(Arc::new(UnexpectedExternalClock)),
+        )
+    });
+    (home, config, auth, manager, calls)
+}
+
+#[tokio::test]
+async fn actual_app_server_registry_retains_original_context_observations_without_startup() {
+    let backend = wiremock::MockServer::start().await;
+    let (_home, config, auth, manager, calls) =
+        original_manager(&backend.uri(), RegistryFixture::Installed).await;
+    let sources = manager
+        .capture_pre_session_api_key_mcp_sources(
+            StartThreadOptions::new(config),
+            auth.capture_cached_api_key_credentials().unwrap(),
+        )
+        .unwrap();
+    let skills = manager
+        .observe_pre_session_skills(&sources, &[])
+        .await
+        .unwrap();
+    let before_clock_read = chrono::Utc::now();
+    let captured = capture_installed_extension_sources(&manager, &sources, &skills).unwrap();
+    let after_clock_read = chrono::Utc::now();
+    let clock = captured.system_clock();
+    assert!(std::ptr::eq(clock.start_sources(), &sources));
+    assert!(before_clock_read <= clock.observed_time());
+    assert!(clock.observed_time() <= after_clock_read);
+    assert_eq!(
+        clock.environment_date(),
+        clock
+            .observed_time()
+            .with_timezone(&chrono::Local)
+            .format("%Y-%m-%d")
+            .to_string(),
+    );
+    assert!(!clock.timezone().is_empty());
+    assert!(std::ptr::eq(captured.manager(), manager.as_ref()));
+    assert!(std::ptr::eq(captured.native_sources(), &sources));
+    assert!(std::ptr::eq(
+        captured.configuration(),
+        &sources.start_options().config
+    ));
+    assert_eq!(captured.history_notes().len(), 1);
+    assert_eq!(captured.memories().len(), 1);
+    assert_eq!(captured.git_attribution().len(), 1);
+    assert!(std::ptr::eq(
+        captured.skills().skills().captured_config(),
+        &sources.start_options().config,
+    ));
+    let registry = manager.pre_session_extension_registry(&sources).unwrap();
+    assert_eq!(
+        captured.registrations().registration_indexes().count(),
+        registry.context_contributors().len(),
+    );
+    assert_eq!(
+        registry.assert_bound_context_source_registrations(captured.registrations()),
+        Ok(()),
+    );
+    assert_eq!(
+        registry
+            .to_builder()
+            .build()
+            .assert_bound_context_source_registrations(captured.registrations()),
+        Err(ContextSourceRegistrationError::RegistryChanged),
+    );
+    assert_eq!(calls.load(Ordering::SeqCst), 0);
+    assert!(manager.list_thread_ids().await.is_empty());
+    assert!(backend.received_requests().await.unwrap().is_empty());
+}
+
+#[tokio::test]
+async fn selected_external_clock_refuses_without_a_fake_thread_or_system_fallback() {
+    let backend = wiremock::MockServer::start().await;
+    let (_home, config, auth, manager, calls) =
+        original_manager(&backend.uri(), RegistryFixture::ExternalClock).await;
+    let sources = manager
+        .capture_pre_session_api_key_mcp_sources(
+            StartThreadOptions::new(config),
+            auth.capture_cached_api_key_credentials().unwrap(),
+        )
+        .unwrap();
+    let skills = manager
+        .observe_pre_session_skills(&sources, &[])
+        .await
+        .unwrap();
+    assert_eq!(
+        capture_installed_extension_sources(&manager, &sources, &skills).err(),
+        Some(AppServerExtensionSourceError::Clock(
+            codex_core::PreSessionClockError::ExternalRequiresThreadBoundary,
+        )),
+    );
+    assert_eq!(calls.load(Ordering::SeqCst), 0);
+    assert!(manager.list_thread_ids().await.is_empty());
+    assert!(backend.received_requests().await.unwrap().is_empty());
+}
+
+#[tokio::test]
+async fn an_actual_extra_legacy_contributor_is_unresolved_even_when_its_callback_returns_empty() {
+    let backend = wiremock::MockServer::start().await;
+    let (_home, config, auth, manager, calls) =
+        original_manager(&backend.uri(), RegistryFixture::AdditionalUnknown).await;
+    let sources = manager
+        .capture_pre_session_api_key_mcp_sources(
+            StartThreadOptions::new(config),
+            auth.capture_cached_api_key_credentials().unwrap(),
+        )
+        .unwrap();
+    let skills = manager
+        .observe_pre_session_skills(&sources, &[])
+        .await
+        .unwrap();
+    assert_eq!(
+        capture_installed_extension_sources(&manager, &sources, &skills).err(),
+        Some(AppServerExtensionSourceError::Registration(
+            ContextSourceRegistrationError::ContributorsChanged,
+        )),
+    );
+    assert_eq!(calls.load(Ordering::SeqCst), 0);
+    assert!(manager.list_thread_ids().await.is_empty());
+    assert!(backend.received_requests().await.unwrap().is_empty());
+}
+
+#[tokio::test]
+async fn equal_configuration_values_from_another_original_source_packet_do_not_match() {
+    let backend = wiremock::MockServer::start().await;
+    let (_home, config, auth, manager, calls) =
+        original_manager(&backend.uri(), RegistryFixture::Installed).await;
+    let second_config = config.clone();
+    let sources = manager
+        .capture_pre_session_api_key_mcp_sources(
+            StartThreadOptions::new(config),
+            auth.capture_cached_api_key_credentials().unwrap(),
+        )
+        .unwrap();
+    let skills = manager
+        .observe_pre_session_skills(&sources, &[])
+        .await
+        .unwrap();
+    let other_sources = manager
+        .capture_pre_session_api_key_mcp_sources(
+            StartThreadOptions::new(second_config),
+            auth.capture_cached_api_key_credentials().unwrap(),
+        )
+        .unwrap();
+    assert_eq!(
+        sources.start_options().config.model,
+        other_sources.start_options().config.model
+    );
+    assert_eq!(
+        sources.start_options().config.cwd,
+        other_sources.start_options().config.cwd
+    );
+    assert!(!std::ptr::eq(
+        &sources.start_options().config,
+        &other_sources.start_options().config,
+    ));
+    assert_eq!(
+        capture_installed_extension_sources(&manager, &other_sources, &skills).err(),
+        Some(AppServerExtensionSourceError::SelectedConfigMismatch),
+    );
+    assert_eq!(calls.load(Ordering::SeqCst), 0);
+    assert!(manager.list_thread_ids().await.is_empty());
+    assert!(backend.received_requests().await.unwrap().is_empty());
+}
