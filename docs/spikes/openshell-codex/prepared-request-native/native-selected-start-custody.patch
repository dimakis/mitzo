+//! Concrete extension observation composition beside the ORIGINAL app-server
+//! registry. Core never imports these Config-dependent extension crates.
+//!
+//! Complete registration membership is not complete context: each retained
+//! observation covers only its existing source-owned initial partition. Built-in
+//! sections, all other partitions and config/policy/date/filesystem currentness
+//! still need their original observations before any request/count/State use.
+//! This packet has no Ready/admission/rendering interface and invokes no ordinary
+//! context/lifecycle/tool/model callbacks or Session construction.
+#![cfg_attr(
+    not(test),
+    allow(dead_code, reason = "Fresh prepared factory is being connected.")
+)]
+
+use codex_core::PreSessionClockError;
+use codex_core::PreSessionMcpError;
+use codex_core::PreSessionMcpSources;
+use codex_core::PreSessionSkillsObservation;
+use codex_core::PreSessionSystemClockObservation;
+use codex_core::ThreadManager;
+use codex_core::config::Config;
+use codex_extension_api::BoundContextSourceRegistrations;
+use codex_extension_api::ContextSourceRegistrationError;
+use codex_git_attribution::GitAttributionInitialObservation;
+use codex_git_attribution::GitAttributionObservationError;
+use codex_history_notes_extension::HistoryNotesInitialObservation;
+use codex_history_notes_extension::HistoryNotesObservationError;
+use codex_memories_extension::MemoriesInitialObservation;
+use codex_memories_extension::MemoriesObservationError;
+
+pub(crate) struct CapturedAppServerExtensionSources<'a> {
+    manager: &'a ThreadManager,
+    sources: &'a PreSessionMcpSources,
+    skills: &'a PreSessionSkillsObservation<'a>,
+    system_clock: PreSessionSystemClockObservation<'a>,
+    registrations: BoundContextSourceRegistrations,
+    history_notes: Vec<HistoryNotesInitialObservation<'a>>,
+    git_attribution: Vec<GitAttributionInitialObservation<'a>>,
+    memories: Vec<MemoriesInitialObservation<'a>>,
+}
+
+#[derive(Debug, PartialEq, Eq)]
+pub(crate) enum AppServerExtensionSourceError {
+    NativeMcp(PreSessionMcpError),
+    Clock(PreSessionClockError),
+    SelectedConfigMismatch,
+    CredentialsUnavailable,
+    Registration(ContextSourceRegistrationError),
+    HistoryNotes(HistoryNotesObservationError),
+    GitAttribution(GitAttributionObservationError),
+    Memories(MemoriesObservationError),
+}
+
+/// Retains heterogeneous original observations with the exact registry owned by
+/// the actual native manager and MCP packet. Unsupported sources refuse; no
+/// contributor is classified from a caller name/list/empty callback result.
+pub(crate) fn capture_installed_extension_sources<'a>(
+    manager: &'a ThreadManager,
+    sources: &'a PreSessionMcpSources,
+    skills: &'a PreSessionSkillsObservation<'a>,
+) -> Result<CapturedAppServerExtensionSources<'a>, AppServerExtensionSourceError> {
+    let registry = manager
+        .pre_session_extension_registry(sources)
+        .map_err(AppServerExtensionSourceError::NativeMcp)?;
+    let config = &sources.start_options().config;
+    if !std::ptr::eq(skills.skills().captured_config(), config) {
+        return Err(AppServerExtensionSourceError::SelectedConfigMismatch);
+    }
+    let system_clock = manager
+        .observe_pre_session_system_clock(sources)
+        .map_err(AppServerExtensionSourceError::Clock)?;
+    let credentials = sources
+        .api_key_credentials()
+        .ok_or(AppServerExtensionSourceError::CredentialsUnavailable)?;
+    let mut identities = vec![skills.skills().context_source_identity().clone()];
+    let mut history_notes = Vec::new();
+    for source in codex_history_notes_extension::registered_history_notes_sources(registry) {
+        let captured = source
+            .observe_initial_context(registry, config)
+            .map_err(AppServerExtensionSourceError::HistoryNotes)?;
+        identities.push(captured.context_source_identity().clone());
+        history_notes.push(captured);
+    }
+    let mut git_attribution = Vec::new();
+    for source in codex_git_attribution::registered_git_attribution_sources(registry) {
+        let captured = source
+            .observe_api_key_initial_context(registry, credentials)
+            .map_err(AppServerExtensionSourceError::GitAttribution)?;
+        identities.push(captured.context_source_identity().clone());
+        git_attribution.push(captured);
+    }
+    let mut memories = Vec::new();
+    for source in codex_memories_extension::registered_memories_sources(registry) {
+        let captured = source
+            .observe_initial_context(registry, config)
+            .map_err(AppServerExtensionSourceError::Memories)?;
+        identities.push(captured.context_source_identity().clone());
+        memories.push(captured);
+    }
+    // Registry itself checks EVERY actual registration/index/allocation. A
+    // legacy or unrecognized contributor remains unresolved, even if its
+    // ordinary callback happens to return no fragments for a fixture.
+    let registrations = registry
+        .bind_context_source_registrations(identities)
+        .map_err(AppServerExtensionSourceError::Registration)?;
+    Ok(CapturedAppServerExtensionSources {
+        manager,
+        sources,
+        skills,
+        system_clock,
+        registrations,
+        history_notes,
+        git_attribution,
+        memories,
+    })
+}
+
+impl<'a> CapturedAppServerExtensionSources<'a> {
+    pub(crate) fn manager(&self) -> &'a ThreadManager {
+        self.manager
+    }
+    pub(crate) fn native_sources(&self) -> &'a PreSessionMcpSources {
+        self.sources
+    }
+    pub(crate) fn configuration(&self) -> &'a Config {
+        &self.sources.start_options().config
+    }
+    pub(crate) fn skills(&self) -> &'a PreSessionSkillsObservation<'a> {
+        self.skills
+    }
+    pub(crate) fn system_clock(&self) -> &PreSessionSystemClockObservation<'a> {
+        &self.system_clock
+    }
+    pub(crate) fn registrations(&self) -> &BoundContextSourceRegistrations {
+        &self.registrations
+    }
+    pub(crate) fn history_notes(&self) -> &[HistoryNotesInitialObservation<'a>] {
+        &self.history_notes
+    }
+    pub(crate) fn git_attribution(&self) -> &[GitAttributionInitialObservation<'a>] {
+        &self.git_attribution
+    }
+    pub(crate) fn memories(&self) -> &[MemoriesInitialObservation<'a>] {
+        &self.memories
+    }
+}
