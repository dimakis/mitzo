+use codex_protocol::approvals::ExecPolicyAmendment;
+use pretty_assertions::assert_eq;
+
+#[tokio::test]
+async fn real_prefix_publisher_invalidates_even_an_equal_filtered_projection() {
+    let home = tempfile::tempdir().expect("test policy home");
+    let manager = ExecPolicyManager::default();
+    let observed = manager.observe_for_prefix_rules(AllowPrefixRules::IgnoreForCyberModel);
+    assert_eq!(observed.with_current(|| 1), Ok(1));
+    manager
+        .append_amendment_and_update(
+            home.path(),
+            &ExecPolicyAmendment::new(vec!["cargo".to_string(), "check".to_string()]),
+        )
+        .await
+        .expect("original prefix publisher");
+    let fresh = manager.observe_for_prefix_rules(AllowPrefixRules::IgnoreForCyberModel);
+    assert!(observed.policy().get_allowed_prefixes().is_empty());
+    assert!(fresh.policy().get_allowed_prefixes().is_empty());
+    assert_eq!(
+        observed.with_current(|| 2),
+        Err(ExecPolicySourceError::Changed)
+    );
+    assert_eq!(fresh.with_current(|| 3), Ok(3));
+    assert!(!manager.current().get_allowed_prefixes().is_empty());
+}
+
+#[tokio::test]
+async fn real_network_publisher_invalidates_the_original_policy_source() {
+    let home = tempfile::tempdir().expect("test policy home");
+    let manager = ExecPolicyManager::default();
+    let observed = manager.observe_for_prefix_rules(AllowPrefixRules::Honor);
+    manager
+        .append_network_rule_and_update(
+            home.path(),
+            "original-owner.test",
+            NetworkRuleProtocol::Https,
+            Decision::Forbidden,
+            /*justification*/ None,
+        )
+        .await
+        .expect("original network publisher");
+    let fresh = manager.observe_for_prefix_rules(AllowPrefixRules::Honor);
+    assert_eq!(
+        observed.with_current(|| ()),
+        Err(ExecPolicySourceError::Changed)
+    );
+    assert_eq!(fresh.with_current(|| ()), Ok(()));
+    assert_eq!(
+        fresh.policy().network_rules(),
+        manager.current().network_rules()
+    );
+    assert!(!fresh.policy().network_rules().is_empty());
+}
+
+#[test]
+fn policy_source_guard_refuses_during_the_original_publisher_lock() {
+    let manager = ExecPolicyManager::default();
+    let observed = manager.observe_for_prefix_rules(AllowPrefixRules::Honor);
+    assert!(Arc::ptr_eq(observed.policy(), &manager.current()));
+    let update = manager
+        .update_lock
+        .try_acquire()
+        .expect("original update lock");
+    let calls = std::cell::Cell::new(0);
+    assert_eq!(
+        observed.with_current(|| calls.set(calls.get() + 1)),
+        Err(ExecPolicySourceError::Busy),
+    );
+    assert_eq!(calls.get(), 0);
+    drop(update);
+    assert_eq!(observed.with_current(|| calls.set(calls.get() + 1)), Ok(()));
+    assert_eq!(calls.get(), 1);
+}
