diff --git a/codex-rs/login/src/auth/prepared_api_key.rs b/codex-rs/login/src/auth/prepared_api_key.rs
new file mode 100644
index 0000000..06f7bbf
--- /dev/null
+++ b/codex-rs/login/src/auth/prepared_api_key.rs
@@ -0,0 +1,94 @@
+//! Cached API-key custody under the existing native auth owner's read lock.
+//!
+//! This binds credentials only. It is not account policy, route, model/limit,
+//! source/settings authority or a durable one-use permit. In particular a prior
+//! successful renewal cannot authorize a later consume/attempt. The admission
+//! owner must perform its bounded native transaction inside the guarded closure,
+//! alongside the other real authority owners, and must not run network work,
+//! reenter AuthManager, refresh/reload or await while holding this synchronous lock.
+
+use std::sync::Arc;
+
+use codex_http_client::HttpClientFactory;
+
+use super::AuthChangeState;
+use super::AuthManager;
+use super::CodexAuth;
+
+/// Opaque process-local cached API credential selection. No serialization, public
+/// credential getters, cloning, or caller-supplied epochs. Retaining the actual
+/// manager prevents pointer reuse; any credential-generation ABA still refuses.
+/// A runtime reconnect must acquire a new selection from its original owner.
+pub struct CapturedApiKeyCredentials {
+    owner: Arc<AuthManager>,
+    change: AuthChangeState,
+    auth: CodexAuth,
+    factory: HttpClientFactory,
+}
+
+impl AuthManager {
+    /// Captures only an already-cached API key and its account-bound factory.
+    /// Never refreshes credentials, reads auth storage, invokes external auth or
+    /// constructs an HTTP client. Unsupported auth families and poisoned locks refuse.
+    pub fn capture_cached_api_key_credentials(
+        self: &Arc<Self>,
+    ) -> Option<CapturedApiKeyCredentials> {
+        // Match external-auth mutation's lock order. Keep this read guard alive
+        // through the cached snapshot so an external provider cannot be installed
+        // between its absence check and credential capture.
+        let external = self.external_auth.read().ok()?;
+        if external.is_some() || self.workload_identity_selected {
+            return None;
+        }
+        let cached = self.inner.read().ok()?;
+        let auth = cached.auth.as_ref()?;
+        if !matches!(auth, CodexAuth::ApiKey(_)) || cached.permanent_refresh_failure.is_some() {
+            return None;
+        }
+        Some(CapturedApiKeyCredentials {
+            owner: Arc::clone(self),
+            change: *self.auth_change_state_tx.borrow(),
+            auth: auth.clone(),
+            factory: self.http_client_factory(),
+        })
+    }
+
+    /// Runs a bounded synchronous native admission/attempt operation only while
+    /// this exact manager still owns the captured cached credentials. The actual
+    /// cached-auth writer holds the same write lock while publishing revisions;
+    /// it therefore cannot change credentials between this check and the closure.
+    /// The external-auth read lock also orders installation/clearing against it.
+    ///
+    /// This does not order managed login/network policy or host source/account
+    /// changes. Those require their own actual owner guards before admission.
+    /// Returning a boolean/epoch for use after this closure would lose this fence.
+    pub fn with_current_api_key_credentials<T>(
+        self: &Arc<Self>,
+        captured: &CapturedApiKeyCredentials,
+        operation: impl FnOnce(&CodexAuth, &HttpClientFactory) -> T,
+    ) -> Option<T> {
+        if !Arc::ptr_eq(self, &captured.owner) {
+            return None;
+        }
+        let external = self.external_auth.read().ok()?;
+        if external.is_some() || self.workload_identity_selected {
+            return None;
+        }
+        let cached = self.inner.read().ok()?;
+        if *self.auth_change_state_tx.borrow() != captured.change
+            || cached.permanent_refresh_failure.is_some()
+            || !Self::auths_equal_for_refresh(cached.auth.as_ref(), Some(&captured.auth))
+            || !matches!(cached.auth.as_ref(), Some(CodexAuth::ApiKey(_)))
+        {
+            return None;
+        }
+        let result = operation(&captured.auth, &captured.factory);
+        drop(cached);
+        drop(external);
+        Some(result)
+    }
+}
+
+#[cfg(test)]
+#[path = "prepared_api_key_tests.rs"]
+mod tests;
diff --git a/codex-rs/login/src/auth/prepared_api_key_tests.rs b/codex-rs/login/src/auth/prepared_api_key_tests.rs
new file mode 100644
index 0000000..00ae554
--- /dev/null
+++ b/codex-rs/login/src/auth/prepared_api_key_tests.rs
@@ -0,0 +1,92 @@
+use super::*;
+use pretty_assertions::assert_eq;
+use std::sync::atomic::AtomicUsize;
+use std::sync::atomic::Ordering;
+use std::sync::mpsc;
+use std::time::Duration;
+
+#[test]
+fn cached_api_credentials_reject_other_owner_logout_and_credential_aba() {
+    let owner = AuthManager::from_auth_for_testing(CodexAuth::from_api_key("offline-first"));
+    let captured = owner.capture_cached_api_key_credentials().unwrap();
+    let calls = AtomicUsize::new(0);
+    let other = AuthManager::from_auth_for_testing(CodexAuth::from_api_key("offline-first"));
+    assert!(
+        other
+            .with_current_api_key_credentials(&captured, |_, _| calls
+                .fetch_add(1, Ordering::SeqCst))
+            .is_none()
+    );
+    assert_eq!(
+        owner.with_current_api_key_credentials(&captured, |auth, _| matches!(
+            auth,
+            CodexAuth::ApiKey(_)
+        )),
+        Some(true)
+    );
+    owner.set_cached_auth(Some(CodexAuth::from_api_key("offline-second")));
+    owner.set_cached_auth(Some(CodexAuth::from_api_key("offline-first")));
+    assert!(
+        owner
+            .with_current_api_key_credentials(&captured, |_, _| calls
+                .fetch_add(1, Ordering::SeqCst))
+            .is_none()
+    );
+    let renewed = owner.capture_cached_api_key_credentials().unwrap();
+    owner.set_cached_auth(None);
+    assert!(
+        owner
+            .with_current_api_key_credentials(&renewed, |_, _| calls.fetch_add(1, Ordering::SeqCst))
+            .is_none()
+    );
+    assert!(owner.capture_cached_api_key_credentials().is_none());
+    assert_eq!(calls.load(Ordering::SeqCst), 0);
+    let subscription =
+        AuthManager::from_auth_for_testing(CodexAuth::create_dummy_chatgpt_auth_for_testing());
+    assert!(subscription.capture_cached_api_key_credentials().is_none());
+}
+
+#[test]
+fn cached_api_credential_writer_cannot_cross_guarded_native_operation() {
+    let owner = AuthManager::from_auth_for_testing(CodexAuth::from_api_key("offline-first"));
+    let captured = owner.capture_cached_api_key_credentials().unwrap();
+    let (start_tx, start_rx) = mpsc::channel();
+    let (attempted_tx, attempted_rx) = mpsc::channel();
+    let (finished_tx, finished_rx) = mpsc::channel();
+    let writer_owner = Arc::clone(&owner);
+    let writer = std::thread::spawn(move || {
+        start_rx.recv_timeout(Duration::from_secs(5)).unwrap();
+        attempted_tx.send(()).unwrap();
+        writer_owner.set_cached_auth(Some(CodexAuth::from_api_key("offline-second")));
+        finished_tx.send(()).unwrap();
+    });
+    let calls = AtomicUsize::new(0);
+    assert_eq!(
+        owner.with_current_api_key_credentials(&captured, |_, _| {
+            assert!(matches!(
+                owner.inner.try_write(),
+                Err(std::sync::TryLockError::WouldBlock)
+            ));
+            assert!(matches!(
+                owner.external_auth.try_write(),
+                Err(std::sync::TryLockError::WouldBlock)
+            ));
+            start_tx.send(()).unwrap();
+            attempted_rx.recv_timeout(Duration::from_secs(5)).unwrap();
+            // The actual writer needs the held native cached-auth write lock. Its
+            // credential mutation cannot finish before this synchronous operation.
+            assert_eq!(finished_rx.try_recv(), Err(mpsc::TryRecvError::Empty));
+            calls.fetch_add(1, Ordering::SeqCst)
+        }),
+        Some(0)
+    );
+    finished_rx.recv_timeout(Duration::from_secs(5)).unwrap();
+    writer.join().unwrap();
+    assert!(
+        owner
+            .with_current_api_key_credentials(&captured, |_, _| calls
+                .fetch_add(1, Ordering::SeqCst))
+            .is_none()
+    );
+    assert_eq!(calls.load(Ordering::SeqCst), 1);
+}
