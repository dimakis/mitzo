+use super::*;
+use crate::session::startup_selection::OriginalStartupSelection;
+use pretty_assertions::assert_eq;
+
+#[tokio::test]
+async fn original_first_step_preserves_resolved_row_and_late_summary_tier_filtering()
+-> anyhow::Result<()> {
+    let (_home, step, models, overrides, features) =
+        OriginalStartupSelection::first_step_fixture().await?;
+    for fast in [false, true] {
+        let mut features = features.clone();
+        if fast {
+            features.enable(codex_features::Feature::FastMode);
+        } else {
+            features.disable(codex_features::Feature::FastMode);
+        }
+        let expected = step.resolve_model_info(models.as_ref(), &overrides).await;
+        let data = OriginalFirstStepModelData::capture(&step, models.as_ref(), &overrides).await;
+        assert_eq!(data.model_info(), &expected);
+        let resolved = data.into_resolved(Arc::clone(&step), &features);
+        assert_eq!(resolved.model_info.as_ref(), &expected);
+        assert_eq!(resolved.selected(), step.as_ref());
+        assert_eq!(
+            resolved.reasoning_summary,
+            step.reasoning_summary
+                .unwrap_or(expected.default_reasoning_summary)
+        );
+        assert_eq!(
+            resolved.service_tier,
+            super::super::get_service_tier(step.service_tier.clone(), fast, &expected)
+        );
+        assert_eq!(resolved.service_tier, fast.then(|| "priority".to_string()));
+    }
+    Ok(())
+}
+
+#[tokio::test]
+async fn ordinary_first_step_resolves_changed_model_instead_of_reusing_startup_row()
+-> anyhow::Result<()> {
+    let (_home, baseline, _, overrides, features) =
+        OriginalStartupSelection::first_step_fixture().await?;
+    let catalog = codex_models_manager::bundled_models_response()?;
+    let changed = catalog
+        .models
+        .iter()
+        .find(|row| row.slug != baseline.collaboration_mode.model())
+        .expect("bundled catalog contains a distinct actual model")
+        .slug
+        .clone();
+    let models = codex_models_manager::manager::StaticModelsManager::new(None, catalog);
+    let startup = baseline.resolve_model_info(&models, &overrides).await;
+    let mut step = (*baseline).clone();
+    step.collaboration_mode =
+        step.collaboration_mode
+            .with_updates(Some(changed.clone()), None, None);
+    step.personality = Some(codex_protocol::config_types::Personality::Friendly);
+    step.reasoning_summary = None;
+    let step = Arc::new(step);
+    let expected = step.resolve_model_info(&models, &overrides).await;
+    let data = OriginalFirstStepModelData::capture(&step, &models, &overrides).await;
+    assert_eq!(data.model_info(), &expected);
+    assert_eq!(data.model_info().slug, changed);
+    assert_ne!(data.model_info().slug, startup.slug);
+    let resolved = data.into_resolved(Arc::clone(&step), &features);
+    assert_eq!(resolved.selected(), step.as_ref());
+    assert_eq!(resolved.model_info.as_ref(), &expected);
+    assert_eq!(
+        resolved.reasoning_summary,
+        expected.default_reasoning_summary
+    );
+    Ok(())
+}
