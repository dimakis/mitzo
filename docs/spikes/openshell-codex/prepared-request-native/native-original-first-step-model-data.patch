+//! Original model DATA, resolved at the ordinary first-step acquisition point.
+//! Borrowed metadata supports intervening startup work; consumption stays at the
+//! original ResolvedStepSettings point. No turn, request or admission is created.
+use super::step_settings::{ModelInfoOverrides, ResolvedStepSettings, StepSettings};
+use codex_features::{Feature, Features};
+use codex_models_manager::manager::ModelsManager;
+use codex_protocol::openai_models::ModelInfo;
+use std::sync::Arc;
+
+pub(super) struct OriginalFirstStepModelData {
+    model_info: ModelInfo,
+}
+impl OriginalFirstStepModelData {
+    pub(super) async fn capture(
+        step: &StepSettings,
+        models: &dyn ModelsManager,
+        overrides: &ModelInfoOverrides,
+    ) -> Self {
+        Self {
+            model_info: step.resolve_model_info(models, overrides).await,
+        }
+    }
+    pub(super) fn model_info(&self) -> &ModelInfo {
+        &self.model_info
+    }
+    pub(super) fn into_resolved(
+        self,
+        step: Arc<StepSettings>,
+        features: &Features,
+    ) -> Arc<ResolvedStepSettings> {
+        Arc::new(ResolvedStepSettings::new(
+            step,
+            Arc::new(self.model_info),
+            features.enabled(Feature::FastMode),
+        ))
+    }
+}
+
+#[cfg(test)]
+#[path = "first_step_model_data_tests.rs"]
+mod tests;
