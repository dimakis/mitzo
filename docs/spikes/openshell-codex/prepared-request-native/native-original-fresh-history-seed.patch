+//! Fresh-history DATA allocated by original selected startup, not complete
+//! history/agent state, a Session, admission, currentness or request authority.
+use super::*;
+
+pub(in crate::session) struct OriginalFreshHistoryData {
+    config: Arc<Config>,
+    source: SessionSource,
+    window_ids: Option<AutoCompactWindowIds>,
+    history: Option<ContextManager>,
+}
+impl OriginalFreshHistoryData {
+    pub(in crate::session) fn capture(
+        config: Arc<Config>,
+        source: &SessionSource,
+        history: &InitialHistory,
+    ) -> io::Result<Self> {
+        if !matches!(history, InitialHistory::New) {
+            return Err(io::Error::other(
+                "fresh history requires original New inputs",
+            ));
+        }
+        // Same ORIGINAL constructors; retain their actual values, including the
+        // unique window ID and ContextManager's process review-context revision.
+        let window_ids = AutoCompactWindowIds::new_initial();
+        let history = ContextManager::for_session(source, &config.features);
+        Ok(Self {
+            config,
+            source: source.clone(),
+            window_ids: Some(window_ids),
+            history: Some(history),
+        })
+    }
+    pub(in crate::session) fn validate(
+        &self,
+        config: &Arc<Config>,
+        source: &SessionSource,
+        history: &InitialHistory,
+    ) -> io::Result<()> {
+        if !Arc::ptr_eq(config, &self.config)
+            || source != &self.source
+            || !matches!(history, InitialHistory::New)
+        {
+            return Err(io::Error::other(
+                "retained original fresh-history inputs changed",
+            ));
+        }
+        Ok(())
+    }
+    pub(in crate::session) fn take_window_ids(&mut self) -> io::Result<AutoCompactWindowIds> {
+        self.window_ids
+            .take()
+            .ok_or_else(|| io::Error::other("original window IDs already adopted"))
+    }
+    pub(in crate::session) fn take_context(
+        &mut self,
+        config: &Arc<Config>,
+        source: &SessionSource,
+        history: &InitialHistory,
+    ) -> io::Result<ContextManager> {
+        let context = self
+            .history
+            .take()
+            .ok_or_else(|| io::Error::other("original fresh context already adopted"))?;
+        self.validate(config, source, history)?;
+        if self.window_ids.is_some() {
+            return Err(io::Error::other(
+                "original window IDs must be adopted before context",
+            ));
+        }
+        Ok(context)
+    }
+}
+
