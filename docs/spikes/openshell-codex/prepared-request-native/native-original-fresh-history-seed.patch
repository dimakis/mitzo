+use super::*;
+use crate::session::startup_selection::OriginalStartupSelection;
+use codex_models_manager::manager::{
+    ModelsEndpointClient, ModelsEndpointFuture, ModelsEndpointResponse, OpenAiModelsManager,
+    RefreshStrategy,
+};
+use pretty_assertions::assert_eq;
+use std::sync::Mutex;
+use std::sync::atomic::{AtomicUsize, Ordering};
+
+#[derive(Debug)]
+struct OfflineCatalog {
+    rows: Mutex<Vec<ModelInfo>>,
+    reads: AtomicUsize,
+}
+impl ModelsEndpointClient for OfflineCatalog {
+    fn identity(&self) -> Option<String> {
+        Some("synthetic-startup-source".to_string())
+    }
+    fn has_command_auth(&self) -> bool {
+        false
+    }
+    fn uses_codex_backend(&self) -> ModelsEndpointFuture<'_, bool> {
+        Box::pin(std::future::ready(false))
+    }
+    fn supports_api_key_models(&self) -> bool {
+        true
+    }
+    fn has_provider_api_key(&self) -> bool {
+        true
+    }
+    fn list_models<'a>(
+        &'a self,
+        _version: &'a str,
+        _factory: codex_http_client::HttpClientFactory,
+    ) -> ModelsEndpointFuture<'a, CodexResult<ModelsEndpointResponse>> {
+        self.reads.fetch_add(1, Ordering::SeqCst);
+        let models = self.rows.lock().unwrap().clone();
+        Box::pin(std::future::ready(Ok(ModelsEndpointResponse {
+            models,
+            etag: None,
+            identity: self.identity().unwrap(),
+        })))
+    }
+}
+async fn fixture() -> anyhow::Result<(
+    tempfile::TempDir,
+    crate::StartThreadOptions,
+    Arc<AuthManager>,
+    SharedModelsManager,
+    Arc<OfflineCatalog>,
+)> {
+    let home = tempfile::tempdir()?;
+    std::fs::write(
+        home.path().join("config.toml"),
+        "model = 'gpt-6-luna'\nsandbox_mode = 'danger-full-access'\n",
+    )?;
+    std::fs::write(
+        home.path().join("requirements.toml"),
+        "[auto_review]\nrequired_on_models = ['gpt-6-luna']\n",
+    )?;
+    let config = crate::config::ConfigBuilder::default()
+        .codex_home(home.path().to_path_buf())
+        .loader_overrides(
+            codex_config::LoaderOverrides::with_managed_config_path_for_tests(
+                home.path().join("managed.toml"),
+            ),
+        )
+        .fallback_cwd(Some(home.path().to_path_buf()))
+        .build()
+        .await?;
+    let auth = AuthManager::from_auth_for_testing_with_home(
+        CodexAuth::from_api_key("synthetic-startup-source"),
+        home.path().to_path_buf(),
+    );
+    // The exact shipped Luna row is published through the REAL catalog owner;
+    // only its external endpoint is deterministic offline data, never HTTP.
+    let row = codex_models_manager::bundled_models_response()?
+        .models
+        .into_iter()
+        .find(|row| row.slug == "gpt-6-luna")
+        .unwrap();
+    let endpoint = Arc::new(OfflineCatalog {
+        rows: Mutex::new(vec![row]),
+        reads: AtomicUsize::new(0),
+    });
+    let models: SharedModelsManager = Arc::new(
+        OpenAiModelsManager::new_without_cache(endpoint.clone(), Some(Arc::clone(&auth)))
+            .with_provider_catalog(),
+    );
+    models.set_api_key_model_discovery_enabled(true);
+    models
+        .raw_model_catalog(RefreshStrategy::Online, config.http_client_factory())
+        .await;
+    let mut options = crate::StartThreadOptions::new(config);
+    options.environments = Some(vec![codex_protocol::protocol::TurnEnvironmentSelection {
+        environment_id: "startup-source-data".to_string(),
+        cwd: options.config.cwd.clone().into(),
+        workspace_roots: vec![options.config.cwd.clone().into()],
+        config: codex_protocol::protocol::EnvironmentConfigState::Pending,
+    }]);
+    Ok((home, options, auth, models, endpoint))
+}
+
+async fn captured() -> anyhow::Result<(
+    tempfile::TempDir,
+    crate::ThreadManager,
+    ThreadId,
+    crate::StartThreadOptions,
+    OriginalClientInputData,
+    Arc<Config>,
+    SessionSource,
+)> {
+    let (home, options, auth, models, _endpoint) = fixture().await?;
+    let manager = crate::ThreadManager::for_fresh_history_fixture(
+        &options.config,
+        Arc::clone(&auth),
+        Arc::clone(&models),
+    );
+    let reservation = manager.reserve_thread_start();
+    let id = reservation.thread_id();
+    let mut selected = manager
+        .prepare_reserved_selected_start(options, reservation)
+        .await?;
+    manager
+        .capture_selected_start_startup(&mut selected)
+        .await?;
+    let adoption = manager.adopt_selected_start_startup(&mut selected).await?;
+    assert!(
+        manager
+            .adopt_selected_start_startup(&mut selected)
+            .await
+            .is_err()
+    );
+    let (adopted_id, options, mut inputs) = adoption.into_fresh_history_fixture_parts();
+    assert_eq!(adopted_id, id);
+    let frame = inputs.source_frame().unwrap();
+    let source = frame.client_source().0.clone();
+    let fork = frame.configured_fork(&options)?;
+    let startup = inputs.take_startup().unwrap();
+    let (_owner, mut stages, _raw) = startup.into_session(
+        &models,
+        &auth,
+        &options.config,
+        configured_settings_data::ConfiguredBaselineInputs::from_options(&options, fork),
+        &source,
+    )?;
+    stages.take_review()?;
+    let effective = stages.take_effective()?;
+    assert!(manager.list_thread_ids().await.is_empty());
+    assert!(!home.path().join(".sandbox_migration").exists());
+    Ok((home, manager, id, options, inputs, effective, source))
+}
+
+#[tokio::test]
+async fn actual_selected_packet_moves_same_window_and_history_into_original_stages_once()
+-> anyhow::Result<()> {
+    let (_home, manager, id, options, mut inputs, effective, source) = captured().await?;
+    let mut seed = inputs
+        .take_fresh_history(id, &effective, &source, &options.initial_history)?
+        .expect("actual selected startup retained original history data");
+    let window = seed.window_ids.unwrap();
+    // Clone only a test witness, not captured production custody. A fresh
+    // ContextManager would allocate a different items Arc and review revision.
+    let witness = seed
+        .history
+        .as_ref()
+        .unwrap()
+        .clone()
+        .into_shared_annotated_items();
+    let version = seed.history.as_ref().unwrap().history_version();
+    assert_eq!(seed.take_window_ids()?, window);
+    assert!(seed.take_window_ids().is_err());
+    let history = seed.take_context(&effective, &source, &options.initial_history)?;
+    assert_eq!(history.history_version(), version);
+    assert!(Arc::ptr_eq(
+        &witness,
+        &history.into_shared_annotated_items()
+    ));
+    assert!(
+        seed.take_context(&effective, &source, &options.initial_history)
+            .is_err()
+    );
+    assert!(
+        inputs
+            .take_fresh_history(id, &effective, &source, &options.initial_history)
+            .is_err()
+    );
+    assert!(manager.list_thread_ids().await.is_empty());
+    Ok(())
+}
+
+#[tokio::test]
+async fn foreign_changed_source_history_and_equal_config_owner_burn_selected_slot()
+-> anyhow::Result<()> {
+    let (_home, options, auth, models, _endpoint) = fixture().await?;
+    let manager = crate::ThreadManager::for_fresh_history_fixture(
+        &options.config,
+        Arc::clone(&auth),
+        Arc::clone(&models),
+    );
+    let foreign = crate::ThreadManager::for_fresh_history_fixture(&options.config, auth, models);
+    let mut selected = manager
+        .prepare_reserved_selected_start(options, manager.reserve_thread_start())
+        .await?;
+    manager
+        .capture_selected_start_startup(&mut selected)
+        .await?;
+    assert!(
+        foreign
+            .adopt_selected_start_startup(&mut selected)
+            .await
+            .is_err()
+    );
+    assert!(foreign.list_thread_ids().await.is_empty());
+    assert!(manager.list_thread_ids().await.is_empty());
+    for mismatch in 0..5 {
+        let (_home, manager, id, options, mut inputs, effective, source) = captured().await?;
+        let mut changed_config = effective.as_ref().clone();
+        changed_config.ephemeral = !changed_config.ephemeral;
+        let foreign_id = manager.reserve_thread_start().thread_id();
+        let equal_but_foreign = Arc::new(effective.as_ref().clone());
+        let changed = Arc::new(changed_config);
+        let foreign_source = SessionSource::Cli;
+        let non_new = InitialHistory::Cleared;
+        let (actual_id, config, actual_source, history) = match mismatch {
+            0 => (foreign_id, &effective, &source, &options.initial_history),
+            1 => (id, &equal_but_foreign, &source, &options.initial_history),
+            2 => (id, &changed, &source, &options.initial_history),
+            3 => (id, &effective, &foreign_source, &options.initial_history),
+            4 => (id, &effective, &source, &non_new),
+            _ => unreachable!(),
+        };
+        assert!(
+            inputs
+                .take_fresh_history(actual_id, config, actual_source, history)
+                .is_err()
+        );
+        // Valid original arguments never reconstruct the consumed/failed slot.
+        assert!(
+            inputs
+                .take_fresh_history(id, &effective, &source, &options.initial_history)
+                .is_err()
+        );
+        assert!(manager.list_thread_ids().await.is_empty());
+    }
+    Ok(())
+}
+
+#[tokio::test]
+async fn wrong_stage_missing_values_and_non_new_capture_never_reconstruct_history()
+-> anyhow::Result<()> {
+    let (_home, _manager, id, options, mut inputs, effective, source) = captured().await?;
+    assert!(
+        OriginalFreshHistoryData::capture(
+            Arc::clone(&effective),
+            &source,
+            &InitialHistory::Cleared
+        )
+        .is_err()
+    );
+    let mut seed = inputs
+        .take_fresh_history(id, &effective, &source, &options.initial_history)?
+        .unwrap();
+    assert!(
+        seed.take_context(&effective, &source, &options.initial_history)
+            .is_err()
+    );
+    seed.take_window_ids()?;
+    assert!(
+        seed.take_context(&effective, &source, &options.initial_history)
+            .is_err()
+    );
+    let mut seed = OriginalFreshHistoryData::capture(
+        Arc::clone(&effective),
+        &source,
+        &options.initial_history,
+    )?;
+    seed.window_ids.take();
+    assert!(seed.take_window_ids().is_err());
+    seed.history.take();
+    assert!(
+        seed.take_context(&effective, &source, &options.initial_history)
+            .is_err()
+    );
+    Ok(())
+}
