+            .await?;
+    let foreign =
+        OriginalStartupSelection::capture(&options, &SessionSource::Exec, None, &auth, &models)
+            .await?;
+    let mut candidate = startup.settings_candidate(ThreadSettingsOverrides {
+        personality: Some(codex_protocol::config_types::Personality::Friendly),
+        ..Default::default()
+    })?;
+    let input = serde_json::from_value(
+        serde_json::json!({"type":"function_call_output","call_id":null,"name":"original-tool","namespace":"original-ns","output":"reply\n🦀"}),
+    )?;
+    let request = TurnInputRequest::new(codex_protocol::turn_input::TurnInput::ResponseItem(input))
+        .on_start(TurnStartOptions {
+            turn_trigger: Some("original-composer".into()),
+            final_output_json_schema: Some(serde_json::json!({"type":"object"})),
+            service_tier: Some("priority".into()),
+            parent_turn_id: Some("retained-parent-data".into()),
+            root_turn_id: Some("retained-root-data".into()),
+            cyber_access_program: Some(
+                codex_protocol::turn_input::CyberAccessProgram::DaybreakBlue,
+            ),
+        })
+        .with_additional_context(std::collections::BTreeMap::from([(
+            "application".into(),
+            codex_protocol::protocol::AdditionalContextEntry {
+                value: "context\nbytes".into(),
+                kind: codex_protocol::protocol::AdditionalContextKind::Application,
+            },
+        )]))
+        .with_responses_metadata(Some(std::collections::HashMap::from([(
+            "opaque".into(),
+            String::new(),
+        )])))
+        .with_trace(Some(codex_protocol::protocol::W3cTraceContext {
+            traceparent: Some("00-00000000000000000000000000000001-0000000000000001-01".into()),
+            tracestate: Some("owner=original".into()),
+        }));
+    candidate.pair_command(
+        "standalone-data".into(),
+        request,
+        None,
+        Some(String::new()),
+        None,
+    )?;
+    let retained = candidate.command.as_ref().unwrap();
+    let address = std::ptr::from_ref(retained.request.as_ref());
+    let expected = project((*retained.request).clone());
