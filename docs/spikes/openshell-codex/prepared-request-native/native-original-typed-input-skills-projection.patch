diff --git a/codex-rs/core/src/session/turn_user_input_data.rs b/codex-rs/core/src/session/turn_user_input_data.rs
new file mode 100644
index 0000000..3f2ce37
--- /dev/null
+++ b/codex-rs/core/src/session/turn_user_input_data.rs
@@ -0,0 +1,54 @@
+//! Original ordinary typed-input classification and Skills UserInput DATA view.
+//! The view never rewrites retained command input or manufactures queue metadata.
+use super::TurnInput;
+use codex_protocol::error::{CodexErr, Result as CodexResult};
+use codex_protocol::models::ResponseItem;
+use codex_protocol::turn_input::TurnInput as SubmittedTurnInput;
+use codex_protocol::user_input::UserInput;
+
+fn clone_user_contents<'a>(contents: impl Iterator<Item = &'a [UserInput]>) -> Vec<UserInput> {
+    contents.flatten().cloned().collect()
+}
+
+pub(super) fn turn_user_input(input: &[TurnInput]) -> Vec<UserInput> {
+    clone_user_contents(input.iter().filter_map(|item| match item {
+        TurnInput::UserInput { content, .. } => Some(content.as_slice()),
+        TurnInput::ResponseItem(_)
+        | TurnInput::FunctionCallOutput(_)
+        | TurnInput::InterAgentCommunication(_) => None,
+    }))
+}
+
+pub(super) fn start_or_steer_has_explicit_input(input: &SubmittedTurnInput) -> CodexResult<bool> {
+    Ok(match input {
+        SubmittedTurnInput::UserInput { content, .. } => !content.is_empty(),
+        SubmittedTurnInput::ResponseItem(ResponseItem::FunctionCallOutput {
+            call_id: None,
+            ..
+        }) => true,
+        _ => {
+            return Err(CodexErr::InvalidRequest(
+                "only user input or standalone function-call outputs can start or steer a turn"
+                    .to_string(),
+            ));
+        }
+    })
+}
+
+/// Only the same input variants accepted by the original ordinary classifier.
+/// Standalone function output has no UserInput content; the complete typed
+/// request, including its output/additional context/metadata, remains separate.
+pub(super) fn first_step_user_input(input: &SubmittedTurnInput) -> CodexResult<Vec<UserInput>> {
+    start_or_steer_has_explicit_input(input)?;
+    let content = match input {
+        SubmittedTurnInput::UserInput { content, .. } => Some(content.as_slice()),
+        SubmittedTurnInput::ResponseItem(_) | SubmittedTurnInput::InterAgentCommunication(_) => {
+            None
+        }
+    };
+    Ok(clone_user_contents(content.into_iter()))
+}
+
