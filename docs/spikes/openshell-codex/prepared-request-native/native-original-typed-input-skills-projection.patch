@@ -0,0 +1,110 @@
+use super::*;
+use codex_history::ResponseItemEnvelope;
+use codex_protocol::AgentPath;
+use codex_protocol::models::{FunctionCallOutputBody, FunctionCallOutputPayload};
+use codex_protocol::protocol::InterAgentCommunication;
+use pretty_assertions::assert_eq;
+
+fn output(call_id: Option<String>) -> ResponseItem {
+    ResponseItem::FunctionCallOutput {
+        id: Some("retained-item".into()),
+        call_id,
+        name: Some("original-tool".into()),
+        namespace: Some("original-namespace".into()),
+        output: FunctionCallOutputPayload {
+            body: FunctionCallOutputBody::Text("reply\n🦀".into()),
+            success: Some(false),
+        },
+        internal_chat_message_metadata_passthrough: None,
+    }
+}
+fn mail() -> InterAgentCommunication {
+    InterAgentCommunication::new(
+        AgentPath::root(),
+        AgentPath::try_from("/root/worker").unwrap(),
+        Vec::new(),
+        "mail bytes".into(),
+        /*trigger_turn*/ false,
+    )
+}
+fn text(value: &str) -> UserInput {
+    UserInput::Text {
+        text: value.into(),
+        text_elements: Vec::new(),
+    }
+}
+
+#[test]
+fn original_internal_projection_keeps_order_and_ignores_all_non_user_partitions() {
+    let first = vec![
+        text("first"),
+        UserInput::Mention {
+            name: "source".into(),
+            path: "app://original".into(),
+        },
+    ];
+    let last = vec![text("last")];
+    let inputs = vec![
+        TurnInput::UserInput {
+            content: first.clone(),
+            client_id: Some("original-client".into()),
+            metadata: super::super::UserInputMetadata::default(),
+        },
+        TurnInput::FunctionCallOutput(ResponseItemEnvelope::new(output(None))),
+        TurnInput::ResponseItem(ResponseItemEnvelope::new(output(Some("reply-call".into())))),
+        TurnInput::InterAgentCommunication(mail()),
+        TurnInput::UserInput {
+            content: last.clone(),
+            client_id: None,
+            metadata: super::super::UserInputMetadata::default(),
+        },
+    ];
+    let original = inputs.clone();
+    assert_eq!(
+        turn_user_input(&inputs),
+        first.into_iter().chain(last).collect::<Vec<_>>()
+    );
+    assert_eq!(inputs, original);
+    let standalone = SubmittedTurnInput::ResponseItem(output(None));
+    assert!(start_or_steer_has_explicit_input(&standalone).unwrap());
+    assert!(first_step_user_input(&standalone).unwrap().is_empty());
+    let ordinary = SubmittedTurnInput::UserInput {
+        content: vec![text("same user")],
+        client_id: Some(String::new()),
+    };
+    assert_eq!(
+        first_step_user_input(&ordinary).unwrap(),
+        vec![text("same user")]
+    );
+    assert!(
+        !start_or_steer_has_explicit_input(&SubmittedTurnInput::UserInput {
+            content: Vec::new(),
+            client_id: None
+        })
+        .unwrap()
+    );
+}
+
+#[test]
+fn original_start_classification_rejects_reply_ids_other_items_and_mail_without_mutation() {
+    let other =
+        serde_json::from_value(serde_json::json!({"type":"message","role":"user","content":[]}))
+            .unwrap();
+    for input in [
+        SubmittedTurnInput::ResponseItem(output(Some("actual-reply".into()))),
+        SubmittedTurnInput::ResponseItem(other),
+        SubmittedTurnInput::InterAgentCommunication(mail()),
+    ] {
+        let original = input.clone();
+        let error = start_or_steer_has_explicit_input(&input).unwrap_err();
+        let CodexErr::InvalidRequest(message) = error else {
+            panic!("original invalid-request error")
+        };
+        assert_eq!(
+            message,
+            "only user input or standalone function-call outputs can start or steer a turn"
+        );
+        assert!(first_step_user_input(&input).is_err());
+        assert_eq!(input, original);
+    }
+}
