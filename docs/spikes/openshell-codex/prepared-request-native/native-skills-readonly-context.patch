+/// Observes the existing installer's marker without creating or repairing files.
+/// This is its installation predicate, not a lease or validation of every skill byte.
+pub fn system_skills_installation_is_current(codex_home: &AbsolutePathBuf) -> bool {
+    system_skills_marker_matches(
+        &system_cache_root_dir(codex_home),
+        &embedded_system_skills_fingerprint(),
+    )
+}
+
+fn system_skills_marker_matches(dest_system: &AbsolutePathBuf, expected_fingerprint: &str) -> bool {
+    let marker_path = dest_system.join(SYSTEM_SKILLS_MARKER_FILENAME);
+    dest_system.as_path().is_dir()
+        && read_marker(&marker_path).is_ok_and(|marker| marker == expected_fingerprint)
+}
+
 fn read_marker(path: &AbsolutePathBuf) -> Result<String, SystemSkillsError> {
     Ok(fs::read_to_string(path.as_path())
         .map_err(|source| SystemSkillsError::io("read system skills marker", source))?
