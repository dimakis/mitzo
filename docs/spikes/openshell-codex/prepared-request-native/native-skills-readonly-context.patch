new file mode 100644
index 0000000..f4f6299
--- /dev/null
+++ b/codex-rs/ext/skills/src/host_pre_session.rs
@@ -0,0 +1,94 @@
+use std::sync::Arc;
+
+use codex_config::bundled_skills_enabled_from_stack;
+use codex_config::skill_config_rules_from_stack;
+use codex_exec_server::ExecutorFileSystem;
+use codex_skills::system_skills_installation_is_current;
+
+use super::HostSkillsLoadInput;
+use super::HostSkillsService;
+use super::apply_skill_config_rules;
+use crate::HostSkillsSnapshot;
+use crate::loader::observe_and_merge_host_skill_roots;
+
+/// Read-only discovery from the original host service. Main-prompt bytes are not
+/// frozen here, and no configuration/filesystem publication lease is established.
+/// This observation alone cannot authorize count association, consume or dispatch.
+pub struct HostSkillsObservation {
+    service: Arc<HostSkillsService>,
+    snapshot: HostSkillsSnapshot,
+}
+
+impl HostSkillsObservation {
+    pub fn snapshot(&self) -> &HostSkillsSnapshot {
+        &self.snapshot
+    }
+}
+
+#[derive(Debug, PartialEq, Eq)]
+pub enum HostSkillsObservationError {
+    BundledSkillsRequireInstallation,
+    ExtraRootsChanged,
+    DiscoveryErrors(Vec<String>),
+    ForeignService,
+}
+
+impl HostSkillsService {
+    /// Discovers through the original service's roots, restrictions and loader,
+    /// bypassing installer and shared cache publication. Missing/stale bundled
+    /// materialization and discovery errors refuse instead of proving absence.
+    pub async fn observe_pre_session_for_config(
+        self: &Arc<Self>,
+        input: &HostSkillsLoadInput,
+        fs: Option<Arc<dyn ExecutorFileSystem>>,
+    ) -> Result<HostSkillsObservation, HostSkillsObservationError> {
+        let bundled = bundled_skills_enabled_from_stack(&input.config_layer_stack);
+        if bundled && !system_skills_installation_is_current(&self.codex_home) {
+            return Err(HostSkillsObservationError::BundledSkillsRequireInstallation);
+        }
+        let extra_roots = self.extra_roots();
+        let roots = self
+            .resolve_skill_roots_for_config(input, fs, extra_roots.clone())
+            .await;
+        let rules = skill_config_rules_from_stack(&input.config_layer_stack);
+        let outcome = observe_and_merge_host_skill_roots(
+            roots,
+            &self.root_scan_slots,
+            self.restriction_product,
+            input.plugin_skill_snapshots.as_ref(),
+        )
+        .await;
+        let outcome = apply_skill_config_rules(outcome, &rules);
+        if extra_roots != self.extra_roots() {
+            return Err(HostSkillsObservationError::ExtraRootsChanged);
+        }
+        if bundled && !system_skills_installation_is_current(&self.codex_home) {
+            return Err(HostSkillsObservationError::BundledSkillsRequireInstallation);
+        }
+        if !outcome.errors.is_empty() {
+            return Err(HostSkillsObservationError::DiscoveryErrors(
+                outcome
+                    .errors
+                    .iter()
+                    .map(|error| error.message.clone())
+                    .collect(),
+            ));
+        }
+        Ok(HostSkillsObservation {
+            service: Arc::clone(self),
+            snapshot: HostSkillsSnapshot::new(Arc::new(outcome)),
+        })
+    }
+
+    /// Checks only original service identity. Fresh source/configuration/byte
+    /// currentness and atomic consumption require their separate owner guards.
+    pub fn assert_pre_session_observation_owner(
+        &self,
+        observation: &HostSkillsObservation,
+    ) -> Result<(), HostSkillsObservationError> {
+        if !std::ptr::eq(self, observation.service.as_ref()) {
+            return Err(HostSkillsObservationError::ForeignService);
+        }
+        Ok(())
+    }
+}
