@@ -0,0 +1,171 @@
+use super::*;
+
+#[tokio::test]
+async fn observation_refuses_missing_bundled_materialization_without_installing() {
+    let home = tempfile::tempdir().unwrap();
+    let cwd = tempfile::tempdir().unwrap();
+    let service = Arc::new(HostSkillsService::new(
+        home.path().abs(),
+        /*bundled_skills_enabled*/ false,
+    ));
+    let input = HostSkillsLoadInput::new(cwd.path().abs(), Vec::new(), config_stack(&home, ""));
+    let result = service
+        .observe_pre_session_for_config(&input, Some(Arc::clone(&LOCAL_FS)))
+        .await;
+    assert!(matches!(
+        result,
+        Err(HostSkillsObservationError::BundledSkillsRequireInstallation)
+    ));
+    assert!(!home.path().join("skills").exists());
+    assert!(service.cache_by_config.read().unwrap().is_empty());
+    assert!(service.cache_by_cwd.read().unwrap().is_empty());
+}
+
+#[tokio::test]
+async fn observation_preserves_ordinary_knowledge_catalog_without_publishing_plugin_cache() {
+    let home = tempfile::tempdir().unwrap();
+    let cwd = tempfile::tempdir().unwrap();
+    write_user_skill(
+        &home,
+        "knowledge",
+        "knowledge-host",
+        "Original Knowledge description",
+    );
+    let plugin_path = write_plugin_skill(&home, "test", "sample", "search", "search", "plugin");
+    let plugin_root = plugin_skill_root_for_skill_path(&plugin_path, "sample@test", "sample");
+    let cache = Arc::new(TestPluginSkillSnapshotCache::default());
+    let snapshots = SkillRootSnapshots::new(cache.clone());
+    let input = HostSkillsLoadInput::new(
+        cwd.path().abs(),
+        vec![plugin_root],
+        config_stack(&home, "[skills.bundled]\nenabled = false\n"),
+    )
+    .with_plugin_skill_snapshots(Some(snapshots));
+    let service = Arc::new(HostSkillsService::new(
+        home.path().abs(),
+        /*bundled_skills_enabled*/ false,
+    ));
+    let observed = service
+        .observe_pre_session_for_config(&input, Some(Arc::clone(&LOCAL_FS)))
+        .await
+        .unwrap();
+    service
+        .assert_pre_session_observation_owner(&observed)
+        .unwrap();
+    assert!(
+        observed
+            .snapshot()
+            .outcome()
+            .skills
+            .iter()
+            .any(|skill| skill.name == "knowledge-host")
+    );
+    assert!(cache.snapshots.lock().unwrap().is_empty());
+    assert!(service.cache_by_config.read().unwrap().is_empty());
+    assert!(service.cache_by_cwd.read().unwrap().is_empty());
+    let ordinary = service
+        .snapshot_for_config(&input, Some(Arc::clone(&LOCAL_FS)))
+        .await;
+    assert_eq!(
+        observed.snapshot().outcome().skills,
+        ordinary.outcome().skills
+    );
+    assert_eq!(
+        observed.snapshot().outcome().disabled_paths,
+        ordinary.outcome().disabled_paths
+    );
+    assert_eq!(
+        observed.snapshot().outcome().errors,
+        ordinary.outcome().errors
+    );
+    assert!(!cache.snapshots.lock().unwrap().is_empty());
+    let foreign = HostSkillsService::new(home.path().abs(), /*bundled_skills_enabled*/ false);
+    assert_eq!(
+        foreign.assert_pre_session_observation_owner(&observed),
+        Err(HostSkillsObservationError::ForeignService)
+    );
+}
+
+#[tokio::test]
+async fn observation_reads_changed_source_without_replacing_ordinary_cached_catalog() {
+    let home = tempfile::tempdir().unwrap();
+    let cwd = tempfile::tempdir().unwrap();
+    write_user_skill(&home, "knowledge", "knowledge-host", "original");
+    let input = HostSkillsLoadInput::new(
+        cwd.path().abs(),
+        Vec::new(),
+        config_stack(&home, "[skills.bundled]\nenabled = false\n"),
+    );
+    let service = Arc::new(HostSkillsService::new(
+        home.path().abs(),
+        /*bundled_skills_enabled*/ false,
+    ));
+    let ordinary = service
+        .snapshot_for_config(&input, Some(Arc::clone(&LOCAL_FS)))
+        .await;
+    write_user_skill(&home, "knowledge", "knowledge-host", "changed source");
+    let observed = service
+        .observe_pre_session_for_config(&input, Some(Arc::clone(&LOCAL_FS)))
+        .await
+        .unwrap();
+    assert_eq!(
+        observed
+            .snapshot()
+            .outcome()
+            .skills
+            .iter()
+            .find(|skill| skill.name == "knowledge-host")
+            .unwrap()
+            .description,
+        "changed source"
+    );
+    let retained = service
+        .snapshot_for_config(&input, Some(Arc::clone(&LOCAL_FS)))
+        .await;
+    assert_eq!(retained.outcome().skills, ordinary.outcome().skills);
+    assert_eq!(
+        retained
+            .outcome()
+            .skills
+            .iter()
+            .find(|skill| skill.name == "knowledge-host")
+            .unwrap()
+            .description,
+        "original"
+    );
+}
+
+#[tokio::test]
+async fn observation_refuses_discovery_errors_without_overwriting_ordinary_cache() {
+    let home = tempfile::tempdir().unwrap();
+    let cwd = tempfile::tempdir().unwrap();
+    write_user_skill(&home, "knowledge", "knowledge-host", "original");
+    let input = HostSkillsLoadInput::new(
+        cwd.path().abs(),
+        Vec::new(),
+        config_stack(&home, "[skills.bundled]\nenabled = false\n"),
+    );
+    let service = Arc::new(HostSkillsService::new(
+        home.path().abs(),
+        /*bundled_skills_enabled*/ false,
+    ));
+    let ordinary = service
+        .snapshot_for_config(&input, Some(Arc::clone(&LOCAL_FS)))
+        .await;
+    fs::write(
+        home.path().join("skills/knowledge/SKILL.md"),
+        "---\nname: knowledge-host\n---\n",
+    )
+    .unwrap();
+    let result = service
+        .observe_pre_session_for_config(&input, Some(Arc::clone(&LOCAL_FS)))
+        .await;
+    assert!(
+        matches!(result, Err(HostSkillsObservationError::DiscoveryErrors(errors)) if !errors.is_empty())
+    );
+    let retained = service
+        .snapshot_for_config(&input, Some(Arc::clone(&LOCAL_FS)))
+        .await;
+    assert_eq!(retained.outcome().skills, ordinary.outcome().skills);
+    assert_eq!(retained.outcome().errors, ordinary.outcome().errors);
+}
