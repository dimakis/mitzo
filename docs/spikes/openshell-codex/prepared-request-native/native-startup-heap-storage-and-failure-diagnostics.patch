+
+#[tokio::test]
+async fn retained_client_heap_snapshot_keeps_same_client_and_ordinary_optional_layout()
+-> anyhow::Result<()> {
+    let (session, _turn) = crate::session::tests::make_session_and_context().await;
+    let session = Arc::new(session);
+    let config = session.get_config().await;
+    let options = crate::StartThreadOptions::new(config.as_ref().clone());
+    let state = session.state.lock().await;
+    let configuration = &state.session_configuration;
+    let routing = session
+        .services
+        .thread_extension_data
+        .get_or_init(|| config.workspace_routing_context());
+    assert!(configuration.provider.info().is_openai());
+    assert!(configuration.provider.info().gateway_oauth.is_none());
+    assert!(configuration.provider.info().aws.is_none());
+    assert!(configuration.provider.info().auth.is_none());
+    let inputs = || OriginalSessionModelClientInputs {
+        config: config.as_ref(),
+        provider_info: configuration.provider.info(),
+        session_source: &configuration.session_source,
+        originator: &configuration.originator,
+        parent_thread_id: configuration.parent_thread_id,
+        auth_manager: &session.services.auth_manager,
+        thread_id: session.thread_id(),
+        initial_history: &options.initial_history,
+        reasoning_effort_override_enabled: original_effort_override(
+            config.as_ref(),
+            configuration.thread_source.as_ref(),
+        ),
+        attestation_provider: session.services.attestation_provider.clone(),
+        workspace_routing: &routing,
+        extensions: session.services.extensions.as_ref(),
+        executed_tool_calls: &session.services.executed_tool_calls,
+        fork_cache_key: None,
+        tx_event: &session.tx_event,
+        codex_responses_headers: session
+            .services
+            .thread_extension_data
+            .get::<crate::CodexResponsesHeaders>(),
+    };
+    // These original layouts are present in ordinary futures even for None and
+    // NotConstructed. Keep both retained Configs out of their inline footprint.
+    assert!(std::mem::size_of::<RetainedOriginalClient>() < std::mem::size_of::<Config>());
+    assert!(
+        std::mem::size_of::<Option<super::super::client_input_data::OriginalClientInputData>>()
+            < std::mem::size_of::<Config>()
+    );
+    let retained = inputs().retain(Arc::clone(&session.services.extensions));
+    let snapshot: &Box<Config> = &retained.facts.config;
+    assert_eq!(snapshot.as_ref(), config.as_ref());
+    let address = snapshot.as_ref() as *const Config;
+    let witness = retained.client().clone();
+    let moved = Box::new(retained);
+    assert!(std::ptr::eq(moved.facts.config.as_ref(), address));
+    let adopted = (*moved).adopt(inputs())?;
+    assert!(witness.same_private_state_for_test(&adopted));
+    Ok(())
+}
