+#[tokio::test]
+async fn retained_startup_config_heap_storage_preserves_values_and_original_adoption()
+-> anyhow::Result<()> {
+    let (_home, options, auth, models, _) = fixture().await?;
+    let startup =
+        OriginalStartupSelection::capture(&options, &SessionSource::Exec, None, &auth, &models)
+            .await?;
+    // A layout regression matters even when the ordinary path carries None.
+    assert!(std::mem::size_of::<Option<StartupSelectionOwner>>() < std::mem::size_of::<Config>());
+    assert!(std::mem::size_of::<OriginalStartupSelection>() < std::mem::size_of::<Config>());
+    let raw: &Box<Config> = &startup.owner.raw;
+    assert_eq!(raw.as_ref(), &options.config);
+    let address = raw.as_ref() as *const Config;
+    let effective = startup.effective_config().clone();
+    let moved = Box::new(startup);
+    assert!(std::ptr::eq(moved.raw_config(), address));
+    let (owner, _stages, adopted_raw) = (*moved).into_session(
+        &models,
+        &auth,
+        &effective,
+        configured_settings_data::ConfiguredBaselineInputs::from_options(&options, None),
+        &SessionSource::Exec,
+    )?;
+    assert!(std::ptr::eq(owner.raw.as_ref(), address));
+    assert_eq!(adopted_raw, options.config);
+    assert_eq!(owner.raw.as_ref(), &adopted_raw);
+    Ok(())
+}
