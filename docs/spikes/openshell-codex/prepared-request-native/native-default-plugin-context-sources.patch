+
+pub struct RegisteredMemoriesSource {
+    registration: RegisteredPromptContextSource<MemoriesExtension>,
+}
+
+/// Source-owned prompt absence for this borrowed fresh configuration only.
+/// Enabled memories require actual summary custody even without dedicated tools.
+/// This does not attest to external configuration or filesystem currency.
+pub struct MemoriesInitialObservation<'a> {
+    _source: &'a MemoriesExtension,
+    config: &'a Config,
+    fragments: Vec<PromptFragment>,
+}
+
+#[derive(Debug, PartialEq, Eq)]
+pub enum MemoriesObservationError {
+    Registration(ContextSourceRegistrationError),
+    UnresolvedSummarySource,
+}
+
+pub fn registered_memories_sources(
+    registry: &ExtensionRegistry<Config>,
+) -> Vec<RegisteredMemoriesSource> {
+    registry
+        .registered_prompt_context_sources::<MemoriesExtension>()
+        .into_iter()
+        .map(|registration| RegisteredMemoriesSource { registration })
+        .collect()
+}
+
+impl RegisteredMemoriesSource {
+    /// Shares the ordinary config projection, not the weaker NoTools plan.
+    /// No summary read, backend construction, lifecycle, metrics or tool runs.
+    pub fn observe_initial_context<'a>(
+        &self,
+        registry: &'a ExtensionRegistry<Config>,
+        config: &'a Config,
+    ) -> Result<MemoriesInitialObservation<'a>, MemoriesObservationError> {
+        let source = registry
+            .borrow_prompt_context_source(&self.registration)
+            .map_err(MemoriesObservationError::Registration)?;
+        if MemoriesExtensionConfig::from_config(config).enabled {
+            return Err(MemoriesObservationError::UnresolvedSummarySource);
+        }
+        Ok(MemoriesInitialObservation {
+            _source: source,
+            config,
+            fragments: Vec::new(),
+        })
+    }
+}
+
+impl MemoriesInitialObservation<'_> {
+    pub fn captured_config(&self) -> &Config {
+        self.config
+    }
+
+    pub fn initial_fragments(&self) -> &[PromptFragment] {
+        &self.fragments
+    }
+}
