index 0000000000000000000000000000000000000000..82fea6a41c44d20fee18e1aea95c9a4358a14487
--- /dev/null
+++ b/codex-rs/core-plugins/src/pre_session_empty_sources.rs
@@ -0,0 +1,578 @@
+//! Passive empty host-plugin source selection from the actual original owner.
+//! No loader/cache publication, filesystem read, provider callback or fetch runs.
+
+use std::sync::Arc;
+
+use codex_login::auth::CapturedApiKeyCredentials;
+
+use super::LoadedPluginsCacheEntry;
+use super::PluginLoadCacheKey;
+use super::PluginLoadOutcome;
+use super::PluginsConfigInput;
+use super::PluginsManager;
+use super::RemoteInstalledPluginsAuthIdentity;
+use crate::remote::RemotePluginCatalogError;
+use crate::remote::ensure_chatgpt_auth;
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum InstalledPluginSourceSelection {
+    /// Original API route cannot use the backend installed producer, and the
+    /// actual manager selects no matching installed publication. NOT a claim
+    /// that an unpublished/failed backend provider returned an empty inventory.
+    ApiDomainWithoutSelectedInstalledRows,
+    PublishedEmptyInstalledRows,
+}
+
+#[derive(Debug, Eq, PartialEq, thiserror::Error)]
+pub enum EmptyPluginSourcesError {
+    #[error("original cached API-key credentials are unavailable or changed")]
+    UnresolvedCredentials,
+    #[error("configured plugin sources require qualified materialization")]
+    ConfiguredSources,
+    #[error("retained installed or loaded plugin sources require qualified materialization")]
+    RetainedSources,
+    #[error("original plugin source publication changed")]
+    SourceChanged,
+}
+
+/// Original source/input custody only. No external Config/permission/selection
+/// or filesystem lease; no full request, count, State or admission authority.
+pub struct EmptyPluginSourcesObservation {
+    owner: Arc<PluginsManager>,
+    credentials: Arc<CapturedApiKeyCredentials>,
+    config: PluginsConfigInput,
+    cache_key: PluginLoadCacheKey,
+    loaded_generation: u64,
+    loaded_publication: Arc<()>,
+    loaded_entry: Option<Arc<LoadedPluginsCacheEntry>>,
+    installed_publication: Arc<()>,
+    installed_selection: InstalledPluginSourceSelection,
+    outcome: PluginLoadOutcome,
+}
+
+impl PluginsManager {
+    /// Observe the actual API route and complete empty applicable input set.
+    /// Enabled default flags remain enabled. Matching installed rows or any
+    /// nonempty loaded entry are refused, including API-eligible local MCP.
+    /// Backend/unavailable/external auth cannot use the API-domain exception.
+    pub fn observe_empty_api_key_sources(
+        self: &Arc<Self>,
+        config: &PluginsConfigInput,
+        credentials: Arc<CapturedApiKeyCredentials>,
+    ) -> Result<EmptyPluginSourcesObservation, EmptyPluginSourcesError> {
+        let auth = self
+            .auth_manager
+            .with_current_api_key_credentials(&credentials, |auth, _| auth.clone())
+            .ok_or(EmptyPluginSourcesError::UnresolvedCredentials)?;
+        if !matches!(
+            ensure_chatgpt_auth(Some(&auth)),
+            Err(RemotePluginCatalogError::UnsupportedAuthMode)
+        ) {
+            return Err(EmptyPluginSourcesError::UnresolvedCredentials);
+        }
+        // Bounded first support: actual effective stack has no configured
+        // plugin/marketplace selection at all. No malformed value, policy parse
+        // fallback, failed capability read or ignored configured row proves empty.
+        let effective = config.config_layer_stack.effective_config();
+        if !config.plugins_enabled
+            || effective.get("plugins").is_some()
+            || effective.get("marketplaces").is_some()
+        {
+            return Err(EmptyPluginSourcesError::ConfiguredSources);
+        }
+        let auth_identity = RemoteInstalledPluginsAuthIdentity::from_auth(Some(&auth));
+        let cache_key = PluginLoadCacheKey::from_config(
+            config,
+            self.codex_home.as_path(),
+            config.remote_plugin_enabled && auth.api_auth_mode().uses_codex_backend(),
+            auth_identity.clone(),
+        );
+        let (
+            installed_selection,
+            installed_publication,
+            loaded_generation,
+            loaded_publication,
+            loaded_entry,
+        ) = {
+            let installed = self
+                .remote_installed_plugins_cache
+                .read()
+                .map_err(|_| EmptyPluginSourcesError::SourceChanged)?;
+            if installed.reconciliation_generation.is_some()
+                || installed.needs_effective_plugins_refresh
+            {
+                return Err(EmptyPluginSourcesError::RetainedSources);
+            }
+            let selection = if installed.auth_identity.as_ref() == Some(&auth_identity) {
+                match installed.plugins.as_ref() {
+                    Some(rows) if !rows.is_empty() => {
+                        return Err(EmptyPluginSourcesError::RetainedSources);
+                    }
+                    Some(_) => InstalledPluginSourceSelection::PublishedEmptyInstalledRows,
+                    None => InstalledPluginSourceSelection::ApiDomainWithoutSelectedInstalledRows,
+                }
+            } else {
+                InstalledPluginSourceSelection::ApiDomainWithoutSelectedInstalledRows
+            };
+            let loaded = self
+                .loaded_plugins_cache
+                .lock()
+                .map_err(|_| EmptyPluginSourcesError::SourceChanged)?;
+            let entry = loaded
+                .entries
+                .iter()
+                .find(|entry| entry.key == cache_key)
+                .cloned();
+            if entry
+                .as_ref()
+                .is_some_and(|entry| !entry.plugins.is_empty())
+            {
+                return Err(EmptyPluginSourcesError::RetainedSources);
+            }
+            (
+                selection,
+                Arc::clone(&installed.source_publication),
+                loaded.generation,
+                Arc::clone(&loaded.source_publication),
+                entry,
+            )
+        };
+        // Auth is rechecked AFTER dropping plugin locks. Original ordinary
+        // readers acquire installed state before auth; do not invert that order.
+        self.auth_manager
+            .with_current_api_key_credentials(&credentials, |_, _| ())
+            .ok_or(EmptyPluginSourcesError::UnresolvedCredentials)?;
+        let outcome = self.resolve_loaded_plugins_for_auth(Vec::new(), Some(auth.api_auth_mode()));
+        Ok(EmptyPluginSourcesObservation {
+            owner: Arc::clone(self),
+            credentials,
+            config: config.clone(),
+            cache_key,
+            loaded_generation,
+            loaded_publication,
+            loaded_entry,
+            installed_publication,
+            installed_selection,
+            outcome,
+        })
+    }
+}
+
+impl EmptyPluginSourcesObservation {
+    pub fn installed_selection(&self) -> InstalledPluginSourceSelection {
+        self.installed_selection
+    }
+
+    pub fn loaded_plugins(&self) -> &PluginLoadOutcome {
+        &self.outcome
+    }
+
+    pub fn captured_config(&self) -> &PluginsConfigInput {
+        &self.config
+    }
+
+    /// Compare frozen ordinary input data, not current upstream settings.
+    pub fn matches_config(&self, config: &PluginsConfigInput) -> bool {
+        self.config.config_layer_stack == config.config_layer_stack
+            && self.config.model_provider_id == config.model_provider_id
+            && self.config.plugins_enabled == config.plugins_enabled
+            && self.config.remote_plugin_enabled == config.remote_plugin_enabled
+            && self.config.chatgpt_base_url == config.chatgpt_base_url
+            && self.config.product_sku == config.product_sku
+    }
+
+    pub fn belongs_to(&self, owner: &Arc<PluginsManager>) -> bool {
+        Arc::ptr_eq(&self.owner, owner)
+    }
+
+    /// Identity of the same retained original opaque credential observation.
+    pub fn uses_credentials(&self, credentials: &CapturedApiKeyCredentials) -> bool {
+        std::ptr::eq(self.credentials.as_ref(), credentials)
+    }
+
+    /// Hold the original installed/loaded publishers, THEN original auth,
+    /// through one bounded SYNCHRONOUS native action. This lock order follows
+    /// existing installed readers; do not call under another AuthManager guard
+    /// or reenter these owners. Returning an async action loses all fences.
+    /// Other required owners and the actual State commit remain the factory's job.
+    pub fn with_current_api_key_sources<R>(
+        &self,
+        action: impl FnOnce() -> R,
+    ) -> Result<R, EmptyPluginSourcesError> {
+        let installed = self
+            .owner
+            .remote_installed_plugins_cache
+            .read()
+            .map_err(|_| EmptyPluginSourcesError::SourceChanged)?;
+        if !Arc::ptr_eq(&installed.source_publication, &self.installed_publication) {
+            return Err(EmptyPluginSourcesError::SourceChanged);
+        }
+        let loaded = self
+            .owner
+            .loaded_plugins_cache
+            .lock()
+            .map_err(|_| EmptyPluginSourcesError::SourceChanged)?;
+        let current = loaded
+            .entries
+            .iter()
+            .find(|entry| entry.key == self.cache_key);
+        let same_entry = match (&self.loaded_entry, current) {
+            (None, None) => true,
+            (Some(original), Some(current)) => Arc::ptr_eq(original, current),
+            _ => false,
+        };
+        if loaded.generation != self.loaded_generation
+            || !Arc::ptr_eq(&loaded.source_publication, &self.loaded_publication)
+            || !same_entry
+        {
+            return Err(EmptyPluginSourcesError::SourceChanged);
+        }
+        let result = self
+            .owner
+            .auth_manager
+            .with_current_api_key_credentials(&self.credentials, |_, _| action())
+            .ok_or(EmptyPluginSourcesError::UnresolvedCredentials);
+        drop(loaded);
+        drop(installed);
+        result
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use codex_login::AuthManager;
+    use codex_login::CodexAuth;
