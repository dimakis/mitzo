+    async fn setup() -> (
+        tempfile::TempDir,
+        Arc<PluginsManager>,
+        PluginsConfigInput,
+        Arc<CapturedApiKeyCredentials>,
+    ) {
+        let home = tempfile::tempdir().unwrap();
+        let auth =
+            AuthManager::from_auth_for_testing(CodexAuth::from_api_key("offline-no-model-call"));
+        let credentials = Arc::new(auth.capture_cached_api_key_credentials().unwrap());
+        let owner = Arc::new(crate::test_support::test_plugins_manager_with_auth_manager(
+            home.path().to_path_buf(),
+            None,
+            auth,
+        ));
+        let config = crate::test_support::load_plugins_config(home.path(), home.path()).await;
+        assert!(config.plugins_enabled);
+        assert!(config.remote_plugin_enabled);
+        (home, owner, config, credentials)
+    }
+
+    #[tokio::test]
+    async fn original_api_owner_classifies_inapplicable_domain_without_loading_or_publishing() {
+        let (_home, owner, config, credentials) = setup().await;
+        let before = Arc::clone(
+            &owner
+                .remote_installed_plugins_cache
+                .read()
+                .unwrap()
+                .source_publication,
+        );
+        let observed = owner
+            .observe_empty_api_key_sources(&config, credentials)
+            .unwrap();
+        assert_eq!(
+            observed.installed_selection(),
+            InstalledPluginSourceSelection::ApiDomainWithoutSelectedInstalledRows
+        );
+        assert!(observed.loaded_plugins().plugins().is_empty());
+        assert!(observed.loaded_plugins().capability_summaries().is_empty());
+        assert!(observed.matches_config(&config));
+        assert!(observed.belongs_to(&owner));
+        assert!(Arc::ptr_eq(
+            &before,
+            &owner
+                .remote_installed_plugins_cache
+                .read()
+                .unwrap()
+                .source_publication
+        ));
+        assert!(
+            owner
+                .remote_installed_plugins_cache
+                .read()
+                .unwrap()
+                .plugins
+                .is_none()
+        );
+        assert!(
+            owner
+                .loaded_plugins_cache
+                .lock()
+                .unwrap()
+                .entries
+                .is_empty()
+        );
+        assert_eq!(
+            observed.with_current_api_key_sources(|| {
+                assert!(owner.remote_installed_plugins_cache.try_write().is_err());
+                assert!(owner.loaded_plugins_cache.try_lock().is_err());
+                47
+            }),
+            Ok(47)
+        );
+        assert!(owner.remote_installed_plugins_cache.try_write().is_ok());
+        assert!(owner.loaded_plugins_cache.try_lock().is_ok());
+    }
+
