+struct OriginalOwnerSource {
+    closed: bool,
+    calls: Arc<AtomicUsize>,
+    observed_pointer: Arc<AtomicUsize>,
+}
+
+impl McpServerContributor<()> for OriginalOwnerSource {
+    fn id(&self) -> &'static str {
+        "original-owner"
+    }
+    fn contribute<'a>(
+        &'a self,
+        _context: McpServerContributionContext<'a, ()>,
+    ) -> ExtensionFuture<'a, Vec<McpServerContribution>> {
+        self.calls.fetch_add(1, Ordering::SeqCst);
+        Box::pin(async { Vec::new() })
+    }
+}
+
+fn original_owner_plan(
+    source: &OriginalOwnerSource,
+    _context: McpPreSessionContext<'_, ()>,
+) -> McpPreSessionOverlay {
+    source
+        .observed_pointer
+        .store(std::ptr::from_ref(source) as usize, Ordering::SeqCst);
+    if source.closed {
+        McpPreSessionOverlay::NoContributions
+    } else {
+        McpPreSessionOverlay::Unresolved
+    }
+}
