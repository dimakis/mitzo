+#[tokio::test]
+async fn registered_memory_prompt_absence_does_not_follow_nondedicated_tool_absence() {
+    use codex_core::config::ConfigBuilder;
+    use codex_features::Feature;
+
+    let home = tempfile::tempdir().unwrap();
+    let config = ConfigBuilder::default()
+        .codex_home(home.path().to_path_buf())
+        .build()
+        .await
+        .unwrap();
+    assert!(!config.features.enabled(Feature::MemoryTool));
+    let mut builder = ExtensionRegistryBuilder::new();
+    crate::install(&mut builder, None);
+    let registry = builder.build();
+    let context = {
+        let sources = crate::registered_memories_sources(&registry);
+        assert_eq!(sources.len(), 1);
+        sources[0]
+            .observe_initial_context(&registry, &config)
+            .unwrap()
+    };
+    assert!(std::ptr::eq(context.captured_config(), &config));
+    assert!(context.initial_fragments().is_empty());
+    let sources = crate::registered_memories_sources(&registry);
+    assert!(matches!(
+        sources[0].observe_initial_context(&registry.to_builder().build(), &config),
+        Err(crate::MemoriesObservationError::Registration(
+            codex_extension_api::ContextSourceRegistrationError::RegistryChanged
+        ))
+    ));
+
+    let mut enabled = config.clone();
+    enabled.features.enable(Feature::MemoryTool).unwrap();
+    enabled.memories.use_memories = true;
+    enabled.memories.dedicated_tools = false;
+    assert!(
+        registry
+            .capture_pre_session_tools_for_config(&enabled)
+            .unwrap()
+            .definitions()
+            .is_empty()
+    );
+    assert!(matches!(
+        sources[0].observe_initial_context(&registry, &enabled),
+        Err(crate::MemoriesObservationError::UnresolvedSummarySource)
+    ));
+    let memory_root = enabled
+        .codex_home
+        .join(enabled.memories.version.directory_name());
+    tokio::fs::create_dir_all(&memory_root).await.unwrap();
+    tokio::fs::write(
+        memory_root.join("memory_summary.md"),
+        "actual summary bytes",
+    )
+    .await
+    .unwrap();
+    let session = ExtensionData::new("ordinary-session");
+    let thread = ExtensionData::new("ordinary-thread");
+    for contributor in registry.thread_lifecycle_contributors() {
+        contributor
+            .on_thread_start(codex_extension_api::ThreadStartInput {
+                config: &enabled,
+                session_source: &codex_protocol::protocol::SessionSource::Exec,
+                persistent_thread_state_available: false,
+                environments: &[],
+                mcp_resource_client: None,
+                extension_metrics: None,
+                session_store: &session,
+                thread_store: &thread,
+            })
+            .await;
+    }
+    let ordinary = registry.context_contributors()[0]
+        .contribute_thread_context(&session, &thread)
+        .await;
+    assert!(!ordinary.is_empty());
+    assert!(
+        ordinary
+            .iter()
+            .any(|fragment| fragment.text().contains("actual summary bytes"))
+    );
+    assert!(
+        registry
+            .tool_contributors()
+            .iter()
+            .all(|source| source.tools(&session, &thread).is_empty())
