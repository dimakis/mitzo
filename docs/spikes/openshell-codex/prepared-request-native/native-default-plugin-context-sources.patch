+
+/// The actual installed prompt allocation, independent of its tool partition.
+pub struct RegisteredHistoryNotesSource {
+    registration: RegisteredPromptContextSource<HistoryNotesExtension>,
+}
+
+/// Source-owned prompt absence for the borrowed fresh configuration only.
+/// This is not a configuration-publication, account or whole-request lease.
+pub struct HistoryNotesInitialObservation<'a> {
+    _source: &'a HistoryNotesExtension,
+    config: &'a Config,
+    fragments: Vec<PromptFragment>,
+}
+
+#[derive(Debug, PartialEq, Eq)]
+pub enum HistoryNotesObservationError {
+    Registration(ContextSourceRegistrationError),
+    UnresolvedHintSource,
+}
+
+pub fn registered_history_notes_sources(
+    registry: &ExtensionRegistry<Config>,
+) -> Vec<RegisteredHistoryNotesSource> {
+    registry
+        .registered_prompt_context_sources::<HistoryNotesExtension>()
+        .into_iter()
+        .map(|registration| RegisteredHistoryNotesSource { registration })
+        .collect()
+}
+
+impl RegisteredHistoryNotesSource {
+    /// Uses the SAME predicate that prevents ordinary backend installation.
+    /// An enabled config still requires genuine account/agent/hint custody;
+    /// missing auth, backend failure or a missing thread is not absence proof.
+    /// No auth lookup, HTTP, lifecycle, analytics or tool callback is invoked.
+    pub fn observe_initial_context<'a>(
+        &self,
+        registry: &'a ExtensionRegistry<Config>,
+        config: &'a Config,
+    ) -> Result<HistoryNotesInitialObservation<'a>, HistoryNotesObservationError> {
+        let source = registry
+            .borrow_prompt_context_source(&self.registration)
+            .map_err(HistoryNotesObservationError::Registration)?;
+        if tool_selection(config) != ToolPreSessionSelection::NoTools {
+            return Err(HistoryNotesObservationError::UnresolvedHintSource);
+        }
+        Ok(HistoryNotesInitialObservation {
+            _source: source,
+            config,
+            fragments: Vec::new(),
+        })
+    }
+}
+
+impl HistoryNotesInitialObservation<'_> {
+    pub fn captured_config(&self) -> &Config {
+        self.config
+    }
+
+    pub fn initial_fragments(&self) -> &[PromptFragment] {
+        &self.fragments
+    }
+}
