+
+    #[tokio::test]
+    async fn actual_installed_writer_preserves_rows_and_invalidates_generation_stable_aba() {
+        let (_home, owner, config, credentials) = setup().await;
+        let missing = owner
+            .observe_empty_api_key_sources(&config, Arc::clone(&credentials))
+            .unwrap();
+        owner.write_remote_installed_plugins_cache(Vec::new());
+        assert_eq!(
+            missing.with_current_api_key_sources(|| ()),
+            Err(EmptyPluginSourcesError::SourceChanged)
+        );
+        let empty = owner
+            .observe_empty_api_key_sources(&config, Arc::clone(&credentials))
+            .unwrap();
+        assert_eq!(
+            empty.installed_selection(),
+            InstalledPluginSourceSelection::PublishedEmptyInstalledRows
+        );
+        let generation = owner
+            .remote_installed_plugins_cache
+            .read()
+            .unwrap()
+            .generation;
+        owner.write_remote_installed_plugins_cache(vec![installed_local_row()]);
+        assert!(matches!(
+            owner.observe_empty_api_key_sources(&config, Arc::clone(&credentials)),
+            Err(EmptyPluginSourcesError::RetainedSources)
+        ));
+        owner.write_remote_installed_plugins_cache(Vec::new());
+        assert_eq!(
+            owner
+                .remote_installed_plugins_cache
+                .read()
+                .unwrap()
+                .generation,
+            generation
+        );
+        assert_eq!(
+            empty.with_current_api_key_sources(|| panic!("installed ABA cannot admit")),
+            Err::<(), _>(EmptyPluginSourcesError::SourceChanged)
+        );
+        let current = owner
+            .observe_empty_api_key_sources(&config, Arc::clone(&credentials))
+            .unwrap();
+        let auth = owner.auth_manager.auth_cached();
+        let reconcile = owner
+            .begin_remote_installed_plugins_reconcile(auth.as_ref())
+            .unwrap();
+        assert_eq!(
+            current.with_current_api_key_sources(|| ()),
+            Err(EmptyPluginSourcesError::SourceChanged)
+        );
+        assert!(matches!(
+            owner.observe_empty_api_key_sources(&config, Arc::clone(&credentials)),
+            Err(EmptyPluginSourcesError::RetainedSources)
+        ));
+        owner.abandon_remote_installed_plugins_reconcile(reconcile);
+        assert!(matches!(
+            owner.observe_empty_api_key_sources(&config, credentials),
+            Err(EmptyPluginSourcesError::RetainedSources)
+        ));
+    }
