+#[tokio::test]
+async fn source_bound_plan_uses_same_original_allocation_without_runtime_calls() {
+    let calls = Arc::new(AtomicUsize::new(0));
+    let pointer = Arc::new(AtomicUsize::new(0));
+    let owner = Arc::new(OriginalOwnerSource {
+        closed: true,
+        calls: Arc::clone(&calls),
+        observed_pointer: Arc::clone(&pointer),
+    });
+    let original = Arc::as_ptr(&owner) as usize;
+    let mut builder = ExtensionRegistryBuilder::new();
+    builder.mcp_server_contributor_with_source_plan(owner, original_owner_plan);
+    let registry = builder.build();
+    assert_eq!(
+        registry.pre_session_mcp_overlays(McpPreSessionContext::new(&(), &[])),
+        Ok(vec![McpPreSessionOverlay::NoContributions])
+    );
+    assert_eq!(pointer.load(Ordering::SeqCst), original);
+    assert_eq!(calls.load(Ordering::SeqCst), 0);
+    let copied = registry.to_builder().build();
+    assert_eq!(
+        copied.pre_session_mcp_overlays(McpPreSessionContext::new(&(), &[])),
+        Ok(vec![McpPreSessionOverlay::NoContributions])
+    );
+    assert_eq!(pointer.load(Ordering::SeqCst), original);
+    registry.mcp_server_contributors()[0]
+        .contribute(McpServerContributionContext::global(&()))
+        .await;
+    assert_eq!(calls.load(Ordering::SeqCst), 1);
+    let mut foreign = ExtensionRegistryBuilder::new();
+    foreign.mcp_server_contributor_with_source_plan(
+        Arc::new(OriginalOwnerSource {
+            closed: false,
+            calls: Arc::clone(&calls),
+            observed_pointer: Arc::clone(&pointer),
+        }),
+        original_owner_plan,
+    );
+    assert_eq!(
+        foreign
+            .build()
+            .pre_session_mcp_overlays(McpPreSessionContext::new(&(), &[])),
+        Err(vec![0])
+    );
+    assert_eq!(calls.load(Ordering::SeqCst), 1);
+}
