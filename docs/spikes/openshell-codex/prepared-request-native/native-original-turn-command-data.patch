+use super::*;
+use codex_app_server_protocol::ByteRange;
+use codex_app_server_protocol::TextElement;
+use codex_protocol::config_types::ModeKind;
+use codex_protocol::config_types::MultiAgentMode;
+use codex_protocol::config_types::Settings;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+
+fn input_variants() -> Vec<V2UserInput> {
+    vec![
+        V2UserInput::Text {
+            text: "héllo".to_string(),
+            text_elements: vec![TextElement::new(
+                ByteRange { start: 0, end: 3 },
+                Some("marker".to_string()),
+            )],
+        },
+        V2UserInput::Image {
+            image: V2ImageReference::Inline {
+                url: "data:image/png;base64,AA==".to_string(),
+            },
+            detail: None,
+        },
+        V2UserInput::Image {
+            image: V2ImageReference::File {
+                file_id: "file-kept".to_string(),
+            },
+            detail: Some(codex_protocol::models::ImageDetail::Original),
+        },
+        V2UserInput::LocalImage {
+            path: PathBuf::from("unread-image.png"),
+            detail: None,
+        },
+        V2UserInput::Audio {
+            url: "data:audio/wav;base64,AA==".to_string(),
+        },
+        V2UserInput::LocalAudio {
+            path: PathBuf::from("unread-audio.wav"),
+        },
+        V2UserInput::Skill {
+            name: "configured-skill".to_string(),
+            path: PathBuf::from("unread-SKILL.md"),
+        },
+        V2UserInput::Mention {
+            name: "original-mention".to_string(),
+            path: "source://kept".to_string(),
+        },
+    ]
+}
+
+// Reconstruct the API DATA after the original conversion and its existing
+// reverse conversion; this is an equality oracle, not a production constructor.
+fn roundtrip(params: TurnStartParams) -> TurnStartParams {
+    let data = OriginalTurnCommandData::new(params);
+    data.validate_tool_output().unwrap();
+    let (environment, input) = data.into_environment_stage();
+    let ConvertedTurnCommand {
+        input,
+        settings,
+        submission,
+        additional_context,
+        turn_has_input,
+    } = input.into_core_input().unwrap();
+    let TurnInput::UserInput { content, client_id } = input else {
+        panic!("expected ordinary user input")
+    };
+    assert_eq!(turn_has_input, !content.is_empty());
+    TurnStartParams {
+        thread_id: submission._original_thread_id,
+        disabled_plugin_ids: settings.disabled_plugin_ids,
+        client_user_message_id: client_id,
+        input: content.into_iter().map(V2UserInput::from).collect(),
+        turn_trigger: submission.turn_trigger,
+        tool_output: None,
+        responsesapi_client_metadata: submission.responsesapi_client_metadata,
+        additional_context: Some(
+            additional_context
+                .into_iter()
+                .map(|(key, entry)| {
+                    (
+                        key,
+                        AdditionalContextEntry {
+                            value: entry.value,
+                            kind: match entry.kind {
+                                CoreAdditionalContextKind::Untrusted => {
+                                    AdditionalContextKind::Untrusted
+                                }
+                                CoreAdditionalContextKind::Application => {
+                                    AdditionalContextKind::Application
+                                }
+                            },
+                        },
+                    )
+                })
+                .collect(),
+        ),
+        environments: environment.environments,
+        cwd: settings.cwd,
+        runtime_workspace_roots: environment.runtime_workspace_roots,
+        approval_policy: settings.approval_policy,
+        approvals_reviewer: settings.approvals_reviewer,
+        sandbox_policy: settings.sandbox_policy,
+        permissions: settings.permissions,
+        model: settings.model,
+        service_tier: settings.service_tier,
+        service_tier_for_turn: submission.service_tier_for_turn,
+        effort: settings.effort,
+        summary: settings.summary,
+        personality: settings.personality,
+        output_schema: submission.output_schema,
+        collaboration_mode: settings.collaboration_mode,
+        multi_agent_mode: submission._ignored_multi_agent_mode,
+        cyber_access_program: submission.cyber_access_program,
+    }
+}
+
+#[test]
+fn original_command_stages_preserve_every_user_variant_selector_and_context_role() {
+    let params = TurnStartParams {
+        thread_id: "actual-route-selector".to_string(),
+        input: input_variants(),
+        client_user_message_id: Some("original-client-message".to_string()),
+        disabled_plugin_ids: Some(vec!["kept-plugin".to_string()]),
+        turn_trigger: Some("composer".to_string()),
+        additional_context: Some(HashMap::from([
+            (
+                "z-untrusted".to_string(),
+                AdditionalContextEntry {
+                    value: "untrusted\nbytes".to_string(),
+                    kind: AdditionalContextKind::Untrusted,
+                },
+            ),
+            (
+                "a-app".to_string(),
+                AdditionalContextEntry {
+                    value: "application bytes".to_string(),
+                    kind: AdditionalContextKind::Application,
+                },
+            ),
+        ])),
+        responsesapi_client_metadata: Some(HashMap::from([(
+            "client-key".to_string(),
+            "client-value".to_string(),
+        )])),
+        cwd: Some(PathBuf::from("not-resolved-here")),
+        environments: Some(vec![TurnEnvironmentParams {
+            environment_id: "original-owner".to_string(),
+            cwd: codex_utils_path_uri::LegacyAppPathString::from_string("/work"),
+            runtime_workspace_roots: Some(vec![
+                codex_utils_path_uri::LegacyAppPathString::from_string("/work"),
+            ]),
+        }]),
+        runtime_workspace_roots: Some(Vec::new()),
+        approval_policy: Some(codex_app_server_protocol::AskForApproval::OnRequest),
+        approvals_reviewer: Some(codex_app_server_protocol::ApprovalsReviewer::User),
+        sandbox_policy: Some(codex_app_server_protocol::SandboxPolicy::ReadOnly {
+            network_access: false,
+        }),
+        permissions: Some("original-profile-selector".to_string()),
+        model: Some("request-data-only-model".to_string()),
+        service_tier: Some(Some("persistent-tier".to_string())),
+        service_tier_for_turn: Some("turn-only-tier".to_string()),
+        effort: Some(ReasoningEffort::Low),
+        summary: Some(ReasoningSummary::Detailed),
+        personality: Some(Personality::None),
+        output_schema: Some(json!({"type":"object","properties":{"answer":{"type":"string"}}})),
+        collaboration_mode: Some(CollaborationMode {
+            mode: ModeKind::Plan,
+            settings: Settings {
+                model: "mode-model".to_string(),
+                reasoning_effort: Some(ReasoningEffort::Low),
+                developer_instructions: None,
+            },
+        }),
+        multi_agent_mode: Some(MultiAgentMode::Custom(
+            "ignored original option".to_string(),
+        )),
+        cyber_access_program: Some(codex_app_server_protocol::CyberAccessProgram::Standard),
+        ..Default::default()
+    };
+    let data = OriginalTurnCommandData::new(params.clone());
+    assert_eq!(data.selectors(), &params);
+    // This producer must retain conflicting selectors too: the unchanged live
+    // permission owner rejects them later, at its original position.
+    assert_eq!(roundtrip(params.clone()), params);
+}
+
+#[test]
+fn original_command_preserves_absent_null_empty_and_start_tier_assembly() {
+    for tier in [None, Some(None), Some(Some("priority".to_string()))] {
+        for plugins in [None, Some(Vec::new()), Some(vec!["kept".to_string()])] {
+            let params = TurnStartParams {
+                service_tier: tier.clone(),
+                disabled_plugin_ids: plugins.clone(),
+                environments: Some(Vec::new()),
+                runtime_workspace_roots: None,
+                service_tier_for_turn: Some("default".to_string()),
+                additional_context: Some(HashMap::new()),
+                responsesapi_client_metadata: Some(HashMap::new()),
+                ..Default::default()
+            };
+            assert_eq!(roundtrip(params.clone()), params);
+        }
+    }
+    let absent: TurnStartParams =
+        serde_json::from_value(json!({"threadId":"raw", "input":[]})).unwrap();
+    let explicit_null: TurnStartParams =
+        serde_json::from_value(json!({"threadId":"raw", "input":[], "serviceTier":null})).unwrap();
+    assert_eq!(
+        (
+            OriginalTurnCommandData::new(absent)
+                .selectors()
+                .service_tier
+                .clone(),
+            OriginalTurnCommandData::new(explicit_null)
+                .selectors()
+                .service_tier
+                .clone()
+        ),
+        (None, Some(None))
+    );
+    let (_, stage) =
+        OriginalTurnCommandData::new(TurnStartParams::default()).into_environment_stage();
+    let converted = stage.into_core_input().unwrap();
+    assert!(converted.additional_context.is_empty());
+    assert!(converted.submission.responsesapi_client_metadata.is_none());
+    let params = TurnStartParams {
+        turn_trigger: Some("composer".to_string()),
+        output_schema: Some(json!({"type":"string"})),
+        service_tier: Some(None),
+        service_tier_for_turn: Some("default".to_string()),
+        cyber_access_program: Some(codex_app_server_protocol::CyberAccessProgram::Standard),
+        responsesapi_client_metadata: Some(HashMap::from([(
+            "kept".to_string(),
+            "value".to_string(),
+        )])),
+        ..Default::default()
+    };
+    let expected = params.clone();
+    let (_, stage) = OriginalTurnCommandData::new(params).into_environment_stage();
+    let ConvertedTurnCommand {
+        input,
+        settings,
+        submission,
+        additional_context,
+        ..
+    } = stage.into_core_input().unwrap();
+    assert_eq!(settings.service_tier, Some(None));
+    let owner_settings = codex_protocol::protocol::ThreadSettingsOverrides {
+        service_tier: Some(None),
+        ..Default::default()
+    };
+    let request = submission.into_request(input, owner_settings.clone(), additional_context);
+    assert_eq!(request.thread_settings, owner_settings);
+    assert_eq!(
+        (
+            request.start.turn_trigger,
+            request.start.final_output_json_schema,
+            request.start.service_tier,
+            request.start.cyber_access_program
+        ),
+        (
+            expected.turn_trigger,
+            expected.output_schema,
+            expected.service_tier_for_turn,
+            expected.cyber_access_program.map(Into::into)
+        )
+    );
+    assert_eq!(
+        request.responsesapi_client_metadata,
+        expected.responsesapi_client_metadata
+    );
+    assert!(request.trace.is_none());
+}
+
+#[test]
+fn original_command_keeps_validation_priority_unicode_count_and_late_output_image_refusal() {
+    let rejected_input = vec![V2UserInput::Image {
+        image: V2ImageReference::Inline {
+            url: "https://example.invalid/no-fetch.png".to_string(),
+        },
+        detail: None,
+    }];
+    assert_eq!(
+        validate_user_input_image_urls(&rejected_input)
+            .unwrap_err()
+            .message,
+        REMOTE_IMAGE_URL_ERROR
+    );
+    let text = V2UserInput::Text {
+        text: "🦀é".to_string(),
+        text_elements: Vec::new(),
+    };
+    let output = codex_app_server_protocol::TurnToolOutput {
+        name: String::new(),
+        namespace: Some("kept".to_string()),
+        output: FunctionCallOutputBody::Text("Qé".to_string()),
+    };
+    let data = OriginalTurnCommandData::new(TurnStartParams {
+        input: vec![text],
+        tool_output: Some(Box::new(output.clone())),
+        ..Default::default()
+    });
+    assert_eq!(
+        data.validate_tool_output().unwrap_err().message,
+        "`toolOutput` cannot be combined with nonempty `input`"
+    );
+    assert_eq!(data.input_text_char_count(), 4);
+    let data = OriginalTurnCommandData::new(TurnStartParams {
+        tool_output: Some(Box::new(output)),
+        ..Default::default()
+    });
+    assert_eq!(
+        data.validate_tool_output().unwrap_err().message,
+        "`toolOutput.name` must not be empty"
+    );
+    let params = TurnStartParams {
+        tool_output: Some(Box::new(codex_app_server_protocol::TurnToolOutput {
+            name: "original-output".to_string(),
+            namespace: None,
+            output: FunctionCallOutputBody::ContentItems(vec![
+                FunctionCallOutputContentItem::InputImage {
+                    image: CoreImageReference::Inline {
+                        image_url: "https://example.invalid/no-fetch.png".to_string(),
+                    },
+                    detail: None,
+                },
+            ]),
+        })),
+        cwd: Some(PathBuf::from("still-unresolved")),
+        ..Default::default()
+    };
+    validate_user_input_image_urls(&params.input).unwrap();
+    let data = OriginalTurnCommandData::new(params);
+    data.validate_tool_output().unwrap();
+    assert_eq!(data.input_text_char_count(), 0);
+    let (_, stage) = data.into_environment_stage();
+    let error = match stage.into_core_input() {
+        Err(error) => error,
+        Ok(_) => panic!("remote output image must refuse before cwd is resolved"),
+    };
+    assert_eq!(error.message, REMOTE_IMAGE_URL_ERROR);
+}
+
+#[test]
+fn original_command_preserves_function_output_content_without_rendering_or_materializing() {
+    let body = FunctionCallOutputBody::ContentItems(vec![
+        FunctionCallOutputContentItem::InputText {
+            text: "Qé".to_string(),
+        },
+        FunctionCallOutputContentItem::InputImage {
+            image: CoreImageReference::File {
+                file_id: "kept-output-file".to_string(),
+            },
+            detail: Some(codex_protocol::models::ImageDetail::Low),
+        },
+        FunctionCallOutputContentItem::InputAudio {
+            audio_url: "data:audio/wav;base64,AA==".to_string(),
+        },
+        FunctionCallOutputContentItem::EncryptedContent {
+            encrypted_content: "opaque-output".to_string(),
+        },
+    ]);
+    let data = OriginalTurnCommandData::new(TurnStartParams {
+        tool_output: Some(Box::new(codex_app_server_protocol::TurnToolOutput {
+            name: "actual-output-name".to_string(),
+            namespace: Some("actual-output-namespace".to_string()),
+            output: body.clone(),
+        })),
+        ..Default::default()
+    });
+    data.validate_tool_output().unwrap();
+    assert_eq!(data.input_text_char_count(), 2);
+    let (_, stage) = data.into_environment_stage();
+    let converted = stage.into_core_input().unwrap();
+    assert!(!converted.turn_has_input);
+    assert_eq!(
+        converted.input,
+        TurnInput::ResponseItem(ResponseItem::FunctionCallOutput {
+            id: None,
+            call_id: None,
+            name: Some("actual-output-name".to_string()),
+            namespace: Some("actual-output-namespace".to_string()),
+            output: FunctionCallOutputPayload {
+                body,
+                success: None
+            },
+            internal_chat_message_metadata_passthrough: None,
+        })
+    );
+}
