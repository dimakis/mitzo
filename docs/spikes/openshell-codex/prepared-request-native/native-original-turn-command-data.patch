+//! Staged ordinary turn/start DATA. No Session, settings publication, command
+//! authorization or preparation eligibility is produced here. Each stage moves
+//! only after the ordinary caller reaches its original validation/effect point.
+use super::*;
+
+pub(super) struct OriginalTurnCommandData {
+    params: TurnStartParams,
+}
+
+pub(super) struct TurnCommandEnvironments {
+    pub(super) runtime_workspace_roots: Option<Vec<AbsolutePathBuf>>,
+    pub(super) environments: Option<Vec<TurnEnvironmentParams>>,
+}
+
+pub(super) struct TurnCommandInputData {
+    input: Vec<V2UserInput>,
+    tool_output: Option<Box<codex_app_server_protocol::TurnToolOutput>>,
+    client_user_message_id: Option<String>,
+    additional_context: Option<HashMap<String, AdditionalContextEntry>>,
+    settings: TurnCommandSettings,
+    submission: TurnCommandSubmission,
+}
+
+pub(super) struct TurnCommandSettings {
+    pub(super) cwd: Option<PathBuf>,
+    pub(super) disabled_plugin_ids: Option<Vec<String>>,
+    pub(super) approval_policy: Option<codex_app_server_protocol::AskForApproval>,
+    pub(super) approvals_reviewer: Option<codex_app_server_protocol::ApprovalsReviewer>,
+    pub(super) sandbox_policy: Option<codex_app_server_protocol::SandboxPolicy>,
+    pub(super) permissions: Option<String>,
+    pub(super) model: Option<String>,
+    pub(super) service_tier: Option<Option<String>>,
+    pub(super) effort: Option<ReasoningEffort>,
+    pub(super) summary: Option<ReasoningSummary>,
+    pub(super) collaboration_mode: Option<CollaborationMode>,
+    pub(super) personality: Option<Personality>,
+}
+
+pub(super) struct TurnCommandSubmission {
+    // The route selector and deprecated option remain DATA through conversion;
+    // neither becomes a model input or a permission/command identity claim.
+    _original_thread_id: String,
+    _ignored_multi_agent_mode: Option<codex_protocol::config_types::MultiAgentMode>,
+    turn_trigger: Option<String>,
+    output_schema: Option<serde_json::Value>,
+    service_tier_for_turn: Option<String>,
+    cyber_access_program: Option<codex_app_server_protocol::CyberAccessProgram>,
+    responsesapi_client_metadata: Option<HashMap<String, String>>,
+}
+
+pub(super) struct ConvertedTurnCommand {
+    pub(super) additional_context: BTreeMap<String, CoreAdditionalContextEntry>,
+    pub(super) turn_has_input: bool,
+    pub(super) input: TurnInput,
+    pub(super) settings: TurnCommandSettings,
+    pub(super) submission: TurnCommandSubmission,
+}
+
+impl OriginalTurnCommandData {
+    pub(super) fn new(params: TurnStartParams) -> Self {
+        Self { params }
+    }
+
+    /// Borrow original selectors; wrapping performs no normalization or reads.
+    pub(super) fn selectors(&self) -> &TurnStartParams {
+        &self.params
+    }
+
+    pub(super) fn validate_tool_output(&self) -> Result<(), JSONRPCErrorError> {
+        if let Some(tool_output) = &self.params.tool_output {
+            if !self.params.input.is_empty() {
+                return Err(invalid_request(
+                    "`toolOutput` cannot be combined with nonempty `input`",
+                ));
+            }
+            if tool_output.name.is_empty() {
+                return Err(invalid_request("`toolOutput.name` must not be empty"));
+            }
+        }
+        Ok(())
+    }
+
+    pub(super) fn input_text_char_count(&self) -> usize {
+        self.params
+            .input
+            .iter()
+            .map(V2UserInput::text_char_count)
+            .sum::<usize>()
+            + self
+                .params
+                .tool_output
+                .as_ref()
+                .map_or(0, |output| match &output.output {
+                    FunctionCallOutputBody::Text(text) => text.chars().count(),
+                    FunctionCallOutputBody::ContentItems(items) => items
+                        .iter()
+                        .map(|item| match item {
+                            FunctionCallOutputContentItem::InputText { text } => {
+                                text.chars().count()
+                            }
+                            _ => 0,
+                        })
+                        .sum(),
+                })
+    }
+
+    /// Called only after the ordinary client-info effect. Fields are moved
+    /// exhaustively; no consumed field is represented as a fabricated default.
+    pub(super) fn into_environment_stage(self) -> (TurnCommandEnvironments, TurnCommandInputData) {
+        let TurnStartParams {
+            thread_id,
+            disabled_plugin_ids,
+            client_user_message_id,
+            input,
+            turn_trigger,
+            tool_output,
+            responsesapi_client_metadata,
+            additional_context,
+            environments,
+            cwd,
+            runtime_workspace_roots,
+            approval_policy,
+            approvals_reviewer,
+            sandbox_policy,
+            permissions,
+            model,
+            service_tier,
+            service_tier_for_turn,
+            effort,
+            summary,
+            personality,
+            output_schema,
+            collaboration_mode,
+            multi_agent_mode,
+            cyber_access_program,
+        } = self.params;
+        (
+            TurnCommandEnvironments {
+                runtime_workspace_roots,
+                environments,
+            },
+            TurnCommandInputData {
+                input,
+                tool_output,
+                client_user_message_id,
+                additional_context,
+                settings: TurnCommandSettings {
+                    cwd,
+                    disabled_plugin_ids,
+                    approval_policy,
+                    approvals_reviewer,
+                    sandbox_policy,
+                    permissions,
+                    model,
+                    service_tier,
+                    effort,
+                    summary,
+                    collaboration_mode,
+                    personality,
+                },
+                submission: TurnCommandSubmission {
+                    _original_thread_id: thread_id,
+                    _ignored_multi_agent_mode: multi_agent_mode,
+                    turn_trigger,
+                    output_schema,
+                    service_tier_for_turn,
+                    cyber_access_program,
+                    responsesapi_client_metadata,
+                },
+            },
+        )
+    }
+}
+
+impl TurnCommandInputData {
+    /// Ordinary context/input conversion stays after environment selection and
+    /// before cwd/permission/settings work. File paths/IDs are not materialized.
+    pub(super) fn into_core_input(self) -> Result<ConvertedTurnCommand, JSONRPCErrorError> {
+        let additional_context = map_additional_context(self.additional_context);
+        let turn_has_input = !self.input.is_empty();
+        let input = if let Some(tool_output) = self.tool_output {
+            let item = ResponseItem::FunctionCallOutput {
+                id: None,
+                call_id: None,
+                name: Some(tool_output.name),
+                namespace: tool_output.namespace,
+                output: FunctionCallOutputPayload {
+                    body: tool_output.output,
+                    success: None,
+                },
+                internal_chat_message_metadata_passthrough: None,
+            };
+            validate_response_item_image_urls(std::slice::from_ref(&item))?;
+            TurnInput::ResponseItem(item)
+        } else {
+            TurnInput::UserInput {
+                content: self.input.into_iter().map(V2UserInput::into_core).collect(),
+                client_id: self.client_user_message_id,
+            }
+        };
+        Ok(ConvertedTurnCommand {
+            additional_context,
+            turn_has_input,
+            input,
+            settings: self.settings,
+            submission: self.submission,
+        })
+    }
+}
+
+impl TurnCommandSubmission {
+    /// Moves exactly these already-normalized DATA fields. Live owner-produced
+    /// settings are supplied at their ordinary point; trace remains caller-owned.
+    pub(super) fn into_request(
+        self,
+        input: TurnInput,
+        thread_settings: codex_protocol::protocol::ThreadSettingsOverrides,
+        additional_context: BTreeMap<String, CoreAdditionalContextEntry>,
+    ) -> TurnInputRequest {
+        let Self {
+            _original_thread_id: _,
+            _ignored_multi_agent_mode: _,
+            turn_trigger,
+            output_schema,
+            service_tier_for_turn,
+            cyber_access_program,
+            responsesapi_client_metadata,
+        } = self;
+        TurnInputRequest::new(input)
+            .with_thread_settings(thread_settings)
+            .on_start(TurnStartOptions {
+                turn_trigger,
+                final_output_json_schema: output_schema,
+                service_tier: service_tier_for_turn,
+                cyber_access_program: cyber_access_program.map(Into::into),
+                ..Default::default()
+            })
+            .with_additional_context(additional_context)
+            .with_responses_metadata(responsesapi_client_metadata)
+    }
+}
+
