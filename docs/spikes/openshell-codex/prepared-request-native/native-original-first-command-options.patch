+//! Original ordinary first-command OPTIONS DATA, split at the real metadata /
+//! reservation / creating-connection effect boundary. No start/admission authority.
+use super::*;
+
+pub(super) struct OriginalFirstCommandOptions {
+    start_options: StartThreadOptions,
+    environments: Vec<TurnEnvironmentSelection>,
+    dynamic_tools: Vec<DynamicToolSpec>,
+    history_mode: Option<ThreadHistoryMode>,
+    thread_extension_init: ExtensionDataInit,
+}
+
+impl OriginalFirstCommandOptions {
+    pub(super) fn prepare(
+        config: Config,
+        thread_manager: &ThreadManager,
+        environment_selections: Option<Vec<TurnEnvironmentSelection>>,
+        dynamic_tools: Option<Vec<DynamicToolSpec>>,
+        history_mode: Option<ThreadHistoryMode>,
+        thread_store: &dyn ThreadStore,
+        selected_capability_roots: Vec<SelectedCapabilityRoot>,
+    ) -> Result<(usize, Self), JSONRPCErrorError> {
+        let environments = environment_selections.unwrap_or_else(|| {
+            thread_manager.default_environment_selections(&config.cwd, &config.workspace_roots)
+        });
+        let dynamic_tools = dynamic_tools.unwrap_or_default();
+        if !dynamic_tools.is_empty() {
+            validate_dynamic_tools(&dynamic_tools).map_err(invalid_request)?;
+        }
+        // Count callable functions rather than top-level namespace containers.
+        let dynamic_tool_count: usize = dynamic_tools
+            .iter()
+            .map(|tool| match tool {
+                DynamicToolSpec::Function(_) => 1,
+                DynamicToolSpec::Namespace(namespace) => namespace.tools.len(),
+            })
+            .sum();
+        let history_mode = history_mode.or_else(|| {
+            (!config.ephemeral && thread_store.supports_paginated_history_lists())
+                .then_some(ThreadHistoryMode::Paginated)
+        });
+        let mut thread_extension_init = ExtensionDataInit::new();
+        if !selected_capability_roots.is_empty() {
+            thread_extension_init.insert(selected_capability_roots);
+        }
+        let start_options = StartThreadOptions::new(config);
+        Ok((
+            dynamic_tool_count,
+            Self {
+                start_options,
+                environments,
+                dynamic_tools,
+                history_mode,
+                thread_extension_init,
+            },
+        ))
+    }
+
+    pub(super) fn is_ephemeral(&self) -> bool {
+        self.start_options.config.ephemeral
+    }
+
+    // Called after the ordinary creating-connection registration. Late fields
+    // retain their original evaluation point, including Startup versus Clear.
+    pub(super) fn finish(
+        self,
+        allow_provider_model_fallback: bool,
+        session_start_source: Option<codex_app_server_protocol::ThreadStartSource>,
+        thread_source: Option<codex_protocol::protocol::ThreadSource>,
+        service_name: Option<String>,
+        request_trace: Option<W3cTraceContext>,
+        client_mcp_extensions: ClientMcpExtensions,
+    ) -> StartThreadOptions {
+        let Self {
+            start_options,
+            environments,
+            dynamic_tools,
+            history_mode,
+            thread_extension_init,
+        } = self;
+        StartThreadOptions {
+            allow_provider_model_fallback,
+            initial_history: match session_start_source
+                .unwrap_or(codex_app_server_protocol::ThreadStartSource::Startup)
+            {
+                codex_app_server_protocol::ThreadStartSource::Startup => InitialHistory::New,
+                codex_app_server_protocol::ThreadStartSource::Clear => InitialHistory::Cleared,
+            },
+            history_mode,
+            thread_source,
+            dynamic_tools,
+            metrics_service_name: service_name,
+            parent_trace: request_trace,
+            environments: Some(environments),
+            thread_extension_init,
+            client_mcp_extensions,
+            ..start_options
+        }
+    }
+}
+
