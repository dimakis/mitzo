+#[tokio::test]
+async fn project_doc_stream_is_dropped_when_loading_is_cancelled() {
+    let tmp = tempfile::tempdir().unwrap();
+    fs::write(tmp.path().join("AGENTS.md"), "fixture").unwrap();
+    let config = make_config(&tmp, 8, None).await;
+    let counts = Arc::new(MetadataCallCounts::default());
+    let filesystem = FailingFileSystem {
+        path: config.cwd.join("AGENTS.md"),
+        failure: InjectedFailure::ReadStream {
+            chunk: b"abcd",
+            chunks: 1,
+            pending_tail: true,
+            error_tail: None,
+        },
+        metadata_calls: Arc::clone(&counts),
+    };
+    let cwd = PathUri::from_abs_path(&config.cwd);
+    {
+        let loading = read_agents_md(&config.config, &filesystem, "local", &cwd, 8, None);
+        tokio::pin!(loading);
+        tokio::select! {
+            result = &mut loading => panic!("instruction stream should wait: {result:?}"),
+            () = counts.stream_pending.notified() => {}
+        }
+        assert_eq!(counts.stream_drops.load(Ordering::SeqCst), 0);
+    }
+    assert_eq!(counts.full_reads.load(Ordering::SeqCst), 0);
+    assert_eq!(counts.stream_drops.load(Ordering::SeqCst), 1);
+}
