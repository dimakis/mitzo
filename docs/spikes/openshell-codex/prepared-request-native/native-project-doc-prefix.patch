+#[tokio::test]
+async fn project_doc_stream_skips_tail_errors_only_after_detecting_a_sufficient_prefix() {
+    for (limit, succeeds, polls) in [(3, true, 1), (4, false, 2), (5, false, 2)] {
+        let tmp = tempfile::tempdir().unwrap();
+        fs::write(tmp.path().join("AGENTS.md"), "fixture").unwrap();
+        let config = make_config(&tmp, limit, None).await;
+        let counts = Arc::new(MetadataCallCounts::default());
+        let filesystem = FailingFileSystem {
+            path: config.cwd.join("AGENTS.md"),
+            failure: InjectedFailure::ReadStream {
+                chunk: b"abcd",
+                chunks: 1,
+                pending_tail: false,
+                error_tail: Some(io::ErrorKind::PermissionDenied),
+            },
+            metadata_calls: Arc::clone(&counts),
+        };
+        let result = read_agents_md(
+            &config.config,
+            &filesystem,
+            "local",
+            &PathUri::from_abs_path(&config.cwd),
+            limit,
+            None,
+        )
+        .await;
+        if succeeds {
+            assert_eq!(result.unwrap().unwrap().text(), "abc");
+        } else {
+            assert_eq!(result.unwrap_err().kind(), io::ErrorKind::PermissionDenied);
+        }
+        assert_eq!(counts.full_reads.load(Ordering::SeqCst), 0);
+        assert_eq!(counts.stream_polls.load(Ordering::SeqCst), polls);
+        assert_eq!(counts.stream_drops.load(Ordering::SeqCst), 1);
+    }
+}
