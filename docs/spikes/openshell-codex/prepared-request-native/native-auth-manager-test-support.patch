+/// Cross-crate test observation of the original client's retained auth owner.
+/// This compares Arc allocation identity only; it exposes no credentials and
+/// does not establish current authorization or dispatch permission.
+pub fn model_client_uses_auth_manager(
+    client: &crate::ModelClient,
+    expected: &Arc<AuthManager>,
+) -> bool {
+    client
+        .auth_manager()
+        .is_some_and(|actual| Arc::ptr_eq(&actual, expected))
+}
+
 pub fn auth_manager_from_auth(auth: CodexAuth) -> Arc<AuthManager> {
     AuthManager::from_auth_for_testing(auth)
 }
