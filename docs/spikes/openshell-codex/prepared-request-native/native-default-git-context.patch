diff --git a/codex-rs/ext/extension-api/src/registry/prompt_sources.rs b/codex-rs/ext/extension-api/src/registry/prompt_sources.rs
new file mode 100644
index 0000000..8a31ba8
--- /dev/null
+++ b/codex-rs/ext/extension-api/src/registry/prompt_sources.rs
@@ -0,0 +1,92 @@
+use std::any::Any;
+use std::sync::Arc;
+
+use super::ContextSourceRegistrationError;
+use super::ExtensionRegistry;
+use super::ExtensionRegistryBuilder;
+use crate::ContextContributor;
+
+#[derive(Clone)]
+pub(super) struct PromptContextSource {
+    source: Arc<dyn Any + Send + Sync>,
+    context_index: usize,
+}
+
+/// Provenance for one original prompt-only contributor. This does not settle
+/// its context data, other partitions, source currency or admission authority.
+pub struct RegisteredPromptContextSource<T> {
+    source: Arc<T>,
+    registry_identity: Arc<()>,
+    context_index: usize,
+}
+
+impl<C: Sync> ExtensionRegistryBuilder<C> {
+    /// Registers the same original prompt allocation while retaining typed
+    /// metadata. It adds no turn-input/tool contributor or absence declaration.
+    pub fn prompt_context_source<T>(&mut self, source: Arc<T>)
+    where
+        T: ContextContributor + 'static,
+    {
+        let registration = PromptContextSource {
+            source: source.clone(),
+            context_index: self.registry.context_contributors.len(),
+        };
+        self.prompt_contributor(source);
+        self.registry.prompt_context_sources.push(registration);
+    }
+}
+
+impl<C: Sync> ExtensionRegistry<C> {
+    /// Finds only actual typed prompt registrations. Unknown/legacy sources
+    /// are not enrolled, and an empty result proves no context absence.
+    pub fn registered_prompt_context_sources<T>(&self) -> Vec<RegisteredPromptContextSource<T>>
+    where
+        T: ContextContributor + 'static,
+    {
+        self.prompt_context_sources
+            .iter()
+            .filter_map(|registration| {
+                Arc::clone(&registration.source)
+                    .downcast::<T>()
+                    .ok()
+                    .map(|source| RegisteredPromptContextSource {
+                        source,
+                        registry_identity: Arc::clone(&self.tool_inventory_identity),
+                        context_index: registration.context_index,
+                    })
+            })
+            .collect()
+    }
+
+    /// Lends the actual registry-owned source after checking registry identity,
+    /// original prompt index, concrete type and original allocation pointer.
+    pub fn borrow_prompt_context_source<T>(
+        &self,
+        registration: &RegisteredPromptContextSource<T>,
+    ) -> Result<&T, ContextSourceRegistrationError>
+    where
+        T: ContextContributor + 'static,
+    {
+        if !Arc::ptr_eq(
+            &self.tool_inventory_identity,
+            &registration.registry_identity,
+        ) {
+            return Err(ContextSourceRegistrationError::RegistryChanged);
+        }
+        let pointer = Arc::as_ptr(&registration.source).cast::<()>();
+        if self
+            .context_contributors
+            .get(registration.context_index)
+            .map(|source| Arc::as_ptr(source).cast::<()>())
+            != Some(pointer)
+        {
+            return Err(ContextSourceRegistrationError::ContributorsChanged);
+        }
+        self.prompt_context_sources
+            .iter()
+            .find(|source| source.context_index == registration.context_index)
+            .and_then(|source| source.source.as_ref().downcast_ref::<T>())
+            .filter(|source| std::ptr::eq(*source, registration.source.as_ref()))
+            .ok_or(ContextSourceRegistrationError::ContributorsChanged)
+    }
+}
