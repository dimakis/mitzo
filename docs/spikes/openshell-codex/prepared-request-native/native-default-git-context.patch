@@ -0,0 +1,87 @@
+use codex_extension_api::ContextSourceRegistrationError;
+use codex_extension_api::ExtensionRegistry;
+use codex_extension_api::PreviousWorldStateSection;
+use codex_extension_api::RegisteredPromptContextSource;
+use codex_extension_api::RenderedWorldStateFragment;
+use codex_login::auth::CapturedApiKeyCredentials;
+
+use super::GitAttributionExtension;
+use crate::world_state::render_git_attribution_fragment;
+
+/// Original registered prompt owner, not a context/currency/eligibility grant.
+pub struct RegisteredGitAttributionSource {
+    registration: RegisteredPromptContextSource<GitAttributionExtension>,
+}
+
+/// Plain initial context from the original API-key branch. The same opaque
+/// original credentials must be retained for count and guarded association.
+pub struct GitAttributionInitialObservation<'a> {
+    source: &'a GitAttributionExtension,
+    credentials: &'a CapturedApiKeyCredentials,
+    fragment: Option<RenderedWorldStateFragment>,
+}
+
+#[derive(Debug, PartialEq, Eq)]
+pub enum GitAttributionObservationError {
+    Registration(ContextSourceRegistrationError),
+    UnresolvedAuth,
+}
+
+pub fn registered_git_attribution_sources<C: Sync>(
+    registry: &ExtensionRegistry<C>,
+) -> Vec<RegisteredGitAttributionSource> {
+    registry
+        .registered_prompt_context_sources::<GitAttributionExtension>()
+        .into_iter()
+        .map(|registration| RegisteredGitAttributionSource { registration })
+        .collect()
+}
+
+impl RegisteredGitAttributionSource {
+    /// Ordinary policy resolution returns disabled for an API key, without a
+    /// backend settings request. Require actual cached credentials from this
+    /// EXACT registered owner's AuthManager; unsupported families stay unknown.
+    /// No auth refresh/reload, policy request, Session/cache or lifecycle runs.
+    pub fn observe_api_key_initial_context<'a, C: Sync>(
+        &self,
+        registry: &'a ExtensionRegistry<C>,
+        credentials: &'a CapturedApiKeyCredentials,
+    ) -> Result<GitAttributionInitialObservation<'a>, GitAttributionObservationError> {
+        let source = registry
+            .borrow_prompt_context_source(&self.registration)
+            .map_err(GitAttributionObservationError::Registration)?;
+        let fragment = source
+            .auth_manager
+            .with_current_api_key_credentials(credentials, |_, _| {
+                render_git_attribution_fragment(
+                    /*enabled*/ false,
+                    PreviousWorldStateSection::Absent,
+                )
+            })
+            .ok_or(GitAttributionObservationError::UnresolvedAuth)?;
+        Ok(GitAttributionInitialObservation {
+            source,
+            credentials,
+            fragment,
+        })
+    }
+}
+
+impl GitAttributionInitialObservation<'_> {
+    pub fn initial_fragment(&self) -> Option<&RenderedWorldStateFragment> {
+        self.fragment.as_ref()
+    }
+
+    /// Only this original cached credential publisher is fenced. The final
+    /// actual synchronous action must also hold every other required owner.
+    /// Async work returned by the action is outside this guard.
+    pub fn with_current_api_key_source<R>(
+        &self,
+        action: impl FnOnce() -> R,
+    ) -> Result<R, GitAttributionObservationError> {
+        self.source
+            .auth_manager
+            .with_current_api_key_credentials(self.credentials, |_, _| action())
+            .ok_or(GitAttributionObservationError::UnresolvedAuth)
+    }
+}
