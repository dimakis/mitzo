 struct AllContributors;
 
+#[test]
+fn prompt_source_lending_preserves_original_owner_without_enrolling_legacy_or_new_partitions() {
+    let legacy = Arc::new(AllContributors);
+    let original = Arc::new(AllContributors);
+    let mut builder = ExtensionRegistryBuilder::<()>::new();
+    builder.prompt_contributor(legacy);
+    builder.prompt_context_source(Arc::clone(&original));
+    let registry = builder.build();
+    let borrowed = {
+        let registered = registry.registered_prompt_context_sources::<AllContributors>();
+        assert_eq!(registered.len(), 1);
+        registry
+            .borrow_prompt_context_source(&registered[0])
+            .unwrap()
+    };
+    assert!(std::ptr::eq(borrowed, original.as_ref()));
+    assert!(
+        registry
+            .registered_context_sources::<AllContributors>()
+            .is_empty()
+    );
+    let sources = registry.registered_prompt_context_sources::<AllContributors>();
+    let copied = registry.to_builder().build();
+    assert_eq!(
+        copied.borrow_prompt_context_source(&sources[0]).err(),
+        Some(codex_extension_api::ContextSourceRegistrationError::RegistryChanged)
+    );
+    let copied_sources = copied.registered_prompt_context_sources::<AllContributors>();
+    assert!(std::ptr::eq(
+        copied
+            .borrow_prompt_context_source(&copied_sources[0])
+            .unwrap(),
+        original.as_ref()
+    ));
+}
