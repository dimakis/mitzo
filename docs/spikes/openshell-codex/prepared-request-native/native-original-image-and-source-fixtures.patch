+#[test]
+fn frozen_preserves_original_image_detail_in_create_count_and_restoration() {
+    let mut request = body();
+    request["input"][0]["content"][1]["detail"] = json!("original");
+    let frozen = FrozenResponsesRequest::new(request.clone(), 16).unwrap();
+    assert_eq!(frozen.body(), &request);
+    assert_eq!(frozen.count_body()["input"], request["input"]);
+    let restored = FrozenResponsesRequest::from_encoded(frozen.encoded_body(), 16).unwrap();
+    assert_eq!(restored.body(), frozen.body());
+    assert_eq!(restored.count_body(), frozen.count_body());
+    assert_eq!(restored.encoded_body(), frozen.encoded_body());
+
+    for detail in [json!("future_detail"), json!(null), json!(42)] {
+        request["input"][0]["content"][1]["detail"] = detail;
+        assert!(FrozenResponsesRequest::new(request.clone(), 16).is_err());
+        assert!(
+            FrozenResponsesRequest::from_encoded(&serde_json::to_vec(&request).unwrap(), 16)
+                .is_err()
+        );
+    }
+}
