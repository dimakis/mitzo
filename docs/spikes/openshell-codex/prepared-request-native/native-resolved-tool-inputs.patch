+#[tokio::test]
+async fn ordinary_tool_builder_recaptures_roles_and_preserves_contributor_registration_order() {
+    let (mut session, mut turn) = make_session_and_context().await;
+    turn.multi_agent_version = MultiAgentVersion::V2;
+    let home = tempfile::tempdir().unwrap();
+    let path = home.path().join("role.toml");
+    std::fs::write(&path, "model = \"first-wrapper-model\"\n").unwrap();
+    Arc::make_mut(&mut turn.config).agent_roles.insert(
+        "ordered".into(),
+        crate::config::AgentRoleConfig {
+            description: Some("Ordered role.".into()),
+            config_file: Some(path.clone()),
+            nickname_candidates: None,
+        },
+    );
+    let trace = Arc::new(Mutex::new(Vec::new()));
+    let mut extensions = codex_extension_api::ExtensionRegistryBuilder::new();
+    extensions.tool_contributor(Arc::new(OrderedPlanningContributor {
+        event: "first_contributor",
+        trace: Arc::clone(&trace),
+        role_path: Some(path),
+        return_tool: true,
+    }));
+    extensions.tool_contributor(Arc::new(OrderedPlanningContributor {
+        event: "second_contributor",
+        trace: Arc::clone(&trace),
+        role_path: None,
+        return_tool: false,
+    }));
+    session.services.extensions = Arc::new(extensions.build());
+    let mcp = Arc::new(codex_mcp::McpBinding::empty(mcp_config_for_test(
+        &turn.config,
+    )));
+    for expected in ["first-wrapper-model", "next-wrapper-model"] {
+        trace.lock().unwrap().clear();
+        let router = super::build_tool_router(
+            &session,
+            &turn,
+            turn.model_info(),
+            &turn.initial_environments,
+            &mcp,
+            false,
+            &turn.extension_data,
+            None,
+        )
+        .unwrap();
+        let body = serde_json::to_string(router.model_visible_specs().as_ref()).unwrap();
+        assert!(body.contains(expected));
+        let events = trace.lock().unwrap();
+        let first = events
+            .iter()
+            .position(|event| *event == "first_contributor")
+            .unwrap();
+        let registration = events
+            .iter()
+            .position(|event| *event == "first_registration")
+            .unwrap();
+        let second = events
+            .iter()
+            .position(|event| *event == "second_contributor")
+            .unwrap();
+        assert!(first < registration && registration < second, "{events:?}");
+    }
+}
