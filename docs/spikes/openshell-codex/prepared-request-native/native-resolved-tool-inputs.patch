+
+impl codex_extension_api::ToolContributor for OrderedPlanningContributor {
+    fn tools(
+        &self,
+        _session_store: &codex_extension_api::ExtensionData,
+        _thread_store: &codex_extension_api::ExtensionData,
+    ) -> Vec<Arc<dyn for<'call> ToolExecutor<ExtensionToolCall<'call>>>> {
+        self.trace.lock().unwrap().push(self.event);
+        if let Some(path) = &self.role_path {
+            std::fs::write(path, "model = \"next-wrapper-model\"\n").unwrap();
+        }
+        if self.return_tool {
