@@ -0,0 +1,197 @@
+use super::super::ModelClient;
+use codex_http_client::HttpClientFactory;
+use codex_http_client::OutboundProxyPolicy;
+use codex_login::AuthManager;
+use codex_login::CodexAuth;
+use codex_login::auth::AgentIdentityAuthPolicy;
+use codex_model_provider_info::ModelProviderInfo;
+use codex_protocol::ThreadId;
+use codex_protocol::protocol::SessionSource;
+use codex_state::NewPreparedRequest;
+use codex_state::PreparedRequestAttemptState;
+use codex_state::PreparedRequestBinding;
+use codex_state::PreparedRequestEffectState;
+use codex_state::PreparedRequestMeasurement;
+use codex_state::PreparedRequestScope;
+use codex_state::StateRuntime;
+use codex_utils_absolute_path::test_support::PathExt;
+use pretty_assertions::assert_eq;
+use std::sync::Arc;
+
+fn client(auth: Arc<AuthManager>) -> ModelClient {
+    ModelClient::new(
+        Some(auth),
+        AgentIdentityAuthPolicy::JwtOnly,
+        ThreadId::new(),
+        ModelProviderInfo::create_openai_provider(/*base_url*/ None),
+        SessionSource::Exec,
+        "offline-guarded-claim".into(),
+        /*model_verbosity*/ None,
+        /*content_item_kinds_enabled*/ true,
+        /*reasoning_effort_override_enabled*/ false,
+        /*enable_request_compression*/ false,
+        /*include_timing_metrics*/ false,
+        /*beta_features_header*/ None,
+        /*concurrent_reasoning_summaries_enabled*/ false,
+        /*attestation_provider*/ None,
+        HttpClientFactory::new(OutboundProxyPolicy::ReqwestDefault),
+        codex_model_provider::WorkspaceRoutingContext::new(
+            "https://chatgpt.com/backend-api".into(),
+        ),
+        Vec::new(),
+    )
+}
+
+async fn measured(
+    runtime: &StateRuntime,
+    operation: &str,
+) -> anyhow::Result<codex_state::PreparedRequestRecord> {
+    let request = NewPreparedRequest {
+        scope: PreparedRequestScope::Command,
+        binding: PreparedRequestBinding {
+            application_scope_id: "synthetic-session".into(),
+            account_id: "synthetic-account".into(),
+            route_revision: "route".into(),
+            source_revision: "source".into(),
+            settings_revision: "settings".into(),
+            history_revision: "history".into(),
+            tools_revision: "tools".into(),
+            runtime_revision: "runtime".into(),
+            command_id: Some(operation.into()),
+            sampling: None,
+        },
+        request_identity: "a".repeat(/*n*/ 64),
+        model: "synthetic-model".into(),
+        encoded_body: br#"{"model":"synthetic-model","input":"offline","max_output_tokens":10}"#
+            .to_vec(),
+        max_output_tokens: 10,
+    };
+    let prepared = runtime.prepare_request(operation, &request).await?;
+    runtime
+        .measure_prepared_request(
+            &prepared.preparation_id,
+            &request,
+            &PreparedRequestMeasurement {
+                witness_id: "witness".into(),
+                request_identity: request.request_identity.clone(),
+                input_tokens: 90,
+                effective_context_ceiling: 100,
+                max_output_tokens: 10,
+                counter_revision: "synthetic-counter".into(),
+                limit_revision: "synthetic-limits".into(),
+            },
+        )
+        .await?;
+    Ok(runtime.read_prepared_request(operation).await?.unwrap())
+}
+
+#[tokio::test]
+async fn ordinary_credential_owner_guards_real_pending_cas_and_logout_refuses() -> anyhow::Result<()>
+{
+    let home = tempfile::TempDir::new()?;
+    let runtime = StateRuntime::init(
+        codex_state::SqliteConfig::new_for_testing(home.path().abs()),
+        "fixture".into(),
+    )
+    .await?;
+    let auth_home = tempfile::TempDir::new()?;
+    let auth = AuthManager::from_auth_for_testing_with_home(
+        CodexAuth::from_api_key("offline-guard-fixture"),
+        auth_home.path().to_path_buf(),
+    );
+    let credentials = auth.capture_cached_api_key_credentials().unwrap();
+    let client = client(Arc::clone(&auth));
+    let prepared = measured(&runtime, "valid").await?;
+    let foreign =
+        AuthManager::from_auth_for_testing(CodexAuth::from_api_key("offline-guard-fixture"));
+    assert!(
+        client
+            .claim_pending_with_ordinary_api_credentials(
+                &runtime,
+                &prepared.preparation_id,
+                &prepared.request,
+                "witness",
+                &foreign.capture_cached_api_key_credentials().unwrap()
+            )
+            .await
+            .is_err()
+    );
+    assert_eq!(
+        runtime.read_prepared_request("valid").await?,
+        Some(prepared.clone())
+    );
+    let pending = client
+        .claim_pending_with_ordinary_api_credentials(
+            &runtime,
+            &prepared.preparation_id,
+            &prepared.request,
+            "witness",
+            &credentials,
+        )
+        .await?;
+    let mut expected = prepared.clone();
+    expected.consumed = true;
+    expected.attempt_state = PreparedRequestAttemptState::Committed;
+    expected.effect_state = PreparedRequestEffectState::Pending;
+    assert_eq!(pending.record(), &expected);
+    drop(pending);
+    let stale = measured(&runtime, "logout").await?;
+    auth.logout().await?;
+    assert!(
+        client
+            .claim_pending_with_ordinary_api_credentials(
+                &runtime,
+                &stale.preparation_id,
+                &stale.request,
+                "witness",
+                &credentials
+            )
+            .await
+            .is_err()
+    );
+    assert_eq!(runtime.read_prepared_request("logout").await?, Some(stale));
+    Ok(())
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn ordinary_logout_races_actual_guarded_claim_without_future_escape() -> anyhow::Result<()> {
+    for iteration in 0..4 {
+        let home = tempfile::TempDir::new()?;
+        let runtime = StateRuntime::init(
+            codex_state::SqliteConfig::new_for_testing(home.path().abs()),
+            "fixture".into(),
+        )
+        .await?;
+        let auth_home = tempfile::TempDir::new()?;
+        let auth = AuthManager::from_auth_for_testing_with_home(
+            CodexAuth::from_api_key("offline-race-fixture"),
+            auth_home.path().to_path_buf(),
+        );
+        let credentials = auth.capture_cached_api_key_credentials().unwrap();
+        let client = client(Arc::clone(&auth));
+        let operation = format!("race-{iteration}");
+        let prepared = measured(&runtime, &operation).await?;
+        let logout_owner = Arc::clone(&auth);
+        let logout = tokio::spawn(async move { logout_owner.logout().await });
+        let claim = client
+            .claim_pending_with_ordinary_api_credentials(
+                &runtime,
+                &prepared.preparation_id,
+                &prepared.request,
+                "witness",
+                &credentials,
+            )
+            .await;
+        logout.await??;
+        let retained = runtime.read_prepared_request(&operation).await?.unwrap();
+        if let Ok(pending) = claim {
+            assert_eq!(pending.record(), &retained);
+            assert!(retained.consumed);
+            assert_eq!(retained.effect_state, PreparedRequestEffectState::Pending);
+        } else {
+            assert_eq!(retained, prepared);
+        }
+        assert!(auth.capture_cached_api_key_credentials().is_none());
+    }
+    Ok(())
+}
