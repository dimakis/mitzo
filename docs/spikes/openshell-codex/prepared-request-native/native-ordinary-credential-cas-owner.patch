+//! Actual ordinary credential owner around the synchronous StateRuntime CAS.
+//!
+//! This closes only the cached credential partition. It does not attest request
+//! construction, all native sources/epochs, model limits, canonical host proof,
+//! production RPC/admission, or authorize releasing the pending effect gate.
+
+impl super::ModelClient {
+    #[cfg_attr(
+        not(test),
+        allow(dead_code, reason = "Prepared admission is not installed.")
+    )]
+    pub(crate) async fn claim_pending_with_ordinary_api_credentials(
+        &self,
+        runtime: &codex_state::StateRuntime,
+        preparation_id: &str,
+        request: &codex_state::NewPreparedRequest,
+        witness_id: &str,
+        credentials: &codex_login::auth::CapturedApiKeyCredentials,
+    ) -> anyhow::Result<codex_state::PendingPreparedRequestAttempt> {
+        // Resolve provider callbacks before all DB waits and before taking auth
+        // locks. ModelClient's constructor fixes this configured provider/manager
+        // identity; the actual manager checks generation/ABA inside the closure.
+        let manager = self.public_api_credential_owner()?;
+        runtime
+            .claim_pending_prepared_request_with_guard(
+                preparation_id,
+                request,
+                witness_id,
+                |commit| {
+                    manager
+                        .with_current_api_key_credentials(credentials, |_, _| commit.commit())
+                        .ok_or_else(|| {
+                            anyhow::anyhow!("ordinary cached credential ownership changed")
+                        })?
+                },
+            )
+            .await
+    }
+}
+
+#[cfg(test)]
+#[path = "client_prepared_api_claim_tests.rs"]
+mod tests;
diff --git a/codex-rs/core/src/client_prepared_api_claim_tests.rs b/codex-rs/core/src/client_prepared_api_claim_tests.rs
new file mode 100644
index 0000000..5180a3e
