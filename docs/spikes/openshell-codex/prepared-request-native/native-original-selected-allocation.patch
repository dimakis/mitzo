+use std::sync::atomic::AtomicUsize;
+
+async fn fixture() -> (tempfile::TempDir, Config, ThreadManager) {
+    let home = tempfile::tempdir().unwrap();
+    let config = ConfigBuilder::default()
+        .codex_home(home.path().to_path_buf())
+        .loader_overrides(LoaderOverrides::with_managed_config_path_for_tests(
+            home.path().join("managed.toml"),
+        ))
+        .fallback_cwd(Some(home.path().to_path_buf()))
+        .build()
+        .await
+        .unwrap();
+    let manager = ThreadManager::with_models_provider_and_home_for_tests(
+        CodexAuth::from_api_key("synthetic-native-allocation"),
+        config.model_provider.clone(),
+        home.path().to_path_buf(),
+        Arc::new(EnvironmentManager::default_for_tests()),
+    );
+    (home, config, manager)
+}
+
+#[tokio::test]
+async fn same_original_allocation_and_controller_are_adopted_once_without_starting() {
+    let (_home, config, manager) = fixture().await;
+    let allocations = Arc::new(AtomicUsize::new(0));
+    let controller_calls = Arc::new(AtomicUsize::new(0));
+    let ids = Arc::clone(&allocations);
+    let calls = Arc::clone(&controller_calls);
+    let manager = manager
+        .with_thread_id_generator(move || {
+            ThreadId::from_u128(
+                /*value*/
+                0x018f_0000_0000_7000_8000_0000_0000_0000
+                    + ids.fetch_add(1, Ordering::SeqCst) as u128,
+            )
+        })
+        .with_agent_control_factory(move |_| {
+            calls.fetch_add(1, Ordering::SeqCst);
+            async {
+                Err(CodexErr::InvalidRequest(
+                    "controller factory must not run during allocation".to_string(),
+                ))
+            }
+        });
+    let mut events = manager.state.thread_created_tx.subscribe();
+    let mut selected = manager
+        .prepare_selected_start(StartThreadOptions::new(config))
+        .await
+        .unwrap();
+    let original_id = selected.allocation.as_ref().unwrap().thread_id();
+    assert!(
+        selected
+            .start_options()
+            .unwrap()
+            .reserved_thread_id
+            .is_none()
+    );
+    assert_eq!(allocations.load(Ordering::SeqCst), 1);
+    let adoption = manager.adopt_selected_start(&mut selected).unwrap();
+    assert_eq!(adoption.options.reserved_thread_id, Some(original_id));
+    let control = adoption.allocation.into_control();
+    // Exercise the very original resolver ordinary Session uses at adoption,
+    // with the consumed SAME controller and original selected options.
+    assert_eq!(
+        original_thread_id(
+            &adoption.options.initial_history,
+            adoption.options.reserved_thread_id,
+            &AgentControlInit::Local(control)
+        )
+        .unwrap(),
+        original_id
+    );
+    assert_eq!(allocations.load(Ordering::SeqCst), 1);
+    assert_eq!(controller_calls.load(Ordering::SeqCst), 0);
+    assert!(manager.adopt_selected_start(&mut selected).is_err());
+    assert!(manager.list_thread_ids().await.is_empty());
+    assert!(matches!(
+        events.try_recv(),
+        Err(tokio::sync::broadcast::error::TryRecvError::Empty)
+    ));
+}
