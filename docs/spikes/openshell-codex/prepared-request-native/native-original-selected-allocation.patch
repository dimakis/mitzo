+        .await
+        .unwrap();
+    let original_id = selected.allocation.as_ref().unwrap().thread_id();
+    assert!(foreign.adopt_selected_start(&mut selected).is_err());
+    let adoption = manager.adopt_selected_start(&mut selected).unwrap();
+    assert_eq!(adoption.options.reserved_thread_id, Some(original_id));
+    assert_eq!(allocations.load(Ordering::SeqCst), 1);
+    std::fs::create_dir_all(home.path().join("rules")).unwrap();
+    let invalid = "prefix_rule(not valid";
+    std::fs::write(home.path().join("rules/default.rules"), invalid).unwrap();
+    assert!(
+        manager
+            .prepare_selected_start(StartThreadOptions::new(config))
+            .await
+            .is_err()
+    );
+    assert_eq!(allocations.load(Ordering::SeqCst), 1);
+    assert_eq!(
+        std::fs::read_to_string(home.path().join("rules/default.rules")).unwrap(),
+        invalid
+    );
+    assert!(manager.list_thread_ids().await.is_empty());
+    assert!(foreign.list_thread_ids().await.is_empty());
+}
