@@ -0,0 +1,37 @@
+//! Private allocation retained by selected-start custody. Identity is allocated
+//! by the SAME original controller/runtime policy ordinary Session startup uses.
+//! This is NOT a ModelClient allocation, source lease, thread, count or permit.
+use super::*;
+use crate::session::native_allocation::original_thread_id;
+
+pub(super) struct SelectedStartNativeAllocation {
+    thread_id: ThreadId,
+    control: LocalAgentControl,
+}
+impl SelectedStartNativeAllocation {
+    pub(super) fn allocate(
+        manager: &ThreadManager,
+        options: &StartThreadOptions,
+    ) -> io::Result<Self> {
+        // prepare_selected_start has already required genuine fresh options and
+        // loaded the strict original policy. No new controller factory is run.
+        let control = manager.agent_control_for_config(&options.config);
+        let thread_id = original_thread_id(
+            &options.initial_history,
+            options.reserved_thread_id,
+            &AgentControlInit::Local(control.clone()),
+        )
+        .map_err(io::Error::other)?;
+        Ok(Self { thread_id, control })
+    }
+    pub(super) fn thread_id(&self) -> ThreadId {
+        self.thread_id
+    }
+    pub(super) fn into_control(self) -> LocalAgentControl {
+        self.control
+    }
+}
