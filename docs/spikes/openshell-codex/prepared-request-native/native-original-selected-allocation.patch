@@ -0,0 +1,106 @@
+//! Required original Session ModelClient construction inputs, not authority.
+//! Ordinary startup supplies these AFTER original lifecycle/metadata/history
+//! acquisition. None are inferred from a fresh label or substituted with empty
+//! ExtensionData. Provider construction is NOT universally pre-session pure:
+//! configured gateway OAuth can eagerly create shared auth/HTTP state.
+//! No selected-start client constructor is available until those owners supply
+//! genuine inputs; identity allocation alone cannot satisfy this boundary.
+use super::session::Session;
+use super::session::SessionConfiguration;
+use crate::attestation::AttestationProvider;
+use crate::client::ModelClient;
+use crate::config::Config;
+use crate::state::ExecutedToolCalls;
+use async_channel::Sender;
+use codex_extension_api::ExtensionRegistry;
+use codex_features::Feature;
+use codex_history::InitialHistory;
+use codex_login::AuthManager;
+use codex_login::auth::AgentIdentityAuthPolicy;
+use codex_model_provider::WorkspaceRoutingContext;
+use codex_protocol::ThreadId;
+use codex_protocol::protocol::Event;
+use std::sync::Arc;
+
+/// Required data from original owners. Visible only to the Session composition
+/// owner, not a caller-provided pre-session success/absence interface. The same
+/// workspace routing Arc, history recorder and thread metadata must be retained
+/// by any future source-owned pre-session allocation/adoption implementation.
+pub(super) struct OriginalSessionModelClientInputs<'a> {
+    pub(super) config: &'a Config,
+    pub(super) session_configuration: &'a SessionConfiguration,
+    pub(super) auth_manager: &'a Arc<AuthManager>,
+    pub(super) thread_id: ThreadId,
+    pub(super) initial_history: &'a InitialHistory,
+    pub(super) reasoning_effort_override_enabled: bool,
+    pub(super) attestation_provider: Option<Arc<dyn AttestationProvider>>,
+    pub(super) workspace_routing: &'a Arc<WorkspaceRoutingContext>,
+    pub(super) extensions: &'a ExtensionRegistry<Config>,
+    pub(super) executed_tool_calls: &'a ExecutedToolCalls,
+    pub(super) fork_cache_key: Option<String>,
+    pub(super) tx_event: &'a Sender<Event>,
+    pub(super) codex_responses_headers: Option<Arc<crate::CodexResponsesHeaders>>,
+}
+impl OriginalSessionModelClientInputs<'_> {
+    pub(super) fn construct(self) -> ModelClient {
+        let Self {
+            config,
+            session_configuration,
+            auth_manager,
+            thread_id,
+            initial_history,
+            reasoning_effort_override_enabled,
+            attestation_provider,
+            workspace_routing,
+            extensions,
+            executed_tool_calls,
+            fork_cache_key,
+            tx_event,
+            codex_responses_headers,
+        } = self;
+        ModelClient::new(
+            Some(Arc::clone(auth_manager)),
+            if config.features.enabled(Feature::UseAgentIdentity) {
+                AgentIdentityAuthPolicy::ChatGptAuth
+            } else {
+                AgentIdentityAuthPolicy::JwtOnly
+            },
+            thread_id,
+            session_configuration.provider.info().clone(),
+            session_configuration.session_source.clone(),
+            session_configuration.originator.clone(),
+            config.model_verbosity,
+            config.features.enabled(Feature::ContentItemKinds),
+            reasoning_effort_override_enabled,
+            config.features.enabled(Feature::EnableRequestCompression),
+            config.features.enabled(Feature::RuntimeMetrics),
+            Session::build_model_client_beta_features_header(config),
+            /*concurrent_reasoning_summaries_enabled*/
+            config
+                .features
+                .enabled(Feature::ConcurrentReasoningSummaries),
+            attestation_provider,
+            config.http_client_factory(),
+            workspace_routing.as_ref().clone(),
+            extensions.model_request_contributors().to_vec(),
+        )
+        .with_executed_tool_calls(executed_tool_calls.clone())
+        .with_restored_history(matches!(
+            initial_history,
+            InitialHistory::Resumed(_) | InitialHistory::Forked(_)
+        ))
+        .with_session_context(
+            crate::guardian::prompt_cache_key_override_for_review_session(
+                &session_configuration.session_source,
+                session_configuration.parent_thread_id,
+            )
+            .or(fork_cache_key),
+            tx_event.clone(),
+            codex_responses_headers,
+        )
+    }
+}
