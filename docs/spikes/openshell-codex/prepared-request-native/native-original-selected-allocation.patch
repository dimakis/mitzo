@@ -0,0 +1,27 @@
+//! ORIGINAL native identity selection. No Session/controller binding, thread
+//! registration, history mutation, transport, lifecycle or provider setup occurs.
+use crate::agent::control::AgentControlInit;
+use codex_history::InitialHistory;
+use codex_protocol::ThreadId;
+
+pub(crate) fn original_thread_id(
+    initial_history: &InitialHistory,
+    reserved_thread_id: Option<ThreadId>,
+    agent_control: &AgentControlInit,
+) -> anyhow::Result<ThreadId> {
+    Ok(match (initial_history, reserved_thread_id) {
+        (
+            InitialHistory::New | InitialHistory::Cleared | InitialHistory::Forked(_),
+            Some(thread_id),
+        ) => thread_id,
+        (InitialHistory::New | InitialHistory::Cleared | InitialHistory::Forked(_), None) => {
+            agent_control.runtime().generate_thread_id()
+        }
+        (InitialHistory::Resumed(resumed_history), None) => resumed_history.conversation_id,
+        (InitialHistory::Resumed(_), Some(_)) => {
+            return Err(anyhow::anyhow!(
+                "reserved thread ID cannot be used when resuming a thread"
+            ));
+        }
+    })
+}
