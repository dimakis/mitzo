+use super::*;
+use crate::client_common::Prompt;
+use crate::responses_metadata::CodexResponsesRequestKind;
+use pretty_assertions::assert_eq;
+
+#[tokio::test]
+async fn original_session_owner_inputs_preserve_client_auth_and_offline_request_projection()
+-> anyhow::Result<()> {
+    // The existing ordinary Session/Step fixture is ONLY a comparison oracle.
+    // No Session or metadata is manufactured by the preparation path. The
+    // actual fixture provider must be the ordinary non-gateway OpenAI provider;
+    // this fixture never calls auth, transport, stream, count or a model.
+    let (session, turn) = crate::session::tests::make_session_and_context().await;
+    let session = Arc::new(session);
+    let step = session
+        .capture_step_context(Arc::new(turn), &tokio_util::sync::CancellationToken::new())
+        .await?;
+    let config = session.get_config().await;
+    let original_start = crate::StartThreadOptions::new(config.as_ref().clone());
+    let metadata = session
+        .responses_metadata(&step, CodexResponsesRequestKind::Turn)
+        .await;
+    let prompt = Prompt {
+        base_instructions: session.get_prompt_base_instructions().await,
+        ..Default::default()
+    };
+    let state = session.state.lock().await;
+    let configuration = &state.session_configuration;
+    assert!(configuration.provider.info().is_openai());
+    assert!(configuration.provider.info().gateway_oauth.is_none());
+    assert!(configuration.provider.info().aws.is_none());
+    assert!(configuration.provider.info().auth.is_none());
+    let routing = session
+        .services
+        .thread_extension_data
+        .get_or_init(|| config.workspace_routing_context());
+    let title_request = config.ephemeral
+        && matches!(configuration.thread_source.as_ref(),
+        Some(codex_protocol::protocol::ThreadSource::Feature(feature)) if feature == "thread_title");
+    let projected = OriginalSessionModelClientInputs {
+        config: &config,
+        session_configuration: configuration,
+        auth_manager: &session.services.auth_manager,
+        thread_id: session.thread_id(),
+        initial_history: &original_start.initial_history,
+        reasoning_effort_override_enabled: config
+            .features
+            .enabled(Feature::ReasoningEffortOverride)
+            && !title_request,
+        attestation_provider: session.services.attestation_provider.clone(),
+        workspace_routing: &routing,
+        extensions: session.services.extensions.as_ref(),
+        executed_tool_calls: &session.services.executed_tool_calls,
+        fork_cache_key: None,
+        tx_event: &session.tx_event,
+        codex_responses_headers: session
+            .services
+            .thread_extension_data
+            .get::<crate::CodexResponsesHeaders>(),
+    }
+    .construct();
+    drop(state);
+    assert!(Arc::ptr_eq(
+        &projected.auth_manager().unwrap(),
+        &session.services.auth_manager
+    ));
+    let request = |client: &ModelClient| {
+        client.build_responses_request(
+            &prompt,
+            &step.settings.model_info,
+            /*effort*/ None,
+            codex_protocol::config_types::ReasoningSummary::Auto,
+            /*service_tier*/ None,
+            &metadata,
+            /*include_internal*/ false,
+        )
+    };
+    // Whole request values (including native IDs, source/cache framing and
+    // metadata), not HashMap serialization order across independent clients.
+    assert_eq!(
+        serde_json::to_value(request(&projected)?)?,
+        serde_json::to_value(request(&session.services.model_client)?)?
+    );
+    Ok(())
+}
