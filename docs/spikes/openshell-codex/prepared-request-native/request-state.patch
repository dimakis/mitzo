diff --git a/codex-rs/state/migrations/0059_prepared_requests.sql b/codex-rs/state/migrations/0059_prepared_requests.sql
new file mode 100644
index 0000000..81bef9a
--- /dev/null
+++ b/codex-rs/state/migrations/0059_prepared_requests.sql
@@ -0,0 +1,77 @@
+-- Private request capabilities may exist before any native thread exists.
+CREATE TABLE prepared_requests (
+    preparation_id TEXT PRIMARY KEY NOT NULL,
+    operation_id TEXT NOT NULL UNIQUE,
+    scope TEXT NOT NULL CHECK (scope IN ('review_context', 'command')),
+    binding_json TEXT NOT NULL CHECK (json_valid(binding_json) AND length(binding_json) <= 65536),
+    request_identity TEXT NOT NULL CHECK (length(request_identity) = 64),
+    model TEXT NOT NULL,
+    encoded_body BLOB NOT NULL CHECK (length(encoded_body) BETWEEN 1 AND 4194304),
+    max_output_tokens INTEGER NOT NULL CHECK (max_output_tokens BETWEEN 1 AND 9007199254740991),
+    measurement_json TEXT CHECK (measurement_json IS NULL OR (json_valid(measurement_json) AND length(measurement_json) <= 65536)),
+    consumed INTEGER NOT NULL DEFAULT 0 CHECK (consumed IN (0, 1)),
+    native_thread_id TEXT,
+    native_turn_id TEXT,
+    provider_response_id TEXT,
+    created_at INTEGER NOT NULL,
+    consumed_at INTEGER,
+    CHECK (consumed = 0 OR (scope = 'command' AND measurement_json IS NOT NULL)),
+    CHECK ((native_thread_id IS NULL) = (native_turn_id IS NULL)),
+    CHECK (consumed = 1 OR (native_thread_id IS NULL AND provider_response_id IS NULL)),
+    UNIQUE (native_thread_id, native_turn_id)
+);
+
+-- Account changes cannot release an ordinary command's consumption tombstone.
+CREATE UNIQUE INDEX prepared_requests_consumed_command
+ON prepared_requests (
+    json_extract(binding_json, '$.application_scope_id'),
+    json_extract(binding_json, '$.command_id')
+) WHERE consumed = 1;
+
+-- Opaque upstream identities are namespaced by the retained account authority.
+CREATE UNIQUE INDEX prepared_requests_provider_response
+ON prepared_requests (
+    json_extract(binding_json, '$.account_id'),
+    provider_response_id
+) WHERE provider_response_id IS NOT NULL;
+
+CREATE TRIGGER prepared_requests_immutable_request
+BEFORE UPDATE OF preparation_id, operation_id, scope, binding_json, request_identity,
+    model, encoded_body, max_output_tokens ON prepared_requests
+BEGIN
+    SELECT RAISE(ABORT, 'prepared request is immutable');
+END;
+
+CREATE TRIGGER prepared_requests_irreversible_consumption
+BEFORE UPDATE OF consumed ON prepared_requests
+WHEN OLD.consumed = 1 AND NEW.consumed != 1
+BEGIN
+    SELECT RAISE(ABORT, 'prepared request consumption is irreversible');
+END;
+
+CREATE TRIGGER prepared_requests_immutable_measurement
+BEFORE UPDATE OF measurement_json ON prepared_requests
+WHEN OLD.measurement_json IS NOT NULL OR OLD.consumed = 1
+BEGIN
+    SELECT RAISE(ABORT, 'prepared request measurement is immutable');
+END;
+
+CREATE TRIGGER prepared_requests_retain_consumed
+BEFORE DELETE ON prepared_requests WHEN OLD.consumed = 1
+BEGIN
+    SELECT RAISE(ABORT, 'consumed request tombstone must be retained');
+END;
+
+CREATE TRIGGER prepared_requests_immutable_native_receipt
+BEFORE UPDATE OF native_thread_id, native_turn_id ON prepared_requests
+WHEN OLD.native_turn_id IS NOT NULL
+BEGIN
+    SELECT RAISE(ABORT, 'native admission receipt is immutable');
+END;
+
+CREATE TRIGGER prepared_requests_immutable_provider_receipt
+BEFORE UPDATE OF provider_response_id ON prepared_requests
+WHEN OLD.provider_response_id IS NOT NULL
+BEGIN
+    SELECT RAISE(ABORT, 'provider acceptance receipt is immutable');
+END;
