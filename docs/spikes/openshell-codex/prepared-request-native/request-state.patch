@@ -0,0 +1,434 @@
+//! Private durable request capabilities; this store creates no thread or history.
+//!
+//! Callers are trusted native owners. They must capture authority and serialize
+//! consumption with ordinary execution. Request identities label frozen bytes;
+//! storage compares the complete immutable request rather than trusting a digest.
+
+use super::StateRuntime;
+use serde::Deserialize;
+use serde::Serialize;
+use sqlx::Connection;
+use sqlx::Row;
+use sqlx::Sqlite;
+use sqlx::pool::PoolConnection;
+use sqlx::sqlite::SqliteRow;
+use uuid::Uuid;
+
+const MAX_BODY_BYTES: usize = 4 * 1024 * 1024;
+const MAX_TEXT_BYTES: usize = 1024;
+const MAX_SAFE_TOKENS: u64 = 9_007_199_254_740_991;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+pub enum PreparedRequestScope {
+    ReviewContext,
+    Command,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct PreparedRequestBinding {
+    pub application_scope_id: String,
+    pub account_id: String,
+    pub route_revision: String,
+    pub source_revision: String,
+    pub settings_revision: String,
+    pub history_revision: String,
+    pub tools_revision: String,
+    pub runtime_revision: String,
+    pub command_id: Option<String>,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct NewPreparedRequest {
+    pub scope: PreparedRequestScope,
+    pub binding: PreparedRequestBinding,
+    pub request_identity: String,
+    pub model: String,
+    pub encoded_body: Vec<u8>,
+    pub max_output_tokens: u64,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct PreparedRequestMeasurement {
+    pub witness_id: String,
+    pub request_identity: String,
+    pub input_tokens: u64,
+    pub effective_context_ceiling: u64,
+    pub max_output_tokens: u64,
+    pub counter_revision: String,
+    pub limit_revision: String,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct PreparedTurnReceipt {
+    pub thread_id: String,
+    pub turn_id: String,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct PreparedProviderReceipt {
+    pub request_identity: String,
+    pub provider_response_id: String,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct PreparedRequestRecord {
+    pub preparation_id: String,
+    pub operation_id: String,
+    pub request: NewPreparedRequest,
+    pub measurement: Option<PreparedRequestMeasurement>,
+    pub consumed: bool,
+    pub exact_turn: Option<PreparedTurnReceipt>,
+    pub provider_receipt: Option<PreparedProviderReceipt>,
+}
+
+impl StateRuntime {
+    /// Retain frozen bytes before any thread exists. Only exact operation retries succeed.
+    pub async fn prepare_request(
+        &self,
+        operation_id: &str,
+        request: &NewPreparedRequest,
+    ) -> anyhow::Result<PreparedRequestRecord> {
+        validate_text(operation_id)?;
+        validate_request(request)?;
+        let mut connection = self.prepared_request_connection().await?;
+        let mut transaction = connection.begin_with("BEGIN IMMEDIATE").await?;
+        sqlx::query("INSERT INTO prepared_requests (preparation_id, operation_id, scope, binding_json, request_identity, model, encoded_body, max_output_tokens, created_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?) ON CONFLICT(operation_id) DO NOTHING")
+            .bind(Uuid::now_v7().to_string()).bind(operation_id)
+            .bind(match request.scope { PreparedRequestScope::ReviewContext => "review_context", PreparedRequestScope::Command => "command" })
+            .bind(serde_json::to_string(&request.binding)?).bind(&request.request_identity)
+            .bind(&request.model).bind(&request.encoded_body).bind(i64::try_from(request.max_output_tokens)?)
+            .bind(chrono::Utc::now().timestamp_millis()).execute(&mut *transaction).await?;
+        let row = sqlx::query("SELECT * FROM prepared_requests WHERE operation_id = ?")
+            .bind(operation_id)
+            .fetch_one(&mut *transaction)
+            .await?;
+        let record = record_from_row(&row)?;
+        anyhow::ensure!(
+            record.request == *request,
+            "prepared operation inputs conflict"
+        );
+        transaction.commit().await?;
+        Ok(record)
+    }
+
+    /// Recover one original operation without dispatching, recounting or releasing consumption.
+    pub async fn read_prepared_request(
+        &self,
+        operation_id: &str,
+    ) -> anyhow::Result<Option<PreparedRequestRecord>> {
+        validate_text(operation_id)?;
+        sqlx::query("SELECT * FROM prepared_requests WHERE operation_id = ?")
+            .bind(operation_id)
+            .fetch_optional(self.pool.as_ref())
+            .await?
+            .as_ref()
+            .map(record_from_row)
+            .transpose()
+    }
+
+    /// Attach a trusted native counter witness to the complete retained request exactly once.
+    pub async fn measure_prepared_request(
+        &self,
+        preparation_id: &str,
+        request: &NewPreparedRequest,
+        measurement: &PreparedRequestMeasurement,
+    ) -> anyhow::Result<()> {
+        validate_text(preparation_id)?;
+        validate_request(request)?;
+        validate_measurement(request, measurement)?;
+        let mut connection = self.prepared_request_connection().await?;
+        let mut transaction = connection.begin_with("BEGIN IMMEDIATE").await?;
+        let row = sqlx::query("SELECT * FROM prepared_requests WHERE preparation_id = ?")
+            .bind(preparation_id)
+            .fetch_one(&mut *transaction)
+            .await?;
+        let record = record_from_row(&row)?;
+        anyhow::ensure!(
+            record.request == *request,
+            "prepared request inputs conflict"
+        );
+        anyhow::ensure!(!record.consumed, "prepared request already consumed");
+        if let Some(existing) = record.measurement {
+            anyhow::ensure!(existing == *measurement, "prepared measurement conflicts");
+        } else {
+            sqlx::query("UPDATE prepared_requests SET measurement_json = ? WHERE preparation_id = ? AND consumed = 0 AND measurement_json IS NULL")
+                .bind(serde_json::to_string(measurement)?).bind(preparation_id)
+                .execute(&mut *transaction).await?;
+        }
+        transaction.commit().await?;
+        Ok(())
+    }
+
+    /// Claim the single dispatch right. Every later attempt refuses, including after a crash.
+    ///
+    /// The trusted caller must establish its current authority fence before invoking this CAS.
+    pub async fn consume_prepared_request(
+        &self,
+        preparation_id: &str,
+        request: &NewPreparedRequest,
+        witness_id: &str,
+    ) -> anyhow::Result<PreparedRequestRecord> {
+        validate_text(preparation_id)?;
+        validate_text(witness_id)?;
+        validate_request(request)?;
+        anyhow::ensure!(
+            request.scope == PreparedRequestScope::Command,
+            "review context cannot be consumed"
+        );
+        let mut connection = self.prepared_request_connection().await?;
+        let mut transaction = connection.begin_with("BEGIN IMMEDIATE").await?;
+        let row = sqlx::query("SELECT * FROM prepared_requests WHERE preparation_id = ?")
+            .bind(preparation_id)
+            .fetch_one(&mut *transaction)
+            .await?;
+        let mut record = record_from_row(&row)?;
+        anyhow::ensure!(
+            record.request == *request,
+            "prepared request inputs conflict"
+        );
+        anyhow::ensure!(
+            record
+                .measurement
+                .as_ref()
+                .is_some_and(|measurement| measurement.witness_id == witness_id),
+            "prepared witness missing or conflicting"
+        );
+        anyhow::ensure!(!record.consumed, "prepared request already consumed");
+        let result = sqlx::query("UPDATE prepared_requests SET consumed = 1, consumed_at = ? WHERE preparation_id = ? AND consumed = 0 AND measurement_json IS NOT NULL")
+            .bind(chrono::Utc::now().timestamp_millis()).bind(preparation_id)
+            .execute(&mut *transaction).await?;
+        anyhow::ensure!(result.rows_affected() == 1, "prepared consumption lost");
+        transaction.commit().await?;
+        record.consumed = true;
+        Ok(record)
+    }
+
+    /// Retain exact native admission independently from upstream provider acceptance.
+    pub async fn acknowledge_prepared_request(
+        &self,
+        preparation_id: &str,
+        receipt: &PreparedTurnReceipt,
+    ) -> anyhow::Result<()> {
+        validate_text(&receipt.thread_id)?;
+        validate_text(&receipt.turn_id)?;
+        self.record_prepared_receipt(preparation_id, Receipt::Turn(receipt))
+            .await
+    }
+
+    /// Retain upstream acceptance even if native admission acknowledgement has not arrived.
+    pub async fn record_prepared_provider_receipt(
+        &self,
+        preparation_id: &str,
+        receipt: &PreparedProviderReceipt,
+    ) -> anyhow::Result<()> {
+        validate_identity(&receipt.request_identity)?;
+        validate_text(&receipt.provider_response_id)?;
+        self.record_prepared_receipt(preparation_id, Receipt::Provider(receipt))
+            .await
+    }
+
+    async fn record_prepared_receipt(
+        &self,
+        preparation_id: &str,
+        receipt: Receipt<'_>,
+    ) -> anyhow::Result<()> {
+        validate_text(preparation_id)?;
+        let mut connection = self.prepared_request_connection().await?;
+        let mut transaction = connection.begin_with("BEGIN IMMEDIATE").await?;
+        let row = sqlx::query("SELECT * FROM prepared_requests WHERE preparation_id = ?")
+            .bind(preparation_id)
+            .fetch_one(&mut *transaction)
+            .await?;
+        let record = record_from_row(&row)?;
+        anyhow::ensure!(record.consumed, "unconsumed request cannot have a receipt");
+        match receipt {
+            Receipt::Turn(receipt) => {
+                if let Some(existing) = record.exact_turn {
+                    anyhow::ensure!(existing == *receipt, "native turn receipt conflicts");
+                } else {
+                    sqlx::query("UPDATE prepared_requests SET native_thread_id = ?, native_turn_id = ? WHERE preparation_id = ? AND consumed = 1 AND native_turn_id IS NULL")
+                        .bind(&receipt.thread_id).bind(&receipt.turn_id).bind(preparation_id)
+                        .execute(&mut *transaction).await?;
+                }
+            }
+            Receipt::Provider(receipt) => {
+                anyhow::ensure!(
+                    record.request.request_identity == receipt.request_identity,
+                    "provider receipt request conflicts"
+                );
+                if let Some(existing) = record.provider_receipt {
+                    anyhow::ensure!(existing == *receipt, "provider receipt conflicts");
+                } else {
+                    sqlx::query("UPDATE prepared_requests SET provider_response_id = ? WHERE preparation_id = ? AND consumed = 1 AND provider_response_id IS NULL")
+                        .bind(&receipt.provider_response_id).bind(preparation_id)
+                        .execute(&mut *transaction).await?;
+                }
+            }
+        }
+        transaction.commit().await?;
+        Ok(())
+    }
+
+    async fn prepared_request_connection(&self) -> anyhow::Result<PoolConnection<Sqlite>> {
+        let mut connection = self.pool.acquire().await?;
+        // Keep the pool permit, but never return FULL synchronization to another
+        // metadata borrower. Closing on drop also covers cancellation and errors.
+        connection.close_on_drop();
+        sqlx::query("PRAGMA synchronous = FULL")
+            .execute(&mut *connection)
+            .await?;
+        Ok(connection)
+    }
+}
+
+enum Receipt<'a> {
+    Turn(&'a PreparedTurnReceipt),
+    Provider(&'a PreparedProviderReceipt),
+}
+
+fn validate_text(value: &str) -> anyhow::Result<()> {
+    anyhow::ensure!(
+        !value.is_empty() && value.len() <= MAX_TEXT_BYTES,
+        "prepared identity/revision size invalid"
+    );
+    Ok(())
+}
+
+fn validate_identity(value: &str) -> anyhow::Result<()> {
+    anyhow::ensure!(
+        value.len() == 64 && value.bytes().all(|byte| byte.is_ascii_hexdigit()),
+        "prepared request identity must be SHA256 hex"
+    );
+    Ok(())
+}
+
+fn validate_request(request: &NewPreparedRequest) -> anyhow::Result<()> {
+    let binding = &request.binding;
+    for value in [
+        &binding.application_scope_id,
+        &binding.account_id,
+        &binding.route_revision,
+        &binding.source_revision,
+        &binding.settings_revision,
+        &binding.history_revision,
+        &binding.tools_revision,
+        &binding.runtime_revision,
+        &request.model,
+    ] {
+        validate_text(value)?;
+    }
+    match (request.scope, binding.command_id.as_deref()) {
+        (PreparedRequestScope::Command, Some(command)) => validate_text(command)?,
+        (PreparedRequestScope::ReviewContext, None) => {}
+        (PreparedRequestScope::Command, None) | (PreparedRequestScope::ReviewContext, Some(_)) => {
+            anyhow::bail!("prepared request command scope invalid")
+        }
+    }
+    validate_identity(&request.request_identity)?;
+    anyhow::ensure!(
+        request.max_output_tokens > 0 && request.max_output_tokens <= MAX_SAFE_TOKENS,
+        "prepared output bound invalid"
+    );
+    anyhow::ensure!(
+        !request.encoded_body.is_empty() && request.encoded_body.len() <= MAX_BODY_BYTES,
+        "prepared body size invalid"
+    );
+    let body: serde_json::Value = serde_json::from_slice(&request.encoded_body)?;
+    anyhow::ensure!(
+        body.get("model").and_then(serde_json::Value::as_str) == Some(request.model.as_str())
+            && body
+                .get("max_output_tokens")
+                .and_then(serde_json::Value::as_u64)
+                == Some(request.max_output_tokens),
+        "prepared body model/output bound conflicts"
+    );
+    Ok(())
+}
+
+fn validate_measurement(
+    request: &NewPreparedRequest,
+    measurement: &PreparedRequestMeasurement,
+) -> anyhow::Result<()> {
+    for value in [
+        &measurement.witness_id,
+        &measurement.counter_revision,
+        &measurement.limit_revision,
+    ] {
+        validate_text(value)?;
+    }
+    anyhow::ensure!(
+        measurement.request_identity == request.request_identity
+            && measurement.max_output_tokens == request.max_output_tokens,
+        "prepared witness request conflicts"
+    );
+    anyhow::ensure!(
+        measurement.input_tokens <= MAX_SAFE_TOKENS
+            && measurement.effective_context_ceiling > 0
+            && measurement.effective_context_ceiling <= MAX_SAFE_TOKENS,
+        "prepared measurement bounds invalid"
+    );
+    let total = measurement
+        .input_tokens
+        .checked_add(measurement.max_output_tokens)
+        .ok_or_else(|| anyhow::anyhow!("prepared measurement overflows"))?;
+    anyhow::ensure!(
+        total <= measurement.effective_context_ceiling,
+        "prepared measurement exceeds context budget"
+    );
+    Ok(())
+}
+
+fn record_from_row(row: &SqliteRow) -> anyhow::Result<PreparedRequestRecord> {
+    let scope: String = row.try_get("scope")?;
+    let request = NewPreparedRequest {
+        scope: match scope.as_str() {
+            "review_context" => PreparedRequestScope::ReviewContext,
+            "command" => PreparedRequestScope::Command,
+            _ => anyhow::bail!("invalid stored request scope"),
+        },
+        binding: serde_json::from_str(&row.try_get::<String, _>("binding_json")?)?,
+        request_identity: row.try_get("request_identity")?,
+        model: row.try_get("model")?,
+        encoded_body: row.try_get("encoded_body")?,
+        max_output_tokens: u64::try_from(row.try_get::<i64, _>("max_output_tokens")?)?,
+    };
+    validate_request(&request)?;
+    let measurement = row
+        .try_get::<Option<String>, _>("measurement_json")?
+        .map(|json| serde_json::from_str::<PreparedRequestMeasurement>(&json))
+        .transpose()?;
+    if let Some(measurement) = &measurement {
+        validate_measurement(&request, measurement)?;
+    }
+    let native_thread_id: Option<String> = row.try_get("native_thread_id")?;
+    let native_turn_id: Option<String> = row.try_get("native_turn_id")?;
+    let exact_turn = match (native_thread_id, native_turn_id) {
+        (Some(thread_id), Some(turn_id)) => Some(PreparedTurnReceipt { thread_id, turn_id }),
+        (None, None) => None,
+        (Some(_), None) | (None, Some(_)) => anyhow::bail!("incomplete stored native receipt"),
+    };
+    let provider_receipt = row
+        .try_get::<Option<String>, _>("provider_response_id")?
+        .map(|provider_response_id| PreparedProviderReceipt {
+            request_identity: request.request_identity.clone(),
+            provider_response_id,
+        });
+    Ok(PreparedRequestRecord {
+        preparation_id: row.try_get("preparation_id")?,
+        operation_id: row.try_get("operation_id")?,
+        request,
+        measurement,
+        consumed: row.try_get("consumed")?,
+        exact_turn,
+        provider_receipt,
+    })
+}
+
+#[cfg(test)]
+#[path = "prepared_requests_tests.rs"]
+mod tests;
