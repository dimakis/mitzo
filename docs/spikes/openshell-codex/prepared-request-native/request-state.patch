+#[tokio::test]
+async fn prepared_request_cross_process_single_winner() {
+    const HOME_KEY: &str = "CODEX_PREPARED_REQUEST_TEST_HOME";
+    const RESULT_KEY: &str = "CODEX_PREPARED_REQUEST_TEST_RESULT";
+    if let Some(home) = std::env::var_os(HOME_KEY) {
+        let runtime = open(Path::new(&home)).await;
+        let record = runtime
+            .read_prepared_request("operation")
+            .await
+            .unwrap()
+            .unwrap();
+        let won = runtime
+            .consume_prepared_request(&record.preparation_id, &record.request, "witness")
+            .await
+            .is_ok();
+        std::fs::write(
+            std::env::var_os(RESULT_KEY).unwrap(),
+            if won { "won" } else { "lost" },
+        )
+        .unwrap();
+        runtime.close().await;
+        return;
+    }
+    let home = unique_temp_dir();
+    let runtime = open(&home).await;
+    let request = request();
+    let prepared = runtime
+        .prepare_request("operation", &request)
+        .await
+        .unwrap();
+    runtime
+        .measure_prepared_request(&prepared.preparation_id, &request, &measurement())
+        .await
+        .unwrap();
+    runtime.close().await;
+    let mut children = vec![];
+    for index in 0..2 {
+        let result = home.join(format!("result-{index}"));
+        let child = std::process::Command::new(std::env::current_exe().unwrap())
+            .args([
+                "--exact",
+                "runtime::prepared_requests::tests::prepared_request_cross_process_single_winner",
+                "--nocapture",
+            ])
+            .env(HOME_KEY, &home)
+            .env(RESULT_KEY, &result)
+            .spawn()
+            .unwrap();
+        children.push((child, result));
+    }
+    let mut wins = 0;
+    for (mut child, result) in children {
+        assert!(child.wait().unwrap().success());
+        wins += usize::from(std::fs::read_to_string(result).unwrap() == "won");
+    }
+    assert_eq!(wins, 1);
+    let reopened = open(&home).await;
+    assert!(
+        reopened
+            .read_prepared_request("operation")
+            .await
+            .unwrap()
+            .unwrap()
+            .consumed
+    );
+    reopened.close().await;
+}
