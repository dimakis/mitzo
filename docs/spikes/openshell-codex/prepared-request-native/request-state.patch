+use super::*;
+use crate::runtime::test_support::unique_temp_dir;
+use codex_utils_absolute_path::test_support::PathExt;
+use pretty_assertions::assert_eq;
+use std::path::Path;
+use std::sync::Arc;
+
+async fn open(home: &Path) -> Arc<StateRuntime> {
+    StateRuntime::init(
+        crate::SqliteConfig::new_for_testing(home.abs()),
+        "test".into(),
+    )
+    .await
+    .unwrap()
+}
+
+fn request() -> NewPreparedRequest {
+    NewPreparedRequest {
+        scope: PreparedRequestScope::Command,
+        binding: PreparedRequestBinding {
+            application_scope_id: "session".into(),
+            account_id: "account".into(),
+            route_revision: "route".into(),
+            source_revision: "sources".into(),
+            settings_revision: "settings".into(),
+            history_revision: "history".into(),
+            tools_revision: "tools".into(),
+            runtime_revision: "runtime".into(),
+            command_id: Some("command".into()),
+        },
+        request_identity: "a".repeat(/*n*/ 64),
+        model: "test-model".into(),
+        encoded_body:
+            br#"{"model":"test-model","input":"explicit command","max_output_tokens":10}"#.to_vec(),
