+#[tokio::test]
+async fn prepared_request_changed_inputs_conflict_even_with_same_identity() {
+    let home = unique_temp_dir();
+    let runtime = open(&home).await;
+    let original = request();
+    let prepared = runtime
+        .prepare_request("operation", &original)
+        .await
+        .unwrap();
+    let mut candidates = Vec::new();
+    let mut body = original.clone();
+    body.encoded_body.push(b' ');
+    candidates.push(body);
+    let mut model = original.clone();
+    model.model.push('2');
+    candidates.push(model);
+    let mut output = original.clone();
+    output.max_output_tokens += 1;
+    candidates.push(output);
+    for field in 0..9 {
+        let mut changed = original.clone();
+        let binding = &mut changed.binding;
+        let value = match field {
+            0 => &mut binding.account_id,
+            1 => &mut binding.route_revision,
+            2 => &mut binding.source_revision,
+            3 => &mut binding.settings_revision,
+            4 => &mut binding.history_revision,
+            5 => &mut binding.tools_revision,
+            6 => &mut binding.runtime_revision,
+            7 => binding.command_id.as_mut().unwrap(),
+            8 => &mut binding.application_scope_id,
+            _ => unreachable!(),
+        };
+        value.push('2');
+        candidates.push(changed);
+    }
+    for changed in candidates {
+        assert!(
+            runtime
+                .prepare_request("operation", &changed)
+                .await
+                .is_err()
+        );
+        assert!(
+            runtime
+                .measure_prepared_request(&prepared.preparation_id, &changed, &measurement())
+                .await
+                .is_err()
+        );
+    }
+    runtime
+        .measure_prepared_request(&prepared.preparation_id, &original, &measurement())
+        .await
+        .unwrap();
+    let mut stale = original.clone();
+    stale.binding.history_revision.push('2');
+    assert!(
+        runtime
+            .consume_prepared_request(&prepared.preparation_id, &stale, "witness")
+            .await
+            .is_err()
+    );
+    runtime.close().await;
+}
