+#[tokio::test]
+async fn malformed_packets_refuse_before_any_callback() -> anyhow::Result<()> {
+    let fixture = Fixture::new(
+        AskForApproval::OnRequest,
+        /*prefix*/ false,
+        /*decision*/ None,
+        /*gated*/ false,
+    )
+    .await?;
+    let hooks = fixture.trusted_hook()?;
+    let valid = ApprovalAction::Execve {
+        id: fixture.provider.call_id.clone(),
+        approval_id: "intercept".into(),
+        environment_id: fixture.provider.environment_id.clone(),
+        source: GuardianCommandSource::UnifiedExec,
+        program: fixture.program.clone(),
+        argv: vec!["argv-zero".into()],
+        command: vec![fixture.program.to_string_lossy().into_owned()],
+        cwd: AbsolutePathBuf::current_dir()?,
+        additional_permissions: None,
+    };
+    let mut actions = vec![valid.clone(), valid.clone(), valid.clone()];
+    if let ApprovalAction::Execve { id, .. } = &mut actions[0] {
+        *id = "foreign-call".into();
+    }
+    if let ApprovalAction::Execve { environment_id, .. } = &mut actions[1] {
+        *environment_id = "foreign-environment".into();
+    }
+    if let ApprovalAction::Execve { command, .. } = &mut actions[2] {
+        command.push("invented".into());
+    }
+    actions.push(ApprovalAction::ExecCommand {
+        id: fixture.provider.call_id.clone(),
+        environment_id: fixture.provider.environment_id.clone(),
+        command: vec!["other-action".into()],
+        hook_command: "other-action".into(),
+        cwd: fixture
+            .provider
+            .review_context
+            .environments()
+            .primary()
+            .unwrap()
+            .cwd()
+            .clone(),
+        sandbox_permissions: SandboxPermissions::UseDefault,
+        additional_permissions: None,
+        justification: None,
+        tty: false,
+        proposed_execpolicy_amendment: None,
+    });
+    for action in actions {
+        assert!(matches!(
+            fixture
+                .provider
+                .session
+                .capture_intercepted_approval_selection(
+                    action,
+                    &fixture.provider.call_id,
+                    &fixture.provider.tool_name,
+                    &fixture.provider.review_context,
+                    Arc::clone(&fixture.provider.parent_exec_policy)
+                )
+                .await,
+            Err(ToolError::Rejected(_))
+        ));
+    }
+    assert_eq!(fixture.calls.load(Ordering::SeqCst), 0);
+    assert!(!hooks.path().join("hook-called").exists());
+    fixture.no_manual_events();
+    fixture.close().await;
+    Ok(())
+}
