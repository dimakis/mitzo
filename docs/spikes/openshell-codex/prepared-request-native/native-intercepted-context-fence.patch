         };
         // Network approvals record their final telemetry after validation and persistence.
         if !is_network_approval {
@@ -629,6 +650,40 @@ impl Session {
         }
     }
 
+    async fn request_intercepted_reviewer_approval(
+        self: &Arc<Self>,
+        action: ApprovalAction,
+        ctx: &ApprovalContext,
+        selected: &crate::session::InterceptedApprovalSelection,
+    ) -> Result<ApprovalResolution, ToolError> {
+        let routing = self
+            .request_guardian_approval_with_routing(action.clone(), ctx)
+            .await;
+        if matches!(
+            routing.disposition(),
+            codex_guardian_reviewer::ReviewDisposition::UserPrompt(_)
+        ) {
+            let used = routing.used_config().ok_or_else(|| {
+                ToolError::Rejected(
+                    "intercepted execution approval context changed during review".into(),
+                )
+            })?;
+            self.validate_intercepted_user_prompt(selected, used)
+                .await?;
+        }
+        Ok(if let Some(decision) = routing.into_legacy_decision() {
+            ApprovalResolution {
+                decision,
+                source: ApprovalResolutionSource::Guardian,
+            }
+        } else {
+            ApprovalResolution {
+                decision: self.request_user_approval(&action, ctx).await,
+                source: ApprovalResolutionSource::User,
+            }
+        })
+    }
