+/// Ordinary review snapshots, not a grant or a barrier against later owner changes.
+pub(crate) struct InterceptedApprovalSelection {
+    session: Weak<Session>,
+    task_done: Arc<Notify>,
+    settings: Arc<ResolvedStepSettings>,
+    config: Arc<Config>,
+    manager_policy: Arc<Policy>,
+    task_cancellation: CancellationToken,
+    environments: crate::environment_selection::SelectedEnvironmentObservation,
+    // Exact provider evaluation snapshot, distinct from the current manager observation.
+    _evaluated_policy: Arc<Policy>,
+    action: ApprovalAction,
+    context: ApprovalContext,
+    environment_id: String,
+}
+
+impl InterceptedApprovalSelection {
+    pub(crate) fn approval_policy(&self) -> AskForApproval {
+        self.context.review_context.approval_policy
+    }
+    pub(crate) fn approval_request(&self) -> (ApprovalAction, ApprovalContext) {
+        (self.action.clone(), self.context.clone())
+    }
+}
+
+enum InterceptedValidation<'a> {
+    BeforeCallbacks,
+    BeforeUserPrompt(&'a Arc<Config>),
+}
+
+fn intercepted_context_changed() -> ToolError {
+    ToolError::Rejected("intercepted execution approval context changed during review".into())
+}
+
+impl Session {
+    #[cfg(unix)]
+    #[expect(
+        clippy::await_holding_invalid_type,
+        reason = "capture actual selected owners together"
+    )]
+    pub(crate) async fn capture_intercepted_approval_selection(
+        self: &Arc<Self>,
+        action: ApprovalAction,
+        call_id: &str,
+        tool_name: &ToolName,
+        provider_context: &GuardianReviewContext,
+        evaluated_policy: Arc<Policy>,
+    ) -> Result<InterceptedApprovalSelection, ToolError> {
+        let ApprovalAction::Execve {
+            id,
+            approval_id,
+            environment_id,
+            source,
+            program,
+            argv,
+            command,
+            ..
+        } = &action
+        else {
+            return Err(intercepted_context_changed());
+        };
+        let normalized = std::iter::once(program.to_string_lossy().into_owned())
+            .chain(argv.iter().skip(1).cloned())
+            .collect::<Vec<_>>();
+        if id != call_id
+            || approval_id.is_empty()
+            || *source != codex_protocol::protocol::GuardianCommandSource::UnifiedExec
+            || *command != normalized
+        {
+            return Err(intercepted_context_changed());
+        }
+        let active = self.active_turn.lock().await;
+        let task = active
+            .as_ref()
+            .and_then(|active| active.task.as_ref())
+            .ok_or_else(|| {
+                ToolError::Rejected(
+                    "cannot approve intercepted execution without an active turn".into(),
+                )
+            })?;
+        let session_state = self.state.lock().await;
+        let state = active
+            .as_ref()
+            .expect("active task")
+            .turn_state
+            .lock()
+            .await;
+        let settings = task.turn_context.next_step_settings.load_full();
+        let environments = self.services.turn_environments.observe_selected();
+        let ready = environments
+            .snapshot()
+            .turn_environments()
+            .find(|environment| environment.selection.environment_id == *environment_id)
+            .ok_or_else(intercepted_context_changed)?;
+        let provider = provider_context
+            .environments()
+            .turn_environments()
+            .find(|environment| environment.selection.environment_id == *environment_id)
+            .ok_or_else(intercepted_context_changed)?;
+        if ready.selection != provider.selection
+            || ready.config_origin != provider.config_origin
+            || !Arc::ptr_eq(&ready.environment, &provider.environment)
+            || ready.executor_platform_os != provider.executor_platform_os
+            || ready.user_home_dir != provider.user_home_dir
+            || ready.temporary_directories != provider.temporary_directories
+            || task.cancellation_token.is_cancelled()
+        {
+            return Err(intercepted_context_changed());
+        }
+        let context = ApprovalContext {
+            review_context: GuardianReviewContext::from_resolved_settings(
+                Arc::clone(&task.turn_context),
+                &settings,
+                environments.snapshot(),
+            ),
+            cancellation_token: None,
+            call_id: call_id.into(),
+            tool_name: tool_name.clone(),
+            strict_auto_review: state.strict_auto_review_enabled(),
+            approval_reason: None,
+            retry_reason: None,
+            network_approval_context: None,
+        };
+        let environment_id = environment_id.clone();
+        Ok(InterceptedApprovalSelection {
+            session: Arc::downgrade(self),
+            task_done: Arc::clone(&task.done),
+            settings,
+            config: Arc::clone(
+                &session_state
+                    .session_configuration
+                    .original_config_do_not_use,
+            ),
+            manager_policy: self.services.exec_policy.current(),
+            task_cancellation: task.cancellation_token.clone(),
+            environments,
+            _evaluated_policy: evaluated_policy,
+            action,
+            context,
+            environment_id,
+        })
+    }
+
+    pub(crate) async fn validate_intercepted_approval_selection(
+        self: &Arc<Self>,
+        selected: &InterceptedApprovalSelection,
+    ) -> Result<(), ToolError> {
+        self.validate_intercepted_selection(selected, InterceptedValidation::BeforeCallbacks)
+            .await
+    }
+
+    pub(crate) async fn validate_intercepted_user_prompt(
+        self: &Arc<Self>,
+        selected: &InterceptedApprovalSelection,
+        used_config: &Arc<Config>,
+    ) -> Result<(), ToolError> {
+        self.validate_intercepted_selection(
+            selected,
+            InterceptedValidation::BeforeUserPrompt(used_config),
+        )
+        .await
+    }
+
+    #[expect(
+        clippy::await_holding_invalid_type,
+        reason = "compare the captured owners before a user prompt"
+    )]
+    async fn validate_intercepted_selection(
+        self: &Arc<Self>,
+        selected: &InterceptedApprovalSelection,
+        phase: InterceptedValidation<'_>,
+    ) -> Result<(), ToolError> {
+        let active = self.active_turn.lock().await;
+        let active = active.as_ref().ok_or_else(intercepted_context_changed)?;
+        let task = active
+            .task
+            .as_ref()
+            .ok_or_else(intercepted_context_changed)?;
+        let session_state = self.state.lock().await;
+        let state = active.turn_state.lock().await;
+        let review_matches = match phase {
+            InterceptedValidation::BeforeCallbacks => true,
+            InterceptedValidation::BeforeUserPrompt(used) => Arc::ptr_eq(used, &selected.config),
+        };
+        if review_matches
+            && selected
+                .session
+                .upgrade()
+                .is_some_and(|owner| Arc::ptr_eq(&owner, self))
+            && Arc::ptr_eq(&task.done, &selected.task_done)
+            && Arc::ptr_eq(&task.turn_context, selected.context.review_context.turn())
+            && Arc::ptr_eq(
+                &task.turn_context.next_step_settings.load_full(),
+                &selected.settings,
+            )
+            && Arc::ptr_eq(
+                &session_state
+                    .session_configuration
+                    .original_config_do_not_use,
+                &selected.config,
+            )
+            && Arc::ptr_eq(
+                &self.services.exec_policy.current(),
+                &selected.manager_policy,
+            )
+            && state.strict_auto_review_enabled() == selected.context.strict_auto_review
+            && !task.cancellation_token.is_cancelled()
+            && !selected.task_cancellation.is_cancelled()
+            && self
+                .services
+                .turn_environments
+                .selected_observation_is_current(&selected.environments, &selected.environment_id)
+        {
+            Ok(())
+        } else {
+            Err(intercepted_context_changed())
+        }
+    }
+}
