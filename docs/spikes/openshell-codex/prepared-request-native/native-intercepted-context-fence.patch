+#[tokio::test]
+async fn current_never_and_both_granular_sources_refuse_before_callbacks() -> anyhow::Result<()> {
+    for (policy, prefix) in [
+        (AskForApproval::Never, false),
+        (
+            AskForApproval::Granular(GranularApprovalConfig {
+                rules: false,
+                sandbox_approval: true,
+                skill_approval: true,
+                request_permissions: true,
+                mcp_elicitations: true,
+            }),
+            true,
+        ),
+        (
+            AskForApproval::Granular(GranularApprovalConfig {
+                rules: true,
+                sandbox_approval: false,
+                skill_approval: true,
+                request_permissions: true,
+                mcp_elicitations: true,
+            }),
+            false,
+        ),
+    ] {
+        let fixture = Fixture::new(policy, prefix, /*decision*/ None, /*gated*/ false).await?;
+        let hooks = fixture.trusted_hook()?;
+        assert_eq!(
+            tokio::time::timeout(Duration::from_secs(5), fixture.run()).await??,
+            EscalationDecision::deny(Some("Execution forbidden by policy".into()))
+        );
+        assert_eq!(fixture.calls.load(Ordering::SeqCst), 0);
+        assert!(!hooks.path().join("hook-called").exists());
+        fixture.no_manual_events();
+        fixture.close().await;
+    }
+    Ok(())
+}
