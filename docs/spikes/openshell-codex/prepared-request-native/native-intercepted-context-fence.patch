+#[tokio::test]
+async fn callback_drift_refuses_default_and_explicit_user_routes_without_relabeling()
+-> anyhow::Result<()> {
+    for decision in [None, Some(ApprovalDecision::AskUser)] {
+        for drift in ["config", "policy", "environment"] {
+            let fixture = Fixture::new(
+                AskForApproval::OnRequest,
+                /*prefix*/ false,
+                decision.clone(),
+                /*gated*/ true,
+            )
+            .await?;
+            let session = &fixture.provider.session;
+            let config = session.get_config().await;
+            let original_policy = session.services.exec_policy.current();
+            let run = fixture.run();
+            tokio::pin!(run);
+            tokio::time::timeout(Duration::from_secs(5), async {
+                tokio::select! {
+                    _ = fixture.entered.notified() => {},
+                    result = &mut run => panic!("expected real contributor gate: {result:?}"),
+                }
+            })
+            .await?;
+            match drift {
+                "config" => {
+                    session
+                        .refresh_runtime_config(config.as_ref().clone())
+                        .await;
+                    assert!(!Arc::ptr_eq(&config, &session.get_config().await));
+                }
+                "policy" => {
+                    let home = tempfile::tempdir()?;
+                    session
+                        .services
+                        .exec_policy
+                        .append_amendment_and_update(
+                            home.path(),
+                            &codex_protocol::protocol::ExecPolicyAmendment {
+                                command: vec!["unrelated-policy-amendment".into()],
+                            },
+                        )
+                        .await?;
+                    assert!(!Arc::ptr_eq(
+                        &original_policy,
+                        &session.services.exec_policy.current()
+                    ));
+                }
+                "environment" => {
+                    let before = session.services.turn_environments.observe_selected();
+                    let projected = session.services.turn_environments.selections();
+                    let mut next = before.snapshot().primary().unwrap().config().clone();
+                    next.permission_profile =
+                        PermissionProfileSnapshot::legacy(PermissionProfile::Disabled);
+                    session
+                        .services
+                        .turn_environments
+                        .set_active_thread_defaults(next);
+                    assert_eq!(session.services.turn_environments.selections(), projected);
+                    let after = session.services.turn_environments.observe_selected();
+                    assert_ne!(
+                        before.snapshot().primary().unwrap().selection.config,
+                        after.snapshot().primary().unwrap().selection.config
+                    );
+                    assert!(Arc::ptr_eq(
+                        &before.snapshot().primary().unwrap().environment,
+                        &after.snapshot().primary().unwrap().environment
+                    ));
+                }
+                _ => unreachable!(),
+            }
+            if drift != "config" {
+                assert!(Arc::ptr_eq(&config, &session.get_config().await));
+            }
+            fixture.release.notify_one();
+            assert_eq!(
+                tokio::time::timeout(Duration::from_secs(5), run).await??,
+                EscalationDecision::deny(Some(
+                    "intercepted execution approval context changed during review".into()
+                ))
+            );
+            assert_eq!(fixture.calls.load(Ordering::SeqCst), 1);
+            fixture.no_manual_events();
+            fixture.close().await;
+        }
+    }
+    Ok(())
+}
