+#[test]
+fn capture_retains_final_ordinary_body_and_count_projection() {
+    let mut request =
+        format_responses_request(&prompt(), &model(), &public_context(), options()).unwrap();
+    normalize_request_copy(
+        &mut request.input,
+        RequestCopyNormalization {
+            content_item_kinds_enabled: false,
+        },
+    );
+    let mut expected = serde_json::to_value(&request).unwrap();
+    let fields = expected.as_object_mut().unwrap();
+    fields.remove("client_metadata");
+    fields.insert("max_output_tokens".into(), json!(64));
+    fields.insert("truncation".into(), json!("disabled"));
+    let mut without_metadata = request.clone();
+    without_metadata.client_metadata = None;
+    let absent =
+        capture_finalized_responses_request(without_metadata, &[], capture_budget()).unwrap();
+    let frozen = capture_finalized_responses_request(request, &[], capture_budget()).unwrap();
+    assert_eq!(frozen.encoded_body(), absent.encoded_body());
+    assert_eq!(frozen.body(), &expected);
+    assert_eq!(
+        frozen.encoded_body(),
+        serde_json::to_vec(&expected).unwrap()
+    );
+    assert_eq!(
+        frozen.count_body(),
+        &json!({
+            "model": expected["model"],
+            "instructions": expected["instructions"],
+            "input": expected["input"],
+            "tools": expected["tools"],
+            "tool_choice": expected["tool_choice"],
+            "parallel_tool_calls": expected["parallel_tool_calls"],
+            "reasoning": expected["reasoning"],
+            "text": expected["text"],
+            "truncation": "disabled",
+        })
+    );
+    let restored = FrozenResponsesRequest::from_encoded(frozen.encoded_body(), 128).unwrap();
+    assert_eq!(restored.encoded_body(), frozen.encoded_body());
+}
