+#[test]
+fn capture_refuses_internal_contributions_without_rewriting_them() {
+    let baseline =
+        format_responses_request(&prompt(), &model(), &public_context(), options()).unwrap();
+    let mut populated_metadata = baseline.clone();
+    populated_metadata.client_metadata = Some(HashMap::from([(
+        "model-visible-contribution".into(),
+        "must not disappear".into(),
+    )]));
+    let mut concurrent_summaries = baseline.clone();
+    concurrent_summaries.stream_options = Some(codex_api::StreamOptions {
+        reasoning_summary_delivery: codex_api::ReasoningSummaryDelivery::SequentialCutoff,
+    });
+    let mut access_programs = baseline.clone();
+    access_programs.access_programs = Some(codex_api::AccessPrograms::from(
+        codex_protocol::turn_input::CyberAccessProgram::Standard,
+    ));
+    let mut encrypted_arguments = baseline.clone();
+    encrypted_arguments.input.push(
+        serde_json::from_value(json!({
+            "type": "function_call", "call_id": "captured-call", "name": "fixture_tool",
+            "arguments": "{}", "encrypted_function_args": ["must not disappear"]
+        }))
+        .unwrap(),
+    );
+    let mut internal_message_metadata = baseline.clone();
+    internal_message_metadata.input.push(serde_json::from_value(json!({
+        "type": "message", "role": "user", "content": [],
+        "internal_chat_message_metadata_passthrough": {"content_item_kinds": ["must not disappear"]}
+    })).unwrap());
+    let mut lite_model = model();
+    lite_model.use_responses_lite = true;
+    let lite =
+        format_responses_request(&prompt(), &lite_model, &public_context(), options()).unwrap();
+    for request in [
+        populated_metadata,
+        concurrent_summaries,
+        access_programs,
+        encrypted_arguments,
+        internal_message_metadata,
+        lite,
+    ] {
+        let original = serde_json::to_value(&request).unwrap();
+        assert!(
+            capture_finalized_responses_request(request.clone(), &[], capture_budget()).is_err()
+        );
+        assert_eq!(serde_json::to_value(&request).unwrap(), original);
+    }
+}
