+#[test]
+fn capture_refuses_unresolved_contributors_without_invoking_them() {
+    use codex_extension_api::ModelRequestContributor;
+    use codex_extension_api::ModelRequestInput;
+    use codex_extension_api::ModelResponseInterceptor;
+    use std::sync::Arc;
+    use std::sync::atomic::AtomicUsize;
+    use std::sync::atomic::Ordering;
+
+    #[derive(Debug)]
+    struct UnresolvedContributor(Arc<AtomicUsize>);
+
+    impl ModelRequestContributor for UnresolvedContributor {
+        fn request(
+            &self,
+            _input: ModelRequestInput<'_>,
+        ) -> Option<Box<dyn ModelResponseInterceptor>> {
+            self.0.fetch_add(1, Ordering::SeqCst);
+            None
+        }
+    }
+
+    let invocations = Arc::new(AtomicUsize::new(0));
+    let contributors: Vec<Arc<dyn ModelRequestContributor>> =
+        vec![Arc::new(UnresolvedContributor(Arc::clone(&invocations)))];
+    let request =
+        format_responses_request(&prompt(), &model(), &public_context(), options()).unwrap();
+    assert!(capture_finalized_responses_request(request, &contributors, capture_budget()).is_err());
+    assert_eq!(invocations.load(Ordering::SeqCst), 0);
+}
