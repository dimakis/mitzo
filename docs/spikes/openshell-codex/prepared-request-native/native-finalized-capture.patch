+#[test]
+fn capture_refuses_invalid_or_unenforceable_output_reservations() {
+    let request =
+        format_responses_request(&prompt(), &model(), &public_context(), options()).unwrap();
+    for (max_output_tokens, model_output_limit) in
+        [(0, 128), (15, 128), (129, 128), (64, 0), (64, u64::MAX)]
+    {
+        assert!(
+            capture_finalized_responses_request(
+                request.clone(),
+                &[],
+                ResponsesOutputBudget {
+                    max_output_tokens,
+                    model_output_limit,
+                },
+            )
+            .is_err()
+        );
+    }
