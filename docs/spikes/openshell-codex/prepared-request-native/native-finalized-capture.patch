+/// Explicit output reservation checked against a caller-supplied numeric bound.
+/// This validates body shape only: no selected-account/model limit authority or
+/// pre-session source capture is established by these numbers.
+#[cfg_attr(
+    not(test),
+    allow(dead_code, reason = "Prepared admission is not installed.")
+)]
+pub(crate) struct ResponsesOutputBudget {
+    pub(crate) max_output_tokens: u64,
+    pub(crate) model_output_limit: u64,
+}
+
+/// Freeze a finalized ordinary HTTP body without rerunning any request contributors.
+///
+/// The existing owner must first resolve account metadata, normalize the request copy and
+/// finish all transport body mutations. Borrow its authoritative request-contributor inventory;
+/// a nonempty inventory refuses rather than invoking or silently bypassing a callback. Resolved
+/// immutable contributions must already be in `request`, where public validation retains or
+/// refuses them. An empty inventory does not establish pre-session source/tool capture.
+///
+/// Only an empty internal metadata map can be omitted: it contains no entries to translate or
+/// discard. Populated metadata, Responses Lite, internal item fields and other unsupported
+/// semantics refuse through the same strict body/count contract used for restoration.
+#[cfg_attr(
+    not(test),
+    allow(dead_code, reason = "Prepared admission is not installed.")
+)]
+pub(crate) fn capture_finalized_responses_request(
+    mut request: ResponsesApiRequest,
+    request_contributors: &[Arc<dyn ModelRequestContributor>],
+    budget: ResponsesOutputBudget,
+) -> std::result::Result<FrozenResponsesRequest, ApiError> {
+    if !request_contributors.is_empty() {
+        return Err(ApiError::InvalidRequest {
+            message: "cannot capture unresolved Responses request contributors".to_string(),
+        });
+    }
+    if request
+        .client_metadata
+        .as_ref()
+        .is_some_and(HashMap::is_empty)
+    {
+        request.client_metadata = None;
+    }
+    let mut body = serde_json::to_value(request).map_err(|_| ApiError::InvalidRequest {
+        message: "cannot encode finalized Responses request".to_string(),
+    })?;
+    let fields = body
+        .as_object_mut()
+        .ok_or_else(|| ApiError::InvalidRequest {
+            message: "finalized Responses request must be an object".to_string(),
+        })?;
+    fields.insert(
+        "max_output_tokens".to_string(),
+        budget.max_output_tokens.into(),
+    );
+    fields.insert("truncation".to_string(), "disabled".into());
+    FrozenResponsesRequest::new(body, budget.model_output_limit)
+}
