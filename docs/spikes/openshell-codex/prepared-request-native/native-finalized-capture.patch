+#[test]
+fn capture_uses_actual_ordinary_owner_and_refuses_populated_final_metadata() -> anyhow::Result<()> {
+    use crate::responses_request_format::ResponsesOutputBudget;
+    use crate::responses_request_format::capture_finalized_responses_request;
+
+    let client = test_model_client(SessionSource::Exec);
+    let metadata = test_responses_metadata_for_client(
+        &client,
+        Some("captured-turn"),
+        "captured-window".into(),
+        /*parent_thread_id*/ None,
+        TestCodexResponsesRequestKind::Turn,
+    );
+    let request = client.build_responses_request(
+        &Prompt::default(),
+        &test_model_info(),
+        /*effort*/ None,
+        codex_protocol::config_types::ReasoningSummary::Auto,
+        /*service_tier*/ None,
+        &metadata,
+        /*include_internal*/ false,
+    )?;
+    // Ordinary metadata comes from the existing owner; the capture helper must not
+    // silently erase it to manufacture public-body compatibility.
+    assert!(
+        request
+            .client_metadata
+            .as_ref()
+            .is_some_and(|values| !values.is_empty())
+    );
+    let retained = serde_json::to_value(&request)?;
+    assert!(
+        capture_finalized_responses_request(
+            request.clone(),
+            &client.request_contributors,
+            ResponsesOutputBudget {
+                max_output_tokens: 64,
+                model_output_limit: 128,
+            },
+        )
+        .is_err()
+    );
+    assert_eq!(serde_json::to_value(&request)?, retained);
+    Ok(())
+}
