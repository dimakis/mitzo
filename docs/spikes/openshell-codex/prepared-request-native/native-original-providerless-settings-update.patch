+//! Original providerless mutable-settings DATA algorithm. Borrowed views retain
+//! actual fields; they create no provider/Session or source authority. This is
+//! NOT a blanket no-I/O path: original cwd compatibility may resolve paths.
+use super::session::SessionSettingsUpdate;
+use super::step_settings::StepSettingsConstraints;
+use super::*;
+use crate::config::ConstraintError;
+use crate::environment_selection::ThreadEnvironments;
+use codex_protocol::models::ProfileWorkspaceRoot;
+use codex_protocol::permissions::FileSystemPath;
+use codex_protocol::permissions::FileSystemSpecialPath;
+use codex_utils_path::replace_path_and_deduplicate;
+
+pub(super) struct ConfiguredSettingsView<'a> {
+    pub(super) step_settings: &'a Arc<StepSettings>,
+    pub(super) permission_profile_state: &'a PermissionProfileState,
+    pub(super) legacy_fallback_cwd: &'a AbsolutePathBuf,
+    pub(super) original_config_do_not_use: &'a Arc<Config>,
+    pub(super) trusted_guardian_reviewer: bool,
+}
+pub(super) struct ConfiguredSettingsEdit<'a> {
+    pub(super) step_settings: &'a mut Arc<StepSettings>,
+    pub(super) permission_profile_state: &'a mut PermissionProfileState,
+    pub(super) legacy_fallback_cwd: &'a mut AbsolutePathBuf,
+    pub(super) original_config_do_not_use: &'a mut Arc<Config>,
+    pub(super) environments: &'a mut Vec<TurnEnvironmentSelection>,
+    pub(super) windows_sandbox_level: &'a mut WindowsSandboxLevel,
+    pub(super) runtime_workspace_roots: &'a mut Vec<AbsolutePathBuf>,
+    pub(super) app_server_client_name: &'a mut Option<String>,
+    pub(super) app_server_client_version: &'a mut Option<String>,
+    pub(super) disabled_plugin_ids: &'a mut Vec<String>,
+    pub(super) trusted_guardian_reviewer: bool,
+}
+
+/// Same original environment-owner rule, BEFORE the caller clones a candidate.
+pub(super) fn check_environment_update(
+    current: &[TurnEnvironmentSelection],
+    updates: &SessionSettingsUpdate,
+) -> ConstraintResult<()> {
+    if let Some(environments) = &updates.environments {
+        super::environment::ensure_configs_stay_owner_provided(
+            current,
+            &environments.environments,
+        )?;
+    }
+    Ok(())
+}
+
+impl<'a> ConfiguredSettingsView<'a> {
+    fn cwd(&self) -> &'a AbsolutePathBuf {
+        self.legacy_fallback_cwd
+    }
+    pub(super) fn permission_profile(&self) -> PermissionProfile {
+        self.permission_profile_state.permission_profile().clone()
+    }
+
+    pub(super) fn materialized_permission_profile(
+        &self,
+        environments: &[TurnEnvironmentSelection],
+    ) -> PermissionProfile {
+        let workspace_roots = ThreadEnvironments::primary_workspace_roots_for(environments);
+        self.permission_profile()
+            .materialize_project_roots_with_workspace_roots(&workspace_roots)
+    }
+
+    pub(super) fn effective_permission_profile(
+        &self,
+        environments: &[TurnEnvironmentSelection],
+    ) -> PermissionProfile {
+        ThreadEnvironments::primary_config_for(environments)
+            .map(|config| {
+                config
+                    .permission_profile
+                    .permission_profile()
+                    .clone()
+                    .materialize_project_roots_with_path_uris(&config.workspace_roots)
+            })
+            .unwrap_or_else(|| self.materialized_permission_profile(environments))
+    }
+
+    pub(super) fn active_permission_profile(&self) -> Option<ActivePermissionProfile> {
+        self.permission_profile_state.active_permission_profile()
+    }
+
+    pub(super) fn sandbox_policy(
+        &self,
+        environments: &[TurnEnvironmentSelection],
+    ) -> SandboxPolicy {
+        let permission_profile = self.materialized_permission_profile(environments);
+        codex_sandboxing::compatibility_sandbox_policy_for_permission_profile(
+            &permission_profile,
+            self.cwd(),
+        )
+    }
+
+    pub(super) fn file_system_sandbox_policy(
+        &self,
+        environments: &[TurnEnvironmentSelection],
+    ) -> FileSystemSandboxPolicy {
+        self.materialized_permission_profile(environments)
+            .file_system_sandbox_policy()
+    }
+
+    pub(super) fn network_sandbox_policy(&self) -> NetworkSandboxPolicy {
+        self.permission_profile_state
+            .permission_profile()
+            .network_sandbox_policy()
+    }
+
+    pub(super) fn step_settings_constraints(
+        &self,
+        environments: &[TurnEnvironmentSelection],
+    ) -> StepSettingsConstraints<'a> {
+        let permission_profile = self.effective_permission_profile(environments);
+        StepSettingsConstraints {
+            requirements: self
+                .original_config_do_not_use
+                .config_layer_stack
+                .requirements(),
+            guardian_approval_enabled: self
+                .original_config_do_not_use
+                .features
+                .enabled(Feature::GuardianApproval),
+            trusted_guardian_reviewer: self.trusted_guardian_reviewer,
+            has_full_disk_write_access: permission_profile
+                .file_system_sandbox_policy()
+                .has_full_disk_write_access(),
+        }
+    }
+}
+
+impl ConfiguredSettingsEdit<'_> {
+    fn view(&self) -> ConfiguredSettingsView<'_> {
+        ConfiguredSettingsView {
+            step_settings: &*self.step_settings,
+            permission_profile_state: &*self.permission_profile_state,
+            legacy_fallback_cwd: &*self.legacy_fallback_cwd,
+            original_config_do_not_use: &*self.original_config_do_not_use,
+            trusted_guardian_reviewer: self.trusted_guardian_reviewer,
+        }
+    }
+    fn cwd(&self) -> &AbsolutePathBuf {
+        self.legacy_fallback_cwd
+    }
+    fn set_permission_profile_projection(
+        &mut self,
+        permission_profile: PermissionProfile,
+        active_permission_profile: Option<ActivePermissionProfile>,
+        profile_workspace_roots: Vec<ProfileWorkspaceRoot>,
+        preserve_deny_reads_from: Option<&FileSystemSandboxPolicy>,
+    ) -> ConstraintResult<()> {
+        let enforcement = permission_profile.enforcement();
+        let (mut file_system_sandbox_policy, network_sandbox_policy) =
+            permission_profile.to_runtime_permissions();
+        if let Some(existing_file_system_policy) = preserve_deny_reads_from {
+            file_system_sandbox_policy
+                .preserve_deny_read_restrictions_from(existing_file_system_policy);
+        }
+        let effective_permission_profile =
+            PermissionProfile::from_runtime_permissions_with_enforcement(
+                enforcement,
+                &file_system_sandbox_policy,
+                network_sandbox_policy,
+            );
+
+        let permission_snapshot = match active_permission_profile {
+            Some(active_permission_profile) => {
+                PermissionProfileSnapshot::active_with_profile_workspace_roots(
+                    effective_permission_profile,
+                    active_permission_profile,
+                    profile_workspace_roots,
+                )
+            }
+            None => PermissionProfileSnapshot::legacy(effective_permission_profile),
+        };
+
+        self.permission_profile_state
+            .set_permission_profile_snapshot(permission_snapshot)
+    }
+}
+
+/// Mutates ONLY the caller's uncommitted candidate fields. The ordinary caller
+/// keeps its original full clone/effect order; error discards that candidate.
+/// check_environment_update must precede candidate cloning on owner-checked paths.
+pub(super) fn apply_fields(
+    current: ConfiguredSettingsView<'_>,
+    mut next: ConfiguredSettingsEdit<'_>,
+    updates: &SessionSettingsUpdate,
+    current_environments: &[TurnEnvironmentSelection],
+) -> ConstraintResult<()> {
+    if let Some(disabled_plugin_ids) = &updates.disabled_plugin_ids {
+        *next.disabled_plugin_ids = disabled_plugin_ids.clone();
+    }
+    let current_file_system_sandbox_policy =
+        current.file_system_sandbox_policy(current_environments);
+    let file_system_policy_has_rebindable_project_root_write = current_file_system_sandbox_policy
+        .entries
+        .iter()
+        .any(|entry| {
+            entry.access.can_write()
+                && matches!(
+                    &entry.path,
+                    FileSystemPath::Special {
+                        value: FileSystemSpecialPath::ProjectRoots { subpath: None },
+                    }
+                )
+        });
+    if let Some(windows_sandbox_level) = updates.windows_sandbox_level {
+        *next.windows_sandbox_level = windows_sandbox_level;
+    }
+
+    let current_cwd = current.cwd().clone();
+    if let Some(environments) = &updates.environments {
+        *next.legacy_fallback_cwd = environments.legacy_fallback_cwd.clone();
+        *next.environments = environments.environments.clone();
+    }
+    let cwd_changed = *next.legacy_fallback_cwd != current_cwd;
+    if let Some(runtime_workspace_roots) = &updates.runtime_workspace_roots {
+        *next.runtime_workspace_roots = runtime_workspace_roots.clone();
+    } else if cwd_changed {
+        *next.runtime_workspace_roots = replace_path_and_deduplicate(
+            std::mem::take(&mut *next.runtime_workspace_roots),
+            current_cwd.as_path(),
+            next.legacy_fallback_cwd.clone(),
+        );
+    }
+
+    if let Some(permission_profile) = updates.permission_profile.clone() {
+        let active_permission_profile = updates.active_permission_profile.clone().or_else(|| {
+            if permission_profile == current.permission_profile() {
+                current.active_permission_profile()
+            } else {
+                None
+            }
+        });
+        next.set_permission_profile_projection(
+            permission_profile,
+            active_permission_profile,
+            updates.profile_workspace_roots.clone().unwrap_or_default(),
+            Some(&current_file_system_sandbox_policy),
+        )?;
+        if let Some(active_permission_profile) = next.view().active_permission_profile() {
+            let mut config = (**next.original_config_do_not_use).clone();
+            let permission_profile = next.view().permission_profile();
+            config.permissions.network = config
+                .network_proxy_spec_for_active_permission_profile(
+                    &active_permission_profile,
+                    &permission_profile,
+                )
+                .map_err(|err| ConstraintError::InvalidValue {
+                    field_name: "default_permissions",
+                    candidate: active_permission_profile.id.clone(),
+                    allowed: format!(
+                        "configured permission profile with valid network policy ({err})"
+                    ),
+                    requirement_source: codex_config::RequirementSource::Unknown,
+                })?;
+            config
+                .permissions
+                .set_permission_profile_from_session_snapshot(PermissionProfileSnapshot::active(
+                    permission_profile,
+                    active_permission_profile,
+                ))?;
+            *next.original_config_do_not_use = Arc::new(config);
+        }
+    } else if let Some(sandbox_policy) = updates.sandbox_policy.clone() {
+        let file_system_sandbox_policy =
+            FileSystemSandboxPolicy::from_legacy_sandbox_policy_preserving_deny_entries(
+                &sandbox_policy,
+                next.cwd(),
+                &current_file_system_sandbox_policy,
+            );
+        let network_sandbox_policy = NetworkSandboxPolicy::from(&sandbox_policy);
+        next.permission_profile_state
+            .set_legacy_permission_profile(
+                PermissionProfile::from_runtime_permissions_with_enforcement(
+                    SandboxEnforcement::from_legacy_sandbox_policy(&sandbox_policy),
+                    &file_system_sandbox_policy,
+                    network_sandbox_policy,
+                ),
+            )?;
+    } else if cwd_changed && file_system_policy_has_rebindable_project_root_write {
+        // Compatibility projection can resolve filesystem paths. Only compute it
+        // when a cwd-bound legacy policy might need rebinding.
+        let current_sandbox_policy = current.sandbox_policy(current_environments);
+        if current_file_system_sandbox_policy.is_semantically_equivalent_to(
+            &FileSystemSandboxPolicy::from_legacy_sandbox_policy_preserving_deny_entries(
+                &current_sandbox_policy,
+                current.cwd(),
+                &current_file_system_sandbox_policy,
+            ),
+            current.cwd(),
+        ) {
+            // Preserve richer split policies across cwd-only updates; only
+            // rederive when the session is already using a structurally
+            // cwd-bound legacy bridge.
+            let file_system_sandbox_policy =
+                FileSystemSandboxPolicy::from_legacy_sandbox_policy_preserving_deny_entries(
+                    &current_sandbox_policy,
+                    next.cwd(),
+                    &current_file_system_sandbox_policy,
+                );
+            next.permission_profile_state
+                .set_legacy_permission_profile(
+                    PermissionProfile::from_runtime_permissions_with_enforcement(
+                        SandboxEnforcement::from_legacy_sandbox_policy(&current_sandbox_policy),
+                        &file_system_sandbox_policy,
+                        current.network_sandbox_policy(),
+                    ),
+                )?;
+        }
+    }
+    if let Some(app_server_client_name) = updates.app_server_client_name.clone() {
+        *next.app_server_client_name = Some(app_server_client_name);
+    }
+    if let Some(app_server_client_version) = updates.app_server_client_version.clone() {
+        *next.app_server_client_version = Some(app_server_client_version);
+    }
+    let next_environments = updates
+        .environments
+        .as_ref()
+        .map_or(current_environments, |environments| {
+            environments.environments.as_slice()
+        });
+    super::environment::validate_environment_configs(next_environments)?;
+    // Apply step settings last: the proposed permissions and environment
+    // selections must be complete before deriving their validation constraints.
+    *next.step_settings = Arc::new(current.step_settings.apply(
+        &updates.step_settings,
+        &next.view().step_settings_constraints(next_environments),
+    )?);
+    Ok(())
+}
+
