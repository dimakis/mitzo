+use super::*;
+use crate::config::Constrained;
+use pretty_assertions::assert_eq;
+
+/// Real baseline DATA only; no provider, SessionConfiguration or Session exists.
+#[derive(Clone, Debug, PartialEq)]
+struct FixtureData {
+    config: Arc<Config>,
+    step: Arc<StepSettings>,
+    environments: Vec<TurnEnvironmentSelection>,
+    permission: PermissionProfileState,
+    windows: WindowsSandboxLevel,
+    cwd: AbsolutePathBuf,
+    roots: Vec<AbsolutePathBuf>,
+    name: Option<String>,
+    version: Option<String>,
+    plugins: Vec<String>,
+}
+impl FixtureData {
+    fn view(&self) -> ConfiguredSettingsView<'_> {
+        ConfiguredSettingsView {
+            step_settings: &self.step,
+            permission_profile_state: &self.permission,
+            legacy_fallback_cwd: &self.cwd,
+            original_config_do_not_use: &self.config,
+            trusted_guardian_reviewer: false,
+        }
+    }
+    fn edit(&mut self) -> ConfiguredSettingsEdit<'_> {
+        ConfiguredSettingsEdit {
+            step_settings: &mut self.step,
+            environments: &mut self.environments,
+            permission_profile_state: &mut self.permission,
+            windows_sandbox_level: &mut self.windows,
+            legacy_fallback_cwd: &mut self.cwd,
+            runtime_workspace_roots: &mut self.roots,
+            original_config_do_not_use: &mut self.config,
+            app_server_client_name: &mut self.name,
+            app_server_client_version: &mut self.version,
+            disabled_plugin_ids: &mut self.plugins,
+            trusted_guardian_reviewer: false,
+        }
+    }
+    fn apply(&self, updates: &SessionSettingsUpdate) -> ConstraintResult<Self> {
+        check_environment_update(&self.environments, updates)?;
+        let mut next = self.clone();
+        apply_fields(self.view(), next.edit(), updates, &self.environments)?;
+        Ok(next)
+    }
+}
+async fn fixture() -> anyhow::Result<(tempfile::TempDir, FixtureData)> {
+    fixture_with_auto_review(/*auto_review*/ false).await
+}
+async fn fixture_with_auto_review(
+    auto_review: bool,
+) -> anyhow::Result<(tempfile::TempDir, FixtureData)> {
+    let home = tempfile::tempdir()?;
+    let mut source = "model = 'gpt-6-luna'\nsandbox_mode = 'workspace-write'\n".to_string();
+    if auto_review {
+        source.push_str("\n[features]\nguardian_approval = true\n");
+        std::fs::write(
+            home.path().join("requirements.toml"),
+            "[auto_review]\nrequired_on_models = ['gpt-6-luna']\n",
+        )?;
+    }
+    std::fs::write(home.path().join("config.toml"), source)?;
+    let config = crate::config::ConfigBuilder::default()
+        .codex_home(home.path().to_path_buf())
+        .loader_overrides(
+            codex_config::LoaderOverrides::with_managed_config_path_for_tests(
+                home.path().join("managed.toml"),
+            ),
+        )
+        .fallback_cwd(Some(home.path().to_path_buf()))
+        .build()
+        .await?;
+    let row = codex_models_manager::bundled_models_response()?
+        .models
+        .into_iter()
+        .find(|row| row.slug == "gpt-6-luna")
+        .expect("original exact row");
+    let parts = super::super::configured_settings_data::OriginalConfiguredHistoryData::capture(
+        &config,
+        &row.slug,
+        &InitialHistory::New,
+        Vec::new(),
+        /*disabled_plugin_ids*/ None,
+        /*forked_from_thread_id*/ None,
+    )
+    .resolve_service_tier(&config, config.features.enabled(Feature::FastMode), &row);
+    let step = parts.step.into_settings();
+    let data = FixtureData {
+        permission: session_permission_profile_state_from_config(&config)?,
+        windows: WindowsSandboxLevel::from_config(&config),
+        cwd: config.cwd.clone(),
+        roots: config.workspace_roots.clone(),
+        environments: vec![TurnEnvironmentSelection {
+            environment_id: "owner-provided-data".to_string(),
+            cwd: config.cwd.clone().into(),
+            workspace_roots: vec![config.cwd.clone().into()],
+            config: codex_protocol::protocol::EnvironmentConfigState::Pending,
+        }],
+        config: Arc::new(config),
+        step,
+        name: None,
+        version: None,
+        plugins: parts.disabled_plugin_ids,
+    };
+    Ok((home, data))
+}
+
+#[tokio::test]
+async fn providerless_update_preserves_whole_mutable_data_and_sparse_precedence()
+-> anyhow::Result<()> {
+    let (_home, data) = fixture().await?;
+    let mut mode = data.step.collaboration_mode.clone();
+    mode.mode = ModeKind::Plan;
+    let mut expected = data.clone();
+    expected.plugins = vec!["first".to_string(), "second".to_string()];
+    expected.name = Some("actual-client".to_string());
+    expected.version = Some("v1".to_string());
+    let step = Arc::make_mut(&mut expected.step);
+    step.collaboration_mode = mode.clone();
+    step.service_tier = Some(SERVICE_TIER_DEFAULT_REQUEST_VALUE.to_string());
+    let updates = SessionSettingsUpdate {
+        disabled_plugin_ids: Some(expected.plugins.clone()),
+        app_server_client_name: expected.name.clone(),
+        app_server_client_version: expected.version.clone(),
+        step_settings: super::super::step_settings::StepSettingsUpdate {
+            collaboration_mode: Some(mode),
+            effort: Some(Some(ReasoningEffortConfig::High)),
+            service_tier: Some(None),
+            ..Default::default()
+        },
+        service_tier_for_turn: Some("priority".to_string()),
+        ..Default::default()
+    };
+    assert_eq!(data.apply(&updates)?, expected);
+    assert_eq!(data.apply(&SessionSettingsUpdate::default())?, data);
+    Ok(())
+}
+
+#[tokio::test]
+async fn providerless_environment_guard_and_permission_errors_precede_step_edits()
+-> anyhow::Result<()> {
+    let (_home, mut data) = fixture().await?;
+    let mut proposed = data.environments.clone();
+    proposed[0].config = codex_protocol::protocol::EnvironmentConfigState::FromThread;
+    let guard_error = super::super::environment::ensure_configs_stay_owner_provided(
+        &data.environments,
+        &proposed,
+    )
+    .unwrap_err();
+    let updates = SessionSettingsUpdate {
+        environments: Some(codex_protocol::protocol::TurnEnvironmentSelections::new(
+            data.cwd.clone(),
+            proposed,
+        )),
+        ..Default::default()
+    };
+    let before = data.clone();
+    assert_eq!(data.apply(&updates).err(), Some(guard_error));
+    assert_eq!(data, before);
+    let permission = Constrained::allow_only(PermissionProfile::read_only());
+    let permission_error = permission
+        .can_set(&PermissionProfile::Disabled)
+        .unwrap_err();
+    data.permission = PermissionProfileState::from_constrained_legacy(permission)?;
+    Arc::make_mut(&mut data.step).approval_policy =
+        Constrained::allow_only(AskForApproval::OnRequest);
+    let step_error = data
+        .step
+        .approval_policy
+        .can_set(&AskForApproval::Never)
+        .unwrap_err();
+    let updates = SessionSettingsUpdate {
+        permission_profile: Some(PermissionProfile::Disabled),
+        step_settings: super::super::step_settings::StepSettingsUpdate {
+            approval_policy: Some(AskForApproval::Never),
+            ..Default::default()
+        },
+        ..Default::default()
+    };
+    let before = data.clone();
+    assert_eq!(data.apply(&updates).err(), Some(permission_error));
+    assert_eq!(data, before);
+    assert_eq!(
+        data.apply(&SessionSettingsUpdate {
+            permission_profile: None,
+            ..updates
+        })
+        .err(),
+        Some(step_error)
+    );
+    Ok(())
+}
+
+#[tokio::test]
+async fn providerless_permission_environment_and_roots_are_resolved_before_final_step()
+-> anyhow::Result<()> {
+    let (home, data) = fixture().await?;
+    let cwd = AbsolutePathBuf::try_from(home.path().join("selected-cwd"))?;
+    let mut environments = data.environments.clone();
+    environments[0].cwd = cwd.clone().into();
+    environments[0].workspace_roots = vec![cwd.clone().into()];
+    let mut expected = data.clone();
+    expected.cwd = cwd.clone();
+    expected.roots = vec![cwd.clone()];
+    expected.environments = environments.clone();
+    let profile = PermissionProfile::read_only();
+    let (mut fs, network) = profile.to_runtime_permissions();
+    fs.preserve_deny_read_restrictions_from(
+        &data.view().file_system_sandbox_policy(&data.environments),
+    );
+    expected.permission.set_legacy_permission_profile(
+        PermissionProfile::from_runtime_permissions_with_enforcement(
+            profile.enforcement(),
+            &fs,
+            network,
+        ),
+    )?;
+    let updates = SessionSettingsUpdate {
+        environments: Some(codex_protocol::protocol::TurnEnvironmentSelections::new(
+            cwd.clone(),
+            environments,
+        )),
+        runtime_workspace_roots: Some(vec![cwd]),
+        permission_profile: Some(profile),
+        ..Default::default()
+    };
+    assert_eq!(data.apply(&updates)?, expected);
+
+    // Actual requirements/feature source and native primary attachment DATA;
+    // no Session, provider, fabricated model row or attachment activation.
+    let (_review_home, mut restricted) = fixture_with_auto_review(/*auto_review*/ true).await?;
+    assert!(
+        restricted
+            .config
+            .features
+            .enabled(Feature::GuardianApproval)
+    );
+    assert!(
+        restricted
+            .config
+            .config_layer_stack
+            .requirements()
+            .auto_review_required_for_model("gpt-6-luna")
+    );
+    restricted.environments[0].config = codex_protocol::protocol::EnvironmentConfigState::Ready(
+        codex_protocol::protocol::EnvironmentConfig {
+            allow_login_shell: restricted.config.permissions.allow_login_shell,
+            workspace_roots: restricted.environments[0].workspace_roots.clone(),
+            permission_profile: PermissionProfileSnapshot::legacy(PermissionProfile::read_only()),
+            shell_environment_policy: restricted
+                .config
+                .permissions
+                .shell_environment_policy
+                .clone(),
+            windows_sandbox_level: restricted.windows,
+            windows_sandbox_type: restricted.config.effective_local_windows_sandbox_type(),
+            use_legacy_landlock: restricted.config.features.use_legacy_landlock(),
+            exec_policy: None,
+            mcp_policy: None,
+            network_policy: None,
+            selected_capability_roots: Vec::new(),
+        },
+    );
+    let step_edit = SessionSettingsUpdate {
+        step_settings: super::super::step_settings::StepSettingsUpdate {
+            approvals_reviewer: Some(ApprovalsReviewer::AutoReview),
+            ..Default::default()
+        },
+        ..Default::default()
+    };
+    let mut reviewed = restricted.clone();
+    Arc::make_mut(&mut reviewed.step).approvals_reviewer = ApprovalsReviewer::AutoReview;
+    assert_eq!(restricted.apply(&step_edit)?, reviewed);
+    let mut full_environments = restricted.environments.clone();
+    let codex_protocol::protocol::EnvironmentConfigState::Ready(full) =
+        &mut full_environments[0].config
+    else {
+        unreachable!("typed fixture")
+    };
+    full.permission_profile = PermissionProfileSnapshot::legacy(PermissionProfile::Disabled);
+    let before = restricted.clone();
+    let full_update = SessionSettingsUpdate {
+        environments: Some(codex_protocol::protocol::TurnEnvironmentSelections::new(
+            restricted.cwd.clone(),
+            full_environments.clone(),
+        )),
+        ..step_edit.clone()
+    };
+    assert_eq!(
+        restricted.apply(&full_update).err(),
+        Some(ConstraintError::AutoReviewRequired {
+            model: "gpt-6-luna".to_string()
+        })
+    );
+    assert_eq!(restricted, before);
+    let mut full_baseline = restricted.clone();
+    full_baseline.environments = full_environments;
+    let restricted_update = SessionSettingsUpdate {
+        environments: Some(codex_protocol::protocol::TurnEnvironmentSelections::new(
+            restricted.cwd.clone(),
+            restricted.environments.clone(),
+        )),
+        ..step_edit
+    };
+    assert_eq!(full_baseline.apply(&restricted_update)?, reviewed);
+    Ok(())
+}
