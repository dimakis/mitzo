+//! Captures an issuing task before approval waits. These snapshots are not child admission.
+use super::session::Session;
+use super::step_context::StepContext;
+use super::step_settings::ResolvedStepSettings;
+use super::turn_context::TurnContext;
+use crate::environment_selection::TurnEnvironmentSnapshot;
+use codex_protocol::config_types::ApprovalsReviewer;
+use codex_protocol::protocol::AskForApproval;
+use std::sync::Arc;
+use std::sync::Weak;
+use tokio::sync::Notify;
+use tokio_util::sync::CancellationToken;
+
+pub(crate) struct InitialExecApprovalIssuer {
+    session: Weak<Session>,
+    task_done: Arc<Notify>,
+    turn: Arc<TurnContext>,
+    settings: Arc<ResolvedStepSettings>,
+    task_cancellation: CancellationToken,
+    call_cancellation: CancellationToken,
+    environments: TurnEnvironmentSnapshot,
+}
+
+impl Session {
+    #[expect(
+        clippy::await_holding_invalid_type,
+        reason = "capture task/settings and strict state together"
+    )]
+    pub(crate) async fn capture_initial_exec_approval_issuer(
+        self: &Arc<Self>,
+        step: &StepContext,
+        cancellation: &CancellationToken,
+    ) -> Option<InitialExecApprovalIssuer> {
+        let active = self.active_turn.lock().await;
+        let active = active.as_ref()?;
+        let task = active.task.as_ref()?;
+        let state = active.turn_state.lock().await;
+        let settings = task.turn_context.next_step_settings.load_full();
+        if !Arc::ptr_eq(&task.turn_context, &step.turn)
+            || !Arc::ptr_eq(&settings, &step.settings)
+            || settings.approval_policy() != AskForApproval::OnRequest
+            || settings.approvals_reviewer() != ApprovalsReviewer::User
+            || state.strict_auto_review_enabled()
+            || task.cancellation_token.is_cancelled()
+            || cancellation.is_cancelled()
+        {
+            return None;
+        }
+        Some(InitialExecApprovalIssuer {
+            session: Arc::downgrade(self),
+            task_done: Arc::clone(&task.done),
+            turn: Arc::clone(&task.turn_context),
+            settings,
+            task_cancellation: task.cancellation_token.clone(),
+            call_cancellation: cancellation.clone(),
+            environments: step.environments.clone(),
+        })
+    }
+
+    /// Conservative post-response snapshot; never recapture a replacement issuer.
+    #[expect(
+        clippy::await_holding_invalid_type,
+        reason = "compare retained issuer under the existing owner locks"
+    )]
+    pub(crate) async fn initial_exec_approval_issuer_is_current(
+        self: &Arc<Self>,
+        issuer: &InitialExecApprovalIssuer,
+    ) -> bool {
+        if !issuer
+            .session
+            .upgrade()
+            .is_some_and(|session| Arc::ptr_eq(&session, self))
+        {
+            return false;
+        }
+        let active = self.active_turn.lock().await;
+        let Some(active) = active.as_ref() else {
+            return false;
+        };
+        let Some(task) = active.task.as_ref() else {
+            return false;
+        };
+        let state = active.turn_state.lock().await;
+        Arc::ptr_eq(&task.done, &issuer.task_done)
+            && Arc::ptr_eq(&task.turn_context, &issuer.turn)
+            && Arc::ptr_eq(
+                &task.turn_context.next_step_settings.load_full(),
+                &issuer.settings,
+            )
+            && !state.strict_auto_review_enabled()
+            && !task.cancellation_token.is_cancelled()
+            && !issuer.task_cancellation.is_cancelled()
+            && !issuer.call_cancellation.is_cancelled()
+    }
+}
+
+#[cfg(all(test, unix))]
+#[path = "../tools/approvals/parent_approval_tests.rs"]
+mod tests;
