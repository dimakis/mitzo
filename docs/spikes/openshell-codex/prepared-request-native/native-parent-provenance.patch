@@ -0,0 +1,34 @@
+//! Sealed evidence of one actual fresh user approval, not permission to run a child.
+use super::ApprovalAction;
+use super::ApprovalResolutionSource;
+use crate::session::InitialExecApprovalIssuer;
+use codex_protocol::protocol::ReviewDecision;
+
+pub(crate) struct InitialExecApproval {
+    pub(crate) decision: ReviewDecision,
+    pub(crate) parent_approval: Option<FreshParentApproval>,
+}
+
+pub(crate) struct FreshParentApproval {
+    issuer: InitialExecApprovalIssuer,
+    action: ApprovalAction,
+}
+
+impl FreshParentApproval {
+    // Only the actual approval-resolution owner can construct this evidence.
+    pub(super) fn from_resolution(
+        issuer: InitialExecApprovalIssuer,
+        action: ApprovalAction,
+        decision: &ReviewDecision,
+        source: ApprovalResolutionSource,
+    ) -> Option<Self> {
+        if matches!(&action, ApprovalAction::ExecCommand { .. })
+            && *decision == ReviewDecision::Approved
+            && source == ApprovalResolutionSource::User
+        {
+            Some(Self { issuer, action })
+        } else {
+            None
+        }
+    }
+}
