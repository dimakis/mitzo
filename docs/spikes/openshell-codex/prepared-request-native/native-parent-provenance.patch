+#[test]
+fn initial_exec_guard_closes_the_same_retained_flag() {
+    let active = Arc::new(AtomicBool::new(true));
+    let guard = InitialExecCommandGuard {
+        active: Some(Arc::clone(&active)),
+        metrics_sidecar: None,
+    };
+    assert!(active.load(Ordering::Acquire));
+    drop(guard);
+    assert!(!active.load(Ordering::Acquire));
+}
+
+#[tokio::test]
+async fn cancelling_initial_exec_future_drops_its_guard() {
+    let active = Arc::new(AtomicBool::new(true));
+    let guard = InitialExecCommandGuard {
+        active: Some(Arc::clone(&active)),
+        metrics_sidecar: None,
+    };
+    let (started, observed) = tokio::sync::oneshot::channel();
+    let task = tokio::spawn(async move {
+        let _guard = guard;
+        let _ = started.send(());
+        std::future::pending::<()>().await;
+    });
+    observed.await.expect("initial future started");
+    assert!(active.load(Ordering::Acquire));
+    task.abort();
+    assert!(task.await.expect_err("task cancelled").is_cancelled());
+    assert!(!active.load(Ordering::Acquire));
+}
