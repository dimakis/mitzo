+#[tokio::test]
+async fn hook_plain_approved_is_not_a_user_receipt() -> anyhow::Result<()> {
+    let fixture = Fixture::new(None).await?;
+    let home = &fixture.step.turn.config.codex_home;
+    std::fs::create_dir_all(home)?;
+    std::fs::write(home.join("hooks.json"), serde_json::json!({"hooks":{"PermissionRequest":[{"hooks":[{
+        "type":"command", "command":"cat >/dev/null; printf '%s\\n' '{\"hookSpecificOutput\":{\"hookEventName\":\"PermissionRequest\",\"decision\":{\"behavior\":\"allow\"}}}'"
+    }]}]}}).to_string())?;
+    let hook_list = codex_hooks::list_hooks(codex_hooks::HooksConfig {
