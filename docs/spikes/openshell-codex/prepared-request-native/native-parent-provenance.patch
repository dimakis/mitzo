+++ b/codex-rs/core/src/tools/approvals/parent_approval_tests.rs
@@ -0,0 +1,368 @@
+//! Real pending-approval responses establish provenance; tests never construct a grant.
+use super::*;
+use crate::guardian::GuardianReviewContext;
+use crate::session::tests::make_session_and_context_with_auth_and_config_and_rx;
+use crate::tasks::SessionTask;
+use crate::tasks::SessionTaskResult;
+use crate::tools::ApprovalContext;
+use crate::tools::sandboxing::ApprovalAction;
+use crate::tools::sandboxing::InitialExecApproval;
+use codex_extension_api::ApprovalDecision;
+use codex_extension_api::ApprovalReviewContributor;
+use codex_protocol::models::PermissionProfile;
+use codex_protocol::models::SandboxPermissions;
+use codex_protocol::protocol::Event;
+use codex_protocol::protocol::EventMsg;
+use codex_protocol::protocol::ReviewDecision;
+use codex_protocol::protocol::TurnAbortReason;
+use codex_protocol::protocol::TurnSettingsUpdate;
+use codex_protocol::protocol::TurnSettingsUpdateOutcome;
+use codex_tools::ToolName;
+use pretty_assertions::assert_eq;
+use std::sync::atomic::AtomicUsize;
+use std::sync::atomic::Ordering;
+
+struct PendingTask;
+impl SessionTask for PendingTask {
+    fn kind(&self) -> crate::state::TaskKind {
+        crate::state::TaskKind::Regular
+    }
+    fn span_name(&self) -> &'static str {
+        "parent_approval_test"
+    }
+    async fn run(
+        self: Arc<Self>,
+        _session: Arc<Session>,
+        _turn: Arc<TurnContext>,
+        _input: Vec<crate::session::TurnInput>,
+        cancellation: CancellationToken,
+    ) -> SessionTaskResult {
+        cancellation.cancelled().await;
+        Ok(None)
+    }
+}
+
+struct Contributor {
+    decision: Option<ApprovalDecision>,
+    calls: Arc<AtomicUsize>,
+}
+impl ApprovalReviewContributor for Contributor {
+    fn decide<'a>(
+        &'a self,
+        _input: &'a codex_extension_api::ApprovalDecisionInput<'_>,
+    ) -> codex_extension_api::ExtensionFuture<'a, Option<ApprovalDecision>> {
+        Box::pin(async move {
+            self.calls.fetch_add(1, Ordering::SeqCst);
+            self.decision.clone()
+        })
+    }
+}
+
+enum Drift {
+    None,
+    Settings,
+    Task,
+    Strict,
+    Cancel,
+}
+struct Fixture {
+    session: Arc<Session>,
+    step: Arc<StepContext>,
+    events: async_channel::Receiver<Event>,
+    calls: Arc<AtomicUsize>,
+}
+impl Fixture {
+    async fn new(decision: Option<ApprovalDecision>) -> anyhow::Result<Self> {
+        let (mut session, turn, events) = make_session_and_context_with_auth_and_config_and_rx(
+            codex_login::CodexAuth::from_api_key("offline-test"),
+            Vec::new(),
+            |config| {
+                config.permissions.approval_policy =
+                    codex_config::Constrained::allow_any(AskForApproval::OnRequest);
+                config.approvals_reviewer = ApprovalsReviewer::User;
+                config
+                    .permissions
+                    .set_permission_profile(PermissionProfile::read_only())
+                    .expect("test permissions");
+            },
+        )
+        .await;
+        let calls = Arc::new(AtomicUsize::new(0));
+        let mut registry = codex_extension_api::ExtensionRegistryBuilder::new();
+        registry.approval_review_contributor(Arc::new(Contributor {
+            decision,
+            calls: Arc::clone(&calls),
+        }));
+        Arc::get_mut(&mut session)
+            .ok_or_else(|| anyhow::anyhow!("unshared session"))?
+            .services
+            .extensions = Arc::new(registry.build());
+        let mut step = StepContext::for_test(Arc::clone(&turn));
+        // The generic unit helper clones settings; this fixture uses the actual selected version.
+        Arc::get_mut(&mut step)
+            .ok_or_else(|| anyhow::anyhow!("unshared step"))?
+            .settings = turn.next_step_settings.load_full();
+        session.start_task(turn, Vec::new(), PendingTask).await;
+        Ok(Self {
+            session,
+            step,
+            events,
+            calls,
+        })
+    }
+    fn action(&self, call: &str) -> ApprovalAction {
+        ApprovalAction::ExecCommand {
+            id: call.into(),
+            environment_id: codex_exec_server::LOCAL_ENVIRONMENT_ID.into(),
+            command: vec!["offline-command".into()],
+            hook_command: "offline-command".into(),
+            cwd: self
+                .step
+                .environments
+                .primary()
+                .expect("local environment")
+                .cwd()
+                .clone(),
+            sandbox_permissions: SandboxPermissions::RequireEscalated,
+            additional_permissions: None,
+            justification: None,
+            tty: false,
+            proposed_execpolicy_amendment: None,
+        }
+    }
+    fn context(&self, call: &str) -> ApprovalContext {
+        ApprovalContext {
+            review_context: GuardianReviewContext::from(&self.step),
+            cancellation_token: Some(CancellationToken::new()),
+            call_id: call.into(),
+            tool_name: ToolName::plain("exec_command"),
+            strict_auto_review: false,
+            approval_reason: None,
+            retry_reason: None,
+            network_approval_context: None,
+        }
+    }
+    async fn approve(
+        &self,
+        call: &str,
+        decision: ReviewDecision,
+        drift: Drift,
+    ) -> anyhow::Result<InitialExecApproval> {
+        let ctx = self.context(call);
+        let cancel = ctx.cancellation_token.clone().expect("call cancellation");
+        let approval =
+            self.session
+                .request_initial_exec_approval(self.action(call), ctx, &self.step);
+        tokio::pin!(approval);
+        tokio::time::timeout(std::time::Duration::from_secs(5), async {
+            loop {
+                tokio::select! {
+                    result = &mut approval => panic!("expected real pending user approval, completed: {}", result.is_ok()),
+                    event = self.events.recv() => {
+                        if let EventMsg::ExecApprovalRequest(request) = event?.msg {
+                            self.session.notify_approval(&request.call_id, decision.clone()).await;
+                            match drift {
+                                Drift::None => {},
+                                Drift::Settings => assert!(matches!(self.session.apply_turn_settings(&self.step.turn.sub_id,
+                                    TurnSettingsUpdate { approvals_reviewer: Some(ApprovalsReviewer::User), ..Default::default() }).await,
+                                    TurnSettingsUpdateOutcome::Applied)),
+                                Drift::Task => {
+                                    self.session.abort_all_tasks(TurnAbortReason::Replaced).await;
+                                    self.session.start_task(Arc::clone(&self.step.turn), Vec::new(), PendingTask).await;
+                                },
+                                Drift::Strict => {
+                                    let state = Arc::clone(&self.session.active_turn.lock().await.as_ref().expect("active").turn_state);
+                                    state.lock().await.enable_strict_auto_review();
+                                },
+                                Drift::Cancel => cancel.cancel(),
+                            }
+                            return approval.await.map_err(|err| anyhow::anyhow!("approval failed: {err:?}"));
+                        }
+                    }
+                }
+            }
+        }).await?
+    }
+}
+
+#[tokio::test]
+async fn only_fresh_user_plain_approval_produces_initial_provenance() -> anyhow::Result<()> {
+    let fixture = Fixture::new(None).await?;
+    let result = fixture
+        .approve("fresh", ReviewDecision::Approved, Drift::None)
+        .await?;
+    assert_eq!(result.decision, ReviewDecision::Approved);
+    assert!(result.parent_approval.is_some());
+    let result = fixture
+        .approve("remember", ReviewDecision::ApprovedForSession, Drift::None)
+        .await?;
+    assert_eq!(result.decision, ReviewDecision::ApprovedForSession);
+    assert!(result.parent_approval.is_none());
+    let result = fixture
+        .session
+        .request_initial_exec_approval(
+            fixture.action("cached"),
+            fixture.context("cached"),
+            &fixture.step,
+        )
+        .await
+        .map_err(|err| anyhow::anyhow!("cached approval: {err:?}"))?;
+    assert_eq!(result.decision, ReviewDecision::ApprovedForSession);
+    assert!(result.parent_approval.is_none());
+    assert_eq!(fixture.calls.load(Ordering::SeqCst), 3);
+    assert!(
+        !std::iter::from_fn(|| fixture.events.try_recv().ok())
+            .any(|event| matches!(event.msg, EventMsg::ExecApprovalRequest(_)))
+    );
+    fixture
+        .session
+        .abort_all_tasks(TurnAbortReason::Interrupted)
+        .await;
+    Ok(())
+}
+
+#[tokio::test]
+async fn issuer_changes_after_user_response_never_relabel_approval() -> anyhow::Result<()> {
+    for drift in [Drift::Settings, Drift::Task, Drift::Strict, Drift::Cancel] {
