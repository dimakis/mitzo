+#[tokio::test]
+async fn installed_first_step_context_retains_command_model_and_rejects_baseline_observation() {
+    for reply in [false, true] {
+        let home = tempfile::tempdir().unwrap();
+        let configs = manager(home.path());
+        let source = configs
+            .load_selected_start_config(
+                None,
+                ConfigOverrides {
+                    cwd: Some(home.path().to_path_buf()),
+                    model: Some("gpt-6-luna".into()),
+                    personality: Some(codex_protocol::config_types::Personality::Pragmatic),
+                    ..Default::default()
+                },
+            )
+            .await
+            .unwrap();
+        let config = source.config().clone();
+        assert!(config.features.enabled(Feature::Apps));
+        assert!(config.features.enabled(Feature::Plugins));
+        let store = Arc::new(InMemoryThreadStore::default());
+        let mut catalog = None;
+        let (threads, installed, _) =
+            thread_manager_with_models(&config, Arc::clone(&store), |auth| {
+                let models: codex_models_manager::manager::SharedModelsManager = Arc::new(
+                    codex_models_manager::manager::OpenAiModelsManager::new_without_cache(
+                        Arc::new(NoStartupEndpoint),
+                        Some(Arc::clone(auth)),
+                    ),
+                );
+                catalog = Some(Arc::clone(&models));
+                models
+            });
+        let original = OriginalFirstCommandStart::new(
+            StartThreadOptions::new(config),
+            threads.reserve_thread_start(),
+            installed,
+            crate::request_processors::AppServerClientInfo::capture(None, None),
+        );
+        let mut selected = source
+            .capture_first_command(&threads, original)
+            .await
+            .unwrap();
+        selected.capture_startup(&threads).await.unwrap();
+        selected.capture_startup_api_mcp(&threads).unwrap();
+        let value = if reply {
+            serde_json::json!({"input":[],"toolOutput":{"name":"actual-reply","namespace":null,"output":"reply bytes"},"personality":"friendly"})
+        } else {
+            serde_json::json!({"input":[],"personality":"friendly"})
+        };
+        let body = serde_json::from_value(value).unwrap();
+        selected
+            .capture_command(&threads, "first-context".into(), body, None)
+            .await
+            .unwrap();
+        if reply {
+            assert!(selected.capture_first_step_context(&threads).await.is_err());
+            assert!(selected.first_step_context.is_none());
+        } else {
+            let expected_instructions;
+            {
+                let sources = selected.start().mcp_sources().unwrap();
+                let baseline = threads
+                    .observe_pre_session_skills(sources, &[])
+                    .await
+                    .unwrap();
+                let actual = threads
+                    .observe_selected_start_skills(selected.start())
+                    .await
+                    .unwrap();
+                let mut config = sources.start_options().config.to_models_manager_config();
+                config.personality = Some(codex_protocol::config_types::Personality::Friendly);
+                let expected = catalog
+                    .as_ref()
+                    .unwrap()
+                    .get_model_info("gpt-6-luna", &config)
+                    .await;
+                assert_eq!(actual.skills().model(), &expected);
+                assert!(sources.start_options().config.base_instructions.is_none());
+                assert!(sources.start_options().config.model_catalog.is_none());
+                let rendered = codex_prompts::render_model_instructions(&expected);
+                expected_instructions = if sources.start_options().config.update_plan_enabled {
+                    rendered
+                } else {
+                    codex_prompts::without_update_plan_instructions(&rendered)
+                };
+                let clock = threads.observe_pre_session_system_clock(sources).unwrap();
+                assert!(
+                    threads
+                        .observe_pre_session_builtin_context(selected.start(), &baseline, &clock)
+                        .await
+                        .is_err()
+                );
+            }
+            selected.capture_first_step_context(&threads).await.unwrap();
+            let partial = selected.first_step_context.as_ref().unwrap();
+            assert_eq!(partial.model_instructions(), expected_instructions);
+            let (foreign, _, _) = thread_manager(
+                &selected.start().start_options().unwrap().config,
+                Arc::new(InMemoryThreadStore::default()),
+            );
+            assert!(
+                foreign
+                    .validate_selected_builtin_context(selected.start(), partial)
+                    .is_err()
+            );
+            assert!(partial.unresolved_partitions().contains(
+                &codex_core::UnresolvedInitialContextPartition::PermissionsAndEnvironmentSnapshot
+            ));
+            assert!(partial.unresolved_partitions().contains(
+                &codex_core::UnresolvedInitialContextPartition::OriginalFreshHistoryAndAgentState
+            ));
+            selected.renew(&threads).await.unwrap();
+            assert!(selected.capture_first_step_context(&threads).await.is_err());
+        }
+        assert!(selected.renew(&threads).await.is_err());
+        assert!(selected.adopt_startup(&threads).await.is_err());
+        assert!(threads.list_thread_ids().await.is_empty());
+        assert_eq!(
+            store.calls().await,
+            codex_thread_store::InMemoryThreadStoreCalls::default()
+        );
+    }
+}
