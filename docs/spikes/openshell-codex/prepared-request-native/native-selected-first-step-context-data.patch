+#[tokio::test]
+async fn first_step_context_uses_same_command_model_and_refuses_lossy_reply_or_root_substitution()
+-> anyhow::Result<()> {
+    let (_home, mut options, auth, models, _) = super::super::tests::fixture().await?;
+    options.config.features.enable(Feature::GuardianApproval);
+    options.config.personality = Some(codex_protocol::config_types::Personality::Pragmatic);
+    let startup =
+        OriginalStartupSelection::capture(&options, &SessionSource::Exec, None, &auth, &models)
+            .await?;
+    let mut candidate = startup.settings_candidate(ThreadSettingsOverrides {
+        personality: Some(codex_protocol::config_types::Personality::Friendly),
+        ..Default::default()
+    })?;
+    assert!(candidate.first_step_context_inputs(&startup)?.is_none());
+    let input = vec![codex_protocol::user_input::UserInput::Text {
+        text: "$actual-command".into(),
+        text_elements: Vec::new(),
+    }];
+    candidate.pair_command(
+        "context".into(),
+        codex_protocol::turn_input::TurnInputRequest::user_input(input.clone()),
+        None,
+        None,
+        None,
+    )?;
+    candidate.capture_first_step_model(&startup).await?;
+    let (row, actual_row, retained_input) = candidate
+        .first_step_context_inputs(&startup)?
+        .expect("captured first-step model");
+    assert!(Arc::ptr_eq(
+        row,
+        &candidate.first_step_model.as_ref().unwrap().candidate
+    ));
+    assert_eq!(
+        row.model_info(),
+        candidate
+            .first_step_model
+            .as_ref()
+            .unwrap()
+            .data
+            .model_info()
+    );
+    assert!(std::ptr::eq(
+        actual_row,
+        candidate
+            .first_step_model
+            .as_ref()
+            .unwrap()
+            .data
+            .model_info()
+    ));
+    assert_eq!(retained_input, input.as_slice());
+    let original = candidate.command.as_ref().unwrap().request.input.clone();
+    let mut plugins = startup.settings_candidate(ThreadSettingsOverrides {
+        disabled_plugin_ids: Some(Vec::new()),
+        ..Default::default()
+    })?;
+    plugins.pair_command(
+        "plugins".into(),
+        codex_protocol::turn_input::TurnInputRequest::user_input(input.clone()),
+        None,
+        None,
+        None,
+    )?;
+    plugins.capture_first_step_model(&startup).await?;
+    assert!(plugins.validate(&startup).is_ok());
+    assert!(plugins.first_step_context_inputs(&startup).is_err());
+    assert_eq!(plugins.command.as_ref().unwrap().request.input, original);
+    let reply = serde_json::from_value(
+        serde_json::json!({"type":"function_call_output","call_id":"actual-reply","output":"retained reply"}),
+    )?;
+    let mut reply_candidate = startup.settings_candidate_without_overrides()?;
+    let request = codex_protocol::turn_input::TurnInputRequest::new(
+        codex_protocol::turn_input::TurnInput::ResponseItem(reply),
+    );
+    let original = request.input.clone();
+    reply_candidate.pair_command("reply".into(), request, None, None, None)?;
+    reply_candidate.capture_first_step_model(&startup).await?;
+    assert!(reply_candidate.first_step_context_inputs(&startup).is_err());
+    assert_eq!(
+        reply_candidate.command.as_ref().unwrap().request.input,
+        original
+    );
+    let step = Arc::clone(&candidate.data.step);
+    candidate.data.step = Arc::new((*step).clone());
+    assert!(candidate.first_step_context_inputs(&startup).is_err());
+    candidate.data.step = step;
+    assert!(candidate.capture_first_step_model(&startup).await.is_err());
+    assert!(candidate.first_step_context_inputs(&startup).is_err());
+    Ok(())
+}
