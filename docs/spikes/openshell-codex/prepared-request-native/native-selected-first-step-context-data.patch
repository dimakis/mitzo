+    let input = vec![UserInput::Text {
+        text: "ordinary input".into(),
+        text_elements: Vec::new(),
+    }];
+    let baseline = manager
+        .observe_pre_session_skills(&sources, &input)
+        .await
+        .unwrap();
+    let retained = manager
+        .observe_pre_session_skills_with_model(
+            &sources,
+            &input,
+            Some((
+                Arc::clone(baseline.model_candidate_arc()),
+                baseline.skills().model(),
+            )),
+        )
+        .await
+        .unwrap();
+    assert!(Arc::ptr_eq(
+        baseline.model_candidate_arc(),
+        retained.model_candidate_arc()
+    ));
+    assert_eq!(retained.skills().model(), baseline.skills().model());
+    assert_eq!(
+        retained.skills().user_input(),
+        baseline.skills().user_input()
+    );
+    assert_eq!(
+        retained.skills().initial_world_state(),
+        baseline.skills().initial_world_state()
+    );
+    assert_eq!(
+        retained.skills().host_items(),
+        baseline.skills().host_items()
+    );
+    assert!(manager.state.threads.read().await.is_empty());
+}
