+#[tokio::test]
+async fn cancelled_review_retains_actual_snapshot_without_default_user_route() -> anyhow::Result<()>
+{
+    let entered = Arc::new(Notify::new());
+    let release = Arc::new(Notify::new());
+    let fixture = Fixture::new(
+        None,
+        Some((Arc::clone(&entered), Arc::clone(&release))),
+        /*panic*/ false,
+    )
+    .await?;
+    let _release_on_drop = ReleaseOnDrop(Arc::clone(&release));
+    let config = fixture.session.get_config().await;
+    let cancellation = CancellationToken::new();
+    let ctx = fixture.context(Some(cancellation.clone()));
+    let review = fixture.typed(&ctx);
+    tokio::pin!(review);
+    tokio::time::timeout(Duration::from_secs(5), async { tokio::select! { _ = entered.notified() => {}, _ = &mut review => panic!("review ended before gate") } }).await?;
+    cancellation.cancel();
+    let (_, history_reset) = fixture.session.history_reset().await;
+    history_reset.cancel();
+    release.notify_one();
+    let result = tokio::time::timeout(Duration::from_secs(5), review).await?;
+    assert_eq!(
+        result.disposition(),
+        &ReviewDisposition::Decision(ReviewDecision::Abort)
+    );
+    assert!(Arc::ptr_eq(
+        result.used_config().expect("actual snapshot"),
+        &config
+    ));
+    assert_eq!(fixture.calls.load(Ordering::SeqCst), 1);
+    Ok(())
+}
