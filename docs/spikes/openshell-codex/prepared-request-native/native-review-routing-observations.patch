+#[tokio::test]
+async fn typed_and_legacy_routes_execute_each_actual_contributor_once() -> anyhow::Result<()> {
+    for cancellation in [None, Some(CancellationToken::new())] {
+        for (decision, expected) in [
+            (
+                None,
+                ReviewDisposition::UserPrompt(UserPromptDisposition::NoContributorDefaultUser {
+                    fresh_review_required: false,
+                }),
+            ),
+            (
+                Some(ApprovalDecision::AskUser),
+                ReviewDisposition::UserPrompt(UserPromptDisposition::ContributorAskUser),
+            ),
+            (
+                Some(ApprovalDecision::Reviewed(ReviewDecision::Approved)),
+                ReviewDisposition::Decision(ReviewDecision::Approved),
+            ),
+        ] {
+            let fixture = Fixture::new(decision, /*gate*/ None, /*panic*/ false).await?;
+            let ctx = fixture.context(cancellation.clone());
+            let config = fixture.session.get_config().await;
+            let typed = fixture.typed(&ctx).await;
+            assert_eq!(typed.disposition(), &expected);
+            assert!(Arc::ptr_eq(
+                typed.used_config().expect("actual selected config"),
+                &config
+            ));
+            assert_eq!(fixture.calls.load(Ordering::SeqCst), 1);
+            let legacy = fixture
+                .session
+                .request_guardian_approval(fixture.action(), &ctx)
+                .await;
+            assert_eq!(legacy, expected.into_legacy_decision());
+            assert_eq!(fixture.calls.load(Ordering::SeqCst), 2);
+        }
+    }
+    Ok(())
+}
