+//! Actual review and trusted hook owners produce observations; no grants are constructed.
+use super::*;
+use crate::guardian::ReviewRoutingResult;
+use crate::hook_runtime::run_permission_request_hooks_with_metadata;
+use crate::session::step_context::StepContext;
+use crate::session::tests::make_session_and_context_with_auth_and_config_and_rx;
+use codex_extension_api::ApprovalDecision;
+use codex_extension_api::ApprovalReviewContributor;
+use codex_guardian_reviewer::ReviewDisposition;
+use codex_guardian_reviewer::UserPromptDisposition;
+use codex_protocol::models::PermissionProfile;
+use codex_protocol::protocol::Event;
+use pretty_assertions::assert_eq;
+use std::sync::atomic::AtomicUsize;
+use std::sync::atomic::Ordering;
+use tokio::sync::Notify;
+use tokio::time::Duration;
+
+struct ReleaseOnDrop(Arc<Notify>);
+impl Drop for ReleaseOnDrop {
+    fn drop(&mut self) {
+        self.0.notify_one();
+    }
+}
+
+struct Contributor {
+    decision: Option<ApprovalDecision>,
+    calls: Arc<AtomicUsize>,
+    gate: Option<(Arc<Notify>, Arc<Notify>)>,
+    panic: bool,
+}
+impl ApprovalReviewContributor for Contributor {
+    fn decide<'a>(
+        &'a self,
+        _input: &'a codex_extension_api::ApprovalDecisionInput<'_>,
+    ) -> codex_extension_api::ExtensionFuture<'a, Option<ApprovalDecision>> {
+        Box::pin(async move {
+            self.calls.fetch_add(1, Ordering::SeqCst);
+            if let Some((entered, release)) = &self.gate {
+                entered.notify_one();
+                release.notified().await;
+            }
+            assert!(!self.panic, "intentional review worker failure");
+            self.decision.clone()
+        })
+    }
+}
+struct Fixture {
+    session: Arc<Session>,
+    step: Arc<StepContext>,
+    calls: Arc<AtomicUsize>,
+    _events: async_channel::Receiver<Event>,
+}
+impl Fixture {
+    async fn new(
+        decision: Option<ApprovalDecision>,
+        gate: Option<(Arc<Notify>, Arc<Notify>)>,
+        panic: bool,
+    ) -> anyhow::Result<Self> {
+        let (mut session, turn, events) = make_session_and_context_with_auth_and_config_and_rx(
+            codex_login::CodexAuth::from_api_key("offline-test"),
+            Vec::new(),
+            |config| {
+                config.permissions.approval_policy =
+                    codex_config::Constrained::allow_any(AskForApproval::OnRequest);
+                config.approvals_reviewer = ApprovalsReviewer::User;
+                config
+                    .permissions
+                    .set_permission_profile(PermissionProfile::read_only())
+                    .expect("test permissions");
+            },
+        )
+        .await;
+        let calls = Arc::new(AtomicUsize::new(0));
+        let mut registry = codex_extension_api::ExtensionRegistryBuilder::new();
+        registry.approval_review_contributor(Arc::new(Contributor {
+            decision,
+            calls: Arc::clone(&calls),
+            gate,
+            panic,
+        }));
+        Arc::get_mut(&mut session)
+            .ok_or_else(|| anyhow::anyhow!("unshared fixture"))?
+            .services
+            .extensions = Arc::new(registry.build());
+        Ok(Self {
+            session,
+            step: StepContext::for_test(turn),
+            calls,
+            _events: events,
+        })
+    }
+    fn action(&self) -> ApprovalAction {
+        ApprovalAction::ExecCommand {
+            id: "routing".into(),
+            environment_id: codex_exec_server::LOCAL_ENVIRONMENT_ID.into(),
+            command: vec!["offline-command".into()],
+            hook_command: "offline-command".into(),
+            cwd: self
+                .step
+                .environments
+                .primary()
+                .expect("local environment")
+                .cwd()
+                .clone(),
+            sandbox_permissions: SandboxPermissions::UseDefault,
+            additional_permissions: None,
+            justification: None,
+            tty: false,
+            proposed_execpolicy_amendment: None,
+        }
+    }
+    fn context(&self, cancellation_token: Option<CancellationToken>) -> ApprovalContext {
+        ApprovalContext {
+            review_context: GuardianReviewContext::from(&self.step),
+            cancellation_token,
+            call_id: "routing".into(),
+            tool_name: ToolName::plain("exec_command"),
+            strict_auto_review: false,
+            approval_reason: None,
+            retry_reason: None,
+            network_approval_context: None,
+        }
+    }
+    async fn typed(&self, ctx: &ApprovalContext) -> ReviewRoutingResult {
+        self.session
+            .request_guardian_approval_with_routing(self.action(), ctx)
+            .await
+    }
+    fn trusted_hooks(&self, commands: Vec<(String, bool)>) -> anyhow::Result<tempfile::TempDir> {
+        let home = tempfile::tempdir()?;
+        let config_path =
+            AbsolutePathBuf::try_from(home.path().join(codex_config::CONFIG_TOML_FILE))?;
+        let stack = self
+            .step
+            .turn
+            .config
+            .config_layer_stack
+            .with_user_config(&config_path, serde_json::from_value(serde_json::json!({}))?)?;
+        std::fs::write(home.path().join("hooks.json"), serde_json::json!({"hooks":{"PermissionRequest":[{"matcher":"Bash", "hooks": commands.into_iter().map(|(command, asynchronous)| serde_json::json!({"type":"command", "command":command, "async":asynchronous})).collect::<Vec<_>>()}]}}).to_string())?;
+        let listed = codex_hooks::list_hooks(codex_hooks::HooksConfig {
+            feature_enabled: true,
+            config_layer_stack: Some(stack.clone()),
+            ..Default::default()
+        });
+        assert!(!listed.hooks.is_empty());
+        let states = listed
+            .hooks
+            .iter()
+            .map(|hook| {
+                (
+                    hook.key.clone(),
+                    serde_json::json!({"trusted_hash":hook.current_hash}),
+                )
+            })
+            .collect::<serde_json::Map<_, _>>();
+        let stack = stack.with_user_config(
+            &config_path,
+            serde_json::from_value(serde_json::json!({"hooks":{"state":states}}))?,
+        )?;
+        let hooks = self.session.hooks().reconfigured(codex_hooks::HooksConfig {
+            feature_enabled: true,
+            config_layer_stack: Some(stack),
+            shell_program: Some("/bin/sh".into()),
+            shell_args: vec!["-c".into()],
+            ..Default::default()
+        });
+        self.session.services.hooks.store(Arc::new(hooks));
+        Ok(home)
+    }
+}
