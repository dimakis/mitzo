+        let result = tokio::time::timeout(
+            Duration::from_secs(5),
+            fixture
+                .session
+                .request_guardian_approval_with_routing(action, &ctx),
+        )
+        .await?;
+        assert_eq!(
+            result.disposition(),
+            &ReviewDisposition::Decision(ReviewDecision::denied(
+                "automatic approval review could not complete"
+            ))
+        );
+        assert!(result.used_config().is_none());
+        assert_eq!(fixture.calls.load(Ordering::SeqCst), 1);
+    }
+    Ok(())
+}
