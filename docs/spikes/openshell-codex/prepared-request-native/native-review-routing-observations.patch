+#[tokio::test]
+async fn real_review_retains_config_selected_before_contributor_await() -> anyhow::Result<()> {
+    let entered = Arc::new(Notify::new());
+    let release = Arc::new(Notify::new());
+    let fixture = Fixture::new(
+        None,
+        Some((Arc::clone(&entered), Arc::clone(&release))),
+        /*panic*/ false,
+    )
+    .await?;
+    let _release_on_drop = ReleaseOnDrop(Arc::clone(&release));
+    let original = fixture.session.get_config().await;
+    let ctx = fixture.context(/*cancellation_token*/ None);
+    let review = fixture.typed(&ctx);
+    tokio::pin!(review);
+    tokio::time::timeout(Duration::from_secs(5), async {
+        tokio::select! { _ = entered.notified() => {}, _ = &mut review => panic!("review completed before contributor gate") }
+    }).await?;
+    fixture
+        .session
+        .refresh_runtime_config(original.as_ref().clone())
+        .await;
+    assert!(!Arc::ptr_eq(&original, &fixture.session.get_config().await));
+    release.notify_one();
+    let result = tokio::time::timeout(Duration::from_secs(5), review).await?;
+    assert!(Arc::ptr_eq(
+        result.used_config().expect("issuing config"),
+        &original
+    ));
+    assert_eq!(
+        result.disposition(),
+        &ReviewDisposition::UserPrompt(UserPromptDisposition::NoContributorDefaultUser {
+            fresh_review_required: false
+        })
+    );
+    assert_eq!(fixture.calls.load(Ordering::SeqCst), 1);
+    Ok(())
+}
