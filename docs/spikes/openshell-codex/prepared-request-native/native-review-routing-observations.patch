+#[tokio::test]
+async fn matching_trusted_handlers_keep_count_when_declining_failing_or_async() -> anyhow::Result<()>
+{
+    for (output, asynchronous) in [
+        ("printf '{}'", false),
+        ("exit 7", false),
+        ("printf '{}'", true),
+    ] {
+        let fixture = Fixture::new(
+            Some(ApprovalDecision::Reviewed(ReviewDecision::Approved)),
+            /*gate*/ None,
+            /*panic*/ false,
+        )
+        .await?;
+        let counter = tempfile::tempdir()?;
+        let hits = counter.path().join("hits");
+        let quoted = hits.to_string_lossy().replace('\'', "'\\''");
+        let _home = fixture.trusted_hooks(vec![(
+            format!("cat >/dev/null; printf 'hit\\n' >> '{quoted}'; {output}"),
+            asynchronous,
+        )])?;
+        let ctx = fixture.context(/*cancellation_token*/ None);
+        let typed = run_permission_request_hooks_with_metadata(
+            &fixture.session,
+            &ctx.review_context,
+            "typed",
+            fixture.action().permission_request_payload(),
+        )
+        .await;
+        assert_eq!(typed.matching_handler_count(), 1);
+        assert_eq!(typed.into_decision(), None);
+        if asynchronous {
+            tokio::time::timeout(
+                Duration::from_secs(5),
+                fixture.session.async_hook_results.recv(),
+            )
+            .await??;
+        }
+        assert_eq!(std::fs::read_to_string(&hits)?, "hit\n");
+        let legacy = crate::hook_runtime::run_permission_request_hooks(
+            &fixture.session,
+            &ctx.review_context,
+            "legacy",
+            fixture.action().permission_request_payload(),
+        )
+        .await;
+        assert_eq!(legacy, None);
+        if asynchronous {
+            tokio::time::timeout(
+                Duration::from_secs(5),
+                fixture.session.async_hook_results.recv(),
+            )
+            .await??;
+        }
+        assert_eq!(std::fs::read_to_string(&hits)?, "hit\nhit\n");
+        assert_eq!(
+            fixture
+                .session
+                .request_approval(fixture.action(), ctx)
+                .await
+                .map_err(|err| anyhow::anyhow!("approval: {err:?}"))?,
+            ReviewDecision::Approved
+        );
+        if asynchronous {
+            tokio::time::timeout(
+                Duration::from_secs(5),
+                fixture.session.async_hook_results.recv(),
+            )
+            .await??;
+        }
+        assert_eq!(std::fs::read_to_string(&hits)?, "hit\nhit\nhit\n");
+        assert_eq!(fixture.calls.load(Ordering::SeqCst), 1);
+    }
+    Ok(())
+}
