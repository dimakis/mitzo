+#[tokio::test]
+async fn trusted_hook_allow_deny_precedence_bypasses_contributors_once() -> anyhow::Result<()> {
+    for deny in [false, true] {
+        let fixture = Fixture::new(
+            Some(ApprovalDecision::AskUser),
+            /*gate*/ None,
+            /*panic*/ false,
+        )
+        .await?;
+        let counter = tempfile::tempdir()?;
+        let hits = counter.path().join("hits");
+        let quoted = hits.to_string_lossy().replace('\'', "'\\''");
+        let command = |behavior: &str| {
+            format!(
+                "cat >/dev/null; printf 'hit\\n' >> '{quoted}'; printf '%s\\n' '{{\"hookSpecificOutput\":{{\"hookEventName\":\"PermissionRequest\",\"decision\":{{\"behavior\":\"{behavior}\",\"message\":\"trusted denied\"}}}}}}'"
+            )
+        };
+        let mut commands = vec![(command("allow"), false)];
+        if deny {
+            commands.push((command("deny"), false));
+        }
+        let _home = fixture.trusted_hooks(commands)?;
+        let typed = run_permission_request_hooks_with_metadata(
+            &fixture.session,
+            &GuardianReviewContext::from(&fixture.step),
+            "typed-verdict",
+            fixture.action().permission_request_payload(),
+        )
+        .await;
+        assert_eq!(typed.matching_handler_count(), if deny { 2 } else { 1 });
+        assert_eq!(
+            typed.into_decision(),
+            Some(if deny {
+                PermissionRequestDecision::Deny {
+                    message: "trusted denied".into(),
+                }
+            } else {
+                PermissionRequestDecision::Allow
+            })
+        );
+        let result = fixture
+            .session
+            .request_approval(
+                fixture.action(),
+                fixture.context(/*cancellation_token*/ None),
+            )
+            .await;
+        if deny {
+            assert!(
+                matches!(result, Err(ToolError::Rejected(message)) if message == "trusted denied")
+            );
+        } else {
+            assert_eq!(
+                result.map_err(|err| anyhow::anyhow!("approval: {err:?}"))?,
+                ReviewDecision::Approved
+            );
+        }
+        assert_eq!(
+            std::fs::read_to_string(&hits)?.lines().count(),
+            if deny { 4 } else { 2 }
+        );
+        assert_eq!(fixture.calls.load(Ordering::SeqCst), 0);
+    }
+    Ok(())
+}
