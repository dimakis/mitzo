 use codex_client::StreamResponse;
@@ -23,7 +24,170 @@ pub(crate) struct EndpointSession<T: HttpTransport> {
     request_telemetry: Option<Arc<dyn RequestTelemetry>>,
 }
 
+fn validate_frozen_headers(headers: &HeaderMap) -> Result<(), ApiError> {
+    // First public API scope: account headers belong to the selected provider/
+    // pinned auth owner; the remaining allowed headers are explicit framing or
+    // tracing/session observations. Internal routing/framing flags remain unsupported.
+    if headers.keys().any(|key| {
+        !matches!(
+            key.as_str(),
+            "authorization"
+                | "openai-project"
+                | "openai-organization"
+                | "content-type"
+                | "content-encoding"
+                | "accept"
+                | "user-agent"
+                | "x-client-request-id"
+                | "session-id"
+                | "thread-id"
+                | "traceparent"
+                | "tracestate"
+        ) || headers.get_all(key).iter().count() != 1
+    }) {
+        return Err(ApiError::InvalidRequest {
+            message: "unsupported frozen Responses headers".to_string(),
+        });
+    }
+    Ok(())
+}
+
 impl<T: HttpTransport> EndpointSession<T> {
+    /// Use the selected provider/auth owner, but refuse route/body rewriting and
+    /// endpoint retries. The native consumption owner supplies pinned credentials.
+    async fn frozen_request(
+        &self,
+        path: &str,
+        body: EncodedJsonBody,
+        headers: HeaderMap,
+        compression: RequestCompression,
+    ) -> Result<Request, ApiError> {
+        if self.provider.base_url.trim_end_matches('/') != "https://api.openai.com/v1"
+            || self
+                .provider
+                .query_params
+                .as_ref()
+                .is_some_and(|p| !p.is_empty())
+        {
+            return Err(ApiError::InvalidRequest {
+                message: "unsupported frozen Responses route".to_string(),
+            });
+        }
+        if ["authorization", "openai-project", "openai-organization"]
+            .iter()
+            .any(|key| headers.contains_key(*key))
+        {
+            return Err(ApiError::InvalidRequest {
+                message: "frozen Responses account headers require selected auth".to_string(),
+            });
+        }
+        let mut request = self.make_request(
+            &Method::POST,
+            path,
+            &headers,
+            Some(&RequestBody::EncodedJson(body)),
+        );
+        validate_frozen_headers(&request.headers)?;
+        if [
+            http::header::HOST,
+            http::header::CONTENT_ENCODING,
+            http::header::CONTENT_LENGTH,
+        ]
+        .iter()
+        .any(|key| request.headers.contains_key(key))
+            || request
+                .headers
+                .get(http::header::CONTENT_TYPE)
+                .is_some_and(|v| v != "application/json")
+        {
+            return Err(ApiError::InvalidRequest {
+                message: "unsupported frozen Responses headers".to_string(),
+            });
+        }
+        request.compression = compression;
+        request.response_body_limit_bytes =
+            (path == "/responses/input_tokens").then_some(64 * 1024);
+        let expected = request.into_prepared().map_err(TransportError::Build)?;
+        let request = self
+            .auth
+            .apply_auth(expected.clone())
+            .await
+            .map_err(TransportError::from)?;
+        validate_frozen_headers(&request.headers)?;
+        if request.method != expected.method
+            || request.url != expected.url
+            || request.body != expected.body
+            || request.compression != expected.compression
+            || request.response_body_limit_bytes != expected.response_body_limit_bytes
+            || [
+                http::header::CONTENT_TYPE,
+                http::header::CONTENT_ENCODING,
+                http::header::CONTENT_LENGTH,
+                http::header::HOST,
+                http::header::ACCEPT,
+            ]
+            .iter()
+            .any(|key| {
+                !request
+                    .headers
+                    .get_all(key)
+                    .iter()
+                    .eq(expected.headers.get_all(key).iter())
+            })
+        {
+            return Err(ApiError::InvalidRequest {
+                message: "authentication changed frozen Responses request".to_string(),
+            });
+        }
+        Ok(request)
+    }
+
+    pub(crate) async fn execute_frozen_json(
+        &self,
+        path: &str,
+        body: EncodedJsonBody,
+    ) -> Result<Response, ApiError> {
+        let mut headers = HeaderMap::new();
+        headers.insert(
+            http::header::ACCEPT,
+            http::HeaderValue::from_static("application/json"),
+        );
+        let request = self
+            .frozen_request(path, body, headers, RequestCompression::None)
+            .await?;
+        let mut policy = self.provider.retry.to_policy();
+        policy.max_attempts = 0;
+        Ok(run_with_request_telemetry(
+            policy,
+            self.request_telemetry.clone(),
+            || request.clone(),
+            |req| self.transport.execute_once(req),
+        )
+        .await?)
+    }
+
