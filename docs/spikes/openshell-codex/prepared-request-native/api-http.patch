@@ -0,0 +1,385 @@
+use super::*;
+use crate::AuthProvider;
+use crate::AuthProviderFuture;
+use crate::FrozenResponsesRequest;
+use crate::RetryConfig;
+use codex_client::Request;
+use codex_client::Response;
+use codex_client::StreamResponse;
+use codex_client::TransportError;
+use http::StatusCode;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+use std::sync::Mutex;
+use std::time::Duration;
+
+#[derive(Clone)]
+struct RecordingTransport {
+    requests: Arc<Mutex<Vec<Request>>>,
+    response: Value,
+}
+
+impl HttpTransport for RecordingTransport {
+    async fn execute(&self, request: Request) -> Result<Response, TransportError> {
+        self.requests.lock().unwrap().push(request);
+        Err(TransportError::Build(
+            "legacy execute must not run".to_string(),
+        ))
+    }
+
+    async fn execute_once(&self, request: Request) -> Result<Response, TransportError> {
+        self.requests.lock().unwrap().push(request);
+        Ok(Response {
+            status: StatusCode::OK,
+            headers: HeaderMap::new(),
+            body: serde_json::to_vec(&self.response).unwrap().into(),
+        })
+    }
+
+    async fn stream(&self, request: Request) -> Result<StreamResponse, TransportError> {
+        self.requests.lock().unwrap().push(request);
+        Err(TransportError::Build(
+            "legacy stream must not run".to_string(),
+        ))
+    }
+
+    async fn stream_once(&self, request: Request) -> Result<StreamResponse, TransportError> {
+        self.requests.lock().unwrap().push(request);
+        Err(TransportError::Timeout)
+    }
+}
+
+struct Auth;
+impl AuthProvider for Auth {
+    fn add_auth_headers(&self, headers: &mut HeaderMap) {
+        headers.insert("authorization", HeaderValue::from_static("Bearer fixture"));
+    }
+}
+
+fn provider() -> Provider {
+    Provider {
+        name: "openai".to_string(),
+        base_url: "https://api.openai.com/v1".to_string(),
+        query_params: None,
+        headers: HeaderMap::new(),
+        retry: RetryConfig {
+            max_attempts: 3,
+            base_delay: Duration::ZERO,
+            retry_429: true,
+            retry_5xx: true,
+            retry_transport: true,
+        },
+        stream_idle_timeout: Duration::from_secs(1),
+    }
+}
+
+fn frozen() -> FrozenResponsesRequest {
+    FrozenResponsesRequest::new(
+        json!({
+            "model":"fixture-model", "instructions":"retained instructions",
+            "input":[{"role":"user", "content":[
+                {"type":"input_text", "text":"retained"},
+                {"type":"input_image", "image_url":"data:image/png;base64,aGVsbG8=", "detail":"high"}
+            ]}],
+            "tools":[{"type":"function", "name":"fixture_tool", "parameters":{"type":"object"}, "strict":true}],
+            "text":{"format":{"type":"json_schema", "name":"result", "schema":{"type":"object"}, "strict":true}},
+            "tool_choice":"auto", "parallel_tool_calls":false,
+            "stream":true, "max_output_tokens":16, "truncation":"disabled"
+        }),
+        16,
+    )
+    .unwrap()
+}
+
+fn transport(response: Value) -> RecordingTransport {
+    RecordingTransport {
+        requests: Arc::default(),
+        response,
+    }
+}
+
+#[tokio::test]
+async fn frozen_count_uses_only_count_endpoint_and_selected_auth() {
+    let transport = transport(json!({"object":"response.input_tokens", "input_tokens":0}));
+    let client = ResponsesClient::new(transport.clone(), provider(), Arc::new(Auth));
+    let frozen = frozen();
+    assert_eq!(client.count_input_tokens(&frozen).await.unwrap(), 0);
+    let requests = transport.requests.lock().unwrap();
+    assert_eq!(requests.len(), 1);
+    assert_eq!(
+        requests[0].url,
+        "https://api.openai.com/v1/responses/input_tokens"
+    );
+    assert_eq!(requests[0].headers["authorization"], "Bearer fixture");
+    assert_eq!(
+        requests[0].headers.get(http::header::ACCEPT),
+        Some(&HeaderValue::from_static("application/json"))
+    );
+    assert_eq!(
+        serde_json::from_slice::<Value>(&requests[0].prepare_body_for_send().unwrap().body_bytes())
+            .unwrap(),
+        *frozen.count_body()
+    );
+}
+
+#[tokio::test]
+async fn frozen_count_refuses_invalid_counter_responses() {
+    for response in [
+        json!({"object":"response", "input_tokens":1}),
+        json!({"object":"response.input_tokens", "input_tokens":-1}),
+        json!({"object":"response.input_tokens", "input_tokens":1.5}),
+        json!({"object":"response.input_tokens", "input_tokens":9007199254740992_u64}),
+        json!({"object":"response.input_tokens"}),
+    ] {
+        let client = ResponsesClient::new(transport(response), provider(), Arc::new(Auth));
+        assert!(client.count_input_tokens(&frozen()).await.is_err());
+    }
+}
+
+#[tokio::test]
+async fn frozen_stream_retains_bytes_and_never_retries_transport_failure() {
+    let transport = transport(json!({}));
+    let client = ResponsesClient::new(transport.clone(), provider(), Arc::new(Auth));
+    let frozen = frozen();
+    assert!(
+        client
+            .stream_frozen_request(&frozen, ResponsesOptions::default())
+            .await
+            .is_err()
+    );
+    let requests = transport.requests.lock().unwrap();
+    assert_eq!(requests.len(), 1);
+    assert_eq!(requests[0].url, "https://api.openai.com/v1/responses");
+    assert_eq!(
+        requests[0].prepare_body_for_send().unwrap().body_bytes(),
+        frozen.encoded_body()
+    );
+}
+
+#[tokio::test]
+async fn frozen_rejects_unsupported_routes_before_transport() {
+    for base_url in [
+        "https://chatgpt.com/backend-api/codex",
+        "https://proxy.example/v1",
+        "https://api.openai.com/v1/responses",
+    ] {
+        let transport = transport(json!({}));
+        let mut provider = provider();
+        provider.base_url = base_url.to_string();
+        let client = ResponsesClient::new(transport.clone(), provider, Arc::new(Auth));
+        assert!(client.count_input_tokens(&frozen()).await.is_err());
+        assert!(
+            client
+                .stream_frozen_request(&frozen(), ResponsesOptions::default())
+                .await
+                .is_err()
+        );
+        assert!(transport.requests.lock().unwrap().is_empty());
+    }
+}
+
+struct MutatingAuth;
+impl AuthProvider for MutatingAuth {
+    fn add_auth_headers(&self, _headers: &mut HeaderMap) {}
+
+    fn apply_auth(&self, mut request: Request) -> AuthProviderFuture<'_> {
+        Box::pin(async move {
+            request.body = None;
+            Ok(request)
+        })
+    }
+}
+
+#[tokio::test]
+async fn frozen_refuses_auth_body_mutation_before_count_or_generation() {
+    let transport = transport(json!({}));
+    let client = ResponsesClient::new(transport.clone(), provider(), Arc::new(MutatingAuth));
+    assert!(client.count_input_tokens(&frozen()).await.is_err());
+    assert!(
+        client
+            .stream_frozen_request(&frozen(), ResponsesOptions::default())
+            .await
+            .is_err()
+    );
+    assert!(transport.requests.lock().unwrap().is_empty());
+}
+
+struct LegacyTransport(RecordingTransport);
+impl HttpTransport for LegacyTransport {
+    async fn execute(&self, request: Request) -> Result<Response, TransportError> {
+        self.0.execute(request).await
+    }
+
+    async fn stream(&self, request: Request) -> Result<StreamResponse, TransportError> {
+        self.0.stream(request).await
+    }
+}
+
+#[tokio::test]
+async fn frozen_refuses_transport_without_explicit_single_attempt_support() {
+    let transport = transport(json!({}));
+    let client = ResponsesClient::new(
+        LegacyTransport(transport.clone()),
+        provider(),
+        Arc::new(Auth),
+    );
+    assert!(client.count_input_tokens(&frozen()).await.is_err());
+    assert!(
+        client
+            .stream_frozen_request(&frozen(), ResponsesOptions::default())
+            .await
+            .is_err()
+    );
+    assert!(transport.requests.lock().unwrap().is_empty());
+}
+
+struct AppendingHeaderAuth(http::HeaderName, HeaderValue);
+impl AuthProvider for AppendingHeaderAuth {
+    fn add_auth_headers(&self, _headers: &mut HeaderMap) {}
+
+    fn apply_auth(&self, mut request: Request) -> AuthProviderFuture<'_> {
+        Box::pin(async move {
+            request.headers.append(self.0.clone(), self.1.clone());
+            Ok(request)
+        })
+    }
+}
+
+#[tokio::test]
+async fn frozen_refuses_auth_appending_a_second_content_type() {
+    let transport = transport(json!({"object":"response.input_tokens", "input_tokens":0}));
+    let auth = AppendingHeaderAuth(
+        http::header::CONTENT_TYPE,
+        HeaderValue::from_static("text/plain"),
+    );
+    let client = ResponsesClient::new(transport.clone(), provider(), Arc::new(auth));
+    assert!(client.count_input_tokens(&frozen()).await.is_err());
+    assert!(
+        client
+            .stream_frozen_request(&frozen(), ResponsesOptions::default())
+            .await
+            .is_err()
+    );
+    assert!(transport.requests.lock().unwrap().is_empty());
+}
+
+#[tokio::test]
+async fn frozen_refuses_auth_appending_a_second_compression_header() {
+    let transport = transport(json!({}));
+    let auth = AppendingHeaderAuth(
+        http::header::CONTENT_ENCODING,
+        HeaderValue::from_static("gzip"),
+    );
+    let client = ResponsesClient::new(transport.clone(), provider(), Arc::new(auth));
+    let options = ResponsesOptions {
+        compression: Compression::Zstd,
+        ..Default::default()
+    };
+    assert!(
+        client
+            .stream_frozen_request(&frozen(), options)
+            .await
+            .is_err()
+    );
+    assert!(transport.requests.lock().unwrap().is_empty());
+}
+
+#[tokio::test]
+async fn frozen_refuses_non_json_content_type_before_generation() {
+    let transport = transport(json!({}));
+    let client = ResponsesClient::new(transport.clone(), provider(), Arc::new(Auth));
+    let mut options = ResponsesOptions::default();
+    options.extra_headers.insert(
+        http::header::CONTENT_TYPE,
+        HeaderValue::from_static("application/cbor"),
+    );
+    assert!(
+        client
+            .stream_frozen_request(&frozen(), options)
+            .await
+            .is_err()
+    );
+    assert!(transport.requests.lock().unwrap().is_empty());
+}
+
+#[tokio::test]
+async fn frozen_refuses_semantic_headers_from_provider_options_or_auth() {
+    for header in [
+        "x-openai-internal-codex-responses-lite",
+        "x-codex-beta-features",
+        "x-codex-routing-hint",
+    ] {
+        let transport = transport(json!({"object":"response.input_tokens", "input_tokens":0}));
+        let header = http::HeaderName::from_static(header);
+        let mut selected = provider();
+        selected
+            .headers
+            .insert(header.clone(), HeaderValue::from_static("true"));
+        let client = ResponsesClient::new(transport.clone(), selected, Arc::new(Auth));
+        assert!(client.count_input_tokens(&frozen()).await.is_err());
+        assert!(
+            client
+                .stream_frozen_request(&frozen(), ResponsesOptions::default())
+                .await
+                .is_err()
+        );
+        let client = ResponsesClient::new(transport.clone(), provider(), Arc::new(Auth));
+        let mut options = ResponsesOptions::default();
+        options
+            .extra_headers
+            .insert(header.clone(), HeaderValue::from_static("true"));
+        assert!(
+            client
+                .stream_frozen_request(&frozen(), options)
+                .await
+                .is_err()
+        );
+        let auth = AppendingHeaderAuth(header, HeaderValue::from_static("true"));
+        let client = ResponsesClient::new(transport.clone(), provider(), Arc::new(auth));
+        assert!(client.count_input_tokens(&frozen()).await.is_err());
+        assert!(
+            client
+                .stream_frozen_request(&frozen(), ResponsesOptions::default())
+                .await
+                .is_err()
+        );
+        assert!(transport.requests.lock().unwrap().is_empty());
+    }
+}
+
+#[tokio::test]
+async fn frozen_refuses_ambiguous_account_headers() {
+    for header in ["authorization", "openai-project", "openai-organization"] {
+        let transport = transport(json!({"object":"response.input_tokens", "input_tokens":0}));
+        let header = http::HeaderName::from_static(header);
+        let mut selected = provider();
+        selected
+            .headers
+            .insert(header.clone(), HeaderValue::from_static("original"));
+        let auth = AppendingHeaderAuth(header, HeaderValue::from_static("other"));
+        let client = ResponsesClient::new(transport.clone(), selected, Arc::new(auth));
+        assert!(client.count_input_tokens(&frozen()).await.is_err());
+        assert!(
+            client
+                .stream_frozen_request(&frozen(), ResponsesOptions::default())
+                .await
+                .is_err()
+        );
+        assert!(transport.requests.lock().unwrap().is_empty());
+    }
+}
+
+#[tokio::test]
+async fn frozen_refuses_auth_changing_accept_semantics() {
+    let transport = transport(json!({"object":"response.input_tokens", "input_tokens":0}));
+    let auth = AppendingHeaderAuth(http::header::ACCEPT, HeaderValue::from_static("text/html"));
+    let client = ResponsesClient::new(transport.clone(), provider(), Arc::new(auth));
+    assert!(client.count_input_tokens(&frozen()).await.is_err());
+    assert!(
+        client
+            .stream_frozen_request(&frozen(), ResponsesOptions::default())
+            .await
+            .is_err()
+    );
+    assert!(transport.requests.lock().unwrap().is_empty());
+}
