@@ -0,0 +1,97 @@
+use super::ResponsesClient;
+use super::ResponsesOptions;
+use crate::ApiError;
+use crate::Compression;
+use crate::FrozenResponsesRequest;
+use crate::ResponseStream;
+use crate::requests::headers::build_session_headers;
+use crate::requests::headers::insert_header;
+use crate::requests::headers::subagent_header;
+use crate::sse::spawn_response_stream;
+use codex_client::HttpTransport;
+use codex_client::RequestCompression;
+use http::HeaderValue;
+use serde::Deserialize;
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct InputTokenCount {
+    object: String,
+    input_tokens: u64,
+}
+
+impl<T: HttpTransport> ResponsesClient<T> {
+    /// Count only the retained public-schema projection using this client's
+    /// selected provider/auth. This method never starts a response or a turn.
+    pub async fn count_input_tokens(
+        &self,
+        request: &FrozenResponsesRequest,
+    ) -> Result<u64, ApiError> {
+        let response = self
+            .session
+            .execute_frozen_json("/responses/input_tokens", request.count_encoded())
+            .await?;
+        let count: InputTokenCount =
+            serde_json::from_slice(&response.body).map_err(|_| ApiError::InvalidRequest {
+                message: "unsupported Responses input token count".to_string(),
+            })?;
+        if !response.status.is_success()
+            || count.object != "response.input_tokens"
+            || count.input_tokens > 9_007_199_254_740_991
+        {
+            return Err(ApiError::InvalidRequest {
+                message: "unsupported Responses input token count".to_string(),
+            });
+        }
+        Ok(count.input_tokens)
+    }
+
+    /// Issue exactly one transport attempt with the retained generation bytes.
+    /// The caller must already own a durable, current one-use consumption permit.
+    /// Calling this method again is not an authorized recovery strategy.
+    pub async fn stream_frozen_request(
+        &self,
+        request: &FrozenResponsesRequest,
+        options: ResponsesOptions,
+    ) -> Result<ResponseStream, ApiError> {
+        let ResponsesOptions {
+            session_id,
+            thread_id,
+            session_source,
+            mut extra_headers,
+            compression,
+            turn_state,
+        } = options;
+        if let Some(ref thread_id) = thread_id {
+            insert_header(&mut extra_headers, "x-client-request-id", thread_id);
+        }
+        extra_headers.extend(build_session_headers(session_id, thread_id));
+        if let Some(subagent) = subagent_header(&session_source) {
+            insert_header(&mut extra_headers, "x-openai-subagent", &subagent);
+        }
+        extra_headers.insert(
+            http::header::ACCEPT,
+            HeaderValue::from_static("text/event-stream"),
+        );
+        let compression = match compression {
+            Compression::None => RequestCompression::None,
+            Compression::Zstd => RequestCompression::Zstd,
+        };
+        let response = self
+            .session
+            .stream_frozen_json(request.encoded(), extra_headers, compression)
+            .await?;
+        if !response.status.is_success() {
+            return Err(ApiError::Api {
+                status: response.status,
+                message: "frozen Responses generation refused".to_string(),
+            });
+        }
+        Ok(spawn_response_stream(
+            response,
+            self.session.provider().stream_idle_timeout,
+            self.sse_telemetry.clone(),
+            turn_state,
+        ))
+    }
+}
diff --git a/codex-rs/codex-api/src/endpoint/frozen_responses_tests.rs b/codex-rs/codex-api/src/endpoint/frozen_responses_tests.rs
