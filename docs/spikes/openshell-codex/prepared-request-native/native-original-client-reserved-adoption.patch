+        auth.capture_cached_api_key_credentials().unwrap(),
+    )?;
+    installed
+        .observe(&manager, selected.mcp_sources().unwrap())
+        .map_err(|error| anyhow::anyhow!("{error:?}"))?;
+    manager.construct_selected_start_client(&mut selected)?;
+    installed
+        .observe(&manager, selected.mcp_sources().unwrap())
+        .map_err(|error| anyhow::anyhow!("{error:?}"))?;
