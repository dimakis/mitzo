+#[tokio::test]
+async fn actual_client_slot_moves_same_state_once_and_burns_changed_inputs() -> anyhow::Result<()> {
+    let (session, _turn) = crate::session::tests::make_session_and_context().await;
+    let session = Arc::new(session);
+    let config = session.get_config().await;
+    let options = crate::StartThreadOptions::new(config.as_ref().clone());
+    let state = session.state.lock().await;
+    let configuration = &state.session_configuration;
+    crate::client::ModelClient::validate_public_api_client_inputs(
+        &configuration.session_source,
+        configuration.provider.info(),
+    )?;
+    let routing = session
+        .services
+        .thread_extension_data
+        .get_or_init(|| config.workspace_routing_context());
+    let inputs = || super::super::model_client_construction::OriginalSessionModelClientInputs {
+        config: config.as_ref(),
+        provider_info: configuration.provider.info(),
+        session_source: &configuration.session_source,
+        originator: &configuration.originator,
+        parent_thread_id: configuration.parent_thread_id,
+        auth_manager: &session.services.auth_manager,
+        thread_id: session.thread_id(),
+        initial_history: &options.initial_history,
+        reasoning_effort_override_enabled:
+            super::super::model_client_construction::original_effort_override(
+                config.as_ref(),
+                configuration.thread_source.as_ref(),
+            ),
+        attestation_provider: session.services.attestation_provider.clone(),
+        workspace_routing: &routing,
+        extensions: session.services.extensions.as_ref(),
+        executed_tool_calls: &session.services.executed_tool_calls,
+        fork_cache_key: None,
+        tx_event: &session.tx_event,
+        codex_responses_headers: session
+            .services
+            .thread_extension_data
+            .get::<crate::CodexResponsesHeaders>(),
+    };
+    let slot = || {
+        let mut init = options.thread_extension_init.clone();
+        let mut carrier = OriginalClientInputData::allocate(
+            config.as_ref(),
+            &options.initial_history,
+            &mut init,
+            session.thread_id(),
+        );
+        // A real RetainedOriginalClient from the ORIGINAL constructor supplies
+        // this private slot fixture. It is not a fresh-source/currentness grant.
+        carrier.client =
+            OriginalClientSlot::Retained(inputs().retain(Arc::clone(&session.services.extensions)));
+        carrier
+    };
+    let mut carrier = slot();
+    let witness = carrier.client()?.clone();
+    let adopted = carrier.adopt_client(inputs())?;
+    assert!(witness.same_private_state_for_test(&adopted));
+    assert!(carrier.client().is_err());
+    assert!(carrier.adopt_client(inputs()).is_err());
+    assert!(matches!(carrier.client, OriginalClientSlot::Consumed));
+
+    let mut carrier = slot();
+    let mut changed = inputs();
+    changed.reasoning_effort_override_enabled = !changed.reasoning_effort_override_enabled;
+    assert!(carrier.adopt_client(changed).is_err());
+    assert!(carrier.client().is_err());
+    // Even valid original inputs cannot fall back to a second construction
+    // after a failed adoption burned the actual slot.
+    assert!(carrier.adopt_client(inputs()).is_err());
+    assert!(matches!(carrier.client, OriginalClientSlot::Consumed));
+    Ok(())
+}
