+    let mut raw = StartThreadOptions::new(config);
+    raw.reserved_thread_id = Some(id);
+    assert!(manager.prepare_selected_start(raw).await.is_err());
+    assert_eq!(calls.load(Ordering::SeqCst), 2);
+    assert!(manager.list_thread_ids().await.is_empty());
+}
