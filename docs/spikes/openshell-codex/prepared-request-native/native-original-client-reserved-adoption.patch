+#[tokio::test]
+async fn genuine_reserved_issuer_is_adopted_once_and_foreign_or_raw_ids_refuse() {
+    let (_home, config, manager) = fixture().await;
+    let (_foreign_home, _foreign_config, foreign) = fixture().await;
+    let calls = Arc::new(AtomicUsize::new(0));
+    let issued = Arc::clone(&calls);
+    let manager = manager.with_thread_id_generator(move || {
+        issued.fetch_add(1, Ordering::SeqCst);
+        ThreadId::new()
+    });
+    let token = manager.reserve_thread_start();
+    let id = token.thread_id();
+    let mut selected = manager
+        .prepare_reserved_selected_start(StartThreadOptions::new(config.clone()), token)
+        .await
+        .unwrap();
+    assert_eq!(selected.allocation.as_ref().unwrap().thread_id(), id);
+    assert!(
+        selected
+            .start_options()
+            .unwrap()
+            .reserved_thread_id
+            .is_none()
+    );
+    assert_eq!(calls.load(Ordering::SeqCst), 1);
+    let adoption = manager.adopt_selected_start(&mut selected).unwrap();
+    assert_eq!(adoption.options.reserved_thread_id, Some(id));
+    assert!(manager.adopt_selected_start(&mut selected).is_err());
+    assert!(
+        foreign
