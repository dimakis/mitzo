+//! Count evidence for an exact ordinary public-API capture, never admission.
+//!
+//! No credential lock survives an await. The catalog read guard spans the count,
+//! but the returned observation retains no guard or authority for later effects.
+
+use std::sync::Arc;
+
+use codex_api::ApiError;
+use codex_api::AuthProvider;
+use codex_api::ResponsesClient as ApiResponsesClient;
+use codex_http_client::ClientRouteClass;
+use codex_login::auth::CapturedApiKeyCredentials;
+use codex_login::default_client::create_single_attempt_transport_for_routes_async;
+use codex_model_provider::BearerAuthProvider;
+use codex_models_manager::manager::SharedModelsManager;
+use codex_models_manager::model_limits::UnverifiedModelLimitCandidate;
+
+use super::public_responses_capture::CapturedPublicApiResponsesRequest;
+
+/// Process-local count evidence only. Not Clone, serializable, Ready, or a permit.
+pub(crate) struct PublicApiCountObservation<'a> {
+    _client: &'a super::ModelClient,
+    captured: &'a CapturedPublicApiResponsesRequest,
+    _credentials: &'a CapturedApiKeyCredentials,
+    _models_manager: &'a SharedModelsManager,
+    limits: &'a UnverifiedModelLimitCandidate,
+    input_tokens: u64,
+}
+
+impl PublicApiCountObservation<'_> {
+    pub(crate) fn input_tokens(&self) -> u64 {
+        self.input_tokens
+    }
+
+    pub(crate) fn captured_request(&self) -> &CapturedPublicApiResponsesRequest {
+        self.captured
+    }
+
+    pub(crate) fn model_limits(&self) -> &UnverifiedModelLimitCandidate {
+        self.limits
+    }
+}
+
+impl super::ModelClient {
+    pub(crate) async fn count_captured_public_api_request<'a>(
+        &'a self,
+        captured: &'a CapturedPublicApiResponsesRequest,
+        credentials: &'a CapturedApiKeyCredentials,
+        models_manager: &'a SharedModelsManager,
+        limits: &'a UnverifiedModelLimitCandidate,
+    ) -> Result<PublicApiCountObservation<'a>, ApiError> {
+        if !captured.matches_client_selection(self, credentials) {
+            return Err(refused(
+                "count capture no longer matches ordinary selection",
+            ));
+        }
+        let request = captured.request();
+        if captured.model_info() != limits.model_info()
+            || request
+                .body()
+                .get("model")
+                .and_then(serde_json::Value::as_str)
+                != Some(limits.model_info().slug.as_str())
+            || request.max_output_tokens() == 0
+            || request.max_output_tokens() > limits.ceilings().maximum_output_tokens
+            || limits.ceilings().context_window == 0
+        {
+            return Err(refused("count capture does not match native model limits"));
+        }
+        // Reuse the exact provider/header conversion retained by original body
+        // capture. Never independently re-read project/org environment variables
+        // to construct another provider between counting and generation.
+        let manager = self.public_api_credential_owner()?;
+        let provider = captured
+            .provider_capture()
+            .filter(|provider| provider.sources_match_current_observation())
+            .ok_or_else(|| refused("original provider header sources changed"))?
+            .provider()
+            .clone();
+
+        let (auth, factory) = manager
+            .with_current_api_key_credentials(credentials, |auth, factory| {
+                let token = auth
+                    .get_token()
+                    .map_err(|_| refused("unavailable ordinary API authorization"))?;
+                if token.trim().is_empty() {
+                    return Err(refused("invalid ordinary API authorization"));
+                }
+                let auth = BearerAuthProvider::new(token);
+                // Native BearerAuthProvider otherwise omits an invalid header.
+                // Check privately; neither key nor header enters diagnostics.
+                let headers = auth.to_auth_headers();
+                if headers.len() != 1 || !headers.contains_key(http::header::AUTHORIZATION) {
+                    return Err(refused("invalid ordinary API authorization"));
+                }
+                Ok((auth, factory.clone()))
+            })
+            .ok_or_else(|| refused("ordinary credential selection changed before count"))??;
+        let transport =
+            create_single_attempt_transport_for_routes_async(factory, ClientRouteClass::Api)
+                .await
+                .map_err(|_| refused("account-bound single-attempt transport unavailable"))?;
+        let client = ApiResponsesClient::new(transport, provider, Arc::new(auth));
+        let catalog = models_manager
+            .pin_model_limit_candidate(limits)
+            .await
+            .ok_or_else(|| refused("native model catalog selection changed before count"))?;
+
+        // The initial matches_client_selection bound this client allocation and
+        // capture revision to these credentials. This fixed manager's original
+        // credential observation includes monotonic ABA revisions. Renew it
+        // directly here: calling matches_client_selection under the catalog guard
+        // would reenter provider callbacks. No synchronous auth guard is retained.
+        if manager
+            .with_current_api_key_credentials(credentials, |_, _| ())
+            .is_none()
+        {
+            return Err(refused(
+                "ordinary credential selection changed before count",
+            ));
+        }
+        let count = client.count_input_tokens(request).await;
+        let current = manager
+            .with_current_api_key_credentials(credentials, |_, _| ())
+            .is_some();
+        drop(catalog);
+        if !current || !captured.matches_client_selection(self, credentials) {
+            return Err(refused(
+                "ordinary credential selection changed during count",
+            ));
+        }
+        let input_tokens = count?;
+        Ok(PublicApiCountObservation {
+            _client: self,
+            captured,
+            _credentials: credentials,
+            _models_manager: models_manager,
+            limits,
+            input_tokens,
+        })
+    }
+}
+
+fn refused(message: &str) -> ApiError {
+    ApiError::InvalidRequest {
+        message: message.to_string(),
+    }
+}
