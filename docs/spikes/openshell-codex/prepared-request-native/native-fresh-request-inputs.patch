+#[tokio::test]
+async fn frozen_retains_native_version_header_and_refuses_auth_inventing_it() {
+    let transport = transport(json!({"object":"response.input_tokens", "input_tokens":7}));
+    let mut selected = provider();
+    selected
+        .headers
