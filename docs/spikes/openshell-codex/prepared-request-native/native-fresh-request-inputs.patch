+
+#[test]
+fn public_route_encodes_one_standard_body_without_replacing_the_lite_catalog_row() {
+    let mut selected_model = model();
+    selected_model.use_responses_lite = true;
+    let original_model = selected_model.clone();
+    let selected_prompt = prompt();
