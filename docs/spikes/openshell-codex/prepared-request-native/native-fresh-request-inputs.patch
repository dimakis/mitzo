+    );
+    assert_eq!(public.model_info(), &original_model);
+    assert_eq!(selected_model, original_model);
+    assert_eq!(selected_prompt.input, original_prompt.input);
+    assert_eq!(&*selected_prompt.tools, &*original_prompt.tools);
+    let restored =
+        FrozenResponsesRequest::from_encoded(public.request().encoded_body(), 128).unwrap();
+    assert_eq!(restored.body(), public.request().body());
+    assert_eq!(restored.count_body(), public.request().count_body());
+}
