+#[tokio::test]
+async fn fresh_global_instruction_observation_preserves_actual_files_without_a_session_or_cache_load()
+ {
+    use codex_extension_api::UserInstructionsProvider;
+    use codex_home::CodexHomeUserInstructionsProvider;
+    let home = tempfile::TempDir::new().unwrap();
+    let mut config = config().await;
+    config.codex_home =
+        codex_utils_absolute_path::AbsolutePathBuf::try_from(home.path().to_path_buf()).unwrap();
+    std::fs::write(home.path().join("AGENTS.md"), " fallback ").unwrap();
+    std::fs::write(home.path().join("AGENTS.override.md"), " selected λ \n").unwrap();
+    let mut manager = manager(&config);
+    let provider = Arc::new(CodexHomeUserInstructionsProvider::new(
+        config.codex_home.clone(),
+    ));
+    Arc::get_mut(&mut manager.state)
+        .unwrap()
+        .user_instructions_provider = provider.clone();
+    let mut created = manager.state.thread_created_tx.subscribe();
+    let sources = manager
+        .capture_pre_session_mcp_sources(StartThreadOptions::new(config))
+        .unwrap();
+    let observed = manager
+        .observe_pre_session_global_instructions(&sources)
+        .await
+        .unwrap();
+    let ordinary = provider.load_user_instructions().await;
+    assert_eq!(observed.instructions(), ordinary.instructions.as_ref());
+    assert_eq!(observed.instructions().unwrap().text, "selected λ");
+    manager
+        .renew_pre_session_global_instruction_observation(&sources, &observed)
+        .await
+        .unwrap();
+    std::fs::write(home.path().join("AGENTS.override.md"), "changed").unwrap();
+    assert!(
+        manager
+            .renew_pre_session_global_instruction_observation(&sources, &observed)
+            .await
+            .is_err()
+    );
+    assert!(manager.state.threads.read().await.is_empty());
+    assert!(matches!(
+        created.try_recv(),
+        Err(tokio::sync::broadcast::error::TryRecvError::Empty)
+    ));
+}
+
+#[tokio::test]
+async fn fresh_global_instruction_observation_refuses_unknown_provider_before_its_load_callback() {
+    use codex_extension_api::LoadInstructionsFuture;
+    use codex_extension_api::UserInstructionsProvider;
+    struct Stateful(Arc<AtomicUsize>);
+    impl UserInstructionsProvider for Stateful {
+        fn load_user_instructions(&self) -> LoadInstructionsFuture<'_> {
+            self.0.fetch_add(1, Ordering::SeqCst);
+            Box::pin(async { panic!("Stateful load must not run during fresh capture") })
+        }
+    }
+    let config = config().await;
+    let mut manager = manager(&config);
+    let calls = Arc::new(AtomicUsize::new(0));
+    Arc::get_mut(&mut manager.state)
+        .unwrap()
+        .user_instructions_provider = Arc::new(Stateful(Arc::clone(&calls)));
+    let sources = manager
+        .capture_pre_session_mcp_sources(StartThreadOptions::new(config))
+        .unwrap();
+    assert!(
+        manager
+            .observe_pre_session_global_instructions(&sources)
+            .await
+            .is_err()
+    );
+    assert_eq!(calls.load(Ordering::SeqCst), 0);
+    assert!(manager.state.threads.read().await.is_empty());
+}
