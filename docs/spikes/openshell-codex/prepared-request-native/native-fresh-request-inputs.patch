+    assert_eq!(
+        captured.request().body()["tools"][0]["name"],
+        json!("ReadKnowledge")
+    );
+    assert!(
+        captured.request().body()["reasoning"]
+            .get("context")
+            .is_none()
+    );
+    assert_eq!(selected_model, original);
