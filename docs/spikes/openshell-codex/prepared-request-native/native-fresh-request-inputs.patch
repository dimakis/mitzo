+    let client = ResponsesClient::new(transport.clone(), selected, Arc::new(Auth));
+    assert_eq!(client.count_input_tokens(&frozen()).await.unwrap(), 7);
+    assert_eq!(
+        transport.requests.lock().unwrap()[0]
+            .headers
+            .get("version")
+            .unwrap(),
+        "native-owned-version"
+    );
+    transport.requests.lock().unwrap().clear();
+    let auth = AppendingHeaderAuth(
+        http::HeaderName::from_static("version"),
+        HeaderValue::from_static("other"),
+    );
+    let client = ResponsesClient::new(transport.clone(), provider(), Arc::new(auth));
+    assert!(client.count_input_tokens(&frozen()).await.is_err());
+    assert!(
+        client
+            .stream_frozen_request(&frozen(), ResponsesOptions::default())
+            .await
+            .is_err()
+    );
+    assert!(transport.requests.lock().unwrap().is_empty());
+}
