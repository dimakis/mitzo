+//! Original global instruction source for fresh request assembly, without a Session.
+//! This is an observed source partition. Re-reading bytes is not an atomic source
+//! lease, whole-R currentness, measurement, one-use consume or admission authority.
+#![cfg_attr(
+    not(test),
+    allow(dead_code, reason = "Fresh prepared factory is being connected.")
+)]
+use super::ThreadManager;
+use crate::PreSessionMcpSources;
+use codex_extension_api::Instructions;
+use codex_extension_api::PreSessionUserInstructionsSource;
+use codex_extension_api::UserInstructionsProvider;
+use codex_home::CodexHomeInstructionsObservation;
+use codex_home::observe_codex_home_instructions;
+use codex_protocol::error::CodexErr;
+use codex_protocol::error::Result as CodexResult;
+use std::sync::Arc;
+
+pub(crate) struct PreSessionGlobalInstructionsObservation {
+    provider: Arc<dyn UserInstructionsProvider>,
+    source: PreSessionUserInstructionsSource,
+    observation: CodexHomeInstructionsObservation,
+}
+impl PreSessionGlobalInstructionsObservation {
+    pub(crate) fn instructions(&self) -> Option<&Instructions> {
+        self.observation.instructions()
+    }
+}
+fn unavailable() -> CodexErr {
+    CodexErr::InvalidRequest("fresh global instruction source is unavailable".to_string())
+}
+impl ThreadManager {
+    /// Resolve only registration-owned native source metadata. Never call the
+    /// legacy load/cache callback or reinterpret unavailable as an empty source.
+    pub(crate) async fn observe_pre_session_global_instructions(
+        &self,
+        sources: &PreSessionMcpSources,
+    ) -> CodexResult<PreSessionGlobalInstructionsObservation> {
+        self.validate_pre_session_mcp_sources(sources)
+            .map_err(|_| unavailable())?;
+        let provider = Arc::clone(&self.state.user_instructions_provider);
+        let source = provider.pre_session_source().ok_or_else(unavailable)?;
+        let root = match &source {
+            PreSessionUserInstructionsSource::CodexHome { codex_home }
+                if *codex_home == sources.start_options().config.codex_home =>
+            {
+                codex_home.clone()
+            }
+            _ => return Err(unavailable()),
+        };
+        let observation = observe_codex_home_instructions(root)
+            .await
+            .map_err(|_| unavailable())?;
+        self.validate_pre_session_mcp_sources(sources)
+            .map_err(|_| unavailable())?;
+        if !Arc::ptr_eq(&provider, &self.state.user_instructions_provider)
+            || provider.pre_session_source().as_ref() != Some(&source)
+        {
+            return Err(unavailable());
+        }
+        Ok(PreSessionGlobalInstructionsObservation {
+            provider,
+            source,
+            observation,
+        })
+    }
+
+    /// Observation renewal only; no caller may use this result as a later native
+    /// transaction guard. All actual source owners still need ordered commitment.
+    pub(crate) async fn renew_pre_session_global_instruction_observation(
+        &self,
+        sources: &PreSessionMcpSources,
+        original: &PreSessionGlobalInstructionsObservation,
+    ) -> CodexResult<()> {
+        if !Arc::ptr_eq(&original.provider, &self.state.user_instructions_provider) {
+            return Err(unavailable());
+        }
+        let observed = self
+            .observe_pre_session_global_instructions(sources)
+            .await?;
+        if original.source != observed.source || original.observation != observed.observation {
+            return Err(unavailable());
+        }
+        Ok(())
+    }
+}
