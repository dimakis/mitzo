diff --git a/codex-rs/core/src/session/initial_context_render.rs b/codex-rs/core/src/session/initial_context_render.rs
new file mode 100644
index 0000000..08242e4
--- /dev/null
+++ b/codex-rs/core/src/session/initial_context_render.rs
@@ -0,0 +1,305 @@
+//! Pure final rendering shared by ordinary initial context and pre-session assembly.
+//!
+//! The renderer consumes plain resolved native fragments and invokes no extension
+//! callbacks. Ordinary WorldState collection is separate and may invoke callbacks;
+//! it is not a pre-session-safe read. Neither result proves source currentness or
+//! admission. Fresh source capture still needs its actual closed owner guards.
+use crate::context::ContextualUserFragment;
+use crate::context::GuardianPolicy;
+use crate::context::ManagedDeveloperInstructions;
+use crate::context::ModelSwitchInstructions;
+use crate::context::MultiAgentRoleInstructions;
+use crate::context::RecommendedPluginsInstructions;
+use crate::context::world_state::WorldState;
+use codex_context_fragments::RenderedFragment;
+use codex_protocol::models::ResponseItem;
+use codex_protocol::protocol::MULTI_AGENT_MODE_OPEN_TAG;
+
+#[derive(Clone, Debug)]
+enum InitialFragmentPlacement {
+    ModelSwitch,
+    MultiAgentMode,
+    ManagedDeveloperInstructions,
+    SeparateDeveloper,
+    Developer,
+    User,
+}
+
+/// Immutable fragment data only. No WorldState, extension closure or trait object
+/// survives into pure rendering. This is not a source/currentness witness.
+#[derive(Clone, Debug)]
+pub(crate) struct ResolvedInitialWorldState(Vec<(InitialFragmentPlacement, RenderedFragment)>);
+
+/// Ordinary source collection, NOT a pre-session-safe read: WorldState::render_full
+/// can invoke extension render callbacks. Fresh preparation must establish closed
+/// source ownership before materializing any such state; it cannot borrow a live
+/// Session's returned fragments as that proof.
+pub(crate) fn collect_initial_world_state(world_state: &WorldState) -> ResolvedInitialWorldState {
+    let fragments = world_state
+        .render_full()
+        .into_iter()
+        .filter_map(|fragment| {
+            let placement = match fragment.role() {
+                "developer"
+                    if fragment.markers().0 == ModelSwitchInstructions::type_markers().0 =>
+                {
+                    InitialFragmentPlacement::ModelSwitch
+                }
+                "developer" if fragment.markers().0 == MULTI_AGENT_MODE_OPEN_TAG => {
+                    InitialFragmentPlacement::MultiAgentMode
+                }
+                "developer"
+                    if fragment.markers().0 == ManagedDeveloperInstructions::type_markers().0 =>
+                {
+                    InitialFragmentPlacement::ManagedDeveloperInstructions
+                }
+                "developer"
+                    if fragment.markers().0 == MultiAgentRoleInstructions::type_markers().0 =>
+                {
+                    InitialFragmentPlacement::SeparateDeveloper
+                }
+                "developer"
+                    if fragment.requires_separate_message() && fragment.markers().0.is_empty() =>
+                {
+                    InitialFragmentPlacement::SeparateDeveloper
+                }
+                "developer" => InitialFragmentPlacement::Developer,
+                "user" => InitialFragmentPlacement::User,
+                _ => return None,
+            };
+            Some((placement, fragment.render_fragment()))
+        })
+        .collect();
+    ResolvedInitialWorldState(fragments)
+}
+
+pub(crate) struct InitialContextRenderInput<'a> {
+    pub world_state: ResolvedInitialWorldState,
+    pub developer_sections: Vec<RenderedFragment>,
+    pub contextual_user_sections: Vec<RenderedFragment>,
+    pub separate_developer_sections: Vec<RenderedFragment>,
+    pub recommended_plugins: Option<RecommendedPluginsInstructions>,
+    pub separate_guardian_developer_message: bool,
+    pub developer_instructions: Option<&'a str>,
+    pub turn_id: &'a str,
+}
+
+pub(crate) fn render_initial_context(input: InitialContextRenderInput<'_>) -> Vec<ResponseItem> {
+    let InitialContextRenderInput {
+        world_state,
+        mut developer_sections,
+        mut contextual_user_sections,
+        mut separate_developer_sections,
+        recommended_plugins,
+        separate_guardian_developer_message,
+        developer_instructions,
+        turn_id,
+    } = input;
+    // Render the active mode after the usage hint so it can override that hint.
+    let mut initial_multi_agent_mode = None;
+    let mut managed_developer_instructions = None;
+    for (placement, fragment) in world_state.0 {
+        match placement {
+            InitialFragmentPlacement::ModelSwitch => developer_sections.insert(0, fragment),
+            InitialFragmentPlacement::MultiAgentMode => initial_multi_agent_mode = Some(fragment),
+            InitialFragmentPlacement::ManagedDeveloperInstructions => {
+                managed_developer_instructions = Some(fragment)
+            }
+            InitialFragmentPlacement::SeparateDeveloper => {
+                separate_developer_sections.push(fragment)
+            }
+            InitialFragmentPlacement::Developer => developer_sections.push(fragment),
+            InitialFragmentPlacement::User => contextual_user_sections.push(fragment),
+        }
+    }
+
+    if let Some(recommended_plugins) = recommended_plugins {
+        developer_sections.push(recommended_plugins.render_fragment());
+    }
+
+    let mut items = Vec::with_capacity(4);
+    if let Some(developer_message) =
+        crate::context_manager::updates::build_rendered_message(developer_sections)
+    {
+        items.push(developer_message);
+    }
+    for section in separate_developer_sections {
+        if let Some(developer_message) =
+            crate::context_manager::updates::build_rendered_message(vec![section])
+        {
+            items.push(developer_message);
+        }
+    }
+    if let Some(initial_multi_agent_mode) = initial_multi_agent_mode
+        && let Some(message) =
+            crate::context_manager::updates::build_rendered_message(vec![initial_multi_agent_mode])
+    {
+        items.push(message);
+    }
+    if let Some(contextual_user_message) =
+        crate::context_manager::updates::build_rendered_message(contextual_user_sections)
+    {
+        items.push(contextual_user_message);
+    }
+    // Emit the guardian policy prompt as a separate developer item so the guardian
+    // subagent sees a distinct, easy-to-audit instruction block.
+    if separate_guardian_developer_message
+        && let Some(developer_instructions) = developer_instructions
+        && !developer_instructions.is_empty()
+        && let Some(guardian_developer_message) =
+            crate::context_manager::updates::build_rendered_message(vec![
+                GuardianPolicy::new(developer_instructions).render_fragment(),
+            ])
+    {
+        items.push(guardian_developer_message);
+    }
+    if let Some(managed_developer_instructions) = managed_developer_instructions
+        && let Some(message) = crate::context_manager::updates::build_rendered_message(vec![
+            managed_developer_instructions,
+        ])
+    {
+        items.push(message);
+    }
+    // New context windows and compaction install these items directly into replacement history.
+    for item in &mut items {
+        item.set_turn_id_if_missing(turn_id);
+    }
+    items
+}
+
+#[cfg(test)]
+mod tests {
+    use super::InitialContextRenderInput;
+    use super::collect_initial_world_state;
+    use super::render_initial_context;
+    use crate::context::ContextualUserFragment;
+    use crate::context::DeveloperInstructions;
+    use crate::context::GuardianPolicy;
+    use crate::context::UserInstructions;
+    use crate::context::world_state::ModelInstructionsState;
+    use crate::context::world_state::WorldState;
+    use codex_protocol::models::ContentItem;
+    use codex_protocol::models::ResponseItem;
+    use pretty_assertions::assert_eq;
+
+    fn text(item: &ResponseItem) -> Vec<&str> {
+        let ResponseItem::Message { content, .. } = item else {
+            panic!("Expected native context message");
+        };
+        content
+            .iter()
+            .map(|content| match content {
+                ContentItem::InputText { text } => text.as_str(),
+                _ => panic!("Expected native instruction text"),
+            })
+            .collect()
+    }
+
+    #[test]
+    fn shared_render_preserves_native_order_knowledge_user_bytes_and_isolated_policy() {
+        let mut world_state = WorldState::default();
+        world_state.add_section(ModelInstructionsState::new(
+            "gpt-6-luna",
+            Some("prior-model"),
+            "actual native model instructions".into(),
+        ));
+        let knowledge = "Selected Knowledge\n  retained whitespace λ\n";
+        let items = render_initial_context(InitialContextRenderInput {
+            world_state: collect_initial_world_state(&world_state),
+            developer_sections: vec![DeveloperInstructions::new(knowledge).render_fragment()],
+            contextual_user_sections: vec![
+                UserInstructions {
+                    directory: Some("/retained/workspace".into()),
+                    text: "Actual selected project instructions".into(),
+                }
+                .render_fragment(),
+            ],
+            separate_developer_sections: vec![
+                GuardianPolicy::new("separate native hint").render_fragment(),
+            ],
+            recommended_plugins: None,
+            separate_guardian_developer_message: true,
+            developer_instructions: Some("isolated native guardian policy"),
+            turn_id: "original-turn",
+        });
+        let roles: Vec<_> = items
+            .iter()
+            .map(|item| match item {
+                ResponseItem::Message { role, .. } => role.as_str(),
+                _ => panic!("Expected native context message"),
+            })
+            .collect();
+        assert_eq!(roles, ["developer", "developer", "user", "developer"]);
+        let first = text(&items[0]);
+        std::assert!(first[0].contains("actual native model instructions"));
+        assert_eq!(first[1], knowledge);
+        assert_eq!(text(&items[1]), ["separate native hint"]);
+        std::assert!(text(&items[2])[0].contains("Actual selected project instructions"));
+        assert_eq!(text(&items[3]), ["isolated native guardian policy"]);
+        std::assert!(
+            items
+                .iter()
+                .all(|item| item.turn_id() == Some("original-turn"))
+        );
+    }
+
+    #[test]
+    fn shared_render_does_not_invent_context_or_a_native_turn_for_empty_inputs() {
+        let world_state = WorldState::default();
+        let items = render_initial_context(InitialContextRenderInput {
+            world_state: collect_initial_world_state(&world_state),
+            developer_sections: Vec::new(),
+            contextual_user_sections: Vec::new(),
+            separate_developer_sections: Vec::new(),
+            recommended_plugins: None,
+            separate_guardian_developer_message: false,
+            developer_instructions: Some("ordinary collector already owns this fragment"),
+            turn_id: "",
+        });
+        std::assert!(items.is_empty());
+    }
+    #[test]
+    fn pure_render_cannot_reenter_an_actual_extension_world_state_callback() {
+        use codex_extension_api::RenderedWorldStateFragment;
+        use codex_extension_api::WorldStateSectionContribution;
+        use std::sync::Arc;
+        use std::sync::atomic::AtomicUsize;
+        use std::sync::atomic::Ordering;
+
+        let calls = Arc::new(AtomicUsize::new(0));
+        let observed = Arc::clone(&calls);
+        let mut world_state = WorldState::default();
+        world_state.add_extension_section(WorldStateSectionContribution::new(
+            "initial_render_test",
+            serde_json::json!({"version": 1}),
+            move |_| {
+                observed.fetch_add(1, Ordering::SeqCst);
+                Some(RenderedWorldStateFragment::new(
+                    "developer",
+                    ("", ""),
+                    "resolved extension instructions",
+                ))
+            },
+        ));
+        let resolved = collect_initial_world_state(&world_state);
+        assert_eq!(calls.load(Ordering::SeqCst), 1);
+        let render = |world_state| {
+            render_initial_context(InitialContextRenderInput {
+                world_state,
+                developer_sections: Vec::new(),
+                contextual_user_sections: Vec::new(),
+                separate_developer_sections: Vec::new(),
+                recommended_plugins: None,
+                separate_guardian_developer_message: false,
+                developer_instructions: None,
+                turn_id: "",
+            })
+        };
+        let first = render(resolved.clone());
+        let second = render(resolved);
+        assert_eq!(calls.load(Ordering::SeqCst), 1);
+        assert_eq!(first, second);
+        assert_eq!(text(&first[0]), ["resolved extension instructions"]);
+        std::assert!(first[0].turn_id().is_none());
+    }
+}
