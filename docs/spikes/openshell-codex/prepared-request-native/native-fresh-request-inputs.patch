@@ -0,0 +1,139 @@
+//! Source-owned provider/header observation. Environment values are read once
+//! into the same provider conversion used by ordinary requests. This is neither
+//! an account grant nor an atomic environment lease; renew observations at every
+//! owner boundary and reuse the retained provider for count and frozen dispatch.
+use super::*;
+use std::collections::HashSet;
+use std::ffi::OsString;
+
+/// Immutable process-local provider capture; no serialization or source callback.
+/// Retaining this does not establish source currentness at a later transaction.
+pub struct CapturedApiProvider {
+    provider: ApiProvider,
+    environment: Vec<(String, Option<OsString>)>,
+    residency: Option<ResidencyRequirement>,
+}
+impl CapturedApiProvider {
+    pub fn provider(&self) -> &ApiProvider {
+        &self.provider
+    }
+
+    /// Observation renewal only, never a permit for a later operation. A process
+    /// environment can change immediately afterwards; the frozen request continues
+    /// using its original provider rather than independently converting again.
+    pub fn sources_match_current_observation(&self) -> bool {
+        self.residency == read_managed_residency_requirement()
+            && self
+                .environment
+                .iter()
+                .all(|(name, value)| std::env::var_os(name) == *value)
+    }
+}
+fn unavailable() -> CodexErr {
+    CodexErr::InvalidRequest("selected provider headers cannot be captured".to_string())
+}
+impl ModelProviderInfo {
+    /// Resolve the actual configured literal/environment headers once. Malformed
+    /// values refuse instead of silently omitting configured request material.
+    /// Ordinary permissive conversion retains its existing behavior separately.
+    pub fn capture_api_provider(
+        &self,
+        auth_mode: Option<AuthMode>,
+    ) -> CodexResult<CapturedApiProvider> {
+        let mut headers = HeaderMap::new();
+        let mut literal_names = HashSet::new();
+        if let Some(literals) = &self.http_headers {
+            for (name, value) in literals {
+                let name = HeaderName::try_from(name.as_str()).map_err(|_| unavailable())?;
+                if !literal_names.insert(name.clone()) {
+                    return Err(unavailable());
+                }
+                headers.insert(
+                    name,
+                    HeaderValue::try_from(value.as_str()).map_err(|_| unavailable())?,
+                );
+            }
+        }
+        let mut environment = Vec::new();
+        let mut env_names = HashSet::new();
+        if let Some(sources) = &self.env_http_headers {
+            for (name, variable) in sources {
+                let name = HeaderName::try_from(name.as_str()).map_err(|_| unavailable())?;
+                if !env_names.insert(name.clone())
+                    || variable.is_empty()
+                    || variable.contains(['=', '\0'])
+                {
+                    return Err(unavailable());
+                }
+                let value = std::env::var_os(variable);
+                if let Some(value) = &value {
+                    let value = value.to_str().ok_or_else(unavailable)?;
+                    if !value.trim().is_empty() {
+                        headers.insert(
+                            name,
+                            HeaderValue::try_from(value).map_err(|_| unavailable())?,
+                        );
+                    }
+                }
+                environment.push((variable.clone(), value));
+            }
+        }
+        let residency = read_managed_residency_requirement();
+        let provider = self.api_provider_with_headers(auth_mode, headers, residency)?;
+        let captured = CapturedApiProvider {
+            provider,
+            environment,
+            residency,
+        };
+        if !captured.sources_match_current_observation() {
+            return Err(unavailable());
+        }
+        Ok(captured)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use pretty_assertions::assert_eq;
+
+    #[test]
+    fn native_default_headers_survive_the_same_provider_conversion() {
+        let info = ModelProviderInfo::create_openai_provider(None);
+        let captured = info.capture_api_provider(Some(AuthMode::ApiKey)).unwrap();
+        let ordinary = info.to_api_provider(Some(AuthMode::ApiKey)).unwrap();
+        assert_eq!(captured.provider().headers, ordinary.headers);
+        assert_eq!(captured.provider().base_url, ordinary.base_url);
+        assert_eq!(
+            captured.provider().headers.get("version").unwrap(),
+            env!("CARGO_PKG_VERSION")
+        );
+        assert!(captured.sources_match_current_observation());
+    }
+
+    #[test]
+    fn capture_refuses_malformed_or_case_ambiguous_literals_without_changing_ordinary_conversion() {
+        for literals in [
+            HashMap::from([("version".to_string(), "bad\nheader".to_string())]),
+            HashMap::from([
+                ("version".to_string(), "one".to_string()),
+                ("Version".to_string(), "two".to_string()),
+            ]),
+        ] {
+            let mut info = ModelProviderInfo::create_openai_provider(None);
+            info.http_headers = Some(literals);
+            assert!(info.capture_api_provider(Some(AuthMode::ApiKey)).is_err());
+            assert!(info.to_api_provider(Some(AuthMode::ApiKey)).is_ok());
+        }
+    }
+
+    #[test]
+    fn capture_refuses_unreadable_environment_source_names_without_accessing_them() {
+        let mut info = ModelProviderInfo::create_openai_provider(None);
+        info.env_http_headers = Some(HashMap::from([(
+            "OpenAI-Project".to_string(),
+            "invalid=variable".to_string(),
+        )]));
+        assert!(info.capture_api_provider(Some(AuthMode::ApiKey)).is_err());
+    }
+}
