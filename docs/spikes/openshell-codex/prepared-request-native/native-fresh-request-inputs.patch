diff --git a/codex-rs/codex-home/src/pre_session_instructions.rs b/codex-rs/codex-home/src/pre_session_instructions.rs
new file mode 100644
index 0000000..9daf389
--- /dev/null
+++ b/codex-rs/codex-home/src/pre_session_instructions.rs
@@ -0,0 +1,249 @@
+//! Bounded read-only observations of the actual global instruction source.
+//!
+//! No provider load/cache callback, warning suppression or history mutation runs
+//! here. Observed file metadata and bytes are not an atomic currentness/lease or
+//! a count/admission grant. The complete factory must bind this to its real
+//! provider/configuration and renew all actual source authorities at commitment.
+use crate::instructions::DEFAULT_AGENTS_MD_FILENAME;
+use crate::instructions::LOCAL_AGENTS_MD_FILENAME;
+use crate::instructions::decode_instructions;
+use codex_extension_api::Instructions;
+use codex_utils_absolute_path::AbsolutePathBuf;
+use std::io;
+use std::time::SystemTime;
+use tokio::io::AsyncReadExt;
+
+const MAX_CANDIDATE_BYTES: u64 = 4 * 1024 * 1024;
+
+#[derive(Debug, Eq, PartialEq)]
+struct MetadataObservation {
+    len: u64,
+    modified: Option<SystemTime>,
+    created: Option<SystemTime>,
+    readonly: bool,
+    file: bool,
+    directory: bool,
+    symlink: bool,
+    #[cfg(unix)]
+    unix: (u64, u64, u32, u32, u32, u64, i64, i64),
+}
+impl MetadataObservation {
+    fn from_metadata(metadata: &std::fs::Metadata) -> Self {
+        #[cfg(unix)]
+        use std::os::unix::fs::MetadataExt;
+        Self {
+            len: metadata.len(),
+            modified: metadata.modified().ok(),
+            created: metadata.created().ok(),
+            readonly: metadata.permissions().readonly(),
+            file: metadata.is_file(),
+            directory: metadata.is_dir(),
+            symlink: metadata.file_type().is_symlink(),
+            #[cfg(unix)]
+            unix: (
+                metadata.dev(),
+                metadata.ino(),
+                metadata.mode(),
+                metadata.uid(),
+                metadata.gid(),
+                metadata.nlink(),
+                metadata.ctime(),
+                metadata.ctime_nsec(),
+            ),
+        }
+    }
+}
+
+#[derive(Debug, Eq, PartialEq)]
+enum CandidateObservation {
+    Absent,
+    NonFile {
+        link: MetadataObservation,
+        target: MetadataObservation,
+    },
+    File {
+        link: MetadataObservation,
+        target: MetadataObservation,
+        bytes: Vec<u8>,
+    },
+}
+
+/// Private, non-serializable source observation; never a provider or filesystem
+/// authorization capability. Every tested precedence candidate is retained.
+#[derive(Debug, Eq, PartialEq)]
+pub struct CodexHomeInstructionsObservation {
+    root: AbsolutePathBuf,
+    root_link: MetadataObservation,
+    root_target: MetadataObservation,
+    candidates: Vec<(&'static str, CandidateObservation)>,
+    instructions: Option<Instructions>,
+}
+impl CodexHomeInstructionsObservation {
+    pub fn instructions(&self) -> Option<&Instructions> {
+        self.instructions.as_ref()
+    }
+    pub fn codex_home(&self) -> &AbsolutePathBuf {
+        &self.root
+    }
+}
+
+fn changed() -> io::Error {
+    io::Error::other("global instruction source changed during observation")
+}
+
+/// Uses the ordinary owner's exact override/default order and decoder. A read
+/// error is unavailable, never cached fallback or confirmed empty instructions.
+/// Does not create a directory/file or mutate the provider's fallback/warnings.
+pub async fn observe_codex_home_instructions(
+    codex_home: AbsolutePathBuf,
+) -> io::Result<CodexHomeInstructionsObservation> {
+    let root_link = MetadataObservation::from_metadata(
+        &tokio::fs::symlink_metadata(codex_home.as_path()).await?,
+    );
+    let root_target =
+        MetadataObservation::from_metadata(&tokio::fs::metadata(codex_home.as_path()).await?);
+    if !root_target.directory {
+        return Err(io::Error::other(
+            "global instruction source root is unavailable",
+        ));
+    }
+    let mut candidates = Vec::with_capacity(2);
+    let mut instructions = None;
+    for name in [LOCAL_AGENTS_MD_FILENAME, DEFAULT_AGENTS_MD_FILENAME] {
+        let path = codex_home.join(name);
+        let link = match tokio::fs::symlink_metadata(path.as_path()).await {
+            Ok(value) => MetadataObservation::from_metadata(&value),
+            Err(error) if error.kind() == io::ErrorKind::NotFound => {
+                candidates.push((name, CandidateObservation::Absent));
+                continue;
+            }
+            Err(error) => return Err(error),
+        };
+        let metadata = tokio::fs::metadata(path.as_path()).await?;
+        if !metadata.is_file() {
+            candidates.push((
+                name,
+                CandidateObservation::NonFile {
+                    link,
+                    target: MetadataObservation::from_metadata(&metadata),
+                },
+            ));
+            continue;
+        }
+        let mut file = tokio::fs::File::open(path.as_path()).await?;
+        let target = MetadataObservation::from_metadata(&file.metadata().await?);
+        if !target.file || target.len > MAX_CANDIDATE_BYTES {
+            return Err(io::Error::other(
+                "global instruction source exceeds supported capture bounds",
+            ));
+        }
+        let mut bytes = Vec::new();
+        (&mut file)
+            .take(MAX_CANDIDATE_BYTES + 1)
+            .read_to_end(&mut bytes)
+            .await?;
+        if bytes.len() as u64 > MAX_CANDIDATE_BYTES {
+            return Err(io::Error::other(
+                "global instruction source exceeds supported capture bounds",
+            ));
+        }
+        if MetadataObservation::from_metadata(&file.metadata().await?) != target
+            || MetadataObservation::from_metadata(&tokio::fs::metadata(path.as_path()).await?)
+                != target
+            || MetadataObservation::from_metadata(
+                &tokio::fs::symlink_metadata(path.as_path()).await?,
+            ) != link
+        {
+            return Err(changed());
+        }
+        instructions = decode_instructions(&bytes, path);
+        candidates.push((
+            name,
+            CandidateObservation::File {
+                link,
+                target,
+                bytes,
+            },
+        ));
+        if instructions.is_some() {
+            break;
+        }
+    }
+    if MetadataObservation::from_metadata(&tokio::fs::symlink_metadata(codex_home.as_path()).await?)
+        != root_link
+        || MetadataObservation::from_metadata(&tokio::fs::metadata(codex_home.as_path()).await?)
+            != root_target
+    {
+        return Err(changed());
+    }
+    Ok(CodexHomeInstructionsObservation {
+        root: codex_home,
+        root_link,
+        root_target,
+        candidates,
+        instructions,
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::MAX_CANDIDATE_BYTES;
+    use super::observe_codex_home_instructions;
+    use crate::CodexHomeUserInstructionsProvider;
+    use codex_extension_api::UserInstructionsProvider;
+    use codex_utils_absolute_path::AbsolutePathBuf;
+    use pretty_assertions::assert_eq;
+
+    fn root(home: &tempfile::TempDir) -> AbsolutePathBuf {
+        AbsolutePathBuf::try_from(home.path().to_path_buf()).unwrap()
+    }
+
+    #[tokio::test]
+    async fn fresh_observation_matches_ordinary_precedence_decoder_and_detects_replacement() {
+        let home = tempfile::TempDir::new().unwrap();
+        std::fs::write(home.path().join("AGENTS.md"), b"  actual fallback \xff  ").unwrap();
+        std::fs::write(home.path().join("AGENTS.override.md"), "  \n ").unwrap();
+        let provider = CodexHomeUserInstructionsProvider::new(root(&home));
+        let observed = observe_codex_home_instructions(root(&home)).await.unwrap();
+        let ordinary = provider.load_user_instructions().await;
+        assert_eq!(observed.instructions(), ordinary.instructions.as_ref());
+        assert_eq!(observed.instructions().unwrap().text, "actual fallback �");
+        std::fs::write(home.path().join("AGENTS.override.md"), "actual override").unwrap();
+        let changed = observe_codex_home_instructions(root(&home)).await.unwrap();
+        std::assert!(observed != changed);
+        assert_eq!(changed.instructions().unwrap().text, "actual override");
+    }
+
+    #[tokio::test]
+    async fn fresh_observation_bounds_sources_without_truncation_or_directory_creation() {
+        let home = tempfile::TempDir::new().unwrap();
+        let missing = root(&home).join("missing");
+        std::assert!(
+            observe_codex_home_instructions(missing.clone())
+                .await
+                .is_err()
+        );
+        std::assert!(!missing.as_path().exists());
+        let file = std::fs::File::create(home.path().join("AGENTS.override.md")).unwrap();
+        file.set_len(MAX_CANDIDATE_BYTES + 1).unwrap();
+        std::assert!(observe_codex_home_instructions(root(&home)).await.is_err());
+        assert_eq!(file.metadata().unwrap().len(), MAX_CANDIDATE_BYTES + 1);
+    }
+
+    #[cfg(unix)]
+    #[tokio::test]
+    async fn fresh_failure_never_consumes_ordinary_fallback_or_warning_state() {
+        let home = tempfile::TempDir::new().unwrap();
+        let path = home.path().join("AGENTS.override.md");
+        std::fs::write(&path, "last ordinary snapshot").unwrap();
+        let provider = CodexHomeUserInstructionsProvider::new(root(&home));
+        let previous = provider.load_user_instructions().await;
+        std::fs::remove_file(&path).unwrap();
+        std::os::unix::fs::symlink("AGENTS.override.md", &path).unwrap();
+        std::assert!(observe_codex_home_instructions(root(&home)).await.is_err());
+        let ordinary = provider.load_user_instructions().await;
+        assert_eq!(ordinary.instructions, previous.instructions);
+        assert_eq!(ordinary.warnings.len(), 1);
+        std::assert!(provider.load_user_instructions().await.warnings.is_empty());
+    }
+}
