diff --git a/codex-rs/core/src/tools/approvals/parent_consumer_routing_tests.rs b/codex-rs/core/src/tools/approvals/parent_consumer_routing_tests.rs
new file mode 100644
index 0000000..d045b57
--- /dev/null
+++ b/codex-rs/core/src/tools/approvals/parent_consumer_routing_tests.rs
@@ -0,0 +1,506 @@
+//! Future active-wire regressions through the actual scoped approval owner; no parent grant.
+use super::*;
+use crate::session::InterceptedApprovalSelection;
+use crate::tasks::SessionTask;
+use crate::tasks::SessionTaskResult;
+use codex_protocol::protocol::GuardianCommandSource;
+use codex_protocol::protocol::TurnAbortReason;
+use codex_protocol::protocol::TurnSettingsUpdate;
+use codex_protocol::protocol::TurnSettingsUpdateOutcome;
+use pretty_assertions::assert_eq;
+use uuid::Uuid;
+
+struct PendingTask;
+impl SessionTask for PendingTask {
+    fn kind(&self) -> crate::state::TaskKind {
+        crate::state::TaskKind::Regular
+    }
+    fn span_name(&self) -> &'static str {
+        "parent_consumer_routing"
+    }
+    async fn run(
+        self: Arc<Self>,
+        _session: Arc<Session>,
+        _turn: Arc<crate::session::turn_context::TurnContext>,
+        _input: Vec<crate::session::TurnInput>,
+        cancellation: CancellationToken,
+    ) -> SessionTaskResult {
+        cancellation.cancelled().await;
+        Ok(None)
+    }
+}
+struct ActiveCase {
+    fixture: Fixture,
+    entered: Arc<Notify>,
+    release: Arc<Notify>,
+}
+impl Drop for ActiveCase {
+    fn drop(&mut self) {
+        self.release.notify_one();
+        // Panic/setup-timeout fallback only. Ordinary cleanup below is awaited and bounded.
+        if let Ok(active) = self.fixture.session.active_turn.try_lock()
+            && let Some(task) = active.as_ref().and_then(|active| active.task.as_ref())
+        {
+            task.cancellation_token.cancel();
+        }
+    }
+}
+impl ActiveCase {
+    async fn new(decision: Option<ApprovalDecision>, gated: bool) -> anyhow::Result<Self> {
+        let entered = Arc::new(Notify::new());
+        let release = Arc::new(Notify::new());
+        // Existing Fixture creates no active task; timeout cannot strand a pending task here.
+        let fixture = tokio::time::timeout(
+            Duration::from_secs(15),
+            Fixture::new(
+                decision,
+                gated.then(|| (Arc::clone(&entered), Arc::clone(&release))),
+                /*panic*/ false,
+            ),
+        )
+        .await??;
+        let mut case = Self {
+            fixture,
+            entered,
+            release,
+        };
+        let setup = tokio::time::timeout(Duration::from_secs(10), async {
+            assert!(
+                !case
+                    .fixture
+                    .step
+                    .turn
+                    .config
+                    .features
+                    .enabled(codex_features::Feature::GuardianV2)
+            );
+            case.fixture
+                .session
+                .start_task(Arc::clone(&case.fixture.step.turn), Vec::new(), PendingTask)
+                .await;
+            case.fixture
+                .session
+                .services
+                .turn_environments
+                .snapshot()
+                .await;
+            let (turn, settings, environments, strict) = case
+                .fixture
+                .session
+                .active_turn_context_and_strict_auto_review()
+                .await
+                .ok_or_else(|| anyhow::anyhow!("actual active routing task"))?;
+            assert!(!strict);
+            assert!(Arc::ptr_eq(&turn, &case.fixture.step.turn));
+            let step = Arc::get_mut(&mut case.fixture.step).expect("actual fixture owns its Step");
+            step.settings = settings;
+            step.environments = environments;
+            Ok::<_, anyhow::Error>(())
+        })
+        .await
+        .map_err(anyhow::Error::from)
+        .and_then(|result| result);
+        if let Err(error) = setup {
+            let close = tokio::time::timeout(
+                Duration::from_secs(5),
+                case.fixture
+                    .session
+                    .abort_all_tasks(TurnAbortReason::Interrupted),
+            )
+            .await;
+            return Err(error.context(format!("setup close={close:?}")));
+        }
+        Ok(case)
+    }
+    async fn selected(&self) -> anyhow::Result<InterceptedApprovalSelection> {
+        let program = AbsolutePathBuf::current_dir()?.join("actual-scoped-review-program");
+        let context = self.fixture.context(/*cancellation_token*/ None);
+        let action = ApprovalAction::Execve {
+            id: context.call_id.clone(),
+            approval_id: Uuid::new_v4().to_string(),
+            environment_id: self
+                .fixture
+                .step
+                .environments
+                .primary()
+                .unwrap()
+                .selection
+                .environment_id
+                .clone(),
+            source: GuardianCommandSource::UnifiedExec,
+            program: program.clone(),
+            argv: vec!["literal-argv-zero".into(), "argument".into()],
+            command: vec![program.to_string_lossy().into_owned(), "argument".into()],
+            cwd: AbsolutePathBuf::current_dir()?.join("literal-child-cwd"),
+            additional_permissions: None,
+        };
+        Ok(self
+            .fixture
+            .session
+            .capture_intercepted_approval_selection(
+                action,
+                &context.call_id,
+                &context.tool_name,
+                &context.review_context,
+                self.fixture.session.services.exec_policy.current(),
+            )
+            .await
+            .map_err(|error| anyhow::anyhow!("selection: {error:?}"))?)
+    }
+    async fn finish(self, result: anyhow::Result<()>) -> anyhow::Result<()> {
+        self.release.notify_one();
+        let hooks = self.fixture.session.hooks();
+        let hook_close = tokio::time::timeout(Duration::from_secs(5), hooks.shutdown()).await;
+        let close = tokio::time::timeout(
+            Duration::from_secs(5),
+            self.fixture
+                .session
+                .abort_all_tasks(TurnAbortReason::Interrupted),
+        )
+        .await;
+        match (result, hook_close, close) {
+            (Ok(()), Ok(()), Ok(())) => Ok(()),
+            (Err(error), hooks, task) => {
+                Err(error.context(format!("cleanup hooks={hooks:?} task={task:?}")))
+            }
+            (Ok(()), hooks, task) => anyhow::bail!("cleanup hooks={hooks:?} task={task:?}"),
+        }
+    }
+    fn no_manual(&self) {
+        assert!(
+            !std::iter::from_fn(|| self.fixture._events.try_recv().ok())
+                .any(|event| matches!(event.msg, EventMsg::ExecApprovalRequest(_)))
+        );
+    }
+}
+async fn bounded(
+    body: impl std::future::Future<Output = anyhow::Result<()>>,
+) -> anyhow::Result<()> {
+    tokio::time::timeout(Duration::from_secs(15), body).await?
+}
+
+#[tokio::test]
+async fn no_parent_default_and_explicit_ask_user_execute_once_and_preserve_child_bytes()
+-> anyhow::Result<()> {
+    for decision in [None, Some(ApprovalDecision::AskUser)] {
+        let case = ActiveCase::new(decision, /*gated*/ false).await?;
+        let result = bounded(async {
+            let selected = case.selected().await?;
+            let (action, _) = selected.approval_request();
+            let ApprovalAction::Execve { approval_id, command, cwd, .. } = action else { unreachable!() };
+            let request = case.fixture.session.request_intercepted_approval(&selected, /*parent*/ None);
+            tokio::pin!(request);
+            let review = loop {
+                tokio::select! {
+                    result = &mut request => anyhow::bail!("expected real user prompt: {result:?}"),
+                    event = case.fixture._events.recv() => if let EventMsg::ExecApprovalRequest(event) = event?.msg {
+                        assert_eq!(event.call_id, "routing");
+                        assert_eq!(event.approval_id.as_deref(), Some(approval_id.as_str()));
+                        assert_eq!(event.command, command);
+                        assert_eq!(event.cwd, cwd);
+                        case.fixture.session.notify_approval(&approval_id, ReviewDecision::Approved).await;
+                        break request.await;
+                    }
+                }
+            };
+            assert_eq!(review.map_err(|error| anyhow::anyhow!("approval: {error:?}"))?, ReviewDecision::Approved);
+            assert_eq!(case.fixture.calls.load(Ordering::SeqCst), 1);
+            case.no_manual();
+            Ok(())
+        }).await;
+        case.finish(result).await?;
+    }
+    Ok(())
+}
+
+#[derive(Clone, Copy, Debug)]
+enum Drift {
+    Config,
+    Policy,
+    Environment,
+    Settings,
+    Strict,
+    Task,
+    Cancel,
+}
+async fn drift(
+    case: &ActiveCase,
+    kind: Drift,
+) -> anyhow::Result<Option<tokio_util::sync::DropGuard>> {
+    let session = &case.fixture.session;
+    match kind {
+        Drift::Config => {
+            let original = session.get_config().await;
+            session
+                .refresh_runtime_config(original.as_ref().clone())
+                .await;
+            assert!(!Arc::ptr_eq(&original, &session.get_config().await));
+        }
+        Drift::Policy => {
+            let original = session.services.exec_policy.current();
+            let home = tempfile::tempdir()?;
+            session
+                .services
+                .exec_policy
+                .append_amendment_and_update(
+                    home.path(),
+                    &codex_protocol::protocol::ExecPolicyAmendment {
+                        command: vec!["unrelated-scoped-change".into()],
+                    },
+                )
+                .await?;
+            assert!(!Arc::ptr_eq(
+                &original,
+                &session.services.exec_policy.current()
+            ));
+        }
+        Drift::Environment => {
+            let before = session.services.turn_environments.observe_selected();
+            let projected = session.services.turn_environments.selections();
+            let mut changed = before.snapshot().primary().unwrap().config().clone();
+            changed.permission_profile =
+                crate::config::PermissionProfileSnapshot::legacy(PermissionProfile::Disabled);
+            session
+                .services
+                .turn_environments
+                .set_active_thread_defaults(changed);
+            let after = session.services.turn_environments.observe_selected();
+            assert_eq!(session.services.turn_environments.selections(), projected);
+            assert_ne!(
+                before.snapshot().primary().unwrap().selection.config,
+                after.snapshot().primary().unwrap().selection.config
+            );
+            assert!(Arc::ptr_eq(
+                &before.snapshot().primary().unwrap().environment,
+                &after.snapshot().primary().unwrap().environment
+            ));
+        }
+        Drift::Settings => {
+            assert!(matches!(
+                session
+                    .apply_parent_test_turn_settings(
+                        &case.fixture.step.turn.sub_id,
+                        TurnSettingsUpdate {
+                            approvals_reviewer: Some(ApprovalsReviewer::User),
+                            ..Default::default()
+                        }
+                    )
+                    .await,
+                TurnSettingsUpdateOutcome::Applied
+            ));
+        }
+        Drift::Strict => {
+            let state = Arc::clone(
+                &session
+                    .active_turn
+                    .lock()
+                    .await
+                    .as_ref()
+                    .unwrap()
+                    .turn_state,
+            );
+            state.lock().await.enable_strict_auto_review();
+        }
+        Drift::Task => {
+            let before = Arc::clone(
+                &session
+                    .active_turn
+                    .lock()
+                    .await
+                    .as_ref()
+                    .unwrap()
+                    .task
+                    .as_ref()
+                    .unwrap()
+                    .done,
+            );
+            session.abort_all_tasks(TurnAbortReason::Replaced).await;
+            session
+                .start_task(Arc::clone(&case.fixture.step.turn), Vec::new(), PendingTask)
+                .await;
+            let active = session.active_turn.lock().await;
+            let task = active.as_ref().unwrap().task.as_ref().unwrap();
+            assert!(!Arc::ptr_eq(&before, &task.done));
+            assert!(!task.cancellation_token.is_cancelled());
+            return Ok(Some(task.cancellation_token.clone().drop_guard()));
+        }
+        Drift::Cancel => session
+            .active_turn
+            .lock()
+            .await
+            .as_ref()
+            .unwrap()
+            .task
+            .as_ref()
+            .unwrap()
+            .cancellation_token
+            .cancel(),
+    }
+    Ok(None)
+}
+#[tokio::test]
+async fn every_default_or_explicit_user_route_refuses_actual_callback_context_drift()
+-> anyhow::Result<()> {
+    for decision in [None, Some(ApprovalDecision::AskUser)] {
+        for kind in [
+            Drift::Config,
+            Drift::Policy,
+            Drift::Environment,
+            Drift::Settings,
+            Drift::Strict,
+            Drift::Task,
+            Drift::Cancel,
+        ] {
+            let case = ActiveCase::new(decision.clone(), /*gated*/ true).await?;
+            let result = bounded(async {
+                let selected = case.selected().await?;
+                let review = case.fixture.session.request_intercepted_approval(&selected, /*parent*/ None);
+                tokio::pin!(review);
+                tokio::select! {
+                    _ = case.entered.notified() => {},
+                    result = &mut review => anyhow::bail!("expected actual contributor gate: {result:?}"),
+                }
+                let replacement = drift(&case, kind).await?;
+                case.release.notify_one();
+                assert!(matches!(review.await, Err(ToolError::Rejected(message))
+                    if message == "intercepted execution approval context changed during review"), "{kind:?}");
+                assert_eq!(case.fixture.calls.load(Ordering::SeqCst), 1);
+                case.no_manual();
+                drop(replacement); // keep actual replacement task live until after the assertion
+                Ok(())
+            }).await;
+            case.finish(result).await?;
+        }
+    }
+    Ok(())
+}
+
