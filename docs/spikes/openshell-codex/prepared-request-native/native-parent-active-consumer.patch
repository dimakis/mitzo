+#[tokio::test]
+async fn strict_reviewed_abort_never_enters_a_model_or_manual_fallback() -> anyhow::Result<()> {
+    let case = ActiveCase::new(
+        Some(ApprovalDecision::Reviewed(ReviewDecision::Abort)),
+        /*gated*/ false,
+    )
+    .await?;
+    let result = bounded(async {
+        let state = Arc::clone(
+            &case
+                .fixture
+                .session
+                .active_turn
+                .lock()
+                .await
+                .as_ref()
+                .unwrap()
+                .turn_state,
+        );
+        state.lock().await.enable_strict_auto_review();
+        let selected = case.selected().await?;
+        let (_, context) = selected.approval_request();
+        assert!(context.strict_auto_review);
+        assert!(matches!(
+            case.fixture
+                .session
+                .request_intercepted_approval(&selected, /*parent*/ None)
+                .await,
+            Err(ToolError::Codex(CodexErr::TurnAborted))
+        ));
+        assert_eq!(case.fixture.calls.load(Ordering::SeqCst), 1);
+        case.no_manual();
+        Ok(())
+    })
+    .await;
+    case.finish(result).await
+}
