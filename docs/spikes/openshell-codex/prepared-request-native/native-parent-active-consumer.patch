+    ));
+    assert!(matches!(
+        ApprovalResolutionSource::Guardian.telemetry_source(),
+        Some(ToolDecisionSource::AutomatedReviewer)
+    ));
+    assert!(matches!(
+        ApprovalResolutionSource::User.telemetry_source(),
+        Some(ToolDecisionSource::User)
+    ));
+    assert!(
+        ApprovalResolutionSource::InheritedParent
+            .telemetry_source()
+            .is_none()
+    );
+    // No ApprovalResolution or parent proof is constructed by this pure mapping check.
+}
