+#[tokio::test]
+async fn actual_decisive_hooks_bypass_contributor_and_preserve_allow_deny_precedence()
+-> anyhow::Result<()> {
+    for behavior in ["allow", "deny"] {
+        let case = ActiveCase::new(Some(ApprovalDecision::AskUser), /*gated*/ false).await?;
+        let counter = tempfile::tempdir()?;
+        let hits = counter.path().join("hits");
+        let mut home = None;
+        let result = bounded(async {
+            let command = format!("cat >/dev/null; printf 'hit\\n' >> {}; printf '%s\\n' '{{\"hookSpecificOutput\":{{\"hookEventName\":\"PermissionRequest\",\"decision\":{{\"behavior\":\"{behavior}\",\"message\":\"actual-hook-denied\"}}}}}}'",
+                shlex::try_quote(hits.to_string_lossy().as_ref())?);
+            // Existing C2 fixture setup occurs before any approval starts; no guarded-publication claim.
+            home = Some(case.fixture.trusted_hooks(vec![(command, false)])?);
+            let selected = case.selected().await?;
+            let result = case.fixture.session.request_intercepted_approval(&selected, /*parent*/ None).await;
+            if behavior == "allow" {
+                assert_eq!(result.map_err(|e| anyhow::anyhow!("{e:?}"))?, ReviewDecision::Approved);
+            } else {
+                assert!(matches!(result, Err(ToolError::Rejected(message)) if message == "actual-hook-denied"));
+            }
+            assert_eq!(case.fixture.calls.load(Ordering::SeqCst), 0);
+            assert_eq!(std::fs::read_to_string(&hits)?, "hit\n");
+            case.no_manual();
+            Ok(())
+        }).await;
+        let result = case.finish(result).await;
+        drop(home);
+        result?;
+    }
+    Ok(())
+}
