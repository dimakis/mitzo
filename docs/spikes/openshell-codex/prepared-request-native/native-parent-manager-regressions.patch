+pub(super) enum FixtureReview {
+    AskUser,
+    Default,
+}
+struct AskUser;
+impl ApprovalReviewContributor for AskUser {
+    fn decide<'a>(
+        &'a self,
+        _input: &'a codex_extension_api::ApprovalDecisionInput<'_>,
+    ) -> codex_extension_api::ExtensionFuture<'a, Option<ApprovalDecision>> {
+        Box::pin(async { Some(ApprovalDecision::AskUser) })
+    }
+}
+
+// Future Fixture::new delegates here with FixtureReview::AskUser; its Q1 control BODY stays exact.
+pub(super) async fn fixture(
+    runtime: &ZshForkRuntime,
+    review: FixtureReview,
+) -> anyhow::Result<Fixture> {
+    let root = tempfile::tempdir()?;
+    let root_path = AbsolutePathBuf::try_from(std::fs::canonicalize(root.path())?)?;
+    let secret = root_path.join("never-read.env");
+    std::fs::write(&secret, SECRET)?;
+    let denied = FileSystemSandboxPolicy::restricted(vec![
+        FileSystemSandboxEntry {
+            path: FileSystemPath::Special {
+                value: FileSystemSpecialPath::Root,
+            },
+            access: FileSystemAccessMode::Read,
+            missing_path_behavior: None,
+        },
+        FileSystemSandboxEntry {
+            path: FileSystemPath::GlobPattern {
+                pattern: secret.to_string_lossy().into_owned(),
+            },
+            access: FileSystemAccessMode::Deny,
+            missing_path_behavior: None,
+        },
+    ]);
+    let profile =
+        PermissionProfile::from_runtime_permissions(&denied, NetworkSandboxPolicy::Restricted);
+    let (zsh, wrapper) = runtime.verified_paths();
+    let shell_mode = UnifiedExecShellMode::ZshFork(ZshForkConfig {
+        shell_zsh_path: AbsolutePathBuf::try_from(zsh)?,
+        main_execve_wrapper_exe: AbsolutePathBuf::try_from(wrapper)?,
+    });
+    let (mut session, turn, events) = tokio::time::timeout(
+        Duration::from_secs(15),
+        make_session_and_context_with_auth_and_config_and_rx(
+            codex_login::CodexAuth::from_api_key("offline-test"),
+            Vec::new(),
+            |config| {
+                // This host-owned directory is the actual selected sandbox workspace BEFORE Session.
+                config.cwd = root_path.clone();
+                config.workspace_roots = vec![root_path.clone()];
+                config
+                    .permissions
+                    .set_workspace_roots(vec![root_path.clone()]);
+                config.permissions.approval_policy =
+                    codex_config::Constrained::allow_any(AskForApproval::OnRequest);
+                config.permissions.allow_login_shell = false;
+                config.approvals_reviewer = ApprovalsReviewer::User;
+                config
+                    .features
+                    .disable(codex_features::Feature::GuardianV2)
+                    .expect("disable model review");
+                for feature in [
+                    codex_features::Feature::ShellTool,
+                    codex_features::Feature::UnifiedExec,
+                    codex_features::Feature::ShellZshFork,
+                    codex_features::Feature::UnifiedExecZshFork,
+                ] {
+                    config.features.enable(feature).unwrap();
+                }
+                config.zsh_path = Some(zsh.to_path_buf());
+                config.main_execve_wrapper_exe = Some(wrapper.to_path_buf());
+                #[cfg(target_os = "linux")]
+                {
+                    config.codex_linux_sandbox_exe = Some(
+                        codex_utils_cargo_bin::cargo_bin("codex-linux-sandbox")
+                            .expect("built sandbox helper"),
+                    );
+                }
+                config.permissions.set_permission_profile(profile).unwrap();
+            },
+        ),
+    )
+    .await?;
+    let mut registry = codex_extension_api::ExtensionRegistryBuilder::new();
+    match review {
+        FixtureReview::AskUser => {
+            registry.approval_review_contributor(Arc::new(AskUser));
+        }
+        FixtureReview::Default => {}
+    }
+    Arc::get_mut(&mut session)
+        .ok_or_else(|| anyhow::anyhow!("unshared Session before task"))?
+        .services
+        .extensions = Arc::new(registry.build());
+    session
+        .services
+        .session_extension_data
+        .insert(ParentBindingTrace::default());
+    let task_cancellation = CancellationToken::new();
+    let task_cleanup = task_cancellation.clone().drop_guard();
+    // Own task cancellation and the workspace BEFORE starting the actual task.
+    let mut fixture = Fixture {
+        session,
+        step: StepContext::for_test(Arc::clone(&turn)),
+        events,
+        cancellation: CancellationToken::new(),
+        _task_cleanup: task_cleanup,
+        _root: root,
+        secret,
+        shell_mode,
+        sandbox_manager: SandboxManager::new(),
+    };
+    let setup = tokio::time::timeout(Duration::from_secs(15), async {
+        fixture
+            .session
+            .start_task(turn, Vec::new(), PendingTask(task_cancellation))
+            .await;
+        fixture.session.services.turn_environments.snapshot().await;
+        let (turn, settings, environments, strict) = fixture
+            .session
+            .active_turn_context_and_strict_auto_review()
+            .await
+            .ok_or_else(|| anyhow::anyhow!("actual active task"))?;
+        assert!(!strict);
+        assert_eq!(
+            environments.primary().unwrap().cwd(),
+            &PathUri::from_abs_path(&root_path)
+        );
+        assert!(Arc::ptr_eq(&turn, &fixture.step.turn));
+        let selected = Arc::get_mut(&mut fixture.step).unwrap();
+        selected.settings = settings;
+        selected.environments = environments;
+        Ok::<_, anyhow::Error>(())
+    })
+    .await
+    .map_err(anyhow::Error::from)
+    .and_then(|result| result);
+    if let Err(error) = setup {
+        let cleanup = tokio::time::timeout(Duration::from_secs(5), fixture.close()).await;
+        return Err(error.context(format!("fixture setup cleanup={cleanup:?}")));
+    }
+    Ok(fixture)
+}
