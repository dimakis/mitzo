+}
+fn assert_nonleak(fixture: &Fixture, output: &[u8]) -> anyhow::Result<()> {
+    let text = String::from_utf8_lossy(output);
+    assert!(text.contains("Q4-marker"));
+    assert!(!text.contains(std::str::from_utf8(SECRET)?));
+    assert_eq!(std::fs::read(&fixture.secret)?, SECRET);
+    Ok(())
+}
+// Own all ordinary error paths before identity/quoting/allocation/launch can fail.
+struct ManagerCase {
+    fixture: Fixture,
+    process_id: Option<i32>,
+    running: Option<RunningCall>,
+}
+impl ManagerCase {
+    async fn new(runtime: &ZshForkRuntime) -> anyhow::Result<Self> {
+        Ok(Self {
+            fixture: fixture(runtime, FixtureReview::Default).await?,
+            process_id: None,
+            running: None,
+        })
+    }
+    async fn launch(&mut self, script: String, yield_time_ms: u64) -> Vec<String> {
+        let id = self
+            .fixture
+            .session
+            .services
+            .unified_exec_manager
+            .allocate_process_id()
+            .await;
+        // No await between allocation and recording cleanup ownership.
+        self.process_id = Some(id);
+        let request = request(&self.fixture, id, script, yield_time_ms);
+        let expected = request.command.clone();
+        self.running = Some(start(&self.fixture, request));
+        expected
+    }
+    async fn finish(mut self, result: anyhow::Result<()>) -> anyhow::Result<()> {
+        let process_cleanup = tokio::time::timeout(Duration::from_secs(10), async {
+            self.fixture.cancellation.cancel();
+            if let Some(running) = self.running.as_mut() {
+                if let Some(call) = running.call.as_mut() {
+                    call.abort();
+                    // Retain ownership across a timeout; Drop can still abort this same handle.
+                    let _ = call.await;
+                }
+                running.call.take();
+            }
+            self.fixture
+                .session
+                .services
+                .unified_exec_manager
+                .terminate_all_processes()
+                .await;
+            if let Some(id) = self.process_id {
+                self.fixture
+                    .session
+                    .services
+                    .unified_exec_manager
+                    .release_process_id(id)
+                    .await;
+            }
+            if let Some(running) = self.running.as_mut() {
+                running.cleaned = true;
+            }
+        })
+        .await;
+        let task_cleanup = tokio::time::timeout(Duration::from_secs(5), self.fixture.close()).await;
+        // Both cleanup attempts are collected before propagating ANY ordinary error.
+        // Timeout/panic fallback remains best effort; no claim of fully drained tasks.
+        match (result, process_cleanup, task_cleanup) {
+            (Ok(()), Ok(()), Ok(())) => Ok(()),
+            (Err(error), process, task) => {
+                Err(error.context(format!("cleanup process={process:?} task={task:?}")))
+            }
+            (Ok(()), process, task) => anyhow::bail!("cleanup process={process:?} task={task:?}"),
+        }
+    }
+}
+async fn output_poll(fixture: &Fixture, process_id: i32) -> anyhow::Result<ExecCommandToolOutput> {
+    let context = UnifiedExecContext::new(
+        Arc::clone(&fixture.session),
+        Arc::clone(&fixture.step),
+        fixture.cancellation.clone(),
+        "post-yield-output-only".into(),
+    );
+    Ok(fixture
+        .session
+        .services
+        .unified_exec_manager
+        .write_stdin(
+            &context,
+            WriteStdinRequest {
+                process_id,
+                input: "",
+                yield_time_ms: crate::unified_exec::MIN_EMPTY_YIELD_TIME_MS,
+                max_output_tokens: Some(1000),
+                truncation_policy: TruncationPolicy::Tokens(1000),
+                interaction_event: None,
+            },
+        )
+        .await?)
+}
