+struct TaskIdentity {
+    done: Arc<Notify>,
+    turn: Arc<TurnContext>,
+    settings: Arc<ResolvedStepSettings>,
+}
+async fn identity(fixture: &Fixture) -> anyhow::Result<TaskIdentity> {
+    let (done, turn) = {
+        let active = fixture.session.active_turn.lock().await;
+        let task = active.as_ref().unwrap().task.as_ref().unwrap();
+        (Arc::clone(&task.done), Arc::clone(&task.turn_context))
+    };
+    let (selected_turn, settings, _, strict) = fixture
+        .session
+        .active_turn_context_and_strict_auto_review()
+        .await
+        .ok_or_else(|| anyhow::anyhow!("same active task settings"))?;
+    assert!(!strict);
+    assert!(Arc::ptr_eq(&turn, &selected_turn));
+    // Renew the actual task identity around the existing settings owner observation.
+    let active = fixture.session.active_turn.lock().await;
+    let task = active.as_ref().unwrap().task.as_ref().unwrap();
+    assert!(Arc::ptr_eq(&done, &task.done));
+    assert!(Arc::ptr_eq(&turn, &task.turn_context));
+    Ok(TaskIdentity {
+        done,
+        turn,
+        settings,
+    })
+}
+fn request(
+    fixture: &Fixture,
+    process_id: i32,
+    script: String,
+    yield_time_ms: u64,
+) -> ExecCommandRequest {
+    let environment = fixture.step.environments.primary().unwrap().clone();
+    let UnifiedExecShellMode::ZshFork(config) = &fixture.shell_mode else {
+        unreachable!()
+    };
+    ExecCommandRequest {
+        command: vec![
+            config.shell_zsh_path.to_string_lossy().into_owned(),
+            "-c".into(),
+            script.clone(),
+        ],
+        shell_type: crate::shell::ShellType::Zsh,
+        hook_command: script,
+        process_id,
+        yield_time_ms,
+        max_output_tokens: Some(1000),
+        cwd: environment.cwd().clone(),
+        sandbox_cwd: environment.cwd().clone(),
+        turn_environment: environment,
+        shell_mode: fixture.shell_mode.clone(),
+        network: None,
+        tty: false,
+        sandbox_permissions: SandboxPermissions::RequireEscalated,
+        additional_permissions: None,
+        additional_permissions_preapproved: false,
+        justification: None,
+        prefix_rule: None,
+    }
+}
+fn start(fixture: &Fixture, request: ExecCommandRequest) -> RunningCall {
+    let process_id = request.process_id;
+    let context = UnifiedExecContext::new(
+        Arc::clone(&fixture.session),
+        Arc::clone(&fixture.step),
+        fixture.cancellation.clone(),
+        CALL.into(),
+    );
+    RunningCall {
+        call: Some(tokio::spawn(async move {
+            Box::pin(
+                context
+                    .session
+                    .services
+                    .unified_exec_manager
+                    .exec_command(request, &context),
+            )
+            .await
+        })),
+        session: Arc::clone(&fixture.session),
+        process_id,
+        cancellation: fixture.cancellation.clone(),
+        cleaned: false,
+    }
+}
+async fn initial(
+    fixture: &Fixture,
+    running: &mut RunningCall,
+    expected: &[String],
+) -> anyhow::Result<(ExecCommandToolOutput, Vec<ExecApprovalRequestEvent>)> {
+    let mut approvals = Vec::new();
+    tokio::time::timeout(Duration::from_secs(45), async {
+        loop {
+            tokio::select! {
+                result = running.call.as_mut().unwrap() => {
+                    running.call.take();
+                    return Ok((result.map_err(anyhow::Error::from)?.map_err(anyhow::Error::from)?, approvals));
+                },
+                event = fixture.events.recv() => {
+                    if let EventMsg::ExecApprovalRequest(request) = event?.msg {
+                        anyhow::ensure!(approvals.is_empty() && request.approval_id.is_none(),
+                            "unexpected child/manual approval during default initial invocation");
+                        assert_eq!(request.call_id, CALL);
+                        assert_eq!(request.command, expected);
+                        fixture.session.notify_approval(&request.call_id, ReviewDecision::Approved).await;
+                        approvals.push(request);
+                    }
+                }
+            }
+        }
+    }).await?
+}
+fn assert_no_approval(fixture: &Fixture) {
+    while let Ok(event) = fixture.events.try_recv() {
+        assert!(!matches!(event.msg, EventMsg::ExecApprovalRequest(_)));
+    }
+}
+fn assert_trace(fixture: &Fixture, admitted: bool) {
+    let environment_id = fixture
+        .step
+        .environments
+        .primary()
+        .unwrap()
+        .selection
+        .environment_id
+        .clone();
+    let trace = fixture
+        .session
+        .services
+        .session_extension_data
+        .get::<ParentBindingTrace>()
+        .unwrap();
+    assert_eq!(
+        *trace.events.lock().unwrap(),
+        vec![
+            ParentBindingPhase::CandidateRetained {
+                call_id: CALL.into(),
+                environment_id: environment_id.clone(),
+                descriptor_present: true
+            },
+            ParentBindingPhase::ExecutorBound {
+                call_id: CALL.into(),
+                environment_id: environment_id.clone(),
+                descriptor_present: true,
+                bound: true
+            },
+            // FUTURE phase, emitted solely at actual Runtime-owned compare_exchange.
+            ParentBindingPhase::ParentAdmissionAttempt {
+                call_id: CALL.into(),
+                environment_id,
+                admitted
+            },
+        ]
+    );
+}
+fn assert_bound_before_gate(fixture: &Fixture) {
+    let environment_id = fixture
+        .step
+        .environments
+        .primary()
+        .unwrap()
+        .selection
+        .environment_id
+        .clone();
+    let trace = fixture
+        .session
+        .services
+        .session_extension_data
+        .get::<ParentBindingTrace>()
+        .unwrap();
+    assert_eq!(
+        *trace.events.lock().unwrap(),
+        vec![
+            ParentBindingPhase::CandidateRetained {
+                call_id: CALL.into(),
+                environment_id: environment_id.clone(),
+                descriptor_present: true
+            },
+            ParentBindingPhase::ExecutorBound {
+                call_id: CALL.into(),
+                environment_id,
+                descriptor_present: true,
+                bound: true
