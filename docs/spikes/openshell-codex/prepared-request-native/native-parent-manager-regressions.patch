+#[tokio::test]
+async fn same_task_child_after_actual_initial_return_reaches_closed_original_flag_and_manual_review()
+-> anyhow::Result<()> {
+    skip_if_sandbox!(Ok(()));
+    let Some(runtime) = zsh_fork_runtime(
+        "same_task_child_after_actual_initial_return_reaches_closed_original_flag_and_manual_review",
+    )?
+    else {
+        return Ok(());
+    };
+    let mut case = ManagerCase::new(&runtime).await?;
+    let result = tokio::time::timeout(Duration::from_secs(50), async {
+        let gate = case
+            .fixture
+            .secret
+            .parent()
+            .expect("owned workspace parent")
+            .join("release-after-initial-return");
+        assert!(!gate.exists());
+        let before = identity(&case.fixture).await?;
+        let script = format!(
+            "printf 'Q4-marker\\n'; while [[ ! -e {} ]]; do :; done; /bin/cat {}",
+            shlex::try_quote(gate.to_string_lossy().as_ref())?,
+            shlex::try_quote(case.fixture.secret.to_string_lossy().as_ref())?
+        );
+        let expected = case
+            .launch(script, crate::unified_exec::MIN_YIELD_TIME_MS)
+            .await;
+        let fixture = &case.fixture;
+        let process_id = case.process_id.unwrap();
+        let (initial_output, initial_approvals) =
+            initial(fixture, case.running.as_mut().unwrap(), &expected).await?;
+        assert_eq!(initial_approvals.len(), 1);
+        assert_eq!(initial_output.process_id, Some(process_id));
+        assert_eq!(initial_output.exit_code, None);
+        let mut output = initial_output.raw_output;
+        while !String::from_utf8_lossy(&output).contains("Q4-marker") {
+            let polled = output_poll(fixture, process_id).await?;
+            assert_eq!(polled.process_id, Some(process_id));
+            assert_eq!(polled.exit_code, None);
+            output.extend(polled.raw_output);
+        }
+        let after = identity(fixture).await?;
+        assert!(Arc::ptr_eq(&before.done, &after.done));
+        assert!(Arc::ptr_eq(&before.turn, &after.turn));
+        assert!(Arc::ptr_eq(&before.settings, &after.settings));
+        assert!(Arc::ptr_eq(&after.settings, &fixture.step.settings));
+        assert_bound_before_gate(&fixture);
+        assert_no_approval(&fixture);
+        // Host release occurs ONLY after real manager returned/yielded and original guard dropped.
+        std::fs::write(&gate, b"release")?;
+        let child = tokio::time::timeout(Duration::from_secs(10), async {
+            loop {
+                if let EventMsg::ExecApprovalRequest(request) = fixture.events.recv().await?.msg {
+                    return Ok::<_, anyhow::Error>(request);
+                }
+            }
+        })
+        .await??;
+        assert_eq!(child.call_id, CALL);
+        assert!(child.approval_id.is_some());
+        assert_eq!(child.command.len(), 2);
+        assert!(matches!(
+            child.command[0].as_str(),
+            "/bin/cat" | "/usr/bin/cat"
+        ));
+        assert_eq!(child.command[1], fixture.secret.to_string_lossy());
+        assert_trace(&fixture, false);
+        fixture
+            .session
+            .notify_approval(
+                child.approval_id.as_deref().unwrap(),
+                ReviewDecision::Approved,
+            )
+            .await;
+        loop {
+            let polled = output_poll(fixture, process_id).await?;
+            output.extend(polled.raw_output);
+            if polled.process_id.is_none() {
+                assert_eq!(polled.exit_code, Some(1));
+                break;
+            }
+        }
+        assert_nonleak(&fixture, &output)?;
+        let final_identity = identity(&fixture).await?;
+        assert!(Arc::ptr_eq(&before.done, &final_identity.done));
+        assert!(Arc::ptr_eq(&before.turn, &final_identity.turn));
+        assert!(Arc::ptr_eq(&before.settings, &final_identity.settings));
+        assert_no_approval(&fixture);
+        Ok(())
+    })
+    .await
+    .map_err(anyhow::Error::from)
+    .and_then(|result| result);
+    case.finish(result).await
+}
