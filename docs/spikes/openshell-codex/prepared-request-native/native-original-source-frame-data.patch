diff --git a/codex-rs/core/src/session/source_frame.rs b/codex-rs/core/src/session/source_frame.rs
new file mode 100644
index 0000000000000000000000000000000000000000..3b1af3e8014a4f82d16e0fc04e55f22207f8e364
--- /dev/null
+++ b/codex-rs/core/src/session/source_frame.rs
@@ -0,0 +1,107 @@
+//! Original startup's source-frame DATA transformations only.
+//! Callers must supply genuine retained original inputs. This module neither
+//! acquires history/parent/process metadata nor certifies their currency; it
+//! allocates no Session, provider client or prepared-request authority.
+use codex_history::InitialHistory;
+use codex_history::RolloutItem;
+use codex_protocol::ThreadId;
+use codex_protocol::protocol::InternalSessionSource;
+use codex_protocol::protocol::SessionSource;
+use codex_protocol::protocol::SubAgentSource;
+
+fn originator_from_service_name(service_name: Option<&str>) -> Option<String> {
+    let service_name = service_name?.trim();
+    for originator in [
+        "codex_work_desktop",
+        "codex_work_web",
+        "codex_work_mobile",
+        "codex_work_cca",
+        "chatgpt_cca",
+    ] {
+        if service_name.eq_ignore_ascii_case(originator) {
+            return Some(originator.to_string());
+        }
+    }
+    None
+}
+
+pub(crate) fn effective_originator_value(
+    metrics_service_name: Option<&str>,
+    env_originator: Option<String>,
+    persisted_originator: Option<String>,
+    inherited_originator: Option<String>,
+    default_originator: String,
+) -> String {
+    originator_from_service_name(metrics_service_name)
+        .or(persisted_originator)
+        .or(inherited_originator)
+        .or(env_originator)
+        .unwrap_or(default_originator)
+}
+
+pub(crate) fn inherited_originator_thread_id(
+    session_source: &SessionSource,
+    parent_thread_id: Option<ThreadId>,
+    forked_from_thread_id: Option<ThreadId>,
+) -> Option<ThreadId> {
+    match session_source {
+        SessionSource::SubAgent(SubAgentSource::ThreadSpawn {
+            parent_thread_id, ..
+        }) => Some(*parent_thread_id),
+        _ => parent_thread_id.or(forked_from_thread_id),
+    }
+}
+
+pub(crate) fn spawn_parent_thread_id(
+    parent_thread_id: Option<ThreadId>,
+    initial_history: &InitialHistory,
+    session_source: &SessionSource,
+) -> Option<ThreadId> {
+    parent_thread_id
+        .or_else(|| initial_history.get_resumed_parent_thread_id())
+        .or(match session_source {
+            SessionSource::SubAgent(SubAgentSource::ThreadSpawn {
+                parent_thread_id, ..
+            }) => Some(*parent_thread_id),
+            _ => None,
+        })
+}
+
+pub(crate) fn session_parent_thread_id(
+    parent_thread_id: Option<ThreadId>,
+    initial_history: &InitialHistory,
+) -> Option<ThreadId> {
+    parent_thread_id.or_else(|| initial_history.get_resumed_parent_thread_id())
+}
+
+pub(crate) fn session_source_for_spawn(session_source: SessionSource) -> SessionSource {
+    match session_source {
+        SessionSource::Internal(InternalSessionSource::Guardian) => SessionSource::SubAgent(
+            SubAgentSource::Other(crate::guardian::GUARDIAN_REVIEWER_NAME.to_owned()),
+        ),
+        source => source,
+    }
+}
+
+pub(crate) fn fork_prompt_cache_key(
+    initial_history: &InitialHistory,
+    ephemeral: bool,
+    session_source: &SessionSource,
+) -> Option<String> {
+    match initial_history {
+        InitialHistory::Forked(items) if ephemeral && !session_source.is_non_root_agent() => {
+            items.iter().find_map(|item| match item {
+                RolloutItem::SessionMeta(meta) => Some(meta.meta.session_id.to_string()),
+                _ => None,
+            })
+        }
+        InitialHistory::New
+        | InitialHistory::Cleared
+        | InitialHistory::Resumed(_)
+        | InitialHistory::Forked(_) => None,
+    }
+}
+
