+use super::*;
+use codex_history::ResumedHistory;
+use codex_protocol::protocol::SessionMeta;
+use codex_protocol::protocol::SessionMetaLine;
+use pretty_assertions::assert_eq;
+use std::sync::Arc;
+
+fn meta(id: ThreadId, parent_thread_id: Option<ThreadId>) -> RolloutItem {
+    RolloutItem::SessionMeta(SessionMetaLine {
+        meta: SessionMeta {
+            id,
+            session_id: id.into(),
+            parent_thread_id,
+            ..SessionMeta::default()
+        },
+        git: None,
+    })
+}
+
+#[test]
+fn original_originator_precedence_keeps_service_persisted_inherited_env_and_default() {
+    for (service, persisted, inherited, env, expected) in [
+        (
+            Some(" CODEX_WORK_WEB "),
+            Some("saved"),
+            Some("parent"),
+            Some("env"),
+            "codex_work_web",
+        ),
+        (
+            Some("codex_work_web_extra"),
+            Some("saved"),
+            Some("parent"),
+            Some("env"),
+            "saved",
+        ),
+        (None, None, Some("parent"), Some("env"), "parent"),
+        (None, None, None, Some("env"), "env"),
+        (None, None, None, None, "provided-process-owner"),
+    ] {
+        assert_eq!(
+            effective_originator_value(
+                service,
+                env.map(str::to_owned),
+                persisted.map(str::to_owned),
+                inherited.map(str::to_owned),
+                "provided-process-owner".to_owned()
+            ),
+            expected
+        );
+    }
+}
+
+#[test]
+fn original_parent_precedence_and_inherited_lookup_choose_their_actual_sources() {
+    let explicit = ThreadId::new();
+    let saved = ThreadId::new();
+    let spawned = ThreadId::new();
+    let forked = ThreadId::new();
+    let source = SessionSource::SubAgent(SubAgentSource::ThreadSpawn {
+        parent_thread_id: spawned,
+        depth: 1,
+        agent_path: None,
+        agent_nickname: None,
+        agent_role: None,
+    });
+    let resumed = InitialHistory::Resumed(ResumedHistory {
+        conversation_id: ThreadId::new(),
+        history: Arc::new(vec![meta(ThreadId::new(), Some(saved))]),
+        rollout_path: None,
+    });
+    assert_eq!(
+        spawn_parent_thread_id(Some(explicit), &resumed, &source),
+        Some(explicit)
+    );
+    assert_eq!(
+        spawn_parent_thread_id(/*parent_thread_id*/ None, &resumed, &source),
+        Some(saved)
+    );
+    assert_eq!(
+        spawn_parent_thread_id(
+            /*parent_thread_id*/ None,
+            &InitialHistory::New,
+            &source
+        ),
+        Some(spawned)
+    );
+    assert_eq!(
+        spawn_parent_thread_id(
+            /*parent_thread_id*/ None,
+            &InitialHistory::New,
+            &SessionSource::Cli
+        ),
+        None
+    );
+    // Parent-originator lookup intentionally prioritizes ThreadSpawn source;
+    // this differs from the resolved Session parent's explicit/history order.
+    assert_eq!(
+        inherited_originator_thread_id(&source, Some(explicit), Some(forked)),
+        Some(spawned)
+    );
+    assert_eq!(
+        inherited_originator_thread_id(&SessionSource::Cli, Some(explicit), Some(forked)),
+        Some(explicit)
+    );
+    assert_eq!(
+        inherited_originator_thread_id(
+            &SessionSource::Cli,
+            /*parent_thread_id*/ None,
+            Some(forked)
+        ),
+        Some(forked)
+    );
+    assert_eq!(
+        session_parent_thread_id(Some(explicit), &resumed),
+        Some(explicit)
+    );
+    assert_eq!(
+        session_parent_thread_id(/*parent_thread_id*/ None, &resumed),
+        Some(saved)
+    );
+    // The original history owner restores parents only for Resumed, not Forked.
+    let forked_history = InitialHistory::Forked(vec![meta(ThreadId::new(), Some(saved))]);
+    assert_eq!(
+        spawn_parent_thread_id(
+            /*parent_thread_id*/ None,
+            &forked_history,
+            &SessionSource::Cli
+        ),
+        None
+    );
+    assert_eq!(
+        session_parent_thread_id(/*parent_thread_id*/ None, &forked_history),
+        None
+    );
+}
+
+#[test]
+fn original_cache_all_history_and_non_root_arms_and_guardian_precedence_remain() {
+    let first = ThreadId::new();
+    let second = ThreadId::new();
+    // Session ID is intentionally distinct from thread ID: cache routing must
+    // use the ORIGINAL first SessionMeta.session_id, never its lifecycle ID.
+    let first_session = ThreadId::new();
+    let first_meta = RolloutItem::SessionMeta(SessionMetaLine {
+        meta: SessionMeta {
+            id: first,
+            session_id: first_session.into(),
+            ..SessionMeta::default()
+        },
+        git: None,
+    });
+    let fork = InitialHistory::Forked(vec![first_meta, meta(second, /*parent_thread_id*/ None)]);
+    assert_eq!(
+        fork_prompt_cache_key(&fork, /*ephemeral*/ true, &SessionSource::Cli),
+        Some(first_session.to_string())
+    );
+    assert_eq!(
+        fork_prompt_cache_key(&fork, /*ephemeral*/ false, &SessionSource::Cli),
+        None
+    );
+    let non_root = SessionSource::SubAgent(SubAgentSource::Other("child".to_owned()));
+    assert_eq!(
+        fork_prompt_cache_key(&fork, /*ephemeral*/ true, &non_root),
+        None
+    );
+    let resumed = InitialHistory::Resumed(ResumedHistory {
+        conversation_id: second,
+        history: Arc::new(vec![meta(first, /*parent_thread_id*/ None)]),
+        rollout_path: None,
+    });
+    for history in [
+        InitialHistory::New,
+        InitialHistory::Cleared,
+        resumed,
+        InitialHistory::Forked(Vec::new()),
+    ] {
+        assert_eq!(
+            fork_prompt_cache_key(&history, /*ephemeral*/ true, &SessionSource::Cli),
+            None
+        );
+    }
+    let guardian =
+        session_source_for_spawn(SessionSource::Internal(InternalSessionSource::Guardian));
+    assert_eq!(
+        guardian,
+        SessionSource::SubAgent(SubAgentSource::Other(
+            crate::guardian::GUARDIAN_REVIEWER_NAME.to_owned()
+        ))
+    );
+    assert_eq!(
+        session_source_for_spawn(SessionSource::Cli),
+        SessionSource::Cli
+    );
+    let fork_key = fork_prompt_cache_key(&fork, /*ephemeral*/ true, &SessionSource::Cli);
+    assert_eq!(
+        crate::guardian::prompt_cache_key_override_for_review_session(&guardian, Some(second))
+            .or(fork_key),
+        Some(format!("guardian:{second}"))
+    );
+    assert_eq!(
+        crate::guardian::prompt_cache_key_override_for_review_session(
+            &guardian, /*parent_thread_id*/ None
+        ),
+        None
+    );
+    assert_eq!(
+        crate::guardian::prompt_cache_key_override_for_review_session(&non_root, Some(second)),
+        None
+    );
+}
