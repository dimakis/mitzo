+        config: &Arc<Config>,
+        source: &SessionSource,
+        history: &InitialHistory,
+        model: &ModelInfo,
+    ) -> io::Result<super::base_instructions_data::BaseProvenanceAdoption> {
+        use super::base_instructions_data::BaseProvenanceAdoption;
+        match std::mem::replace(
+            &mut self.base_provenance,
+            OriginalBaseProvenanceSlot::Consumed,
+        ) {
+            OriginalBaseProvenanceSlot::Ordinary => {
+                if self.startup.is_some()
+                    || !matches!(self.fresh_history, OriginalFreshHistorySlot::Ordinary)
+                {
+                    return Err(io::Error::other("selected base provenance was not staged"));
+                }
+                Ok(BaseProvenanceAdoption::Ordinary)
+            }
+            OriginalBaseProvenanceSlot::Retained(id, data) => {
+                if reserved != Some(id) {
+                    return Err(io::Error::other("original base allocation changed"));
+                }
+                Ok(BaseProvenanceAdoption::Retained(
+                    data.adopt(config, source, history, model)?,
+                ))
+            }
+            OriginalBaseProvenanceSlot::Consumed => {
+                Err(io::Error::other("original base provenance consumed"))
+            }
+        }
+    }
     pub(super) fn take_startup(
         &mut self,
     ) -> Option<super::startup_selection::OriginalStartupSelection> {
