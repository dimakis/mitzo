+
+#[tokio::test]
+async fn retained_base_stays_startup_owned_across_first_command_personality_and_original_packet_adoption()
+-> anyhow::Result<()> {
+    let (_home, mut options, auth, models, _) = fixture().await?;
+    options.config.personality = Some(codex_protocol::config_types::Personality::Pragmatic);
+    let startup =
+        OriginalStartupSelection::capture(&options, &SessionSource::Exec, None, &auth, &models)
+            .await?;
+    let expected = startup.base_instructions()?;
+    let mut command =
+        startup.settings_candidate(codex_protocol::protocol::ThreadSettingsOverrides {
+            personality: Some(codex_protocol::config_types::Personality::Friendly),
+            ..Default::default()
+        })?;
+    command.pair_command(
+        "base-data".into(),
+        codex_protocol::turn_input::TurnInputRequest::user_input(Vec::new()),
+        None,
+        None,
+        None,
+    )?;
+    command.capture_first_step_model(&startup).await?;
+    assert_eq!(startup.base_instructions()?, expected);
+    let manager = crate::ThreadManager::for_fresh_history_fixture(
+        &options.config,
+        Arc::clone(&auth),
+        Arc::clone(&models),
+    );
+    let reservation = manager.reserve_thread_start();
+    let id = reservation.thread_id();
+    let mut selected = manager
+        .prepare_reserved_selected_start(options, reservation)
+        .await?;
+    manager
+        .capture_selected_start_startup(&mut selected)
+        .await?;
+    let adoption = manager.adopt_selected_start_startup(&mut selected).await?;
+    let (actual_id, options, mut inputs) = adoption.into_fresh_history_fixture_parts();
+    assert_eq!(actual_id, id);
+    inputs.stage_base_provenance_for_session()?;
+    let startup = inputs.take_startup().unwrap();
+    let frame = inputs.source_frame().unwrap();
+    let source = frame.client_source().0.clone();
+    let fork = frame.configured_fork(&options)?;
+    let row = startup.owner.model_info().clone();
+    let (_owner, mut stages, _raw) = startup.into_session(
+        &models,
+        &auth,
+        &options.config,
+        configured_settings_data::ConfiguredBaselineInputs::from_options(&options, fork),
+        &source,
+    )?;
+    stages.take_review()?;
+    let effective = stages.take_effective()?;
+    let storage = stages.base.text_storage_for_test();
+    let text = stages.take_base()?;
+    assert_eq!(text.as_ptr(), storage);
+    assert_eq!(text, expected.text);
+    let adopted = inputs.take_base_provenance(
+        Some(id),
+        &effective,
+        &source,
+        &options.initial_history,
+        &row,
+    )?;
+    let super::super::base_instructions_data::BaseProvenanceAdoption::Retained(provenance) =
+        adopted
+    else {
+        panic!("retained startup cannot fall back")
+    };
+    assert_eq!(provenance, expected.provenance);
+    assert!(
+        inputs
+            .take_base_provenance(
+                Some(id),
+                &effective,
+                &source,
+                &options.initial_history,
+                &row
+            )
+            .is_err()
+    );
+    assert!(stages.take_base().is_err());
+    assert!(manager.list_thread_ids().await.is_empty());
+    Ok(())
+}
