+    pub(super) fn stage_base_provenance_for_session(&mut self) -> io::Result<()> {
+        if !matches!(self.base_provenance, OriginalBaseProvenanceSlot::Ordinary) {
+            self.base_provenance = OriginalBaseProvenanceSlot::Consumed;
+            return Err(io::Error::other("original base provenance stage repeated"));
+        }
+        match self.startup.as_mut() {
+            Some(startup) => {
+                self.base_provenance = OriginalBaseProvenanceSlot::Consumed;
+                let data = startup.take_base_provenance()?;
+                self.base_provenance = OriginalBaseProvenanceSlot::Retained(self.thread_id, data);
+                Ok(())
+            }
+            None if matches!(self.fresh_history, OriginalFreshHistorySlot::Ordinary) => Ok(()),
+            None => {
+                self.base_provenance = OriginalBaseProvenanceSlot::Consumed;
