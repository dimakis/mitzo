+use super::*;
+use codex_protocol::protocol::{SessionMeta, SessionMetaLine};
+use pretty_assertions::assert_eq;
+
+async fn source() -> anyhow::Result<(tempfile::TempDir, Arc<Config>, ModelInfo)> {
+    let home = tempfile::tempdir()?;
+    let config = crate::config::ConfigBuilder::default()
+        .codex_home(home.path().to_path_buf())
+        .loader_overrides(
+            codex_config::LoaderOverrides::with_managed_config_path_for_tests(
+                home.path().join("managed.toml"),
+            ),
+        )
+        .fallback_cwd(Some(home.path().to_path_buf()))
+        .build()
+        .await?;
+    let row = codex_models_manager::bundled_models_response()?
+        .models
+        .into_iter()
+        .find(|row| row.slug == "gpt-6-luna")
+        .unwrap();
+    Ok((home, Arc::new(config), row))
+}
+fn inherited(base: BaseInstructions) -> InitialHistory {
+    InitialHistory::Forked(vec![RolloutItem::SessionMeta(SessionMetaLine {
+        meta: SessionMeta {
+            base_instructions: Some(base),
+            ..SessionMeta::default()
+        },
+        git: None,
+    })])
+}
+impl OriginalBaseInstructionsData {
+    pub(in crate::session) fn text_storage_for_test(&self) -> *const u8 {
+        self.text.as_ref().unwrap().as_ptr()
+    }
+}
+#[tokio::test]
+async fn original_provenance_branches_preserve_config_history_precedence_and_prompt_copy()
+-> anyhow::Result<()> {
+    let (_home, config, row) = source().await?;
+    let rendered = render_model_instructions(&row);
+    let model = Some(BaseInstructionsProvenance::Model {
+        model: row.slug.clone(),
+    });
+    for (history, expected) in [
+        (InitialHistory::New, model.clone()),
+        (
+            inherited(BaseInstructions {
+                text: rendered.clone(),
+                provenance: None,
+            }),
+            model.clone(),
+        ),
+        (
+            inherited(BaseInstructions {
+                text: "unknown inherited bytes".into(),
+                provenance: None,
+            }),
+            None,
+        ),
+        (
+            inherited(BaseInstructions {
+                text: rendered.clone(),
+                provenance: Some(BaseInstructionsProvenance::Custom),
+            }),
+            Some(BaseInstructionsProvenance::Custom),
+        ),
+    ] {
+        assert_eq!(resolve_provenance(&config, &history, &row), expected);
+    }
+    for provenance in [
+        None,
+        model.clone(),
+        Some(BaseInstructionsProvenance::Custom),
+    ] {
+        let mut selected = (*config).clone();
+        selected.base_instructions = Some("configured override".into());
+        selected.base_instructions_provenance = provenance.clone();
+        let history = inherited(BaseInstructions {
+            text: rendered.clone(),
+            provenance: model.clone(),
+        });
+        assert_eq!(
+            resolve_provenance(&selected, &history, &row),
+            provenance.or(Some(BaseInstructionsProvenance::Custom))
+        );
+        assert_eq!(
+            super::super::startup_selection::resolve_base_instructions(&selected, &history, &row),
+            "configured override"
+        );
+    }
+    let raw = BaseInstructions {
+        text: rendered,
+        provenance: model,
+    };
+    let mut filtered = (*config).clone();
+    filtered.update_plan_enabled = false;
+    filtered.model_catalog = None;
+    let copy =
+        super::super::initial_context_builtin::prompt_base_instructions(&filtered, raw.clone());
+    assert_eq!(
+        copy,
+        BaseInstructions {
+            text: codex_prompts::without_update_plan_instructions(&raw.text),
+            provenance: raw.provenance.clone()
+        }
+    );
+    let custom = BaseInstructions {
+        text: "custom bytes".into(),
+        provenance: Some(BaseInstructionsProvenance::Custom),
+    };
+    assert_eq!(
+        super::super::initial_context_builtin::prompt_base_instructions(&filtered, custom.clone()),
+        custom
+    );
+    filtered.update_plan_enabled = true;
+    assert_eq!(
+        super::super::initial_context_builtin::prompt_base_instructions(&filtered, raw.clone()),
+        raw
+    );
+    Ok(())
+}
+#[tokio::test]
+async fn captured_base_values_move_once_and_refuse_foreign_changed_or_nonfresh_inputs()
+-> anyhow::Result<()> {
+    let (_home, config, row) = source().await?;
+    let make = || {
+        OriginalBaseInstructionsData::capture(
+            Arc::clone(&config),
+            &SessionSource::Exec,
+            &InitialHistory::New,
+            &row,
+        )
+    };
+    let mut data = make()?;
+    let expected = data.snapshot(&config, &SessionSource::Exec, &row)?;
+    let storage = data.text_storage_for_test();
+    let text = data.take_text()?;
+    assert_eq!(text.as_ptr(), storage);
+    assert_eq!(text, expected.text);
+    assert!(data.take_text().is_err());
+    let provenance = data.take_provenance()?;
+    assert_eq!(
+        provenance.adopt(&config, &SessionSource::Exec, &InitialHistory::New, &row)?,
+        expected.provenance
+    );
+    assert!(data.take_provenance().is_err());
+    assert!(data.snapshot(&config, &SessionSource::Exec, &row).is_err());
+    for variant in 0..3 {
+        let mut data = make()?;
+        let provenance = data.take_provenance()?;
+        let foreign = Arc::new((*config).clone());
+        let mut changed = row.clone();
+        changed.slug.push_str("-changed");
+        let (actual_config, source, actual_row) = match variant {
+            0 => (&foreign, SessionSource::Exec, &row),
+            1 => (&config, SessionSource::VSCode, &row),
+            _ => (&config, SessionSource::Exec, &changed),
+        };
+        assert!(
+            provenance
+                .adopt(actual_config, &source, &InitialHistory::New, actual_row)
+                .is_err()
+        );
+    }
+    assert!(
+        OriginalBaseInstructionsData::capture(
+            Arc::clone(&config),
+            &SessionSource::Exec,
+            &InitialHistory::Forked(Vec::new()),
+            &row
+        )
+        .is_err()
+    );
+    Ok(())
+}
