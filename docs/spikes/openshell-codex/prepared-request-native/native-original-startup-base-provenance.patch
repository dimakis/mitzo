new file mode 100644
index 0000000..afe7e20
--- /dev/null
+++ b/codex-rs/core/src/session/base_instructions_data.rs
@@ -0,0 +1,136 @@
+//! Original base text and provenance DATA, consumed at distinct ordinary stages.
+//! Neither this snapshot nor prompt-copy rendering supplies previous-turn state.
+use super::*;
+use codex_prompts::render_model_instructions;
+use codex_protocol::models::{BaseInstructions, BaseInstructionsProvenance};
+use std::io;
+
+pub(super) enum BaseProvenanceAdoption {
+    Ordinary,
+    Retained(Option<BaseInstructionsProvenance>),
+}
+pub(super) struct OriginalBaseInstructionsData {
+    text: Option<String>,
+    provenance: Option<Box<OriginalBaseProvenance>>,
+}
+pub(super) struct OriginalBaseProvenance {
+    config: Arc<Config>,
+    source: SessionSource,
+    model: ModelInfo,
+    value: Option<BaseInstructionsProvenance>,
+}
+impl OriginalBaseInstructionsData {
+    pub(super) fn capture(
+        config: Arc<Config>,
+        source: &SessionSource,
+        history: &InitialHistory,
+        model: &ModelInfo,
+    ) -> io::Result<Self> {
+        if !matches!(history, InitialHistory::New) {
+            return Err(io::Error::other(
+                "selected base requires original fresh history",
+            ));
+        }
+        let text = super::startup_selection::resolve_base_instructions(&config, history, model);
+        let value = resolve_provenance(&config, history, model);
+        Ok(Self {
+            text: Some(text),
+            provenance: Some(Box::new(OriginalBaseProvenance {
+                config,
+                source: source.clone(),
+                model: model.clone(),
+                value,
+            })),
+        })
+    }
+    pub(super) fn snapshot(
+        &self,
+        config: &Arc<Config>,
+        source: &SessionSource,
+        model: &ModelInfo,
+    ) -> io::Result<BaseInstructions> {
+        let provenance = self
+            .provenance
+            .as_ref()
+            .ok_or_else(|| io::Error::other("original base provenance moved"))?;
+        provenance.validate_owners(config, source, model)?;
+        Ok(BaseInstructions {
+            text: self
+                .text
+                .as_ref()
+                .ok_or_else(|| io::Error::other("original base text moved"))?
+                .clone(),
+            provenance: provenance.value.clone(),
+        })
+    }
+    pub(super) fn take_text(&mut self) -> io::Result<String> {
+        self.text
+            .take()
+            .ok_or_else(|| io::Error::other("startup base instructions already adopted"))
+    }
+    pub(super) fn take_provenance(&mut self) -> io::Result<Box<OriginalBaseProvenance>> {
+        self.provenance
+            .take()
+            .ok_or_else(|| io::Error::other("startup base provenance already adopted"))
+    }
+}
+impl OriginalBaseProvenance {
+    fn validate_owners(
+        &self,
+        config: &Arc<Config>,
+        source: &SessionSource,
+        model: &ModelInfo,
+    ) -> io::Result<()> {
+        if !Arc::ptr_eq(config, &self.config) || source != &self.source || model != &self.model {
+            return Err(io::Error::other(
+                "original base config/source/startup row changed",
+            ));
+        }
+        Ok(())
+    }
+    pub(super) fn adopt(
+        self: Box<Self>,
+        config: &Arc<Config>,
+        source: &SessionSource,
+        history: &InitialHistory,
+        model: &ModelInfo,
+    ) -> io::Result<Option<BaseInstructionsProvenance>> {
+        self.validate_owners(config, source, model)?;
+        if !matches!(history, InitialHistory::New) {
+            return Err(io::Error::other("original base history changed"));
+        }
+        Ok(self.value)
+    }
+}
+
+pub(super) fn resolve_provenance(
+    config: &Config,
+    initial_history: &InitialHistory,
+    model_info: &ModelInfo,
+) -> Option<BaseInstructionsProvenance> {
+    if config.base_instructions.is_some() {
+        Some(
+            config
+                .base_instructions_provenance
+                .clone()
+                .unwrap_or(BaseInstructionsProvenance::Custom),
+        )
+    } else if let Some(inherited_base_instructions) = initial_history.get_base_instructions() {
+        let BaseInstructions { text, provenance } = inherited_base_instructions;
+        provenance.or_else(|| {
+            (text == render_model_instructions(model_info)).then(|| {
+                BaseInstructionsProvenance::Model {
+                    model: model_info.slug.clone(),
+                }
+            })
+        })
+    } else {
+        Some(BaseInstructionsProvenance::Model {
+            model: model_info.slug.clone(),
+        })
+    }
+}
