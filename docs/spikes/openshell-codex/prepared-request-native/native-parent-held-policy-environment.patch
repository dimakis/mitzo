+//! Observe actual updater ordering; callbacks cannot construct an approval.
+use super::*;
+use pretty_assertions::assert_eq;
+use std::cell::Cell;
+
+#[tokio::test]
+async fn matching_policy_callback_holds_the_existing_permit() {
+    let manager = ExecPolicyManager::default();
+    let expected = manager.current();
+    let calls = Cell::new(0);
+    assert!(
+        manager
+            .with_matching_parent_policy(&expected, || {
+                calls.set(calls.get() + 1);
+                assert!(manager.update_lock.try_acquire().is_err());
+                None
+            })
+            .is_none()
+    );
+    assert_eq!(calls.get(), 1);
+    assert!(manager.update_lock.try_acquire().is_ok());
+    let foreign = Arc::new(expected.as_ref().clone());
+    let _ = manager.with_matching_parent_policy(&foreign, || {
+        calls.set(calls.get() + 1);
+        None
+    });
+    assert_eq!(calls.get(), 1);
+}
+
+#[tokio::test]
+async fn busy_and_closed_policy_owner_never_enters_the_callback() {
+    let manager = ExecPolicyManager::default();
+    let expected = manager.current();
+    let calls = Cell::new(0);
+    let held = manager.update_lock.acquire().await.unwrap();
+    let _ = manager.with_matching_parent_policy(&expected, || {
+        calls.set(calls.get() + 1);
+        None
+    });
+    assert_eq!(calls.get(), 0);
+    drop(held);
+    manager.update_lock.close();
+    let _ = manager.with_matching_parent_policy(&expected, || {
+        calls.set(calls.get() + 1);
+        None
+    });
+    assert_eq!(calls.get(), 0);
+}
+
+#[tokio::test]
+async fn both_real_policy_updaters_invalidate_the_original_arc() -> anyhow::Result<()> {
+    for update in ["command", "network"] {
+        let home = tempfile::tempdir()?;
+        let manager = ExecPolicyManager::default();
+        let original = manager.current();
+        match update {
+            "command" => {
+                manager
+                    .append_amendment_and_update(
+                        home.path(),
+                        &ExecPolicyAmendment::new(vec!["q2-offline-command".into()]),
+                    )
+                    .await?
+            }
+            "network" => {
+                manager
+                    .append_network_rule_and_update(
+                        home.path(),
+                        "q2.invalid",
+                        NetworkRuleProtocol::Https,
+                        Decision::Forbidden,
+                        /*justification*/ None,
+                    )
+                    .await?
+            }
+            _ => unreachable!(),
+        }
+        let calls = Cell::new(0);
+        let _ = manager.with_matching_parent_policy(&original, || {
+            calls.set(calls.get() + 1);
+            None
+        });
+        assert_eq!(calls.get(), 0, "stale {update} snapshot");
+        let current = manager.current();
+        assert!(!Arc::ptr_eq(&original, &current));
+        let _ = manager.with_matching_parent_policy(&current, || {
+            calls.set(calls.get() + 1);
+            assert!(manager.update_lock.try_acquire().is_err());
+            None
+        });
+        assert_eq!(calls.get(), 1, "renewed {update} snapshot");
+    }
+    Ok(())
+}
