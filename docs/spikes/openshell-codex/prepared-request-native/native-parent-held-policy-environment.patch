@@ -0,0 +1,263 @@
+//! Nonpolling held-owner observations; no approval or provenance constructors.
+use super::*;
+use crate::config::PermissionProfileSnapshot;
+use crate::exec_policy::ExecPolicyManager;
+use codex_exec_server::LOCAL_ENVIRONMENT_ID;
+use codex_protocol::permissions::NetworkSandboxPolicy;
+use codex_protocol::sandbox::SandboxType;
+use pretty_assertions::assert_eq;
+use std::cell::Cell;
+use std::sync::atomic::AtomicUsize;
+use std::sync::atomic::Ordering;
+use std::task::Poll;
+
+async fn ready_owner() -> Arc<ThreadEnvironments> {
+    let owner = Arc::new(ThreadEnvironments::new(
+        Arc::new(EnvironmentManager::default_for_tests()),
+        crate::shell::default_user_shell(),
+        ThreadEnvironmentDefaults::new(tests::test_environment_config(), SandboxType::None),
+        ShellSnapshot::disabled(),
+        TurnEnvironmentSnapshot::default(),
+        /*non_blocking_snapshots*/ false,
+    ));
+    let cwd = PathUri::from_abs_path(&AbsolutePathBuf::current_dir().expect("cwd"));
+    owner.update_selections(&[TurnEnvironmentSelection {
+        environment_id: LOCAL_ENVIRONMENT_ID.into(),
+        cwd: cwd.clone(),
+        workspace_roots: vec![cwd],
+        config: EnvironmentConfigState::FromThread,
+    }]);
+    assert!(owner.snapshot().await.primary().is_some());
+    owner
+}
+
+fn entries(
+    owner: &Arc<ThreadEnvironments>,
+    observed: &SelectedEnvironmentObservation,
+    target: &str,
+) -> usize {
+    let count = Cell::new(0);
+    assert!(
+        owner
+            .with_current_parent_environment(observed, target, || {
+                count.set(count.get() + 1);
+                assert!(owner.state.try_lock().is_err());
+                None
+            })
+            .is_none()
+    );
+    count.get()
+}
+
+#[tokio::test]
+async fn current_ready_and_nested_policy_callback_retain_both_actual_guards() {
+    let owner = ready_owner().await;
+    let observed = owner.observe_selected();
+    assert_eq!(entries(&owner, &observed, LOCAL_ENVIRONMENT_ID), 1);
+    let manager = ExecPolicyManager::default();
+    let policy = manager.current();
+    let outer = Cell::new(0);
+    let inner = Cell::new(0);
+    let _ = manager.with_matching_parent_policy(&policy, || {
+        outer.set(outer.get() + 1);
+        owner.with_current_parent_environment(&observed, LOCAL_ENVIRONMENT_ID, || {
+            inner.set(inner.get() + 1);
+            assert!(owner.state.try_lock().is_err());
+            let reentered = Cell::new(0);
+            let _ = manager.with_matching_parent_policy(&policy, || {
+                reentered.set(reentered.get() + 1);
+                None
+            });
+            assert_eq!(reentered.get(), 0);
+            None
+        })
+    });
+    assert_eq!((outer.get(), inner.get()), (1, 1));
+}
+
+#[tokio::test]
+async fn foreign_missing_removed_duplicate_and_ordered_entries_refuse() {
+    let owner = ready_owner().await;
+    let observed = owner.observe_selected();
+    let foreign = ready_owner().await;
+    assert_eq!(entries(&foreign, &observed, LOCAL_ENVIRONMENT_ID), 0);
+    assert_eq!(entries(&owner, &observed, "missing"), 0);
+    let original = owner.state.lock().unwrap().environments[0].clone();
+    owner.state.lock().unwrap().environments.clear();
+    assert_eq!(entries(&owner, &observed, LOCAL_ENVIRONMENT_ID), 0);
+    owner.state.lock().unwrap().environments = vec![original.clone(), original.clone()];
+    let duplicate = owner.observe_selected();
+    assert_eq!(entries(&owner, &duplicate, LOCAL_ENVIRONMENT_ID), 0);
+    owner.state.lock().unwrap().environments[1]
+        .selection
+        .environment_id = "secondary".into();
+    let two = owner.observe_selected();
+    assert_eq!(entries(&owner, &two, LOCAL_ENVIRONMENT_ID), 1);
+    assert_eq!(entries(&owner, &observed, LOCAL_ENVIRONMENT_ID), 0);
+    owner.state.lock().unwrap().environments.reverse();
+    assert_eq!(entries(&owner, &two, LOCAL_ENVIRONMENT_ID), 0);
+}
+
+#[tokio::test]
+async fn raw_ready_config_origin_cwd_roots_and_environment_identity_drift_refuse() {
+    let owner = ready_owner().await;
+    let original = owner.state.lock().unwrap().environments[0].clone();
+    for change in [
+        "origin", "profile", "network", "cwd", "roots", "selected", "resolved", "shared",
+    ] {
+        owner.state.lock().unwrap().environments[0] = original.clone();
+        let observed = owner.observe_selected();
+        let mut replacement = original.clone();
+        match change {
+            "origin" => replacement.config_origin = EnvironmentConfigOrigin::Owner,
+            "profile" | "network" => {
+                let EnvironmentConfigState::Ready(config) = &mut replacement.selection.config
+                else {
+                    panic!("ready fixture")
+                };
+                let profile = if change == "profile" {
+                    PermissionProfile::workspace_write()
+                } else {
+                    PermissionProfile::from_runtime_permissions(
+                        &PermissionProfile::read_only().file_system_sandbox_policy(),
+                        NetworkSandboxPolicy::Enabled,
+                    )
+                };
+                config.permission_profile = PermissionProfileSnapshot::legacy(profile);
+            }
+            "cwd" => {
+                replacement.selection.cwd = PathUri::from_abs_path(
+                    &AbsolutePathBuf::current_dir()
+                        .unwrap()
+                        .join("different-cwd"),
+                )
+            }
+            "roots" => replacement.selection.workspace_roots.clear(),
+            "selected" => replacement.environment = Arc::new(Environment::default_for_tests()),
+            "resolved" | "shared" => {
+                let mut cached = original.resolution.peek().cloned().unwrap();
+                if change == "resolved" {
+                    cached.as_mut().unwrap().environment =
+                        Arc::new(Environment::default_for_tests());
+                }
+                let resolution = futures::future::ready(cached).boxed().shared();
+                assert!(resolution.clone().await.is_ok());
+                replacement.resolution = resolution;
+            }
+            _ => unreachable!(),
+        }
+        owner.state.lock().unwrap().environments[0] = replacement;
+        assert_eq!(
+            entries(&owner, &observed, LOCAL_ENVIRONMENT_ID),
+            0,
+            "{change}"
+        );
+    }
+}
+
+#[tokio::test]
+async fn same_projected_thread_identity_cannot_hide_resolved_network_change() {
+    let owner = ready_owner().await;
+    let observed = owner.observe_selected();
+    let projected = owner.selections();
+    let original = observed.snapshot().primary().unwrap();
+    let config = EnvironmentConfig {
+        permission_profile: PermissionProfileSnapshot::legacy(
+            PermissionProfile::from_runtime_permissions(
+                &PermissionProfile::read_only().file_system_sandbox_policy(),
+                NetworkSandboxPolicy::Enabled,
+            ),
+        ),
+        ..tests::test_environment_config()
+    };
+    owner.set_active_thread_defaults(config);
+    let current = owner.observe_selected();
+    let ready = current.snapshot().primary().unwrap();
+    assert_eq!(owner.selections(), projected);
+    assert_eq!(ready.selection(), original.selection());
+    assert!(Arc::ptr_eq(&ready.environment, &original.environment));
+    assert_eq!(entries(&owner, &observed, LOCAL_ENVIRONMENT_ID), 0);
+    assert_eq!(entries(&owner, &current, LOCAL_ENVIRONMENT_ID), 1);
+}
+
+#[tokio::test]
+async fn every_selected_startup_must_already_be_successfully_cached_without_polling() {
+    let owner = ready_owner().await;
+    let original = owner.state.lock().unwrap().environments[0].clone();
+    let polls = Arc::new(AtomicUsize::new(0));
+    let counted = Arc::clone(&polls);
+    let cached = original.resolution.peek().cloned().unwrap();
+    let resolution = futures::future::poll_fn(move |_| {
+        counted.fetch_add(1, Ordering::SeqCst);
+        Poll::Ready(cached.clone())
+    })
+    .boxed()
+    .shared();
+    let mut secondary = original.clone();
+    secondary.selection.environment_id = "secondary".into();
+    secondary.resolution = resolution.clone();
+    owner.state.lock().unwrap().environments.push(secondary);
+    let starting = owner.observe_selected();
+    assert_eq!(entries(&owner, &starting, LOCAL_ENVIRONMENT_ID), 0);
+    assert_eq!(polls.load(Ordering::SeqCst), 0);
+    assert!(resolution.await.is_ok());
+    let ready = owner.observe_selected();
+    assert_eq!(entries(&owner, &starting, LOCAL_ENVIRONMENT_ID), 0);
+    assert_eq!(entries(&owner, &ready, LOCAL_ENVIRONMENT_ID), 1);
+    assert_eq!(polls.load(Ordering::SeqCst), 1);
+    let failed = futures::future::ready(Err(Arc::new(ExecServerError::Protocol("failure".into()))))
+        .boxed()
+        .shared();
+    assert!(failed.clone().await.is_err());
+    owner.state.lock().unwrap().environments[1].resolution = failed;
+    let observed = owner.observe_selected();
+    assert_eq!(entries(&owner, &observed, LOCAL_ENVIRONMENT_ID), 0);
+    assert_eq!(entries(&owner, &observed, "secondary"), 0);
+}
+
+#[tokio::test]
+async fn pending_installed_ready_is_supported_but_nonready_derivations_refuse() {
+    let owner = ready_owner().await;
+    let original = owner.state.lock().unwrap().environments[0].clone();
+    for configuration in ["installed", "pending", "failed"] {
+        let mut selected = original.clone();
+        selected.config_origin = EnvironmentConfigOrigin::Owner;
+        selected.selection.config = if configuration == "failed" {
+            EnvironmentConfigState::Failed("raw failure".into())
+        } else {
+            EnvironmentConfigState::Pending
+        };
+        let mut cached = original.resolution.peek().cloned().unwrap();
+        cached.as_mut().unwrap().installed_config = if configuration == "installed" {
+            Some(tests::test_environment_config())
+        } else {
+            None
+        };
+        let resolution = futures::future::ready(cached).boxed().shared();
+        assert!(resolution.clone().await.is_ok());
+        selected.resolution = resolution;
+        owner.state.lock().unwrap().environments[0] = selected;
+        let observed = owner.observe_selected();
+        assert_eq!(
+            entries(&owner, &observed, LOCAL_ENVIRONMENT_ID),
+            usize::from(configuration == "installed"),
+            "{configuration}"
+        );
+    }
+}
+
+#[tokio::test]
+async fn busy_and_poisoned_environment_owner_never_enters_callback() {
+    let owner = ready_owner().await;
+    let observed = owner.observe_selected();
+    {
+        let _held = owner.state.lock().unwrap();
+        assert_eq!(entries(&owner, &observed, LOCAL_ENVIRONMENT_ID), 0);
+    }
+    let caught = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+        let _held = owner.state.lock().unwrap();
+        panic!("poison actual selected owner");
+    }));
+    assert!(caught.is_err());
+    assert_eq!(entries(&owner, &observed, LOCAL_ENVIRONMENT_ID), 0);
+}
