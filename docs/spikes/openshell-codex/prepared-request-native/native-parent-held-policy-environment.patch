+    /// Keeps selected bindings held through an optional parent resolution, without polling.
+    /// Cached startup must be complete for every entry; connection liveness is not fenced.
+    pub(crate) fn with_current_parent_environment(
+        self: &Arc<Self>,
+        observed: &SelectedEnvironmentObservation,
+        target: &str,
+        finish: impl FnOnce() -> Option<crate::tools::ApprovalResolution>,
+    ) -> Option<crate::tools::ApprovalResolution> {
+        let state = self.state.try_lock().ok()?;
+        if !observed
+            .owner
+            .upgrade()
+            .is_some_and(|owner| Arc::ptr_eq(&owner, self))
+        {
+            return None;
+        }
+        // One peek per current entry supplies both cache status and the derived state.
+        let current = self.observe_selected_locked(&state);
+        let matching_entries =
+            observed
+                .entries
+                .iter()
+                .zip(&current.entries)
+                .all(|(previous, current)| {
+                    previous.selection == current.selection
+                        && previous.config_origin == current.config_origin
+                        && Arc::ptr_eq(&previous.environment, &current.environment)
+                        && previous.resolution.ptr_eq(&current.resolution)
+                        && matches!(
+                            (&previous.cached, &current.cached),
+                            (
+                                CachedEnvironmentResolution::Ready(previous),
+                                CachedEnvironmentResolution::Ready(current)
+                            ) if Arc::ptr_eq(previous, current)
+                        )
+                });
+        let matching_ready = observed
+            .snapshot
+            .environments
+            .iter()
+            .zip(&current.snapshot.environments)
+            .all(|(previous, current)| {
+                let (TurnEnvironmentState::Ready(previous), TurnEnvironmentState::Ready(current)) =
+                    (previous, current)
+                else {
+                    return false;
+                };
+                matches!(previous.selection.config, EnvironmentConfigState::Ready(_))
+                    && matches!(current.selection.config, EnvironmentConfigState::Ready(_))
+                    && previous.selection == current.selection
+                    && previous.config_origin == current.config_origin
+                    && Arc::ptr_eq(&previous.environment, &current.environment)
+                    && previous.executor_platform_os == current.executor_platform_os
+                    && previous.user_home_dir == current.user_home_dir
+                    && previous.temporary_directories == current.temporary_directories
+            });
+        if observed.entries.len() != current.entries.len()
+            || observed.snapshot.environments.len() != observed.entries.len()
+            || current.snapshot.environments.len() != current.entries.len()
+            || observed
+                .snapshot
+                .turn_environments()
+                .filter(|ready| ready.selection.environment_id == target)
+                .count()
+                != 1
+            || current
+                .snapshot
+                .turn_environments()
+                .filter(|ready| ready.selection.environment_id == target)
+                .count()
+                != 1
+            || !matching_entries
+            || !matching_ready
+        {
+            return None;
+        }
+        finish()
+    }
+
     pub(crate) fn new(
         environment_manager: Arc<EnvironmentManager>,
         local_shell: Shell,
