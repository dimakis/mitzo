diff --git a/codex-rs/state/migrations/0062_prepared_request_effects.sql b/codex-rs/state/migrations/0062_prepared_request_effects.sql
new file mode 100644
index 0000000..487abf2
--- /dev/null
+++ b/codex-rs/state/migrations/0062_prepared_request_effects.sql
@@ -0,0 +1,58 @@
+-- Existing committed/legacy rows retain uncertainty. Only a new commitment may
+-- explicitly withhold its handoff; never infer zero effects from absent receipts.
+ALTER TABLE prepared_requests ADD COLUMN effect_state TEXT NOT NULL DEFAULT 'ordinary'
+CHECK (effect_state IN ('ordinary', 'pending', 'released', 'refused_before_effects')
+    AND (effect_state = 'ordinary' OR (consumed = 1 AND attempt_state = 'committed')));
+
+CREATE TRIGGER prepared_requests_initial_effect_state
+BEFORE INSERT ON prepared_requests WHEN NEW.effect_state != 'ordinary'
+BEGIN
+    SELECT RAISE(ABORT, 'prepared effects must start in ordinary state');
+END;
+
+CREATE TRIGGER prepared_requests_effect_transition
+BEFORE UPDATE OF effect_state ON prepared_requests
+WHEN NEW.effect_state != OLD.effect_state AND NOT (
+    (OLD.effect_state = 'ordinary' AND NEW.effect_state = 'pending'
+        AND OLD.attempt_state = 'open' AND NEW.attempt_state = 'committed'
+        AND OLD.consumed = 1 AND NEW.consumed = 1 AND NEW.consumption_nonce IS NOT NULL)
+    OR (OLD.effect_state = 'pending' AND NEW.effect_state IN ('released', 'refused_before_effects')
+        AND OLD.attempt_state = 'committed' AND NEW.attempt_state = 'committed')
+)
+BEGIN
+    SELECT RAISE(ABORT, 'prepared effect decision is irreversible');
+END;
+
+CREATE TRIGGER prepared_requests_pending_without_receipts
+BEFORE UPDATE OF effect_state ON prepared_requests
+WHEN NEW.effect_state IN ('pending', 'refused_before_effects')
+    AND (NEW.native_thread_id IS NOT NULL OR NEW.native_turn_id IS NOT NULL
+        OR NEW.native_turn_owner_preparation_id IS NOT NULL OR NEW.provider_response_id IS NOT NULL)
+BEGIN
+    SELECT RAISE(ABORT, 'pending or refused effects cannot retain acceptance');
+END;
+
+CREATE TRIGGER prepared_requests_receipts_require_effect_release
+BEFORE UPDATE OF native_thread_id, native_turn_id, native_turn_owner_preparation_id, provider_response_id ON prepared_requests
+WHEN NEW.effect_state IN ('pending', 'refused_before_effects')
+BEGIN
+    SELECT RAISE(ABORT, 'pending or refused effects cannot acknowledge');
+END;
+
+CREATE TRIGGER prepared_requests_sampling_requires_effect_release
+BEFORE UPDATE OF consumed ON prepared_requests
+WHEN OLD.consumed = 0 AND NEW.consumed = 1
+    AND EXISTS (
+        SELECT 1 FROM prepared_requests previous
+        WHERE previous.preparation_id = json_extract(NEW.binding_json, '$.sampling.previous_preparation_id')
+            AND previous.effect_state IN ('pending', 'refused_before_effects')
+    )
+BEGIN
+    SELECT RAISE(ABORT, 'pending or refused effects cannot authorize continuation');
+END;
+
+CREATE TRIGGER prepared_requests_retain_effect_claim
+BEFORE DELETE ON prepared_requests WHEN OLD.effect_state != 'ordinary'
+BEGIN
+    SELECT RAISE(ABORT, 'prepared effect claim must be retained');
+END;
