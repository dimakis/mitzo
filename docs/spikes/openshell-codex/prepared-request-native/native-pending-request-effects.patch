diff --git a/codex-rs/state/src/runtime/prepared_request_effects.rs b/codex-rs/state/src/runtime/prepared_request_effects.rs
new file mode 100644
index 0000000..dd7386f
--- /dev/null
+++ b/codex-rs/state/src/runtime/prepared_request_effects.rs
@@ -0,0 +1,109 @@
+//! Durable private pending claims, without an executable transport handoff.
+//!
+//! These transitions are not authority verification. The native owner must prove
+//! original canonical revisions across commitment before releasing effects. A
+//! missing proof must close the pending gate, never manufacture a send right.
+
+use super::PreparedRequestAttempt;
+use super::PreparedRequestConsumption;
+use super::PreparedRequestRecord;
+use super::StateRuntime;
+use super::record_from_row;
+use super::sampling::REQUEST_BY_PREPARATION_ID;
+use sqlx::Connection;
+use sqlx::Row;
+use sqlx::SqlitePool;
+use std::sync::Arc;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum PreparedRequestEffectState {
+    /// Existing ordinary/legacy path; no retrospective zero-effects inference.
+    Ordinary,
+    Pending,
+    Released,
+    RefusedBeforeEffects,
+}
+
+/// Private one-use custody of a committed claim. This cannot enter transport.
+/// Reads and restart cannot reconstruct it. It is neither an authority proof nor
+/// admission acknowledgement, and must never be passed to queue/session owners.
+pub struct PendingPreparedRequestAttempt {
+    record: PreparedRequestRecord,
+    nonce: String,
+    owner_pool: Arc<SqlitePool>,
+}
+
+impl PendingPreparedRequestAttempt {
+    pub fn record(&self) -> &PreparedRequestRecord {
+        &self.record
+    }
+}
+
+impl StateRuntime {
+    /// Commit an irrevocable private pending claim, withholding the transport
+    /// handoff. The caller still owns canonical/native authority verification;
+    /// this method cannot establish its retrospective proof or guarded CAS.
+    pub async fn commit_pending_prepared_request_attempt(
+        &self,
+        consumption: PreparedRequestConsumption,
+    ) -> anyhow::Result<PendingPreparedRequestAttempt> {
+        let (record, nonce) = self
+            .commit_prepared_request_attempt_record(
+                consumption,
+                PreparedRequestEffectState::Pending,
+            )
+            .await?;
+        Ok(PendingPreparedRequestAttempt {
+            record,
+            nonce,
+            owner_pool: Arc::clone(&self.pool),
+        })
+    }
+
+    /// Release one pending handoff after the trusted native owner verifies the
+    /// exact private retrospective authority response. This API does not accept
+    /// a caller epoch, permission boolean or reusable authorization callback.
+    /// Cancellation/refusal winning first permanently excludes a delayed release.
+    /// After release, a lost handoff or crash remains consumed uncertainty.
+    pub async fn release_prepared_request_effects(
+        &self,
+        pending: PendingPreparedRequestAttempt,
+    ) -> anyhow::Result<PreparedRequestAttempt> {
+        let PendingPreparedRequestAttempt {
+            record: expected,
+            nonce,
+            owner_pool,
+        } = pending;
+        anyhow::ensure!(
+            Arc::ptr_eq(&self.pool, &owner_pool),
+            "prepared pending runtime custody conflicts"
+        );
+        let mut connection = self.prepared_request_connection().await?;
+        let mut transaction = connection.begin_with("BEGIN IMMEDIATE").await?;
+        let row = sqlx::query(REQUEST_BY_PREPARATION_ID)
+            .bind(&expected.preparation_id)
+            .fetch_one(&mut *transaction)
+            .await?;
+        let mut record = record_from_row(&row)?;
+        anyhow::ensure!(
+            record == expected,
+            "prepared pending claim changed or closed"
+        );
+        anyhow::ensure!(
+            record.effect_state == PreparedRequestEffectState::Pending,
+            "prepared effects are not pending"
+        );
+        anyhow::ensure!(
+            row.try_get::<Option<String>, _>("consumption_nonce")?
+                .as_deref()
+                == Some(nonce.as_str()),
+            "prepared pending claim conflicts"
+        );
+        let result = sqlx::query("UPDATE prepared_requests SET effect_state = 'released' WHERE preparation_id = ? AND consumed = 1 AND attempt_state = 'committed' AND effect_state = 'pending' AND consumption_nonce = ?")
+            .bind(&expected.preparation_id).bind(nonce).execute(&mut *transaction).await?;
+        anyhow::ensure!(result.rows_affected() == 1, "prepared effect release lost");
+        transaction.commit().await?;
+        record.effect_state = PreparedRequestEffectState::Released;
+        Ok(PreparedRequestAttempt { record })
+    }
+}
diff --git a/codex-rs/state/src/runtime/prepared_request_effects_tests.rs b/codex-rs/state/src/runtime/prepared_request_effects_tests.rs
new file mode 100644
index 0000000..ae2fd27
--- /dev/null
+++ b/codex-rs/state/src/runtime/prepared_request_effects_tests.rs
@@ -0,0 +1,258 @@
+use super::*;
+
+#[tokio::test]
+async fn pending_claim_cannot_acknowledge_and_refusal_survives_restart() {
+    let home = unique_temp_dir();
+    let runtime = open(&home).await;
+    let request = request();
+    let prepared = runtime.prepare_request("pending", &request).await.unwrap();
+    runtime
+        .measure_prepared_request(&prepared.preparation_id, &request, &measurement())
+        .await
+        .unwrap();
+    let consumption = runtime
+        .consume_prepared_request(&prepared.preparation_id, &request, "witness")
+        .await
+        .unwrap();
+    let pending = runtime
+        .commit_pending_prepared_request_attempt(consumption)
+        .await
+        .unwrap();
+    let turn = PreparedTurnReceipt {
+        thread_id: "thread".into(),
+        turn_id: "turn".into(),
+    };
+    let provider = PreparedProviderReceipt {
+        request_identity: request.request_identity.clone(),
+        provider_response_id: "response".into(),
+    };
+    assert!(sqlx::query("UPDATE prepared_requests SET native_thread_id = 'thread', native_turn_id = 'turn' WHERE preparation_id = ?").bind(&prepared.preparation_id).execute(runtime.pool.as_ref()).await.is_err());
+    assert!(
+        runtime
+            .acknowledge_prepared_request(&prepared.preparation_id, &turn)
+            .await
+            .is_err()
+    );
+    assert!(
+        runtime
+            .record_prepared_provider_receipt(&prepared.preparation_id, &provider)
+            .await
+            .is_err()
+    );
+    assert_eq!(
+        runtime
+            .close_prepared_request(&prepared.preparation_id, &request)
+            .await
+            .unwrap(),
+        PreparedRequestClosure::RefusedBeforeEffects
+    );
+    assert!(
+        runtime
+            .release_prepared_request_effects(pending)
+            .await
+            .is_err()
+    );
+    assert!(
+        runtime
+            .consume_prepared_request(&prepared.preparation_id, &request, "witness")
+            .await
+            .is_err()
+    );
+    let refused = runtime
+        .read_prepared_request("pending")
+        .await
+        .unwrap()
+        .unwrap();
+    assert!(refused.consumed);
+    assert_eq!(
+        refused.attempt_state,
+        PreparedRequestAttemptState::Committed
+    );
+    assert_eq!(
+        refused.effect_state,
+        PreparedRequestEffectState::RefusedBeforeEffects
+    );
+    assert_eq!(
+        (refused.exact_turn.clone(), refused.provider_receipt.clone()),
+        (None, None)
+    );
+    assert!(
+        sqlx::query(
+            "UPDATE prepared_requests SET effect_state = 'released' WHERE preparation_id = ?"
+        )
+        .bind(&prepared.preparation_id)
+        .execute(runtime.pool.as_ref())
+        .await
+        .is_err()
+    );
+    assert!(
+        sqlx::query("DELETE FROM prepared_requests WHERE preparation_id = ?")
+            .bind(&prepared.preparation_id)
+            .execute(runtime.pool.as_ref())
+            .await
+            .is_err()
+    );
+    runtime.close().await;
+    let reopened = open(&home).await;
+    assert_eq!(
+        reopened.read_prepared_request("pending").await.unwrap(),
+        Some(refused)
+    );
+    assert!(
+        reopened
+            .acknowledge_prepared_request(&prepared.preparation_id, &turn)
+            .await
+            .is_err()
+    );
+    assert!(
+        reopened
+            .record_prepared_provider_receipt(&prepared.preparation_id, &provider)
+            .await
+            .is_err()
+    );
+    assert_eq!(
+        reopened
+            .close_prepared_request(&prepared.preparation_id, &request)
+            .await
+            .unwrap(),
+        PreparedRequestClosure::RefusedBeforeEffects
+    );
+    assert!(sqlx::query("UPDATE prepared_requests SET provider_response_id = 'response' WHERE preparation_id = ?").bind(&prepared.preparation_id).execute(reopened.pool.as_ref()).await.is_err());
+}
+
+#[tokio::test]
+async fn release_and_cancellation_have_one_durable_winner() {
+    for iteration in 0..8 {
+        let home = unique_temp_dir();
+        let runtime = open(&home).await;
+        let request = request();
+        let operation = format!("race-{iteration}");
+        let prepared = runtime.prepare_request(&operation, &request).await.unwrap();
+        runtime
+            .measure_prepared_request(&prepared.preparation_id, &request, &measurement())
+            .await
+            .unwrap();
+        let consumption = runtime
+            .consume_prepared_request(&prepared.preparation_id, &request, "witness")
+            .await
+            .unwrap();
+        let pending = runtime
+            .commit_pending_prepared_request_attempt(consumption)
+            .await
+            .unwrap();
+        let (release, close) = tokio::join!(
+            runtime.release_prepared_request_effects(pending),
+            runtime.close_prepared_request(&prepared.preparation_id, &request)
+        );
+        let current = runtime
+            .read_prepared_request(&operation)
+            .await
+            .unwrap()
+            .unwrap();
+        match close.unwrap() {
+            PreparedRequestClosure::RefusedBeforeEffects => {
+                assert!(release.is_err());
+                assert_eq!(
+                    current.effect_state,
+                    PreparedRequestEffectState::RefusedBeforeEffects
+                );
+            }
+            PreparedRequestClosure::AttemptAlreadyCommitted => {
+                let attempt = release.expect("release won");
+                assert_eq!(attempt.record(), &current);
+                assert_eq!(current.effect_state, PreparedRequestEffectState::Released);
+                runtime
+                    .acknowledge_prepared_request(
+                        &prepared.preparation_id,
+                        &PreparedTurnReceipt {
+                            thread_id: "thread".into(),
+                            turn_id: "turn".into(),
+                        },
+                    )
+                    .await
+                    .unwrap();
+                runtime
+                    .record_prepared_provider_receipt(
+                        &prepared.preparation_id,
+                        &PreparedProviderReceipt {
+                            request_identity: request.request_identity.clone(),
+                            provider_response_id: "response".into(),
+                        },
+                    )
+                    .await
+                    .unwrap();
+            }
+            other => panic!("unexpected pending closure {other:?}"),
+        }
+    }
+}
+
+#[tokio::test]
+async fn pending_custody_is_pool_local_and_ordinary_attempts_remain_uncertain() {
+    let home = unique_temp_dir();
+    let runtime = open(&home).await;
+    let request = request();
+    for (operation, pending_mode) in [("pending", true), ("ordinary", false)] {
+        let prepared = runtime.prepare_request(operation, &request).await.unwrap();
+        runtime
+            .measure_prepared_request(&prepared.preparation_id, &request, &measurement())
+            .await
+            .unwrap();
+        let consumption = runtime
+            .consume_prepared_request(&prepared.preparation_id, &request, "witness")
+            .await
+            .unwrap();
+        if pending_mode {
+            let pending = runtime
+                .commit_pending_prepared_request_attempt(consumption)
+                .await
+                .unwrap();
+            let foreign_pool = open(&home).await;
+            assert!(
+                foreign_pool
+                    .release_prepared_request_effects(pending)
+                    .await
+                    .is_err()
+            );
+            assert_eq!(
+                runtime
+                    .close_prepared_request(&prepared.preparation_id, &request)
+                    .await
+                    .unwrap(),
+                PreparedRequestClosure::RefusedBeforeEffects
+            );
+        } else {
+            drop(
+                runtime
+                    .commit_prepared_request_attempt(consumption)
+                    .await
+                    .unwrap(),
+            );
+            assert_eq!(
+                runtime
+                    .close_prepared_request(&prepared.preparation_id, &request)
+                    .await
+                    .unwrap(),
+                PreparedRequestClosure::AttemptAlreadyCommitted
+            );
+            assert_eq!(
+                runtime
+                    .read_prepared_request(operation)
+                    .await
+                    .unwrap()
+                    .unwrap()
+                    .effect_state,
+                PreparedRequestEffectState::Ordinary
+            );
