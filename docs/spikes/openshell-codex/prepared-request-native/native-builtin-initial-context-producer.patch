+use super::*;
+use crate::session::initial_context_builtin::InitialDeveloperData;
+use crate::session::initial_context_render::{
+    InitialContextRenderInput, ResolvedInitialWorldState, collect_initial_world_state,
+    render_initial_context,
+};
+use pretty_assertions::assert_eq;
+use std::sync::Arc;
+
+#[tokio::test]
+async fn original_session_full_builtin_data_preserves_native_order_roles_and_placement()
+-> anyhow::Result<()> {
+    // Genuine ordinary Session/Step owner is a comparison oracle outside the
+    // preparation branch. No hand-built Session/Turn/Step or inference is used.
+    let (session, turn) = crate::session::tests::make_session_and_context().await;
+    let session = Arc::new(session);
+    let step = session
+        .capture_step_context(Arc::new(turn), &tokio_util::sync::CancellationToken::new())
+        .await?;
+    let (before, _) = session
+        .collect_builtin_initial_context_before_extensions(&step)
+        .await?;
+    let after = session.collect_builtin_initial_context_after_extensions(&step);
+    // Compare the extracted strict formatter against the original constructor,
+    // using genuine ordinary settings/environment/policy/model owners.
+    if let PermissionInitialContext::Full(section) = &before.permission {
+        use crate::context::world_state::WorldStateSection;
+        let environment = step.environments.primary();
+        let sandbox = environment
+            .filter(|entry| entry.environment.is_remote())
+            .map(|entry| entry.sandbox_context(/*additional_permissions*/ None));
+        let paths = sandbox
+            .as_ref()
+            .map(codex_file_system::FileSystemSandboxContext::policy_context);
+        let profile = step
+            .turn
+            .permission_profile_for_environments(&step.environments);
+        let cwd = environment
+            .and_then(|entry| entry.cwd().to_abs_path().ok())
+            .unwrap_or_else(|| step.turn.cwd.clone());
+        let policy = session
+            .services
+            .exec_policy
+            .current_for_prefix_rules(step.turn.allow_prefix_rules());
+        let original = PermissionsState::new(
+            &profile,
+            step.settings.approval_policy(),
+            codex_prompts::ApprovalPromptContext::new(
+                step.settings.approvals_reviewer(),
+                codex_prompts::ResolvedModelMessages::from_model(&step.settings.model_info),
+            ),
+            &policy,
+            &cwd,
+            paths.as_ref(),
+            step.turn
+                .config
+                .features
+                .enabled(codex_features::Feature::ExecPermissionApprovals),
+            step.turn
+                .config
+                .features
+                .enabled(codex_features::Feature::RequestPermissionsTool),
+        );
+        assert_eq!(section.snapshot(), original.snapshot());
+    }
+
+    let complete =
+        CompleteBuiltinInitialContextData::from_original_inputs(before.clone(), after.clone());
+    let mut ordinary_native = before.install();
+    after.install(&mut ordinary_native);
+    let original = collect_initial_world_state(&ordinary_native);
+    let resolved = ResolvedInitialWorldState::from_sections(
+        complete
+            .before_extensions
+            .into_iter()
+            .chain(complete.after_extensions)
+            .collect(),
+    );
+    let render = |world_state| {
+        let developer = InitialDeveloperData::new(
+            &step.turn.session_source,
+            step.turn.developer_instructions.as_deref(),
+        );
+        render_initial_context(InitialContextRenderInput {
+            world_state,
+            developer_sections: developer.developer_sections,
+            contextual_user_sections: Vec::new(),
+            separate_developer_sections: Vec::new(),
+            recommended_plugins: None,
+            separate_guardian_developer_message: crate::guardian::is_basic_session_source(
+                &step.turn.session_source,
+            ),
+            developer_instructions: step.turn.developer_instructions.as_deref(),
+            turn_id: &step.turn.sub_id,
+        })
+    };
+    // Whole annotated native-component items: roles, markers, separate-message
+    // placement, whitespace and the REAL ordinary turn identity. This does not
+    // qualify extension/tool inventories or a complete fresh prepared factory.
+    assert_eq!(render(resolved), render(original));
+    Ok(())
+}
