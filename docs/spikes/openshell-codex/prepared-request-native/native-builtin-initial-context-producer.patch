+//! Complete ORIGINAL builtin section input boundary, after source acquisition.
+//! Ordinary startup and preparation share order and concrete native renderers.
+//! Options express ORIGINAL enabled/selected sections, never caller readiness.
+//! Only actual source owners may establish their inputs; this data owns no lease.
+#![cfg_attr(
+    not(test),
+    allow(
+        dead_code,
+        reason = "Complete fresh source inputs are not yet available."
+    )
+)]
+use super::initial_context_render::ResolvedInitialSection;
+use crate::context::TokenBudgetContext;
+use crate::context::world_state::AgentsMdState;
+use crate::context::world_state::AppsInstructionsState;
+use crate::context::world_state::CollaborationModeState;
+use crate::context::world_state::CompactPermissionsState;
+use crate::context::world_state::ContextWindowGuidanceState;
+use crate::context::world_state::EnvironmentsInstructionsState;
+use crate::context::world_state::EnvironmentsState;
+use crate::context::world_state::ManagedDeveloperInstructionsState;
+use crate::context::world_state::ModelInstructionsState;
+use crate::context::world_state::MultiAgentModeState;
+use crate::context::world_state::MultiAgentUsageHintState;
+use crate::context::world_state::PermissionsState;
+use crate::context::world_state::PersistentModeState;
+use crate::context::world_state::PluginsInstructionsState;
+use crate::context::world_state::RealtimeState;
+use crate::context::world_state::ToolsState;
+use crate::context::world_state::WorldState;
+
+#[derive(Clone)]
+pub(crate) enum PermissionInitialContext {
+    Full(PermissionsState),
+    Compact(CompactPermissionsState),
+}
+
+/// Every original native section before extension WorldState contributions.
+/// Missing active source facts cannot be represented by a partial constructor.
+#[derive(Clone)]
+pub(crate) struct BuiltinInitialContextBeforeExtensions {
+    pub(crate) model: ModelInstructionsState,
+    pub(crate) token_budget: Option<TokenBudgetContext>,
+    pub(crate) guidance: ContextWindowGuidanceState,
+    pub(crate) realtime: RealtimeState,
+    pub(crate) agents_md: AgentsMdState,
+    pub(crate) permission: PermissionInitialContext,
+    pub(crate) collaboration: Option<CollaborationModeState>,
+    pub(crate) persistent: Option<PersistentModeState>,
+    pub(crate) environments: Option<EnvironmentsState>,
+    pub(crate) environments_instructions: EnvironmentsInstructionsState,
+    pub(crate) apps_instructions: AppsInstructionsState,
+    pub(crate) plugins_instructions: PluginsInstructionsState,
+    pub(crate) tools: Option<ToolsState>,
+}
+
+/// Original native tail, AFTER extension sections and before final rendering.
+#[derive(Clone)]
+pub(crate) struct BuiltinInitialContextAfterExtensions {
+    pub(crate) usage_hint: Option<MultiAgentUsageHintState>,
+    pub(crate) multi_agent_mode: MultiAgentModeState,
+    pub(crate) managed: Option<ManagedDeveloperInstructionsState>,
+}
+
+macro_rules! native_sections {
+    ($($variant:ident($section:ty)),+ $(,)?) => {
+        enum NativeInitialSection { $($variant($section)),+ }
+        impl NativeInitialSection {
+            fn install(self, target: &mut WorldState) {
+                match self { $(Self::$variant(section) => target.add_section(section)),+ }
+            }
+            fn resolve(self) -> ResolvedInitialSection {
+                match self { $(Self::$variant(section) => ResolvedInitialSection::native(section)),+ }
+            }
+        }
+    };
+}
+native_sections! {
+    Model(ModelInstructionsState), Budget(TokenBudgetContext), Guidance(ContextWindowGuidanceState),
+    Realtime(RealtimeState), Agents(AgentsMdState), Permissions(PermissionsState),
+    CompactPermissions(CompactPermissionsState), Collaboration(CollaborationModeState),
+    Persistent(PersistentModeState), Environments(EnvironmentsState),
+    EnvironmentsInstructions(EnvironmentsInstructionsState), Apps(AppsInstructionsState),
+    Plugins(PluginsInstructionsState), Tools(ToolsState), UsageHint(MultiAgentUsageHintState),
+    MultiAgent(MultiAgentModeState), Managed(ManagedDeveloperInstructionsState),
+}
+impl BuiltinInitialContextBeforeExtensions {
+    fn sections(self) -> Vec<NativeInitialSection> {
+        let mut sections = vec![NativeInitialSection::Model(self.model)];
+        sections.extend(self.token_budget.map(NativeInitialSection::Budget));
+        sections.push(NativeInitialSection::Guidance(self.guidance));
+        sections.push(NativeInitialSection::Realtime(self.realtime));
+        sections.push(NativeInitialSection::Agents(self.agents_md));
+        sections.push(match self.permission {
+            PermissionInitialContext::Full(section) => NativeInitialSection::Permissions(section),
+            PermissionInitialContext::Compact(section) => {
+                NativeInitialSection::CompactPermissions(section)
+            }
+        });
+        sections.extend(self.collaboration.map(NativeInitialSection::Collaboration));
+        sections.extend(self.persistent.map(NativeInitialSection::Persistent));
+        sections.extend(self.environments.map(NativeInitialSection::Environments));
+        sections.push(NativeInitialSection::EnvironmentsInstructions(
+            self.environments_instructions,
+        ));
+        sections.push(NativeInitialSection::Apps(self.apps_instructions));
+        sections.push(NativeInitialSection::Plugins(self.plugins_instructions));
+        sections.extend(self.tools.map(NativeInitialSection::Tools));
+        sections
+    }
+    pub(crate) fn install(self) -> WorldState {
+        let mut world = WorldState::default();
+        for section in self.sections() {
+            section.install(&mut world);
+        }
+        world
+    }
+    /// Keeps markers, separate-message metadata, section IDs and native origin.
+    /// No WorldState or extension callback is constructed/invoked on this path.
+    pub(crate) fn resolve(self) -> Vec<ResolvedInitialSection> {
+        self.sections()
+            .into_iter()
+            .map(NativeInitialSection::resolve)
+            .collect()
+    }
+}
+impl BuiltinInitialContextAfterExtensions {
+    fn sections(self) -> Vec<NativeInitialSection> {
+        let mut sections = Vec::new();
+        sections.extend(self.usage_hint.map(NativeInitialSection::UsageHint));
+        sections.push(NativeInitialSection::MultiAgent(self.multi_agent_mode));
+        sections.extend(self.managed.map(NativeInitialSection::Managed));
+        sections
+    }
+    pub(crate) fn install(self, world: &mut WorldState) {
+        for section in self.sections() {
+            section.install(world);
+        }
+    }
+    pub(crate) fn resolve(self) -> Vec<ResolvedInitialSection> {
+        self.sections()
+            .into_iter()
+            .map(NativeInitialSection::resolve)
+            .collect()
+    }
+}
+
+/// Complete builtin DATA only: extension partitions and every original source
+/// renewal remain independent. Never serializable or a request/admission grant.
+pub struct CompleteBuiltinInitialContextData {
+    pub(crate) before_extensions: Vec<ResolvedInitialSection>,
+    pub(crate) after_extensions: Vec<ResolvedInitialSection>,
+}
+impl CompleteBuiltinInitialContextData {
+    pub(crate) fn from_original_inputs(
+        before: BuiltinInitialContextBeforeExtensions,
+        after: BuiltinInitialContextAfterExtensions,
+    ) -> Self {
+        Self {
+            before_extensions: before.resolve(),
+            after_extensions: after.resolve(),
+        }
+    }
+}
