+//! Exercise the actual initial call and retain only its stored process flag.
+use super::*;
+use crate::session::step_context::StepContext;
+use crate::session::tests::make_session_and_context_with_auth_and_config_and_rx;
+use crate::shell::ShellType;
+use codex_protocol::models::PermissionProfile;
+use codex_protocol::models::SandboxPermissions;
+use codex_protocol::protocol::AskForApproval;
+use codex_tools::UnifiedExecShellMode;
+use codex_utils_output_truncation::TruncationPolicy;
+use core_test_support::skip_if_sandbox;
+use pretty_assertions::assert_eq;
+
+// Own the real future/process so assertion failures and timeouts cannot detach them.
+struct InitialCall {
+    context: Arc<UnifiedExecContext>,
+    process_id: i32,
+    call: Option<tokio::task::JoinHandle<Result<ExecCommandToolOutput, UnifiedExecError>>>,
+    process: Option<Arc<UnifiedExecProcess>>,
+    cleaned: bool,
+}
+impl Drop for InitialCall {
+    fn drop(&mut self) {
+        if self.cleaned {
+            return;
+        }
+        let call = self.call.take();
+        if let Some(call) = &call {
+            call.abort();
+        }
+        if let Some(process) = &self.process {
+            process.terminate();
+        }
+        let context = Arc::clone(&self.context);
+        let id = self.process_id;
+        tokio::spawn(async move {
+            if let Some(call) = call {
+                let _ = call.await;
+            }
+            context
+                .session
+                .services
+                .unified_exec_manager
+                .terminate_all_processes()
+                .await;
+            context
+                .session
+                .services
+                .unified_exec_manager
+                .release_process_id(id)
+                .await;
+        });
+    }
+}
+impl InitialCall {
+    async fn finish(&mut self) -> anyhow::Result<Result<ExecCommandToolOutput, UnifiedExecError>> {
+        let result = tokio::time::timeout(
+            Duration::from_secs(45),
+            self.call.as_mut().expect("initial call"),
+        )
+        .await?;
+        self.call.take();
+        Ok(result?)
+    }
+    async fn cleanup(&mut self) {
+        if let Some(call) = self.call.take() {
+            call.abort();
+            let _ = call.await;
+        }
+        if let Some(process) = &self.process {
+            process.terminate();
+        }
+        self.context
+            .session
+            .services
+            .unified_exec_manager
+            .terminate_all_processes()
+            .await;
+        self.context
+            .session
+            .services
+            .unified_exec_manager
+            .release_process_id(self.process_id)
+            .await;
+        self.cleaned = true;
+    }
+}
+
+// These are process-lifetime tests, not approval/provenance constructors.
+async fn start_initial_call() -> anyhow::Result<(InitialCall, Arc<AtomicBool>)> {
+    let (session, turn, _events) = make_session_and_context_with_auth_and_config_and_rx(
+        codex_login::CodexAuth::from_api_key("offline-test"),
+        Vec::new(),
+        |config| {
+            config.permissions.approval_policy =
+                codex_config::Constrained::allow_any(AskForApproval::Never);
+            config
+                .permissions
+                .set_permission_profile(PermissionProfile::Disabled)
+                .expect("test permissions");
+        },
+    )
+    .await;
+    let step = StepContext::for_test(turn);
+    let environment = step
+        .environments
+        .primary()
+        .expect("local environment")
+        .clone();
+    let context = Arc::new(UnifiedExecContext::new(
+        session,
+        step,
+        CancellationToken::new(),
+        "initial-lifetime".into(),
+    ));
+    let manager = &context.session.services.unified_exec_manager;
+    let process_id = manager.allocate_process_id().await;
+    let request = ExecCommandRequest {
+        command: vec!["/bin/sh".into(), "-c".into(), "sleep 120".into()],
+        shell_type: ShellType::Sh,
+        hook_command: "sleep 120".into(),
+        process_id,
+        yield_time_ms: MAX_YIELD_TIME_MS,
+        max_output_tokens: Some(100),
+        cwd: environment.cwd().clone(),
+        sandbox_cwd: environment.cwd().clone(),
+        turn_environment: environment,
+        shell_mode: UnifiedExecShellMode::Direct,
+        network: None,
+        tty: false,
+        sandbox_permissions: SandboxPermissions::UseDefault,
+        additional_permissions: None,
+        additional_permissions_preapproved: false,
+        justification: None,
+        prefix_rule: None,
+    };
+    let running_context = Arc::clone(&context);
+    let call = tokio::spawn(async move {
+        Box::pin(
+            running_context
+                .session
+                .services
+                .unified_exec_manager
+                .exec_command_inner(request, &running_context, /*completion*/ None),
+        )
+        .await
+    });
+    let mut initial = InitialCall {
+        context: Arc::clone(&context),
+        process_id,
+        call: Some(call),
+        process: None,
+        cleaned: false,
+    };
+    let observed = tokio::time::timeout(Duration::from_secs(10), async {
+        loop {
+            let stored = {
+                let store = manager.process_store.lock().await;
+                store.processes.get(&process_id).map(|entry| {
+                    (
+                        Arc::clone(&entry.initial_exec_command_active),
+                        Arc::clone(&entry.process),
+                    )
+                })
+            };
+            if let Some(stored) = stored {
+                break Ok(stored);
+            }
+            if initial.call.as_ref().expect("initial call").is_finished() {
+                break Err(anyhow::anyhow!(
+                    "initial call ended before storing a live process"
+                ));
+            }
+            tokio::time::sleep(Duration::from_millis(5)).await;
+        }
+    })
+    .await;
+    let (active, process) = match observed {
+        Ok(Ok(stored)) => stored,
+        Ok(Err(error)) => {
+            initial.cleanup().await;
+            return Err(error);
+        }
+        Err(error) => {
+            initial.cleanup().await;
+            return Err(error.into());
+        }
+    };
+    initial.process = Some(process);
+    assert!(active.load(Ordering::Acquire));
+    Ok((initial, active))
+}
+
+async fn poll_retained_closed(
+    context: &UnifiedExecContext,
+    process_id: i32,
+    active: &AtomicBool,
+) -> anyhow::Result<()> {
+    assert!(!active.load(Ordering::Acquire));
+    let output = context
+        .session
+        .services
+        .unified_exec_manager
+        .write_stdin(
+            context,
+            WriteStdinRequest {
+                process_id,
+                input: "",
+                yield_time_ms: 1,
+                max_output_tokens: Some(100),
+                truncation_policy: TruncationPolicy::Bytes(1024),
+                interaction_event: None,
+            },
+        )
+        .await?;
+    assert_eq!(output.process_id, Some(process_id));
+    assert!(!active.load(Ordering::Acquire));
+    Ok(())
+}
+
+#[tokio::test]
+async fn actual_initial_yield_closes_flag_and_retained_poll_never_reopens_it() -> anyhow::Result<()>
+{
+    skip_if_sandbox!(Ok(()));
+    let (mut initial, active) = start_initial_call().await?;
+    let output = initial.finish().await??;
+    assert_eq!(output.process_id, Some(initial.process_id));
+    let result = poll_retained_closed(&initial.context, initial.process_id, &active).await;
+    initial.cleanup().await;
+    result
+}
+
+#[tokio::test]
+async fn dropping_actual_initial_call_closes_flag_without_killing_retained_process()
+-> anyhow::Result<()> {
+    skip_if_sandbox!(Ok(()));
+    let (mut initial, active) = start_initial_call().await?;
+    initial.call.as_ref().expect("initial call").abort();
+    let result = tokio::time::timeout(
+        Duration::from_secs(10),
+        initial.call.as_mut().expect("initial call"),
+    )
+    .await?;
+    initial.call.take();
+    assert!(result.expect_err("actual call aborted").is_cancelled());
+    assert!(
+        !initial
+            .process
+            .as_ref()
+            .expect("stored process")
+            .has_exited()
+    );
+    let result = poll_retained_closed(&initial.context, initial.process_id, &active).await;
+    initial.cleanup().await;
+    result
+}
+
+#[tokio::test]
+async fn actual_initial_process_failure_closes_flag_on_error() -> anyhow::Result<()> {
+    skip_if_sandbox!(Ok(()));
+    let (mut initial, active) = start_initial_call().await?;
+    initial
+        .process
+        .as_ref()
+        .expect("stored process")
+        .fail_and_terminate("initial lifetime fixture failure".into());
+    let result = initial.finish().await?;
+    assert!(result.is_err());
+    assert!(!active.load(Ordering::Acquire));
+    initial.cleanup().await;
+    Ok(())
+}
