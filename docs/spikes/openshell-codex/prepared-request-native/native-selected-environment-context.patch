+use super::*;
+use crate::StartThreadOptions;
+use crate::ThreadManager;
+use crate::config::{ConfigBuilder, ConfigOverrides};
+use codex_exec_server::EnvironmentManager;
+use codex_login::CodexAuth;
+use pretty_assertions::assert_eq;
+use std::sync::Arc;
+
+async fn fixture() -> (tempfile::TempDir, Config, ThreadManager) {
+    let home = tempfile::tempdir().unwrap();
+    let config = ConfigBuilder::default()
+        .codex_home(home.path().to_path_buf())
+        .loader_overrides(
+            codex_config::LoaderOverrides::with_managed_config_path_for_tests(
+                home.path().join("managed.toml"),
+            ),
+        )
+        .harness_overrides(ConfigOverrides {
+            cwd: Some(home.path().to_path_buf()),
+            ..Default::default()
+        })
+        .build()
+        .await
+        .unwrap();
+    let manager = ThreadManager::with_models_provider_and_home_for_tests(
+        CodexAuth::from_api_key("synthetic-environment-source"),
+        config.model_provider.clone(),
+        home.path().to_path_buf(),
+        Arc::new(EnvironmentManager::default_for_tests()),
+    );
+    (home, config, manager)
+}
+
+#[tokio::test]
+async fn retained_original_local_owner_projects_exact_selection_permissions_and_shell_without_startup()
+ {
+    let (_home, config, manager) = fixture().await;
+    let mut selected = manager
+        .prepare_selected_start(StartThreadOptions::new(config.clone()))
+        .await
+        .unwrap();
+    manager
+        .capture_selected_start_api_mcp(
+            &mut selected,
+            manager
+                .auth_manager()
+                .capture_cached_api_key_credentials()
+                .unwrap(),
+        )
+        .unwrap();
+    let sources = selected.mcp_sources().unwrap();
+    let projected = SelectedStartEnvironmentContext::observe(sources).unwrap();
+    let selections = sources.start_options().environments.as_ref().unwrap();
+    assert_eq!(
+        projected
+            .entries
+            .iter()
+            .map(|entry| entry.selection.clone())
+            .collect::<Vec<_>>(),
+        *selections
+    );
+    assert_eq!(
+        projected.permission_profile(&config),
+        config
+            .permissions
+            .permission_profile()
+            .clone()
+            .materialize_project_roots_with_path_uris(&selections[0].workspace_roots)
+    );
+    assert_eq!(
+        projected.shell,
+        crate::shell::select_start_shell(&config, /*user_shell_override*/ None).unwrap()
+    );
+    projected.renew_local_sources().unwrap();
+    assert!(manager.list_thread_ids().await.is_empty());
+}
+
+#[tokio::test]
+async fn selected_owner_ready_configuration_is_not_silently_reinterpreted_as_thread_defaults() {
+    let (_home, config, manager) = fixture().await;
+    let mut options = StartThreadOptions::new(config);
+    // An actual ordinary fixture supplies the real owner-ready config. It is
+    // not a fabricated readiness marker and is never overwritten by capture.
+    let (_session, turn) = crate::session::tests::make_session_and_context().await;
+    let ready = turn
+        .initial_environments
+        .primary()
+        .unwrap()
+        .config()
+        .clone();
+    let mut selections = manager
+        .default_environment_selections(&options.config.cwd, &options.config.workspace_roots);
+    selections[0].config = EnvironmentConfigState::Ready(ready);
+    options.environments = Some(selections);
+    let mut selected = manager.prepare_selected_start(options).await.unwrap();
+    manager
+        .capture_selected_start_api_mcp(
+            &mut selected,
+            manager
+                .auth_manager()
+                .capture_cached_api_key_credentials()
+                .unwrap(),
+        )
+        .unwrap();
+    assert_eq!(
+        SelectedStartEnvironmentContext::observe(selected.mcp_sources().unwrap()).err(),
+        Some(InitialEnvironmentContextRefusal::OwnerConfiguration)
+    );
+    assert!(manager.list_thread_ids().await.is_empty());
+}
