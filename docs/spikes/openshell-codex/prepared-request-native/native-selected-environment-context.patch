diff --git a/codex-rs/core/src/shell.rs b/codex-rs/core/src/shell.rs
index 37a35bfe3f44c71c1829d03918185043880655af..7bdc711bd7ddf32b5d9b74611474ca9acf669338 100644
--- a/codex-rs/core/src/shell.rs
+++ b/codex-rs/core/src/shell.rs
@@ -102,3 +102,40 @@ fn default_user_shell_from_path(user_shell_path: Option<PathBuf>) -> Shell {
 #[cfg(unix)]
 #[path = "shell_tests.rs"]
 mod tests;
+
+/// Original ordinary shell selection. Reads local account/PATH/filesystem
+/// metadata; never starts an executor, shell process or snapshot task. Retained
+/// callers must renew the result; this is not an external metadata lease.
+pub(crate) fn select_start_shell(
+    config: &crate::config::Config,
+    user_shell_override: Option<&Shell>,
+) -> anyhow::Result<Shell> {
+    let use_zsh_fork_shell = config
+        .features
+        .enabled(codex_features::Feature::ShellZshFork);
+    let default_shell = if let Some(user_shell_override) = user_shell_override.cloned() {
+        user_shell_override
+    } else if use_zsh_fork_shell {
+        let zsh_path = config.zsh_path.as_ref().ok_or_else(|| {
+            anyhow::anyhow!(
+                "zsh fork feature enabled, but no packaged zsh fork is available for this install"
+            )
+        })?;
+        if zsh_path.is_file() {
+            Shell {
+                shell_type: ShellType::Zsh,
+                shell_path: zsh_path.clone(),
+            }
+        } else {
+            get_shell(ShellType::Zsh).ok_or_else(|| {
+                anyhow::anyhow!(
+                    "zsh fork feature enabled, but packaged zsh fork `{}` is not usable",
+                    zsh_path.display()
+                )
+            })?
+        }
+    } else {
+        default_user_shell()
+    };
+    Ok(default_shell)
+}
