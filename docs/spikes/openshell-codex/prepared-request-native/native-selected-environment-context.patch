+//! Initial environment display/permission DATA from retained original handles.
+//! Does not create TurnEnvironmentSnapshot/TurnContext, connect, publish config,
+//! install a shell snapshot or execute a shell/version probe. Remote/owner-ready
+//! configurations require their own exact ordinary validation/currency contract.
+use crate::PreSessionMcpSources;
+use crate::config::Config;
+use crate::shell::Shell;
+use crate::shell::ShellType;
+use codex_features::Feature;
+use codex_protocol::models::PermissionProfile;
+use codex_protocol::protocol::EnvironmentConfigState;
+use codex_protocol::protocol::TurnEnvironmentSelection;
+use codex_utils_absolute_path::AbsolutePathBuf;
+
+#[derive(Debug, thiserror::Error, PartialEq, Eq)]
+pub(crate) enum InitialEnvironmentContextRefusal {
+    #[error("original start shell source is unavailable")]
+    ShellSource,
+    #[error("original PowerShell version probe is unresolved")]
+    ShellVersionProbe,
+    #[error("ordinary selected environments are unresolved or changed")]
+    Selection,
+    #[error("initial context requires retained ready local environments")]
+    RemoteOrChangedHandle,
+    #[error("owner-provided environment context requires its original currency source")]
+    OwnerConfiguration,
+    #[error("selected initial environment sources changed")]
+    Changed,
+}
+
+#[derive(Clone)]
+pub(crate) struct InitialEnvironmentEntry {
+    pub(crate) selection: TurnEnvironmentSelection,
+    pub(crate) profile: PermissionProfile,
+}
+/// Only this original source module constructs these selected values.
+pub(crate) struct SelectedStartEnvironmentContext<'a> {
+    sources: &'a PreSessionMcpSources,
+    entries: Vec<InitialEnvironmentEntry>,
+    shell: Shell,
+}
+impl<'a> SelectedStartEnvironmentContext<'a> {
+    pub(crate) fn sources(&self) -> &PreSessionMcpSources {
+        self.sources
+    }
+    pub(crate) fn entries(&self) -> &[InitialEnvironmentEntry] {
+        &self.entries
+    }
+    pub(crate) fn shell(&self) -> &Shell {
+        &self.shell
+    }
+
+    pub(crate) fn observe(
+        sources: &'a PreSessionMcpSources,
+    ) -> Result<Self, InitialEnvironmentContextRefusal> {
+        let config = &sources.start_options().config;
+        let shell = crate::shell::select_start_shell(config, /*user_shell_override*/ None)
+            .map_err(|_| InitialEnvironmentContextRefusal::ShellSource)?;
+        if config.features.enabled(Feature::PowerShellShellVersion)
+            && shell.shell_type == ShellType::PowerShell
+        {
+            return Err(InitialEnvironmentContextRefusal::ShellVersionProbe);
+        }
+        let selections = sources
+            .start_options()
+            .environments
+            .as_ref()
+            .ok_or_else(|| InitialEnvironmentContextRefusal::Selection)?;
+        let handles = sources.captured_environment_handles();
+        if selections.len() != handles.len() {
+            return Err(InitialEnvironmentContextRefusal::Selection);
+        }
+        let mut entries = Vec::with_capacity(selections.len());
+        for (selection, (id, handle)) in selections.iter().zip(handles) {
+            if id != &selection.environment_id || handle.is_remote() {
+                return Err(InitialEnvironmentContextRefusal::RemoteOrChangedHandle);
+            }
+            // Original local wait_until_ready/readiness_result are unconditional
+            // ready (exec-server/environment.rs); no transport/probe is invoked.
+            // Only actual FromThread defaults are projected. Owner-ready, pending
+            // and failed inputs are not reinterpreted or overwritten.
+            if !matches!(&selection.config, EnvironmentConfigState::FromThread) {
+                return Err(InitialEnvironmentContextRefusal::OwnerConfiguration);
+            }
+            entries.push(InitialEnvironmentEntry {
+                selection: selection.clone(),
+                profile: config.permissions.permission_profile().clone(),
+            });
+        }
+        Ok(Self {
+            sources,
+            entries,
+            shell,
+        })
+    }
+    pub(crate) fn renew_local_sources(&self) -> Result<(), InitialEnvironmentContextRefusal> {
+        let current = Self::observe(self.sources)?;
+        if current.shell != self.shell
+            || current.entries.len() != self.entries.len()
+            || current
+                .entries
+                .iter()
+                .zip(&self.entries)
+                .any(|(a, b)| a.selection != b.selection || a.profile != b.profile)
+        {
+            return Err(InitialEnvironmentContextRefusal::Changed);
+        }
+        Ok(())
+    }
+    pub(crate) fn permission_profile(&self, config: &Config) -> PermissionProfile {
+        match self.entries.first() {
+            Some(entry) => entry
+                .profile
+                .clone()
+                .materialize_project_roots_with_path_uris(&entry.selection.workspace_roots),
+            None => config
+                .permissions
+                .permission_profile()
+                .clone()
+                .materialize_project_roots_with_path_uris(&[]),
+        }
+    }
+    pub(crate) fn permission_cwd(&self, config: &Config) -> AbsolutePathBuf {
+        self.entries
+            .first()
+            .and_then(|entry| entry.selection.cwd.to_abs_path().ok())
+            .unwrap_or_else(|| config.cwd.clone())
+    }
+}
