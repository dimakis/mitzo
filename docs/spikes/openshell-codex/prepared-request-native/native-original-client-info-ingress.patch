+#[tokio::test]
+async fn initiating_client_info_moves_with_original_options_reservation_and_installed_owner() {
+    for (name, version) in [
+        (None, None),
+        (Some(""), Some("")),
+        (Some("Xcode"), Some("26.4.1")),
+    ] {
+        let home = tempfile::tempdir().unwrap();
+        let configs = manager(home.path());
+        let source = configs
+            .load_selected_start_config(
+                /*request*/ None,
+                ConfigOverrides {
+                    cwd: Some(home.path().to_path_buf()),
+                    ..Default::default()
+                },
+            )
+            .await
+            .unwrap();
+        let config = source.config().clone();
+        let store = Arc::new(InMemoryThreadStore::default());
+        let (threads, installed, _auth) = thread_manager(&config, Arc::clone(&store));
+        let reservation = threads.reserve_thread_start();
+        let native_id = reservation.thread_id();
+        let info = crate::request_processors::AppServerClientInfo::capture(
+            name.map(str::to_owned),
+            version.map(str::to_owned),
+        );
+        let buffers = info.buffers_for_test();
+        let mut options = StartThreadOptions::new(config.clone());
+        options.metrics_service_name = Some("client-info-fixture".to_owned());
+        let service_buffer = options.metrics_service_name.as_ref().unwrap().as_ptr();
+        let command =
+            OriginalFirstCommandStart::new(options, reservation, Arc::clone(&installed), info);
+        let (options, reservation, actual_installed, info) = command.into_parts();
+        assert_eq!(reservation.thread_id(), native_id);
+        assert_eq!(options.config, config);
+        assert_eq!(
+            options.metrics_service_name.as_deref(),
+            Some("client-info-fixture")
+        );
+        assert_eq!(
+            options.metrics_service_name.as_ref().unwrap().as_ptr(),
+            service_buffer
+        );
+        assert!(Arc::ptr_eq(&actual_installed, &installed));
+        assert_eq!(info.buffers_for_test(), buffers);
+        let selected = source
+            .capture_first_command(
+                &threads,
+                OriginalFirstCommandStart::new(options, reservation, actual_installed, info),
+            )
+            .await
+            .unwrap();
+        assert_eq!(selected.start.start_options().unwrap().config, config);
+        let retained_options = selected.start.start_options().unwrap();
+        assert_eq!(
+            retained_options.metrics_service_name.as_deref(),
+            Some("client-info-fixture")
+        );
+        assert_eq!(
+            retained_options
+                .metrics_service_name
+                .as_ref()
+                .unwrap()
+                .as_ptr(),
+            service_buffer
+        );
+        assert!(Arc::ptr_eq(
+            selected.installed.as_ref().unwrap(),
+            &installed
+        ));
+        let retained = selected.client_info.as_ref().unwrap();
+        assert_eq!(retained.raw_for_test(), (name, version));
+        assert_eq!(retained.buffers_for_test(), buffers);
+        assert!(threads.list_thread_ids().await.is_empty());
+        assert_eq!(
+            store.calls().await,
+            codex_thread_store::InMemoryThreadStoreCalls::default()
+        );
+    }
+}
