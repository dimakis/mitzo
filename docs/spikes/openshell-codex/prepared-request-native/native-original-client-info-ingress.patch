@@ -0,0 +1,73 @@
+use super::*;
+use pretty_assertions::assert_eq;
+
+// Test-only access remains in the dedicated test module.
+impl AppServerClientInfo {
+    pub(crate) fn raw_for_test(&self) -> (Option<&str>, Option<&str>) {
+        (self.name.as_deref(), self.version.as_deref())
+    }
+    pub(crate) fn buffers_for_test(&self) -> (Option<*const u8>, Option<*const u8>) {
+        (
+            self.name.as_ref().map(|value| value.as_ptr()),
+            self.version.as_ref().map(|value| value.as_ptr()),
+        )
+    }
+}
+
+#[test]
+fn raw_metadata_preserves_absence_empty_content_and_owned_buffers_until_resolution() {
+    for (name, version) in [
+        (None, None),
+        (Some(""), Some("")),
+        (Some("Xcode"), None),
+        (None, Some("26.4")),
+        (Some(" Xcode\n"), Some("26.4 beta\n")),
+    ] {
+        let name = name.map(str::to_owned);
+        let version = version.map(str::to_owned);
+        let buffers = (
+            name.as_ref().map(|value| value.as_ptr()),
+            version.as_ref().map(|value| value.as_ptr()),
+        );
+        let expected = (name.clone(), version.clone());
+        let data = AppServerClientInfo::capture(name, version);
+        assert_eq!(data.buffers_for_test(), buffers);
+        assert_eq!(
+            data.raw_for_test(),
+            (expected.0.as_deref(), expected.1.as_deref())
+        );
+        let (name, version, _) = data.resolve();
+        assert_eq!((name, version), expected);
+    }
+}
+
+#[test]
+fn original_xcode_prefix_and_case_boundaries_are_resolved_without_normalization() {
+    for (name, version, expected) in [
+        (None, None, false),
+        (Some("Xcode"), None, false),
+        (None, Some("26.4"), false),
+        (Some("Xcode"), Some(""), false),
+        (Some("Xcode"), Some("26.3.9"), false),
+        (Some("Xcode"), Some("26.4"), true),
+        (Some("Xcode"), Some("26.4.0"), true),
+        (Some("Xcode"), Some("26.40"), true),
+        (Some("Xcode"), Some("26.4 beta"), true),
+        (Some("Xcode"), Some("26.5"), false),
+        (Some("xcode"), Some("26.4"), false),
+        (Some(" Xcode"), Some("26.4"), false),
+        (Some("Xcode"), Some(" 26.4"), false),
+        (Some(""), Some("26.4"), false),
+    ] {
+        let data =
+            AppServerClientInfo::capture(name.map(str::to_owned), version.map(str::to_owned));
+        assert_eq!(
+            data.resolve(),
+            (
+                name.map(str::to_owned),
+                version.map(str::to_owned),
+                expected
+            )
+        );
+    }
+}
