+    #[test]
+    fn selected_attachment_network_is_an_independent_parent_approval_fence() -> anyhow::Result<()> {
+        use codex_protocol::permissions::FileSystemAccessMode;
+        use codex_protocol::permissions::FileSystemPath;
+        use codex_protocol::permissions::FileSystemSandboxEntry;
+        use codex_protocol::permissions::FileSystemSandboxPolicy;
+        use codex_protocol::permissions::NetworkSandboxPolicy;
+
+        let denied = FileSystemSandboxPolicy::restricted(vec![FileSystemSandboxEntry {
+            path: FileSystemPath::GlobPattern {
+                pattern: "**/selected-secret.env".into(),
+            },
+            access: FileSystemAccessMode::Deny,
+            missing_path_behavior: None,
+        }]);
+        let restricted =
+            PermissionProfile::from_runtime_permissions(&denied, NetworkSandboxPolicy::Restricted);
+        let enabled =
+            PermissionProfile::from_runtime_permissions(&denied, NetworkSandboxPolicy::Enabled);
+        let cwd = AbsolutePathBuf::try_from(std::env::current_dir()?)?;
+        let mut environment = test_turn_environment(cwd.into());
+        environment.config_mut().permission_profile =
+            PermissionProfileSnapshot::legacy(restricted.clone());
+        assert!(restricted_parent_approval_permissions(
+            SandboxPermissions::RequireEscalated,
+            environment.permission_profile(),
+            &restricted,
+            &restricted,
+            &restricted
+        ));
+        environment.config_mut().permission_profile = PermissionProfileSnapshot::legacy(enabled);
+        assert!(!restricted_parent_approval_permissions(
+            SandboxPermissions::RequireEscalated,
+            environment.permission_profile(),
+            &restricted,
+            &restricted,
+            &restricted
+        ));
+        Ok(())
+    }
