+
+fn assert_tools_retained(tools: Value) {
+    let mut request = body();
+    request["tools"] = tools.clone();
+    let encoded = serde_json::to_vec(&request).unwrap();
+    let frozen = FrozenResponsesRequest::new(request.clone(), 16).unwrap();
+    assert_eq!(frozen.body(), &request);
+    assert_eq!(frozen.encoded_body(), encoded);
+    assert_eq!(frozen.count_body()["tools"], tools);
+    let restored = FrozenResponsesRequest::from_encoded(&encoded, 16).unwrap();
+    assert_eq!(restored.encoded_body(), encoded);
+    assert_eq!(restored.count_body(), frozen.count_body());
+}
+
+#[test]
+fn frozen_accepts_deferred_function_tools_without_projection_loss() {
+    for deferred in [false, true] {
+        assert_tools_retained(json!([{
+            "type":"function", "name":"retained_function", "description":"Retained description.",
+            "defer_loading":deferred, "strict":true,
+            "parameters":{
+                "type":"object", "properties":{"value":{"$ref":"#/$defs/value"}},
+                "$defs":{"value":{"type":"string", "enum":["second", "first"]}},
+                "required":["value"], "additionalProperties":false,
+                "x-application-schema-label":"retained schema extension"
+            }
+        }]));
+    }
+}
+
+#[test]
+fn frozen_accepts_custom_tool_formats_without_projection_loss() {
+    for format in [
+        None,
+        Some(json!({"type":"text"})),
+        Some(json!({"type":"grammar", "syntax":"lark", "definition":"start: \"retained\"\n"})),
+        Some(json!({"type":"grammar", "syntax":"regex", "definition":"^(second|first)\\n$"})),
+    ] {
+        for deferred in [None, Some(false), Some(true)] {
+            let mut tool = json!({"type":"custom", "name":"retained_custom"});
+            if let Some(format) = &format {
+                tool["format"] = format.clone();
+            }
+            if let Some(deferred) = deferred {
+                tool["defer_loading"] = deferred.into();
+            }
+            assert_tools_retained(json!([tool]));
+        }
+    }
+}
+
+#[test]
+fn frozen_accepts_namespace_tools_without_reordering_or_flattening() {
+    assert_tools_retained(json!([
+        {"type":"function", "name":"same_name", "parameters":{}},
+        {"type":"namespace", "name":"retained_namespace", "description":"", "tools":[
+            {"type":"custom", "name":"same_name", "description":"Custom first.", "defer_loading":true,
+                "format":{"type":"grammar", "syntax":"regex", "definition":"^retained$"}},
+            {"type":"function", "name":"second", "defer_loading":false, "strict":false,
+                "parameters":{"type":"object", "properties":{}, "required":[]}},
+            {"type":"custom", "name":"third", "format":{"type":"text"}}
+        ]},
+        {"type":"namespace", "name":"empty_namespace", "description":"Retained empty list.", "tools":[]}
+    ]));
+}
+
+#[test]
+fn frozen_refuses_invalid_or_unqualified_tool_branches_without_repair() {
+    for tool in [
+        json!(null),
+        json!({"name":"missing_type"}),
+        json!({"type":"function", "name":"f", "defer_loading":null}),
+        json!({"type":"function", "name":"f", "defer_loading":"true"}),
+        json!({"type":"function", "name":"f", "parameters":[]}),
+        json!({"type":"function", "name":"f", "strict":null}),
+        json!({"type":"custom", "name":"c", "description":false}),
+        json!({"type":"custom", "name":"c", "defer_loading":1}),
+        json!({"type":"custom", "name":"c", "parameters":{}}),
+        json!({"type":"custom", "name":"c", "strict":true}),
+        json!({"type":"custom", "name":"c", "format":null}),
+        json!({"type":"custom", "name":"c", "format":{"type":"text", "syntax":"regex", "definition":".*"}}),
+        json!({"type":"custom", "name":"c", "format":{"type":"grammar", "syntax":"lark"}}),
+        json!({"type":"custom", "name":"c", "format":{"type":"grammar", "definition":".*"}}),
+        json!({"type":"custom", "name":"c", "format":{"type":"grammar", "syntax":"unknown", "definition":".*"}}),
+        json!({"type":"custom", "name":"c", "format":{"type":"grammar", "syntax":"regex", "definition":12}}),
+        json!({"type":"custom", "name":"c", "format":{"type":"unknown"}}),
+        json!({"type":"namespace", "name":"n", "tools":[]}),
+        json!({"type":"namespace", "name":"n", "description":null, "tools":[]}),
+        json!({"type":"namespace", "name":"n", "description":"n", "tools":{}}),
+        json!({"type":"namespace", "name":"n", "description":"n", "tools":[], "defer_loading":true}),
+        json!({"type":"namespace", "name":"n", "description":"n", "tools":[
+            {"type":"namespace", "name":"nested", "description":"nested", "tools":[]}
+        ]}),
+        json!({"type":"namespace", "name":"n", "description":"n", "tools":[{"type":"tool_search"}]}),
+        // Public features outside this actual ordinary-serializer subset still refuse.
+        json!({"type":"function", "name":"f", "allowed_callers":["programmatic"]}),
+        json!({"type":"function", "name":"f", "async":true}),
+        json!({"type":"function", "name":"f", "output_schema":{}}),
+        json!({"type":"function", "name":"f", "future_control":true}),
+        json!({"type":"mcp", "server_url":"https://example.com"}),
+    ] {
+        let mut request = body();
+        request["tools"] = json!([tool]);
+        let original = request.clone();
+        let encoded = serde_json::to_vec(&request).unwrap();
+        assert!(
+            FrozenResponsesRequest::new(request.clone(), 16).is_err(),
+            "{tool}"
+        );
+        assert!(
+            FrozenResponsesRequest::from_encoded(&encoded, 16).is_err(),
+            "{tool}"
+        );
+        assert_eq!(request, original);
+    }
+}
+
+#[test]
+fn frozen_tool_names_keep_the_explicit_conservative_identifier_subset() {
+    // This is the retained implementation subset, not a public API name ceiling.
+    for name in ["".to_string(), "contains.dot".to_string(), "x".repeat(65)] {
+        for tool in [
+            json!({"type":"function", "name":name}),
+            json!({"type":"custom", "name":name}),
+            json!({"type":"namespace", "name":name, "description":"", "tools":[]}),
+        ] {
+            let mut request = body();
+            request["tools"] = json!([tool]);
+            assert!(FrozenResponsesRequest::new(request, 16).is_err());
+        }
+    }
+}
