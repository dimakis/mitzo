--- a/codex-rs/codex-api/src/requests/frozen_responses.rs
+++ b/codex-rs/codex-api/src/requests/frozen_responses.rs
@@ -399,18 +399,81 @@ fn validate_controls(fields: &Map<String, Value>) -> Result<(), ApiError> {
     }
     if let Some(tools) = fields.get("tools") {
         for tool in tools.as_array().ok_or_else(unsupported)? {
-            let tool = object(
+            validate_tool(tool, true)?;
