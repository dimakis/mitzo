+}
+
+// Public create/count tool shapes used by the ordinary tool serializers. This
+// qualified subset retains the conservative identifier restriction in name();
+// it does not claim that restriction is a public API ceiling. Other documented
+// tool fields still refuse here. Shape validation does not establish selected
+// model/tool authority or inventory completeness, and never rewrites values.
+fn validate_tool(tool: &Value, allow_namespace: bool) -> Result<(), ApiError> {
+    match tool.get("type").and_then(Value::as_str) {
+        Some("function") => {
+            let fields = object(
+                tool,
+                &[
+                    "type",
+                    "name",
+                    "description",
+                    "parameters",
+                    "strict",
+                    "defer_loading",
+                ],
+            )?;
+            strings(fields, &["description"])?;
+            ensure(
+                name(fields.get("name"))
+                    && fields.get("parameters").is_none_or(Value::is_object)
+                    && fields.get("strict").is_none_or(Value::is_boolean)
+                    && fields.get("defer_loading").is_none_or(Value::is_boolean),
+            )?;
+        }
+        Some("custom") => {
+            let fields = object(
                 tool,
-                &["type", "name", "description", "parameters", "strict"],
+                &["type", "name", "description", "defer_loading", "format"],
             )?;
-            strings(tool, &["description"])?;
+            strings(fields, &["description"])?;
             ensure(
-                tool.get("type").and_then(Value::as_str) == Some("function")
-                    && name(tool.get("name"))
-                    && tool.get("parameters").is_none_or(Value::is_object)
-                    && tool.get("strict").is_none_or(Value::is_boolean),
+                name(fields.get("name"))
+                    && fields.get("defer_loading").is_none_or(Value::is_boolean),
             )?;
+            if let Some(format) = fields.get("format") {
+                match format.get("type").and_then(Value::as_str) {
+                    Some("text") => {
+                        object(format, &["type"])?;
+                    }
+                    Some("grammar") => {
+                        let format = object(format, &["type", "syntax", "definition"])?;
+                        ensure(
+                            matches!(
+                                format.get("syntax").and_then(Value::as_str),
+                                Some("lark" | "regex")
+                            ) && format.get("definition").is_some_and(Value::is_string),
+                        )?;
+                    }
+                    _ => return Err(unsupported()),
+                }
+            }
+        }
+        Some("namespace") if allow_namespace => {
+            let fields = object(tool, &["type", "name", "description", "tools"])?;
+            ensure(
+                name(fields.get("name")) && fields.get("description").is_some_and(Value::is_string),
+            )?;
+            for child in fields
+                .get("tools")
+                .and_then(Value::as_array)
+                .ok_or_else(unsupported)?
+            {
+                validate_tool(child, false)?;
+            }
         }
+        _ => return Err(unsupported()),
     }
     Ok(())
 }
