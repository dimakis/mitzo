+#[tokio::test]
+async fn capture_retains_ordinary_serialized_tool_shapes_through_recorded_count() {
+    use codex_api::AuthProvider;
+    use codex_api::Provider;
+    use codex_api::ResponsesClient;
+    use codex_api::RetryConfig;
+    use codex_client::HttpTransport;
+    use codex_client::Request;
+    use codex_client::Response;
+    use codex_client::StreamResponse;
+    use codex_client::TransportError;
+    use codex_tools::FreeformTool;
+    use codex_tools::FreeformToolFormat;
+    use codex_tools::ResponsesApiNamespace;
+    use codex_tools::ResponsesApiNamespaceTool;
+    use std::sync::Arc;
+    use std::sync::Mutex;
+    use std::time::Duration;
+
+    #[derive(Clone, Default)]
+    struct RecordingCountTransport(Arc<Mutex<Vec<Request>>>);
+
+    impl HttpTransport for RecordingCountTransport {
+        async fn execute(
+            &self,
+            _request: Request,
+        ) -> std::result::Result<Response, TransportError> {
+            panic!("ordinary HTTP execution must not run");
+        }
+
+        async fn stream(
+            &self,
+            _request: Request,
+        ) -> std::result::Result<StreamResponse, TransportError> {
+            panic!("model generation must not run");
+        }
+
+        async fn execute_once(
+            &self,
+            request: Request,
+        ) -> std::result::Result<Response, TransportError> {
+            self.0.lock().unwrap().push(request);
+            Ok(Response {
+                status: http::StatusCode::OK,
+                headers: http::HeaderMap::new(),
+                body: serde_json::to_vec(&json!({
+                    "object":"response.input_tokens", "input_tokens":23
+                }))
+                .unwrap()
+                .into(),
+            })
+        }
+    }
+
+    struct FixtureAuth;
+    impl AuthProvider for FixtureAuth {
+        fn add_auth_headers(&self, headers: &mut http::HeaderMap) {
+            headers.insert(
+                "authorization",
+                http::HeaderValue::from_static("Bearer fixture"),
+            );
+        }
+    }
+
+    let mut prompt = prompt();
+    let ToolSpec::Function(mut function) = prompt.tools[0].clone() else {
+        panic!("expected the ordinary function fixture");
+    };
+    function.defer_loading = Some(true);
+    let custom = FreeformTool {
+        name: "apply_patch".into(),
+        description: "Retained ordinary grammar.".into(),
+        defer_loading: Some(false),
+        format: FreeformToolFormat {
+            r#type: "grammar".into(),
+            syntax: "lark".into(),
+            definition: "start: \"retained patch\"\n".into(),
+        },
+    };
+    prompt.tools = vec![
+        ToolSpec::Function(function.clone()),
+        ToolSpec::Freeform(custom.clone()),
+        ToolSpec::Namespace(ResponsesApiNamespace {
+            name: "ordinary_namespace".into(),
+            description: "Retained ordinary namespace.".into(),
+            tools: vec![
+                ResponsesApiNamespaceTool::Custom(custom),
+                ResponsesApiNamespaceTool::Function(function),
+            ],
+        }),
+    ]
+    .into();
+    let expected_tools =
+        json!(codex_tools::create_tools_json_for_responses_api(&prompt.tools).unwrap());
+    let raw = codex_tools::create_tools_raw_json_for_responses_api(&prompt.tools).unwrap();
+    assert_eq!(
+        serde_json::from_str::<serde_json::Value>(raw.get()).unwrap(),
+        expected_tools
+    );
+
+    // This is deliberately a lower-level public-body fixture with empty native
+    // metadata. Real ordinary metadata/source capture and authority remain unavailable.
+    let request =
+        format_responses_request(&prompt, &model(), &public_context(), options()).unwrap();
+    let retained = serde_json::to_value(&request).unwrap();
+    assert_eq!(retained["tools"], expected_tools);
+    let frozen = capture_finalized_responses_request(request, &[], capture_budget()).unwrap();
+    assert_eq!(frozen.body()["tools"], expected_tools);
+    assert_eq!(frozen.body()["input"], retained["input"]);
+    assert_eq!(frozen.body()["text"], retained["text"]);
+    assert_eq!(frozen.body()["reasoning"], retained["reasoning"]);
+    assert_eq!(frozen.max_output_tokens(), 64);
+    assert_eq!(frozen.count_body()["tools"], expected_tools);
+    let restored = FrozenResponsesRequest::from_encoded(frozen.encoded_body(), 128).unwrap();
+    assert_eq!(restored.encoded_body(), frozen.encoded_body());
+
+    let transport = RecordingCountTransport::default();
+    let client = ResponsesClient::new(
+        transport.clone(),
+        Provider {
+            name: "fixture".into(),
+            base_url: "https://api.openai.com/v1".into(),
+            query_params: None,
+            headers: http::HeaderMap::new(),
+            retry: RetryConfig {
+                max_attempts: 3,
+                base_delay: Duration::ZERO,
+                retry_429: true,
+                retry_5xx: true,
+                retry_transport: true,
+            },
+            stream_idle_timeout: Duration::from_secs(1),
+        },
+        Arc::new(FixtureAuth),
+    );
+    assert_eq!(client.count_input_tokens(&frozen).await.unwrap(), 23);
+    let recorded = transport.0.lock().unwrap();
+    assert_eq!(recorded.len(), 1);
+    assert_eq!(
+        recorded[0].url,
+        "https://api.openai.com/v1/responses/input_tokens"
+    );
+    let encoded_count = recorded[0].prepare_body_for_send().unwrap().body_bytes();
+    let count: serde_json::Value = serde_json::from_slice(&encoded_count).unwrap();
+    assert_eq!(&count, frozen.count_body());
+    assert_eq!(count["tools"], expected_tools);
+    assert_eq!(
+        serde_json::to_vec(&count["tools"]).unwrap(),
+        serde_json::to_vec(&frozen.body()["tools"]).unwrap()
+    );
+}
