+/// A selected-owner observation, not connection liveness or permission to execute.
+pub(crate) struct SelectedEnvironmentObservation {
+    owner: std::sync::Weak<ThreadEnvironments>,
+    entries: Vec<SelectedEnvironmentEntryObservation>,
+    snapshot: TurnEnvironmentSnapshot,
+}
+
+struct SelectedEnvironmentEntryObservation {
+    selection: TurnEnvironmentSelection,
+    config_origin: EnvironmentConfigOrigin,
+    environment: Arc<Environment>,
+    resolution: TurnEnvironmentResolution,
+    cached: CachedEnvironmentResolution,
+}
+
+enum CachedEnvironmentResolution {
+    Starting,
+    Ready(Arc<Environment>),
+    Failed(Arc<ExecServerError>),
+}
+
+impl SelectedEnvironmentObservation {
+    pub(crate) fn snapshot(&self) -> &TurnEnvironmentSnapshot {
+        &self.snapshot
+    }
+}
+
 impl ThreadEnvironments {
+    /// Copies raw bindings and already cached startup results without polling startup work.
+    pub(crate) fn observe_selected(self: &Arc<Self>) -> SelectedEnvironmentObservation {
+        let state = self.state.lock().unwrap_or_else(PoisonError::into_inner);
+        let mut entries = Vec::with_capacity(state.environments.len());
+        let mut environments = Vec::with_capacity(state.environments.len());
+        for selected in &state.environments {
+            // Startup can complete independently of the selection mutex. Derive both the
+            // observation and snapshot from this single sample, never a second peek.
+            let resolved = selected.resolution.peek().cloned();
+            let cached = match &resolved {
+                None => CachedEnvironmentResolution::Starting,
+                Some(Ok(resolved)) => {
+                    CachedEnvironmentResolution::Ready(Arc::clone(&resolved.environment))
+                }
+                Some(Err(error)) => CachedEnvironmentResolution::Failed(Arc::clone(error)),
+            };
+            entries.push(SelectedEnvironmentEntryObservation {
+                selection: selected.selection.clone(),
+                config_origin: selected.config_origin,
+                environment: Arc::clone(&selected.environment),
+                resolution: selected.resolution.clone(),
+                cached,
+            });
+            environments.push(TurnEnvironmentState::from_resolution(
+                StartingTurnEnvironment {
+                    selection: selected.selection.clone(),
+                    config_origin: selected.config_origin,
+                    resolution: selected.resolution.clone(),
+                    environment: Arc::clone(&selected.environment),
+                    owner_config_result: selected.owner_config_result.clone(),
+                },
+                resolved,
+            ));
+        }
+        SelectedEnvironmentObservation {
+            owner: Arc::downgrade(self),
+            entries,
+            snapshot: TurnEnvironmentSnapshot { environments },
+        }
+    }
+
+    /// Compares an observation at this owner read; it does not freeze later owner changes.
+    pub(crate) fn selected_observation_is_current(
+        self: &Arc<Self>,
+        observed: &SelectedEnvironmentObservation,
+        environment_id: &str,
+    ) -> bool {
+        if !observed
+            .owner
+            .upgrade()
+            .is_some_and(|owner| Arc::ptr_eq(&owner, self))
+        {
+            return false;
+        }
+        let current = self.observe_selected();
+        let Some(previous_ready) = observed
+            .snapshot
+            .turn_environments()
+            .find(|environment| environment.selection.environment_id == environment_id)
+        else {
+            return false;
+        };
+        let Some(current_ready) = current
+            .snapshot
+            .turn_environments()
+            .find(|environment| environment.selection.environment_id == environment_id)
+        else {
+            return false;
+        };
+        // Compare concrete Ready config, not selection(), which projects Thread config
+        // back to FromThread and would hide changed permissions or network policy.
+        previous_ready.selection == current_ready.selection
+            && Arc::ptr_eq(&previous_ready.environment, &current_ready.environment)
+            && observed.entries.len() == current.entries.len()
+            && observed
+                .entries
+                .iter()
+                .zip(&current.entries)
+                .all(|(previous, current)| {
+                    previous.selection == current.selection
+                        && previous.config_origin == current.config_origin
+                        && Arc::ptr_eq(&previous.environment, &current.environment)
+                        && previous.resolution.ptr_eq(&current.resolution)
+                        && match (&previous.cached, &current.cached) {
+                            (
+                                CachedEnvironmentResolution::Starting,
+                                CachedEnvironmentResolution::Starting,
+                            ) => true,
+                            (
+                                CachedEnvironmentResolution::Ready(previous),
+                                CachedEnvironmentResolution::Ready(current),
+                            ) => Arc::ptr_eq(previous, current),
+                            (
+                                CachedEnvironmentResolution::Failed(previous),
+                                CachedEnvironmentResolution::Failed(current),
+                            ) => Arc::ptr_eq(previous, current),
+                            _ => false,
+                        }
+                })
+    }
+
