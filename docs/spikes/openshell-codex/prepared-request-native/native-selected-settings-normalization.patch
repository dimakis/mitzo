+-> anyhow::Result<()> {
+    let (_home, mut options, auth, models, _endpoint) = super::super::tests::fixture().await?;
+    options.config.features.enable(Feature::GuardianApproval);
+    let startup =
+        OriginalStartupSelection::capture(&options, &SessionSource::Exec, None, &auth, &models)
+            .await?;
+    let candidate = startup.settings_candidate_without_overrides()?;
+    let mut foreign =
+        OriginalStartupSelection::capture(&options, &SessionSource::Exec, None, &auth, &models)
+            .await?;
+    assert!(candidate.validate(&foreign).is_err());
+    options.config = startup.effective_config().clone();
+    options.disabled_plugin_ids = Some(Vec::new());
+    assert!(startup.validate_baseline_options(&options, None).is_err());
+    foreign.stages.baseline.take_environments()?;
+    assert!(foreign.settings_candidate_without_overrides().is_err());
+    Ok(())
+}
