+#[tokio::test]
+async fn selected_candidate_checks_proposed_permissions_before_step_constraints()
+-> anyhow::Result<()> {
+    let (_home, mut options, auth, models, _endpoint) = super::super::tests::fixture().await?;
+    options.config.features.enable(Feature::GuardianApproval);
+    let startup =
+        OriginalStartupSelection::capture(&options, &SessionSource::Exec, None, &auth, &models)
+            .await?;
+    let baseline = startup.settings_candidate_without_overrides()?;
+    assert_eq!(
+        startup
+            .settings_candidate(codex_protocol::protocol::ThreadSettingsOverrides::default())?
+            .data,
+        baseline.data
+    );
+    let updates = codex_protocol::protocol::ThreadSettingsOverrides {
+        sandbox_policy: Some(SandboxPolicy::DangerFullAccess),
+        approvals_reviewer: Some(ApprovalsReviewer::AutoReview),
+        ..Default::default()
+    };
+    let error = startup
+        .settings_candidate(updates)
+        .err()
+        .expect("proposed full access violates original auto-review requirement");
+    assert_eq!(
+        error
+            .get_ref()
+            .and_then(|error| error.downcast_ref::<crate::config::ConstraintError>()),
+        Some(&crate::config::ConstraintError::AutoReviewRequired {
+            model: "gpt-6-luna".to_string()
+        })
+    );
+    assert_eq!(
+        startup.settings_candidate_without_overrides()?.data,
+        baseline.data
+    );
+    Ok(())
+}
