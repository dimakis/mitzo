+            .await?;
+    let mut options = options;
+    options.config = startup.effective_config().clone();
+    let unchanged = startup.settings_candidate_without_overrides()?;
+    let cleared =
+        startup.settings_candidate(codex_protocol::protocol::ThreadSettingsOverrides {
+            service_tier: Some(None),
+            disabled_plugin_ids: Some(Vec::new()),
+            ..Default::default()
+        })?;
+    let mut expected = unchanged.data.clone();
+    let mut step = (*expected.step).clone();
+    step.service_tier =
+        Some(codex_protocol::config_types::SERVICE_TIER_DEFAULT_REQUEST_VALUE.to_string());
+    expected.step = Arc::new(step);
