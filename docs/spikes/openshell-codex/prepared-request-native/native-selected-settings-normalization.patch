+//! Selected settings DATA uses the original retained baseline and original
+//! sparse mapper/update algorithm. No intended command/admission is established.
+use super::super::configured_settings_data::ConfiguredSettingsCandidateData;
+use super::*;
+use codex_protocol::protocol::ThreadSettingsOverrides;
+
+pub(crate) struct SelectedSettingsCandidate {
+    source: Arc<Config>,
+    overrides: ThreadSettingsOverrides,
+    data: ConfiguredSettingsCandidateData,
+}
+impl SelectedSettingsCandidate {
+    pub(crate) fn validate(&self, startup: &OriginalStartupSelection) -> io::Result<()> {
+        if !Arc::ptr_eq(&self.source, &startup.owner.effective) {
+            return Err(io::Error::other(
+                "selected settings effective owner changed",
+            ));
+        }
+        startup.stages.baseline.bind_effective(&self.source)
+    }
+}
+impl OriginalStartupSelection {
+    pub(crate) fn settings_candidate_without_overrides(
+        &self,
+    ) -> io::Result<SelectedSettingsCandidate> {
+        Ok(SelectedSettingsCandidate {
+            source: Arc::clone(&self.owner.effective),
+            overrides: ThreadSettingsOverrides::default(),
+            data: self.stages.baseline.selected_settings_data()?,
+        })
+    }
+    pub(crate) fn settings_candidate(
+        &self,
+        overrides: ThreadSettingsOverrides,
+    ) -> io::Result<SelectedSettingsCandidate> {
+        let current = self.stages.baseline.selected_settings_data()?;
+        let updates = super::super::thread_settings::prepare_update(overrides.clone());
+        super::super::configured_settings_update::check_environment_update(
+            &current.environments,
+            &updates,
+        )
+        .map_err(io::Error::other)?;
+        let mut next = current.clone();
+        super::super::configured_settings_update::apply_fields(
+            current.view(),
+            next.edit(),
+            &updates,
+            &current.environments,
+        )
+        .map_err(io::Error::other)?;
+        Ok(SelectedSettingsCandidate {
+            source: Arc::clone(&self.owner.effective),
+            overrides,
+            data: next,
+        })
+    }
+}
