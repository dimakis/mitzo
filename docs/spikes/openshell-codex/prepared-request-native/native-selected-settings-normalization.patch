+
+fn fixture_thread_manager(
+    config: &Config,
+    store: Arc<InMemoryThreadStore>,
+) -> (
+    Arc<ThreadManager>,
+    Arc<crate::extensions::registry_provenance::InstalledThreadExtensions>,
+    Arc<AuthManager>,
+) {
+    thread_manager_with_models(config, store, |auth| {
+        Arc::new(
+            codex_models_manager::manager::OpenAiModelsManager::new_without_cache(
+                Arc::new(NoStartupEndpoint),
+                Some(Arc::clone(auth)),
+            ),
+        )
+    })
+}
+
+fn thread_manager_with_models(
+    config: &Config,
+    store: Arc<InMemoryThreadStore>,
+    make_models: impl FnOnce(&Arc<AuthManager>) -> codex_models_manager::manager::SharedModelsManager,
+) -> (
+    Arc<ThreadManager>,
+    Arc<crate::extensions::registry_provenance::InstalledThreadExtensions>,
+    Arc<AuthManager>,
+) {
+    let auth = AuthManager::from_auth_for_testing(CodexAuth::from_api_key("synthetic-offline"));
+    let models = make_models(&auth);
+    let environment = Arc::new(EnvironmentManager::default_for_tests());
+    let (outgoing_tx, _outgoing_rx) = tokio::sync::mpsc::channel(4);
+    let outgoing = Arc::new(crate::outgoing_message::OutgoingMessageSender::new(
+        outgoing_tx,
+        codex_analytics::AnalyticsEventsClient::disabled(),
+    ));
+    let thread_states = crate::thread_state::ThreadStateManager::new();
+    let attestation = crate::attestation::app_server_attestation_provider(
+        Arc::clone(&outgoing),
+        thread_states.clone(),
+    );
+    let sink = crate::extensions::app_server_extension_event_sink(outgoing, thread_states);
+    let mut installed = None;
+    let threads = Arc::new_cyclic(|owner| {
+        let composition = crate::extensions::installed_thread_extensions(
+            crate::extensions::ThreadExtensionDependencies {
+                event_sink: Arc::clone(&sink),
+                auth_manager: Arc::clone(&auth),
+                state_db: None,
+                analytics_events_client: codex_analytics::AnalyticsEventsClient::disabled(),
+                thread_manager: owner.clone(),
+                goal_service: Arc::new(codex_goal_extension::GoalService::new()),
+                environment_manager: Arc::clone(&environment),
+                executor_skill_provider: Arc::new(
+                    codex_skills_extension::ExecutorSkillProvider::new_with_restriction_product(
+                        Arc::clone(&environment),
+                        SessionSource::Exec.restriction_product(),
+                    ),
+                ),
+                git_attribution_base_url: config.chatgpt_base_url.clone(),
+                http_client_factory: config.http_client_factory(),
+                queue_service: None,
+                turn_start_admission: Some(Arc::new(
+                    crate::turn_admission::TurnAdmission::default(),
+                )),
+            },
+        );
+        let registry = composition.registry();
+        installed = Some(Arc::new(composition));
+        ThreadManager::new(
+            config,
+            Arc::clone(&auth),
+            Arc::clone(&models),
+            CodexAppsToolsCache::default(),
+            SessionSource::Exec,
+            Arc::clone(&environment),
+            registry,
+            Arc::new(CodexHomeUserInstructionsProvider::new(
+                config.codex_home.clone(),
+            )),
+            /*analytics_events_client*/ None,
+            passthrough_image_store(),
+            store,
+            /*agent_graph_store*/ None,
+            "offline-selected-start".to_string(),
+            Some(Arc::clone(&attestation)),
+            /*external_time_provider*/ None,
+        )
+    });
+    (threads, installed.unwrap(), auth)
+}
