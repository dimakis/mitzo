+++ b/codex-rs/app-server/src/request_processors/turn_settings_data.rs
@@ -0,0 +1,355 @@
+//! Original turn-settings normalization shared by live and retained selected
+//! sources. No command identity, environment lease or admission is inferred.
+use super::*;
+use crate::config_manager::ConfigManager;
+use codex_core::SelectedStartInputs;
+
+pub(crate) enum SettingsSource<'a> {
+    Live(&'a CodexThread),
+    Selected {
+        start: &'a mut SelectedStartInputs,
+        manager: &'a ThreadManager,
+    },
+}
+enum PermissionSourceData {
+    Live(codex_core::ThreadConfigSnapshot),
+    Selected(AbsolutePathBuf),
+}
+impl PermissionSourceData {
+    fn cwd(&self) -> &AbsolutePathBuf {
+        match self {
+            Self::Live(snapshot) => snapshot.cwd(),
+            Self::Selected(cwd) => cwd,
+        }
+    }
+}
+impl SettingsSource<'_> {
+    async fn permission_snapshot(&self) -> PermissionSourceData {
+        match self {
+            Self::Live(thread) => PermissionSourceData::Live(thread.config_snapshot().await),
+            Self::Selected { start, .. } => PermissionSourceData::Selected(
+                start
+                    .start_options()
+                    .expect("selected source checked before normalization")
+                    .config
+                    .cwd
+                    .clone(),
+            ),
+        }
+    }
+    async fn permission_config(&self) -> Arc<Config> {
+        match self {
+            Self::Live(thread) => thread.config().await,
+            Self::Selected { start, .. } => Arc::new(
+                start
+                    .start_options()
+                    .expect("selected source checked before normalization")
+                    .config
+                    .clone(),
+            ),
+        }
+    }
+    async fn environment_snapshot(&self) -> (AbsolutePathBuf, Option<Vec<AbsolutePathBuf>>) {
+        match self {
+            Self::Live(thread) => {
+                let snapshot = thread.thread_settings_snapshot().await;
+                (snapshot.cwd, snapshot.runtime_workspace_roots)
+            }
+            Self::Selected { start, .. } => {
+                let config = &start
+                    .start_options()
+                    .expect("selected source checked before normalization")
+                    .config;
+                (config.cwd.clone(), Some(config.workspace_roots.clone()))
+            }
+        }
+    }
+    async fn preview(
+        &mut self,
+        overrides: codex_protocol::protocol::ThreadSettingsOverrides,
+    ) -> Result<(), String> {
+        match self {
+            Self::Live(thread) => {
+                let codex_protocol::protocol::ThreadSettingsOverrides {
+                    disabled_plugin_ids,
+                    environments,
+                    runtime_workspace_roots,
+                    profile_workspace_roots,
+                    approval_policy,
+                    approvals_reviewer,
+                    sandbox_policy,
+                    permission_profile,
+                    active_permission_profile,
+                    windows_sandbox_level,
+                    model,
+                    effort,
+                    summary,
+                    service_tier,
+                    collaboration_mode,
+                    personality,
+                } = overrides;
+                thread
+                    .preview_thread_settings_overrides(CodexThreadSettingsOverrides {
+                        disabled_plugin_ids,
+                        environments,
+                        runtime_workspace_roots,
+                        profile_workspace_roots,
+                        approval_policy,
+                        approvals_reviewer,
+                        sandbox_policy,
+                        permission_profile,
+                        active_permission_profile,
+                        windows_sandbox_level,
+                        model,
+                        effort,
+                        summary,
+                        service_tier,
+                        collaboration_mode,
+                        personality,
+                    })
+                    .await
+                    .map(|_| ())
+                    .map_err(|error| error.to_string())
+            }
+            Self::Selected { start, manager } => manager
+                .retain_selected_start_settings(start, overrides)
+                .map_err(|error| error.to_string()),
+        }
+    }
+}
+
+#[derive(Default)]
+pub(crate) struct ThreadEnvironmentOverride {
+    pub(crate) environments: Option<TurnEnvironmentSelections>,
+    // Only default-environment updates replace the task's separately persisted root selection.
+    pub(crate) runtime_workspace_roots: Option<Vec<AbsolutePathBuf>>,
+}
+
+pub(crate) struct ThreadSettingsBuildParams {
+    pub(crate) method: &'static str,
+    pub(crate) disabled_plugin_ids: Option<Vec<String>>,
+    pub(crate) environment_override: ThreadEnvironmentOverride,
+    pub(crate) approval_policy: Option<codex_app_server_protocol::AskForApproval>,
+    pub(crate) approvals_reviewer: Option<codex_app_server_protocol::ApprovalsReviewer>,
+    pub(crate) sandbox_policy: Option<codex_app_server_protocol::SandboxPolicy>,
+    pub(crate) permissions: Option<String>,
+    pub(crate) model: Option<String>,
+    pub(crate) service_tier: Option<Option<String>>,
+    pub(crate) effort: Option<ReasoningEffort>,
+    pub(crate) summary: Option<ReasoningSummary>,
+    pub(crate) collaboration_mode: Option<CollaborationMode>,
+    pub(crate) personality: Option<Personality>,
+}
+
+fn normalize_collaboration_mode(mut collaboration_mode: CollaborationMode) -> CollaborationMode {
+    if collaboration_mode.settings.developer_instructions.is_none()
+        && let Some(instructions) = builtin_collaboration_mode_presets()
+            .into_iter()
+            .find(|preset| preset.mode == Some(collaboration_mode.mode))
+            .and_then(|preset| preset.developer_instructions.flatten())
+            .filter(|instructions| !instructions.is_empty())
+    {
+        collaboration_mode.settings.developer_instructions = Some(instructions);
+    }
+
+    collaboration_mode
+}
+
+pub(crate) async fn build_environment_override(
+    source: &SettingsSource<'_>,
+    thread_manager: &ThreadManager,
+    cwd: Option<AbsolutePathBuf>,
+    workspace_roots: Option<Vec<AbsolutePathBuf>>,
+    environment_selections: Option<Vec<TurnEnvironmentSelection>>,
+) -> ThreadEnvironmentOverride {
+    if cwd.is_none() && workspace_roots.is_none() && environment_selections.is_none() {
+        return ThreadEnvironmentOverride::default();
+    }
+
+    // Explicit environment selections own their roots and pass through unchanged. Top-level
+    // `runtimeWorkspaceRoots` is only a compatibility input for default environments.
+    if let Some(environment_selections) = environment_selections {
+        let legacy_fallback_cwd = match cwd {
+            Some(cwd) => cwd,
+            None => match environment_selections
+                .iter()
+                .find(|selection| selection.environment_id == LOCAL_ENVIRONMENT_ID)
+                .and_then(|selection| selection.cwd.to_abs_path().ok())
+            {
+                Some(cwd) => cwd,
+                None => source.permission_snapshot().await.cwd().clone(),
+            },
+        };
+        return ThreadEnvironmentOverride {
+            environments: Some(TurnEnvironmentSelections::new(
+                legacy_fallback_cwd,
+                environment_selections,
+            )),
+            ..Default::default()
+        };
+    }
+
+    // Default-environment updates retain the task's fallback roots, not its active roots.
+    let (current_cwd, runtime_workspace_roots) = source.environment_snapshot().await;
+    let legacy_fallback_cwd = cwd.unwrap_or_else(|| current_cwd.clone());
+    let workspace_roots = match workspace_roots {
+        Some(workspace_roots) => workspace_roots,
+        None => path_utils::replace_path_and_deduplicate(
+            runtime_workspace_roots.unwrap_or_default(),
+            current_cwd.as_path(),
+            legacy_fallback_cwd.clone(),
+        ),
+    };
+    let environment_selections =
+        thread_manager.default_environment_selections(&legacy_fallback_cwd, &workspace_roots);
+    ThreadEnvironmentOverride {
+        environments: Some(TurnEnvironmentSelections::new(
+            legacy_fallback_cwd,
+            environment_selections,
+        )),
+        runtime_workspace_roots: Some(workspace_roots),
+    }
+}
+
+pub(crate) async fn build_thread_settings_overrides(
+    source: &mut SettingsSource<'_>,
+    config_manager: &ConfigManager,
+    params: ThreadSettingsBuildParams,
+) -> Result<codex_protocol::protocol::ThreadSettingsOverrides, JSONRPCErrorError> {
+    let ThreadSettingsBuildParams {
+        method,
+        disabled_plugin_ids,
+        environment_override:
+            ThreadEnvironmentOverride {
+                environments,
+                runtime_workspace_roots,
+            },
+        approval_policy,
+        approvals_reviewer,
+        sandbox_policy,
+        permissions,
+        model,
+        service_tier,
+        effort,
+        summary,
+        collaboration_mode,
+        personality,
+    } = params;
+
+    if sandbox_policy.is_some() && permissions.is_some() {
+        return Err(invalid_request(
+            "`permissions` cannot be combined with `sandboxPolicy`",
+        ));
+    }
+
+    let collaboration_mode = collaboration_mode.map(normalize_collaboration_mode);
+    let has_environment_override = environments.is_some();
+    // `thread/settings/update` only acknowledges that the update was queued.
+    // Clients that send dependent partial updates should wait for
+    // `thread/settings/updated` or combine the fields in one request.
+    let snapshot = if permissions.is_some() {
+        Some(source.permission_snapshot().await)
+    } else {
+        None
+    };
+
+    let has_any_overrides = has_environment_override
+        || disabled_plugin_ids.is_some()
+        || approval_policy.is_some()
+        || approvals_reviewer.is_some()
+        || sandbox_policy.is_some()
+        || permissions.is_some()
+        || model.is_some()
+        || service_tier.is_some()
+        || effort.is_some()
+        || summary.is_some()
+        || collaboration_mode.is_some()
+        || personality.is_some();
+
+    let approval_policy = approval_policy.map(codex_app_server_protocol::AskForApproval::to_core);
+    let approvals_reviewer =
+        approvals_reviewer.map(codex_app_server_protocol::ApprovalsReviewer::to_core);
+    let sandbox_policy = sandbox_policy.map(|policy| policy.to_core());
+    let (permission_profile, active_permission_profile, profile_workspace_roots) =
+        if let Some(permissions) = permissions {
+            let Some(snapshot) = snapshot.as_ref() else {
+                return Err(internal_error(format!(
+                    "{method} permission selection missing thread snapshot"
+                )));
+            };
+            let thread_config = source.permission_config().await;
+            let cwd = environments.as_ref().map_or_else(
+                || snapshot.cwd().clone(),
+                |environments| environments.legacy_fallback_cwd.clone(),
+            );
+            let config = config_manager
+                .load_permission_config_for_thread(&thread_config, cwd, permissions)
+                .await
+                .map_err(|error| config_load_error(&error))?;
+            // Startup config is allowed to fall back when requirements
+            // disallow a configured profile. An explicit settings update
+            // is different: reject it before accepting the request.
+            if let Some(warning) = config.startup_warnings.iter().find(|warning| {
+                warning.contains("Configured value for `permission_profile` is disallowed")
+            }) {
+                return Err(invalid_request(format!(
+                    "invalid thread settings override: {warning}"
+                )));
+            }
+            (
+                Some(config.permissions.permission_profile().clone()),
+                config.permissions.active_permission_profile(),
+                Some(config.permissions.profile_workspace_roots().to_vec()),
+            )
+        } else {
+            (None, None, None)
+        };
+    let effort = effort.map(Some);
+
+    if has_any_overrides {
+        source
+            .preview(codex_protocol::protocol::ThreadSettingsOverrides {
+                disabled_plugin_ids: disabled_plugin_ids.clone(),
+                environments: environments.clone(),
+                runtime_workspace_roots: runtime_workspace_roots.clone(),
+                approval_policy,
+                approvals_reviewer,
+                sandbox_policy: sandbox_policy.clone(),
+                permission_profile: permission_profile.clone(),
+                active_permission_profile: active_permission_profile.clone(),
+                profile_workspace_roots: profile_workspace_roots.clone(),
+                windows_sandbox_level: None,
+                model: model.clone(),
+                effort: effort.clone(),
+                summary,
+                service_tier: service_tier.clone(),
+                collaboration_mode: collaboration_mode.clone(),
+                personality,
+            })
+            .await
+            .map_err(|err| invalid_request(format!("invalid thread settings override: {err}")))?;
+    }
+
+    Ok(codex_protocol::protocol::ThreadSettingsOverrides {
+        disabled_plugin_ids,
+        environments,
+        runtime_workspace_roots,
+        profile_workspace_roots,
+        approval_policy,
+        approvals_reviewer,
+        sandbox_policy,
+        permission_profile,
+        active_permission_profile,
+        windows_sandbox_level: None,
+        model,
+        effort,
+        summary,
+        service_tier,
+        collaboration_mode,
+        personality,
+    })
+}
+
