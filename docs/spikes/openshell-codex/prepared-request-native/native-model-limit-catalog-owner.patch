index 0000000..62b0388
--- /dev/null
+++ b/codex-rs/models-manager/src/model_limits.rs
@@ -0,0 +1,93 @@
+//! Provider specification projection under the existing model catalog owner.
+//!
+//! A candidate is explicitly unverified for account/provider/Responses access.
+//! Neither bundled nor cached model metadata proves that access. These types
+//! cannot measure, admit, consume or dispatch a request. The catalog guard pins
+//! only this owner's publication; actual configuration, route, credentials and
+//! all other native/host authorities need their own guards at commitment.
+use crate::ModelsManagerConfig;
+use crate::cache::ModelsCacheEntry;
+use crate::model_info;
+use crate::provider_spec_limits::ProviderSpecLimits;
+use codex_protocol::openai_models::ModelInfo;
+use std::sync::Arc;
+use tokio::sync::RwLockReadGuard;
+
+#[derive(Debug)]
+pub struct ModelSpecCeilings {
+    pub context_window: u64,
+    pub maximum_output_tokens: u64,
+    pub specification_url: String,
+    pub policy_revision: String,
+    pub descriptor_sha256: &'static str,
+}
+
+/// Process-local observation, not serializable or an account eligibility grant.
+#[derive(Debug)]
+pub struct UnverifiedModelLimitCandidate {
+    pub(crate) owner: Arc<()>,
+    pub(crate) publication: Arc<()>,
+    pub(crate) original: ModelInfo,
+    resolved: ModelInfo,
+    ceilings: ModelSpecCeilings,
+}
+impl UnverifiedModelLimitCandidate {
+    pub(crate) fn capture(
+        owner: Arc<()>,
+        publication: Arc<()>,
+        original: ModelInfo,
+        config: &ModelsManagerConfig,
+    ) -> Option<Self> {
+        let spec = ProviderSpecLimits::for_exact_model_id(&original.slug)?;
+        if spec.model_id != original.slug
+            || !original.supported_in_api
+            || original.used_fallback_model_metadata
+            || config.model_catalog.is_some()
+            || !(1..=100).contains(&original.effective_context_window_percent)
+        {
+            return None;
+        }
+        let original_window = u64::try_from(original.usable_context_window()?).ok()?;
+        let resolved = model_info::with_config_overrides(original.clone(), config);
+        let configured_window = u64::try_from(resolved.usable_context_window()?).ok()?;
+        let context_window = spec
+            .context_window
+            .min(original_window)
+            .min(configured_window);
+        if context_window == 0 || spec.maximum_output_tokens == 0 {
+            return None;
+        }
+        Some(Self {
+            owner,
+            publication,
+            original,
+            resolved,
+            ceilings: ModelSpecCeilings {
+                context_window,
+                maximum_output_tokens: spec.maximum_output_tokens,
+                specification_url: spec.specification_url,
+                policy_revision: spec.policy_revision,
+                descriptor_sha256: spec.descriptor_sha256,
+            },
+        })
+    }
+    pub fn model_info(&self) -> &ModelInfo {
+        &self.resolved
+    }
+    pub fn ceilings(&self) -> &ModelSpecCeilings {
+        &self.ceilings
+    }
+}
+
+/// Holds the actual catalog read lock; no callback or later boolean substitutes
+/// for that lock. This does not hold credential, route or configuration authority.
+#[must_use]
+pub struct ModelLimitsCatalogGuard<'a> {
+    pub(crate) _catalog: RwLockReadGuard<'a, ModelsCacheEntry>,
+    pub(crate) candidate: &'a UnverifiedModelLimitCandidate,
+}
+impl ModelLimitsCatalogGuard<'_> {
+    pub fn candidate(&self) -> &UnverifiedModelLimitCandidate {
+        self.candidate
+    }
+}
