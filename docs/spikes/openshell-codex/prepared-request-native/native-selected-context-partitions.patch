+/// Original data stays partitioned: missing native sections cannot be flattened
+/// away into a complete initial context. The source packet retains first-input,
+/// tools and all original Skills observations separately; none is discarded.
+pub(crate) struct ObservedAppServerInitialContext<'a> {
+    pub(crate) sources: &'a CapturedAppServerExtensionSources<'a>,
+    pub(crate) selected:
+        &'a crate::config_manager::selected_start_config::SelectedConfiguredStart<'a>,
+    pub(crate) builtin: codex_core::PreSessionBuiltinContextData,
+    pub(crate) extensions: Vec<ObservedExtensionInitialPartition<'a>>,
