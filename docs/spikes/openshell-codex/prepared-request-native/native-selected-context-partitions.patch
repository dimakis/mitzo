+//! Genuine selected-start builtin DATA, deliberately incomplete.
+//! No Session/Turn/WorldState, lifecycle callback, tool, network, identity,
+//! request/count/State operation or complete-context rendering is available.
+//! These projections are observations, not leases over external sources.
+use super::PreSessionSkillsObservation;
+use super::PreSessionSystemClockObservation;
+use super::SelectedStartInputs;
+use super::ThreadManager;
+use crate::session::initial_context_builtin;
+use crate::session::initial_context_builtin::InitialDeveloperData;
+use crate::session::initial_context_render::ResolvedInitialSection;
+use codex_context_fragments::RenderedFragment;
+use codex_features::Feature;
+use std::io;
+
+/// Actual unresolved original producer inputs. A successful partial projection
+/// never converts these into absence or qualifies a complete initial request.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum UnresolvedInitialContextPartition {
+    ModelAndBaseInstructionsSelection,
+    InitialTurnSettings,
+    PermissionsAndEnvironmentSnapshot,
+    RepositoryInstructions,
+    RealtimeAndSubagentState,
+    FinalizedToolPlan,
+    NativeTurnIdentity,
+    TokenBudgetHistory,
+    PluginRecommendations,
+}
+
+/// Non-Clone/non-Serialize partial data. Section IDs/bytes and source checks
+/// cannot establish readiness. No method constructs a Prompt or ResponseItems.
+pub struct PreSessionBuiltinContextData {
+    model_instructions: String,
+    sections: Vec<ResolvedInitialSection>,
+    trailing_sections: Vec<ResolvedInitialSection>,
+    developer: InitialDeveloperData,
+    unresolved: Vec<UnresolvedInitialContextPartition>,
+}
+impl PreSessionBuiltinContextData {
+    pub fn model_instructions(&self) -> &str {
+        &self.model_instructions
+    }
+    /// Each section is separate: missing sections MUST NOT be flattened away
+    /// into purported full-world-state order. Extension composition belongs
+    /// between the leading and trailing partitions at the original owner.
+    pub fn leading_sections(
+        &self,
+    ) -> impl Iterator<Item = (&'static str, Vec<RenderedFragment>)> + '_ {
+        self.sections.iter().map(|section| {
+            (
+                section.id,
+                section
+                    .fragments
+                    .iter()
+                    .map(|fragment| fragment.rendered.clone())
+                    .collect(),
+            )
+        })
+    }
+    pub fn trailing_sections(
+        &self,
+    ) -> impl Iterator<Item = (&'static str, Vec<RenderedFragment>)> + '_ {
+        self.trailing_sections.iter().map(|section| {
+            (
+                section.id,
+                section
+                    .fragments
+                    .iter()
+                    .map(|fragment| fragment.rendered.clone())
+                    .collect(),
+            )
+        })
+    }
+    pub fn developer_fragments(&self) -> &[RenderedFragment] {
+        &self.developer.developer_sections
+    }
+    pub fn unresolved_partitions(&self) -> &[UnresolvedInitialContextPartition] {
+        &self.unresolved
+    }
+}
+fn unavailable(message: &'static str) -> io::Error {
+    io::Error::other(message)
+}
+impl ThreadManager {
+    /// Projects only settled builtin inputs from the actual selected-start and
+    /// its same Skills/clock observations. Full model selection, effective turn
+    /// settings, ordinary environment snapshot and history remain unresolved.
+    pub async fn observe_pre_session_builtin_context(
+        &self,
+        selected: &SelectedStartInputs,
+        skills: &PreSessionSkillsObservation<'_>,
+        clock: &PreSessionSystemClockObservation<'_>,
+    ) -> io::Result<PreSessionBuiltinContextData> {
+        self.with_current_selected_start(selected, || ())?;
+        let sources = selected
+            .mcp_sources()
+            .ok_or_else(|| unavailable("selected MCP source is missing"))?;
+        if !std::ptr::eq(sources, skills.sources) || !std::ptr::eq(sources, clock.start_sources()) {
+            return Err(unavailable(
+                "builtin observations belong to another selected start",
+            ));
+        }
+        let config = &sources.start_options().config;
+        let source = sources
+            .start_options()
+            .session_source
+            .as_ref()
+            .ok_or_else(|| unavailable("ordinary source is unresolved"))?;
+        if sources.api_key_credentials().is_none() {
+            return Err(unavailable("original API source is unresolved"));
+        }
+        let catalog = self
+            .state
+            .models_manager
+            .pin_model_limit_candidate(skills.model_candidate())
+            .await
+            .ok_or_else(|| unavailable("selected model catalog changed"))?;
+        self.with_current_selected_start(selected, || ())?;
+        // The existing API-key source is verified above. Use the SAME original
+        // feature/auth predicate as TurnContext::apps_enabled, not a flag reset.
+        let apps_enabled = config
+            .features
+            .apps_enabled_for_auth(/*has_chatgpt_auth*/ false)
+            && config.orchestrator_mcp_enabled;
+        let model = skills.skills().model();
+        let (environments, apps, plugins) = initial_context_builtin::execution_guidance(
+            config,
+            model,
+            sources.binding(),
+            apps_enabled,
+        );
+        let sections = vec![
+            ResolvedInitialSection::native(environments),
+            ResolvedInitialSection::native(apps),
+            ResolvedInitialSection::native(plugins),
+        ];
+        let trailing_sections = initial_context_builtin::managed_developer_section(config, source)
+            .map(ResolvedInitialSection::native)
+            .into_iter()
+            .collect();
+        let mut unresolved = vec![
+            UnresolvedInitialContextPartition::ModelAndBaseInstructionsSelection,
+            UnresolvedInitialContextPartition::InitialTurnSettings,
+            UnresolvedInitialContextPartition::PermissionsAndEnvironmentSnapshot,
+            UnresolvedInitialContextPartition::RepositoryInstructions,
+            UnresolvedInitialContextPartition::RealtimeAndSubagentState,
+            UnresolvedInitialContextPartition::FinalizedToolPlan,
+            UnresolvedInitialContextPartition::NativeTurnIdentity,
+        ];
+        if config.features.enabled(Feature::TokenBudget)
+            && model.resolved_context_window().is_some()
+        {
+            unresolved.push(UnresolvedInitialContextPartition::TokenBudgetHistory);
+        }
+        if config.features.plugin_recommendations_enabled() {
+            unresolved.push(UnresolvedInitialContextPartition::PluginRecommendations);
+        }
+        let data = PreSessionBuiltinContextData {
+            model_instructions: initial_context_builtin::model_instructions(config, model),
+            sections,
+            trailing_sections,
+            developer: InitialDeveloperData::new(source, config.developer_instructions.as_deref()),
+            unresolved,
+        };
+        // Renew the original selected publications, never a caller readiness bit.
+        // This point check grants no later lease and does not cover missing
+        // environment/config/filesystem/history inputs.
+        let renew = || {
+            self.state
+                .environment_manager
+                .with_current_selected_environment_publications(
+                    skills.environment_publication(),
+                    || {
+                        self.state
+                            .skills_service
+                            .with_current_pre_session_prompt_roots(
+                                skills.skills().host_observation(),
+                                || (),
+                            )
+                    },
+                )
+        };
+        let renewed = if let Some(plugins) = sources.plugin_sources() {
+            plugins
+                .with_current_api_key_sources(renew)
+                .map_err(|_| unavailable("plugin source changed"))?
+        } else {
+            renew()
+        };
+        renewed
+            .map_err(|_| unavailable("selected environment changed"))?
+            .map_err(|_| unavailable("host Skills source changed"))?;
+        self.with_current_selected_start(selected, || ())?;
+        drop(catalog);
+        Ok(data)
+    }
+}
