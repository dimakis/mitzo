+impl<'a> CapturedAppServerExtensionSources<'a> {
+    /// Original installed composition owner. This retains partial DATA only;
+    /// there is no caller classification, complete-context renderer or request
+    /// builder. Only controlled publications are checked here; config/cloud/filesystem
+    /// renewal remains a separate original-owner operation, not a lease.
+    pub(crate) async fn observe_initial_context_partitions(
+        &'a self,
+        selected: &'a crate::config_manager::selected_start_config::SelectedConfiguredStart<'a>,
+    ) -> Result<ObservedAppServerInitialContext<'a>, AppServerExtensionSourceError> {
+        if !selected
+            .start()
+            .mcp_sources()
+            .is_some_and(|sources| std::ptr::eq(sources, self.sources))
+        {
+            return Err(AppServerExtensionSourceError::SelectedConfigMismatch);
+        }
+        selected
+            .with_current(self.manager, || ())
+            .map_err(|_| AppServerExtensionSourceError::SelectedStartUnavailable)?;
+        let registry = self
+            .manager
+            .pre_session_extension_registry(self.sources)
+            .map_err(AppServerExtensionSourceError::NativeMcp)?;
+        registry
+            .assert_bound_context_source_registrations(&self.registrations)
+            .map_err(AppServerExtensionSourceError::Registration)?;
+        let builtin = self
+            .manager
+            .observe_pre_session_builtin_context(selected.start(), self.skills, &self.system_clock)
+            .await
+            .map_err(|_| AppServerExtensionSourceError::BuiltinSourcesUnavailable)?;
+        let mut extensions = vec![ObservedExtensionInitialPartition::Skills(self.skills)];
+        extensions.extend(
+            self.history_notes
+                .iter()
+                .map(ObservedExtensionInitialPartition::HistoryNotes),
+        );
+        for observation in &self.git_attribution {
+            observation
+                .with_current_api_key_source(|| ())
+                .map_err(AppServerExtensionSourceError::GitAttribution)?;
+            extensions.push(ObservedExtensionInitialPartition::GitAttribution(
+                observation,
+            ));
+        }
+        extensions.extend(
+            self.memories
+                .iter()
+                .map(ObservedExtensionInitialPartition::Memories),
+        );
+        extensions.sort_by_key(ObservedExtensionInitialPartition::registration_index);
+        selected
+            .with_current(self.manager, || ())
+            .map_err(|_| AppServerExtensionSourceError::SelectedStartUnavailable)?;
+        registry
+            .assert_bound_context_source_registrations(&self.registrations)
+            .map_err(AppServerExtensionSourceError::Registration)?;
+        Ok(ObservedAppServerInitialContext {
+            sources: self,
+            selected,
+            builtin,
+            extensions,
+        })
+    }
+}
