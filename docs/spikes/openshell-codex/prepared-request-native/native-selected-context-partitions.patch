+
+/// Keep ORIGINAL typed observations rather than classifying missing partitions
+/// from empty vectors. Their source-owned accessors retain section IDs, slots,
+/// exact fragments, and the difference between prompt and first-turn inputs.
+pub(crate) enum ObservedExtensionInitialPartition<'a> {
+    Skills(&'a PreSessionSkillsObservation<'a>),
+    HistoryNotes(&'a HistoryNotesInitialObservation<'a>),
+    GitAttribution(&'a GitAttributionInitialObservation<'a>),
+    Memories(&'a MemoriesInitialObservation<'a>),
+}
+impl ObservedExtensionInitialPartition<'_> {
+    pub(crate) fn registration_index(&self) -> usize {
+        match self {
+            Self::Skills(observation) => observation.skills().context_source_identity(),
+            Self::HistoryNotes(observation) => observation.context_source_identity(),
+            Self::GitAttribution(observation) => observation.context_source_identity(),
+            Self::Memories(observation) => observation.context_source_identity(),
+        }
+        .registration_index()
+    }
+}
