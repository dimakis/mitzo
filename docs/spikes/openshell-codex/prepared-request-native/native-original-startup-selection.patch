+    let base = resolve_base_instructions(&effective, &options.initial_history, &row);
+    assert_eq!(startup.owner.candidate.model_info(), &row);
+    assert_eq!(startup.effective_config(), effective.as_ref());
+    assert_eq!(startup.raw_config(), &raw);
+    assert_ne!(raw.permissions, effective.permissions);
+    assert_eq!(effective.approvals_reviewer, ApprovalsReviewer::AutoReview);
+    // Actual allocation consumed this controller/routing/recorder projection.
+    assert_eq!(
+        (
+            &raw.rollout_budget,
+            &raw.chatgpt_base_url,
+            &raw.cwd,
+            &raw.config_layer_stack,
+            crate::state::ExecutedToolCalls::is_enabled(&raw.features)
+        ),
+        (
+            &effective.rollout_budget,
+            &effective.chatgpt_base_url,
+            &effective.cwd,
+            &effective.config_layer_stack,
+            crate::state::ExecutedToolCalls::is_enabled(&effective.features)
+        ),
+    );
+    let constructor_projection = |config: &Config| {
+        (
+            config.model_provider.clone(),
+            config.model_verbosity,
+            config.ephemeral,
+            [
+                Feature::UseAgentIdentity,
+                Feature::ContentItemKinds,
+                Feature::ReasoningEffortOverride,
+                Feature::EnableRequestCompression,
+                Feature::RuntimeMetrics,
+                Feature::ConcurrentReasoningSummaries,
+            ]
+            .map(|feature| config.features.enabled(feature)),
+            Session::build_model_client_beta_features_header(config),
+            config.http_client_factory(),
+        )
+    };
+    assert!(Session::build_model_client_beta_features_header(&raw).is_some());
+    assert_eq!(
+        constructor_projection(&raw),
+        constructor_projection(&effective)
+    );
+    let (owner, mut stages, adopted_raw) = startup.into_session(
+        &models,
+        &auth,
+        &effective,
+        &options.initial_history,
