+#[tokio::test]
+async fn installed_first_command_startup_preserves_raw_owner_and_effective_inputs_without_start() {
+    let home = tempfile::tempdir().unwrap();
+    std::fs::write(
+        home.path().join("config.toml"),
+        "model = 'gpt-6-luna'\nsandbox_mode = 'danger-full-access'\n",
+    )
+    .unwrap();
+    std::fs::write(
+        home.path().join("requirements.toml"),
+        "[auto_review]\nrequired_on_models = ['gpt-6-luna']\n",
+    )
+    .unwrap();
+    let configs = manager(home.path());
+    let source = configs
+        .load_selected_start_config(
+            None,
+            ConfigOverrides {
+                cwd: Some(home.path().to_path_buf()),
+                ..Default::default()
+            },
+        )
+        .await
+        .unwrap();
+    let raw = source.config().clone();
+    let store = Arc::new(InMemoryThreadStore::default());
+    let (threads, installed, auth) = thread_manager_with_models(&raw, Arc::clone(&store), |auth| {
+        Arc::new(
+            codex_models_manager::manager::OpenAiModelsManager::new_without_cache(
+                Arc::new(NoStartupEndpoint),
+                Some(Arc::clone(auth)),
+            ),
+        )
+    });
+    assert!(raw.features.enabled(Feature::Apps));
+    assert!(raw.features.enabled(Feature::Plugins));
+    let command = OriginalFirstCommandStart::new(
+        StartThreadOptions::new(raw.clone()),
+        threads.reserve_thread_start(),
+        installed,
+    );
+    let mut selected = source
+        .capture_first_command(&threads, command)
+        .await
+        .unwrap();
+    selected.capture_startup(&threads).await.unwrap();
+    let effective = selected.start().start_options().unwrap().config.clone();
+    // The real raw loader is renewed against raw values, never derived values.
+    assert_eq!(selected.source.config(), &raw);
+    assert_ne!(effective, raw);
+    selected.renew(&threads).await.unwrap();
+    assert!(selected.adopt(&threads).is_err());
+    selected.capture_startup_api_mcp(&threads).unwrap();
+    assert_eq!(
+        &selected
+            .start()
+            .mcp_sources()
+            .unwrap()
+            .start_options()
+            .config,
+        &effective
+    );
+    selected.construct_client(&threads).await.unwrap();
+    assert!(Arc::ptr_eq(
+        &auth,
+        &threads
+            .selected_start_client(selected.start())
+            .unwrap()
+            .auth_manager()
+            .unwrap()
+    ));
+    let adoption = selected.adopt_startup(&threads).await.unwrap();
+    assert!(Arc::ptr_eq(
+        &auth,
+        &adoption.client().unwrap().auth_manager().unwrap()
+    ));
+    assert!(selected.adopt_startup(&threads).await.is_err());
+    assert!(threads.list_thread_ids().await.is_empty());
+    assert_eq!(
+        store.calls().await,
+        codex_thread_store::InMemoryThreadStoreCalls::default()
+    );
+    assert!(!home.path().join(".sandbox_migration").exists());
+}
