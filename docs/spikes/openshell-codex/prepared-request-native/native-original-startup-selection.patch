diff --git a/codex-rs/core/src/session/startup_selection.rs b/codex-rs/core/src/session/startup_selection.rs
new file mode 100644
index 0000000..51e4b3f
--- /dev/null
+++ b/codex-rs/core/src/session/startup_selection.rs
@@ -0,0 +1,297 @@
+//! Original startup DATA stages and exact catalog/credential observations.
+//! Raw loader Config remains distinct from reviewed/effective Config. This
+//! packet neither captures a request nor grants account eligibility or Ready.
+use super::*;
+use codex_models_manager::model_limits::ModelLimitsCatalogGuard;
+use codex_models_manager::model_limits::UnverifiedModelLimitCandidate;
+use std::io;
+
+/// Non-Clone/non-Serialize; created only by the selected ThreadManager phase.
+pub(crate) struct OriginalStartupSelection {
+    pub(super) owner: StartupSelectionOwner,
+    pub(super) stages: StartupSelectionStages,
+}
+pub(super) struct StartupSelectionOwner {
+    models: SharedModelsManager,
+    auth: Arc<AuthManager>,
+    pub(crate) credentials: Arc<codex_login::auth::CapturedApiKeyCredentials>,
+    candidate: Arc<UnverifiedModelLimitCandidate>,
+    raw: Config,
+    effective: Arc<Config>,
+    source: SessionSource,
+}
+pub(super) struct StartupSelectionStages {
+    model: String,
+    reviewed: Option<Arc<Config>>,
+    effective: Option<Arc<Config>>,
+    base: Option<String>,
+    trusted: bool,
+}
+impl OriginalStartupSelection {
+    pub(crate) async fn capture(
+        options: &crate::StartThreadOptions,
+        source: &SessionSource,
+        auth: &Arc<AuthManager>,
+        models: &SharedModelsManager,
+    ) -> io::Result<Self> {
+        if !matches!(options.initial_history, InitialHistory::New) {
+            return Err(io::Error::other(
+                "startup selection requires original fresh history",
+            ));
+        }
+        let raw = options.config.clone();
+        let model = raw
+            .model
+            .clone()
+            .filter(|id| !id.trim().is_empty())
+            .ok_or_else(|| io::Error::other("startup selection requires an explicit model"))?;
+        crate::client::ModelClient::validate_public_api_client_inputs(source, &raw.model_provider)
+            .map_err(io::Error::other)?;
+        let credentials = Arc::new(
+            auth.capture_cached_api_key_credentials()
+                .ok_or_else(|| io::Error::other("original cached API credentials unavailable"))?,
+        );
+        // Release all synchronous auth locks before any catalog await or Config work.
+        auth.with_current_api_key_credentials(&credentials, |_, _| ())
+            .ok_or_else(|| io::Error::other("original credentials changed"))?;
+        let mut reviewed = Arc::new(raw.clone());
+        let trusted = apply_review(&mut reviewed, &model, &options.initial_history, source)
+            .map_err(io::Error::other)?;
+        let candidate = models
+            .capture_model_limit_candidate(&model, &reviewed.to_models_manager_config())
+            .await
+            .ok_or_else(|| io::Error::other("exact original model candidate unavailable"))?;
+        // Unknown managers refuse above, before invoking an ordinary metadata
+        // method. The original manager's getter observes only its retained catalog.
+        let actual_row = models
+            .get_model_info(&model, &reviewed.to_models_manager_config())
+            .await;
+        let pin = models
+            .pin_model_limit_candidate(&candidate)
+            .await
+            .ok_or_else(|| io::Error::other("original model publication changed"))?;
+        if candidate.model_info() != &actual_row {
+            return Err(io::Error::other(
+                "exact candidate differs from ordinary model selection",
+            ));
+        }
+        let cached_auth = auth
+            .with_current_api_key_credentials(&credentials, |auth, _| auth.clone())
+            .ok_or_else(|| io::Error::other("original credentials changed"))?;
+        let mut effective = Arc::clone(&reviewed);
+        apply_token_budget(
+            &mut effective,
+            &options.initial_history,
+            Some(&cached_auth),
+            candidate.model_info(),
+        )
+        .map_err(io::Error::other)?;
+        let base =
+            resolve_base_instructions(&effective, &options.initial_history, candidate.model_info());
+        auth.with_current_api_key_credentials(&credentials, |_, _| ())
+            .ok_or_else(|| io::Error::other("original credentials changed"))?;
+        drop(pin);
+        Ok(Self {
+            owner: StartupSelectionOwner {
+                models: Arc::clone(models),
+                auth: Arc::clone(auth),
+                credentials,
+                candidate: Arc::new(candidate),
+                raw,
+                effective: Arc::clone(&effective),
+                source: source.clone(),
+            },
+            stages: StartupSelectionStages {
+                model,
+                reviewed: Some(reviewed),
+                effective: Some(effective),
+                base: Some(base),
+                trusted,
+            },
+        })
+    }
+    pub(crate) fn catalog_observation(
+        &self,
+    ) -> (SharedModelsManager, Arc<UnverifiedModelLimitCandidate>) {
+        (
+            Arc::clone(&self.owner.models),
+            Arc::clone(&self.owner.candidate),
+        )
+    }
+    pub(crate) fn validate_selection(
+        &self,
+        models: &SharedModelsManager,
+        auth: &Arc<AuthManager>,
+        config: &Config,
+    ) -> io::Result<()> {
+        self.owner.validate(models, auth, config)
+    }
+    pub(crate) fn raw_config(&self) -> &Config {
+        &self.owner.raw
+    }
+    pub(crate) fn effective_config(&self) -> &Config {
+        &self.owner.effective
+    }
+    pub(crate) fn credentials(&self) -> Arc<codex_login::auth::CapturedApiKeyCredentials> {
+        Arc::clone(&self.owner.credentials)
+    }
+    pub(crate) async fn renew(
+        &self,
+        models: &SharedModelsManager,
+        auth: &Arc<AuthManager>,
+        config: &Config,
+    ) -> io::Result<()> {
+        self.owner.validate(models, auth, config)?;
+        let _pin = self.owner.pin().await?;
+        self.owner.current_auth()?;
+        Ok(())
+    }
+    pub(super) fn into_session(
+        self,
+        models: &SharedModelsManager,
+        auth: &Arc<AuthManager>,
+        config: &Config,
+        history: &InitialHistory,
+        source: &SessionSource,
+    ) -> io::Result<(StartupSelectionOwner, StartupSelectionStages, Config)> {
+        self.owner.validate(models, auth, config)?;
+        if !matches!(history, InitialHistory::New) || *source != self.owner.source {
+            return Err(io::Error::other(
+                "ordinary startup changed original startup inputs",
+            ));
+        }
+        let raw = self.owner.raw.clone();
+        Ok((self.owner, self.stages, raw))
+    }
+}
+impl StartupSelectionOwner {
+    fn validate(
+        &self,
+        models: &SharedModelsManager,
+        auth: &Arc<AuthManager>,
+        config: &Config,
+    ) -> io::Result<()> {
+        if !Arc::ptr_eq(models, &self.models)
+            || !Arc::ptr_eq(auth, &self.auth)
+            || *config != *self.effective
+        {
+            return Err(io::Error::other(
+                "original startup owner or effective Config changed",
+            ));
+        }
+        self.current_auth().map(|_| ())
+    }
+    pub(super) async fn pin(&self) -> io::Result<ModelLimitsCatalogGuard<'_>> {
+        self.models
+            .pin_model_limit_candidate(&self.candidate)
+            .await
+            .ok_or_else(|| io::Error::other("original model publication changed"))
+    }
+    pub(super) fn model_info(&self) -> &ModelInfo {
+        self.candidate.model_info()
+    }
+    pub(super) fn current_auth(&self) -> io::Result<CodexAuth> {
+        self.auth
+            .with_current_api_key_credentials(&self.credentials, |auth, _| auth.clone())
+            .ok_or_else(|| io::Error::other("original credentials changed"))
+    }
+}
+impl StartupSelectionStages {
+    pub(super) fn take_review(&mut self) -> io::Result<(String, Arc<Config>, bool)> {
+        let reviewed = self
+            .reviewed
+            .take()
+            .ok_or_else(|| io::Error::other("startup review already adopted"))?;
+        Ok((std::mem::take(&mut self.model), reviewed, self.trusted))
+    }
+    pub(super) fn take_effective(&mut self) -> io::Result<Arc<Config>> {
+        self.effective
+            .take()
+            .ok_or_else(|| io::Error::other("startup activation already adopted"))
+    }
+    pub(super) fn take_base(&mut self) -> io::Result<String> {
+        self.base
+            .take()
+            .ok_or_else(|| io::Error::other("startup base instructions already adopted"))
+    }
+}
+
+// These are the original ordinary data transforms, shared at their original
+// pre-row / post-row / base-instructions evaluation positions.
+pub(super) fn apply_review(
+    config: &mut Arc<Config>,
+    model: &str,
+    conversation_history: &InitialHistory,
+    session_source: &SessionSource,
+) -> CodexResult<bool> {
+    let trusted_guardian_reviewer = crate::guardian::is_basic_session_source(&session_source)
+        && !matches!(conversation_history, InitialHistory::Resumed(_));
+    if config
+        .config_layer_stack
+        .requirements()
+        .auto_review_required_for_model(&model)
+        && !trusted_guardian_reviewer
+    {
+        let config = Arc::make_mut(config);
+        if matches!(
+            config.legacy_sandbox_policy(),
+            SandboxPolicy::DangerFullAccess
+        ) {
+            let permission_profile = PermissionProfile::workspace_write();
+            config
+                .permissions
+                .set_permission_profile(permission_profile.clone())
+                .map_err(|err| CodexErr::InvalidRequest(err.to_string()))?;
+            if let Some(network) = config.permissions.network.as_ref() {
+                config.permissions.network = Some(
+                    network
+                        .recompute_for_permission_profile(&permission_profile)
+                        .map_err(|err| CodexErr::InvalidRequest(err.to_string()))?,
+                );
+            }
+        }
+        config
+            .config_layer_stack
+            .requirements()
+            .approvals_reviewer
+            .can_set(&ApprovalsReviewer::AutoReview)
+            .map_err(|err| CodexErr::InvalidRequest(err.to_string()))?;
+        config.approvals_reviewer = ApprovalsReviewer::AutoReview;
+    }
+    Ok(trusted_guardian_reviewer)
+}
+pub(super) fn apply_token_budget(
+    config: &mut Arc<Config>,
+    conversation_history: &InitialHistory,
+    auth: Option<&CodexAuth>,
+    model_info: &ModelInfo,
+) -> CodexResult<()> {
+    // Forked subagents keep their parent's activation with the copied history.
+    // Fresh children restore configured preferences before applying startup defaults.
+    let inherits_token_budget = matches!(conversation_history, InitialHistory::Forked(_))
+        && config.token_budget_startup_config.is_some();
+    if !inherits_token_budget {
+        Arc::make_mut(config)
+            .prepare_token_budget_for_startup()
+            .map_err(|err| CodexErr::InvalidRequest(err.to_string()))?;
+        // Resolve activation for this runtime, including when resuming saved history.
+        token_budget::apply_experimental_context(Arc::make_mut(config), auth, model_info)?;
+        token_budget::apply_model_defaults(Arc::make_mut(config), model_info);
+    }
+    Ok(())
+}
+pub(super) fn resolve_base_instructions(
+    config: &Config,
+    conversation_history: &InitialHistory,
+    model_info: &ModelInfo,
+) -> String {
+    config
+        .base_instructions
+        .clone()
+        .or_else(|| conversation_history.get_base_instructions().map(|s| s.text))
+        .unwrap_or_else(|| render_model_instructions(model_info))
+}
