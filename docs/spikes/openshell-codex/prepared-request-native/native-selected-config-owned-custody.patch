+
+#[test]
+fn owned_runtime_observation_outlives_initiating_manager_and_tracks_shared_clone_aba() {
+    let home = tempfile::tempdir().unwrap();
+    let (observed, writer) = {
+        let initiating = ConfigManager::without_managed_config_for_tests(home.path().to_path_buf());
+        initiating
+            .extend_runtime_feature_enablement([("apps".to_string(), true)])
+            .unwrap();
+        (
+            initiating.observe_runtime_feature_source().unwrap(),
+            initiating.clone(),
+        )
+    };
+    assert!(Arc::ptr_eq(
+        &observed.publisher,
+        &writer.runtime_feature_enablement
+    ));
+    assert_eq!(
+        observed.with_current(|| observed.features().clone()),
+        Ok(BTreeMap::from([("apps".to_string(), true)]))
+    );
+    writer
+        .extend_runtime_feature_enablement([("apps".to_string(), false)])
+        .unwrap();
+    writer
+        .extend_runtime_feature_enablement([("apps".to_string(), true)])
+        .unwrap();
+    assert_eq!(
+        observed.features(),
+        &writer.current_runtime_feature_enablement()
+    );
+    let mut associated = false;
+    assert_eq!(
+        observed.with_current(|| associated = true),
+        Err(RuntimeFeatureSourceError::Changed)
+    );
+    assert!(!associated);
+}
+
+#[test]
+fn owned_poisoned_original_publisher_refuses_observation_and_association() {
+    let home = tempfile::tempdir().unwrap();
+    let manager = ConfigManager::without_managed_config_for_tests(home.path().to_path_buf());
+    let observed = manager.observe_runtime_feature_source().unwrap();
+    let publisher = Arc::clone(&manager.runtime_feature_enablement);
+    assert!(
+        std::thread::spawn(move || {
+            let _writer = publisher.write().unwrap();
+            panic!("poison original runtime publisher in deterministic fixture");
+        })
+        .join()
+        .is_err()
+    );
+    let mut associated = false;
+    assert_eq!(
+        observed.with_current(|| associated = true),
+        Err(RuntimeFeatureSourceError::Poisoned)
+    );
+    assert!(!associated);
+    assert_eq!(
+        manager.observe_runtime_feature_source().err(),
+        Some(RuntimeFeatureSourceError::Poisoned)
+    );
+}
