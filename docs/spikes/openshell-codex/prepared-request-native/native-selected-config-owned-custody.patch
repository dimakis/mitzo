+#[tokio::test]
+async fn owned_selected_source_outlives_initiating_manager_and_rejects_foreign_substitution() {
+    let home = tempfile::tempdir().unwrap();
+    let (source, writer) = {
+        let initiating = manager(home.path());
+        initiating
+            .extend_runtime_feature_enablement([("apps".to_string(), true)])
+            .unwrap();
+        let source = initiating
+            .load_selected_start_config(
+                None,
+                ConfigOverrides {
+                    cwd: Some(home.path().to_path_buf()),
+                    ..Default::default()
+                },
+            )
+            .await
+            .unwrap();
+        (source, initiating.clone())
+    };
+    assert!(Arc::ptr_eq(
+        &source.manager.runtime_feature_enablement,
+        &writer.runtime_feature_enablement
+    ));
+    assert!(Arc::ptr_eq(
+        &source.manager.cli_overrides,
+        &writer.cli_overrides
+    ));
+    assert!(Arc::ptr_eq(
+        &source.manager.cloud_config_bundle,
+        &writer.cloud_config_bundle
+    ));
+    assert!(Arc::ptr_eq(
+        &source.manager.network_policy_snapshot,
+        &writer.network_policy_snapshot
+    ));
+    let foreign = manager(home.path());
+    assert!(!Arc::ptr_eq(
+        &source.manager.runtime_feature_enablement,
+        &foreign.runtime_feature_enablement
+    ));
+    foreign
+        .extend_runtime_feature_enablement([("apps".to_string(), false)])
+        .unwrap();
+    source.renew().await.unwrap();
+    let config = source.config().clone();
+    assert!(config.features.enabled(Feature::Apps));
+    assert!(config.features.enabled(Feature::Plugins));
+    let store = Arc::new(InMemoryThreadStore::default());
+    let (threads, _installed, _auth) = thread_manager(&config, Arc::clone(&store));
+    let mut captured = source
+        .capture(&threads, StartThreadOptions::new(config))
+        .await
+        .unwrap();
+    drop(writer);
+    captured.renew(&threads).await.unwrap();
+    captured.with_current(&threads, || ()).unwrap();
+    let _adoption = captured.adopt(&threads).unwrap();
+    assert!(captured.adopt(&threads).is_err());
+    assert!(threads.list_thread_ids().await.is_empty());
+    assert_eq!(
+        store.calls().await,
+        codex_thread_store::InMemoryThreadStoreCalls::default()
+    );
+}
