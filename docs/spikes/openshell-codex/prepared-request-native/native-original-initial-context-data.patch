+use super::*;
+use crate::context::world_state::EnvironmentsInstructionsState;
+use crate::context::world_state::ModelInstructionsState;
+use crate::context::world_state::WorldState;
+use crate::session::initial_context_render::ResolvedInitialSection;
+use codex_protocol::models::ContentItemKind;
+use pretty_assertions::assert_eq;
+
+#[test]
+fn shared_slot_application_preserves_roles_and_context_window_hints() {
+    let policy =
+        PromptFragment::developer_policy("selected policy\n", ContentItemKind("policy".into()));
+    let capability = PromptFragment::developer_capability(
+        "selected capability λ",
+        ContentItemKind("capability".into()),
+    );
+    let hint = PromptFragment::new(
+        PromptSlot::ContextWindow,
+        "original window hint",
+        ContentItemKind("hint".into()),
+    );
+    let mut data = InitialDeveloperData::new(
+        &SessionSource::Exec,
+        Some("original developer instructions"),
+    );
+    for fragment in [policy.clone(), hint.clone(), capability.clone()] {
+        data.push_thread_fragment(fragment);
+    }
+    assert_eq!(
+        data.developer_sections,
+        vec![
+            DeveloperInstructions::new("original developer instructions").render_fragment(),
+            policy.into(),
+            capability.into(),
+        ]
+    );
+    assert_eq!(data.context_window_hints, vec![hint.text().to_string()]);
+    assert!(
+        data.developer_sections
+            .iter()
+            .all(|fragment| fragment.role() == "developer")
+    );
+}
+
+#[test]
+fn native_section_projection_preserves_ordinary_initial_fragments() {
+    // The original ordinary container is used only as a pure parity oracle;
+    // preparation invokes the concrete native renderers without a WorldState.
+    let model = ModelInstructionsState::new(
+        "selected-model",
+        Some("previous-model"),
+        "original model framing".into(),
+    );
+    let environments = EnvironmentsInstructionsState::new(/*enabled*/ true);
+    let mut ordinary = WorldState::default();
+    ordinary.add_section(model.clone());
+    ordinary.add_section(environments);
+    let expected = ordinary
+        .render_full()
+        .into_iter()
+        .map(|fragment| fragment.render_fragment())
+        .collect::<Vec<_>>();
+    let actual = [
+        ResolvedInitialSection::native(model),
+        ResolvedInitialSection::native(environments),
+    ]
+    .into_iter()
+    .flat_map(|section| {
+        section
+            .fragments
+            .into_iter()
+            .map(|fragment| fragment.rendered)
+    })
+    .collect::<Vec<_>>();
+    assert_eq!(actual, expected);
+}
