     pub(crate) fragments: Vec<ResolvedInitialFragment>,
 }
 
+impl ResolvedInitialSection {
+    /// Uses the SAME native section renderer as ordinary WorldState::render_full,
+    /// with its original initial (Absent) comparison. No synthetic WorldState.
+    pub(crate) fn native<S: crate::context::world_state::WorldStateSection>(section: S) -> Self {
+        Self {
+            id: S::ID,
+            origin: WorldStateSectionOrigin::Native,
+            fragments: section
+                .render_diff(crate::context::world_state::PreviousSectionState::Absent)
+                .map(|fragment| ResolvedInitialFragment {
+                    rendered: fragment.render_fragment(),
+                    start_marker: fragment.markers().0,
+                    requires_separate_message: fragment.requires_separate_message(),
+                })
+                .into_iter()
+                .collect(),
+        }
+    }
+}
