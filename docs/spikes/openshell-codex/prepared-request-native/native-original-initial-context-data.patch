+use codex_protocol::openai_models::ModelInfo;
+use codex_protocol::protocol::SessionSource;
+
+pub(crate) fn model_instructions(config: &Config, model: &ModelInfo) -> String {
+    let instructions = render_model_instructions(model);
+    if !config.update_plan_enabled
+        && config.model_catalog.is_none()
+        && (config.base_instructions.is_none()
+            || matches!(
+                config.base_instructions_provenance,
+                Some(BaseInstructionsProvenance::Model { .. })
+            ))
+    {
+        codex_prompts::without_update_plan_instructions(&instructions)
+    } else {
+        instructions
+    }
+}
+
+pub(crate) fn prompt_base_instructions(
+    config: &Config,
+    instructions: BaseInstructions,
+) -> BaseInstructions {
+    if !config.update_plan_enabled
+        && config.model_catalog.is_none()
+        && matches!(
+            instructions.provenance,
+            Some(BaseInstructionsProvenance::Model { .. })
+        )
+    {
+        BaseInstructions {
+            text: codex_prompts::without_update_plan_instructions(&instructions.text),
+            ..instructions
+        }
+    } else {
+        instructions
+    }
+}
+
+/// Original effective MCP policy projection, not feature-flag absence.
+/// Source acquisition and the final tool plan remain with their actual owners.
+pub(crate) fn execution_guidance(
+    config: &Config,
+    model: &ModelInfo,
+    mcp: &McpBinding,
+    apps_enabled: bool,
+) -> (
+    EnvironmentsInstructionsState,
+    AppsInstructionsState,
+    PluginsInstructionsState,
+) {
+    let apps_available = if config.include_apps_instructions && apps_enabled {
+        AppToolPolicyEvaluator::new(&config.config_layer_stack)
+            .apply_app_enabled_state(connectors::accessible_connectors_from_mcp_tools(
+                mcp.tools(),
+            ))
+            .into_iter()
+            .any(|connector| connector.is_accessible && connector.is_enabled)
+    } else {
+        false
+    };
+    (
+        EnvironmentsInstructionsState::new(
+            config.include_environment_context
+                && config.features.enabled(Feature::DeferredExecutor),
+        ),
+        AppsInstructionsState::new(apps_available && model.include_apps_usage_instructions),
+        PluginsInstructionsState::new(
+            mcp.plugins_available() && model.include_plugin_usage_instructions,
+        ),
+    )
+}
+
+pub(crate) fn managed_developer_section(
+    config: &Config,
+    source: &SessionSource,
+) -> Option<ManagedDeveloperInstructionsState> {
+    (!crate::guardian::is_basic_session_source(source)).then(|| {
+        ManagedDeveloperInstructionsState::new(
+            config
+                .config_layer_stack
+                .requirements()
+                .additional_developer_instructions
+                .as_ref(),
+        )
+    })
+}
+
+/// Slot application shared with ordinary initial context. ContextWindow data
+/// remains a hint partition; it must not become an ordinary developer fragment.
+#[derive(Default)]
+pub(crate) struct InitialDeveloperData {
+    pub(crate) developer_sections: Vec<RenderedFragment>,
+    pub(crate) context_window_hints: Vec<String>,
+}
+impl InitialDeveloperData {
+    pub(crate) fn new(source: &SessionSource, developer_instructions: Option<&str>) -> Self {
+        let mut data = Self::default();
+        if !crate::guardian::is_basic_session_source(source)
+            && let Some(instructions) = developer_instructions
+            && !instructions.is_empty()
+        {
+            data.developer_sections
+                .push(DeveloperInstructions::new(instructions).render_fragment());
+        }
+        data
+    }
+    pub(crate) fn push_thread_fragment(&mut self, fragment: PromptFragment) {
+        match fragment.slot() {
+            PromptSlot::ContextWindow => {
+                self.context_window_hints.push(fragment.text().to_string())
+            }
+            PromptSlot::DeveloperPolicy | PromptSlot::DeveloperCapabilities => {
+                self.developer_sections.push(fragment.into())
+            }
+        }
+    }
+}
