+use super::*;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+
+#[test]
+fn prepare_decoder_keeps_scope_selection_and_command_presence_distinct() {
+    let base = json!({"operationId":"op-data", "scope":"command", "ordinarySelection":{},
+        "capturedSourcePins":{"ordered":[2,1]}, "reviewedContextIdentity":{"review":"data"},
+        "command":{"ordinaryCommandId":"ordinary-data", "exactTurnInput":{"input":[],"serviceTier":null}},
+        "maxOutputTokens":128});
+    let decoded = RequestPrepareInput::decode(base.clone()).unwrap();
+    assert_eq!(decoded.operation_id, "op-data");
+    assert_eq!(decoded.ordinary_selection, ThreadStartParams::default());
+    assert_eq!(decoded.max_output_tokens, 128);
+    assert_eq!(decoded.captured_source_pins, json!({"ordered":[2,1]}));
+    assert_eq!(decoded.reviewed_context_identity, json!({"review":"data"}));
+    for mutate in [0, 1, 2, 3] {
+        let mut value = base.clone();
+        match mutate {
+            0 => {
+                value.as_object_mut().unwrap().remove("command");
+            }
+            1 => value["command"]["ordinaryCommandId"] = json!(""),
+            2 => value["scope"] = json!("review_context"),
+            3 => value["command"]["exactTurnInput"]["threadId"] = json!("forbidden-route"),
+            _ => unreachable!(),
+        }
+        assert!(RequestPrepareInput::decode(value).is_err());
+    }
+    let mut review = base;
+    review["scope"] = json!("review_context");
+    review.as_object_mut().unwrap().remove("command");
+    assert!(matches!(
+        RequestPrepareInput::decode(review).unwrap().scope,
+        InputScope::ReviewContext
+    ));
+}
