+//! Private request/prepare INPUT pipeline. No registered RPC, capability, public
+//! preparation response, Session, queue, count or Ready is supplied here.
+use super::*;
+use crate::config_manager::selected_start_config::{
+    OriginalFirstCommandStart, SelectedConfiguredStart,
+};
+
+#[derive(serde::Deserialize)]
+#[serde(rename_all = "snake_case")]
+enum InputScope {
+    ReviewContext,
+    Command,
+}
+#[derive(serde::Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct CommandInput {
+    ordinary_command_id: String,
+    exact_turn_input: OriginalTurnCommandBody,
+}
+#[derive(serde::Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub(super) struct RequestPrepareInput {
+    operation_id: String,
+    scope: InputScope,
+    ordinary_selection: ThreadStartParams,
+    captured_source_pins: serde_json::Value,
+    reviewed_context_identity: serde_json::Value,
+    command: Option<CommandInput>,
+    max_output_tokens: u64,
+}
+impl RequestPrepareInput {
+    fn decode(value: serde_json::Value) -> Result<Self, JSONRPCErrorError> {
+        let input: Self =
+            serde_json::from_value(value).map_err(|e| invalid_request(e.to_string()))?;
+        match (&input.scope, &input.command) {
+            (InputScope::Command, Some(command)) if !command.ordinary_command_id.is_empty() => {}
+            (InputScope::ReviewContext, None) => {}
+            _ => {
+                return Err(invalid_request(
+                    "command scope requires an ordinaryCommandId and exactTurnInput; review_context is commandless",
+                ));
+            }
+        }
+        Ok(input)
+    }
+}
+
+pub(super) enum RequestInputPreparation {
+    ReviewContext {
+        input: RequestPrepareInput,
+        client_info: AppServerClientInfo,
+        client_mcp_extensions: ClientMcpExtensions,
+        request_trace: Option<W3cTraceContext>,
+    },
+    Command {
+        operation_id: String,
+        captured_source_pins: serde_json::Value,
+        reviewed_context_identity: serde_json::Value,
+        max_output_tokens: u64,
+        experimental_raw_events: bool,
+        dynamic_tool_count: usize,
+        selected: SelectedConfiguredStart,
+    },
+}
+impl ThreadRequestProcessor {
+    /// Called by this processor's private preparation pipeline. Binding strings
+    /// remain DATA; actual initialized owners below supply native source custody.
+    pub(super) async fn prepare_request_input(
+        &self,
+        value: serde_json::Value,
+        client_info: AppServerClientInfo,
+        client_mcp_extensions: ClientMcpExtensions,
+        request_trace: Option<W3cTraceContext>,
+    ) -> Result<RequestInputPreparation, JSONRPCErrorError> {
+        let input = RequestPrepareInput::decode(value)?;
+        if matches!(&input.scope, InputScope::ReviewContext) {
+            return Ok(RequestInputPreparation::ReviewContext {
+                input,
+                client_info,
+                client_mcp_extensions,
+                request_trace,
+            });
+        }
+        let RequestPrepareInput {
+            operation_id,
+            scope: _,
+            ordinary_selection,
+            captured_source_pins,
+            reviewed_context_identity,
+            command,
+            max_output_tokens,
+        } = input;
+        let command = command.ok_or_else(|| invalid_request("command missing"))?;
+        let ThreadStartParams {
+            model,
+            model_provider,
+            allow_provider_model_fallback,
+            service_tier,
+            cwd,
+            runtime_workspace_roots,
+            approval_policy,
+            approvals_reviewer,
+            sandbox,
+            permissions,
+            config,
+            service_name,
+            base_instructions,
+            developer_instructions,
+            dynamic_tools,
+            selected_capability_roots,
+            mock_experimental_field: _,
+            experimental_raw_events,
+            personality,
+            multi_agent_mode: _,
+            ephemeral,
+            history_mode,
+            session_start_source,
+            thread_source,
+            project_id,
+            daybreak_enabled,
+            environments,
+        } = ordinary_selection;
+        if project_id.is_some() || daybreak_enabled.is_some() {
+            return Err(invalid_request(
+                "selected input requires unsupported project/daybreak metadata staging",
+            ));
+        }
+        if matches!(
+            history_mode,
+            Some(codex_app_server_protocol::ThreadHistoryMode::Paginated)
+        ) && !self.thread_store.supports_paginated_history_lists()
+        {
+            return Err(invalid_request(
+                "paginated threads require thread/turns/list and thread/items/list support",
+            ));
+        }
+        if sandbox.is_some() && permissions.is_some() {
+            return Err(invalid_request(
+                "`permissions` cannot be combined with `sandbox`",
+            ));
+        }
+        let roots = runtime_workspace_roots.map(resolve_runtime_workspace_roots);
+        let environments =
+            resolve_turn_environment_selections(self.thread_manager.as_ref(), environments)?;
+        let mut overrides = self.build_thread_config_overrides(
+            model,
+            model_provider,
+            service_tier,
+            cwd,
+            roots,
+            approval_policy,
+            approvals_reviewer,
+            sandbox,
+            permissions,
+            base_instructions,
+            developer_instructions,
+            personality,
+        );
+        overrides.ephemeral = ephemeral;
+        let source = self
+            .config_manager
+            .load_selected_start_config(config, overrides)
+            .await
+            .map_err(|e| config_load_error(&e))?;
+        let (dynamic_tool_count, options) =
+            first_command_options::OriginalFirstCommandOptions::prepare(
+                source.config().clone(),
+                self.thread_manager.as_ref(),
+                environments,
+                dynamic_tools,
+                history_mode.map(Into::into),
+                self.thread_store.as_ref(),
+                selected_capability_roots.unwrap_or_default(),
+            )?;
+        let options = options.finish(
+            allow_provider_model_fallback,
+            session_start_source,
+            thread_source.map(Into::into),
+            service_name,
+            request_trace.clone(),
+            client_mcp_extensions,
+        );
+        let original = OriginalFirstCommandStart::new(
+            options,
+            self.thread_manager.reserve_thread_start(),
+            Arc::clone(&self.installed),
+            client_info,
+        );
+        let mut selected = source
+            .capture_first_command(self.thread_manager.as_ref(), original)
+            .await
+            .map_err(|e| config_load_error(&e))?;
+        selected
+            .capture_startup(self.thread_manager.as_ref())
+            .await
+            .map_err(|e| config_load_error(&e))?;
+        selected
+            .capture_startup_api_mcp(self.thread_manager.as_ref())
+            .map_err(|e| config_load_error(&e))?;
+        selected
+            .capture_command(
+                self.thread_manager.as_ref(),
+                command.ordinary_command_id,
+                command.exact_turn_input,
+                request_trace,
+            )
+            .await?;
+        Ok(RequestInputPreparation::Command {
+            operation_id,
+            captured_source_pins,
+            reviewed_context_identity,
+            max_output_tokens,
+            experimental_raw_events,
+            dynamic_tool_count,
+            selected,
+        })
+    }
+}
+
