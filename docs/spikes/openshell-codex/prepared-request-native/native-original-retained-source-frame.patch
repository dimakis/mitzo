--- /dev/null
+++ b/codex-rs/core/src/thread_manager/selected_start_frame.rs
@@ -0,0 +1,170 @@
+//! Actual original getter-produced source-frame DATA custody, not authority.
+//! Minted only from the private original request/allocation owner. Process and
+//! loaded-parent snapshots are frozen values, not an environment/source lease.
+use super::*;
+use crate::session::source_frame;
+use std::io;
+
+pub(crate) struct CapturedSelectedStartFrame {
+    owner: Arc<ThreadManagerState>,
+    extensions: Arc<ExtensionRegistry<Config>>,
+    mcp: Arc<McpManager>,
+    source: SessionSource,
+    raw_parent: Option<ThreadId>,
+    raw_fork: Option<ThreadId>,
+    raw_parent_originator: Option<String>,
+    metrics: Option<String>,
+    ephemeral: bool,
+    parent: Option<ThreadId>,
+    originator: String,
+    session_source: SessionSource,
+    fork_cache_key: Option<String>,
+}
+
+pub(crate) struct InheritedSessionSourceFrame {
+    source: SessionSource,
+    originator: String,
+    parent: Option<ThreadId>,
+    ephemeral: bool,
+    fork_cache_key: Option<String>,
+}
+
+impl ThreadManagerState {
+    pub(super) async fn capture_selected_source_frame(
+        self: &Arc<Self>,
+        request: &ThreadSpawnRequest,
+    ) -> io::Result<CapturedSelectedStartFrame> {
+        let options = &request.options;
+        let source = options
+            .session_source
+            .as_ref()
+            .ok_or_else(|| io::Error::other("original start source was not resolved"))?;
+        if !matches!(options.initial_history, InitialHistory::New)
+            || options.internal_parent.is_some()
+            || options.inherited_environments.is_some()
+        {
+            return Err(io::Error::other(
+                "selected source frame requires original fresh inputs",
+            ));
+        }
+        let parent = source_frame::spawn_parent_thread_id(
+            request.parent_thread_id,
+            &options.initial_history,
+            source,
+        );
+        // SAME real getter and fallback semantics as ordinary spawn. It may
+        // initialize the EXISTING process originator owner; no new publisher,
+        // model/lifecycle callback, inference or environment mutation is added.
+        let originator = self
+            .effective_originator(
+                &options.initial_history,
+                options.metrics_service_name.as_deref(),
+                source,
+                parent,
+                request.forked_from_thread_id,
+                request.parent_originator.clone(),
+            )
+            .await;
+        let session_source = source_frame::session_source_for_spawn(source.clone());
+        let fork_cache_key = source_frame::fork_prompt_cache_key(
+            &options.initial_history,
+            options.config.ephemeral,
+            &session_source,
+        );
+        Ok(CapturedSelectedStartFrame {
+            owner: Arc::clone(self),
+            extensions: Arc::clone(&self.extensions),
+            mcp: Arc::clone(&self.mcp_manager),
+            source: source.clone(),
+            raw_parent: request.parent_thread_id,
+            raw_fork: request.forked_from_thread_id,
+            raw_parent_originator: request.parent_originator.clone(),
+            metrics: options.metrics_service_name.clone(),
+            ephemeral: options.config.ephemeral,
+            parent,
+            originator,
+            session_source,
+            fork_cache_key,
+        })
+    }
+}
+impl CapturedSelectedStartFrame {
+    pub(super) fn validate_options(&self, options: &StartThreadOptions) -> io::Result<()> {
+        if options.session_source.as_ref() != Some(&self.source)
+            || !matches!(options.initial_history, InitialHistory::New)
+            || options.internal_parent.is_some()
+            || options.inherited_environments.is_some()
+            || options.metrics_service_name != self.metrics
+            || options.config.ephemeral != self.ephemeral
+        {
+            return Err(io::Error::other("retained original source inputs changed"));
+        }
+        Ok(())
+    }
+    pub(super) fn validate_request(
+        &self,
+        manager: &ThreadManagerState,
+        request: &ThreadSpawnRequest,
+    ) -> io::Result<()> {
+        self.validate_options(&request.options)?;
+        if !std::ptr::eq(self.owner.as_ref(), manager)
+            || !Arc::ptr_eq(&self.extensions, &manager.extensions)
+            || !Arc::ptr_eq(&self.mcp, &manager.mcp_manager)
+            || self.raw_parent != request.parent_thread_id
+            || self.raw_fork != request.forked_from_thread_id
+            || self.raw_parent_originator != request.parent_originator
+        {
+            return Err(io::Error::other(
+                "retained original source request owner changed",
+            ));
+        }
+        Ok(())
+    }
+    pub(super) fn source(&self) -> &SessionSource {
+        &self.source
+    }
+    pub(super) fn parent(&self) -> Option<ThreadId> {
+        self.parent
+    }
+    pub(super) fn adopt(self) -> (String, InheritedSessionSourceFrame) {
+        let session = InheritedSessionSourceFrame {
+            source: self.session_source,
+            originator: self.originator.clone(),
+            parent: self.parent,
+            ephemeral: self.ephemeral,
+            fork_cache_key: self.fork_cache_key,
+        };
+        (self.originator, session)
+    }
+}
+impl InheritedSessionSourceFrame {
+    pub(crate) fn source(&self) -> &SessionSource {
+        &self.source
+    }
+    pub(crate) fn parent(&self) -> Option<ThreadId> {
+        self.parent
+    }
+    pub(crate) fn validate(
+        &self,
+        source: &SessionSource,
+        originator: &str,
+        parent: Option<ThreadId>,
+        history: &InitialHistory,
+        ephemeral: bool,
+    ) -> io::Result<()> {
+        if source != &self.source
+            || originator != self.originator.as_str()
+            || parent != self.parent
+            || !matches!(history, InitialHistory::New)
+            || ephemeral != self.ephemeral
+        {
+            return Err(io::Error::other(
+                "ordinary startup changed retained source data",
+            ));
+        }
+        Ok(())
+    }
+    pub(crate) fn into_fork_cache_key(self) -> Option<String> {
+        self.fork_cache_key
+    }
+}
