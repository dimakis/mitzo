+                "changed-after-capture",
+                parent,
+                &request.options.initial_history,
+                request.options.config.ephemeral,
+            )
+            .is_err()
+    );
+    inputs
+        .session_frame()
+        .unwrap()
+        .validate(
+            &session_source,
+            &originator,
+            parent,
+            &request.options.initial_history,
+            request.options.config.ephemeral,
