+#[tokio::test]
+async fn retained_original_request_getter_data_is_moved_once_without_session_start() {
+    let (_home, config, manager) = fixture().await;
+    let mut options = StartThreadOptions::new(config);
+    options.metrics_service_name = Some(" CODEX_WORK_WEB ".to_string());
+    let mut events = manager.subscribe_thread_created();
+    let mut selected = manager.prepare_selected_start(options).await.unwrap();
+    let adoption = manager.adopt_selected_start(&mut selected).unwrap();
+    assert!(manager.adopt_selected_start(&mut selected).is_err());
+    let (control, mut inputs) = adoption.allocation.into_parts();
+    let frame = inputs.take_source_frame().unwrap();
+    assert!(inputs.take_source_frame().is_none());
+    let mut request = ThreadSpawnRequest::new(
+        adoption.options,
+        Arc::clone(&manager.state.auth_manager),
+        control,
+    );
+    frame
+        .validate_request(manager.state.as_ref(), &request)
+        .unwrap();
+    let (_foreign_home, _foreign_config, foreign) = fixture().await;
+    assert!(
+        frame
+            .validate_request(foreign.state.as_ref(), &request)
+            .is_err()
+    );
+    let original_metrics = request.options.metrics_service_name.clone();
+    request.options.metrics_service_name = Some("different".to_string());
+    assert!(
+        frame
+            .validate_request(manager.state.as_ref(), &request)
+            .is_err()
+    );
+    request.options.metrics_service_name = original_metrics;
+    let original_source = request.options.session_source.clone();
+    request.options.session_source = Some(SessionSource::Custom("changed".to_string()));
+    assert!(
+        frame
+            .validate_request(manager.state.as_ref(), &request)
+            .is_err()
+    );
+    request.options.session_source = original_source;
+    request.options.initial_history = InitialHistory::Cleared;
+    assert!(
+        frame
+            .validate_request(manager.state.as_ref(), &request)
+            .is_err()
+    );
+    request.options.initial_history = InitialHistory::New;
+    request.options.config.ephemeral = !request.options.config.ephemeral;
+    assert!(
+        frame
+            .validate_request(manager.state.as_ref(), &request)
+            .is_err()
+    );
+    request.options.config.ephemeral = !request.options.config.ephemeral;
+    request.parent_thread_id = Some(ThreadId::new());
+    assert!(
+        frame
+            .validate_request(manager.state.as_ref(), &request)
+            .is_err()
+    );
+    request.parent_thread_id = None;
+    frame
+        .validate_request(manager.state.as_ref(), &request)
+        .unwrap();
+    let source = frame.source().clone();
+    let parent = frame.parent();
+    let (originator, session) = frame.adopt();
+    assert_eq!(originator, "codex_work_web");
+    inputs.install_session_frame(session).unwrap();
+    let session_source = crate::session::source_frame::session_source_for_spawn(source);
+    // A later ordinary configuration cannot overwrite the retained getter data.
+    assert!(
+        inputs
+            .session_frame()
+            .unwrap()
+            .validate(
