+++ b/codex-rs/core/src/tools/spec_plan/model_exposure.rs
@@ -0,0 +1,88 @@
+//! Shared ordinary exposure/model-spec transformation over resolved inputs.
+//! Provider namespace eligibility and final registry ownership stay with the
+//! enclosing ordinary planner. No Session/TurnContext or provider callback is
+//! needed here; mode/config values do not attest source or execution authority.
+
+use crate::config::Config;
+use crate::tools::registry::ToolExposure;
+use crate::tools::registry::ToolRegistry;
+use codex_protocol::openai_models::ToolMode;
+use codex_tools::ToolName;
+use codex_tools::ToolSpec;
+use std::collections::BTreeMap;
+
+pub(super) fn apply_direct_model_only_namespace_overrides(
+    config: &Config,
+    registry: &mut ToolRegistry,
+) {
+    if config.code_mode.direct_only_tool_namespaces.is_empty() {
+        return;
+    }
+
+    for tool in registry.entries_mut() {
+        let configured = tool
+            .runtime
+            .tool_name()
+            .with_default_namespace()
+            .namespace
+            .as_ref()
+            .is_some_and(|namespace| {
+                config
+                    .code_mode
+                    .direct_only_tool_namespaces
+                    .contains(namespace)
+            });
+        if configured && tool.exposure.is_available_in_code_mode() {
+            tool.exposure = ToolExposure::DirectModelOnly;
+        }
+    }
+}
+
+pub(super) fn spec_for_model_request(
+    config: &Config,
+    tool_mode: ToolMode,
+    exposure: ToolExposure,
+    tool_name: &ToolName,
+    code_mode_tool_names: &BTreeMap<String, ToolName>,
+    spec: ToolSpec,
+) -> ToolSpec {
+    if matches!(tool_mode, ToolMode::CodeMode | ToolMode::CodeModeOnly)
+        && exposure.is_available_in_code_mode()
+        && !is_excluded_from_code_mode(config, tool_name)
+        && codex_code_mode::is_code_mode_nested_tool(spec.name())
+        && code_mode_tool_names
+            .get(&codex_code_mode::normalize_code_mode_identifier(
+                &codex_tools::code_mode_name_for_tool_name(tool_name),
+            ))
+            .is_some_and(|winner| winner == tool_name)
+    {
+        codex_tools::augment_tool_spec_for_code_mode(
+            spec,
+            config.code_mode.tool_input_schema_max_bytes,
+        )
+    } else {
+        spec
+    }
+}
+
+pub(super) fn is_hidden_by_code_mode_only(
+    tool_mode: ToolMode,
+    tool_name: &ToolName,
+    exposure: ToolExposure,
+) -> bool {
+    tool_mode == ToolMode::CodeModeOnly
+        && exposure.is_available_in_code_mode()
+        && codex_code_mode::is_code_mode_nested_tool(&codex_tools::code_mode_name_for_tool_name(
+            tool_name,
+        ))
+}
+
+pub(super) fn is_excluded_from_code_mode(config: &Config, tool_name: &ToolName) -> bool {
+    let tool_name = tool_name.clone().with_default_namespace();
+    tool_name.namespace.as_ref().is_some_and(|namespace| {
+        config
+            .code_mode
+            .excluded_tool_namespaces
+            .contains(namespace)
+    })
+}
