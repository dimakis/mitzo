+// These fixtures exercise native TLS fallback, irrespective of ambient custom
+// CA configuration (which intentionally selects rustls in production).
+fn install_native_tls_fixture_client(pool: &RouteAwareClientPool) {
+    let client = TransportClient::new(
+        reqwest::Client::builder()
+            .use_native_tls()
+            .no_proxy()
+            .redirect(reqwest::redirect::Policy::none())
+            .build()
+            .expect("native TLS fixture client should build"),
+        RequestLogging::Enabled,
+        http::HeaderMap::new(),
+    );
+    pool.clients
+        .lock()
+        .expect("fixture client cache should be available")
+        .insert(OutboundProxyRoute::Direct, client);
+}
