+#[tokio::test]
+async fn protocol_wrapping_preserves_controls_recovery_and_legacy_turn_input() {
+    use super::super::submission::SubmissionOp;
+    for operation in [
+        Op::Interrupt,
+        Op::Shutdown,
+        Op::RunUserShellCommand {
+            command: "opaque shell bytes\n".into(),
+            timeout_ms: Some(17),
+        },
+    ] {
+        let kind = operation.kind();
+        let debug = format!("{operation:?}");
+        let wrapped: SubmissionOp = operation.into();
+        assert_eq!(wrapped.kind(), kind);
+        assert_eq!(format!("{wrapped:?}"), debug);
+        let recovered = wrapped.into_protocol_for_test();
+        assert_eq!(recovered.kind(), kind);
+        assert_eq!(format!("{recovered:?}"), debug);
+    }
+    let (reply, waiter) = oneshot::channel();
+    let original = request(inputs().remove(1), /*trace*/ None);
+    let expected = project(original.clone());
+    let operation: SubmissionOp = Op::TurnInput {
+        request: Box::new(original),
+        mode: TurnInputMode::StartIfIdle,
+        reply,
+    }
+    .into();
+    let (tx, rx) = async_channel::bounded::<Submission>(1);
+    tx.send(Submission {
+        id: new_submission_id(),
+        op: operation,
+        trace: None,
+        parent_turn_id: None,
+        root_turn_id: None,
+        residency_guard: None,
+    })
+    .await
+    .unwrap();
+    let received = rx.recv().await.unwrap();
+    let SubmissionOp::Protocol(Op::TurnInput {
+        request,
+        mode,
+        reply,
+    }) = received.op
+    else {
+        panic!("legacy path stays protocol")
+    };
+    assert_eq!(mode, TurnInputMode::StartIfIdle);
+    assert_eq!(project(*request), expected);
+    reply
+        .send(Ok(TurnInputSubmission::NotSubmitted {
+            reason: NotSubmittedReason::NotIdle,
+        }))
+        .unwrap();
+    assert_eq!(
+        waiter.await.unwrap().unwrap(),
+        TurnInputSubmission::NotSubmitted {
+            reason: NotSubmittedReason::NotIdle
+        }
+    );
+
+    let original = request(inputs().remove(0), /*trace*/ None);
+    let expected = project(original.clone());
+    let (reply, waiter) = oneshot::channel();
+    let wrapped: SubmissionOp = Op::RecoverTurn {
+        thread_settings: original.thread_settings,
+        start_options: original.start,
+        reply,
+    }
+    .into();
+    let SubmissionOp::Protocol(Op::RecoverTurn {
+        thread_settings,
+        start_options,
+        reply,
+    }) = wrapped
+    else {
+        panic!("recovery stays protocol")
+    };
+    let mut recovered = request(inputs().remove(0), /*trace*/ None);
+    recovered.thread_settings = thread_settings;
+    recovered.start = start_options;
+    assert_eq!(project(recovered), expected);
+    reply.send(Err(CodexErr::InternalAgentDied)).unwrap();
+    assert!(matches!(
+        waiter.await.unwrap().unwrap_err().details(),
+        CodexErrorDetails::InternalAgentDied
+    ));
+}
