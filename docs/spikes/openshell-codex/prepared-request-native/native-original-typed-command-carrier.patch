+/// Move-only original request/mode/reply custody. Only the original envelope
+/// constructor makes one; production consumes it at the actual handler, never into Op.
+pub(crate) struct OriginalTurnInputCommand {
+    request: Box<TurnInputRequest>,
+    mode: TurnInputMode,
+    reply: oneshot::Sender<CodexResult<TurnInputSubmission>>,
+}
+impl OriginalTurnInputCommand {
+    pub(super) async fn handle(self, sess: &Arc<super::session::Session>, sub_id: String) {
+        let Self {
+            request,
+            mode,
+            reply,
+        } = self;
+        let result = super::turn_input::handle(sess, *request, mode, sub_id).await;
+        let _ = reply.send(result);
+    }
+}
+impl std::fmt::Debug for OriginalTurnInputCommand {
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        // Match the existing Op::TurnInput Debug field names and ordering.
+        formatter
+            .debug_struct("TurnInput")
+            .field("request", &self.request)
+            .field("mode", &self.mode)
+            .field("reply", &self.reply)
+            .finish()
+    }
+}
