+#[tokio::test]
+async fn dropping_queued_typed_command_closes_original_waiter_without_replay() {
+    let (submission, waiter) = OriginalTurnInputSubmission::capture(
+        request(inputs().remove(0), /*trace*/ None),
+        TurnInputMode::StartIfIdle,
+    )
+    .into_submission();
+    let (tx, rx) = async_channel::bounded::<Submission>(1);
+    tx.send(submission).await.unwrap();
+    drop(tx);
+    drop(rx);
+    let error = waiter
+        .await
+        .unwrap_or(Err(CodexErr::InternalAgentDied))
+        .unwrap_err();
+    assert!(matches!(
+        error.details(),
+        CodexErrorDetails::InternalAgentDied
+    ));
