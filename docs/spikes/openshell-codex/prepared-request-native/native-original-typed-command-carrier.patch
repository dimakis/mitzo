+#[tokio::test]
+async fn same_opaque_command_and_complete_request_cross_actual_core_channel_once() {
+    use super::super::submission::SubmissionOp;
+    for mode in [
+        TurnInputMode::StartOrSteer,
+        TurnInputMode::StartIfIdle,
+        TurnInputMode::ContinueIfIdle {
+            expected_previous_turn_id: "previous".into(),
+        },
+        TurnInputMode::Steer {
+            expected_turn_id: "active".into(),
+        },
+    ] {
+        for input in inputs() {
+            let original = request(
+                input,
+                Some(W3cTraceContext {
+                    traceparent: Some(
+                        "00-00000000000000000000000000000001-0000000000000001-01".into(),
+                    ),
+                    tracestate: Some("owner=original".into()),
+                }),
+            );
+            let mut expected = original.clone();
+            expected.trace = None;
+            let (mut submission, waiter) =
+                OriginalTurnInputSubmission::capture(original, mode.clone()).into_submission();
+            let id = submission.id.clone();
+            let trace = submission.trace.clone();
+            let SubmissionOp::TurnInput(command) = &submission.op else {
+                panic!("typed producer")
+            };
+            let box_storage = command.request.as_ref() as *const TurnInputRequest;
+            let input_bytes = input_storage(&command.request.input);
+            assert_eq!(submission.op.kind(), "turn_input");
+            // Original queue metadata/residency travels with the same Submission.
+            let residency = Arc::new(tokio::sync::RwLock::new(()));
+            submission.residency_guard = Some(Arc::clone(&residency).read_owned().await);
+            submission.parent_turn_id = Some("queue-parent".into());
+            submission.root_turn_id = Some("queue-root".into());
+            let (tx, rx) = async_channel::bounded::<Submission>(1);
+            tx.send(submission).await.unwrap();
+            let received = rx.recv().await.unwrap();
+            assert!(rx.try_recv().is_err());
+            assert_eq!((&received.id, &received.trace), (&id, &trace));
+            assert_eq!(
+                (
+                    received.parent_turn_id.as_deref(),
+                    received.root_turn_id.as_deref()
+                ),
+                (Some("queue-parent"), Some("queue-root"))
+            );
+            assert!(residency.try_write().is_err());
+            let SubmissionOp::TurnInput(command) = received.op else {
+                panic!("typed queue carrier")
+            };
+            assert_eq!(
+                command.request.as_ref() as *const TurnInputRequest,
+                box_storage
+            );
+            assert_eq!(input_storage(&command.request.input), input_bytes);
+            let OriginalTurnInputCommand {
+                request,
+                mode: actual_mode,
+                reply,
+            } = command;
+            assert_eq!(actual_mode, mode);
+            assert_eq!(project(*request), project(expected));
+            drop(received.residency_guard);
+            assert!(residency.try_write().is_ok());
+            let result = TurnInputSubmission::Started { turn_id: id };
+            reply.send(Ok(result.clone())).unwrap();
+            assert_eq!(waiter.await.unwrap().unwrap(), result);
+        }
+    }
+}
