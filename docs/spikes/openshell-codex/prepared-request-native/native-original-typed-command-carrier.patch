+// Test-only exact adapter preserves every old protocol-op assertion; production
+// never flattens a typed command into Op or reconstructs an opaque owner.
+impl super::super::submission::SubmissionOp {
+    pub(crate) fn into_protocol_for_test(self) -> Op {
+        match self {
+            Self::Protocol(op) => op,
+            Self::TurnInput(command) => {
+                let OriginalTurnInputCommand {
+                    request,
+                    mode,
+                    reply,
+                } = command;
+                Op::TurnInput {
+                    request,
+                    mode,
+                    reply,
+                }
+            }
+        }
+    }
+}
