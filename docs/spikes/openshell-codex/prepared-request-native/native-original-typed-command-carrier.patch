@@ -8,7 +8,7 @@ use tokio::sync::OwnedRwLockReadGuard;
 #[expect(dead_code, reason = "Turn ancestry is retained in Debug diagnostics.")]
 pub(crate) struct Submission {
     pub id: String,
-    pub op: Op,
+    pub op: SubmissionOp,
     /// Optional W3C trace carrier propagated across async submission handoffs.
     pub trace: Option<W3cTraceContext>,
     pub parent_turn_id: Option<String>,
@@ -16,3 +16,32 @@ pub(crate) struct Submission {
     /// Keeps a V2 recipient resident until this submission is handled or dropped.
     pub residency_guard: Option<OwnedRwLockReadGuard<()>>,
 }
+
+/// Private Core queue operation. Public protocol operations retain their exact
+/// payload; ordinary turn input keeps its move-only original command until its handler.
+pub(crate) enum SubmissionOp {
+    Protocol(Op),
+    TurnInput(super::turn_input_submission::OriginalTurnInputCommand),
+}
+impl From<Op> for SubmissionOp {
+    fn from(op: Op) -> Self {
+        Self::Protocol(op)
+    }
+}
+impl SubmissionOp {
+    pub(crate) fn kind(&self) -> &'static str {
+        match self {
+            Self::Protocol(op) => op.kind(),
+            // Exact existing protocol Op::TurnInput kind, not a new kind/schema.
+            Self::TurnInput(_) => "turn_input",
+        }
+    }
+}
+impl std::fmt::Debug for SubmissionOp {
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            Self::Protocol(op) => std::fmt::Debug::fmt(op, formatter),
+            Self::TurnInput(command) => std::fmt::Debug::fmt(command, formatter),
+        }
+    }
+}
