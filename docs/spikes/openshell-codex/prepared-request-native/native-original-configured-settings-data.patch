+//! Original baseline DATA in ordinary startup evaluation stages. No Session,
+//! provider, first-command apply, currentness or preparation grant is produced.
+use super::*;
+
+pub(super) struct OriginalConfiguredHistoryData {
+    dynamic_tools: Vec<DynamicToolSpec>,
+    disabled_plugin_ids: Vec<String>,
+    collaboration_mode: CollaborationMode,
+}
+
+pub(super) struct ConfiguredSettingsParts<'a> {
+    pub(super) dynamic_tools: Vec<DynamicToolSpec>,
+    pub(super) disabled_plugin_ids: Vec<String>,
+    pub(super) step: ConfiguredStepData<'a>,
+}
+
+/// Config is borrowed until the ordinary step_settings field is evaluated,
+/// after the original provider field. No Config values are eagerly projected.
+pub(super) struct ConfiguredStepData<'a> {
+    config: &'a Config,
+    collaboration_mode: CollaborationMode,
+    service_tier: Option<String>,
+}
+
+impl OriginalConfiguredHistoryData {
+    pub(super) fn capture(
+        config: &Config,
+        model: &str,
+        conversation_history: &InitialHistory,
+        dynamic_tools: Vec<DynamicToolSpec>,
+        disabled_plugin_ids: Option<Vec<String>>,
+        forked_from_thread_id: Option<ThreadId>,
+    ) -> Self {
+        // Dynamic tools are defined at thread start and persisted in rollout session metadata.
+        let dynamic_tools = if dynamic_tools.is_empty() {
+            conversation_history.get_dynamic_tools().unwrap_or_default()
+        } else {
+            dynamic_tools
+        };
+        let disabled_plugin_ids = disabled_plugin_ids.unwrap_or_else(|| {
+            let settings_owner = match conversation_history {
+                InitialHistory::Resumed(resumed) => Some(resumed.conversation_id),
+                InitialHistory::Forked(_) => forked_from_thread_id,
+                InitialHistory::New | InitialHistory::Cleared => None,
+            };
+            settings_owner
+                .and_then(|thread_id| {
+                    codex_history::latest_disabled_plugin_ids(
+                        conversation_history.get_rollout_items(),
+                        thread_id,
+                    )
+                })
+                .map(<[String]>::to_vec)
+                .unwrap_or_default()
+        });
+        // TODO (aibrahim): Consolidate config.model and config.model_reasoning_effort into config.collaboration_mode
+        // to avoid extracting these fields separately and constructing CollaborationMode here.
+        let persisted_collaboration_mode = match conversation_history {
+            InitialHistory::Resumed(resumed) => resumed
+                .history
+                .iter()
+                .rev()
+                .find_map(|item| match item {
+                    RolloutItem::EventMsg(EventMsg::ThreadSettingsApplied(event))
+                        if event.thread_id == Some(resumed.conversation_id) =>
+                    {
+                        Some(&event.thread_settings.collaboration_mode)
+                    }
+                    _ => None,
+                })
+                .or_else(|| {
+                    resumed
+                        .history
+                        .iter()
+                        .rev()
+                        .find_map(|item| match item {
+                            RolloutItem::TurnContext(context) => {
+                                Some(context.collaboration_mode.as_ref())
+                            }
+                            _ => None,
+                        })
+                        .flatten()
+                }),
+            InitialHistory::New | InitialHistory::Cleared | InitialHistory::Forked(_) => None,
+        };
+        let collaboration_mode = CollaborationMode {
+            mode: ModeKind::Default,
+            settings: Settings {
+                model: model.to_string(),
+                reasoning_effort: config.model_reasoning_effort.clone(),
+                developer_instructions: None,
+            },
+        };
+        let collaboration_mode = persisted_collaboration_mode.map_or(collaboration_mode, |saved| {
+            saved.with_updates(
+                Some(model.to_string()),
+                Some(config.model_reasoning_effort.clone()),
+                /*developer_instructions*/ None,
+            )
+        });
+        Self {
+            dynamic_tools,
+            disabled_plugin_ids,
+            collaboration_mode,
+        }
+    }
+
+    /// Called at the ORIGINAL service-tier expression, after warning selection.
+    pub(super) fn resolve_service_tier<'a>(
+        self,
+        config: &'a Config,
+        fast_mode_enabled: bool,
+        model_info: &ModelInfo,
+    ) -> ConfiguredSettingsParts<'a> {
+        let service_tier =
+            get_service_tier(config.service_tier.clone(), fast_mode_enabled, model_info);
+        ConfiguredSettingsParts {
+            dynamic_tools: self.dynamic_tools,
+            disabled_plugin_ids: self.disabled_plugin_ids,
+            step: ConfiguredStepData {
+                config,
+                collaboration_mode: self.collaboration_mode,
+                service_tier,
+            },
+        }
+    }
+}
+
+impl ConfiguredStepData<'_> {
+    pub(super) fn into_settings(self) -> Arc<StepSettings> {
+        let config = self.config;
+        let collaboration_mode = self.collaboration_mode;
+        let service_tier = self.service_tier;
+        Arc::new(StepSettings {
+            collaboration_mode,
+            reasoning_summary: config.model_reasoning_summary,
+            service_tier,
+            personality: config.personality,
+            approval_policy: config.permissions.approval_policy.clone(),
+            approvals_reviewer: config.approvals_reviewer,
+        })
+    }
+}
+
+/// Borrowed original inputs only. Each projection is evaluated at its existing
+/// field position; this view is neither a materialized readiness snapshot nor
+/// a lease. All other SessionConfiguration fields retain their original source.
+pub(super) struct ConfiguredPermissionEnvironmentData<'a> {
+    config: &'a Config,
+    selections: &'a [codex_protocol::protocol::TurnEnvironmentSelection],
+}
+impl<'a> ConfiguredPermissionEnvironmentData<'a> {
+    pub(super) fn new(
+        config: &'a Config,
+        selections: &'a [codex_protocol::protocol::TurnEnvironmentSelection],
+    ) -> Self {
+        Self { config, selections }
+    }
+    pub(super) fn environment_selections(
+        &self,
+    ) -> Vec<codex_protocol::protocol::TurnEnvironmentSelection> {
+        self.selections.to_vec()
+    }
+    pub(super) fn permission_profile_state(&self) -> CodexResult<PermissionProfileState> {
+        // Keep the original FALLIBLE owner helper at the later permission field,
+        // never at baseline creation or before provider/step/environment fields.
+        session_permission_profile_state_from_config(self.config)
+    }
+}
+
