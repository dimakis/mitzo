new file mode 100644
index 0000000..c2822e1
--- /dev/null
+++ b/codex-rs/state/migrations/0061_prepared_request_sampling.sql
@@ -0,0 +1,86 @@
+-- Existing rows keep their command-wide tombstones. Only explicitly identified
+-- sampling chains may continue, and no migration grants historical chain rights.
+ALTER TABLE prepared_requests ADD COLUMN native_turn_owner_preparation_id TEXT
+REFERENCES prepared_requests(preparation_id)
+CHECK (native_turn_owner_preparation_id IS NULL OR
+    (consumed = 1 AND native_thread_id IS NULL AND native_turn_id IS NULL
+        AND json_extract(binding_json, '$.sampling.previous_preparation_id') IS NOT NULL));
+
+DROP INDEX prepared_requests_consumed_command;
+CREATE UNIQUE INDEX prepared_requests_consumed_command_root
+ON prepared_requests (
+    json_extract(binding_json, '$.application_scope_id'),
+    json_extract(binding_json, '$.command_id')
+) WHERE consumed = 1 AND json_extract(binding_json, '$.sampling.previous_preparation_id') IS NULL;
+
+CREATE UNIQUE INDEX prepared_requests_consumed_sampling
+ON prepared_requests (
+    json_extract(binding_json, '$.application_scope_id'),
+    json_extract(binding_json, '$.command_id'),
+    json_extract(binding_json, '$.sampling.sampling_id')
+) WHERE consumed = 1 AND json_extract(binding_json, '$.sampling.sampling_id') IS NOT NULL;
+
+CREATE UNIQUE INDEX prepared_requests_consumed_successor
+ON prepared_requests (json_extract(binding_json, '$.sampling.previous_preparation_id'))
+WHERE consumed = 1 AND json_extract(binding_json, '$.sampling.previous_preparation_id') IS NOT NULL;
+
+-- A predecessor acknowledgement and acceptance remain distinct observations;
+-- neither establishes completion, current source authority or tool execution.
+CREATE TRIGGER prepared_requests_sampling_predecessor
+BEFORE UPDATE OF consumed ON prepared_requests
+WHEN OLD.consumed = 0 AND NEW.consumed = 1
+    AND json_extract(NEW.binding_json, '$.sampling.previous_preparation_id') IS NOT NULL
+    AND NOT EXISTS (
+        SELECT 1 FROM prepared_requests previous
+        WHERE previous.preparation_id = json_extract(NEW.binding_json, '$.sampling.previous_preparation_id')
+            AND previous.preparation_id != NEW.preparation_id
+            AND previous.consumed = 1 AND previous.attempt_state = 'committed'
+            AND previous.provider_response_id IS NOT NULL
+            AND (previous.native_turn_id IS NOT NULL OR previous.native_turn_owner_preparation_id IS NOT NULL)
+            AND json_type(previous.binding_json, '$.sampling.sampling_id') = 'text'
+            AND json_type(NEW.binding_json, '$.sampling.sampling_id') = 'text'
+            AND json_extract(previous.binding_json, '$.application_scope_id') = json_extract(NEW.binding_json, '$.application_scope_id')
+            AND json_extract(previous.binding_json, '$.command_id') = json_extract(NEW.binding_json, '$.command_id')
+            AND json_extract(previous.binding_json, '$.account_id') = json_extract(NEW.binding_json, '$.account_id')
+            AND json_extract(previous.binding_json, '$.route_revision') = json_extract(NEW.binding_json, '$.route_revision')
+            AND json_extract(previous.binding_json, '$.runtime_revision') = json_extract(NEW.binding_json, '$.runtime_revision')
+            AND json_extract(previous.binding_json, '$.settings_revision') = json_extract(NEW.binding_json, '$.settings_revision')
+            AND previous.model = NEW.model
+    )
+BEGIN
+    SELECT RAISE(ABORT, 'sampling predecessor is unavailable or conflicts');
+END;
+
+-- The original unique native thread/turn receipt stays on the root request.
+-- A continuation can only reference that original owner, never copy its receipt.
+CREATE TRIGGER prepared_requests_continuation_native_receipt
+BEFORE UPDATE OF native_thread_id, native_turn_id ON prepared_requests
+WHEN json_extract(NEW.binding_json, '$.sampling.previous_preparation_id') IS NOT NULL
+    AND (NEW.native_thread_id IS NOT NULL OR NEW.native_turn_id IS NOT NULL)
+BEGIN
+    SELECT RAISE(ABORT, 'continuation must retain the original native turn owner');
+END;
+
+CREATE TRIGGER prepared_requests_native_turn_owner
+BEFORE UPDATE OF native_turn_owner_preparation_id ON prepared_requests
+WHEN (OLD.native_turn_owner_preparation_id IS NOT NULL
+        AND NEW.native_turn_owner_preparation_id IS NOT OLD.native_turn_owner_preparation_id)
+    OR (NEW.native_turn_owner_preparation_id IS NOT NULL AND NOT EXISTS (
+        SELECT 1 FROM prepared_requests previous
+        JOIN prepared_requests root ON root.preparation_id = NEW.native_turn_owner_preparation_id
+        WHERE previous.preparation_id = json_extract(NEW.binding_json, '$.sampling.previous_preparation_id')
+            AND COALESCE(previous.native_turn_owner_preparation_id,
+                CASE WHEN previous.native_turn_id IS NOT NULL THEN previous.preparation_id END) = root.preparation_id
+            AND root.native_turn_id IS NOT NULL AND root.native_turn_owner_preparation_id IS NULL
+            AND json_extract(root.binding_json, '$.sampling.previous_preparation_id') IS NULL
+            AND json_extract(root.binding_json, '$.application_scope_id') = json_extract(NEW.binding_json, '$.application_scope_id')
+            AND json_extract(root.binding_json, '$.command_id') = json_extract(NEW.binding_json, '$.command_id')
+            AND json_extract(root.binding_json, '$.account_id') = json_extract(NEW.binding_json, '$.account_id')
+            AND json_extract(root.binding_json, '$.route_revision') = json_extract(NEW.binding_json, '$.route_revision')
+            AND json_extract(root.binding_json, '$.runtime_revision') = json_extract(NEW.binding_json, '$.runtime_revision')
+            AND json_extract(root.binding_json, '$.settings_revision') = json_extract(NEW.binding_json, '$.settings_revision')
+            AND root.model = NEW.model
+    ))
+BEGIN
+    SELECT RAISE(ABORT, 'native turn owner is immutable and command bound');
+END;
