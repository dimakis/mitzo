+#[tokio::test]
+async fn prepared_request_sampling_migration_preserves_legacy_command_and_turn_tombstones() {
+    let home = unique_temp_dir();
+    std::fs::create_dir_all(&home).unwrap();
+    let sqlite = crate::SqliteConfig::new_for_testing(home.abs());
+    let mut before = crate::migrations::runtime_state_migrator();
+    before.migrations = std::borrow::Cow::Owned(
+        before
+            .migrations
+            .iter()
+            .filter(|migration| migration.version < 60)
+            .cloned()
+            .collect(),
+    );
+    let pool = sqlite
+        .open_state_db(&before, /*telemetry_override*/ None)
+        .await
+        .unwrap();
+    let request = request();
+    let binding_json = serde_json::to_string(&request.binding).unwrap();
+    sqlx::query("INSERT INTO prepared_requests (preparation_id, operation_id, scope, binding_json, request_identity, model, encoded_body, max_output_tokens, measurement_json, consumed, native_thread_id, native_turn_id, provider_response_id, created_at) VALUES ('legacy', 'legacy', 'command', ?, ?, ?, ?, 10, ?, 1, 'legacy-thread', 'legacy-turn', 'legacy-response', 1)")
+        .bind(&binding_json).bind(&request.request_identity).bind(&request.model).bind(&request.encoded_body).bind(serde_json::to_string(&measurement()).unwrap()).execute(&pool).await.unwrap();
+    pool.close().await;
+    let runtime = open(&home).await;
+    let retained = runtime
+        .read_prepared_request("legacy")
+        .await
+        .unwrap()
+        .unwrap();
+    assert_eq!(retained.request, request);
+    assert_eq!(
+        retained.attempt_state,
+        PreparedRequestAttemptState::LegacyConsumedUncertain
+    );
+    assert_eq!(retained.reply_origin_preparation_id(), Some("legacy"));
+    assert_eq!(
+        retained
+            .provider_receipt
+            .as_ref()
+            .unwrap()
+            .provider_response_id,
+        "legacy-response"
+    );
+    assert_eq!(
+        sqlx::query_scalar::<_, String>(
+            "SELECT binding_json FROM prepared_requests WHERE preparation_id = 'legacy'"
+        )
+        .fetch_one(runtime.pool.as_ref())
+        .await
+        .unwrap(),
+        binding_json
+    );
+    assert_eq!(sqlx::query_scalar::<_, Option<String>>("SELECT native_turn_owner_preparation_id FROM prepared_requests WHERE preparation_id = 'legacy'").fetch_one(runtime.pool.as_ref()).await.unwrap(), None);
+    for (operation, predecessor) in [("new-root", None), ("legacy-continuation", Some("legacy"))] {
+        let mut replacement = sampling_request(operation, predecessor);
+        replacement.binding.account_id.push('2');
+        let candidate = measure_sample(&runtime, operation, &replacement).await;
+        assert!(
+            runtime
+                .consume_prepared_request(&candidate.preparation_id, &replacement, "witness")
+                .await
+                .is_err()
+        );
+    }
+    assert_eq!(
+        runtime.read_prepared_request("legacy").await.unwrap(),
+        Some(retained)
+    );
+    runtime.close().await;
+}
