diff --git a/codex-rs/state/src/runtime/prepared_request_sampling.rs b/codex-rs/state/src/runtime/prepared_request_sampling.rs
new file mode 100644
index 0000000..e58b210
--- /dev/null
+++ b/codex-rs/state/src/runtime/prepared_request_sampling.rs
@@ -0,0 +1,139 @@
+use super::NewPreparedRequest;
+use super::PreparedRequestAttemptState;
+use super::PreparedRequestRecord;
+use super::PreparedRequestScope;
+use super::PreparedTurnReceipt;
+use super::record_from_row;
+use super::validate_text;
+use serde::Deserialize;
+use serde::Serialize;
+use sqlx::SqliteConnection;
+
+macro_rules! request_query {
+    ($identity:literal) => {
+        concat!(
+            "SELECT prepared_requests.*, ",
+            "(SELECT native_thread_id FROM prepared_requests root WHERE root.preparation_id = prepared_requests.native_turn_owner_preparation_id) AS owner_native_thread_id, ",
+            "(SELECT native_turn_id FROM prepared_requests root WHERE root.preparation_id = prepared_requests.native_turn_owner_preparation_id) AS owner_native_turn_id ",
+            "FROM prepared_requests WHERE ", $identity, " = ?"
+        )
+    };
+}
+
+pub(super) const REQUEST_BY_PREPARATION_ID: &str = request_query!("preparation_id");
+pub(super) const REQUEST_BY_OPERATION_ID: &str = request_query!("operation_id");
+
+/// Stable identity for one sampling request within an ordinary command.
+/// A first sampling opts into a chain; continuations name their exact predecessor.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct PreparedRequestSampling {
+    pub sampling_id: String,
+    pub previous_preparation_id: Option<String>,
+}
+
+impl PreparedRequestRecord {
+    /// All sampling receipts resolve to one original native turn owner. Delivery
+    /// must use that original owner rather than emit once per sampling request.
+    pub fn reply_origin_preparation_id(&self) -> Option<&str> {
+        self.exact_turn.as_ref().map(|_| {
+            self.native_turn_owner_preparation_id
+                .as_deref()
+                .unwrap_or(&self.preparation_id)
+        })
+    }
+}
+
+pub(super) fn validate_sampling(request: &NewPreparedRequest) -> anyhow::Result<()> {
+    if let Some(sampling) = &request.binding.sampling {
+        anyhow::ensure!(
+            request.scope == PreparedRequestScope::Command,
+            "review context cannot own a sampling chain"
+        );
+        validate_text(&sampling.sampling_id)?;
+        if let Some(previous) = &sampling.previous_preparation_id {
+            validate_text(previous)?;
+        }
+    }
+    Ok(())
+}
+
+async fn predecessor(
+    connection: &mut SqliteConnection,
+    record: &PreparedRequestRecord,
+) -> anyhow::Result<Option<PreparedRequestRecord>> {
+    let Some(previous_id) = record
+        .request
+        .binding
+        .sampling
+        .as_ref()
+        .and_then(|sampling| sampling.previous_preparation_id.as_deref())
+    else {
+        return Ok(None);
+    };
+    anyhow::ensure!(
+        previous_id != record.preparation_id,
+        "sampling cannot name itself as predecessor"
+    );
+    let row = sqlx::query(REQUEST_BY_PREPARATION_ID)
+        .bind(previous_id)
+        .fetch_one(connection)
+        .await?;
+    let previous = record_from_row(&row)?;
+    let current_binding = &record.request.binding;
+    let previous_binding = &previous.request.binding;
+    anyhow::ensure!(
+        previous.request.scope == PreparedRequestScope::Command
+            && previous_binding.sampling.is_some()
+            && previous_binding.application_scope_id == current_binding.application_scope_id
+            && previous_binding.command_id == current_binding.command_id
+            && previous_binding.account_id == current_binding.account_id
+            && previous_binding.route_revision == current_binding.route_revision
+            && previous_binding.runtime_revision == current_binding.runtime_revision
+            && previous_binding.settings_revision == current_binding.settings_revision
+            && previous.request.model == record.request.model,
+        "sampling predecessor command or authority conflicts"
+    );
+    Ok(Some(previous))
+}
+
+/// This proves retained observations and chain custody only. The ordinary owner
+/// must independently authorize current source/history/tools and actual continuation.
+pub(super) async fn validate_consumption(
+    connection: &mut SqliteConnection,
+    record: &PreparedRequestRecord,
+) -> anyhow::Result<()> {
+    if let Some(previous) = predecessor(connection, record).await? {
+        anyhow::ensure!(
+            previous.consumed
+                && previous.attempt_state == PreparedRequestAttemptState::Committed
+                && previous.provider_receipt.is_some()
+                && previous.exact_turn.is_some(),
+            "sampling predecessor has no committed acceptance and native acknowledgement"
+        );
+    }
+    Ok(())
+}
+
+pub(super) async fn acknowledge_continuation(
+    connection: &mut SqliteConnection,
+    record: &PreparedRequestRecord,
+    receipt: &PreparedTurnReceipt,
+) -> anyhow::Result<bool> {
+    let Some(previous) = predecessor(connection, record).await? else {
+        return Ok(false);
+    };
+    anyhow::ensure!(
+        previous.exact_turn.as_ref() == Some(receipt),
+        "continuation native turn conflicts with original command"
+    );
+    let root_id = previous
+        .reply_origin_preparation_id()
+        .ok_or_else(|| anyhow::anyhow!("sampling predecessor has no native turn owner"))?;
+    sqlx::query("UPDATE prepared_requests SET native_turn_owner_preparation_id = ? WHERE preparation_id = ? AND consumed = 1 AND native_turn_owner_preparation_id IS NULL")
+        .bind(root_id)
+        .bind(&record.preparation_id)
+        .execute(connection)
+        .await?;
+    Ok(true)
+}
diff --git a/codex-rs/state/src/runtime/prepared_request_sampling_tests.rs b/codex-rs/state/src/runtime/prepared_request_sampling_tests.rs
new file mode 100644
index 0000000..208d98a
--- /dev/null
+++ b/codex-rs/state/src/runtime/prepared_request_sampling_tests.rs
@@ -0,0 +1,507 @@
+use super::*;
+use pretty_assertions::assert_eq;
+
+fn sampling_request(sampling_id: &str, predecessor: Option<&str>) -> NewPreparedRequest {
+    let mut request = request();
+    request.binding.sampling = Some(PreparedRequestSampling {
+        sampling_id: sampling_id.into(),
+        previous_preparation_id: predecessor.map(str::to_owned),
+    });
+    request
+}
+
+async fn measure_sample(
+    runtime: &StateRuntime,
+    operation: &str,
+    request: &NewPreparedRequest,
+) -> PreparedRequestRecord {
+    let prepared = runtime.prepare_request(operation, request).await.unwrap();
+    let mut witness = measurement();
+    witness.request_identity = request.request_identity.clone();
+    runtime
+        .measure_prepared_request(&prepared.preparation_id, request, &witness)
+        .await
+        .unwrap();
+    runtime
+        .read_prepared_request(operation)
+        .await
+        .unwrap()
+        .unwrap()
+}
+
+async fn commit_sample(runtime: &StateRuntime, prepared: &PreparedRequestRecord) {
+    let handle = runtime
+        .consume_prepared_request(&prepared.preparation_id, &prepared.request, "witness")
+        .await
+        .expect("each distinct sampling must have one live consumption in its command");
+    runtime
+        .commit_prepared_request_attempt(handle)
+        .await
+        .unwrap();
+}
+
+async fn acknowledge_sample(
+    runtime: &StateRuntime,
+    prepared: &PreparedRequestRecord,
+    turn: &PreparedTurnReceipt,
+    provider_id: &str,
+) {
+    runtime
+        .acknowledge_prepared_request(&prepared.preparation_id, turn)
+        .await
+        .expect("sampling acknowledgements must retain the same ordinary turn");
+    runtime
+        .record_prepared_provider_receipt(
+            &prepared.preparation_id,
+            &PreparedProviderReceipt {
+                request_identity: prepared.request.request_identity.clone(),
+                provider_response_id: provider_id.into(),
+            },
+        )
+        .await
+        .unwrap();
+}
+
+async fn accepted_root(runtime: &StateRuntime) -> (PreparedRequestRecord, PreparedTurnReceipt) {
+    let root = measure_sample(
+        runtime,
+        "initial-operation",
+        &sampling_request("initial", /*predecessor*/ None),
+    )
+    .await;
+    commit_sample(runtime, &root).await;
+    let turn = PreparedTurnReceipt {
+        thread_id: "ordinary-thread".into(),
+        turn_id: "ordinary-turn".into(),
+    };
+    acknowledge_sample(runtime, &root, &turn, "initial-response").await;
+    (root, turn)
+}
+
+#[tokio::test]
+async fn prepared_request_sampling_continuations_share_command_and_exact_native_turn() {
+    let home = unique_temp_dir();
+    let runtime = open(&home).await;
+    let (root, turn) = accepted_root(&runtime).await;
+    let mut next_request = sampling_request("tool-continuation", Some(&root.preparation_id));
+    next_request.binding.history_revision = "history-with-tool-result".into();
+    next_request.request_identity = "b".repeat(/*n*/ 64);
+    next_request.encoded_body =
+        br#"{"model":"test-model","input":"retained tool result","max_output_tokens":10}"#.to_vec();
+    let next = measure_sample(&runtime, "continuation-operation", &next_request).await;
+    commit_sample(&runtime, &next).await;
+    let changed_turn = PreparedTurnReceipt {
+        turn_id: "unrelated-turn".into(),
+        ..turn.clone()
+    };
+    assert!(
+        runtime
+            .acknowledge_prepared_request(&next.preparation_id, &changed_turn)
+            .await
+            .is_err()
+    );
+    acknowledge_sample(&runtime, &next, &turn, "continuation-response").await;
+    let third_request = sampling_request("next-sampling", Some(&next.preparation_id));
+    let third = measure_sample(&runtime, "third-operation", &third_request).await;
+    commit_sample(&runtime, &third).await;
+    acknowledge_sample(&runtime, &third, &turn, "third-response").await;
+    let mut retained_records = Vec::new();
+    for (prepared, provider_id) in [
+        (&root, "initial-response"),
+        (&next, "continuation-response"),
+        (&third, "third-response"),
+    ] {
+        let retained = runtime
+            .read_prepared_request(&prepared.operation_id)
+            .await
+            .unwrap()
+            .unwrap();
+        assert_eq!(
+            retained.reply_origin_preparation_id(),
+            Some(root.preparation_id.as_str())
+        );
+        assert_eq!(retained.request, prepared.request);
+        assert_eq!(retained.exact_turn, Some(turn.clone()));
+        assert_eq!(
+            retained.provider_receipt,
+            Some(PreparedProviderReceipt {
+                request_identity: prepared.request.request_identity.clone(),
+                provider_response_id: provider_id.into(),
+            })
+        );
+        assert!(
+            runtime
+                .consume_prepared_request(&prepared.preparation_id, &prepared.request, "witness")
+                .await
+                .is_err()
+        );
+        runtime
+            .acknowledge_prepared_request(&prepared.preparation_id, &turn)
+            .await
+            .unwrap();
+        retained_records.push(retained);
+    }
+    assert_eq!(
+        sqlx::query_scalar::<_, i64>(
+            "SELECT count(*) FROM prepared_requests WHERE native_turn_id IS NOT NULL"
+        )
+        .fetch_one(runtime.pool.as_ref())
+        .await
+        .unwrap(),
+        1
+    );
+    runtime.close().await;
+    let reopened = open(&home).await;
+    for retained in retained_records {
+        assert_eq!(
+            reopened
+                .read_prepared_request(&retained.operation_id)
+                .await
+                .unwrap(),
+            Some(retained)
+        );
+    }
+    reopened.close().await;
+}
+
+#[tokio::test]
+async fn prepared_request_sampling_rejects_new_root_reused_sampling_and_concurrent_forks() {
+    let home = unique_temp_dir();
+    let runtime = open(&home).await;
+    let other = open(&home).await;
+    let (root, turn) = accepted_root(&runtime).await;
+    let replacement = measure_sample(
+        &runtime,
+        "replacement-root",
+        &sampling_request("different-root", /*predecessor*/ None),
+    )
+    .await;
+    assert!(
+        runtime
+            .consume_prepared_request(&replacement.preparation_id, &replacement.request, "witness")
+            .await
+            .is_err()
+    );
+    let reused = measure_sample(
+        &runtime,
+        "reused-sampling",
+        &sampling_request("initial", Some(&root.preparation_id)),
+    )
+    .await;
+    assert!(
+        runtime
+            .consume_prepared_request(&reused.preparation_id, &reused.request, "witness")
+            .await
+            .is_err()
+    );
+    let first = measure_sample(
+        &runtime,
+        "successor-a",
+        &sampling_request("successor-a", Some(&root.preparation_id)),
+    )
+    .await;
+    let second = measure_sample(
+        &runtime,
+        "successor-b",
+        &sampling_request("successor-b", Some(&root.preparation_id)),
+    )
+    .await;
+    let (a, b) = tokio::join!(
+        runtime.consume_prepared_request(&first.preparation_id, &first.request, "witness"),
+        other.consume_prepared_request(&second.preparation_id, &second.request, "witness")
+    );
+    assert_eq!(usize::from(a.is_ok()) + usize::from(b.is_ok()), 1);
+    let (owner, winner, handle) = if let Ok(handle) = a {
+        (&runtime, first, handle)
+    } else {
+        (&other, second, b.unwrap())
+    };
+    owner.commit_prepared_request_attempt(handle).await.unwrap();
+    acknowledge_sample(owner, &winner, &turn, "successor-response").await;
+    assert_eq!(sqlx::query_scalar::<_, i64>("SELECT count(*) FROM prepared_requests WHERE json_extract(binding_json, '$.sampling.previous_preparation_id') = ? AND consumed = 1")
+        .bind(&root.preparation_id).fetch_one(runtime.pool.as_ref()).await.unwrap(), 1);
+    other.close().await;
+    runtime.close().await;
+}
+
+#[tokio::test]
+async fn prepared_request_sampling_requires_bound_acknowledged_accepted_predecessor() {
+    let home = unique_temp_dir();
+    let runtime = open(&home).await;
+    let (root, _) = accepted_root(&runtime).await;
+    for field in ["scope", "command", "account", "route", "runtime", "missing"] {
+        let mut request = sampling_request(field, Some(&root.preparation_id));
+        match field {
+            "scope" => request.binding.application_scope_id.push('2'),
+            "command" => request.binding.command_id.as_mut().unwrap().push('2'),
+            "account" => request.binding.account_id.push('2'),
+            "route" => request.binding.route_revision.push('2'),
+            "runtime" => request.binding.runtime_revision.push('2'),
+            "missing" => {
+                request
+                    .binding
+                    .sampling
+                    .as_mut()
+                    .unwrap()
+                    .previous_preparation_id = Some("missing-preparation".into())
+            }
+            _ => unreachable!(),
+        }
+        let candidate = measure_sample(&runtime, field, &request).await;
+        assert!(
+            runtime
+                .consume_prepared_request(&candidate.preparation_id, &request, "witness")
+                .await
+                .is_err(),
+            "{field}"
+        );
+        assert!(
+            !runtime
+                .read_prepared_request(field)
+                .await
+                .unwrap()
+                .unwrap()
+                .consumed
+        );
+    }
+    for (index, stage) in [
+        "unconsumed",
+        "consumed",
+        "committed",
+        "no-native-ack",
+        "no-provider-receipt",
+        "legacy",
+    ]
+    .iter()
+    .enumerate()
+    {
+        let mut request = sampling_request(stage, /*predecessor*/ None);
+        request.binding.command_id = Some(format!("incomplete-{index}"));
+        if *stage == "legacy" {
+            request.binding.sampling = None;
+        }
+        let previous = measure_sample(&runtime, &format!("previous-{index}"), &request).await;
+        if *stage != "unconsumed" {
+            let handle = runtime
+                .consume_prepared_request(&previous.preparation_id, &request, "witness")
+                .await
+                .unwrap();
+            if *stage != "consumed" {
+                runtime
+                    .commit_prepared_request_attempt(handle)
+                    .await
+                    .unwrap();
+            }
+        }
+        let turn = PreparedTurnReceipt {
+            thread_id: "incomplete-thread".into(),
+            turn_id: format!("turn-{index}"),
+        };
+        if ["no-provider-receipt", "legacy"].contains(stage) {
+            runtime
+                .acknowledge_prepared_request(&previous.preparation_id, &turn)
+                .await
+                .unwrap();
+        }
+        if ["no-native-ack", "legacy"].contains(stage) {
+            runtime
+                .record_prepared_provider_receipt(
+                    &previous.preparation_id,
+                    &PreparedProviderReceipt {
+                        request_identity: request.request_identity.clone(),
+                        provider_response_id: format!("response-{index}"),
+                    },
+                )
+                .await
+                .unwrap();
+        }
+        request.binding.sampling = Some(PreparedRequestSampling {
+            sampling_id: "next".into(),
+            previous_preparation_id: Some(previous.preparation_id.clone()),
+        });
+        let candidate = measure_sample(&runtime, &format!("invalid-next-{index}"), &request).await;
+        assert!(
+            runtime
+                .consume_prepared_request(&candidate.preparation_id, &request, "witness")
+                .await
+                .is_err(),
+            "{stage}"
+        );
+    }
+    runtime.close().await;
+}
+
+async fn frozen_command_setting(field: &str) {
+    let mut rejected = Vec::new();
+    for path in ["native", "sql"] {
+        let home = unique_temp_dir();
+        let runtime = open(&home).await;
+        let (root, _) = accepted_root(&runtime).await;
+        let mut request = sampling_request("changed-setting", Some(&root.preparation_id));
+        match field {
+            "model" => {
+                request.model = "different-model".into();
+                request.encoded_body = br#"{"model":"different-model","input":"explicit command","max_output_tokens":10}"#.to_vec();
+            }
+            "settings" => request.binding.settings_revision.push('2'),
+            _ => unreachable!(),
+        }
+        let next = measure_sample(&runtime, "changed-setting", &request).await;
+        let refused = match path {
+            "native" => runtime.consume_prepared_request(&next.preparation_id, &request, "witness").await.is_err(),
+            "sql" => sqlx::query("UPDATE prepared_requests SET consumed = 1, consumption_nonce = '00000000-0000-0000-0000-000000000000' WHERE preparation_id = ?")
+                .bind(&next.preparation_id).execute(runtime.pool.as_ref()).await.is_err(),
+            _ => unreachable!(),
+        };
+        rejected.push(refused);
+        runtime.close().await;
+    }
+    assert_eq!(
+        rejected,
+        vec![true, true],
+        "{field} must remain frozen for native and SQL consumption"
+    );
+}
