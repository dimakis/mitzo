+#[tokio::test]
+async fn prepared_request_sampling_storage_guards_reject_self_cycles_and_owner_mutation() {
+    let home = unique_temp_dir();
+    let runtime = open(&home).await;
+    for (id, parent) in [
+        ("self", "self"),
+        ("cycle-a", "cycle-b"),
+        ("cycle-b", "cycle-a"),
+    ] {
+        let request = sampling_request(id, Some(parent));
+        sqlx::query("INSERT INTO prepared_requests (preparation_id, operation_id, scope, binding_json, request_identity, model, encoded_body, max_output_tokens, measurement_json, created_at) VALUES (?, ?, 'command', ?, ?, ?, ?, ?, ?, 1)")
+            .bind(id).bind(id).bind(serde_json::to_string(&request.binding).unwrap()).bind(&request.request_identity).bind(&request.model).bind(&request.encoded_body).bind(10_i64).bind(serde_json::to_string(&measurement()).unwrap()).execute(runtime.pool.as_ref()).await.unwrap();
+        assert!(
+            runtime
+                .consume_prepared_request(id, &request, "witness")
+                .await
+                .is_err()
+        );
+        assert!(sqlx::query("UPDATE prepared_requests SET consumed = 1, consumption_nonce = '00000000-0000-0000-0000-000000000000' WHERE preparation_id = ?")
+            .bind(id).execute(runtime.pool.as_ref()).await.is_err());
+    }
+    let (root, turn) = accepted_root(&runtime).await;
+    let next = measure_sample(
+        &runtime,
+        "next",
+        &sampling_request("next", Some(&root.preparation_id)),
+    )
+    .await;
+    commit_sample(&runtime, &next).await;
+    let mut unrelated_request = sampling_request("other-root", /*predecessor*/ None);
+    unrelated_request.binding.command_id = Some("other-command".into());
+    let unrelated = measure_sample(&runtime, "other-root", &unrelated_request).await;
+    commit_sample(&runtime, &unrelated).await;
+    acknowledge_sample(
+        &runtime,
+        &unrelated,
+        &PreparedTurnReceipt {
+            thread_id: "other-thread".into(),
+            turn_id: "other-turn".into(),
+        },
+        "other-response",
+    )
+    .await;
+    assert!(sqlx::query("UPDATE prepared_requests SET native_turn_owner_preparation_id = ? WHERE preparation_id = ?")
+        .bind(&unrelated.preparation_id).bind(&next.preparation_id).execute(runtime.pool.as_ref()).await.is_err());
+    assert_eq!(
+        runtime.read_prepared_request("next").await.unwrap(),
+        Some({
+            let mut expected = next.clone();
+            expected.consumed = true;
+            expected.attempt_state = PreparedRequestAttemptState::Committed;
+            expected
+        })
+    );
+    assert!(sqlx::query("UPDATE prepared_requests SET native_thread_id = 'other', native_turn_id = 'other' WHERE preparation_id = ?")
+        .bind(&next.preparation_id).execute(runtime.pool.as_ref()).await.is_err());
+    acknowledge_sample(&runtime, &next, &turn, "next-response").await;
+    assert!(sqlx::query("UPDATE prepared_requests SET native_turn_owner_preparation_id = NULL WHERE preparation_id = ?")
+        .bind(&next.preparation_id).execute(runtime.pool.as_ref()).await.is_err());
+    runtime.close().await;
+}
