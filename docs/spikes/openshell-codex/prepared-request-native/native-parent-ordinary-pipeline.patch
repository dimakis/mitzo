+#[tokio::test]
+async fn ordinary_manager_retains_populated_descriptor_and_real_bound_parent() -> anyhow::Result<()>
+{
+    skip_if_sandbox!(Ok(()));
+    let Some(runtime) =
+        zsh_fork_runtime("ordinary_manager_retains_populated_descriptor_and_real_bound_parent")?
+    else {
+        return Ok(());
+    };
+    let fixture = Fixture::new(&runtime).await?;
+    fixture
+        .session
+        .services
+        .session_extension_data
+        .insert(ParentBindingTrace::default());
+    let environment = fixture.step.environments.primary().unwrap().clone();
+    let UnifiedExecShellMode::ZshFork(config) = &fixture.shell_mode else {
+        unreachable!()
+    };
+    let script = format!(
+        "printf 'Q1-marker\\n'; /bin/cat {}",
+        shlex::try_quote(fixture.secret.to_string_lossy().as_ref())?
+    );
+    let manager = &fixture.session.services.unified_exec_manager;
+    let process_id = manager.allocate_process_id().await;
+    let request = ExecCommandRequest {
+        command: vec![
+            config.shell_zsh_path.to_string_lossy().into_owned(),
+            "-c".into(),
+            script.clone(),
+        ],
+        shell_type: crate::shell::ShellType::Zsh,
+        hook_command: script,
+        process_id,
+        yield_time_ms: 30_000,
+        max_output_tokens: Some(1000),
+        cwd: environment.cwd().clone(),
+        sandbox_cwd: environment.cwd().clone(),
+        turn_environment: environment.clone(),
+        shell_mode: fixture.shell_mode.clone(),
+        network: None,
+        tty: false,
+        sandbox_permissions: SandboxPermissions::RequireEscalated,
+        additional_permissions: None,
+        additional_permissions_preapproved: false,
+        justification: None,
+        prefix_rule: None,
+    };
+    let context = UnifiedExecContext::new(
+        Arc::clone(&fixture.session),
+        Arc::clone(&fixture.step),
+        fixture.cancellation.clone(),
+        CALL.into(),
+    );
+    let expected_initial_command = request.command.clone();
+    let mut running = RunningCall {
+        call: Some(tokio::spawn(async move {
+            Box::pin(
+                context
+                    .session
+                    .services
+                    .unified_exec_manager
+                    .exec_command(request, &context),
+            )
+            .await
+        })),
+        session: Arc::clone(&fixture.session),
+        process_id,
+        cancellation: fixture.cancellation.clone(),
+        cleaned: false,
+    };
+    let result = async {
+        let mut approvals = Vec::new();
+        let output = tokio::time::timeout(Duration::from_secs(45), async {
+            loop {
+                tokio::select! {
+                    result = running.call.as_mut().unwrap() => {
+                        running.call.take();
+                        return result.map_err(anyhow::Error::from)?.map_err(anyhow::Error::from);
+                    },
+                    event = fixture.events.recv() => {
+                        if let EventMsg::ExecApprovalRequest(request) = event?.msg {
+                            assert_eq!(request.call_id, CALL);
+                            assert!(approvals.len() < 2, "unexpected additional manual approval");
+                            assert_eq!(request.approval_id.is_some(), !approvals.is_empty());
+                            fixture.session.notify_approval(
+                                request.approval_id.as_deref().unwrap_or(&request.call_id),
+                                ReviewDecision::Approved,
+                            ).await;
+                            approvals.push(request);
+                        }
+                    }
+                }
+            }
+        })
+        .await??;
+        assert_eq!(approvals.len(), 2);
+        assert_eq!(approvals[0].command, expected_initial_command);
+        assert_eq!(approvals[1].command.len(), 2);
+        assert!(matches!(
+            approvals[1].command[0].as_str(),
+            "/bin/cat" | "/usr/bin/cat"
+        ));
+        assert_eq!(approvals[1].command[1], fixture.secret.to_string_lossy());
+        assert_eq!(output.exit_code, Some(1));
+        assert!(output.process_id.is_none());
+        let text = String::from_utf8_lossy(&output.raw_output);
+        assert!(text.contains("Q1-marker"));
+        assert!(!text.contains(std::str::from_utf8(SECRET)?));
+        assert_eq!(std::fs::read(&fixture.secret)?, SECRET);
+        while let Ok(event) = fixture.events.try_recv() {
+            assert!(!matches!(event.msg, EventMsg::ExecApprovalRequest(_)));
+        }
+        let trace = fixture
