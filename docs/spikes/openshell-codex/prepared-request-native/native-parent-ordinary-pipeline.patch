+#[tokio::test]
+async fn actual_user_descriptor_custody_checks_every_policy_field_map_and_tag() -> anyhow::Result<()>
+{
+    let Some(runtime) =
+        zsh_fork_runtime("actual_user_descriptor_custody_checks_every_policy_field_map_and_tag")?
+    else {
+        return Ok(());
+    };
+    let fixture = Fixture::new(&runtime).await?;
+    let req = fixture.request();
+    let proof = fixture.approve(&req).await?;
+    let attempt = fixture.attempt(&req);
+    let mut exec = attempt
+        .env_for(
+            codex_sandboxing::SandboxCommand {
+                program: req.command[0].clone().into(),
+                args: req.command[1..].to_vec(),
+                cwd: req.cwd.clone(),
+                env: req.env.clone(),
+                managed_network: None,
+                additional_permissions: None,
+            },
+            crate::sandboxing::ExecOptions {
+                expiration: ExecExpiration::DefaultTimeout,
+                capture_policy: ExecCapturePolicy::ShellTool,
+            },
+            /*network*/ None,
+            Some(&req.turn_environment.selection.environment_id),
+        )
+        .map_err(|error| anyhow::anyhow!("actual transform: {error:?}"))?;
+    exec.exec_server_env_config = req.exec_server_env_config.clone();
+    let executor =
+        CoreShellCommandExecutor::for_initial_request(&req, &attempt, &fixture.context(), &exec)
+            .map_err(|error| anyhow::anyhow!("actual executor: {error:?}"))?;
+    let policy = fixture.session.services.exec_policy.current();
+    let facts = InitialParentRestrictedLaunch::capture(&req, &attempt, &exec);
+    assert!(
+        proof.matches_original_launch(
+            &UnifiedExecRuntime::new(
+                &fixture.session.services.unified_exec_manager,
+                UnifiedExecShellMode::Direct
+            )
+            .approval_action(&req, CALL)?,
+            &fixture.session,
+            &fixture.step,
+            &req.turn_environment
+        )
+    );
+    assert!(facts.matches_executor(
+        &proof,
+        &req,
+        &attempt,
+        &exec,
+        executor.parent_launch_view(),
+        &policy
+    ));
+    for position in ["request", "transformed"] {
+        for field in [
+            "inherit",
+            "ignore_default_excludes",
+            "exclude",
+            "set",
+            "include_only",
+            "local_policy_env",
+            "tag",
+        ] {
+            let mut changed_req = req.clone();
+            let original_exec_descriptor = exec.exec_server_env_config.clone();
+            let changed = if position == "request" {
+                &mut changed_req.exec_server_env_config
+            } else {
+                &mut exec.exec_server_env_config
+            };
+            if field == "tag" {
+                *changed = None;
+            } else {
+                let changed = changed.as_mut().unwrap();
+                match field {
+                    "inherit" => changed.policy.inherit = ShellEnvironmentPolicyInherit::None,
+                    "ignore_default_excludes" => changed.policy.ignore_default_excludes = true,
+                    "exclude" => changed.policy.exclude.push("OTHER_*".into()),
+                    "set" => {
+                        changed
+                            .policy
+                            .r#set
+                            .insert("Q1_SET".into(), "changed".into());
+                    }
+                    "include_only" => changed.policy.include_only.push("OTHER_*".into()),
+                    "local_policy_env" => {
+                        changed
+                            .local_policy_env
+                            .insert("Q1_BASE_B".into(), "changed".into());
+                    }
+                    _ => unreachable!(),
+                }
+            }
+            let changed_attempt = fixture.attempt(&changed_req);
+            assert!(
+                !facts.matches_executor(
+                    &proof,
+                    &changed_req,
+                    &changed_attempt,
+                    &exec,
+                    executor.parent_launch_view(),
+                    &policy
+                ),
+                "retained custody: {position}/{field}"
+            );
+            let recaptured =
+                InitialParentRestrictedLaunch::capture(&changed_req, &changed_attempt, &exec);
+            assert!(
+                !recaptured.matches_executor(
+                    &proof,
+                    &changed_req,
+                    &changed_attempt,
+                    &exec,
+                    executor.parent_launch_view(),
+                    &policy
+                ),
+                "request/transformed mismatch: {position}/{field}"
+            );
+            exec.exec_server_env_config = original_exec_descriptor;
+        }
+    }
+    let mut both_changed = req.clone();
+    both_changed
+        .exec_server_env_config
+        .as_mut()
+        .unwrap()
+        .local_policy_env
+        .insert("Q1_BASE_A".into(), "changed".into());
+    exec.exec_server_env_config = both_changed.exec_server_env_config.clone();
+    let changed_attempt = fixture.attempt(&both_changed);
+    assert!(!facts.matches_executor(
+        &proof,
+        &both_changed,
+        &changed_attempt,
+        &exec,
+        executor.parent_launch_view(),
+        &policy
+    ));
+    let mut none_req = req.clone();
+    none_req.exec_server_env_config = None;
+    exec.exec_server_env_config = None;
+    let none_attempt = fixture.attempt(&none_req);
+    assert!(!facts.matches_executor(
+        &proof,
+        &none_req,
+        &none_attempt,
+        &exec,
+        executor.parent_launch_view(),
+        &policy
+    ));
+    let none_facts = InitialParentRestrictedLaunch::capture(&none_req, &none_attempt, &exec);
+    assert!(none_facts.matches_executor(
+        &proof,
+        &none_req,
+        &none_attempt,
+        &exec,
+        executor.parent_launch_view(),
+        &policy
+    ));
+    fixture.close().await;
+    Ok(())
+}
