+struct RunningCall {
+    call: Option<
+        tokio::task::JoinHandle<
+            Result<
+                crate::tools::context::ExecCommandToolOutput,
+                crate::unified_exec::UnifiedExecError,
+            >,
+        >,
+    >,
+    session: Arc<crate::session::session::Session>,
+    process_id: i32,
+    cancellation: CancellationToken,
+    cleaned: bool,
+}
+impl Drop for RunningCall {
+    fn drop(&mut self) {
+        if self.cleaned {
+            return;
+        }
+        if let Some(call) = &self.call {
+            call.abort();
+        }
+        self.cancellation.cancel();
+        let session = Arc::clone(&self.session);
+        let id = self.process_id;
+        tokio::spawn(async move {
+            session
+                .services
+                .unified_exec_manager
+                .terminate_all_processes()
+                .await;
+            session
+                .services
+                .unified_exec_manager
+                .release_process_id(id)
+                .await;
+        });
+    }
+}
+impl RunningCall {
+    async fn cleanup(&mut self) {
+        self.cancellation.cancel();
+        if let Some(call) = self.call.take() {
+            call.abort();
+            let _ = call.await;
+        }
+        self.session
+            .services
+            .unified_exec_manager
+            .terminate_all_processes()
+            .await;
+        self.session
+            .services
+            .unified_exec_manager
+            .release_process_id(self.process_id)
+            .await;
+        self.cleaned = true;
+    }
+}
