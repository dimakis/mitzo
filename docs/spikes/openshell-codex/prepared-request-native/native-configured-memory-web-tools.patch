diff --git a/codex-rs/ext/memories/src/tests.rs b/codex-rs/ext/memories/src/tests.rs
index a4f780d..6ef9321 100644
--- a/codex-rs/ext/memories/src/tests.rs
+++ b/codex-rs/ext/memories/src/tests.rs
@@ -602,3 +602,74 @@ fn memory_tool(
 fn memory_tool_name(tool_name: &str) -> ToolName {
     ToolName::namespaced(crate::MEMORY_TOOLS_NAMESPACE, tool_name)
 }
+
+#[tokio::test]
+async fn installed_memory_source_declares_only_config_proven_tool_absence() {
+    use codex_core::config::ConfigBuilder;
+    use codex_extension_api::PreSessionToolInventoryError;
+    use codex_features::Feature;
+    let home = tempfile::tempdir().unwrap();
+    let mut config = ConfigBuilder::default()
+        .codex_home(home.path().to_path_buf())
+        .build()
+        .await
+        .unwrap();
+    config.features.enable(Feature::MemoryTool).unwrap();
+    config.memories.use_memories = true;
+    config.memories.dedicated_tools = true;
+    let mut builder = ExtensionRegistryBuilder::new();
+    crate::extension::install(&mut builder, None);
+    let registry = builder.build();
+    assert_eq!(
+        registry.capture_pre_session_tools_for_config(&config).err(),
+        Some(PreSessionToolInventoryError::StateBoundContributors {
+            registration_indexes: vec![0]
+        })
+    );
+    // Enabling dedicated memory tools is unresolved, never silently omitted.
+    // Both actual disabled configurations declare absence; no lifecycle, memory
+    // reads, backend construction, model or tool callback is needed to capture it.
+    for dedicated in [true, false] {
+        let mut disabled = config.clone();
+        disabled.memories.dedicated_tools = dedicated;
+        if dedicated {
+            disabled.memories.use_memories = false;
+        }
+        let capture = registry
+            .capture_pre_session_tools_for_config(&disabled)
+            .unwrap();
+        assert!(capture.definitions().is_empty());
+        registry
+            .renew_pre_session_tools_for_config(&capture, &disabled)
+            .unwrap();
+        assert!(
+            registry
+                .renew_pre_session_tools_for_config(&capture, &config)
+                .is_err()
+        );
+        let session = ExtensionData::new("ordinary-session");
+        let thread = ExtensionData::new("ordinary-thread");
+        for contributor in registry.thread_lifecycle_contributors() {
+            contributor
+                .on_thread_start(codex_extension_api::ThreadStartInput {
+                    config: &disabled,
+                    session_source: &codex_protocol::protocol::SessionSource::Exec,
+                    persistent_thread_state_available: false,
+                    environments: &[],
+                    mcp_resource_client: None,
+                    extension_metrics: None,
+                    session_store: &session,
+                    thread_store: &thread,
+                })
+                .await;
+        }
+        assert!(
+            registry
+                .tool_contributors()
+                .iter()
+                .flat_map(|source| source.tools(&session, &thread))
+                .collect::<Vec<_>>()
+                .is_empty()
+        );
+    }
+}
