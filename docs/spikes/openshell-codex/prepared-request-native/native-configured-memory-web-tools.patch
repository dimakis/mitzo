+// This is the same source decision used for ordinary executor selection and
+// pre-session absence; it constructs neither an auth/provider client nor tools.
+fn tool_selection(provider: &ModelProviderInfo, mode: WebSearchMode) -> ToolPreSessionSelection {
+    if (provider.is_openai()
+        || provider.uses_openai_actor_authorization()
+        || provider.supports_standalone_web_search)
+        && mode != WebSearchMode::Disabled
+    {
+        ToolPreSessionSelection::Unresolved
+    } else {
+        ToolPreSessionSelection::NoTools
+    }
+}
