+#[tokio::test]
+async fn retained_configured_baseline_refuses_changed_presence_order_history_source_and_fork()
+-> anyhow::Result<()> {
+    let (_home, config, row) = config_and_original_row().await?;
+    let config = Arc::new(config);
+    let mut options = crate::StartThreadOptions::new(config.as_ref().clone());
+    options.dynamic_tools = vec![tool("first"), tool("second")];
+    options.disabled_plugin_ids = Some(vec!["first".to_string(), "second".to_string()]);
+    options.environments = Some(Vec::new());
+    let baseline = OwnedConfiguredBaseline::capture(
+        Arc::clone(&config),
+        &row.slug,
+        &row,
+        ConfiguredBaselineInputs::from_options(&options, /*forked_from_thread_id*/ None),
+        &SessionSource::Exec,
+        /*trusted_guardian_reviewer*/ false,
+    )?;
+    let validate = |options: &crate::StartThreadOptions| {
+        baseline.validate(
+            &config,
+            &SessionSource::Exec,
+            /*trusted_guardian_reviewer*/ false,
+            ConfiguredBaselineInputs::from_options(options, /*forked_from_thread_id*/ None),
+        )
+    };
+    options.environments = None;
+    assert!(validate(&options).is_err());
+    options.environments = Some(Vec::new());
+    options.dynamic_tools.swap(0, 1);
+    assert!(validate(&options).is_err());
+    options.dynamic_tools.swap(0, 1);
+    options.disabled_plugin_ids.as_mut().unwrap().swap(0, 1);
+    assert!(validate(&options).is_err());
+    options.disabled_plugin_ids.as_mut().unwrap().swap(0, 1);
+    options.initial_history = InitialHistory::Cleared;
+    assert!(validate(&options).is_err());
+    options.initial_history = InitialHistory::New;
+    assert!(
+        baseline
+            .validate(
+                &config,
+                &SessionSource::Cli,
+                /*trusted_guardian_reviewer*/ false,
+                ConfiguredBaselineInputs::from_options(
+                    &options, /*forked_from_thread_id*/ None
+                )
+            )
+            .is_err()
+    );
+    assert!(
+        baseline
+            .validate(
+                &config,
+                &SessionSource::Exec,
+                /*trusted_guardian_reviewer*/ true,
+                ConfiguredBaselineInputs::from_options(
+                    &options, /*forked_from_thread_id*/ None
+                )
+            )
+            .is_err()
+    );
+    assert!(
+        baseline
+            .validate(
+                &config,
+                &SessionSource::Exec,
+                /*trusted_guardian_reviewer*/ false,
+                ConfiguredBaselineInputs::from_options(&options, Some(ThreadId::new()))
+            )
+            .is_err()
+    );
+    options.disabled_plugin_ids = Some(Vec::new());
+    let empty = OwnedConfiguredBaseline::capture(
+        Arc::clone(&config),
+        &row.slug,
+        &row,
+        ConfiguredBaselineInputs::from_options(&options, /*forked_from_thread_id*/ None),
+        &SessionSource::Exec,
+        /*trusted_guardian_reviewer*/ false,
+    )?;
+    options.disabled_plugin_ids = None;
+    assert!(
+        empty
+            .validate(
+                &config,
+                &SessionSource::Exec,
+                /*trusted_guardian_reviewer*/ false,
+                ConfiguredBaselineInputs::from_options(
+                    &options, /*forked_from_thread_id*/ None
+                )
+            )
+            .is_err()
+    );
+    Ok(())
+}
