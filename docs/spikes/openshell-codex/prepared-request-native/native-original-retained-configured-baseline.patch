+#[tokio::test]
+async fn original_startup_retains_effective_baseline_and_rejects_changed_selected_inputs()
+-> anyhow::Result<()> {
+    let (_home, mut options, auth, models, endpoint) = fixture().await?;
+    options.disabled_plugin_ids = Some(vec!["original-selected-plugin".to_string()]);
+    let startup = OriginalStartupSelection::capture(
+        &options,
+        &SessionSource::Exec,
+        /*forked_from_thread_id*/ None,
+        &auth,
+        &models,
+    )
+    .await?;
+    let mut selected = crate::StartThreadOptions::new(startup.effective_config().clone());
+    selected.disabled_plugin_ids = options.disabled_plugin_ids.clone();
+    selected.environments = options.environments.clone();
+    startup.validate_baseline_options(&selected, /*forked_from_thread_id*/ None)?;
+    selected.disabled_plugin_ids = None;
+    assert!(
+        startup
+            .validate_baseline_options(&selected, /*forked_from_thread_id*/ None)
+            .is_err()
+    );
+    selected.disabled_plugin_ids = options.disabled_plugin_ids.clone();
+    selected.environments = None;
+    assert!(
+        startup
+            .validate_baseline_options(&selected, /*forked_from_thread_id*/ None)
+            .is_err()
+    );
+    selected.environments = options.environments.clone();
+    let effective = Arc::clone(&startup.owner.effective);
+    let (owner, mut stages, _) = startup.into_session(
+        &models,
+        &auth,
+        &selected.config,
+        configured_settings_data::ConfiguredBaselineInputs::from_options(
+            &selected, /*forked_from_thread_id*/ None,
+        ),
+        &SessionSource::Exec,
+    )?;
+    assert!(Arc::ptr_eq(&effective, &stages.take_effective()?));
+    stages.baseline.bind_effective(&effective)?;
+    let row = owner.model_info();
+    let expected = configured_settings_data::OriginalConfiguredHistoryData::capture(
+        &effective,
+        &row.slug,
+        &options.initial_history,
+        options.dynamic_tools.clone(),
+        options.disabled_plugin_ids.clone(),
+        /*forked_from_thread_id*/ None,
+    )
+    .resolve_service_tier(
+        &effective,
+        effective.features.enabled(Feature::FastMode),
+        row,
+    );
+    let actual = stages
+        .baseline
+        .take_history()?
+        .with_service_tier(&effective, stages.baseline.take_service_tier()?);
+    assert_eq!(
+        (
+            actual.dynamic_tools,
+            actual.disabled_plugin_ids,
+            actual.step.into_settings()
+        ),
+        (
+            expected.dynamic_tools,
+            expected.disabled_plugin_ids,
+            expected.step.into_settings()
+        )
+    );
+    assert!(stages.baseline.take_history().is_err());
+    assert!(stages.baseline.take_service_tier().is_err());
+    let startup = OriginalStartupSelection::capture(
+        &options,
+        &SessionSource::Exec,
+        /*forked_from_thread_id*/ None,
+        &auth,
+        &models,
+    )
+    .await?;
+    selected.config = startup.effective_config().clone();
+    selected.disabled_plugin_ids = None;
+    assert!(
+        startup
+            .into_session(
+                &models,
+                &auth,
+                &selected.config,
+                configured_settings_data::ConfiguredBaselineInputs::from_options(
+                    &selected, /*forked_from_thread_id*/ None
+                ),
+                &SessionSource::Exec
+            )
+            .is_err()
+    );
+    assert_eq!(endpoint.reads.load(Ordering::SeqCst), 1);
+    Ok(())
+}
