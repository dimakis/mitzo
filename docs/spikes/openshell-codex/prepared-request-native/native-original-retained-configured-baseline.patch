+/// Borrowed ORIGINAL inputs at the selected or ordinary boundary, never a
+/// manufactured history/environment snapshot or permission grant.
+pub(super) struct ConfiguredBaselineInputs<'a> {
+    pub(super) history: &'a InitialHistory,
+    pub(super) dynamic_tools: &'a [DynamicToolSpec],
+    pub(super) disabled_plugin_ids: &'a Option<Vec<String>>,
+    pub(super) environments: Option<&'a [codex_protocol::protocol::TurnEnvironmentSelection]>,
+    pub(super) forked_from_thread_id: Option<ThreadId>,
+}
+impl<'a> ConfiguredBaselineInputs<'a> {
+    pub(super) fn from_options(
+        options: &'a crate::StartThreadOptions,
+        forked_from_thread_id: Option<ThreadId>,
+    ) -> Self {
+        Self {
+            history: &options.initial_history,
+            dynamic_tools: &options.dynamic_tools,
+            disabled_plugin_ids: &options.disabled_plugin_ids,
+            environments: options.environments.as_deref(),
+            forked_from_thread_id,
+        }
+    }
+}
+
+/// One owned, non-Clone/non-Serialize baseline retained by the original startup
+/// packet. Stages never borrow their own Config and never load permissions.
+pub(super) struct OwnedConfiguredBaseline {
+    config: Arc<Config>,
+    source: SessionSource,
+    trusted_guardian_reviewer: bool,
+    dynamic_input: Vec<DynamicToolSpec>,
+    plugins_input: Option<Vec<String>>,
+    forked_from_thread_id: Option<ThreadId>,
+    history: Option<OriginalConfiguredHistoryData>,
+    warning: Option<Option<String>>,
+    service_tier: Option<Option<String>>,
+    environments: Option<Vec<codex_protocol::protocol::TurnEnvironmentSelection>>,
+}
+impl OwnedConfiguredBaseline {
+    pub(super) fn capture(
+        config: Arc<Config>,
+        model: &str,
+        row: &ModelInfo,
+        inputs: ConfiguredBaselineInputs<'_>,
+        source: &SessionSource,
+        trusted_guardian_reviewer: bool,
+    ) -> std::io::Result<Self> {
+        if !matches!(inputs.history, InitialHistory::New) {
+            return Err(std::io::Error::other(
+                "configured baseline requires original fresh history",
+            ));
+        }
+        let environments = inputs
+            .environments
+            .ok_or_else(|| std::io::Error::other("original selected environments missing"))?
+            .to_vec();
+        let history = OriginalConfiguredHistoryData::capture(
+            &config,
+            model,
+            inputs.history,
+            inputs.dynamic_tools.to_vec(),
+            inputs.disabled_plugin_ids.clone(),
+            inputs.forked_from_thread_id,
+        );
+        let fast_mode_enabled = config.features.enabled(Feature::FastMode);
+        let warning = unsupported_service_tier_warning(
+            config.service_tier.as_deref(),
+            fast_mode_enabled,
+            row,
+        );
+        let service_tier = get_service_tier(config.service_tier.clone(), fast_mode_enabled, row);
+        Ok(Self {
+            config,
+            source: source.clone(),
+            trusted_guardian_reviewer,
+            dynamic_input: inputs.dynamic_tools.to_vec(),
+            plugins_input: inputs.disabled_plugin_ids.clone(),
+            forked_from_thread_id: inputs.forked_from_thread_id,
+            history: Some(history),
+            warning: Some(warning),
+            service_tier: Some(service_tier),
+            environments: Some(environments),
+        })
+    }
+    pub(super) fn validate(
+        &self,
+        config: &Config,
+        source: &SessionSource,
+        trusted_guardian_reviewer: bool,
+        inputs: ConfiguredBaselineInputs<'_>,
+    ) -> std::io::Result<()> {
+        if *config != *self.config
+            || *source != self.source
+            || trusted_guardian_reviewer != self.trusted_guardian_reviewer
+            || !matches!(inputs.history, InitialHistory::New)
+            || inputs.dynamic_tools != self.dynamic_input.as_slice()
+            || *inputs.disabled_plugin_ids != self.plugins_input
+            || inputs.forked_from_thread_id != self.forked_from_thread_id
+            || self.environments.is_none()
+            || inputs.environments != self.environments.as_deref()
+            || self.history.is_none()
+            || self.warning.is_none()
+            || self.service_tier.is_none()
+        {
+            return Err(std::io::Error::other(
+                "configured baseline changed or already adopted",
+            ));
+        }
+        Ok(())
+    }
+    pub(super) fn bind_effective(&self, config: &Arc<Config>) -> std::io::Result<()> {
+        if !Arc::ptr_eq(config, &self.config) {
+            return Err(std::io::Error::other(
+                "configured baseline effective owner changed",
+            ));
+        }
+        Ok(())
+    }
+    pub(super) fn take_history(&mut self) -> std::io::Result<OriginalConfiguredHistoryData> {
+        self.history
+            .take()
+            .ok_or_else(|| std::io::Error::other("configured history already adopted"))
+    }
+    pub(super) fn take_warning(&mut self) -> std::io::Result<Option<String>> {
+        self.warning
+            .take()
+            .ok_or_else(|| std::io::Error::other("configured warning already adopted"))
+    }
+    pub(super) fn take_service_tier(&mut self) -> std::io::Result<Option<String>> {
+        self.service_tier
+            .take()
+            .ok_or_else(|| std::io::Error::other("configured tier already adopted"))
+    }
+    pub(super) fn take_environments(
+        &mut self,
+    ) -> std::io::Result<Vec<codex_protocol::protocol::TurnEnvironmentSelection>> {
+        self.environments
+            .take()
+            .ok_or_else(|| std::io::Error::other("configured environments already adopted"))
+    }
+}
