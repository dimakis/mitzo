+#[tokio::test]
+async fn retained_configured_baseline_keeps_owned_data_and_burns_each_stage() -> anyhow::Result<()>
+{
+    let (_home, mut config, row) = config_and_original_row().await?;
+    config.service_tier = Some("priority".to_string());
+    let config = Arc::new(config);
+    let mut options = crate::StartThreadOptions::new(config.as_ref().clone());
+    options.dynamic_tools = vec![tool("retained-original-tool")];
+    options.disabled_plugin_ids = Some(vec!["selected-plugin".to_string()]);
+    options.environments = Some(vec![codex_protocol::protocol::TurnEnvironmentSelection {
+        environment_id: "retained-selected-environment".to_string(),
+        cwd: config.cwd.clone().into(),
+        workspace_roots: vec![config.cwd.clone().into()],
+        config: codex_protocol::protocol::EnvironmentConfigState::Pending,
+    }]);
+    let mut second_environment = options.environments.as_ref().unwrap()[0].clone();
+    second_environment.environment_id = "retained-second-environment".to_string();
+    options
+        .environments
+        .as_mut()
+        .unwrap()
+        .push(second_environment);
+    let inputs =
+        ConfiguredBaselineInputs::from_options(&options, /*forked_from_thread_id*/ None);
+    let mut baseline = OwnedConfiguredBaseline::capture(
+        Arc::clone(&config),
+        &row.slug,
+        &row,
+        inputs,
+        &SessionSource::Exec,
+        /*trusted_guardian_reviewer*/ false,
+    )?;
+    baseline.validate(
+        &config,
+        &SessionSource::Exec,
+        /*trusted_guardian_reviewer*/ false,
+        ConfiguredBaselineInputs::from_options(&options, /*forked_from_thread_id*/ None),
+    )?;
+    options.environments.as_mut().unwrap().swap(0, 1);
+    assert!(
+        baseline
+            .validate(
+                &config,
+                &SessionSource::Exec,
+                /*trusted_guardian_reviewer*/ false,
+                ConfiguredBaselineInputs::from_options(
+                    &options, /*forked_from_thread_id*/ None
+                )
+            )
+            .is_err()
+    );
+    options.environments.as_mut().unwrap().swap(0, 1);
+    baseline.bind_effective(&config)?;
+    assert!(
+        baseline
+            .bind_effective(&Arc::new(config.as_ref().clone()))
+            .is_err()
+    );
+    let original = OriginalConfiguredHistoryData::capture(
+        &config,
+        &row.slug,
+        &options.initial_history,
+        options.dynamic_tools.clone(),
+        options.disabled_plugin_ids.clone(),
+        /*forked_from_thread_id*/ None,
+    )
+    .resolve_service_tier(&config, config.features.enabled(Feature::FastMode), &row);
+    let history = baseline.take_history()?;
+    assert!(
+        baseline
+            .validate(
+                &config,
+                &SessionSource::Exec,
+                /*trusted_guardian_reviewer*/ false,
+                ConfiguredBaselineInputs::from_options(
+                    &options, /*forked_from_thread_id*/ None
+                )
+            )
+            .is_err()
+    );
+    let warning = baseline.take_warning()?;
+    let retained = history.with_service_tier(&config, baseline.take_service_tier()?);
+    assert_eq!(
+        (&retained.dynamic_tools, &retained.disabled_plugin_ids),
+        (&original.dynamic_tools, &original.disabled_plugin_ids)
+    );
+    assert_eq!(retained.step.into_settings(), original.step.into_settings());
+    assert_eq!(
+        warning,
+        unsupported_service_tier_warning(
+            config.service_tier.as_deref(),
+            config.features.enabled(Feature::FastMode),
+            &row
+        )
+    );
+    assert_eq!(
+        baseline.take_environments()?,
+        options.environments.clone().unwrap()
+    );
+    assert!(baseline.take_history().is_err());
+    assert!(baseline.take_service_tier().is_err());
+    assert!(baseline.take_warning().is_err());
+    assert!(baseline.take_environments().is_err());
+    Ok(())
+}
