+// Retain the manager's actual terminal-denial payload; never fabricate a tool response.
+pub(super) type InitialOutcome = Result<ExecCommandToolOutput, UnifiedExecError>;
+
+pub(super) fn initial_outcome(result: InitialOutcome) -> anyhow::Result<InitialOutcome> {
+    match result {
+        Ok(output) => Ok(Ok(output)),
+        Err(error @ UnifiedExecError::SandboxDenied { .. }) => Ok(Err(error)),
+        Err(error) => Err(error.into()),
+    }
+}
+
+pub(super) async fn terminal_initial_output<'a>(
+    fixture: &Fixture,
+    process_id: i32,
+    outcome: &'a InitialOutcome,
+) -> anyhow::Result<&'a [u8]> {
+    let bytes = match outcome {
+        Ok(output) => {
+            assert_eq!(output.exit_code, Some(1));
+            assert!(output.process_id.is_none());
+            output.raw_output.as_slice()
+        }
+        Err(UnifiedExecError::SandboxDenied { output, .. }) => {
+            assert_eq!(output.exit_code, 1);
+            assert!(!output.timed_out);
+            let secret = std::str::from_utf8(SECRET)?;
+            assert!(!output.stdout.text.contains(secret));
+            assert!(!output.stderr.text.contains(secret));
+            output.aggregated_output.text.as_bytes()
+        }
+        Err(error) => anyhow::bail!("unexpected initial manager outcome: {error:?}"),
+    };
+    // Observe the actual store BEFORE cleanup; absence is not inferred from an error variant.
+    assert_eq!(
+        fixture
+            .session
+            .services
+            .unified_exec_manager
+            .environment_id_for_process(process_id)
+            .await,
+        None
+    );
+    Ok(bytes)
+}
