@@ -0,0 +1,136 @@
+use super::*;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+
+fn body() -> Value {
+    json!({
+        "model": "fixture-model", "instructions": "retained developer instructions",
+        "input": [{"role":"user", "content":[
+            {"type":"input_text", "text":"retained brief"},
+            {"type":"input_image", "image_url":"data:image/png;base64,aGVsbG8=", "detail":"high"}
+        ]}],
+        "tools":[{"type":"function", "name":"example", "parameters":{"type":"object"}, "strict":true}],
+        "tool_choice":"auto", "parallel_tool_calls":false,
+        "text":{"format":{"type":"json_schema", "name":"result", "schema":{"type":"object"}, "strict":true}},
+        "reasoning":{"effort":"low"}, "store":false, "stream":true,
+        "max_output_tokens":16, "truncation":"disabled"
+    })
+}
+
+#[test]
+fn frozen_retains_final_generation_body_and_exact_count_projection() {
+    let original = body();
+    let frozen = FrozenResponsesRequest::new(original.clone(), 16).unwrap();
+    let mut expected_count = original.clone();
+    for key in ["store", "stream", "max_output_tokens"] {
+        expected_count.as_object_mut().unwrap().remove(key);
+    }
+    assert_eq!(frozen.body(), &original);
+    assert_eq!(frozen.count_body(), &expected_count);
+    assert_eq!(
+        frozen.encoded_body(),
+        serde_json::to_vec(&original).unwrap()
+    );
+    assert_eq!(frozen.max_output_tokens(), 16);
+}
+
+#[test]
+fn frozen_refuses_unknown_internal_or_stateful_fields() {
+    for field in [
+        "client_metadata",
+        "access_programs",
+        "conversation",
+        "previous_response_id",
+        "future_framing",
+    ] {
+        let mut request = body();
+        request[field] = json!(null);
+        assert!(FrozenResponsesRequest::new(request, 16).is_err(), "{field}");
+    }
+}
+
+#[test]
+fn frozen_refuses_invalid_output_limits_and_truncation() {
+    for budget in [
+        json!(0),
+        json!(15),
+        json!(-1),
+        json!(1.5),
+        json!(17),
+        json!(null),
+        json!(9007199254740992_u64),
+    ] {
+        let mut request = body();
+        request["max_output_tokens"] = budget;
+        assert!(FrozenResponsesRequest::new(request, 16).is_err());
+    }
+    assert!(FrozenResponsesRequest::new(body(), 0).is_err());
+    let mut request = body();
+    request["truncation"] = json!("auto");
+    assert!(FrozenResponsesRequest::new(request, 16).is_err());
+}
+
+#[test]
+fn frozen_refuses_unretained_images_and_unsupported_shapes() {
+    for input in [
+        json!([{"role":"user", "content":[{"type":"input_image", "image_url":"https://example.com/image.png"}]}]),
+        json!([{"role":"user", "content":[{"type":"input_file", "file_id":"file-123"}]}]),
+        json!([{"type":"item_reference", "id":"mutable-item"}]),
+        json!([{"role":"user", "content":[{"type":"unknown", "text":"hidden"}]}]),
+    ] {
+        let mut request = body();
+        request["input"] = input;
+        assert!(FrozenResponsesRequest::new(request, 16).is_err());
+    }
+    let mut request = body();
+    request["tools"] = json!([{"type":"mcp", "server_url":"https://example.com"}]);
+    assert!(FrozenResponsesRequest::new(request, 16).is_err());
+}
+
+#[test]
+fn frozen_enforces_encoded_size_bound() {
+    let mut request = body();
+    request["input"] = json!("");
+    let overhead = serde_json::to_vec(&request).unwrap().len();
+    request["input"] = json!("x".repeat(4 * 1024 * 1024 - overhead));
+    let frozen = FrozenResponsesRequest::new(request.clone(), 16).unwrap();
+    assert_eq!(frozen.encoded_body().len(), 4 * 1024 * 1024);
+    request["input"] = json!(format!("{}x", request["input"].as_str().unwrap()));
+    assert!(FrozenResponsesRequest::new(request, 16).is_err());
+}
+
+#[test]
+fn frozen_refuses_unknown_nested_fields_and_unsafe_numbers() {
+    for (field, value) in [
+        (
+            "reasoning",
+            json!({"effort":"low", "internal_framing":"unsupported"}),
+        ),
+        ("text", json!({"unknown":"unsupported"})),
+        (
+            "input",
+            json!([{"role":"user", "content":"text", "unknown":"unsupported"}]),
+        ),
+        (
+            "tools",
+            json!([{"type":"function", "name":"f", "parameters":{"maximum":9007199254740992_u64}}]),
+        ),
+    ] {
+        let mut request = body();
+        request[field] = value;
+        assert!(FrozenResponsesRequest::new(request, 16).is_err(), "{field}");
+    }
+}
+
+#[test]
+fn frozen_restores_identical_encoded_body_and_count_projection() {
+    let frozen = FrozenResponsesRequest::new(body(), 16).unwrap();
+    let restored = FrozenResponsesRequest::from_encoded(frozen.encoded_body(), 16).unwrap();
+    assert_eq!(restored.encoded_body(), frozen.encoded_body());
+    assert_eq!(restored.body(), frozen.body());
+    assert_eq!(restored.count_body(), frozen.count_body());
+    assert!(FrozenResponsesRequest::from_encoded(b"corrupt", 16).is_err());
+    let whitespace = format!(" {}", String::from_utf8_lossy(frozen.encoded_body()));
+    assert!(FrozenResponsesRequest::from_encoded(whitespace.as_bytes(), 16).is_err());
+    assert!(FrozenResponsesRequest::from_encoded(frozen.encoded_body(), 15).is_err());
+}
