@@ -0,0 +1,415 @@
+use crate::ApiError;
+use base64::Engine;
+use codex_client::EncodedJsonBody;
+use serde_json::Map;
+use serde_json::Value;
+
+const MAX_SAFE_INTEGER: u64 = 9_007_199_254_740_991;
+const MAX_BODY_BYTES: usize = 4 * 1024 * 1024;
+// https://developers.openai.com/api/reference/python/resources/responses/subresources/input_tokens/methods/count
+// No generation-only or undocumented parameter is projected into that schema.
+const COUNT_FIELDS: &[&str] = &[
+    "model",
+    "input",
+    "instructions",
+    "parallel_tool_calls",
+    "personality",
+    "reasoning",
+    "text",
+    "tool_choice",
+    "tools",
+    "truncation",
+];
+
+/// Final public Responses HTTP body and its documented count projection.
+///
+/// This does not expand native context or confer account/dispatch authority. The
+/// caller supplies the selected model's authoritative output limit. Unsupported
+/// public/internal shapes refuse; neither construction nor restoration drops fields.
+#[derive(Clone)]
+pub struct FrozenResponsesRequest {
+    body: Value,
+    encoded: EncodedJsonBody,
+    count_body: Value,
+    count_encoded: EncodedJsonBody,
+    max_output_tokens: u64,
+}
+
+impl FrozenResponsesRequest {
+    pub fn new(body: Value, model_output_limit: u64) -> Result<Self, ApiError> {
+        validate_numbers(&body, 0)?;
+        let fields = object(
+            &body,
+            &[
+                "model",
+                "input",
+                "instructions",
+                "parallel_tool_calls",
+                "personality",
+                "reasoning",
+                "text",
+                "tool_choice",
+                "tools",
+                "truncation",
+                // These public create controls affect delivery/storage/cache or output
+                // reservation, not model-visible input. All other fields refuse.
+                "max_output_tokens",
+                "stream",
+                "store",
+                "include",
+                "service_tier",
+                "prompt_cache_key",
+                "metadata",
+                "stream_options",
+            ],
+        )?;
+        ensure(
+            fields
+                .get("model")
+                .and_then(Value::as_str)
+                .is_some_and(|s| !s.is_empty()),
+        )?;
+        let max_output_tokens = fields
+            .get("max_output_tokens")
+            .and_then(Value::as_u64)
+            .ok_or_else(unsupported)?;
+        // 16 is this implementation's conservative supported floor, not a claim
+        // that every provider/model documents the same minimum.
+        ensure(
+            (16..=MAX_SAFE_INTEGER).contains(&model_output_limit)
+                && (16..=model_output_limit).contains(&max_output_tokens),
+        )?;
+        ensure(fields.get("truncation").and_then(Value::as_str) == Some("disabled"))?;
+        ensure(fields.get("stream").and_then(Value::as_bool) == Some(true))?;
+        validate_input(fields.get("input").ok_or_else(unsupported)?)?;
+        validate_controls(fields)?;
+        let encoded = EncodedJsonBody::encode(&body).map_err(|_| unsupported())?;
+        ensure(encoded.as_bytes().len() <= MAX_BODY_BYTES)?;
+        let count_body = Value::Object(
+            fields
+                .iter()
+                .filter(|(key, _)| COUNT_FIELDS.contains(&key.as_str()))
+                .map(|(key, value)| (key.clone(), value.clone()))
+                .collect(),
+        );
+        let count_encoded = EncodedJsonBody::encode(&count_body).map_err(|_| unsupported())?;
+        Ok(Self {
+            body,
+            encoded,
+            count_body,
+            count_encoded,
+            max_output_tokens,
+        })
+    }
+
+    /// Restore only canonical bytes produced by this boundary. Never rebuild from
+    /// current source/configuration or normalize an old retained body on recovery.
+    pub fn from_encoded(encoded: &[u8], model_output_limit: u64) -> Result<Self, ApiError> {
+        ensure(encoded.len() <= MAX_BODY_BYTES)?;
+        let body = serde_json::from_slice(encoded).map_err(|_| unsupported())?;
+        let restored = Self::new(body, model_output_limit)?;
+        ensure(restored.encoded_body() == encoded)?;
+        Ok(restored)
+    }
+
+    pub fn body(&self) -> &Value {
+        &self.body
+    }
+    pub fn encoded_body(&self) -> &[u8] {
+        self.encoded.as_bytes()
+    }
+    pub fn count_body(&self) -> &Value {
+        &self.count_body
+    }
+    pub fn max_output_tokens(&self) -> u64 {
+        self.max_output_tokens
+    }
+    pub(crate) fn encoded(&self) -> EncodedJsonBody {
+        self.encoded.clone()
+    }
+    pub(crate) fn count_encoded(&self) -> EncodedJsonBody {
+        self.count_encoded.clone()
+    }
+}
+
+fn unsupported() -> ApiError {
+    ApiError::InvalidRequest {
+        message: "unsupported frozen Responses request or count contract".to_string(),
+    }
+}
+
+fn ensure(condition: bool) -> Result<(), ApiError> {
+    if condition {
+        Ok(())
+    } else {
+        Err(unsupported())
+    }
+}
+
+fn object<'a>(value: &'a Value, allowed: &[&str]) -> Result<&'a Map<String, Value>, ApiError> {
+    let fields = value.as_object().ok_or_else(unsupported)?;
+    ensure(fields.keys().all(|key| allowed.contains(&key.as_str())))?;
+    Ok(fields)
+}
+
+fn strings(fields: &Map<String, Value>, keys: &[&str]) -> Result<(), ApiError> {
+    ensure(
+        keys.iter()
+            .all(|key| fields.get(*key).is_none_or(Value::is_string)),
+    )
+}
+
+fn name(value: Option<&Value>) -> bool {
+    value.and_then(Value::as_str).is_some_and(|s| {
+        !s.is_empty()
+            && s.len() <= 64
+            && s.bytes()
+                .all(|c| c.is_ascii_alphanumeric() || c == b'_' || c == b'-')
+    })
+}
+
+fn validate_numbers(value: &Value, depth: usize) -> Result<(), ApiError> {
+    ensure(depth <= 64)?;
+    match value {
+        Value::Number(number) => ensure(
+            number
+                .as_f64()
+                .is_some_and(|n| n.abs() <= MAX_SAFE_INTEGER as f64),
+        ),
+        Value::Array(items) => items
+            .iter()
+            .try_for_each(|item| validate_numbers(item, depth + 1)),
+        Value::Object(fields) => fields
+            .values()
+            .try_for_each(|item| validate_numbers(item, depth + 1)),
+        Value::Null | Value::Bool(_) | Value::String(_) => Ok(()),
+    }
+}
+
+fn validate_input(input: &Value) -> Result<(), ApiError> {
+    if input.is_string() {
+        return Ok(());
+    }
+    for item in input.as_array().ok_or_else(unsupported)? {
+        match item
+            .get("type")
+            .and_then(Value::as_str)
+            .unwrap_or("message")
+        {
+            "message" => {
+                let fields = object(item, &["type", "id", "status", "role", "content", "phase"])?;
+                strings(fields, &["type", "id", "status", "phase"])?;
+                ensure(
+                    fields.get("status").is_none_or(|v| {
+                        matches!(v.as_str(), Some("in_progress" | "completed" | "incomplete"))
+                    }) && fields
+                        .get("phase")
+                        .is_none_or(|v| matches!(v.as_str(), Some("commentary" | "final_answer"))),
+                )?;
+                ensure(matches!(
+                    fields.get("role").and_then(Value::as_str),
+                    Some("user" | "assistant" | "system" | "developer")
+                ))?;
+                let content = fields.get("content").ok_or_else(unsupported)?;
+                if !content.is_string() {
+                    for part in content.as_array().ok_or_else(unsupported)? {
+                        validate_content(part)?;
+                    }
+                }
+            }
+            "function_call" => {
+                let fields = object(
+                    item,
+                    &["type", "id", "status", "name", "call_id", "arguments"],
+                )?;
+                strings(fields, &["id", "status"])?;
+                ensure(
+                    ["name", "call_id", "arguments"]
+                        .iter()
+                        .all(|key| fields.get(*key).is_some_and(Value::is_string)),
+                )?;
+            }
+            "function_call_output" => {
+                let fields = object(item, &["type", "id", "status", "call_id", "output"])?;
+                strings(fields, &["id", "status"])?;
+                ensure(
+                    ["call_id", "output"]
+                        .iter()
+                        .all(|key| fields.get(*key).is_some_and(Value::is_string)),
+                )?;
+            }
+            // Reasoning history and hosted-tool records require separately
+            // qualified schemas; never replace them with a text approximation.
+            _ => return Err(unsupported()),
+        }
+    }
+    Ok(())
+}
+
+fn validate_content(part: &Value) -> Result<(), ApiError> {
+    match part.get("type").and_then(Value::as_str) {
+        Some("input_text") => {
+            object(part, &["type", "text"])?;
+            ensure(part.get("text").is_some_and(Value::is_string))
+        }
+        Some("output_text") => {
+            object(part, &["type", "text", "annotations", "logprobs"])?;
+            ensure(
+                part.get("text").is_some_and(Value::is_string)
+                    && ["annotations", "logprobs"].iter().all(|key| {
+                        part.get(*key)
+                            .is_none_or(|v| v.as_array().is_some_and(Vec::is_empty))
+                    }),
+            )
+        }
+        Some("input_image") => {
+            object(part, &["type", "image_url", "detail"])?;
+            ensure(
+                part.get("detail")
+                    .is_none_or(|v| matches!(v.as_str(), Some("auto" | "low" | "high"))),
+            )?;
+            let url = part
+                .get("image_url")
+                .and_then(Value::as_str)
+                .ok_or_else(unsupported)?;
+            retained_data(url, &["image/png", "image/jpeg", "image/webp", "image/gif"])
+        }
+        Some("input_file") => {
+            object(part, &["type", "filename", "file_data"])?;
+            ensure(part.get("filename").is_some_and(Value::is_string))?;
+            retained_data(
+                part.get("file_data")
+                    .and_then(Value::as_str)
+                    .ok_or_else(unsupported)?,
+                &["application/pdf"],
+            )
+        }
+        _ => Err(unsupported()),
+    }
+}
+
+fn retained_data(data: &str, media_types: &[&str]) -> Result<(), ApiError> {
+    let (prefix, payload) = data.split_once(";base64,").ok_or_else(unsupported)?;
+    ensure(payload.len() <= MAX_BODY_BYTES)?;
+    ensure(
+        media_types
+            .iter()
+            .any(|media| prefix.strip_prefix("data:") == Some(*media)),
+    )?;
+    let bytes = base64::engine::general_purpose::STANDARD
+        .decode(payload)
+        .map_err(|_| unsupported())?;
+    ensure(!bytes.is_empty())
+}
+
+fn validate_controls(fields: &Map<String, Value>) -> Result<(), ApiError> {
+    strings(fields, &["instructions", "personality", "prompt_cache_key"])?;
+    for key in ["store", "parallel_tool_calls"] {
+        ensure(fields.get(key).is_none_or(Value::is_boolean))?;
+    }
+    if let Some(include) = fields.get("include") {
+        ensure(include.as_array().is_some_and(|items| {
+            items.iter().all(|v| {
+                matches!(
+                    v.as_str(),
+                    Some("reasoning.encrypted_content" | "message.output_text.logprobs")
+                )
+            })
+        }))?;
+    }
+    if let Some(tier) = fields.get("service_tier") {
+        ensure(matches!(
+            tier.as_str(),
+            Some("auto" | "default" | "flex" | "priority")
+        ))?;
+    }
+    if let Some(metadata) = fields.get("metadata") {
+        let metadata = metadata.as_object().ok_or_else(unsupported)?;
+        ensure(
+            metadata.len() <= 16
+                && metadata.iter().all(|(key, value)| {
+                    key.len() <= 64 && value.as_str().is_some_and(|s| s.len() <= 512)
+                }),
+        )?;
+    }
+    if let Some(options) = fields.get("stream_options") {
+        let options = object(options, &["include_obfuscation"])?;
+        ensure(
+            options
+                .get("include_obfuscation")
+                .is_none_or(Value::is_boolean),
+        )?;
+    }
+    if let Some(reasoning) = fields.get("reasoning").filter(|v| !v.is_null()) {
+        let reasoning = object(reasoning, &["effort", "summary"])?;
+        ensure(reasoning.get("effort").is_none_or(|v| {
+            matches!(
+                v.as_str(),
+                Some("none" | "minimal" | "low" | "medium" | "high" | "xhigh")
+            )
+        }))?;
+        ensure(
+            reasoning
+                .get("summary")
+                .is_none_or(|v| matches!(v.as_str(), Some("auto" | "concise" | "detailed"))),
+        )?;
+    }
+    if let Some(text) = fields.get("text") {
+        let text = object(text, &["format", "verbosity"])?;
+        ensure(
+            text.get("verbosity")
+                .is_none_or(|v| matches!(v.as_str(), Some("low" | "medium" | "high"))),
+        )?;
+        if let Some(format) = text.get("format") {
+            match format.get("type").and_then(Value::as_str) {
+                Some("text" | "json_object") => {
+                    object(format, &["type"])?;
+                }
+                Some("json_schema") => {
+                    object(format, &["type", "name", "description", "schema", "strict"])?;
+                    ensure(
+                        name(format.get("name"))
+                            && format.get("schema").is_some_and(Value::is_object)
+                            && format.get("description").is_none_or(Value::is_string)
+                            && format.get("strict").is_none_or(Value::is_boolean),
+                    )?;
+                }
+                _ => return Err(unsupported()),
+            }
+        }
+    }
+    if let Some(choice) = fields.get("tool_choice") {
+        if choice.is_object() {
+            object(choice, &["type", "name"])?;
+            ensure(
+                choice.get("type").and_then(Value::as_str) == Some("function")
+                    && choice.get("name").is_some_and(Value::is_string),
+            )?;
+        } else {
+            ensure(matches!(
+                choice.as_str(),
+                Some("auto" | "none" | "required")
+            ))?;
+        }
+    }
+    if let Some(tools) = fields.get("tools") {
+        for tool in tools.as_array().ok_or_else(unsupported)? {
+            let tool = object(
+                tool,
+                &["type", "name", "description", "parameters", "strict"],
+            )?;
+            strings(tool, &["description"])?;
+            ensure(
+                tool.get("type").and_then(Value::as_str) == Some("function")
+                    && name(tool.get("name"))
+                    && tool.get("parameters").is_none_or(Value::is_object)
+                    && tool.get("strict").is_none_or(Value::is_boolean),
+            )?;
+        }
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+#[path = "frozen_responses_tests.rs"]
+mod tests;
