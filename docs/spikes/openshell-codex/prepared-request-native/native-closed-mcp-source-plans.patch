@@ -53,3 +53,67 @@ async fn hosted_plugin_runtime_forwards_thread_originator() -> Result<(), Box<dy
 
     Ok(())
 }
+
+#[tokio::test]
+async fn installed_sources_share_closed_absence_and_refuse_enabled_discovery()
+-> Result<(), Box<dyn std::error::Error>> {
+    let home = tempfile::tempdir()?;
+    let mut config = ConfigBuilder::default()
+        .codex_home(home.path().to_path_buf())
+        .fallback_cwd(Some(home.path().to_path_buf()))
+        .build()
+        .await?;
+    config.features.disable(codex_features::Feature::Apps)?;
+    config.features.disable(codex_features::Feature::Plugins)?;
+    let mut builder = ExtensionRegistryBuilder::new();
+    install(&mut builder);
+    install_plugins(
+        &mut builder,
+        std::sync::Arc::new(codex_exec_server::EnvironmentManager::default_for_tests()),
+    );
+    let registry = builder.build();
+    let closed = registry
+        .pre_session_mcp_overlays(McpPreSessionContext::new(&config, &[]))
+        .map_err(|indexes| format!("unresolved source indexes: {indexes:?}"))?;
+    assert_eq!(
+        closed,
+        vec![
+            McpPreSessionOverlay::RemoveServer {
+                name: CODEX_APPS_MCP_SERVER_NAME.to_string()
+            },
+            McpPreSessionOverlay::NoContributions
+        ]
+    );
+    let init = ExtensionDataInit::new();
+    let thread = ExtensionData::new("ordinary-thread");
+    let context = McpServerContributionContext::for_step(
+        &config,
+        &init,
+        &thread,
+        "ordinary-originator",
+        &[],
+        /*executor_capability_discovery*/ None,
+    );
+    let mut ordinary = Vec::new();
+    for source in registry.mcp_server_contributors() {
+        assert!(source.selected_plugins(context).await.is_empty());
+        ordinary.extend(source.contribute(context).await);
+    }
+    assert!(
+        matches!(ordinary.as_slice(), [McpServerContribution::Remove { name }] if name == CODEX_APPS_MCP_SERVER_NAME)
+    );
+    for (feature, index) in [
+        (codex_features::Feature::Apps, 0),
+        (codex_features::Feature::Plugins, 1),
+    ] {
+        let mut enabled = config.clone();
+        enabled.features.enable(feature)?;
+        assert!(
+            registry
+                .pre_session_mcp_overlays(McpPreSessionContext::new(&enabled, &[]))
+                .err()
+                .is_some_and(|indexes| indexes.contains(&index))
+        );
+    }
+    Ok(())
+}
