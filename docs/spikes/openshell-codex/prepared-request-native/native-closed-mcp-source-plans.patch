@@ -295,6 +319,42 @@ impl<C: Sync> ExtensionRegistry<C> {
         &self.mcp_server_contributors
     }
 
+    /// Resolves closed source overlays without any runtime contribution or
+    /// selected-plugin callbacks. Missing plans refuse before even the closed
+    /// functions run. Returned overlays are only a source partition, not proof
+    /// that configuration, environments or the complete tool inventory are empty.
+    pub fn pre_session_mcp_overlays(
+        &self,
+        context: McpPreSessionContext<'_, C>,
+    ) -> Result<Vec<McpPreSessionOverlay>, Vec<usize>> {
+        let missing: Vec<_> = self
+            .mcp_pre_session_plans
+            .iter()
+            .enumerate()
+            .filter_map(|(index, plan)| plan.is_none().then_some(index))
+            .collect();
+        if !missing.is_empty() {
+            return Err(missing);
+        }
+        let overlays: Vec<_> = self
+            .mcp_pre_session_plans
+            .iter()
+            .flatten()
+            .map(|plan| plan(context))
+            .collect();
+        let unresolved: Vec<_> = overlays
+            .iter()
+            .enumerate()
+            .filter_map(|(index, overlay)| {
+                matches!(overlay, McpPreSessionOverlay::Unresolved).then_some(index)
+            })
+            .collect();
+        if !unresolved.is_empty() {
+            return Err(unresolved);
+        }
+        Ok(overlays)
+    }
+
     /// Returns the registered turn-input contributors.
     pub fn turn_input_contributors(&self) -> &[Arc<dyn TurnInputContributor>] {
         &self.turn_input_contributors
diff --git a/codex-rs/ext/extension-api/tests/pre_session_mcp.rs b/codex-rs/ext/extension-api/tests/pre_session_mcp.rs
new file mode 100644
index 0000000..b7fbfe2
--- /dev/null
+++ b/codex-rs/ext/extension-api/tests/pre_session_mcp.rs
@@ -0,0 +1,94 @@
+use std::sync::Arc;
+use std::sync::atomic::AtomicUsize;
+use std::sync::atomic::Ordering;
+
+use codex_extension_api::ExtensionFuture;
+use codex_extension_api::ExtensionRegistryBuilder;
+use codex_extension_api::McpPreSessionContext;
+use codex_extension_api::McpPreSessionOverlay;
+use codex_extension_api::McpServerContribution;
+use codex_extension_api::McpServerContributionContext;
+use codex_extension_api::McpServerContributor;
+use pretty_assertions::assert_eq;
+
+enum SourceSelection {
+    Absent,
+    NeedsRuntime,
+}
+
+fn declared_selection(context: McpPreSessionContext<'_, SourceSelection>) -> McpPreSessionOverlay {
+    match context.config() {
+        SourceSelection::Absent => McpPreSessionOverlay::NoContributions,
+        SourceSelection::NeedsRuntime => McpPreSessionOverlay::Unresolved,
+    }
+}
+
+struct RuntimeSource(Arc<AtomicUsize>);
+
+impl McpServerContributor<SourceSelection> for RuntimeSource {
+    fn id(&self) -> &'static str {
+        "runtime-source"
+    }
+
+    fn contribute<'a>(
+        &'a self,
+        _context: McpServerContributionContext<'a, SourceSelection>,
+    ) -> ExtensionFuture<'a, Vec<McpServerContribution>> {
+        self.0.fetch_add(1, Ordering::SeqCst);
+        Box::pin(async {
+            vec![McpServerContribution::HostedApps {
+                config: Box::new(codex_mcp::codex_apps_mcp_server_config(
+                    "https://not-contacted.invalid",
+                    /*apps_mcp_product_sku*/ None,
+                    /*originator*/ None,
+                )),
+                protocol_mode: None,
+            }]
+        })
+    }
+}
+
+#[tokio::test]
+async fn closed_registration_owns_ordinary_metadata_instead_of_an_empty_inventory_promise() {
+    let calls = Arc::new(AtomicUsize::new(0));
+    let mut builder = ExtensionRegistryBuilder::new();
+    builder.mcp_server_contributor_with_pre_session_plan(
+        Arc::new(RuntimeSource(calls.clone())),
+        declared_selection,
+    );
+    let registry = builder.build();
+    assert_eq!(
+        registry.pre_session_mcp_overlays(McpPreSessionContext::new(&SourceSelection::Absent, &[])),
+        Ok(vec![McpPreSessionOverlay::NoContributions])
+    );
+    assert_eq!(calls.load(Ordering::SeqCst), 0);
+    assert!(
+        registry.mcp_server_contributors()[0]
+            .contribute(McpServerContributionContext::global(
+                &SourceSelection::Absent
+            ))
+            .await
+            .is_empty()
+    );
+    assert_eq!(calls.load(Ordering::SeqCst), 1);
+    // Unresolved is honest refusal before runtime discovery, while ordinary
+    // operation retains its existing dynamic source and lifecycle behavior.
+    assert_eq!(
+        registry.pre_session_mcp_overlays(McpPreSessionContext::new(
+            &SourceSelection::NeedsRuntime,
+            &[]
+        )),
+        Err(vec![0])
+    );
+    assert_eq!(calls.load(Ordering::SeqCst), 1);
+    assert!(matches!(
+        registry.mcp_server_contributors()[0]
+            .contribute(McpServerContributionContext::global(
+                &SourceSelection::NeedsRuntime
+            ))
+            .await
+            .as_slice(),
+        [McpServerContribution::HostedApps { .. }]
+    ));
+    assert_eq!(calls.load(Ordering::SeqCst), 2);
+}
