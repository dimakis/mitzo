+pub(crate) fn pre_session_plugin_plan(
+    context: codex_extension_api::McpPreSessionContext<'_, Config>,
+) -> codex_extension_api::McpPreSessionOverlay {
+    if !context.config().features.enabled(Feature::Plugins)
+        && context.selected_capability_roots().is_empty()
+    {
+        codex_extension_api::McpPreSessionOverlay::NoContributions
+    } else {
+        codex_extension_api::McpPreSessionOverlay::Unresolved
+    }
+}
