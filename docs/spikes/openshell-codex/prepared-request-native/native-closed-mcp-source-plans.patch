@@ -0,0 +1,124 @@
+use codex_protocol::capabilities::SelectedCapabilityRoot;
+use std::sync::Arc;
+
+use crate::ExtensionFuture;
+use crate::McpServerContribution;
+use crate::McpServerContributionContext;
+use crate::McpServerContributor;
+use crate::SelectedPlugin;
+
+/// Immutable selection inputs for a registered MCP source's closed plan.
+///
+/// Unlike runtime contribution context, this exposes no thread stores, clients,
+/// discovery or refresh capabilities. Plans must only inspect these values.
+pub struct McpPreSessionContext<'a, C> {
+    config: &'a C,
+    selected_capability_roots: &'a [SelectedCapabilityRoot],
+}
+
+impl<C> Clone for McpPreSessionContext<'_, C> {
+    fn clone(&self) -> Self {
+        *self
+    }
+}
+
+impl<C> Copy for McpPreSessionContext<'_, C> {}
+
+impl<'a, C> McpPreSessionContext<'a, C> {
+    pub fn new(config: &'a C, selected_capability_roots: &'a [SelectedCapabilityRoot]) -> Self {
+        Self {
+            config,
+            selected_capability_roots,
+        }
+    }
+
+    pub fn config(&self) -> &'a C {
+        self.config
+    }
+
+    pub fn selected_capability_roots(&self) -> &'a [SelectedCapabilityRoot] {
+        self.selected_capability_roots
+    }
+}
+
+/// Closed contribution outcomes supported before MCP activation.
+///
+/// There is deliberately no caller-supplied server/tool catalog. Sources that
+/// might add servers, connectors or selected plugin identities remain unresolved.
+/// Both closed variants settle the entire registered source contribution;
+/// even plugins without MCP servers must not be omitted by an absence plan.
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub enum McpPreSessionOverlay {
+    NoContributions,
+    RemoveServer { name: String },
+    Unresolved,
+}
+
+/// Source-owned, effect-free selection function registered beside its real
+/// runtime contributor. It must share the owner's ordinary selection logic;
+/// this is not permission to invoke a runtime callback during preparation.
+pub type McpPreSessionPlan<C> = for<'a> fn(McpPreSessionContext<'a, C>) -> McpPreSessionOverlay;
+
+pub(crate) struct PlannedMcpSource<C: Sync> {
+    pub(crate) contributor: Arc<dyn McpServerContributor<C>>,
+    pub(crate) plan: McpPreSessionPlan<C>,
+}
+
+impl<C: Sync> PlannedMcpSource<C> {
+    fn runtime_plan(&self, context: McpServerContributionContext<'_, C>) -> McpPreSessionOverlay {
+        let mut roots = context
+            .ready_selected_capability_roots()
+            .unwrap_or_default()
+            .to_vec();
+        if let Some(discovery) = context.executor_capability_discovery() {
+            roots.extend(
+                discovery
+                    .roots()
+                    .iter()
+                    .map(|root| root.selected_root.clone()),
+            );
+        }
+        (self.plan)(McpPreSessionContext::new(context.config(), &roots))
+    }
+}
+
+impl<C: Sync> McpServerContributor<C> for PlannedMcpSource<C> {
+    fn id(&self) -> &'static str {
+        self.contributor.id()
+    }
+
+    fn contribute<'a>(
+        &'a self,
+        context: McpServerContributionContext<'a, C>,
+    ) -> ExtensionFuture<'a, Vec<McpServerContribution>> {
+        Box::pin(async move {
+            let plan = self.runtime_plan(context);
+            // Preserve ordinary source cleanup/state effects. The registration's
+            // closed declaration owns metadata in BOTH paths, rather than merely
+            // promising that a separate runtime callback will return no servers.
+            let runtime = self.contributor.contribute(context).await;
+            match plan {
+                McpPreSessionOverlay::NoContributions => Vec::new(),
+                McpPreSessionOverlay::RemoveServer { name } => {
+                    vec![McpServerContribution::Remove { name }]
+                }
+                McpPreSessionOverlay::Unresolved => runtime,
+            }
+        })
+    }
+
+    fn selected_plugins<'a>(
+        &'a self,
+        context: McpServerContributionContext<'a, C>,
+    ) -> ExtensionFuture<'a, Vec<SelectedPlugin<'a>>> {
+        Box::pin(async move {
+            let plan = self.runtime_plan(context);
+            let runtime = self.contributor.selected_plugins(context).await;
+            match plan {
+                McpPreSessionOverlay::NoContributions
+                | McpPreSessionOverlay::RemoveServer { .. } => Vec::new(),
+                McpPreSessionOverlay::Unresolved => runtime,
+            }
+        })
+    }
+}
