+//! ORIGINAL ordered turn-input submission DATA. A generated Core queue ID and
+//! one-shot reply custody are not native-thread, selected-command or admission authority.
+use super::*;
+
+pub(super) struct OriginalTurnInputSubmission {
+    id: String,
+    request: TurnInputRequest,
+    mode: TurnInputMode,
+    reply_tx: oneshot::Sender<CodexResult<TurnInputSubmission>>,
+    reply_rx: oneshot::Receiver<CodexResult<TurnInputSubmission>>,
+    trace: Option<W3cTraceContext>,
+}
+impl OriginalTurnInputSubmission {
+    pub(super) fn capture(mut request: TurnInputRequest, mode: TurnInputMode) -> Self {
+        let id = new_submission_id();
+        let (reply_tx, reply_rx) = oneshot::channel();
+        let trace = request.trace.take();
+        Self {
+            id,
+            request,
+            mode,
+            reply_tx,
+            reply_rx,
+            trace,
+        }
+    }
+
+    pub(super) fn into_submission(
+        self,
+    ) -> (
+        Submission,
+        oneshot::Receiver<CodexResult<TurnInputSubmission>>,
+    ) {
+        let Self {
+            id,
+            request,
+            mode,
+            reply_tx,
+            reply_rx,
+            trace,
+        } = self;
+        (
+            Submission {
+                id,
+                op: Op::TurnInput {
+                    request: Box::new(request),
+                    mode,
+                    reply: reply_tx,
+                },
+                trace,
+                parent_turn_id: None,
+                root_turn_id: None,
+                residency_guard: None,
+            },
+            reply_rx,
+        )
+    }
+}
