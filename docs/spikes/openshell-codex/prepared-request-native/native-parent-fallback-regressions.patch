+//! TEST-ONLY scheduling after a real Some(scope) -> None; never an approval observation/grant.
+use crate::session::InterceptedApprovalSelection;
+use crate::tools::sandboxing::ApprovalAction;
+use std::sync::Arc;
+use std::sync::Mutex;
+use tokio::sync::Notify;
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct ParentFallbackMetadata {
+    call_id: String,
+    environment_id: String,
+    child_approval_id: String,
+}
+impl ParentFallbackMetadata {
+    pub(crate) fn identity(&self) -> (&str, &str, &str) {
+        (&self.call_id, &self.environment_id, &self.child_approval_id)
+    }
+}
+
+#[derive(Default)]
+pub(crate) struct ParentFallbackPause {
+    seen: Mutex<Vec<ParentFallbackMetadata>>,
+    entered: Notify,
+    release: Notify,
+}
+impl ParentFallbackPause {
+    pub(crate) fn observations(&self) -> Vec<ParentFallbackMetadata> {
+        self.seen.lock().unwrap().clone()
+    }
+    pub(crate) async fn wait(&self) -> ParentFallbackMetadata {
+        loop {
+            let observed = self.observations().first().cloned();
+            if let Some(observed) = observed {
+                return observed;
+            }
+            self.entered.notified().await;
+        }
+    }
+    pub(crate) fn release(&self) {
+        self.release.notify_one();
+    }
+    pub(crate) fn release_on_drop(self: &Arc<Self>) -> ParentFallbackRelease {
+        ParentFallbackRelease(Arc::clone(self))
+    }
+    // Sole future callsite: actual Some(scope).try_resolve returned None, before revalidation.
+    // No authority owner guards remain held, and successful Some never enters this method.
+    pub(super) async fn after_scope_none(&self, selected: &InterceptedApprovalSelection) {
+        let (action, _) = selected.approval_request();
+        let ApprovalAction::Execve {
+            id,
+            environment_id,
+            approval_id,
+            ..
+        } = action
+        else {
+            return;
+        };
+        self.seen.lock().unwrap().push(ParentFallbackMetadata {
+            call_id: id,
+            environment_id,
+            child_approval_id: approval_id,
+        });
+        self.entered.notify_one();
+        self.release.notified().await;
+    }
+}
+
+pub(crate) struct ParentFallbackRelease(Arc<ParentFallbackPause>);
+impl Drop for ParentFallbackRelease {
+    fn drop(&mut self) {
+        self.0.release();
+    }
+}
diff --git a/codex-rs/core/src/tools/runtimes/zsh_fork/parent_inheritance_boundary_tests.rs b/codex-rs/core/src/tools/runtimes/zsh_fork/parent_inheritance_boundary_tests.rs
