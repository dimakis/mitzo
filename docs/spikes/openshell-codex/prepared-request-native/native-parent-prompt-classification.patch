+//! Original policy observations and pure classification; never child approval.
+use super::*;
+use pretty_assertions::assert_eq;
+
+fn context(parsing: bool) -> InterceptedExecPolicyContext {
+    InterceptedExecPolicyContext {
+        approval_policy: AskForApproval::OnRequest,
+        permission_profile: PermissionProfile::read_only(),
+        windows_sandbox_level: WindowsSandboxLevel::Disabled,
+        sandbox_permissions: SandboxPermissions::RequireEscalated,
+        enable_shell_wrapper_parsing: parsing,
+    }
+}
+
+fn policy(source: &str) -> Arc<Policy> {
+    let mut parser = codex_execpolicy::PolicyParser::new();
+    parser.parse("q3.rules", source).unwrap();
+    Arc::new(parser.build())
+}
+
+fn command() -> AbsolutePathBuf {
+    AbsolutePathBuf::current_dir().unwrap().join("q3-command")
+}
+
+fn multi(policy: Arc<Policy>) -> CapturedInterceptedEvaluation {
+    CapturedInterceptedEvaluation::evaluate(
+        policy,
+        &AbsolutePathBuf::from_absolute_path("/bin/zsh").unwrap(),
+        &["zsh".into(), "-c".into(), "printf first; cat second".into()],
+        context(/*parsing*/ true),
+    )
+}
+
+#[test]
+fn captured_evaluation_keeps_original_arc_context_and_legacy_projection() {
+    let policy = policy("");
+    let program = command();
+    let argv = vec!["literal-argv-zero".into(), "argument".into()];
+    let original = context(/*parsing*/ false);
+    let observed = CapturedInterceptedEvaluation::evaluate(
+        Arc::clone(&policy),
+        &program,
+        &argv,
+        original.clone(),
+    );
+    assert!(Arc::ptr_eq(&observed.evaluated_policy, &policy));
+    assert_eq!(observed.context, original);
+    assert_eq!(
+        observed.commands,
+        vec![vec![
+            program.to_string_lossy().into_owned(),
+            "argument".into()
+        ]]
+    );
+    assert_eq!(
+        observed.evaluation,
+        evaluate_intercepted_exec_policy(&policy, &program, &argv, original)
+    );
+    assert_eq!(observed.evaluation.decision, Decision::Prompt);
+    let before = observed.clone();
+    assert!(observed.inherited_default_fallback_is_allow());
+    assert_eq!(observed.evaluation, before.evaluation);
+    assert_eq!(observed.commands, before.commands);
+    assert_eq!(observed.context, before.context);
+    assert!(Arc::ptr_eq(
+        &observed.evaluated_policy,
+        &before.evaluated_policy
+    ));
+}
+
+#[test]
+fn complete_multiple_heuristics_are_ordered_and_keep_original_prompt() {
+    let observed = multi(policy(""));
+    assert_eq!(
+        observed.commands,
+        vec![
+            vec!["printf".to_string(), "first".to_string()],
+            vec!["cat".to_string(), "second".to_string()],
+        ]
+    );
+    assert_eq!(observed.evaluation.decision, Decision::Prompt);
+    assert_eq!(
+        observed.evaluation.matched_rules.len(),
+        observed.commands.len()
+    );
+    for (matched, command) in observed
+        .evaluation
+        .matched_rules
+        .iter()
+        .zip(&observed.commands)
+    {
+        assert!(
+            matches!(matched, RuleMatch::HeuristicsRuleMatch { command: actual, .. } if actual == command)
+        );
+    }
+    assert!(observed.inherited_default_fallback_is_allow());
+    assert_eq!(observed.evaluation.decision, Decision::Prompt);
+}
+
+#[test]
+fn mixed_explicit_allow_and_heuristic_prompt_is_not_complete_fallback() {
+    let observed = multi(policy(
+        "prefix_rule(pattern=[\"printf\"], decision=\"allow\")",
+    ));
+    assert_eq!(observed.evaluation.decision, Decision::Prompt);
+    assert!(!CoreShellActionProvider::decision_driven_by_policy(
+        &observed.evaluation.matched_rules,
+        observed.evaluation.decision,
+    ));
+    assert!(
+        observed
+            .evaluation
+            .matched_rules
+            .iter()
+            .any(|matched| !matches!(matched, RuleMatch::HeuristicsRuleMatch { .. }))
+    );
+    assert!(
+        observed
+            .evaluation
+            .matched_rules
+            .iter()
+            .any(|matched| matches!(matched, RuleMatch::HeuristicsRuleMatch { .. }))
+    );
+    assert!(!observed.inherited_default_fallback_is_allow());
+}
+
+#[test]
+fn actual_explicit_prompt_and_forbidden_are_ineligible() {
+    let program = command();
+    for (source_decision, decision) in [
+        ("prompt", Decision::Prompt),
+        ("forbidden", Decision::Forbidden),
+    ] {
+        let source = format!(
+            "prefix_rule(pattern=[{}], decision=\"{source_decision}\")",
+            serde_json::to_string(&program.to_string_lossy()).unwrap()
+        );
+        let observed = CapturedInterceptedEvaluation::evaluate(
+            policy(&source),
+            &program,
+            &["argv-zero".into()],
+            context(/*parsing*/ false),
+        );
+        assert_eq!(observed.evaluation.decision, decision);
+        assert!(!observed.inherited_default_fallback_is_allow());
+    }
+}
+
+#[test]
+fn dangerous_default_still_requires_review_without_mutating_original_flags() {
+    let observed = CapturedInterceptedEvaluation::evaluate(
+        policy(""),
+        &AbsolutePathBuf::from_absolute_path("/bin/rm").unwrap(),
+        &["rm".into(), "-rf".into(), "/".into()],
+        context(/*parsing*/ false),
+    );
+    assert_eq!(observed.evaluation.decision, Decision::Prompt);
+    assert_eq!(
+        crate::exec_policy::render_decision_for_unmatched_command(
+            &observed.commands[0],
+            crate::exec_policy::UnmatchedCommandContext {
+                approval_policy: observed.context.approval_policy,
+                permission_profile: &observed.context.permission_profile,
+                windows_sandbox_level: observed.context.windows_sandbox_level,
+                sandbox_permissions: SandboxPermissions::UseDefault,
+                command_origin: crate::exec_policy::ExecPolicyCommandOrigin::Generic,
+            },
+        ),
+        Decision::Prompt
+    );
+    assert!(!observed.inherited_default_fallback_is_allow());
+    assert_eq!(
+        observed.context.sandbox_permissions,
+        SandboxPermissions::RequireEscalated
+    );
+}
+
+#[test]
+fn incomplete_empty_reordered_and_foreign_observations_refuse() {
+    let original = multi(policy(""));
+    assert!(original.inherited_default_fallback_is_allow());
+    for corruption in [
+        "empty-list",
+        "empty-command",
+        "missing",
+        "extra",
+        "reordered",
+        "foreign-command",
+        "foreign-match",
+        "allow",
+    ] {
+        let mut observed = original.clone();
+        match corruption {
+            "empty-list" => observed.commands.clear(),
+            "empty-command" => observed.commands[0].clear(),
+            "missing" => {
+                observed.evaluation.matched_rules.pop();
+            }
+            "extra" => observed
+                .evaluation
+                .matched_rules
+                .push(observed.evaluation.matched_rules[0].clone()),
+            "reordered" => observed.commands.reverse(),
+            "foreign-command" => observed.commands[0][0] = "foreign-command".into(),
+            "foreign-match" => {
+                let RuleMatch::HeuristicsRuleMatch { command, .. } =
+                    &mut observed.evaluation.matched_rules[0]
+                else {
+                    panic!("actual heuristic fixture")
+                };
+                command[0] = "foreign-match".into();
+            }
+            "allow" => observed.evaluation.decision = Decision::Allow,
+            _ => unreachable!(),
+        }
+        assert!(
+            !observed.inherited_default_fallback_is_allow(),
+            "{corruption}"
+        );
+    }
+}
+
+#[test]
+fn actual_context_policy_and_raw_permission_are_required() {
+    let original = multi(policy(""));
+    for approval_policy in [AskForApproval::Never, AskForApproval::UnlessTrusted] {
+        let mut observed = original.clone();
+        observed.context.approval_policy = approval_policy;
+        assert!(!observed.inherited_default_fallback_is_allow());
+    }
+    for permission in [
+        SandboxPermissions::UseDefault,
+        SandboxPermissions::WithAdditionalPermissions,
+    ] {
+        let mut observed = original.clone();
+        observed.context.sandbox_permissions = permission;
+        assert!(!observed.inherited_default_fallback_is_allow());
+    }
+    assert_eq!(original.context, context(/*parsing*/ true));
+    assert!(original.inherited_default_fallback_is_allow());
+}
+
+#[test]
+fn host_resolved_input_retains_the_literal_original_heuristic_vector() -> anyhow::Result<()> {
+    let root = tempfile::tempdir()?;
+    let literal = root.path().join("literal-symlink-command");
+    std::os::unix::fs::symlink(std::env::current_exe()?, &literal)?;
+    let program = AbsolutePathBuf::try_from(literal)?;
+    let expected = vec![
+        program.to_string_lossy().into_owned(),
+        "literal-argument".into(),
+    ];
+    let observed = CapturedInterceptedEvaluation::evaluate(
+        policy(""),
+        &program,
+        &["unrelated-argv-zero".into(), "literal-argument".into()],
+        context(/*parsing*/ false),
+    );
+    assert_eq!(observed.commands, vec![expected.clone()]);
+    assert_eq!(observed.evaluation.matched_rules.len(), 1);
+    assert!(
+        matches!(&observed.evaluation.matched_rules[0], RuleMatch::HeuristicsRuleMatch { command, .. } if *command == expected)
+    );
+    assert!(observed.inherited_default_fallback_is_allow());
+    Ok(())
+}
