+/// Original evaluation data only, never permission to admit an intercepted command.
 #[derive(Clone)]
+struct CapturedInterceptedEvaluation {
+    evaluated_policy: Arc<Policy>,
+    evaluation: Evaluation,
+    commands: Vec<Vec<String>>,
+    context: InterceptedExecPolicyContext,
+}
+
+impl CapturedInterceptedEvaluation {
+    fn evaluate(
+        evaluated_policy: Arc<Policy>,
+        program: &AbsolutePathBuf,
+        argv: &[String],
+        context: InterceptedExecPolicyContext,
+    ) -> Self {
+        let (evaluation, commands, context) =
+            evaluate_intercepted_exec_policy_inner(&evaluated_policy, program, argv, context);
+        Self {
+            evaluated_policy,
+            evaluation,
+            commands,
+            context,
+        }
+    }
+
+    /// Inert classification; actual routing, issuer, physical and lifetime gates are separate.
+    fn inherited_default_fallback_is_allow(&self) -> bool {
+        if self.evaluation.decision != Decision::Prompt
+            || self.context.approval_policy != AskForApproval::OnRequest
+            || self.context.sandbox_permissions != SandboxPermissions::RequireEscalated
+            || self.commands.is_empty()
+            || self.evaluation.matched_rules.len() != self.commands.len()
+        {
+            return false;
+        }
+        self.commands
+            .iter()
+            .zip(&self.evaluation.matched_rules)
+            .all(|(command, matched)| {
+                let RuleMatch::HeuristicsRuleMatch {
+                    command: original, ..
+                } = matched
+                else {
+                    return false;
+                };
+                !command.is_empty()
+                    && original == command
+                    && crate::exec_policy::render_decision_for_unmatched_command(
+                        command,
+                        crate::exec_policy::UnmatchedCommandContext {
+                            approval_policy: self.context.approval_policy,
+                            permission_profile: &self.context.permission_profile,
+                            windows_sandbox_level: self.context.windows_sandbox_level,
+                            sandbox_permissions: SandboxPermissions::UseDefault,
+                            command_origin: crate::exec_policy::ExecPolicyCommandOrigin::Generic,
+                        },
+                    ) == Decision::Allow
+            })
+    }
+}
+
