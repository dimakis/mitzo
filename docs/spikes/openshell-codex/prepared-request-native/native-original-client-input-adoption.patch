+#[tokio::test]
+async fn actual_absent_header_and_original_channels_are_retained_and_consumed_once() {
+    use crate::CodexResponsesHeaders;
+    use codex_model_provider::WorkspaceRoutingContext;
+    use codex_protocol::protocol::Event;
+    use codex_protocol::protocol::EventMsg;
+    use codex_protocol::protocol::WarningEvent;
+
+    let (_home, config, manager) = fixture().await;
+    let mut events = manager.state.thread_created_tx.subscribe();
+    let mut selected = manager
+        .prepare_selected_start(StartThreadOptions::new(config))
+        .await
+        .unwrap();
+    let retained_routing = selected
+        .start_options()
+        .unwrap()
+        .thread_extension_init
+        .get::<WorkspaceRoutingContext>()
+        .unwrap();
+    let adoption = manager.adopt_selected_start(&mut selected).unwrap();
+    let (_control, mut inputs) = adoption.allocation.into_parts();
+    inputs
+        .validate_init(
+            &adoption.options.thread_extension_init,
+            adoption.options.reserved_thread_id,
+        )
+        .unwrap();
+    assert!(
+        adoption
+            .options
+            .thread_extension_init
+            .get::<CodexResponsesHeaders>()
+            .is_none()
+    );
+    assert!(inputs.headers.is_none());
+    assert!(Arc::ptr_eq(&inputs.routing, &retained_routing));
+    let channels = inputs.take_channels().unwrap();
+    assert!(inputs.take_channels().is_err());
+    let warning = Event {
+        id: "data-channel-only".to_string(),
+        msg: EventMsg::Warning(WarningEvent {
+            message: "no session was started".to_string(),
+        }),
+    };
+    channels.tx_event.try_send(warning.clone()).unwrap();
+    assert_eq!(
+        serde_json::to_value(channels.rx_event.try_recv().unwrap()).unwrap(),
+        serde_json::to_value(warning).unwrap()
+    );
+    assert!(channels.rx_event.try_recv().is_err());
+    // The legacy None path uses this SAME original channel allocator. Closing
+    // either original submission endpoint is visible to the retained peer.
+    drop(channels.tx_sub);
+    assert!(channels.rx_sub.is_closed());
+    assert!(manager.list_thread_ids().await.is_empty());
+    assert!(matches!(
+        events.try_recv(),
+        Err(tokio::sync::broadcast::error::TryRecvError::Empty)
+    ));
+}
+
+#[tokio::test]
+async fn changed_header_routing_identity_and_recorder_projection_refuse() {
+    use crate::CodexResponsesHeaders;
+    use codex_features::Feature;
+
+    let (_home, config, manager) = fixture().await;
+    let mut selected = manager
+        .prepare_selected_start(StartThreadOptions::new(config))
+        .await
+        .unwrap();
+    let adoption = manager.adopt_selected_start(&mut selected).unwrap();
+    let (_control, inputs) = adoption.allocation.into_parts();
+    let init = &adoption.options.thread_extension_init;
+    let id = adoption.options.reserved_thread_id;
+    inputs.validate_init(init, id).unwrap();
+    let mut changed = init.clone();
+    changed.insert(CodexResponsesHeaders {
+        model: "introduced".to_string(),
+        headers: http::HeaderMap::new(),
+    });
+    assert!(inputs.validate_init(&changed, id).is_err());
+    let mut changed = init.clone();
+    changed.insert(adoption.options.config.workspace_routing_context());
+    assert!(inputs.validate_init(&changed, id).is_err());
+    assert!(inputs.validate_init(init, Some(ThreadId::new())).is_err());
+    let mut changed_config = adoption.options.config.clone();
+    changed_config.chatgpt_base_url.push_str("/changed");
+    assert!(inputs.validate_config(&changed_config).is_err());
+    let mut changed_config = adoption.options.config.clone();
+    if changed_config
+        .features
+        .enabled(Feature::ExecutedToolCallMetadata)
+    {
+        changed_config
+            .features
+            .disable(Feature::ExecutedToolCallMetadata);
+    } else {
+        changed_config
+            .features
+            .enable(Feature::ExecutedToolCallMetadata);
+    }
+    assert!(inputs.validate_config(&changed_config).is_err());
+    // A refused validation does not replace the retained input or consume it.
+    inputs.validate_init(init, id).unwrap();
+    inputs.validate_config(&adoption.options.config).unwrap();
+    assert!(manager.list_thread_ids().await.is_empty());
+}
