diff --git a/codex-rs/core/src/session/client_input_data.rs b/codex-rs/core/src/session/client_input_data.rs
new file mode 100644
index 0000000000000000000000000000000000000000..bf89a787e86f643be0aca71771ed3a5568b70cbc
--- /dev/null
+++ b/codex-rs/core/src/session/client_input_data.rs
@@ -0,0 +1,125 @@
+//! Original client INPUT allocations, never a ModelClient or readiness grant.
+//! Retain actual init values/history and move the same owners into ordinary
+//! startup. No Session/Turn/ExtensionData, transport, auth or lifecycle is made.
+use super::*;
+use crate::CodexResponsesHeaders;
+use crate::state::ExecutedToolCalls;
+use codex_model_provider::WorkspaceRoutingContext;
+use std::io;
+
+pub(crate) struct SessionChannels {
+    pub(crate) tx_sub: Sender<Submission>,
+    pub(crate) rx_sub: Receiver<Submission>,
+    pub(crate) tx_event: Sender<Event>,
+    pub(crate) rx_event: Receiver<Event>,
+}
+impl SessionChannels {
+    pub(crate) fn allocate() -> Self {
+        let (tx_sub, rx_sub) = async_channel::bounded(SUBMISSION_CHANNEL_CAPACITY);
+        let (tx_event, rx_event) = async_channel::unbounded();
+        Self {
+            tx_sub,
+            rx_sub,
+            tx_event,
+            rx_event,
+        }
+    }
+}
+
+/// Retained data owners only. The init map shares interior-mutable values; these
+/// checks do not certify arbitrary extension state or selected config currency.
+pub(crate) struct OriginalClientInputData {
+    thread_id: ThreadId,
+    init: ExtensionDataInit,
+    routing_config: (String, AbsolutePathBuf, codex_config::ConfigLayerStack),
+    pub(crate) routing: Arc<WorkspaceRoutingContext>,
+    pub(crate) headers: Option<Arc<CodexResponsesHeaders>>,
+    pub(crate) executed: ExecutedToolCalls,
+    recorder_enabled: bool,
+    channels: Option<SessionChannels>,
+}
+fn same_optional<T>(a: &Option<Arc<T>>, b: &Option<Arc<T>>) -> bool {
+    match (a, b) {
+        (Some(a), Some(b)) => Arc::ptr_eq(a, b),
+        (None, None) => true,
+        _ => false,
+    }
+}
+impl OriginalClientInputData {
+    pub(crate) fn allocate(
+        config: &Config,
+        history: &InitialHistory,
+        init: &mut ExtensionDataInit,
+        thread_id: ThreadId,
+    ) -> Self {
+        if init.get::<WorkspaceRoutingContext>().is_none() {
+            init.insert(config.workspace_routing_context());
+        }
+        let routing = init
+            .get::<WorkspaceRoutingContext>()
+            .expect("original routing was inserted");
+        Self {
+            thread_id,
+            init: init.clone(),
+            routing_config: (
+                config.chatgpt_base_url.clone(),
+                config.cwd.clone(),
+                config.config_layer_stack.clone(),
+            ),
+            routing,
+            headers: init.get::<CodexResponsesHeaders>(),
+            executed: ExecutedToolCalls::new(&config.features, history),
+            recorder_enabled: ExecutedToolCalls::is_enabled(&config.features),
+            channels: Some(SessionChannels::allocate()),
+        }
+    }
+    pub(crate) fn validate_init(
+        &self,
+        init: &ExtensionDataInit,
+        thread_id: Option<ThreadId>,
+    ) -> io::Result<()> {
+        if thread_id != Some(self.thread_id)
+            || !same_optional(
+                &self.init.get::<WorkspaceRoutingContext>(),
+                &init.get::<WorkspaceRoutingContext>(),
+            )
+            || !same_optional(&self.headers, &init.get::<CodexResponsesHeaders>())
+        {
+            return Err(io::Error::other("retained original client init changed"));
+        }
+        Ok(())
+    }
+    pub(crate) fn take_channels(&mut self) -> io::Result<SessionChannels> {
+        self.channels
+            .take()
+            .ok_or_else(|| io::Error::other("original channels already adopted"))
+    }
+    pub(crate) fn validate_config(&self, config: &Config) -> io::Result<()> {
+        if self.routing_config
+            != (
+                config.chatgpt_base_url.clone(),
+                config.cwd.clone(),
+                config.config_layer_stack.clone(),
+            )
+            || self.recorder_enabled != ExecutedToolCalls::is_enabled(&config.features)
+        {
+            return Err(io::Error::other("retained original client config changed"));
+        }
+        Ok(())
+    }
+    pub(crate) fn validate_scope(
+        &self,
+        scope: &codex_extension_api::ExtensionData,
+    ) -> io::Result<()> {
+        if !scope
+            .get::<WorkspaceRoutingContext>()
+            .is_some_and(|routing| Arc::ptr_eq(&self.routing, &routing))
+            || !same_optional(&self.headers, &scope.get::<CodexResponsesHeaders>())
+        {
+            return Err(io::Error::other(
+                "ordinary lifecycle changed retained client metadata",
+            ));
+        }
+        Ok(())
+    }
+}
