+        .thread_extension_init
+        .get::<WorkspaceRoutingContext>()
+        .unwrap();
+    let mut selected = manager.prepare_selected_start(options).await.unwrap();
+    let adoption = manager.adopt_selected_start(&mut selected).unwrap();
+    let original_id = adoption.options.reserved_thread_id.unwrap();
+    let (_control, inputs) = adoption.allocation.into_parts();
+    inputs
+        .validate_init(&adoption.options.thread_extension_init, Some(original_id))
