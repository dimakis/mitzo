+    pub(crate) async fn retain_extension_tools(
+        &mut self,
+        manager: &ThreadManager,
+    ) -> io::Result<()> {
+        let result = async {
+            self.renew(manager).await?;
+            self.installed
+                .as_ref()
+                .ok_or_else(|| io::Error::other("original first-command composition missing"))?
+                .observe(
+                    manager,
+                    self.start
+                        .mcp_sources()
+                        .ok_or_else(|| io::Error::other("original API MCP sources missing"))?,
+                )
+                .map_err(|error| io::Error::other(format!("{error:?}")))?;
+            manager.retain_selected_start_extension_tools(&mut self.start)?;
+            self.installed
+                .as_ref()
+                .ok_or_else(|| io::Error::other("original first-command composition missing"))?
+                .observe(
+                    manager,
+                    self.start
+                        .mcp_sources()
+                        .ok_or_else(|| io::Error::other("original API MCP sources missing"))?,
+                )
+                .map_err(|error| io::Error::other(format!("{error:?}")))?;
+            self.renew(manager).await
+        }
+        .await;
+        if result.is_err() {
+            self.source.invalidated.store(true, Ordering::Release);
+        }
