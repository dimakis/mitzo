+enum OriginalExtensionToolSlot {
+    Uncaptured,
+    Retained(Arc<OriginalPreparedExtensionTools>),
+    Consumed,
+}
+
+/// Original registry-minted extension partition, not the final Core/MCP plan.
+/// Config is the retained selected effective DATA snapshot; selection renewal
+/// is not a whole-Config/account/permission currentness grant.
+pub(crate) struct OriginalPreparedExtensionTools {
+    thread_id: ThreadId,
+    registry: Arc<codex_extension_api::ExtensionRegistry<Config>>,
+    config: Config,
+    source: SessionSource,
+    capture: codex_extension_api::PreSessionExtensionTools,
+}
+impl OriginalPreparedExtensionTools {
+    fn renew(
+        &self,
+        thread_id: ThreadId,
+        registry: &Arc<codex_extension_api::ExtensionRegistry<Config>>,
+        config: &Config,
+        source: &SessionSource,
+    ) -> io::Result<()> {
+        if thread_id != self.thread_id
+            || !Arc::ptr_eq(registry, &self.registry)
+            || source != &self.source
+        {
+            return Err(io::Error::other("prepared extension tool owner changed"));
+        }
+        self.registry
+            .renew_pre_session_tools_for_source(&self.capture, &self.config, &self.source)
+            .map_err(io::Error::other)?;
+        registry
+            .renew_pre_session_tools_for_source(&self.capture, config, source)
+            .map_err(io::Error::other)
+    }
+}
+
+pub(crate) enum PreparedExtensionToolTurnKind {
+    User,
+    Unsupported,
+}
+
+enum PreparedExtensionToolState {
+    Pending(Arc<OriginalPreparedExtensionTools>),
+    Binding(Arc<()>),
+    Bound(
+        Arc<OriginalPreparedExtensionTools>,
+        std::sync::Weak<super::turn_context::TurnContext>,
+    ),
+    Failed,
+}
+
+pub(crate) struct PreparedExtensionToolBinding {
+    token: Arc<()>,
+    plan: Arc<OriginalPreparedExtensionTools>,
+}
+
+/// One actual Session's pending/bound partition. Failure or cancellation while
+/// binding cannot restore Pending or become the ordinary None path. No lock is
+/// held while plans, metadata getters or other original callbacks are invoked.
+pub(crate) struct PreparedExtensionToolCarry {
+    state: std::sync::Mutex<PreparedExtensionToolState>,
+}
+impl PreparedExtensionToolCarry {
+    pub(crate) fn begin_turn(
+        &self,
+        kind: PreparedExtensionToolTurnKind,
+    ) -> io::Result<PreparedExtensionToolBinding> {
+        let mut state = self
+            .state
+            .lock()
+            .map_err(|_| io::Error::other("prepared tool custody poisoned"))?;
+        let previous = std::mem::replace(&mut *state, PreparedExtensionToolState::Failed);
+        match (kind, previous) {
+            (PreparedExtensionToolTurnKind::User, PreparedExtensionToolState::Pending(plan)) => {
+                let token = Arc::new(());
+                *state = PreparedExtensionToolState::Binding(Arc::clone(&token));
+                Ok(PreparedExtensionToolBinding { token, plan })
+            }
+            _ => Err(io::Error::other(
+                "prepared tools require their one admitted User turn",
+            )),
+        }
+    }
+    pub(crate) fn bind_turn(
+        &self,
+        binding: PreparedExtensionToolBinding,
+        session: &super::session::Session,
+        turn: &Arc<super::turn_context::TurnContext>,
+    ) -> io::Result<()> {
+        let renewed = binding.plan.renew(
+            session.thread_id(),
+            &session.services.extensions,
+            &turn.config,
+            &turn.session_source,
+        );
+        let mut state = self
+            .state
+            .lock()
+            .map_err(|_| io::Error::other("prepared tool custody poisoned"))?;
+        if renewed.is_err()
+            || !matches!(&*state, PreparedExtensionToolState::Binding(token) if Arc::ptr_eq(token, &binding.token))
+        {
+            *state = PreparedExtensionToolState::Failed;
+            return Err(io::Error::other("prepared tool turn binding changed"));
+        }
+        *state = PreparedExtensionToolState::Bound(binding.plan, Arc::downgrade(turn));
+        Ok(())
+    }
+    pub(crate) fn plan_for_turn(
+        &self,
+        turn: &super::turn_context::TurnContext,
+    ) -> io::Result<Arc<OriginalPreparedExtensionTools>> {
+        let state = self
+            .state
+            .lock()
+            .map_err(|_| io::Error::other("prepared tool custody poisoned"))?;
+        if let PreparedExtensionToolState::Bound(plan, owner) = &*state
+            && owner
+                .upgrade()
+                .is_some_and(|owner| std::ptr::eq(owner.as_ref(), turn))
+        {
+            return Ok(Arc::clone(plan));
+        }
+        Err(io::Error::other(
+            "prepared tools are not bound to this turn",
+        ))
+    }
+    pub(crate) fn associate(
+        &self,
+        plan: &Arc<OriginalPreparedExtensionTools>,
+        session: &super::session::Session,
+        turn: &super::turn_context::TurnContext,
+        executors: &[Arc<dyn for<'call> codex_tools::ToolExecutor<codex_tools::ToolCall<'call>>>],
+    ) -> io::Result<()> {
+        let result = (|| {
+            if !Arc::ptr_eq(plan, &self.plan_for_turn(turn)?) {
+                return Err(io::Error::other("prepared tool partition changed"));
+            }
+            plan.renew(
+                session.thread_id(),
+                &session.services.extensions,
+                &turn.config,
+                &turn.session_source,
+            )?;
+            session
+                .services
+                .extensions
+                .associate_pre_session_tools_for_source(
+                    &plan.capture,
+                    &turn.config,
+                    &turn.session_source,
+                    executors,
+                )
+                .map_err(io::Error::other)?;
+            // Refuse invalidation which occurred while callbacks ran, too.
+            if !Arc::ptr_eq(plan, &self.plan_for_turn(turn)?) {
+                return Err(io::Error::other("prepared tool partition changed"));
+            }
+            Ok(())
+        })();
+        if result.is_err() {
+            *self
+                .state
+                .lock()
+                .map_err(|_| io::Error::other("prepared tool custody poisoned"))? =
+                PreparedExtensionToolState::Failed;
+        }
+        result
+    }
+}
