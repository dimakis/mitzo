+#[tokio::test]
+async fn retained_tool_carrier_burns_foreign_allocation_and_repeated_install_or_take()
+-> anyhow::Result<()> {
+    let (session, turn) = crate::session::tests::make_session_and_context().await;
+    let config = &turn.config;
+    let source = &turn.session_source;
+    let registry = Arc::clone(&session.services.extensions);
+    let make = || {
+        let mut init = ExtensionDataInit::default();
+        OriginalClientInputData::allocate(
+            config,
+            &InitialHistory::New,
+            &mut init,
+            session.thread_id(),
+        )
+    };
+    let capture = || registry.capture_pre_session_tools_for_source(config, source);
+    let mut carrier = make();
+    carrier.retain_extension_tools(Arc::clone(&registry), config, source, capture()?)?;
+    assert!(
+        carrier
+            .take_extension_tools(ThreadId::new(), &registry, config, source)
+            .is_err()
+    );
+    assert!(
+        carrier
+            .take_extension_tools(session.thread_id(), &registry, config, source)
+            .is_err()
+    );
+    let mut carrier = make();
+    carrier.retain_extension_tools(Arc::clone(&registry), config, source, capture()?)?;
+    assert!(
