+#[tokio::test]
+async fn retained_tools_bind_only_actual_admitted_user_and_reject_automatic_or_recovery()
+-> anyhow::Result<()> {
+    use crate::session::client_input_data::OriginalClientInputData;
+    for kind in [
+        TurnStartKind::Automatic,
+        TurnStartKind::Recovery,
+        TurnStartKind::User,
+    ] {
+        let (mut session, turn) = make_session_and_context().await;
+        session.services.prepared_extension_tools =
+            Some(OriginalClientInputData::extension_tool_carry_fixture(
+                &session,
+                &turn.config,
+                &turn.session_source,
+            )?);
+        let session = Arc::new(session);
+        // A real context-only build must not take pending admitted-work custody.
+        let context_only = session.new_default_turn().await;
+        let carry = session.services.prepared_extension_tools.as_ref().unwrap();
+        assert!(carry.plan_for_turn(&context_only).is_err());
+        let prepared = PreparedTurnInputSettings::prepare(
+            &session,
+            ThreadSettingsOverrides::default(),
+            TurnStartOptions::default(),
+        )
+        .await?;
+        let result = prepared
+            .apply_started(&session, "retained-user".to_string(), kind)
+            .await;
+        match kind {
+            TurnStartKind::User => {
+                let admitted = result?.unwrap();
+                let plan = carry.plan_for_turn(&admitted)?;
+                assert!(Arc::ptr_eq(&plan, &carry.plan_for_turn(&admitted)?));
+                assert!(carry.plan_for_turn(&context_only).is_err());
+                assert!(Arc::ptr_eq(&plan, &carry.plan_for_turn(&admitted)?));
+            }
+            TurnStartKind::Automatic | TurnStartKind::Recovery => {
+                assert!(result.is_err());
+                let next = PreparedTurnInputSettings::prepare(
+                    &session,
+                    ThreadSettingsOverrides::default(),
+                    TurnStartOptions::default(),
+                )
+                .await?;
+                assert!(
+                    next.apply_started(&session, "cannot-recover".to_string(), TurnStartKind::User)
+                        .await
+                        .is_err()
+                );
+            }
+        }
+        assert!(session.active_turn.lock().await.is_none());
+    }
+    Ok(())
+}
