+#[tokio::test]
+async fn retained_router_metadata_mismatch_burns_before_adapter_and_cannot_fall_back()
+-> anyhow::Result<()> {
+    use crate::session::client_input_data::OriginalClientInputData;
+    use crate::session::client_input_data::PreparedExtensionToolTurnKind;
+    let (mut session, turn) = make_session_and_context().await;
+    let mut turn = Arc::new(turn);
+    let trace = Arc::new(Mutex::new(Vec::new()));
+    let captured_ephemeral = turn.config.ephemeral;
+    let mut builder = codex_extension_api::ExtensionRegistryBuilder::<crate::config::Config>::new();
+    builder.tool_contributor_with_source_pre_session_plan(
+        Arc::new(OrderedPlanningContributor {
+            event: "mismatching_contributor",
+            trace: Arc::clone(&trace),
+            role_path: None,
+            return_tool: false,
+        }),
+        Arc::new(|_| codex_extension_api::ToolPreSessionSelection::Unresolved),
+        Arc::new(move |config, _| {
+            if config.ephemeral != captured_ephemeral {
+                codex_extension_api::SourceToolPreSessionSelection::Unresolved
+            } else {
+                codex_extension_api::SourceToolPreSessionSelection::Definitions(
+                    vec![
+                        codex_extension_api::ExtensionToolDefinition::from_default_spec(
+                            ToolName::namespaced("ordering", "probe"),
+                            TestNamespaceExtensionTool {
+                                namespace: "ordering",
+                                tool_name: "probe",
+                            }
+                            .spec(),
+                        ),
+                    ]
+                    .into(),
+                )
+            }
+        }),
+    );
+    session.services.extensions = builder.build();
+    // The original test Config is retained; no production eligibility/default is changed.
+    let changed_config = OriginalClientInputData::extension_tool_carry_fixture(
+        &session,
+        &turn.config,
+        &turn.session_source,
+    )?;
+    let binding = changed_config.begin_turn(PreparedExtensionToolTurnKind::User)?;
+    Arc::make_mut(&mut Arc::get_mut(&mut turn).unwrap().config).ephemeral = !captured_ephemeral;
+    assert!(changed_config.bind_turn(binding, &session, &turn).is_err());
+    Arc::make_mut(&mut Arc::get_mut(&mut turn).unwrap().config).ephemeral = captured_ephemeral;
+    assert!(
+        changed_config
+            .begin_turn(PreparedExtensionToolTurnKind::User)
+            .is_err()
+    );
+    let changed_source = OriginalClientInputData::extension_tool_carry_fixture(
+        &session,
+        &turn.config,
+        &turn.session_source,
+    )?;
+    let binding = changed_source.begin_turn(PreparedExtensionToolTurnKind::User)?;
+    let original_source = turn.session_source.clone();
+    Arc::get_mut(&mut turn).unwrap().session_source =
+        SessionSource::SubAgent(SubAgentSource::Review);
+    assert!(changed_source.bind_turn(binding, &session, &turn).is_err());
+    Arc::get_mut(&mut turn).unwrap().session_source = original_source;
+    assert!(
+        changed_source
+            .begin_turn(PreparedExtensionToolTurnKind::User)
+            .is_err()
+    );
+    let carry = OriginalClientInputData::extension_tool_carry_fixture(
+        &session,
+        &turn.config,
+        &turn.session_source,
+    )?;
+    let binding = carry.begin_turn(PreparedExtensionToolTurnKind::User)?;
+    carry.bind_turn(binding, &session, &turn)?;
+    session.services.prepared_extension_tools = Some(carry);
+    let mcp = Arc::new(codex_mcp::McpBinding::empty(mcp_config_for_test(
+        &turn.config,
+    )));
+    trace.lock().unwrap().clear();
+    assert!(
+        super::build_tool_router(
+            &session,
+            &turn,
+            turn.model_info(),
+            &turn.initial_environments,
+            &mcp,
+            false,
+            &turn.extension_data,
+            None
+        )
+        .is_err()
+    );
+    assert_eq!(*trace.lock().unwrap(), vec!["mismatching_contributor"]);
+    // A later valid selection cannot turn this failed association into None.
+    trace.lock().unwrap().clear();
+    assert!(
+        super::build_tool_router(
+            &session,
+            &turn,
+            turn.model_info(),
+            &turn.initial_environments,
+            &mcp,
+            false,
+            &turn.extension_data,
+            None
+        )
+        .is_err()
+    );
+    assert!(trace.lock().unwrap().is_empty());
+    Ok(())
+}
