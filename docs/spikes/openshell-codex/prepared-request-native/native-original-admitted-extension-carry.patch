+async fn retained_tool_binding_ignores_unbound_contexts_and_never_recovers_after_cancel_or_failure()
+-> anyhow::Result<()> {
+    let (session, turn) = crate::session::tests::make_session_and_context().await;
+    let turn = Arc::new(turn);
+    let carry = OriginalClientInputData::extension_tool_carry_fixture(
+        &session,
+        &turn.config,
+        &turn.session_source,
+    )?;
+    assert!(carry.plan_for_turn(&turn).is_err());
+    let binding = carry.begin_turn(PreparedExtensionToolTurnKind::User)?;
+    carry.bind_turn(binding, &session, &turn)?;
+    let first = carry.plan_for_turn(&turn)?;
+    assert!(Arc::ptr_eq(&first, &carry.plan_for_turn(&turn)?));
+    let (_, foreign_turn) = crate::session::tests::make_session_and_context().await;
+    assert!(carry.plan_for_turn(&foreign_turn).is_err());
+    assert!(Arc::ptr_eq(&first, &carry.plan_for_turn(&turn)?));
+    assert!(
+        carry
+            .begin_turn(PreparedExtensionToolTurnKind::User)
+            .is_err()
+    );
+    assert!(carry.plan_for_turn(&turn).is_err());
+
+    let cancelled = OriginalClientInputData::extension_tool_carry_fixture(
+        &session,
+        &turn.config,
+        &turn.session_source,
+    )?;
+    drop(cancelled.begin_turn(PreparedExtensionToolTurnKind::User)?);
+    assert!(
+        cancelled
+            .begin_turn(PreparedExtensionToolTurnKind::User)
+            .is_err()
+    );
+    assert!(cancelled.plan_for_turn(&turn).is_err());
+
+    let failed = OriginalClientInputData::extension_tool_carry_fixture(
+        &session,
+        &turn.config,
+        &turn.session_source,
+    )?;
+    let binding = failed.begin_turn(PreparedExtensionToolTurnKind::User)?;
+    let (foreign_session, _) = crate::session::tests::make_session_and_context().await;
+    assert!(failed.bind_turn(binding, &foreign_session, &turn).is_err());
+    assert!(
+        failed
+            .begin_turn(PreparedExtensionToolTurnKind::User)
+            .is_err()
+    );
+    Ok(())
+}
