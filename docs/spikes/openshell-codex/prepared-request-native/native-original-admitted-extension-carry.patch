+#[tokio::test]
+async fn retained_actual_registry_iterator_associates_before_router_and_preserves_final_specs()
+-> anyhow::Result<()> {
+    use crate::session::client_input_data::OriginalClientInputData;
+    use crate::session::client_input_data::PreparedExtensionToolTurnKind;
+    let (mut session, turn) = make_session_and_context().await;
+    let turn = Arc::new(turn);
+    let trace = Arc::new(Mutex::new(Vec::new()));
+    let mut builder = codex_extension_api::ExtensionRegistryBuilder::<crate::config::Config>::new();
+    builder.tool_contributor_with_source_pre_session_plan(
+        Arc::new(OrderedPlanningContributor {
+            event: "retained_contributor",
+            trace: Arc::clone(&trace),
+            role_path: None,
+            return_tool: true,
+        }),
+        Arc::new(|_| codex_extension_api::ToolPreSessionSelection::Unresolved),
+        Arc::new(|_, _| {
+            codex_extension_api::SourceToolPreSessionSelection::Definitions(
+                vec![
+                    codex_extension_api::ExtensionToolDefinition::from_default_spec(
+                        ToolName::namespaced("ordering", "probe"),
+                        TestNamespaceExtensionTool {
+                            namespace: "ordering",
+                            tool_name: "probe",
+                        }
+                        .spec(),
+                    ),
+                ]
+                .into(),
+            )
+        }),
+    );
+    session.services.extensions = builder.build();
+    let mcp = Arc::new(codex_mcp::McpBinding::empty(mcp_config_for_test(
+        &turn.config,
+    )));
+    let ordinary = super::build_tool_router(
+        &session,
+        &turn,
+        turn.model_info(),
+        &turn.initial_environments,
+        &mcp,
+        false,
+        &turn.extension_data,
+        None,
+    )?;
+    session.services.prepared_extension_tools =
+        Some(OriginalClientInputData::extension_tool_carry_fixture(
+            &session,
+            &turn.config,
+            &turn.session_source,
+        )?);
+    let carry = session.services.prepared_extension_tools.as_ref().unwrap();
+    // No callback/tool execution occurs in capture or binding.
+    trace.lock().unwrap().clear();
+    let binding = carry.begin_turn(PreparedExtensionToolTurnKind::User)?;
+    carry.bind_turn(binding, &session, &turn)?;
+    assert!(trace.lock().unwrap().is_empty());
+    for _ in 0..2 {
+        trace.lock().unwrap().clear();
+        let prepared = super::build_tool_router(
+            &session,
+            &turn,
+            turn.model_info(),
+            &turn.initial_environments,
+            &mcp,
+            false,
+            &turn.extension_data,
+            None,
+        )?;
+        assert_eq!(
+            prepared.model_visible_specs(),
+            ordinary.model_visible_specs()
+        );
+        assert_eq!(
+            trace
+                .lock()
+                .unwrap()
+                .iter()
+                .filter(|event| **event == "retained_contributor")
+                .count(),
+            1
+        );
+    }
+    let foreign = session.new_default_turn().await;
+    trace.lock().unwrap().clear();
+    assert!(
+        super::build_tool_router(
+            &session,
+            &foreign,
+            foreign.model_info(),
+            &foreign.initial_environments,
+            &mcp,
+            false,
+            &foreign.extension_data,
+            None
+        )
+        .is_err()
+    );
+    assert!(!trace.lock().unwrap().contains(&"retained_contributor"));
+    Ok(())
+}
