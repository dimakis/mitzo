+use std::collections::HashMap;
+use std::sync::Arc;
+
+use codex_config::Constrained;
+use codex_config::config_toml::ConfigToml;
+use codex_exec_server::EnvironmentManager;
+use codex_extension_api::ExtensionRegistryBuilder;
+use codex_login::CodexAuth;
+use codex_skills_extension::ExecutorSkillProvider;
+use codex_skills_extension::HostSkillProvider;
+use codex_skills_extension::SkillProviders;
+use codex_skills_extension::SkillsExtensionConfig;
+use codex_utils_absolute_path::AbsolutePathBuf;
+use pretty_assertions::assert_eq;
+
+use super::*;
+use crate::McpManager;
+use crate::config::ConfigOverrides;
+use crate::thread_manager::StartThreadOptions;
+
+async fn config(home: &tempfile::TempDir) -> Config {
+    let toml: ConfigToml =
+        toml::from_str("model='gpt-6-luna'\n[skills.bundled]\nenabled=false\n").unwrap();
+    let mut config = Config::load_from_base_config_with_overrides(
+        toml,
+        ConfigOverrides {
+            cwd: Some(home.path().to_path_buf()),
+            ..Default::default()
+        },
+        AbsolutePathBuf::from_absolute_path(home.path()).unwrap(),
+    )
+    .await
+    .unwrap();
+    config.features.disable(Feature::Apps).unwrap();
+    config.features.disable(Feature::Plugins).unwrap();
+    config
+        .features
+        .disable(Feature::SkipHostSkillDiscovery)
+        .unwrap();
+    config.mcp_servers = Constrained::allow_any(HashMap::new());
+    config
+}
+
+fn manager(config: &Config) -> ThreadManager {
+    let environment_manager = Arc::new(EnvironmentManager::default_for_tests());
+    let mut manager = ThreadManager::with_models_provider_and_home_for_tests(
+        CodexAuth::from_api_key("offline-no-model-call"),
+        config.model_provider.clone(),
+        config.codex_home.to_path_buf(),
+        Arc::clone(&environment_manager),
+    );
+    let mut registry = ExtensionRegistryBuilder::<Config>::new();
+    let providers = SkillProviders::new()
+        .with_native_host_provider(Arc::new(HostSkillProvider::new()))
+        .with_native_executor_provider(Arc::new(
+            ExecutorSkillProvider::new_with_restriction_product(
+                environment_manager,
+                /*restriction_product*/ None,
+            ),
+        ));
+    codex_skills_extension::install_with_providers(&mut registry, providers, |config| {
+        SkillsExtensionConfig {
+            include_instructions: false,
+            max_context_tokens: None,
+            bundled_skills_enabled: config.bundled_skills_enabled(),
+            cloud_skill_enabled: false,
+            shadow_selection_enabled: false,
+        }
+    });
+    let state = Arc::get_mut(&mut manager.state).unwrap();
+    state.extensions = Arc::new(registry.build());
+    state.mcp_manager = Arc::new(McpManager::new_with_extensions(
+        Arc::clone(&state.plugins_manager),
+        Arc::clone(&state.extensions),
+        state.mcp_manager.codex_apps_tools_cache(),
+    ));
+    manager
+}
+
+#[tokio::test]
+async fn original_thread_manager_captures_hidden_knowledge_and_native_model_without_startup() {
+    let home = tempfile::tempdir().unwrap();
+    let config = config(&home).await;
+    let skill = home.path().join("skills/original-knowledge");
+    std::fs::create_dir_all(&skill).unwrap();
+    let text = "---\nname: original-knowledge\ndescription: Original host Knowledge\n---\nCORE_SELECTED_KNOWLEDGE_BYTES\n";
+    std::fs::write(skill.join("SKILL.md"), text).unwrap();
+    let manager = manager(&config);
+    let mut created = manager.state.thread_created_tx.subscribe();
+    let sources = manager
+        .capture_pre_session_mcp_sources(StartThreadOptions::new(config.clone()))
+        .unwrap();
+    let input = vec![UserInput::Text {
+        text: "$original-knowledge".into(),
+        text_elements: Vec::new(),
+    }];
+    let observed = manager
+        .observe_pre_session_skills(&sources, &input)
+        .await
+        .unwrap();
+    assert_eq!(
+        observed
+            .skills()
+            .host_observation()
+            .source_bytes()
+            .map(|(_, bytes)| bytes)
+            .collect::<Vec<_>>(),
+        vec![text]
+    );
+    assert_eq!(observed.skills().user_input(), input.as_slice());
+    assert_eq!(
+        serde_json::to_value(observed.skills().model()).unwrap(),
+        serde_json::to_value(observed.model_candidate().model_info()).unwrap()
+    );
+    assert_eq!(observed.skills().model().slug, "gpt-6-luna");
+    assert_eq!(
+        manager
+            .state
+            .environment_manager
+            .with_current_selected_environment_publications(
+                observed.environment_publication(),
+                || 41,
+            ),
+        Ok(41)
+    );
+    assert!(observed.skills().initial_world_state().is_empty());
+    assert!(!observed.skills().host_items().is_empty());
+    assert!(observed.skills().tool_specs().is_empty());
+    assert!(
+        manager
+            .state
+            .extensions
+            .capture_pre_session_tools()
+            .is_err()
+    );
+    assert!(manager.state.threads.read().await.is_empty());
+    assert!(matches!(
+        created.try_recv(),
+        Err(tokio::sync::broadcast::error::TryRecvError::Empty)
+    ));
+    std::fs::remove_file(skill.join("SKILL.md")).unwrap();
+    assert_eq!(
+        observed
+            .skills()
+            .host_observation()
+            .source_bytes()
+            .next()
+            .unwrap()
+            .1,
+        text
+    );
+    // Retained bytes are data, not a file-currentness/admission grant.
+    assert!(!observed.skills().host_items().is_empty());
+}
+
+#[tokio::test]
+async fn foreign_fresh_source_packet_refuses_before_source_capture_or_session_creation() {
+    let home = tempfile::tempdir().unwrap();
+    let config = config(&home).await;
+    let original = manager(&config);
+    let foreign = manager(&config);
+    let sources = foreign
+        .capture_pre_session_mcp_sources(StartThreadOptions::new(config))
+        .unwrap();
+    assert!(
+        original
+            .observe_pre_session_skills(&sources, &[])
+            .await
+            .is_err()
+    );
+    assert!(original.state.threads.read().await.is_empty());
+    assert!(foreign.state.threads.read().await.is_empty());
+}
