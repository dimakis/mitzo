@@ -0,0 +1,166 @@
+use std::sync::Arc;
+
+use codex_protocol::capabilities::CapabilityRootLocation;
+use codex_protocol::capabilities::SelectedCapabilityRoot;
+
+use crate::Environment;
+use crate::EnvironmentManager;
+use crate::EnvironmentReadyInfo;
+use crate::ResolvedSelectedCapabilityRoot;
+
+#[cfg(test)]
+#[path = "environment_publication_tests.rs"]
+mod tests;
+
+/// Original manager entries and accepted Ready-report allocations captured under
+/// their actual publisher lock. This does not grant connection, filesystem,
+/// permission, configuration or selected-root authority.
+pub struct SelectedEnvironmentPublicationObservation<'a> {
+    manager: &'a EnvironmentManager,
+    entries: Vec<SelectedEnvironmentPublication>,
+}
+
+struct SelectedEnvironmentPublication {
+    environment_id: String,
+    selected_root: Option<SelectedCapabilityRoot>,
+    environment: Arc<Environment>,
+    ready_report: Option<Arc<EnvironmentReadyInfo>>,
+}
+
+#[derive(Debug, PartialEq, Eq)]
+pub enum SelectedEnvironmentPublicationError {
+    MissingEnvironment,
+    ForeignManager,
+    ChangedEnvironment,
+    ChangedReadyReport,
+    DifferentResolvedRoots,
+}
+
+impl EnvironmentManager {
+    /// Passive observation only. Pending environments can be observed; this
+    /// operation never starts, waits for or probes a connection.
+    pub fn observe_selected_environment_publications(
+        &self,
+        selected_roots: &[SelectedCapabilityRoot],
+    ) -> Result<SelectedEnvironmentPublicationObservation<'_>, SelectedEnvironmentPublicationError>
+    {
+        let environments = self
+            .environments
+            .read()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        let mut entries = Vec::with_capacity(selected_roots.len());
+        for selected_root in selected_roots {
+            let CapabilityRootLocation::Environment { environment_id, .. } =
+                &selected_root.location;
+            let environment = environments
+                .get(environment_id)
+                .ok_or(SelectedEnvironmentPublicationError::MissingEnvironment)?;
+            entries.push(SelectedEnvironmentPublication {
+                environment_id: environment_id.clone(),
+                selected_root: Some(selected_root.clone()),
+                environment: Arc::clone(environment),
+                ready_report: environment.last_ready_info(),
+            });
+        }
+        Ok(SelectedEnvironmentPublicationObservation {
+            manager: self,
+            entries,
+        })
+    }
+
+    /// Captures original selection-owned environment handles without inventing
+    /// capability roots. Every supplied handle must still be the actual map
+    /// entry under the original publisher lock before its report is captured.
+    pub fn observe_selected_environment_handles(
+        &self,
+        handles: &[(String, Arc<Environment>)],
+    ) -> Result<SelectedEnvironmentPublicationObservation<'_>, SelectedEnvironmentPublicationError>
+    {
+        let environments = self
+            .environments
+            .read()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        let mut entries = Vec::with_capacity(handles.len());
+        for (environment_id, captured) in handles {
+            let current = environments
+                .get(environment_id)
+                .ok_or(SelectedEnvironmentPublicationError::MissingEnvironment)?;
+            if !Arc::ptr_eq(current, captured) {
+                return Err(SelectedEnvironmentPublicationError::ChangedEnvironment);
+            }
+            entries.push(SelectedEnvironmentPublication {
+                environment_id: environment_id.clone(),
+                selected_root: None,
+                environment: Arc::clone(current),
+                ready_report: current.last_ready_info(),
+            });
+        }
+        Ok(SelectedEnvironmentPublicationObservation {
+            manager: self,
+            entries,
+        })
+    }
+
+    /// Runs a bounded synchronous action while the ORIGINAL manager read lock
+    /// excludes entry replacement and accepted Ready-report publication. Equal
+    /// report contents republished on the same Environment still invalidate.
+    /// Async work returned by the action is outside this fence; callers must
+    /// perform their actual synchronous commit before the action returns.
+    /// Connection retirement and external filesystem writes use other owners
+    /// and are deliberately not covered by this publication fence.
+    pub fn with_current_selected_environment_publications<R>(
+        &self,
+        observation: &SelectedEnvironmentPublicationObservation<'_>,
+        action: impl FnOnce() -> R,
+    ) -> Result<R, SelectedEnvironmentPublicationError> {
+        if !std::ptr::eq(self, observation.manager) {
+            return Err(SelectedEnvironmentPublicationError::ForeignManager);
+        }
+        let environments = self
+            .environments
+            .read()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        for entry in &observation.entries {
+            let current = environments
+                .get(&entry.environment_id)
+                .ok_or(SelectedEnvironmentPublicationError::ChangedEnvironment)?;
+            if !Arc::ptr_eq(current, &entry.environment) {
+                return Err(SelectedEnvironmentPublicationError::ChangedEnvironment);
+            }
+            let same_report = match (&entry.ready_report, current.last_ready_info()) {
+                (None, None) => true,
+                (Some(captured), Some(current)) => Arc::ptr_eq(captured, &current),
+                (None, Some(_)) | (Some(_), None) => false,
+            };
+            if !same_report {
+                return Err(SelectedEnvironmentPublicationError::ChangedReadyReport);
+            }
+        }
+        let result = action();
+        drop(environments);
+        Ok(result)
+    }
+}
+
+impl SelectedEnvironmentPublicationObservation<'_> {
+    /// Binds the actual passive resolver output to the captured entries before
+    /// discovery. ID or equal root data cannot substitute a different handle.
+    pub fn assert_resolved_roots(
+        &self,
+        resolved_roots: &[ResolvedSelectedCapabilityRoot],
+    ) -> Result<(), SelectedEnvironmentPublicationError> {
+        if self.entries.len() != resolved_roots.len()
+            || self
+                .entries
+                .iter()
+                .zip(resolved_roots)
+                .any(|(entry, root)| {
+                    entry.selected_root.as_ref() != Some(root.selected_root())
+                        || !Arc::ptr_eq(&entry.environment, root.environment())
+                })
+        {
+            return Err(SelectedEnvironmentPublicationError::DifferentResolvedRoots);
+        }
+        Ok(())
+    }
+}
