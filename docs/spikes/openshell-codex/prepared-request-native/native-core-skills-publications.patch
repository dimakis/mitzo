+use std::cell::Cell;
+use std::sync::Arc;
+
+use codex_protocol::capabilities::CapabilityRootLocation;
+use codex_protocol::capabilities::SelectedCapabilityRoot;
+use codex_utils_path_uri::PathUri;
+use futures::FutureExt;
+use futures::future::BoxFuture;
+use pretty_assertions::assert_eq;
+
+use crate::EnvironmentManager;
+use crate::EnvironmentReadyInfo;
+use crate::ExecServerError;
+use crate::NoiseChannelPublicKey;
+use crate::NoiseRendezvousConnectBundle;
+use crate::NoiseRendezvousConnectProvider;
+use crate::SelectedEnvironmentPublicationError;
+
+struct UnusedProvider;
+
+impl NoiseRendezvousConnectProvider for UnusedProvider {
+    fn connect_bundle(
+        &self,
+        _: NoiseChannelPublicKey,
+    ) -> BoxFuture<'_, Result<NoiseRendezvousConnectBundle, ExecServerError>> {
+        async { panic!("publication observation must never start a connection") }.boxed()
+    }
+}
+
+fn root(environment_id: &str) -> SelectedCapabilityRoot {
+    SelectedCapabilityRoot {
+        id: "publication-root".into(),
+        location: CapabilityRootLocation::Environment {
+            environment_id: environment_id.into(),
+            path: PathUri::parse("file:///publication-root").unwrap(),
+        },
+    }
+}
+
+#[tokio::test]
+async fn publication_action_holds_original_writer_lock_and_rejects_foreign_manager() {
+    let manager = EnvironmentManager::default_for_tests();
+    let foreign = EnvironmentManager::default_for_tests();
+    let observation = manager
+        .observe_selected_environment_publications(&[root("local")])
+        .unwrap();
+    let invoked = Cell::new(false);
+    let result = manager.with_current_selected_environment_publications(&observation, || {
+        assert!(manager.environments.try_write().is_err());
+        invoked.set(true);
+        17
+    });
+    assert_eq!(result, Ok(17));
+    assert!(invoked.get());
+    assert!(manager.environments.try_write().is_ok());
+    assert_eq!(
+        foreign.with_current_selected_environment_publications(&observation, || {
+            panic!("foreign manager cannot commit")
+        }),
+        Err::<(), _>(SelectedEnvironmentPublicationError::ForeignManager)
+    );
+}
+
+#[tokio::test]
+async fn every_ready_report_republication_invalidates_even_identical_contents_and_same_environment()
+{
+    let manager = EnvironmentManager::default_for_tests();
+    let provider = Arc::new(UnusedProvider);
+    let original = manager
+        .materialize_pending_noise_environment("tools".into(), provider.clone())
+        .unwrap();
+    let pending = manager
+        .observe_selected_environment_publications(&[root("tools")])
+        .unwrap();
+    assert!(original.last_ready_info().is_none());
+    manager
+        .report_environment_provisioning_status(
+            "tools".into(),
+            Ok(EnvironmentReadyInfo::default()),
+            provider.clone(),
+        )
+        .unwrap();
+    assert_eq!(
+        manager.with_current_selected_environment_publications(&pending, || {
+            panic!("None and Some(empty report) are different publications")
+        }),
+        Err::<(), _>(SelectedEnvironmentPublicationError::ChangedReadyReport)
+    );
+    let ready = manager
+        .observe_selected_environment_publications(&[root("tools")])
+        .unwrap();
+    let handles = manager
+        .observe_selected_environment_handles(&[("tools".into(), Arc::clone(&original))])
+        .unwrap();
+    manager
+        .report_environment_provisioning_status(
+            "tools".into(),
+            Ok(EnvironmentReadyInfo::default()),
+            provider,
+        )
+        .unwrap();
+    assert!(Arc::ptr_eq(
+        &original,
+        &manager.get_environment("tools").unwrap()
+    ));
+    assert_eq!(
+        manager.with_current_selected_environment_publications(&ready, || {
+            panic!("equal-data Ready-to-Ready publication must invalidate")
