@@ -0,0 +1,151 @@
+//! Genuine fresh Skills observations through the original ThreadManager owners.
+//! This is one source partition. It cannot count, commit, create a Session or
+//! grant complete context/tool/account/source-currentness authority.
+#![cfg_attr(
+    not(test),
+    allow(dead_code, reason = "Fresh prepared factory is being connected.")
+)]
+
+use std::collections::HashMap;
+
+use codex_exec_server::SelectedEnvironmentPublicationObservation;
+use codex_features::Feature;
+use codex_models_manager::model_limits::UnverifiedModelLimitCandidate;
+use codex_protocol::error::CodexErr;
+use codex_protocol::error::Result as CodexResult;
+use codex_protocol::user_input::UserInput;
+use codex_skills_extension::SkillsContextObservation;
+use codex_skills_extension::registered_skills_sources;
+
+use super::ThreadManager;
+use crate::PreSessionMcpSources;
+use crate::config::Config;
+
+#[cfg(test)]
+#[path = "pre_session_skills_tests.rs"]
+mod tests;
+
+pub(crate) struct PreSessionSkillsObservation<'a> {
+    model: UnverifiedModelLimitCandidate,
+    skills: SkillsContextObservation<'a, Config>,
+    environment_publication: SelectedEnvironmentPublicationObservation<'a>,
+}
+
+impl PreSessionSkillsObservation<'_> {
+    pub(crate) fn model_candidate(&self) -> &UnverifiedModelLimitCandidate {
+        &self.model
+    }
+
+    pub(crate) fn skills(&self) -> &SkillsContextObservation<'_, Config> {
+        &self.skills
+    }
+
+    pub(crate) fn environment_publication(&self) -> &SelectedEnvironmentPublicationObservation<'_> {
+        &self.environment_publication
+    }
+}
+
+fn unavailable() -> CodexErr {
+    CodexErr::InvalidRequest("fresh native Skills source is unavailable".into())
+}
+
+impl ThreadManager {
+    /// Requires this manager's genuine inherited, fresh MCP-absence packet.
+    /// Configured Apps/plugins/root inventories remain refused by that source
+    /// rather than being dropped to construct a successful Skills observation.
+    /// Model metadata is captured passively from the original catalog; it is
+    /// explicitly unverified for selected-account/provider access.
+    pub(crate) async fn observe_pre_session_skills<'a>(
+        &'a self,
+        sources: &PreSessionMcpSources,
+        input: &[UserInput],
+    ) -> CodexResult<PreSessionSkillsObservation<'a>> {
+        self.validate_pre_session_mcp_sources(sources)
+            .map_err(|_| unavailable())?;
+        let config = &sources.start_options().config;
+        let environment_publication = self
+            .state
+            .environment_manager
+            .observe_selected_environment_handles(sources.captured_environment_handles())
+            .map_err(|_| unavailable())?;
+        if config.features.enabled(Feature::SkipHostSkillDiscovery) {
+            return Err(unavailable());
+        }
+        let registered = registered_skills_sources(&self.state.extensions);
+        let [source] = registered.as_slice() else {
+            return Err(unavailable());
+        };
+        let model_id = config.model.as_deref().ok_or_else(unavailable)?;
+        let model = self
+            .state
+            .models_manager
+            .capture_model_limit_candidate(model_id, &config.to_models_manager_config())
+            .await
+            .ok_or_else(unavailable)?;
+        // Apps/plugins/selected roots have already been excluded by the actual
+        // MCP source, so their connector counts and effective plugin roots are
+        // genuinely empty for this supported partition. Other configurations
+        // need their original source collectors before this path can support them.
+        let input = source
+            .observe_first_input(
+                &self.state.extensions,
+                config,
+                model.model_info(),
+                input,
+                &HashMap::new(),
+            )
+            .map_err(|_| unavailable())?;
+        let executor = source
+            .observe_executor_source(
+                &self.state.extensions,
+                &[],
+                &HashMap::new(),
+                /*selected_plugins*/ None,
+            )
+            .await
+            .map_err(|_| unavailable())?;
+        let host = self
+            .state
+            .skills_service
+            .observe_pre_session_for_config(
+                &crate::skills_load_input_from_config(config, Vec::new()),
+                sources.primary_filesystem(),
+            )
+            .await
+            .map_err(|_| unavailable())?;
+        self.state
+            .skills_service
+            .assert_pre_session_observation_owner(&host)
+            .map_err(|_| unavailable())?;
+        let skills = source
+            .observe_first_context(input, host, executor)
+            .await
+            .map_err(|_| unavailable())?;
+        self.validate_pre_session_mcp_sources(sources)
+            .map_err(|_| unavailable())?;
+        self.state
+            .skills_service
+            .assert_pre_session_prompt_observation_owner(skills.host_observation())
+            .map_err(|_| unavailable())?;
+        self.state
+            .skills_service
+            .with_current_pre_session_prompt_roots(skills.host_observation(), || ())
+            .map_err(|_| unavailable())?;
+        let catalog = self
+            .state
+            .models_manager
+            .pin_model_limit_candidate(&model)
+            .await
+            .ok_or_else(unavailable)?;
+        drop(catalog);
+        self.state
+            .environment_manager
+            .with_current_selected_environment_publications(&environment_publication, || ())
+            .map_err(|_| unavailable())?;
+        Ok(PreSessionSkillsObservation {
+            model,
+            skills,
+            environment_publication,
+        })
+    }
+}
