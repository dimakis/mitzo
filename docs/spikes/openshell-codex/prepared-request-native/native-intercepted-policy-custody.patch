+//! Actual intercepted review owners; no model requests or parent receipts.
+use super::*;
+use crate::session::step_context::StepContext;
+use crate::session::tests::make_session_and_context_with_auth_and_config_and_rx;
+use crate::tasks::SessionTask;
+use crate::tasks::SessionTaskResult;
+use codex_extension_api::ApprovalDecision;
+use codex_extension_api::ApprovalReviewContributor;
+use codex_protocol::config_types::ApprovalsReviewer;
+use codex_protocol::protocol::Event;
+use codex_protocol::protocol::EventMsg;
+use codex_protocol::protocol::TurnAbortReason;
+use pretty_assertions::assert_eq;
+use std::sync::atomic::AtomicUsize;
+use std::sync::atomic::Ordering;
+use tokio::sync::Notify;
+use tokio::time::Duration;
+
+struct PendingTask;
+impl SessionTask for PendingTask {
+    fn kind(&self) -> crate::state::TaskKind {
+        crate::state::TaskKind::Regular
+    }
+    fn span_name(&self) -> &'static str {
+        "intercepted_context_test"
+    }
+    async fn run(
+        self: Arc<Self>,
+        _session: Arc<crate::session::session::Session>,
+        _turn: Arc<crate::session::turn_context::TurnContext>,
+        _input: Vec<crate::session::TurnInput>,
+        cancellation: CancellationToken,
+    ) -> SessionTaskResult {
+        cancellation.cancelled().await;
+        Ok(None)
+    }
+}
+struct Contributor {
+    calls: Arc<AtomicUsize>,
+    decision: Option<ApprovalDecision>,
+    entered: Arc<Notify>,
+    release: Option<Arc<Notify>>,
+}
+impl ApprovalReviewContributor for Contributor {
+    fn decide<'a>(
+        &'a self,
+        _input: &'a codex_extension_api::ApprovalDecisionInput<'_>,
+    ) -> codex_extension_api::ExtensionFuture<'a, Option<ApprovalDecision>> {
+        Box::pin(async move {
+            self.calls.fetch_add(1, Ordering::SeqCst);
+            self.entered.notify_one();
+            if let Some(release) = &self.release {
+                release.notified().await;
+            }
+            self.decision.clone()
+        })
+    }
+}
+struct Fixture {
+    provider: CoreShellActionProvider,
+    events: async_channel::Receiver<Event>,
+    calls: Arc<AtomicUsize>,
+    entered: Arc<Notify>,
+    release: Arc<Notify>,
+    cancellation: CancellationToken,
+    program: AbsolutePathBuf,
+}
+impl Drop for Fixture {
+    fn drop(&mut self) {
+        self.release.notify_one();
+        self.cancellation.cancel();
+    }
+}
+impl Fixture {
+    async fn new(
+        policy: AskForApproval,
+        prefix: bool,
+        decision: Option<ApprovalDecision>,
+        gated: bool,
+    ) -> anyhow::Result<Self> {
+        let (mut session, turn, events) = make_session_and_context_with_auth_and_config_and_rx(
+            codex_login::CodexAuth::from_api_key("offline-test"),
+            Vec::new(),
+            |config| {
+                config.permissions.approval_policy = codex_config::Constrained::allow_any(policy);
+                config.approvals_reviewer = ApprovalsReviewer::User;
+                config.features.disable(codex_features::Feature::GuardianV2);
+                config
+                    .permissions
+                    .set_permission_profile(PermissionProfile::read_only())
+                    .unwrap();
+            },
+        )
+        .await;
+        let calls = Arc::new(AtomicUsize::new(0));
+        let entered = Arc::new(Notify::new());
+        let release = Arc::new(Notify::new());
+        let mut registry = codex_extension_api::ExtensionRegistryBuilder::new();
+        registry.approval_review_contributor(Arc::new(Contributor {
+            calls: Arc::clone(&calls),
+            decision,
+            entered: Arc::clone(&entered),
+            release: gated.then(|| Arc::clone(&release)),
+        }));
+        Arc::get_mut(&mut session).unwrap().services.extensions = Arc::new(registry.build());
+        let step = StepContext::for_test(Arc::clone(&turn));
+        let program = AbsolutePathBuf::current_dir()?.join("offline-intercepted-program");
+        let mut parser = codex_execpolicy::PolicyParser::new();
+        if prefix {
+            parser.parse(
+                "test.rules",
+                &format!(
+                    "prefix_rule(pattern=[{}], decision=\"prompt\")",
+                    serde_json::to_string(&program.to_string_lossy())?
+                ),
+            )?;
+        }
+        let parent_exec_policy = Arc::new(parser.build());
+        session.start_task(turn, Vec::new(), PendingTask).await;
+        let environments = &session.services.turn_environments;
+        environments.snapshot().await;
+        assert!(
+            environments
+                .observe_selected()
+                .snapshot()
+                .primary()
+                .is_some()
+        );
+        let cancellation = session
+            .active_turn
+            .lock()
+            .await
+            .as_ref()
+            .unwrap()
+            .task
+            .as_ref()
+            .unwrap()
+            .cancellation_token
+            .clone();
+        Ok(Self {
+            provider: CoreShellActionProvider {
+                parent_approval: None,
+                policy: Arc::new(RwLock::new(Arc::clone(&parent_exec_policy))),
+                parent_exec_policy,
+                session,
+                review_context: GuardianReviewContext::from(&step),
+                call_id: "retained-launch".into(),
+                environment_id: step
+                    .environments
+                    .primary()
+                    .unwrap()
+                    .selection
+                    .environment_id
+                    .clone(),
+                source: GuardianCommandSource::UnifiedExec,
+                tool_name: ToolName::plain("exec_command"),
+                approval_policy: AskForApproval::OnRequest,
+                permission_profile: PermissionProfile::read_only(),
+                sandbox_permissions: SandboxPermissions::RequireEscalated,
+                approval_sandbox_permissions: SandboxPermissions::RequireEscalated,
+                prompt_permissions: None,
+                stopwatch: Stopwatch::unlimited(),
+            },
+            events,
+            calls,
+            entered,
+            release,
+            cancellation,
+            program,
+        })
+    }
+    async fn run(&self) -> anyhow::Result<EscalationDecision> {
+        self.provider
+            .determine_action(
+                &self.program,
+                &["argv-zero".into(), "argument".into()],
+                &AbsolutePathBuf::current_dir()?.join("child-cwd"),
+            )
+            .await
+    }
+    fn no_manual_events(&self) {
+        assert!(
+            !std::iter::from_fn(|| self.events.try_recv().ok())
+                .any(|event| matches!(event.msg, EventMsg::ExecApprovalRequest(_)))
+        );
+    }
+    async fn close(&self) {
+        self.provider
+            .session
+            .abort_all_tasks(TurnAbortReason::Interrupted)
+            .await;
+    }
+    fn trusted_hook(&self) -> anyhow::Result<tempfile::TempDir> {
+        let home = tempfile::tempdir()?;
+        let config_path =
+            AbsolutePathBuf::try_from(home.path().join(codex_config::CONFIG_TOML_FILE))?;
+        let stack = self
+            .provider
+            .review_context
+            .turn()
+            .config
+            .config_layer_stack
+            .with_user_config(&config_path, serde_json::from_value(serde_json::json!({}))?)?;
+        let marker = home.path().join("hook-called");
+        std::fs::write(home.path().join("hooks.json"), serde_json::json!({"hooks":{"PermissionRequest":[{"matcher":"Bash","hooks":[{"type":"command","command":format!("printf called >> '{}'; printf '{{}}'", marker.display())}]}]}}).to_string())?;
+        let listed = codex_hooks::list_hooks(codex_hooks::HooksConfig {
+            feature_enabled: true,
+            config_layer_stack: Some(stack.clone()),
+            ..Default::default()
+        });
+        assert_eq!(listed.hooks.len(), 1);
+        let states = listed
+            .hooks
+            .iter()
+            .map(|hook| {
+                (
+                    hook.key.clone(),
+                    serde_json::json!({"trusted_hash":hook.current_hash}),
+                )
+            })
+            .collect::<serde_json::Map<_, _>>();
+        let stack = stack.with_user_config(
+            &config_path,
+            serde_json::from_value(serde_json::json!({"hooks":{"state":states}}))?,
+        )?;
+        let hooks = self
+            .provider
+            .session
+            .hooks()
+            .reconfigured(codex_hooks::HooksConfig {
+                feature_enabled: true,
+                config_layer_stack: Some(stack),
+                shell_program: Some("/bin/sh".into()),
+                shell_args: vec!["-c".into()],
+                ..Default::default()
+            });
+        self.provider.session.services.hooks.store(Arc::new(hooks));
+        Ok(home)
+    }
+}
+
+#[tokio::test]
+async fn current_on_request_without_parent_runs_original_callbacks_and_user_once()
+-> anyhow::Result<()> {
+    let fixture = Fixture::new(
+        AskForApproval::OnRequest,
+        /*prefix*/ false,
+        /*decision*/ None,
+        /*gated*/ false,
+    )
+    .await?;
+    // This asserts the configured provider owner, not the manager-to-launch pipeline.
+    let configured = fixture.provider.policy.read().await;
+    assert!(Arc::ptr_eq(
+        &configured,
+        &fixture.provider.parent_exec_policy
+    ));
+    drop(configured);
+    let hooks = fixture.trusted_hook()?;
+    let run = fixture.run();
+    tokio::pin!(run);
+    let result = tokio::time::timeout(Duration::from_secs(5), async {
+        loop { tokio::select! {
+            result = &mut run => panic!("expected pending user approval: {result:?}"),
+            event = fixture.events.recv() => if let EventMsg::ExecApprovalRequest(request) = event?.msg {
+                assert_eq!(request.call_id, "retained-launch");
+                let approval_id = request.approval_id.as_deref().unwrap_or(&request.call_id);
+                fixture.provider.session.notify_approval(approval_id, ReviewDecision::Approved).await;
+                return run.await;
+            }
+        }}
+    }).await??;
+    assert_eq!(
+        result,
+        EscalationDecision::escalate(EscalationExecution::Unsandboxed)
+    );
+    assert_eq!(fixture.calls.load(Ordering::SeqCst), 1);
+    assert_eq!(
+        std::fs::read_to_string(hooks.path().join("hook-called"))?,
+        "called"
+    );
+    fixture.no_manual_events();
+    fixture.close().await;
+    Ok(())
+}
