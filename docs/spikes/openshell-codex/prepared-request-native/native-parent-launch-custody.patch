 impl InitialExecApprovalIssuer {
+    /// Matches immutable issuance facts, not the current task or its lifetime.
+    pub(crate) fn matches_original_launch(
+        &self,
+        session: &Arc<Session>,
+        step: &StepContext,
+        ready: &TurnEnvironment,
+    ) -> bool {
+        self.session
+            .upgrade()
+            .is_some_and(|original| Arc::ptr_eq(&original, session))
+            && Arc::ptr_eq(&self.turn, &step.turn)
+            && Arc::ptr_eq(&self.settings, &step.settings)
+            && matches!(
+                &ready.selection.config,
+                codex_protocol::protocol::EnvironmentConfigState::Ready(_)
+            )
+            && [&self.environments, &step.environments]
+                .into_iter()
+                .all(|snapshot| {
+                    let mut matching = snapshot.turn_environments().filter(|environment| {
+                        environment.selection.environment_id == ready.selection.environment_id
+                    });
+                    let Some(original) = matching.next() else {
+                        return false;
+                    };
+                    matching.next().is_none()
+                        && original.selection == ready.selection
+                        && original.config_origin == ready.config_origin
+                        && Arc::ptr_eq(&original.environment, &ready.environment)
+                        && original.executor_platform_os == ready.executor_platform_os
+                        && original.user_home_dir == ready.user_home_dir
+                        && original.temporary_directories == ready.temporary_directories
+                })
+    }
+
     pub(crate) fn matches_original_exec_policy(&self, policy: &Arc<Policy>) -> bool {
         Arc::ptr_eq(&self.base_exec_policy, policy)
     }
