diff --git a/codex-rs/core/src/tools/runtimes/zsh_fork/parent_binding_tests.rs b/codex-rs/core/src/tools/runtimes/zsh_fork/parent_binding_tests.rs
new file mode 100644
index 0000000..89cdadd
--- /dev/null
+++ b/codex-rs/core/src/tools/runtimes/zsh_fork/parent_binding_tests.rs
@@ -0,0 +1,417 @@
+//! Original issuance mapping only; no process launch, initial flag, or child admission.
+use crate::config::PermissionProfileSnapshot;
+use crate::environment_selection::EnvironmentConfigOrigin;
+use crate::environment_selection::TurnEnvironmentState;
+use crate::guardian::GuardianReviewContext;
+use crate::session::session::Session;
+use crate::session::step_context::StepContext;
+use crate::session::tests::make_session_and_context_with_auth_and_config_and_rx;
+use crate::session::turn_context::TurnContext;
+use crate::session::turn_context::TurnEnvironment;
+use crate::tasks::SessionTask;
+use crate::tasks::SessionTaskResult;
+use crate::tools::ApprovalContext;
+use crate::tools::approvals::FreshParentApproval;
+use crate::tools::runtimes::unified_exec::UnifiedExecRequest;
+use crate::tools::runtimes::unified_exec::UnifiedExecRuntime;
+use crate::tools::sandboxing::Approvable;
+use crate::tools::sandboxing::ApprovalAction;
+use crate::tools::sandboxing::ExecApprovalRequirement;
+use crate::unified_exec::UnifiedExecProcessManager;
+use codex_exec_server::Environment;
+use codex_protocol::config_types::ApprovalsReviewer;
+use codex_protocol::models::PermissionProfile;
+use codex_protocol::models::SandboxPermissions;
+use codex_protocol::permissions::NetworkSandboxPolicy;
+use codex_protocol::protocol::AskForApproval;
+use codex_protocol::protocol::Event;
+use codex_protocol::protocol::EventMsg;
+use codex_protocol::protocol::ReviewDecision;
+use codex_protocol::protocol::TurnAbortReason;
+use codex_tools::ToolName;
+use codex_tools::UnifiedExecShellMode;
+use codex_utils_absolute_path::AbsolutePathBuf;
+use pretty_assertions::assert_eq;
+use std::collections::HashMap;
+use std::sync::Arc;
+use tokio::time::Duration;
+use tokio_util::sync::CancellationToken;
+
+const CALL: &str = "original-parent-launch";
+
+struct TaskCleanup(CancellationToken);
+impl Drop for TaskCleanup {
+    fn drop(&mut self) {
+        self.0.cancel();
+    }
+}
+
+struct PendingTask(CancellationToken);
+impl SessionTask for PendingTask {
+    fn kind(&self) -> crate::state::TaskKind {
+        crate::state::TaskKind::Regular
+    }
+    fn span_name(&self) -> &'static str {
+        "parent_launch_binding_test"
+    }
+    async fn run(
+        self: Arc<Self>,
+        _session: Arc<Session>,
+        _turn: Arc<TurnContext>,
+        _input: Vec<crate::session::TurnInput>,
+        cancellation: CancellationToken,
+    ) -> SessionTaskResult {
+        tokio::select! {
+            _ = cancellation.cancelled() => {},
+            _ = self.0.cancelled() => {},
+        }
+        Ok(None)
+    }
+}
+
+struct Fixture {
+    session: Arc<Session>,
+    step: Arc<StepContext>,
+    events: async_channel::Receiver<Event>,
+    manager: UnifiedExecProcessManager,
+    task_cancellation: CancellationToken,
+    call_cancellation: CancellationToken,
+    _task_cleanup: TaskCleanup,
+}
+impl Drop for Fixture {
+    fn drop(&mut self) {
+        self.call_cancellation.cancel();
+        self.task_cancellation.cancel();
+    }
+}
+impl Fixture {
+    async fn new() -> anyhow::Result<Self> {
+        let (session, turn, events) = make_session_and_context_with_auth_and_config_and_rx(
+            codex_login::CodexAuth::from_api_key("offline-test"),
+            Vec::new(),
+            |config| {
+                config.permissions.approval_policy =
+                    codex_config::Constrained::allow_any(AskForApproval::OnRequest);
+                config.approvals_reviewer = ApprovalsReviewer::User;
+                config.features.disable(codex_features::Feature::GuardianV2);
+                config
+                    .permissions
+                    .set_permission_profile(PermissionProfile::read_only())
+                    .unwrap();
+            },
+        )
+        .await;
+        // Own cleanup before launching the task, including setup errors or dropped setup futures.
+        let task_cleanup = TaskCleanup(CancellationToken::new());
+        session
+            .start_task(turn, Vec::new(), PendingTask(task_cleanup.0.clone()))
+            .await;
+        // Explicit fixture setup drives startup; the production comparison never polls it.
+        session.services.turn_environments.snapshot().await;
+        let (turn, settings, environments, strict) = session
+            .active_turn_context_and_strict_auto_review()
+            .await
+            .ok_or_else(|| anyhow::anyhow!("active test task"))?;
+        assert!(!strict);
+        assert!(environments.primary().is_some());
+        let mut step = StepContext::for_test(turn);
+        let selected = Arc::get_mut(&mut step).unwrap();
+        selected.settings = settings;
+        selected.environments = environments;
+        let task_cancellation = session
+            .active_turn
+            .lock()
+            .await
+            .as_ref()
+            .unwrap()
+            .task
+            .as_ref()
+            .unwrap()
+            .cancellation_token
+            .clone();
+        Ok(Self {
+            session,
+            step,
+            events,
+            manager: UnifiedExecProcessManager::default(),
+            task_cancellation,
+            call_cancellation: CancellationToken::new(),
+            _task_cleanup: task_cleanup,
+        })
+    }
+    fn request(&self) -> UnifiedExecRequest {
+        let environment = self.step.environments.primary().unwrap().clone();
+        UnifiedExecRequest {
+            command: vec!["offline-command".into()],
+            shell_type: crate::shell::ShellType::Sh,
+            hook_command: "offline-command".into(),
+            process_id: 1,
+            cwd: environment.cwd().clone(),
+            sandbox_cwd: environment.cwd().clone(),
+            turn_environment: environment,
+            env: HashMap::new(),
+            exec_server_env_config: None,
+            shell_snapshot: None,
+            explicit_env_overrides: HashMap::new(),
+            network: None,
+            tty: false,
+            sandbox_permissions: SandboxPermissions::RequireEscalated,
+            additional_permissions: None,
+            additional_permissions_preapproved: false,
+            justification: None,
+            exec_approval_requirement: ExecApprovalRequirement::NeedsApproval {
+                reason: None,
+                proposed_execpolicy_amendment: None,
+            },
+        }
+    }
+    fn action(&self, req: &UnifiedExecRequest, call: &str) -> anyhow::Result<ApprovalAction> {
+        // The ordinary action formatter is independent of whether a process is launched.
+        Ok(
+            UnifiedExecRuntime::new(&self.manager, UnifiedExecShellMode::Direct)
+                .approval_action(req, call)?,
+        )
+    }
+    async fn approve(&self) -> anyhow::Result<FreshParentApproval> {
+        let req = self.request();
+        let action = self.action(&req, CALL)?;
+        let ctx = ApprovalContext {
+            review_context: GuardianReviewContext::from(&self.step),
+            cancellation_token: Some(self.call_cancellation.clone()),
+            call_id: CALL.into(),
+            tool_name: ToolName::plain("exec_command"),
+            strict_auto_review: false,
+            approval_reason: None,
+            retry_reason: None,
+            network_approval_context: None,
+        };
+        let approval = self
+            .session
+            .request_initial_exec_approval(action, ctx, &self.step);
+        tokio::pin!(approval);
+        tokio::time::timeout(Duration::from_secs(5), async {
+            loop { tokio::select! {
+                result = &mut approval => panic!("expected actual pending User approval: {}", result.is_ok()),
+                event = self.events.recv() => if let EventMsg::ExecApprovalRequest(request) = event?.msg {
+                    assert_eq!(request.call_id, CALL);
+                    self.session.notify_approval(request.approval_id.as_deref().unwrap_or(&request.call_id),
+                        ReviewDecision::Approved).await;
+                    let result = approval.await.map_err(|error| anyhow::anyhow!("approval: {error:?}"))?;
+                    assert_eq!(result.decision, ReviewDecision::Approved);
+                    return result.parent_approval.ok_or_else(|| anyhow::anyhow!("actual fresh User provenance"));
+                }
+            }}
+        }).await?
+    }
+    fn step_with(&self, environments: Vec<TurnEnvironmentState>) -> Arc<StepContext> {
+        let mut step = StepContext::for_test(Arc::clone(&self.step.turn));
+        let selected = Arc::get_mut(&mut step).unwrap();
+        selected.settings = Arc::clone(&self.step.settings);
+        selected.environments.environments = environments;
+        step
+    }
+    async fn close(&self) {
+        self.session
+            .abort_all_tasks(TurnAbortReason::Interrupted)
+            .await;
+    }
+}
+
+#[tokio::test]
+async fn actual_user_proof_matches_the_original_runtime_action_and_ready_step() -> anyhow::Result<()>
+{
+    let fixture = Fixture::new().await?;
+    let proof = fixture.approve().await?;
+    let req = fixture.request();
+    let action = fixture.action(&req, CALL)?;
+    assert!(proof.matches_original_launch(
+        &action,
+        &fixture.session,
+        &fixture.step,
+        &req.turn_environment
+    ));
+    // This checks retained issuance mapping; closing the task does not turn it into a live grant.
+    fixture.close().await;
+    assert!(proof.matches_original_launch(
+        &action,
+        &fixture.session,
+        &fixture.step,
+        &req.turn_environment
+    ));
+    Ok(())
+}
+
+#[tokio::test]
+async fn different_runtime_action_or_issuer_identity_does_not_relabel_user_provenance()
+-> anyhow::Result<()> {
+    let fixture = Fixture::new().await?;
+    let proof = fixture.approve().await?;
+    let original = fixture.request();
+    for change in ["call", "command", "cwd", "environment"] {
+        let mut req = original.clone();
+        let mut call = CALL;
+        match change {
+            "call" => call = "other-call",
+            "command" => req.command.push("different".into()),
+            "cwd" => req.cwd = AbsolutePathBuf::current_dir()?.join("different-cwd").into(),
+            "environment" => {
+                req.turn_environment.selection.environment_id = "other-environment".into()
+            }
+            _ => unreachable!(),
+        }
+        assert!(
+            !proof.matches_original_launch(
+                &fixture.action(&req, call)?,
+                &fixture.session,
+                &fixture.step,
+                &req.turn_environment
+            ),
+            "{change}"
+        );
+    }
+    let action = fixture.action(&original, CALL)?;
+    let foreign = Fixture::new().await?;
+    assert!(!proof.matches_original_launch(
+        &action,
+        &foreign.session,
+        &fixture.step,
+        &original.turn_environment
+    ));
+    let mut step = fixture.step_with(fixture.step.environments.environments.clone());
+    Arc::get_mut(&mut step).unwrap().turn = Arc::clone(&foreign.step.turn);
+    assert!(!proof.matches_original_launch(
+        &action,
+        &fixture.session,
+        &step,
+        &original.turn_environment
+    ));
+    let mut step = fixture.step_with(fixture.step.environments.environments.clone());
+    Arc::get_mut(&mut step).unwrap().settings = Arc::new(fixture.step.settings.as_ref().clone());
+    assert!(!proof.matches_original_launch(
+        &action,
+        &fixture.session,
+        &step,
+        &original.turn_environment
+    ));
+    foreign.close().await;
+    fixture.close().await;
+    Ok(())
+}
+
+#[tokio::test]
+async fn raw_ready_facts_are_bound_in_both_request_and_step_without_projecting_thread_config()
+-> anyhow::Result<()> {
+    let fixture = Fixture::new().await?;
+    let proof = fixture.approve().await?;
+    let req = fixture.request();
+    let action = fixture.action(&req, CALL)?;
+    for change in [
+        "profile",
+        "network",
+        "cwd",
+        "roots",
+        "config-roots",
+        "origin",
+        "handle",
+        "platform",
+        "home",
+        "temporary",
+    ] {
+        let mut ready = req.turn_environment.clone();
+        let path = AbsolutePathBuf::current_dir()?.join("different-anchor");
+        match change {
+            "profile" => {
+                ready.config_mut().permission_profile =
+                    PermissionProfileSnapshot::legacy(PermissionProfile::workspace_write())
+            }
+            "network" => {
+                ready.config_mut().permission_profile =
+                    PermissionProfileSnapshot::legacy(PermissionProfile::from_runtime_permissions(
+                        &ready.permission_profile().file_system_sandbox_policy(),
+                        NetworkSandboxPolicy::Enabled,
+                    ))
+            }
+            "cwd" => ready.selection.cwd = path.clone().into(),
+            "roots" => ready.selection.workspace_roots.push(path.clone().into()),
+            "config-roots" => ready.config_mut().workspace_roots.push(path.clone().into()),
+            "origin" => ready.config_origin = EnvironmentConfigOrigin::Owner,
+            "handle" => ready.environment = Arc::new(Environment::default_for_tests()),
+            "platform" => ready.executor_platform_os = Some("different-platform".into()),
+            "home" => ready.user_home_dir = Some(path.clone().into()),
+            "temporary" => ready.temporary_directories = Some(vec![path.into()]),
+            _ => unreachable!(),
+        }
+        assert_eq!(
+            ready.selection.environment_id,
+            req.turn_environment.selection.environment_id
+        );
+        if matches!(change, "profile" | "network") {
+            assert_eq!(ready.selection(), req.turn_environment.selection());
+            assert!(Arc::ptr_eq(
+                &ready.environment,
+                &req.turn_environment.environment
+            ));
+            assert_ne!(
+                ready.selection.config,
+                req.turn_environment.selection.config
+            );
+        }
+        assert!(
+            !proof.matches_original_launch(&action, &fixture.session, &fixture.step, &ready),
+            "request {change}"
+        );
+        let step = fixture.step_with(vec![TurnEnvironmentState::Ready(ready)]);
+        assert!(
+            !proof.matches_original_launch(&action, &fixture.session, &step, &req.turn_environment),
+            "step {change}"
+        );
+    }
+    let step = fixture.step_with(Vec::new());
+    assert!(!proof.matches_original_launch(
+        &action,
+        &fixture.session,
+        &step,
+        &req.turn_environment
+    ));
+    fixture.close().await;
+    Ok(())
+}
+
+#[tokio::test]
+async fn current_thread_defaults_cannot_replace_the_original_ready_profile() -> anyhow::Result<()> {
+    let fixture = Fixture::new().await?;
+    let proof = fixture.approve().await?;
+    let req = fixture.request();
+    let action = fixture.action(&req, CALL)?;
+    let owner = &fixture.session.services.turn_environments;
+    let projected = owner.selections();
+    let mut defaults = req.turn_environment.config().clone();
+    defaults.permission_profile = PermissionProfileSnapshot::legacy(PermissionProfile::Disabled);
+    owner.set_active_thread_defaults(defaults);
+    let observed = owner.observe_selected();
+    let ready = observed.snapshot().primary().unwrap();
+    assert_eq!(owner.selections(), projected);
+    assert!(Arc::ptr_eq(
+        &ready.environment,
+        &req.turn_environment.environment
+    ));
+    assert_eq!(ready.selection.cwd, req.turn_environment.selection.cwd);
+    assert_eq!(
+        ready.selection.workspace_roots,
+        req.turn_environment.selection.workspace_roots
+    );
+    assert_ne!(
+        ready.selection.config,
+        req.turn_environment.selection.config
+    );
+    let step = fixture.step_with(observed.snapshot().environments.clone());
+    assert!(!proof.matches_original_launch(&action, &fixture.session, &step, ready));
+    assert!(proof.matches_original_launch(
+        &action,
+        &fixture.session,
+        &fixture.step,
+        &req.turn_environment
+    ));
+    fixture.close().await;
+    Ok(())
+}
