+                    Some(NativeSkillProviderSource::Executor(provider))
+                        if source.kind == SkillSourceKind::Executor =>
+                    {
+                        Arc::as_ptr(provider).cast::<()>()
+                    }
+                    _ => return Some(index),
+                };
+                (Arc::as_ptr(&source.provider).cast::<()>() != native_pointer).then_some(index)
+            })
+            .collect::<Vec<_>>();
+        if !missing.is_empty() {
+            return Err(missing);
