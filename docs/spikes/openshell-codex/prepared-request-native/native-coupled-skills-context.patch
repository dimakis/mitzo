+use crate::SkillsExtensionConfig;
+use crate::sources::NativeSkillProviderSource;
+
+#[path = "first_context_observation.rs"]
+mod first_context;
+pub use first_context::SkillsContextObservation;
+pub use first_context::SkillsInputObservation;
+
+/// The original installed Skills owner shared by all three context partitions.
+/// Registry provenance/config projection only; this is not captured context,
+/// tool selection, source-currentness authority or an admission permit.
+pub struct RegisteredSkillsSource<C> {
+    registration: RegisteredContextSource<SkillsExtension<C>>,
+}
+
+pub fn registered_skills_sources<C>(
+    registry: &ExtensionRegistry<C>,
+) -> Vec<RegisteredSkillsSource<C>>
+where
+    C: Send + Sync + 'static,
+{
+    registry
+        .registered_context_sources::<SkillsExtension<C>>()
+        .into_iter()
+        .map(|registration| RegisteredSkillsSource { registration })
+        .collect()
+}
+
+#[derive(Debug, PartialEq, Eq)]
+pub enum RegisteredSkillsSourceError {
+    Registration(ContextSourceRegistrationError),
+    UnresolvedProviders(Vec<usize>),
+    MissingOrAmbiguousExecutorProvider,
+    MissingOrAmbiguousHostProvider,
+    InputSourceChanged,
+    MissingExecutorPromptBytes,
+    Host(crate::HostSkillsObservationError),
+    Executor(ExecutorSkillsObservationError),
+}
+
+impl<C> RegisteredSkillsSource<C>
+where
+    C: Send + Sync + 'static,
+{
+    /// Observes the exact concrete executor retained at ordinary registration.
+    /// All provider provenance is checked before discovery; unknown/dynamic
+    /// providers cannot borrow another native provider or disappear as empty.
+    /// This captures only the executor partition, not complete Skills context.
+    pub async fn observe_executor_source<'a>(
+        &'a self,
+        registry: &ExtensionRegistry<C>,
+        selected_roots: &[SelectedCapabilityRoot],
+        sandbox_contexts: &HashMap<String, FileSystemSandboxContext>,
+        selected_plugins: Option<Arc<SelectedPluginSnapshot>>,
+    ) -> Result<ExecutorSkillsObservation<'a>, RegisteredSkillsSourceError> {
+        registry
+            .assert_context_source_registration(&self.registration)
+            .map_err(RegisteredSkillsSourceError::Registration)?;
+        let providers = self
+            .registration
+            .source()
+            .providers
+            .native_pre_session_sources()
+            .map_err(RegisteredSkillsSourceError::UnresolvedProviders)?;
+        let mut executors = providers.into_iter().filter_map(|provider| match provider {
+            NativeSkillProviderSource::Executor(provider) => Some(provider),
+            NativeSkillProviderSource::Host(_) => None,
+        });
+        let provider = executors
+            .next()
+            .ok_or(RegisteredSkillsSourceError::MissingOrAmbiguousExecutorProvider)?;
+        if executors.next().is_some() {
+            return Err(RegisteredSkillsSourceError::MissingOrAmbiguousExecutorProvider);
+        }
+        provider
+            .observe_pre_session(selected_roots, sandbox_contexts, selected_plugins)
+            .await
+            .map_err(RegisteredSkillsSourceError::Executor)
+    }
+
+    /// Uses the original installed projection after checking exact registry and
+    /// contributor allocation. Actual effective config selection/renewal remains
+    /// with the native preparation owner; this accepts no caller success flag.
+    pub fn project_configuration(
+        &self,
+        registry: &ExtensionRegistry<C>,
+        config: &C,
+    ) -> Result<SkillsExtensionConfig, ContextSourceRegistrationError> {
+        registry.assert_context_source_registration(&self.registration)?;
+        Ok((self.registration.source().config_from_host)(config))
+    }
+}
