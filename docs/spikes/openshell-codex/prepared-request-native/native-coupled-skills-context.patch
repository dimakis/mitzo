diff --git a/codex-rs/ext/extension-api/src/registry/context_sources.rs b/codex-rs/ext/extension-api/src/registry/context_sources.rs
new file mode 100644
index 0000000..eafbf95
--- /dev/null
+++ b/codex-rs/ext/extension-api/src/registry/context_sources.rs
@@ -0,0 +1,122 @@
+use std::any::Any;
+use std::sync::Arc;
+
+use super::ExtensionRegistry;
+use super::ExtensionRegistryBuilder;
+use crate::ContextContributor;
+use crate::ToolContributor;
+use crate::TurnInputContributor;
+
+#[derive(Clone)]
+pub(super) struct CoupledContextSource {
+    source: Arc<dyn Any + Send + Sync>,
+    context_index: usize,
+    turn_input_index: usize,
+    tool_index: usize,
+}
+
+/// Original registered owner shared by prompt, turn-input and tool contributions.
+/// This is provenance only: it does not settle any partition's captured content,
+/// source currentness or preparation/admission authority.
+pub struct RegisteredContextSource<T> {
+    source: Arc<T>,
+    registry_identity: Arc<()>,
+    context_index: usize,
+    turn_input_index: usize,
+    tool_index: usize,
+}
+
+impl<T> RegisteredContextSource<T> {
+    pub fn source(&self) -> &T {
+        &self.source
+    }
+
+    /// Original indexes in the prompt, turn-input and tool contributor vectors.
+    pub fn registration_indexes(&self) -> (usize, usize, usize) {
+        (self.context_index, self.turn_input_index, self.tool_index)
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum ContextSourceRegistrationError {
+    RegistryChanged,
+    ContributorsChanged,
+}
+
+impl<C: Sync> ExtensionRegistryBuilder<C> {
+    /// Registers the SAME original allocation for all three context partitions.
+    /// State-bound tools remain unresolved in the existing tool inventory until
+    /// their actual source-owned selection is captured; no callback is invoked.
+    pub fn coupled_context_contributor<T>(&mut self, source: Arc<T>)
+    where
+        T: ContextContributor + TurnInputContributor + ToolContributor + 'static,
+    {
+        let registration = CoupledContextSource {
+            source: source.clone(),
+            context_index: self.registry.context_contributors.len(),
+            turn_input_index: self.registry.turn_input_contributors.len(),
+            tool_index: self.registry.tool_contributors.len(),
+        };
+        self.prompt_contributor(source.clone());
+        self.turn_input_contributor(source.clone());
+        self.tool_contributor(source);
+        self.registry.coupled_context_sources.push(registration);
+    }
+}
+
+impl<C: Sync> ExtensionRegistry<C> {
+    /// Finds only actual coupled owners of this concrete type, in registration
+    /// order. An empty result proves no absence for other contributor sources.
+    pub fn registered_context_sources<T>(&self) -> Vec<RegisteredContextSource<T>>
+    where
+        T: ContextContributor + TurnInputContributor + ToolContributor + 'static,
+    {
+        self.coupled_context_sources
+            .iter()
+            .filter_map(|registration| {
+                Arc::clone(&registration.source)
+                    .downcast::<T>()
+                    .ok()
+                    .map(|source| RegisteredContextSource {
+                        source,
+                        registry_identity: Arc::clone(&self.tool_inventory_identity),
+                        context_index: registration.context_index,
+                        turn_input_index: registration.turn_input_index,
+                        tool_index: registration.tool_index,
+                    })
+            })
+            .collect()
+    }
+
+    /// Checks only exact registry identity and the three original allocation
+    /// pointers. Provider/configuration/filesystem capture and renewal remain
+    /// obligations of the registered native source, not this metadata check.
+    pub fn assert_context_source_registration<T>(
+        &self,
+        source: &RegisteredContextSource<T>,
+    ) -> Result<(), ContextSourceRegistrationError>
+    where
+        T: ContextContributor + TurnInputContributor + ToolContributor + 'static,
+    {
+        if !Arc::ptr_eq(&self.tool_inventory_identity, &source.registry_identity) {
+            return Err(ContextSourceRegistrationError::RegistryChanged);
+        }
+        let pointer = Arc::as_ptr(&source.source).cast::<()>();
+        let context = self
+            .context_contributors
+            .get(source.context_index)
+            .map(|source| Arc::as_ptr(source).cast::<()>());
+        let turn_input = self
+            .turn_input_contributors
+            .get(source.turn_input_index)
+            .map(|source| Arc::as_ptr(source).cast::<()>());
+        let tool = self
+            .tool_contributors
+            .get(source.tool_index)
+            .map(|source| Arc::as_ptr(source).cast::<()>());
+        if context != Some(pointer) || turn_input != Some(pointer) || tool != Some(pointer) {
+            return Err(ContextSourceRegistrationError::ContributorsChanged);
+        }
+        Ok(())
+    }
+}
