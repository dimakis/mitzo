@@ -0,0 +1,219 @@
+use super::*;
+use crate::HostSkillsLoadInput;
+use crate::HostSkillsService;
+use codex_config::ConfigLayerEntry;
+use codex_config::ConfigLayerSource;
+use codex_config::ConfigLayerStack;
+use codex_config::ConfigRequirementsToml;
+use codex_exec_server::LOCAL_FS;
+use codex_protocol::capabilities::CapabilityRootLocation;
+use codex_protocol::capabilities::SelectedCapabilityRoot;
+use codex_protocol::user_input::UserInput;
+use codex_utils_absolute_path::test_support::PathExt;
+use codex_utils_path_uri::PathUri;
+use pretty_assertions::assert_eq;
+
+enum ContextCase {
+    HiddenDistinctKnowledge,
+    VisibleExecutorPrecedence,
+    ForeignExecutor,
+}
+
+async fn capture(case: ContextCase) {
+    let include_catalog = matches!(case, ContextCase::VisibleExecutorPrecedence);
+    let same_name = matches!(case, ContextCase::VisibleExecutorPrecedence);
+    let home = tempfile::tempdir().unwrap();
+    let cwd = tempfile::tempdir().unwrap();
+    let executor_root = tempfile::tempdir().unwrap();
+    let host_dir = home.path().join("skills/knowledge");
+    let executor_dir = executor_root.path().join("knowledge");
+    std::fs::create_dir_all(&host_dir).unwrap();
+    std::fs::create_dir_all(&executor_dir).unwrap();
+    let host_name = if same_name {
+        "shared-knowledge"
+    } else {
+        "knowledge-host"
+    };
+    let executor_name = if same_name {
+        "shared-knowledge"
+    } else {
+        "knowledge-executor"
+    };
+    let host_text = format!(
+        "---\nname: {host_name}\ndescription: Original host Knowledge\n---\nHOST_KNOWLEDGE_BYTES\n"
+    );
+    let executor_text = format!(
+        "---\nname: {executor_name}\ndescription: Original executor Knowledge\n---\nEXECUTOR_KNOWLEDGE_BYTES\n"
+    );
+    std::fs::write(host_dir.join("SKILL.md"), &host_text).unwrap();
+    std::fs::write(executor_dir.join("SKILL.md"), &executor_text).unwrap();
+    let stack = ConfigLayerStack::new(
+        vec![ConfigLayerEntry::new(
+            ConfigLayerSource::User {
+                file: home.path().join("config.toml").abs(),
+                profile: None,
+            },
+            toml::from_str("[skills.bundled]\nenabled=false\n").unwrap(),
+        )],
+        Default::default(),
+        ConfigRequirementsToml::default(),
+    )
+    .unwrap();
+    let service = Arc::new(HostSkillsService::new_with_restriction_product(
+        home.path().abs(),
+        /*bundled_skills_enabled*/ false,
+        /*restriction_product*/ None,
+    ));
+    let host_input = HostSkillsLoadInput::new(cwd.path().abs(), Vec::new(), stack);
+    let host = service
+        .observe_pre_session_for_config(&host_input, Some(Arc::clone(&LOCAL_FS)))
+        .await
+        .unwrap();
+    let provider = Arc::new(ExecutorSkillProvider::new_with_restriction_product(
+        Arc::new(EnvironmentManager::default_for_tests()),
+        /*restriction_product*/ None,
+    ));
+    let providers = SkillProviders::new()
+        .with_native_executor_provider(Arc::clone(&provider))
+        .with_native_host_provider(Arc::new(HostSkillProvider::new()));
+    let mut builder = ExtensionRegistryBuilder::<bool>::new();
+    install_with_providers(&mut builder, providers, |include: &bool| {
+        SkillsExtensionConfig {
+            include_instructions: *include,
+            max_context_tokens: None,
+            bundled_skills_enabled: false,
+            cloud_skill_enabled: false,
+            shadow_selection_enabled: false,
+        }
+    });
+    let registry = builder.build();
+    let sources = registered_skills_sources(&registry);
+    let model = codex_models_manager::bundled_models_response()
+        .unwrap()
+        .models
+        .into_iter()
+        .find(|model| model.slug == "gpt-6-luna")
+        .unwrap();
+    let model_json = serde_json::to_value(&model).unwrap();
+    let inputs = vec![UserInput::Text {
+        text: format!("${host_name} ${executor_name}"),
+        text_elements: Vec::new(),
+    }];
+    let selected = sources[0]
+        .observe_first_input(
+            &registry,
+            &include_catalog,
+            &model,
+            &inputs,
+            &HashMap::new(),
+        )
+        .unwrap();
+    let roots = vec![SelectedCapabilityRoot {
+        id: "original-knowledge".into(),
+        location: CapabilityRootLocation::Environment {
+            environment_id: "local".into(),
+            path: PathUri::from_host_native_path(executor_root.path()).unwrap(),
+        },
+    }];
+    if matches!(case, ContextCase::ForeignExecutor) {
+        let foreign = ExecutorSkillProvider::new_with_restriction_product(
+            Arc::new(EnvironmentManager::default_for_tests()),
+            /*restriction_product*/ None,
+        );
+        let executor = foreign
+            .observe_pre_session(&roots, &HashMap::new(), /*selected_plugins*/ None)
+            .await
+            .unwrap();
+        std::fs::remove_file(host_dir.join("SKILL.md")).unwrap();
+        let result = sources[0]
+            .observe_first_context(selected, host, executor)
+            .await;
+        assert!(matches!(
+            result,
+            Err(RegisteredSkillsSourceError::Executor(
+                crate::ExecutorSkillsObservationError::ForeignProvider
+            ))
+        ));
+        return;
+    }
+    let executor = sources[0]
+        .observe_executor_source(
+            &registry,
+            &roots,
+            &HashMap::new(),
+            /*selected_plugins*/ None,
+        )
+        .await
+        .unwrap();
+    let captured = sources[0]
+        .observe_first_context(selected, host, executor)
+        .await
+        .unwrap();
+    fn assert_send_sync<T: Send + Sync>(_: &T) {}
+    assert_send_sync(&captured);
+    service
+        .assert_pre_session_prompt_observation_owner(captured.host_observation())
+        .unwrap();
+    provider
+        .assert_pre_session_observation_owner(captured.executor_observation())
+        .unwrap();
+    assert!(captured.thread_context().is_empty());
+    assert_eq!(captured.user_input(), inputs);
+    assert_eq!(serde_json::to_value(captured.model()).unwrap(), model_json);
+    assert_eq!(captured.tool_specs().len(), 2);
+    assert_eq!(captured.extension_items().len(), 1);
+    assert!(
+        serde_json::to_string(captured.extension_items())
+            .unwrap()
+            .contains("EXECUTOR_KNOWLEDGE_BYTES")
+    );
+    assert_eq!(
+        captured.host_observation().source_bytes().next().unwrap().1,
+        host_text
+    );
+    if same_name {
+        assert!(captured.host_items().is_empty());
+    } else {
+        assert_eq!(captured.host_items().len(), 1);
+        assert!(
+            serde_json::to_string(&captured.host_items())
+                .unwrap()
+                .contains("HOST_KNOWLEDGE_BYTES")
+        );
+    }
+    if include_catalog {
+        assert!(!captured.initial_world_state().is_empty());
+        assert!(
+            captured
+                .initial_world_state()
+                .iter()
+                .any(|(_, fragment)| fragment.body().contains(executor_name))
+        );
+    } else {
+        assert!(captured.initial_world_state().is_empty());
+    }
+    let host_items = captured.host_items();
+    let extension_items = captured.extension_items().to_vec();
+    // This proves immutable rendering only. A real final source lease must
+    // separately refuse edits before association/commit; no Ready is asserted.
+    std::fs::remove_file(host_dir.join("SKILL.md")).unwrap();
+    std::fs::remove_file(executor_dir.join("SKILL.md")).unwrap();
