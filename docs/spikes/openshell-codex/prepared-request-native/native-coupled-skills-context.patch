+use pretty_assertions::assert_eq;
+use std::sync::Arc;
+use std::sync::atomic::AtomicUsize;
+use std::sync::atomic::Ordering;
+
+use super::*;
+
+#[test]
+fn initial_native_skill_render_matches_ordinary_without_invoking_its_callback() {
+    let calls = Arc::new(AtomicUsize::new(0));
+    let observed_calls = Arc::clone(&calls);
+    let body = "\nKnowledge retained from the original provider.\n";
+    let pure = initial_skills_world_state_fragment(Some(body));
+    assert_eq!(calls.load(Ordering::SeqCst), 0);
+    let ordinary = executor_skills_world_state_section(
+        Some(body.to_string()),
+        /*include_instructions*/ true,
+        /*previous_snapshot*/ None,
+        Box::new(move || {
+            observed_calls.fetch_add(1, Ordering::SeqCst);
+        }),
+    );
+    assert_eq!(
+        ordinary.render_diff(PreviousWorldStateSection::Absent),
+        pure
+    );
+    assert_eq!(calls.load(Ordering::SeqCst), 1);
+    assert_eq!(initial_skills_world_state_fragment(Some(body)), pure);
+    assert!(initial_skills_world_state_fragment(/*body*/ None).is_none());
+    assert_eq!(calls.load(Ordering::SeqCst), 1);
+}
+
+#[test]
+fn initial_host_omission_uses_original_placeholder_and_ordinary_callback() {
+    let report = SkillRenderReport {
+        omitted_count: 1,
+        ..Default::default()
+    };
+    let body = host_skills_catalog_body(/*body*/ None, &report);
+    let pure = initial_skills_world_state_fragment(body.as_deref());
+    let calls = Arc::new(AtomicUsize::new(0));
+    let observed_calls = Arc::clone(&calls);
+    let ordinary = host_skills_world_state_section(
+        /*body*/ None,
+        /*include_instructions*/ true,
+        &report,
+        Box::new(move || {
+            observed_calls.fetch_add(1, Ordering::SeqCst);
+        }),
+    );
+    assert_eq!(
+        ordinary.render_diff(PreviousWorldStateSection::Absent),
+        pure
+    );
+    assert!(pure.unwrap().body().contains("omitted"));
+    assert_eq!(calls.load(Ordering::SeqCst), 1);
+}
