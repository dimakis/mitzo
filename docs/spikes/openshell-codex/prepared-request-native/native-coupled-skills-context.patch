+use std::collections::HashMap;
+use std::sync::Arc;
+
+use codex_exec_server::ExecutorCapabilityDiscoverySnapshot;
+use codex_exec_server::FileSystemSandboxContext;
+use codex_exec_server::ResolvedSelectedCapabilityRoot;
+use codex_exec_server::discover_resolved_capability_roots;
+use codex_extension_api::SelectedPluginSnapshot;
+use codex_extension_api::ToolSpec;
+use codex_protocol::capabilities::SelectedCapabilityRoot;
+
+use super::ExecutorSkillProvider;
+use crate::catalog::SkillCatalog;
+use crate::provider::attribute_executor_plugins;
+use crate::tools::skill_tool_specs;
+
+/// Discovery bytes produced through the original provider/environment owner.
+/// No environment/permission/config publication lease or admission is supplied.
+pub struct ExecutorSkillsObservation<'a> {
+    provider: &'a ExecutorSkillProvider,
+    discovery: ExecutorCapabilityDiscoverySnapshot,
+    resolved_roots: Vec<ResolvedSelectedCapabilityRoot>,
+    selected_plugins: Option<Arc<SelectedPluginSnapshot>>,
+    catalog: SkillCatalog,
+}
+
+#[derive(Debug, PartialEq, Eq)]
+pub enum ExecutorSkillsObservationError {
+    DiscoveryErrors(Vec<String>),
+    ForeignProvider,
+    SelectedRootsUnresolved,
+    RemoteSourceRequiresCapturedObservation,
+}
+
+impl ExecutorSkillProvider {
+    /// Uses the original native discovery constructor with this provider's
+    /// actual EnvironmentManager and exact passive ready handles. No thread
+    /// cache, Session/lifecycle/tool executor or inferred provider is constructed.
+    /// Selected roots, sandboxes and plugin policy must come from native capture.
+    pub async fn observe_pre_session<'a>(
+        &'a self,
+        selected_roots: &[SelectedCapabilityRoot],
+        sandbox_contexts: &HashMap<String, FileSystemSandboxContext>,
+        selected_plugins: Option<Arc<SelectedPluginSnapshot>>,
+    ) -> Result<ExecutorSkillsObservation<'a>, ExecutorSkillsObservationError> {
+        let resolved_roots = self
+            .environment_manager
+            .observe_ready_selected_capability_roots(selected_roots);
+        if resolved_roots.len() != selected_roots.len()
+            || resolved_roots
+                .iter()
+                .zip(selected_roots)
+                .any(|(resolved, selected)| resolved.selected_root() != selected)
+        {
+            return Err(ExecutorSkillsObservationError::SelectedRootsUnresolved);
+        }
+        // Ordinary remote discovery may reconnect. Preparation requires its own
+        // already-captured passive source; never activate it through this path.
+        if resolved_roots
+            .iter()
+            .any(|root| root.environment().is_remote())
+        {
+            return Err(ExecutorSkillsObservationError::RemoteSourceRequiresCapturedObservation);
+        }
+        let discovery = discover_resolved_capability_roots(&resolved_roots, sandbox_contexts)
+            .await
+            .map_err(|error| ExecutorSkillsObservationError::DiscoveryErrors(vec![error]))?;
+        let mut catalog = self.list_from_discovery(&discovery);
+        if !catalog.warnings.is_empty() {
+            return Err(ExecutorSkillsObservationError::DiscoveryErrors(
+                catalog.warnings,
+            ));
+        }
+        if let Some(plugins) = selected_plugins.as_deref() {
+            attribute_executor_plugins(&mut catalog, plugins);
+        }
+        Ok(ExecutorSkillsObservation {
+            provider: self,
+            discovery,
+            resolved_roots,
+            selected_plugins,
+            catalog,
+        })
+    }
+
+    /// Original provider pointer only; not an epoch, permission or source lease.
+    pub fn assert_pre_session_observation_owner(
+        &self,
+        observation: &ExecutorSkillsObservation<'_>,
+    ) -> Result<(), ExecutorSkillsObservationError> {
+        if !std::ptr::eq(self, observation.provider) {
+            return Err(ExecutorSkillsObservationError::ForeignProvider);
+        }
+        Ok(())
+    }
+}
+
+impl ExecutorSkillsObservation<'_> {
+    pub fn catalog(&self) -> &SkillCatalog {
+        &self.catalog
+    }
+
+    pub fn discovery(&self) -> &ExecutorCapabilityDiscoverySnapshot {
+        &self.discovery
+    }
+
+    pub fn selected_plugins(&self) -> Option<&SelectedPluginSnapshot> {
+        self.selected_plugins.as_deref()
+    }
+
+    /// This executor partition's ordinary root-selected schemas. Other sources
+    /// (including cloud) and Core policy remain separate unresolved partitions.
+    pub fn tool_specs(&self) -> Vec<ToolSpec> {
+        if self.resolved_roots.is_empty() {
+            Vec::new()
+        } else {
+            skill_tool_specs().into()
+        }
+    }
+}
