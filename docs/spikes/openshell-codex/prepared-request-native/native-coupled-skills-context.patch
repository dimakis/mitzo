@@ -0,0 +1,95 @@
+use std::collections::HashMap;
+
+use codex_protocol::models::ResponseItem;
+use codex_protocol::user_input::UserInput;
+use codex_skills::SkillMetadata;
+use codex_skills::collect_explicit_skill_mentions;
+
+use super::HostSkillsObservation;
+use super::HostSkillsObservationError;
+use crate::HostSkillPrompts;
+use crate::HostSkillsService;
+use crate::InjectedHostSkillPrompts;
+use crate::deduplicate_host_skill_items;
+use crate::host_prompt::HostSkillSourceRetention;
+use crate::host_prompt::RetainedHostSkillSource;
+
+/// Original selected host bytes and ordinary prompt formatting, retained together.
+/// No source publication/currentness lease or count/consume authority is supplied.
+pub struct HostSkillPromptObservation {
+    host: HostSkillsObservation,
+    items: Vec<ResponseItem>,
+    injected: Vec<SkillMetadata>,
+    warnings: Vec<String>,
+    sources: Vec<RetainedHostSkillSource>,
+}
+
+impl HostSkillsObservation {
+    /// Selects with Core's original host selector and reads through the original
+    /// snapshot/filesystem. Input/connector policy must come from native capture;
+    /// no Session, installer, invocation analytics or runtime store is constructed.
+    pub async fn observe_explicit_prompts(
+        self,
+        inputs: &[UserInput],
+        connector_slug_counts: &HashMap<String, usize>,
+    ) -> Result<HostSkillPromptObservation, HostSkillsObservationError> {
+        let selected =
+            collect_explicit_skill_mentions(inputs, self.snapshot.outcome(), connector_slug_counts);
+        let reads = self
+            .snapshot
+            .load_skill_prompt_reads(&selected, HostSkillSourceRetention::Retain)
+            .await;
+        if reads.prompts.injected.len() != selected.len() || reads.sources.len() != selected.len() {
+            return Err(HostSkillsObservationError::PromptReadErrors(
+                reads.prompts.warnings,
+            ));
+        }
+        let HostSkillPrompts {
+            fragments,
+            injected,
+            warnings,
+        } = reads.prompts;
+        let items = fragments
+            .into_iter()
+            .map(codex_extension_api::ContextualUserFragment::into_boxed_response_item)
+            .collect();
+        Ok(HostSkillPromptObservation {
+            host: self,
+            items,
+            injected,
+            warnings,
+            sources: reads.sources,
+        })
+    }
+}
+
+impl HostSkillPromptObservation {
+    pub fn warnings(&self) -> &[String] {
+        &self.warnings
+    }
+
+    /// Exact file text read through each original selected source, before the
+    /// existing agent-plugin truncation policy. No new cap or omission is applied.
+    pub fn source_bytes(&self) -> impl Iterator<Item = (&SkillMetadata, &str)> {
+        self.sources
+            .iter()
+            .map(|source| (&source.skill, source.contents.as_str()))
+    }
+
+    /// Pure ordinary formatting and precedence; never re-reads providers/files.
+    pub fn render_items(
+        &self,
+        extension_injected: Option<&InjectedHostSkillPrompts>,
+    ) -> Vec<ResponseItem> {
+        deduplicate_host_skill_items(self.items.clone(), &self.injected, extension_injected)
+    }
+}
+
+impl HostSkillsService {
+    pub fn assert_pre_session_prompt_observation_owner(
+        &self,
+        observation: &HostSkillPromptObservation,
+    ) -> Result<(), HostSkillsObservationError> {
+        self.assert_pre_session_observation_owner(&observation.host)
+    }
+}
