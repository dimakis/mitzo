+        let missing = self
+            .sources
+            .iter()
+            .enumerate()
+            .filter_map(|(index, source)| {
+                let native_pointer = match source.native_source.as_ref() {
+                    Some(NativeSkillProviderSource::Host(provider))
+                        if source.kind == SkillSourceKind::Host =>
+                    {
+                        Arc::as_ptr(provider).cast::<()>()
