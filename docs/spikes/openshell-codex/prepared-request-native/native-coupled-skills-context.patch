+#[test]
+fn registered_original_skills_projects_config_without_runtime_state_or_tool_grant() {
+    use std::sync::atomic::AtomicUsize;
+    use std::sync::atomic::Ordering;
+
+    let projections = Arc::new(AtomicUsize::new(0));
+    let observed_projections = Arc::clone(&projections);
+    let mut builder = ExtensionRegistryBuilder::<bool>::new();
+    install(&mut builder, move |include: &bool| {
+        observed_projections.fetch_add(1, Ordering::SeqCst);
+        SkillsExtensionConfig {
+            include_instructions: *include,
+            max_context_tokens: None,
+            bundled_skills_enabled: true,
+            cloud_skill_enabled: false,
+            shadow_selection_enabled: false,
+        }
+    });
+    let registry = builder.build();
+    let sources = registered_skills_sources(&registry);
+    assert_eq!(sources.len(), 1);
+    assert_eq!(projections.load(Ordering::SeqCst), 0);
+    let hidden_catalog = false;
+    assert!(
+        !sources[0]
+            .project_configuration(&registry, &hidden_catalog)
+            .unwrap()
+            .include_instructions
+    );
+    assert_eq!(projections.load(Ordering::SeqCst), 1);
+    // include_instructions=false must not be converted into a NoTools grant.
+    assert!(registry.capture_pre_session_tools().is_err());
+    let copied = registry.to_builder().build();
+    assert_eq!(
+        sources[0].project_configuration(&copied, &hidden_catalog),
+        Err(codex_extension_api::ContextSourceRegistrationError::RegistryChanged),
+    );
+    assert_eq!(projections.load(Ordering::SeqCst), 1);
+    let visible_catalog = true;
+    let copied_sources = registered_skills_sources(&copied);
+    assert!(
+        copied_sources[0]
+            .project_configuration(&copied, &visible_catalog)
+            .unwrap()
+            .include_instructions
+    );
+    assert_eq!(projections.load(Ordering::SeqCst), 2);
+}
