+use crate::world_state::HOST_SKILLS_WORLD_STATE_ID;
+use crate::world_state::SKILLS_WORLD_STATE_ID;
+use crate::world_state::host_skills_catalog_body;
+use crate::world_state::initial_skills_world_state_fragment;
+
+pub(crate) struct InitialSkillCatalogs {
+    pub(crate) fragments: Vec<(&'static str, RenderedWorldStateFragment)>,
+    pub(crate) warnings: Vec<String>,
+}
+
+/// Pure initial rendering after the registered source has established that its
+/// exact providers are native host/executor sources. Cloud/custom coverage is
+/// NOT inferred here; unqualified registrations must refuse before this call.
+pub(crate) fn render_initial_filesystem_catalogs(
+    config: &SkillsExtensionConfig,
+    model: &ModelInfo,
+    executor: SkillCatalog,
+    host: SkillCatalog,
+) -> InitialSkillCatalogs {
+    let include_usage = model.include_skills_usage_instructions;
+    let catalogs = CatalogContributions {
+        executor: CatalogContribution {
+            catalog: executor,
+            status: CatalogStatus::Enabled,
+        },
+        cloud: CatalogContribution::unavailable(),
+        host: CatalogContribution {
+            catalog: if config.include_instructions || config.shadow_selection_enabled {
+                host
+            } else {
+                SkillCatalog::default()
+            },
+            status: CatalogStatus::Enabled,
+        },
+    };
+    let rendered = CatalogRenderer {
+        config,
+        metadata_budget: skill_metadata_budget(
+            model.resolved_context_window(),
+            config.max_context_tokens,
+        ),
+        include_usage,
+        previous_world_state: None,
+    }
+    .render_catalogs(catalogs);
+    let mut output = InitialSkillCatalogs {
+        fragments: Vec::new(),
+        warnings: Vec::new(),
+    };
+    for catalog in rendered {
+        if catalog.status == CatalogStatus::Unavailable {
+            continue;
+        }
+        let report = catalog
+            .rendered
+            .as_ref()
+            .map(|value| value.report.clone())
+            .unwrap_or_default();
+        let body = catalog
+            .rendered
+            .and_then(|value| value.into_fragment(include_usage))
+            .map(|fragment| fragment.body());
+        let body = match catalog.kind {
+            CatalogKind::Host => host_skills_catalog_body(body, &report),
+            CatalogKind::Executor | CatalogKind::Cloud => body,
+        };
+        if let Some(fragment) = initial_skills_world_state_fragment(body.as_deref()) {
+            if config.include_instructions
+                && catalog.status == CatalogStatus::Enabled
+                && let Some(warning) = report.warning_message()
+            {
+                output.warnings.push(warning);
+            }
+            let id = match catalog.kind {
+                CatalogKind::Executor => SKILLS_WORLD_STATE_ID,
+                CatalogKind::Cloud => CLOUD_SKILLS_WORLD_STATE_ID,
+                CatalogKind::Host => HOST_SKILLS_WORLD_STATE_ID,
+            };
+            output.fragments.push((id, fragment));
+        }
+    }
+    output
+}
