diff --git a/codex-rs/exec-server/src/capability_discovery_cache/resolved.rs b/codex-rs/exec-server/src/capability_discovery_cache/resolved.rs
new file mode 100644
index 0000000..ae863fb
--- /dev/null
+++ b/codex-rs/exec-server/src/capability_discovery_cache/resolved.rs
@@ -0,0 +1,147 @@
+use std::collections::BTreeMap;
+use std::collections::HashMap;
+use std::sync::Arc;
+
+use codex_protocol::capabilities::CapabilityRootLocation;
+use codex_protocol::capabilities::SelectedCapabilityRoot;
+
+use super::CachedRoot;
+use crate::CapabilityRootDiscoverRequest;
+use crate::CapabilityRootsDiscoverParams;
+use crate::Environment;
+use crate::ExecutorCapabilityDiscoverySnapshot;
+use crate::FileSystemSandboxContext;
+use crate::ResolvedSelectedCapabilityRoot;
+
+/// Reads through the exact already-resolved environment handles, without
+/// selecting another environment from a manager or publishing a thread cache.
+/// This performs discovery I/O; it is not a source/permission lease. Callers
+/// must apply their source's activation and readiness restrictions first.
+pub async fn discover_resolved_capability_roots(
+    resolved: &[ResolvedSelectedCapabilityRoot],
+    sandbox_contexts: &HashMap<String, FileSystemSandboxContext>,
+) -> Result<ExecutorCapabilityDiscoverySnapshot, String> {
+    let mut grouped = BTreeMap::<String, (Arc<Environment>, Vec<SelectedCapabilityRoot>)>::new();
+    for root in resolved {
+        let CapabilityRootLocation::Environment { environment_id, .. } =
+            &root.selected_root().location;
+        let (environment, roots) = grouped
+            .entry(environment_id.clone())
+            .or_insert_with(|| (Arc::clone(root.environment()), Vec::new()));
+        if !Arc::ptr_eq(environment, root.environment()) {
+            return Err("selected roots contain different handles for one environment".to_string());
+        }
+        roots.push(root.selected_root().clone());
+    }
+    let batches = grouped
+        .into_iter()
+        .flat_map(|(environment_id, (environment, roots))| {
+            roots
+                .chunks(crate::capability_discovery::MAX_ROOTS_PER_REQUEST)
+                .map(|batch| {
+                    (
+                        Arc::clone(&environment),
+                        batch.to_vec(),
+                        sandbox_contexts.get(&environment_id).cloned(),
+                    )
+                })
+                .collect::<Vec<_>>()
+        });
+    let discoveries = futures::future::join_all(
+        batches.map(|(environment, roots, sandbox)| discover_batch(environment, roots, sandbox)),
+    )
+    .await;
+    let discoveries = discoveries.into_iter().flatten().collect::<Vec<_>>();
+    let selected = resolved
+        .iter()
+        .map(|root| root.selected_root().clone())
+        .collect::<Vec<_>>();
+    let ordered = selected
+        .iter()
+        .map(|root| {
+            discoveries
+                .iter()
+                .find(|result| result.selected_root == *root)
+                .map(|result| result.result.clone())
+                .unwrap_or_else(|| Err("selected root discovery is missing".to_string()))
+        })
+        .collect();
+    Ok(ExecutorCapabilityDiscoverySnapshot::new(
+        &selected,
+        ordered,
+        sandbox_contexts.clone(),
+    ))
+}
+
+pub(super) async fn discover_batch(
+    environment: Arc<Environment>,
+    selected_roots: Vec<SelectedCapabilityRoot>,
+    sandbox: Option<FileSystemSandboxContext>,
+) -> Vec<CachedRoot> {
+    let params = CapabilityRootsDiscoverParams {
+        roots: selected_roots
+            .iter()
+            .map(|selected_root| {
+                let CapabilityRootLocation::Environment { path, .. } = &selected_root.location;
+                CapabilityRootDiscoverRequest {
+                    id: selected_root.id.clone(),
+                    path: path.clone(),
+                    sandbox: sandbox.clone(),
+                }
+            })
+            .collect(),
+    };
+    let response = match environment.discover_capability_roots(params).await {
+        Ok(response) => response,
+        Err(error) => {
+            let retryable = crate::client::can_retry_connection_attempt(&error);
+            let error = error.to_string();
+            return selected_roots
+                .into_iter()
+                .map(|selected_root| CachedRoot {
+                    selected_root,
+                    sandbox: sandbox.clone(),
+                    result: Err(error.clone()),
+                    retryable,
+                })
+                .collect();
+        }
+    };
+    if response.roots.len() != selected_roots.len() {
+        let error = format!(
+            "exec-server returned {} capability roots for {} requests",
+            response.roots.len(),
+            selected_roots.len()
+        );
+        return selected_roots
+            .into_iter()
+            .map(|selected_root| CachedRoot {
+                selected_root,
+                sandbox: sandbox.clone(),
+                result: Err(error.clone()),
+                retryable: false,
+            })
+            .collect();
+    }
+    selected_roots
+        .into_iter()
+        .zip(response.roots)
+        .map(|(selected_root, discovery)| {
+            let CapabilityRootLocation::Environment { path, .. } = &selected_root.location;
+            let result = if discovery.id == selected_root.id && discovery.path == *path {
+                Ok(Arc::new(discovery))
+            } else {
+                Err(format!(
+                    "exec-server returned mismatched capability root `{}` at {}",
+                    discovery.id, discovery.path
+                ))
+            };
+            CachedRoot {
+                selected_root,
+                sandbox: sandbox.clone(),
+                result,
+                retryable: false,
+            }
+        })
+        .collect()
+}
