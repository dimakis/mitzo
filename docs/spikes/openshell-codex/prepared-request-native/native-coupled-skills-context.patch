+        self.inspect_selected_capability_roots(selected_roots)
+            .ready_roots
+            .into_iter()
+            .filter_map(|selected_root| {
+                let CapabilityRootLocation::Environment { environment_id, .. } =
+                    &selected_root.location;
+                let environment = self.get_environment(environment_id)?;
+                if !matches!(environment.readiness_result(), Some(Ok(()))) {
+                    return None;
+                }
+                Some(ResolvedSelectedCapabilityRoot {
+                    selected_root,
+                    environment,
+                })
+            })
+            .collect()
+    }
