+#[tokio::test]
+async fn prepared_executor_observation_uses_original_ready_owner_and_retained_bytes() {
+    let root_path = create_local_skill_root("prepared-observation").expect("local skill fixture");
+    let manager = Arc::new(EnvironmentManager::default_for_tests());
+    let provider = ExecutorSkillProvider::new_with_restriction_product(
+        Arc::clone(&manager),
+        /*restriction_product*/ None,
+    );
+    let roots = vec![SelectedCapabilityRoot {
+        id: "prepared-root".to_string(),
+        location: CapabilityRootLocation::Environment {
+            environment_id: "local".to_string(),
+            path: PathUri::from_host_native_path(&root_path).unwrap(),
+        },
+    }];
+    let observation = provider
+        .observe_pre_session(&roots, &HashMap::new(), /*selected_plugins*/ None)
+        .await
+        .unwrap();
+    provider
+        .assert_pre_session_observation_owner(&observation)
+        .unwrap();
+    let ordinary = provider
+        .list(SkillListQuery {
+            turn_id: "ordinary-fixture".into(),
+            executor_roots: roots,
+            resolved_executor_roots: Vec::new(),
+            host_snapshot: None,
+            include_host_skills: false,
+            include_bundled_skills: false,
+            include_cloud_skills: false,
+            mcp_resources: None,
+            executor_capability_discovery: Some(observation.discovery().clone()),
+        })
+        .await
+        .unwrap();
+    assert_eq!(observation.catalog().entries, ordinary.entries);
+    assert_eq!(observation.catalog().warnings, ordinary.warnings);
+    assert_eq!(observation.catalog().entries.len(), 1);
+    assert_eq!(observation.tool_specs().len(), 2);
+    let entry = &observation.catalog().entries[0];
+    std::fs::remove_dir_all(&root_path).unwrap();
+    let retained = provider
+        .read(SkillReadRequest {
+            _lifetime: PhantomData,
+            authority: entry.authority.clone(),
+            package: entry.id.clone(),
+            resource: entry.main_prompt.clone(),
+            resolved_executor_roots: Vec::new(),
+            sandbox: None,
+            host_snapshot: None,
+            mcp_resources: None,
+        })
+        .await
+        .unwrap();
+    assert_eq!(retained.contents, SKILL_CONTENTS);
+    let foreign = ExecutorSkillProvider::new_with_restriction_product(
+        manager, /*restriction_product*/ None,
+    );
+    assert_eq!(
+        foreign.assert_pre_session_observation_owner(&observation),
+        Err(codex_skills_extension::ExecutorSkillsObservationError::ForeignProvider)
+    );
+}
