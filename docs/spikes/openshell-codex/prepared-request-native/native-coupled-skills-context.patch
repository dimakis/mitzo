+#[tokio::test]
+async fn passive_root_observation_retains_ready_local_handle_without_creating_missing_environments()
+{
+    let manager = codex_exec_server::EnvironmentManager::default_for_tests();
+    let local = manager
+        .try_local_environment()
+        .expect("original local environment");
+    let local_root = SelectedCapabilityRoot {
+        id: "passive-local".into(),
+        location: CapabilityRootLocation::Environment {
+            environment_id: "local".into(),
+            path: PathUri::parse("file:///passive-observation").unwrap(),
+        },
+    };
+    let mut absent_root = local_root.clone();
+    absent_root.id = "passive-missing".into();
+    absent_root.location = CapabilityRootLocation::Environment {
+        environment_id: "never-created".into(),
+        path: PathUri::parse("file:///passive-observation").unwrap(),
+    };
+    let observed =
+        manager.observe_ready_selected_capability_roots(&[local_root.clone(), absent_root]);
+    assert_eq!(observed.len(), 1);
+    assert_eq!(observed[0].selected_root(), &local_root);
+    assert!(Arc::ptr_eq(observed[0].environment(), &local));
+    assert!(manager.get_environment("never-created").is_none());
+}
