new file mode 100644
index 0000000..ecb643f
--- /dev/null
+++ b/codex-rs/ext/skills/src/first_context_observation.rs
@@ -0,0 +1,228 @@
+use std::collections::HashMap;
+
+use codex_extension_api::ContextualUserFragment;
+use codex_extension_api::ExtensionRegistry;
+use codex_extension_api::PromptFragment;
+use codex_extension_api::RenderedWorldStateFragment;
+use codex_extension_api::ToolSpec;
+use codex_protocol::models::ResponseItem;
+use codex_protocol::openai_models::ModelInfo;
+use codex_protocol::user_input::UserInput;
+
+use super::RegisteredSkillsSource;
+use super::RegisteredSkillsSourceError;
+use crate::ExecutorSkillsObservation;
+use crate::HostSkillPromptObservation;
+use crate::HostSkillsObservation;
+use crate::InjectedHostSkillPrompts;
+use crate::SkillsExtensionConfig;
+use crate::fragments::main_prompt_truncation_warning;
+use crate::fragments::render_selected_skill_instructions;
+use crate::host_prompt::supersede_selected_host_prompts;
+use crate::selection::collect_explicit_skill_mentions;
+use crate::sources::NativeSkillProviderSource;
+use crate::world_state_catalogs::InitialSkillCatalogs;
+use crate::world_state_catalogs::render_initial_filesystem_catalogs;
+
+/// Original source projection and exact first input facts. Private construction
+/// keeps them paired; selected config/model/connector currency is not a lease.
+pub struct SkillsInputObservation<'a, C: Sync> {
+    source: &'a RegisteredSkillsSource<C>,
+    registry: &'a ExtensionRegistry<C>,
+    config: SkillsExtensionConfig,
+    model: ModelInfo,
+    user_input: Vec<UserInput>,
+    connector_slug_counts: HashMap<String, usize>,
+}
+
+/// Coupled Skills prompt/world-state/first-input/tool DATA from the installed
+/// native pair. No Session or runtime stores, callbacks during rendering,
+/// source publication lease, complete extension inventory or Ready grant.
+pub struct SkillsContextObservation<'a, C: Sync> {
+    input: SkillsInputObservation<'a, C>,
+    executor: ExecutorSkillsObservation<'a>,
+    host: HostSkillPromptObservation,
+    initial_catalogs: InitialSkillCatalogs,
+    extension_items: Vec<ResponseItem>,
+    extension_warnings: Vec<String>,
+    injected_host: InjectedHostSkillPrompts,
+    tools: Vec<ToolSpec>,
+    thread_context: Vec<PromptFragment>,
+}
+
+impl<C> RegisteredSkillsSource<C>
+where
+    C: Send + Sync + 'static,
+{
+    /// Projects only this original source. All native providers are preflighted
+    /// before discovery; unknown/extra providers stay explicitly unresolved.
+    pub fn observe_first_input<'a>(
+        &'a self,
+        registry: &'a ExtensionRegistry<C>,
+        config: &C,
+        model: &ModelInfo,
+        user_input: &[UserInput],
+        connector_slug_counts: &HashMap<String, usize>,
+    ) -> Result<SkillsInputObservation<'a, C>, RegisteredSkillsSourceError> {
+        let projected = self
+            .project_configuration(registry, config)
+            .map_err(RegisteredSkillsSourceError::Registration)?;
+        let providers = self
+            .registration
+            .source()
+            .providers
+            .native_pre_session_sources()
+            .map_err(RegisteredSkillsSourceError::UnresolvedProviders)?;
+        if providers
+            .iter()
+            .filter(|source| matches!(source, NativeSkillProviderSource::Host(_)))
+            .count()
+            != 1
+        {
+            return Err(RegisteredSkillsSourceError::MissingOrAmbiguousHostProvider);
+        }
+        if providers
+            .iter()
+            .filter(|source| matches!(source, NativeSkillProviderSource::Executor(_)))
+            .count()
+            != 1
+        {
+            return Err(RegisteredSkillsSourceError::MissingOrAmbiguousExecutorProvider);
+        }
+        Ok(SkillsInputObservation {
+            source: self,
+            registry,
+            config: projected,
+            model: model.clone(),
+            user_input: user_input.to_vec(),
+            connector_slug_counts: connector_slug_counts.clone(),
+        })
+    }
+
+    /// Captures this source's three partitions from genuine native observations.
+    /// The caller still owns selected HostSkillsService/config/model/permission
+    /// currentness; these data cannot be used as a later transaction guard.
+    pub async fn observe_first_context<'a>(
+        &'a self,
+        input: SkillsInputObservation<'a, C>,
+        host: HostSkillsObservation,
+        executor: ExecutorSkillsObservation<'a>,
+    ) -> Result<SkillsContextObservation<'a, C>, RegisteredSkillsSourceError> {
+        input
+            .registry
+            .assert_context_source_registration(&self.registration)
+            .map_err(RegisteredSkillsSourceError::Registration)?;
+        if !std::ptr::eq(
+            self.registration.source(),
+            input.source.registration.source(),
+        ) {
+            return Err(RegisteredSkillsSourceError::InputSourceChanged);
+        }
+        let providers = self
+            .registration
+            .source()
+            .providers
+            .native_pre_session_sources()
+            .map_err(RegisteredSkillsSourceError::UnresolvedProviders)?;
+        let mut host_catalog = None;
+        let mut executor_matches = 0;
+        for provider in providers {
+            match provider {
+                NativeSkillProviderSource::Host(provider) => {
+                    if host_catalog.is_some() {
+                        return Err(RegisteredSkillsSourceError::MissingOrAmbiguousHostProvider);
+                    }
+                    host_catalog = Some(provider.catalog_for_snapshot(host.snapshot()));
+                }
+                NativeSkillProviderSource::Executor(provider) => {
+                    provider
+                        .assert_pre_session_observation_owner(&executor)
+                        .map_err(RegisteredSkillsSourceError::Executor)?;
+                    executor_matches += 1;
+                }
+            }
+        }
+        if executor_matches != 1 {
+            return Err(RegisteredSkillsSourceError::MissingOrAmbiguousExecutorProvider);
+        }
+        let host_catalog =
+            host_catalog.ok_or(RegisteredSkillsSourceError::MissingOrAmbiguousHostProvider)?;
+        let initial_catalogs = render_initial_filesystem_catalogs(
+            &input.config,
+            &input.model,
+            executor.catalog().clone(),
+            host_catalog,
+        );
+        let selected = collect_explicit_skill_mentions(&input.user_input, executor.catalog());
+        let mut extension_items = Vec::new();
+        let mut extension_warnings = Vec::new();
+        for entry in &selected {
+            let contents = entry
+                .main_prompt
+                .environment_contents()
+                .ok_or(RegisteredSkillsSourceError::MissingExecutorPromptBytes)?;
+            let (fragment, truncated) = render_selected_skill_instructions(entry, contents);
+            if truncated {
+                extension_warnings.push(main_prompt_truncation_warning(entry));
+            }
+            extension_items.push(ResponseItem::from(fragment.render_fragment()));
+        }
+        let mut injected_host = InjectedHostSkillPrompts::default();
+        supersede_selected_host_prompts(host.snapshot(), &selected, &mut injected_host);
+        let host = host
+            .observe_explicit_prompts(&input.user_input, &input.connector_slug_counts)
+            .await
+            .map_err(RegisteredSkillsSourceError::Host)?;
+        let tools = executor.tool_specs();
+        Ok(SkillsContextObservation {
+            input,
+            executor,
+            host,
+            initial_catalogs,
+            extension_items,
+            extension_warnings,
+            injected_host,
+            tools,
+            thread_context: Vec::new(),
+        })
+    }
+}
+
+impl<C: Sync> SkillsContextObservation<'_, C> {
+    /// Native-only providers have no thread-context contribution under the
+    /// original thread query (host/cloud excluded, executor roots absent).
+    pub fn thread_context(&self) -> &[PromptFragment] {
+        &self.thread_context
+    }
+
+    pub fn initial_world_state(&self) -> &[(&'static str, RenderedWorldStateFragment)] {
+        &self.initial_catalogs.fragments
+    }
+    pub fn catalog_warnings(&self) -> &[String] {
+        &self.initial_catalogs.warnings
+    }
+    pub fn host_items(&self) -> Vec<ResponseItem> {
+        self.host.render_items(Some(&self.injected_host))
+    }
+    pub fn extension_items(&self) -> &[ResponseItem] {
+        &self.extension_items
+    }
+    pub fn extension_warnings(&self) -> &[String] {
+        &self.extension_warnings
+    }
+    pub fn host_observation(&self) -> &HostSkillPromptObservation {
+        &self.host
+    }
+    pub fn executor_observation(&self) -> &ExecutorSkillsObservation<'_> {
+        &self.executor
+    }
+    pub fn tool_specs(&self) -> &[ToolSpec] {
+        &self.tools
+    }
+    pub fn model(&self) -> &ModelInfo {
+        &self.input.model
+    }
+    pub fn user_input(&self) -> &[UserInput] {
+        &self.input.user_input
+    }
+}
diff --git a/codex-rs/ext/skills/src/first_context_observation_tests.rs b/codex-rs/ext/skills/src/first_context_observation_tests.rs
