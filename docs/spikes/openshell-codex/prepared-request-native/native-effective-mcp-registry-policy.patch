+#[tokio::test]
+async fn isolated_registry_refuses_before_inherited_plans_or_runtime_callbacks() {
+    use codex_extension_api::IsolatedSessionExtensions;
+    use codex_extension_api::SessionIsolation;
+    use codex_protocol::protocol::InternalSessionSource;
+    use codex_protocol::protocol::SessionSource;
+
+    let config = config().await;
+    let mut manager = manager(&config);
+    let calls = Arc::new(AtomicUsize::new(0));
+    let mut inherited = ExtensionRegistryBuilder::new();
+    inherited.mcp_server_contributor_with_pre_session_plan(
+        Arc::new(RuntimeSource(calls.clone())),
+        unexpected_inherited_plan,
+    );
+    let state = Arc::get_mut(&mut manager.state).expect("unshared owner");
+    state.mcp_manager = Arc::new(McpManager::new_with_extensions(
+        state.plugins_manager.clone(),
+        Arc::new(inherited.build()),
+        state.mcp_manager.codex_apps_tools_cache(),
+    ));
+    let mut isolated = ExtensionRegistryBuilder::new();
+    isolated.mcp_server_contributor(Arc::new(RuntimeSource(calls.clone())));
+    let isolated = Arc::new(isolated.build());
+    assert!(matches!(
+        isolated.pre_session_mcp_overlays(McpPreSessionContext::new(&config, &[])),
+        Err(indices) if indices == vec![0]
+    ));
+    let mut created = manager.state.thread_created_tx.subscribe();
+    // Explicit policy, explicit guardian source, and the manager's actual
+    // guardian default all select the isolated branch in ordinary startup.
+    for selection in 0..3 {
+        let mut options = StartThreadOptions::new(config.clone());
+        options
+            .thread_extension_init
+            .insert(IsolatedSessionExtensions(isolated.clone()));
+        match selection {
+            0 => {
+                options
+                    .thread_extension_init
+                    .insert(SessionIsolation::Isolated);
+            }
+            1 => {
+                options.session_source =
+                    Some(SessionSource::Internal(InternalSessionSource::Guardian));
+            }
+            2 => {
+                Arc::get_mut(&mut manager.state)
+                    .expect("unshared owner")
+                    .session_source = SessionSource::Internal(InternalSessionSource::Guardian);
+            }
+            _ => unreachable!(),
+        }
+        assert_eq!(
+            manager.capture_pre_session_mcp_sources(options).err(),
+            Some(PreSessionMcpError::RequiresInheritedExtensions)
+        );
+    }
+    assert_eq!(calls.load(Ordering::SeqCst), 0);
+    assert_eq!(manager.state.threads.read().await.len(), 0);
+    assert!(matches!(
+        created.try_recv(),
+        Err(tokio::sync::broadcast::error::TryRecvError::Empty)
+    ));
+}
