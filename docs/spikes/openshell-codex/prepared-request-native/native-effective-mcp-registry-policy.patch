+#[tokio::test]
+async fn retained_source_and_isolation_do_not_reselect_manager_defaults() {
+    use codex_extension_api::SessionIsolation;
+    use codex_protocol::protocol::InternalSessionSource;
+    use codex_protocol::protocol::SessionSource;
+
+    let config = config().await;
+    let mut manager = manager(&config);
+    let sources = manager
+        .capture_pre_session_mcp_sources(StartThreadOptions::new(config.clone()))
+        .expect("ordinary inherited registry");
+    Arc::get_mut(&mut manager.state)
+        .expect("unshared owner")
+        .session_source = SessionSource::Internal(InternalSessionSource::Guardian);
+    manager
+        .validate_pre_session_mcp_sources(&sources)
+        .expect("retained original policy");
+    let retained = manager
+        .release_pre_session_start_inputs(sources)
+        .expect("original inputs");
+    assert_eq!(retained.session_source, Some(SessionSource::Exec));
+    assert_eq!(
+        retained
+            .thread_extension_init
+            .get::<SessionIsolation>()
+            .as_deref(),
+        Some(&SessionIsolation::Inherit)
+    );
+    // Ordinary precedence remains exact: an explicit source or policy overrides
+    // the manager/source default, using the same helper as real spawn_thread.
+    let mut explicit_source = StartThreadOptions::new(config.clone());
+    explicit_source.session_source = Some(SessionSource::Exec);
+    let sources = manager
+        .capture_pre_session_mcp_sources(explicit_source)
+        .expect("explicit ordinary source");
+    manager
+        .release_pre_session_start_inputs(sources)
+        .expect("original explicit source");
+    let mut explicit_policy = StartThreadOptions::new(config);
+    explicit_policy
+        .thread_extension_init
+        .insert(SessionIsolation::Inherit);
+    let sources = manager
+        .capture_pre_session_mcp_sources(explicit_policy)
+        .expect("explicit inherited policy");
+    let retained = manager
+        .release_pre_session_start_inputs(sources)
+        .expect("original explicit policy");
+    assert_eq!(
+        retained.session_source,
+        Some(SessionSource::Internal(InternalSessionSource::Guardian))
+    );
+    assert_eq!(
+        retained
+            .thread_extension_init
+            .get::<SessionIsolation>()
+            .as_deref(),
+        Some(&SessionIsolation::Inherit)
+    );
+    assert_eq!(manager.state.threads.read().await.len(), 0);
+}
