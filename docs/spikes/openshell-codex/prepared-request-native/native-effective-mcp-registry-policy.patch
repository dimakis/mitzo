+            return Err(PreSessionMcpError::RequiresInheritedExtensions);
+        }
+        // Retain the actual resolved ordinary defaults so release cannot select
+        // another source/registry policy if the manager's default later changes.
+        options.session_source = Some(session_source);
+        options.thread_extension_init.insert(isolation);
