+struct DormantRemote(Arc<AtomicUsize>);
+
+impl codex_exec_server::NoiseRendezvousConnectProvider for DormantRemote {
+    fn connect_bundle(
+        &self,
+        _: codex_exec_server::NoiseChannelPublicKey,
+    ) -> futures::future::BoxFuture<
+        '_,
+        Result<codex_exec_server::NoiseRendezvousConnectBundle, codex_exec_server::ExecServerError>,
+    > {
+        self.0.fetch_add(1, Ordering::SeqCst);
+        Box::pin(futures::future::pending())
+    }
+}
