+use crate::config::Config;
+use crate::config::test_config;
+
+async fn config() -> Config {
+    let mut config = test_config().await;
+    config
+        .features
+        .disable(Feature::Apps)
+        .expect("Apps fixture");
+    config
+        .features
+        .disable(Feature::Plugins)
+        .expect("plugin fixture");
+    config.mcp_servers = Constrained::allow_any(HashMap::new());
+    config
+}
+
+fn manager(config: &Config) -> ThreadManager {
+    ThreadManager::with_models_provider_and_home_for_tests(
+        CodexAuth::from_api_key("offline-no-model-call"),
+        config.model_provider.clone(),
+        config.codex_home.to_path_buf(),
+        Arc::new(EnvironmentManager::default_for_tests()),
+    )
+}
+
+#[tokio::test]
+async fn fresh_capture_retains_ordinary_inputs_without_startup_or_default_reselection() {
+    let config = config().await;
+    let manager = manager(&config);
+    let mut created = manager.state.thread_created_tx.subscribe();
+    let mut options = StartThreadOptions::new(config.clone());
+    let tools = vec![DynamicToolSpec::Function(DynamicToolFunctionSpec {
+        name: "ReadKnowledge".to_string(),
+        description: "synthetic selected profile schema custody fixture".to_string(),
+        input_schema: json!({"type":"object","properties":{"query":{"type":"string"}}}),
+        defer_loading: true,
+    })];
+    options.dynamic_tools = tools.clone();
+    let selections = manager.default_environment_selections(&config.cwd, &config.workspace_roots);
+    let sources = manager
+        .capture_pre_session_mcp_sources(options)
+        .expect("closed sources");
+    assert!(!sources.binding().has_servers());
+    assert!(sources.binding().tools().is_empty());
+    assert!(
+        sources
+            .binding()
+            .config()
+            .mcp_server_catalog
+            .configured_servers()
+            .is_empty()
+    );
+    assert_eq!(&sources.start_options().dynamic_tools, &tools);
+    assert_eq!(
+        &sources.start_options().environments,
+        &Some(selections.clone())
+    );
+    assert_eq!(manager.state.threads.read().await.len(), 0);
+    assert!(matches!(
+        created.try_recv(),
+        Err(tokio::sync::broadcast::error::TryRecvError::Empty)
+    ));
+    manager
+        .validate_pre_session_mcp_sources(&sources)
+        .expect("same owners");
+    let restored = manager
+        .release_pre_session_start_inputs(sources)
+        .expect("retained inputs");
+    assert_eq!(
+        (
+            restored.config.cwd,
+            restored.dynamic_tools,
+            restored.environments
+        ),
+        (config.cwd, tools, Some(selections))
+    );
+    assert!(matches!(restored.initial_history, InitialHistory::New));
+    assert_eq!(manager.state.threads.read().await.len(), 0);
+}
+
+#[tokio::test]
+async fn configured_or_selected_sources_refuse_instead_of_becoming_an_empty_binding() {
+    let config = config().await;
+    let manager = manager(&config);
+    for feature in [Feature::Apps, Feature::Plugins] {
+        let mut enabled = config.clone();
+        enabled.features.enable(feature).expect("enabled fixture");
+        assert_eq!(
+            manager
+                .capture_pre_session_mcp_sources(StartThreadOptions::new(enabled))
+                .err(),
+            Some(PreSessionMcpError::ConfiguredSources)
+        );
+    }
+    let mut configured = config.clone();
+    configured.mcp_servers = Constrained::allow_any(HashMap::from([(
+        "configured".to_string(),
+        codex_mcp::codex_apps_mcp_server_config(
+            "https://uncontacted.invalid",
+            /*apps_mcp_product_sku*/ None,
+            /*originator*/ None,
+        ),
+    )]));
+    assert_eq!(
+        manager
+            .capture_pre_session_mcp_sources(StartThreadOptions::new(configured))
+            .err(),
+        Some(PreSessionMcpError::ConfiguredSources)
+    );
+    let mut selected = StartThreadOptions::new(config.clone());
+    selected
+        .thread_extension_init
+        .insert(vec![SelectedCapabilityRoot {
+            id: "selected-root".to_string(),
+            location: CapabilityRootLocation::Environment {
+                environment_id: "local".to_string(),
+                path: PathUri::from_abs_path(&config.cwd),
+            },
+        }]);
+    assert_eq!(
+        manager.capture_pre_session_mcp_sources(selected).err(),
+        Some(PreSessionMcpError::SelectedCapabilities)
+    );
+    let mut inherited = StartThreadOptions::new(config);
+    inherited.initial_history = InitialHistory::Cleared;
+    assert_eq!(
+        manager.capture_pre_session_mcp_sources(inherited).err(),
+        Some(PreSessionMcpError::RequiresFreshInputs)
+    );
+    assert_eq!(manager.state.threads.read().await.len(), 0);
+}
+
+static PLAN_CALLS: AtomicUsize = AtomicUsize::new(0);
+
+fn observed_plan(_context: McpPreSessionContext<'_, Config>) -> McpPreSessionOverlay {
+    PLAN_CALLS.fetch_add(1, Ordering::SeqCst);
+    McpPreSessionOverlay::NoContributions
+}
+
+struct RuntimeSource(Arc<AtomicUsize>);
+
+impl McpServerContributor<Config> for RuntimeSource {
+    fn id(&self) -> &'static str {
+        "runtime-source"
+    }
+
+    fn contribute<'a>(
+        &'a self,
+        _context: McpServerContributionContext<'a, Config>,
+    ) -> codex_extension_api::ExtensionFuture<'a, Vec<McpServerContribution>> {
+        self.0.fetch_add(1, Ordering::SeqCst);
+        Box::pin(async { Vec::new() })
+    }
+}
+
+#[tokio::test]
+async fn unknown_registration_refuses_before_closed_plans_or_runtime_callbacks() {
+    let config = config().await;
+    let mut manager = manager(&config);
+    let calls = Arc::new(AtomicUsize::new(0));
+    let mut registry = ExtensionRegistryBuilder::new();
+    registry.mcp_server_contributor_with_pre_session_plan(
+        Arc::new(RuntimeSource(calls.clone())),
+        observed_plan,
+    );
+    registry.mcp_server_contributor(Arc::new(RuntimeSource(calls.clone())));
+    let state = Arc::get_mut(&mut manager.state).expect("unshared owner");
+    state.mcp_manager = Arc::new(McpManager::new_with_extensions(
+        state.plugins_manager.clone(),
+        Arc::new(registry.build()),
+        state.mcp_manager.codex_apps_tools_cache(),
+    ));
+    PLAN_CALLS.store(0, Ordering::SeqCst);
+    assert_eq!(
+        manager
+            .capture_pre_session_mcp_sources(StartThreadOptions::new(config))
+            .err(),
+        Some(PreSessionMcpError::UnresolvedContributors(vec![1]))
+    );
+    assert_eq!(
+        (
+            PLAN_CALLS.load(Ordering::SeqCst),
+            calls.load(Ordering::SeqCst)
+        ),
+        (0, 0)
+    );
+    assert_eq!(manager.state.threads.read().await.len(), 0);
+}
+
+#[tokio::test]
+async fn unresolved_and_duplicate_environments_refuse_and_replaced_owners_invalidate() {
+    let config = config().await;
+    let mut manager = manager(&config);
+    let selections = manager.default_environment_selections(&config.cwd, &config.workspace_roots);
+    for state in [
+        EnvironmentConfigState::Pending,
+        EnvironmentConfigState::Failed("unavailable".into()),
+    ] {
+        let mut selected = selections.clone();
+        selected[0].config = state;
+        let mut options = StartThreadOptions::new(config.clone());
+        options.environments = Some(selected);
+        assert_eq!(
+            manager.capture_pre_session_mcp_sources(options).err(),
+            Some(PreSessionMcpError::UnresolvedEnvironment("local".into()))
+        );
+    }
+    let mut duplicate = StartThreadOptions::new(config.clone());
+    duplicate.environments = Some([selections.clone(), selections].concat());
+    assert_eq!(
+        manager.capture_pre_session_mcp_sources(duplicate).err(),
+        Some(PreSessionMcpError::UnresolvedEnvironment("local".into()))
+    );
+    let capture = manager
+        .capture_pre_session_mcp_sources(StartThreadOptions::new(config.clone()))
+        .expect("closed source");
+    let state = Arc::get_mut(&mut manager.state).expect("unshared owner");
+    state.mcp_manager = Arc::new(McpManager::new(state.plugins_manager.clone()));
+    assert_eq!(
+        manager.validate_pre_session_mcp_sources(&capture),
+        Err(PreSessionMcpError::SourceOwnerChanged)
+    );
+    let capture = manager
+        .capture_pre_session_mcp_sources(StartThreadOptions::new(config))
+        .expect("closed source");
+    Arc::get_mut(&mut manager.state)
+        .expect("unshared owner")
+        .environment_manager = Arc::new(EnvironmentManager::default_for_tests());
+    assert_eq!(
+        manager.validate_pre_session_mcp_sources(&capture),
+        Err(PreSessionMcpError::SourceOwnerChanged)
+    );
+}
