+use crate::PreSessionMcpError;
+use crate::PreSessionMcpSources;
+
+use super::StartThreadOptions;
+use super::ThreadManager;
+
+impl ThreadManager {
+    /// Retains a fresh ordinary start's inputs when the actual configuration,
+    /// registered sources and process-local environment owners establish MCP
+    /// absence. This neither starts a Session nor qualifies a prepared request.
+    pub fn capture_pre_session_mcp_sources(
+        &self,
+        options: StartThreadOptions,
+    ) -> Result<PreSessionMcpSources, PreSessionMcpError> {
+        self.state
+            .mcp_manager
+            .capture_pre_session_fresh_sources(options, self.state.environment_manager.clone())
+    }
+
+    /// Renews only this packet's registry/environment custody. Actual selected
+    /// configuration/source/account renewal and prepared admission remain
+    /// separate requirements before count association or any dispatch.
+    pub fn validate_pre_session_mcp_sources(
+        &self,
+        sources: &PreSessionMcpSources,
+    ) -> Result<(), PreSessionMcpError> {
+        self.state
+            .mcp_manager
+            .validate_pre_session_sources(sources, &self.state.environment_manager)
+    }
+
+    /// Returns the retained ordinary options, including the resolved original
+    /// environment selection. This restores inputs, not an execution permit.
+    pub fn release_pre_session_start_inputs(
+        &self,
+        sources: PreSessionMcpSources,
+    ) -> Result<StartThreadOptions, PreSessionMcpError> {
+        self.validate_pre_session_mcp_sources(&sources)?;
+        Ok(sources.into_start_options())
+    }
+}
+
