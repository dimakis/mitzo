diff --git a/codex-rs/core/src/mcp/pre_session.rs b/codex-rs/core/src/mcp/pre_session.rs
new file mode 100644
index 0000000..187019d
--- /dev/null
+++ b/codex-rs/core/src/mcp/pre_session.rs
@@ -0,0 +1,224 @@
+use std::collections::HashSet;
+use std::sync::Arc;
+
+use codex_core_plugins::PluginLoadOutcome;
+use codex_exec_server::Environment;
+use codex_exec_server::EnvironmentManager;
+use codex_extension_api::McpPreSessionContext;
+use codex_extension_api::McpPreSessionOverlay;
+use codex_features::Feature;
+use codex_history::InitialHistory;
+use codex_mcp::McpBinding;
+use codex_protocol::capabilities::SelectedCapabilityRoot;
+use codex_protocol::protocol::EnvironmentConfigState;
+use codex_protocol::protocol::TurnEnvironmentSelection;
+
+use super::McpManager;
+use crate::environment_selection::default_thread_environment_selections;
+use crate::thread_manager::StartThreadOptions;
+
+/// Retains genuine ordinary start inputs with configuration-owned MCP absence.
+///
+/// "Local" means the native process's actual local executor, including when the
+/// process runs inside an OpenShell sandbox. It does not select a Mac, account,
+/// provider, installed runtime or target. No Session or MCP runtime is created.
+/// This is only a source partition: configuration/source/account currentness,
+/// complete request capture, counting and prepared admission remain required.
+pub struct PreSessionMcpSources {
+    owner: Arc<()>,
+    options: StartThreadOptions,
+    environment_manager: Arc<EnvironmentManager>,
+    environments: Vec<(String, Arc<Environment>)>,
+    selection_origin: SelectionOrigin,
+    binding: Arc<McpBinding>,
+}
+
+enum SelectionOrigin {
+    Explicit,
+    Default,
+}
+
+impl PreSessionMcpSources {
+    /// The actual retained ordinary inputs, including dynamic Tools/Knowledge.
+    pub fn start_options(&self) -> &StartThreadOptions {
+        &self.options
+    }
+
+    pub fn binding(&self) -> &Arc<McpBinding> {
+        &self.binding
+    }
+
+    pub(crate) fn into_start_options(self) -> StartThreadOptions {
+        self.options
+    }
+}
+
+#[derive(Debug, thiserror::Error, Eq, PartialEq)]
+pub enum PreSessionMcpError {
+    #[error("MCP preparation requires fresh, non-inherited native start inputs")]
+    RequiresFreshInputs,
+    #[error("configured MCP, Apps or plugin sources require unresolved inventory")]
+    ConfiguredSources,
+    #[error("selected capability roots require unresolved inventory")]
+    SelectedCapabilities,
+    #[error("selected environment {0} is unavailable or requires discovery")]
+    UnresolvedEnvironment(String),
+    #[error("MCP source registrations require unresolved inventory at {0:?}")]
+    UnresolvedContributors(Vec<usize>),
+    #[error("captured MCP source owner or selected environment changed")]
+    SourceOwnerChanged,
+}
+
+impl McpManager {
+    pub(crate) fn capture_pre_session_fresh_sources(
+        &self,
+        mut options: StartThreadOptions,
+        environment_manager: Arc<EnvironmentManager>,
+    ) -> Result<PreSessionMcpSources, PreSessionMcpError> {
+        if !matches!(&options.initial_history, InitialHistory::New)
+            || options.inherited_environments.is_some()
+            || options.internal_parent.is_some()
+        {
+            return Err(PreSessionMcpError::RequiresFreshInputs);
+        }
+        let config = &options.config;
+        if config.features.enabled(Feature::Apps)
+            || config.features.enabled(Feature::Plugins)
+            || !config.mcp_servers.get().is_empty()
+        {
+            return Err(PreSessionMcpError::ConfiguredSources);
+        }
+        let thread_roots = options
+            .thread_extension_init
+            .get::<Vec<SelectedCapabilityRoot>>();
+        if thread_roots
+            .as_deref()
+            .is_some_and(|roots| !roots.is_empty())
+        {
+            return Err(PreSessionMcpError::SelectedCapabilities);
+        }
+
+        // Resolve defaults with the same owner used by ordinary thread/start.
+        // Retaining Some prevents a later start from silently selecting new defaults.
+        let (selections, selection_origin) = match options.environments.take() {
+            Some(selections) => (selections, SelectionOrigin::Explicit),
+            None => (
+                default_thread_environment_selections(
+                    &environment_manager,
+                    &config.cwd,
+                    &config.workspace_roots,
+                ),
+                SelectionOrigin::Default,
+            ),
+        };
+        let mut environments = Vec::with_capacity(selections.len());
+        let mut seen = HashSet::with_capacity(selections.len());
+        for selection in &selections {
+            if !seen.insert(selection.environment_id.clone()) {
+                return Err(PreSessionMcpError::UnresolvedEnvironment(
+                    selection.environment_id.clone(),
+                ));
+            }
+            let environment = environment_manager
+                .get_environment(&selection.environment_id)
+                .filter(|environment| !environment.is_remote())
+                .ok_or_else(|| {
+                    PreSessionMcpError::UnresolvedEnvironment(selection.environment_id.clone())
+                })?;
+            match &selection.config {
+                EnvironmentConfigState::Pending | EnvironmentConfigState::Failed(_) => {
+                    return Err(PreSessionMcpError::UnresolvedEnvironment(
+                        selection.environment_id.clone(),
+                    ));
+                }
+                EnvironmentConfigState::Ready(config) => {
+                    if !config.selected_capability_roots.is_empty() {
+                        return Err(PreSessionMcpError::SelectedCapabilities);
+                    }
+                }
+                EnvironmentConfigState::FromThread => {
+                    if !environment.selected_capability_roots().is_empty() {
+                        return Err(PreSessionMcpError::SelectedCapabilities);
+                    }
+                }
+            }
+            environments.push((selection.environment_id.clone(), environment));
+        }
+
+        let overlays = self
+            .extensions
+            .pre_session_mcp_overlays(McpPreSessionContext::new(
+                config,
+                thread_roots
+                    .as_deref()
+                    .map(Vec::as_slice)
+                    .unwrap_or_default(),
+            ))
+            .map_err(PreSessionMcpError::UnresolvedContributors)?;
+        for (index, overlay) in overlays.into_iter().enumerate() {
+            match overlay {
+                McpPreSessionOverlay::NoContributions
+                | McpPreSessionOverlay::RemoveServer { .. } => {}
+                McpPreSessionOverlay::Unresolved => {
+                    return Err(PreSessionMcpError::UnresolvedContributors(vec![index]));
+                }
+            }
+        }
+
+        // All registered sources can only remove/omit servers, and the actual
+        // effective configuration above contains no server/plugin/Apps source.
+        // Reuse ordinary config construction; do not call plugin loading or an
+        // existing runtime's current_binding (which can start discovery).
+        let mcp_config = config
+            .to_mcp_config_with_loaded_plugins(&PluginLoadOutcome::default(), std::iter::empty());
+        if !mcp_config
+            .mcp_server_catalog
+            .configured_servers()
+            .is_empty()
+        {
+            return Err(PreSessionMcpError::ConfiguredSources);
+        }
+        let binding = Arc::new(McpBinding::empty(Arc::new(mcp_config)));
+        options.environments = Some(selections);
+        Ok(PreSessionMcpSources {
+            owner: Arc::clone(&self.pre_session_source_identity),
+            options,
+            environment_manager,
+            environments,
+            selection_origin,
+            binding,
+        })
+    }
+
+    pub(crate) fn validate_pre_session_sources(
+        &self,
+        sources: &PreSessionMcpSources,
+        environment_manager: &Arc<EnvironmentManager>,
+    ) -> Result<(), PreSessionMcpError> {
+        if !Arc::ptr_eq(&self.pre_session_source_identity, &sources.owner)
+            || !Arc::ptr_eq(environment_manager, &sources.environment_manager)
+        {
+            return Err(PreSessionMcpError::SourceOwnerChanged);
+        }
+        if matches!(sources.selection_origin, SelectionOrigin::Default)
+            && Some(default_thread_environment_selections(
+                environment_manager,
+                &sources.options.config.cwd,
+                &sources.options.config.workspace_roots,
+            ))
+            .as_ref()
+                != sources.options.environments.as_ref()
+        {
+            return Err(PreSessionMcpError::SourceOwnerChanged);
+        }
+        for (environment_id, environment) in &sources.environments {
+            if !environment_manager
+                .get_environment(environment_id)
+                .is_some_and(|current| Arc::ptr_eq(&current, environment))
+            {
+                return Err(PreSessionMcpError::SourceOwnerChanged);
+            }
+        }
+        Ok(())
+    }
+}
