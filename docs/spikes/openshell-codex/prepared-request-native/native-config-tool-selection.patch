diff --git a/codex-rs/ext/extension-api/src/tool_pre_session.rs b/codex-rs/ext/extension-api/src/tool_pre_session.rs
new file mode 100644
index 0000000..4072e56
--- /dev/null
+++ b/codex-rs/ext/extension-api/src/tool_pre_session.rs
@@ -0,0 +1,120 @@
+use std::sync::Arc;
+use std::sync::Mutex;
+use std::sync::PoisonError;
+
+use crate::ConfigContributor;
+use crate::ExtensionData;
+use crate::ExtensionFuture;
+use crate::ThreadLifecycleContributor;
+use crate::ThreadStartInput;
+use crate::ToolCall;
+use crate::ToolContributor;
+use crate::ToolExecutor;
+
+/// Config-only declaration from the registered tool source. NoTools settles only
+/// this source's executable tools; context/instructions require their own capture.
+/// Sources needing runtime, model, account, roots or discovery remain Unresolved.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum ToolPreSessionSelection {
+    NoTools,
+    Unresolved,
+}
+
+/// Effect-free source-owned selection using the actual effective config. Share
+/// ordinary selection logic; never call runtime/discovery or consult mutable state.
+pub type ToolPreSessionPlan<C> = Arc<dyn Fn(&C) -> ToolPreSessionSelection + Send + Sync>;
+
+#[derive(Default)]
+struct ThreadToolSelections(Mutex<Vec<(Arc<()>, ToolPreSessionSelection)>>);
+
+pub(crate) struct PlannedToolContributor<C> {
+    contributor: Arc<dyn ToolContributor>,
+    plan: ToolPreSessionPlan<C>,
+    identity: Arc<()>,
+}
+
+impl<C> PlannedToolContributor<C> {
+    pub(crate) fn new(contributor: Arc<dyn ToolContributor>, plan: ToolPreSessionPlan<C>) -> Self {
+        Self {
+            contributor,
+            plan,
+            identity: Arc::new(()),
+        }
+    }
+
+    fn install_selection(&self, config: &C, thread_store: &ExtensionData) {
+        let selection = (self.plan)(config);
+        let selections = thread_store.get_or_init(ThreadToolSelections::default);
+        let mut selections = selections.0.lock().unwrap_or_else(PoisonError::into_inner);
+        if let Some((_, current)) = selections
+            .iter_mut()
+            .find(|(identity, _)| Arc::ptr_eq(identity, &self.identity))
+        {
+            *current = selection;
+        } else {
+            selections.push((Arc::clone(&self.identity), selection));
+        }
+    }
+
+    fn selection(&self, thread_store: &ExtensionData) -> ToolPreSessionSelection {
+        thread_store
+            .get::<ThreadToolSelections>()
+            .and_then(|selections| {
+                selections
+                    .0
+                    .lock()
+                    .unwrap_or_else(PoisonError::into_inner)
+                    .iter()
+                    .find(|(identity, _)| Arc::ptr_eq(identity, &self.identity))
+                    .map(|(_, selection)| *selection)
+            })
+            .unwrap_or(ToolPreSessionSelection::Unresolved)
+    }
+}
+
+impl<C: Sync> ThreadLifecycleContributor<C> for PlannedToolContributor<C> {
+    fn on_thread_start<'a>(&'a self, input: ThreadStartInput<'a, C>) -> ExtensionFuture<'a, ()> {
+        Box::pin(async move {
+            self.install_selection(input.config, input.thread_store);
+        })
+    }
+}
+
+impl<C> ConfigContributor<C> for PlannedToolContributor<C> {
+    fn on_config_changed(
+        &self,
+        _session: &ExtensionData,
+        thread: &ExtensionData,
+        _previous: &C,
+        current: &C,
+    ) {
+        self.install_selection(current, thread);
+    }
+}
+
+impl<C> ToolContributor for PlannedToolContributor<C> {
+    fn tools(
+        &self,
+        session: &ExtensionData,
+        thread: &ExtensionData,
+    ) -> Vec<Arc<dyn for<'call> ToolExecutor<ToolCall<'call>>>> {
+        let tools = self.contributor.tools(session, thread);
+        match self.selection(thread) {
+            ToolPreSessionSelection::NoTools => Vec::new(),
+            ToolPreSessionSelection::Unresolved => tools,
+        }
+    }
+
+    fn tools_for_step(
+        &self,
+        session: &ExtensionData,
+        thread: &ExtensionData,
+        step: &ExtensionData,
+    ) -> Vec<Arc<dyn for<'call> ToolExecutor<ToolCall<'call>>>> {
+        let tools = self.contributor.tools_for_step(session, thread, step);
+        match self.selection(thread) {
+            ToolPreSessionSelection::NoTools => Vec::new(),
+            ToolPreSessionSelection::Unresolved => tools,
+        }
+    }
+}
diff --git a/codex-rs/ext/extension-api/tests/pre_session_tools.rs b/codex-rs/ext/extension-api/tests/pre_session_tools.rs
index 8297d69..506f8e1 100644
--- a/codex-rs/ext/extension-api/tests/pre_session_tools.rs
+++ b/codex-rs/ext/extension-api/tests/pre_session_tools.rs
@@ -274,3 +274,164 @@ fn empty_registry_is_resolved_but_empty_state_bound_contributor_is_not() {
         matches!(added.build().capture_pre_session_tools(), Err(PreSessionToolInventoryError::StateBoundContributors { registration_indexes }) if registration_indexes == vec![0])
     );
 }
+
+struct PlannedRuntimeTools {
+    tool: Arc<MutableTool>,
+    calls: Arc<AtomicUsize>,
+}
+
+impl ToolContributor for PlannedRuntimeTools {
+    fn tools(
+        &self,
+        _session: &ExtensionData,
+        _thread: &ExtensionData,
+    ) -> Vec<Arc<dyn for<'call> ToolExecutor<ToolCall<'call>>>> {
+        self.calls.fetch_add(1, Ordering::SeqCst);
+        vec![self.tool.clone()]
+    }
+}
+
+#[tokio::test]
+async fn config_plan_owns_ordinary_absence_and_renews_without_runtime_callbacks() {
+    use codex_extension_api::ThreadStartInput;
+    use codex_extension_api::ToolPreSessionSelection;
+    use codex_protocol::protocol::SessionSource;
+
+    let calls = Arc::new(AtomicUsize::new(0));
+    let plans = Arc::new(AtomicUsize::new(0));
+    let tool = MutableTool::new("planned");
+    let mut builder = ExtensionRegistryBuilder::<bool>::new();
+    let plan_calls = Arc::clone(&plans);
+    builder.tool_contributor_with_pre_session_plan(
+        Arc::new(PlannedRuntimeTools {
+            tool,
+            calls: Arc::clone(&calls),
+        }),
+        Arc::new(move |enabled| {
+            plan_calls.fetch_add(1, Ordering::SeqCst);
+            if *enabled {
+                ToolPreSessionSelection::Unresolved
+            } else {
+                ToolPreSessionSelection::NoTools
+            }
+        }),
+    );
+    let fixed = MutableTool::new("fixed");
+    builder.fixed_tools(vec![fixed]);
+    let registry = builder.build();
+    let capture = registry
+        .capture_pre_session_tools_for_config(&false)
+        .expect("closed absent source");
+    assert_eq!(
+        capture
+            .definitions()
+            .iter()
+            .map(|tool| tool.name().clone())
+            .collect::<Vec<_>>(),
+        vec![ToolName::plain("fixed")]
+    );
+    assert_eq!(calls.load(Ordering::SeqCst), 0);
+    assert_eq!(
+        registry.renew_pre_session_tools(&capture),
+        Err(PreSessionToolInventoryError::ConfigurationRequired)
+    );
+    registry
+        .renew_pre_session_tools_for_config(&capture, &false)
+        .expect("current absent selection");
+    assert_eq!(
+        registry.renew_pre_session_tools_for_config(&capture, &true),
+        Err(PreSessionToolInventoryError::StateBoundContributors {
+            registration_indexes: vec![0]
+        })
+    );
+    assert_eq!(calls.load(Ordering::SeqCst), 0);
+    assert_eq!(
+        registry
+            .to_builder()
+            .build()
+            .renew_pre_session_tools_for_config(&capture, &false),
+        Err(PreSessionToolInventoryError::RegistryChanged)
+    );
+
+    let session = ExtensionData::new("session");
+    let thread = ExtensionData::new("thread");
+    let other_thread = ExtensionData::new("other-thread");
+    let step = ExtensionData::new("step");
+    for contributor in registry.thread_lifecycle_contributors() {
+        contributor
+            .on_thread_start(ThreadStartInput {
+                config: &false,
+                session_source: &SessionSource::Exec,
+                persistent_thread_state_available: false,
+                environments: &[],
+                mcp_resource_client: None,
+                extension_metrics: None,
+                session_store: &session,
+                thread_store: &thread,
+            })
+            .await;
+    }
+    // Even a runtime source that returns tools cannot override its own closed declaration.
+    assert!(
+        registry.tool_contributors()[0]
+            .tools_for_step(&session, &thread, &step)
+            .is_empty()
+    );
+    assert_eq!(calls.load(Ordering::SeqCst), 1);
+    for contributor in registry.config_contributors() {
+        contributor.on_config_changed(&session, &thread, &false, &true);
+    }
+    assert_eq!(
+        registry.tool_contributors()[0]
+            .tools_for_step(&session, &thread, &step)
+            .iter()
+            .map(|tool| tool.tool_name())
+            .collect::<Vec<_>>(),
+        vec![ToolName::plain("planned")]
+    );
+    // Config changes are scoped; a missing ordinary lifecycle does not fabricate absence.
+    assert_eq!(
+        registry.tool_contributors()[0]
+            .tools(&session, &other_thread)
+            .iter()
+            .map(|tool| tool.tool_name())
+            .collect::<Vec<_>>(),
+        vec![ToolName::plain("planned")]
+    );
+    for contributor in registry.config_contributors() {
+        contributor.on_config_changed(&session, &thread, &true, &false);
+    }
+    assert!(
+        registry.tool_contributors()[0]
+            .tools(&session, &thread)
+            .is_empty()
+    );
+}
+
+#[test]
+fn missing_tool_plan_preflights_before_any_closed_plan_or_runtime_callback() {
+    use codex_extension_api::ToolPreSessionSelection;
+    let calls = Arc::new(AtomicUsize::new(0));
+    let plans = Arc::new(AtomicUsize::new(0));
+    let mut builder = ExtensionRegistryBuilder::<()>::new();
+    let plan_calls = Arc::clone(&plans);
+    builder.tool_contributor_with_pre_session_plan(
+        Arc::new(StateBoundTools(Arc::clone(&calls))),
+        Arc::new(move |_| {
+            plan_calls.fetch_add(1, Ordering::SeqCst);
+            ToolPreSessionSelection::NoTools
+        }),
+    );
+    builder.tool_contributor(Arc::new(StateBoundTools(Arc::clone(&calls))));
+    let registry = builder.build();
+    assert_eq!(
+        registry.capture_pre_session_tools_for_config(&()).err(),
+        Some(PreSessionToolInventoryError::StateBoundContributors {
+            registration_indexes: vec![1]
+        })
+    );
+    assert_eq!(
+        (plans.load(Ordering::SeqCst), calls.load(Ordering::SeqCst)),
+        (0, 0)
+    );
+}
