diff --git a/codex-rs/ext/extension-api/src/registry/pre_session_tools.rs b/codex-rs/ext/extension-api/src/registry/pre_session_tools.rs
new file mode 100644
index 0000000..530354f
--- /dev/null
+++ b/codex-rs/ext/extension-api/src/registry/pre_session_tools.rs
@@ -0,0 +1,74 @@
+use std::sync::Arc;
+
+use crate::ExtensionRegistry;
+use crate::PreSessionExtensionTools;
+use crate::PreSessionToolInventoryError;
+use crate::ToolPreSessionSelection;
+
+impl<C: Sync> ExtensionRegistry<C> {
+    /// Captures fixed definitions plus source-proven config-only absence. Every
+    /// unknown registration refuses before any plan runs. This cannot discover
+    /// enabled tools, inspect a Session, or settle their instructions/Core policy.
+    pub fn capture_pre_session_tools_for_config(
+        &self,
+        config: &C,
+    ) -> Result<PreSessionExtensionTools, PreSessionToolInventoryError> {
+        let missing: Vec<_> = self
+            .pre_session_tool_definitions
+            .iter()
+            .zip(&self.tool_pre_session_plans)
+            .enumerate()
+            .filter_map(|(index, (definitions, plan))| {
+                (definitions.is_none() && plan.is_none()).then_some(index)
+            })
+            .collect();
+        if !missing.is_empty() {
+            return Err(PreSessionToolInventoryError::StateBoundContributors {
+                registration_indexes: missing,
+            });
+        }
+        let unresolved: Vec<_> = self
+            .tool_pre_session_plans
+            .iter()
+            .enumerate()
+            .filter_map(|(index, plan)| {
+                plan.as_ref().and_then(|plan| {
+                    (plan(config) == ToolPreSessionSelection::Unresolved).then_some(index)
+                })
+            })
+            .collect();
+        if !unresolved.is_empty() {
+            return Err(PreSessionToolInventoryError::StateBoundContributors {
+                registration_indexes: unresolved,
+            });
+        }
+        Ok(PreSessionExtensionTools {
+            registry_identity: Arc::clone(&self.tool_inventory_identity),
+            requires_config_renewal: self.tool_pre_session_plans.iter().any(Option::is_some),
+            definitions: self
+                .pre_session_tool_definitions
+                .iter()
+                .flatten()
+                .flat_map(|definitions| definitions.iter().cloned())
+                .collect(),
+        })
+    }
+
+    /// Renews this partition with the actual current effective configuration.
+    /// Whole-request source/account/configuration custody remains the caller's
+    /// separate authority; this only settles the registered tool selection.
+    pub fn renew_pre_session_tools_for_config(
+        &self,
+        capture: &PreSessionExtensionTools,
+        config: &C,
+    ) -> Result<(), PreSessionToolInventoryError> {
+        if !Arc::ptr_eq(&self.tool_inventory_identity, &capture.registry_identity) {
+            return Err(PreSessionToolInventoryError::RegistryChanged);
+        }
+        let renewed = self.capture_pre_session_tools_for_config(config)?;
+        if renewed.definitions != capture.definitions {
+            return Err(PreSessionToolInventoryError::SelectionChanged);
+        }
+        Ok(())
+    }
+}
