+#[test]
+fn frozen_count_projection_preserves_settings_and_excludes_delivery_controls() {
+    let mut request = body();
+    request["personality"] = json!("retained personality");
+    request["reasoning"] = json!({"effort":"low", "summary":"detailed"});
+    request["include"] = json!(["reasoning.encrypted_content"]);
+    request["metadata"] = json!({"trace":"retained metadata"});
+    request["prompt_cache_key"] = json!("retained cache key");
+    request["service_tier"] = json!("default");
+    request["stream_options"] = json!({"include_obfuscation":false});
+    let frozen = FrozenResponsesRequest::new(request.clone(), /*model_output_limit*/ 16).unwrap();
+    assert_eq!(frozen.body(), &request);
