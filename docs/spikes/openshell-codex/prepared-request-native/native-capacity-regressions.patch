+#[tokio::test]
+async fn frozen_raw_count_does_not_treat_output_limit_as_context_authority() {
+    let transport = transport(json!({
+        "object":"response.input_tokens", "input_tokens":9_007_199_254_740_991_u64
+    }));
+    let client = ResponsesClient::new(transport.clone(), provider(), Arc::new(Auth));
+    let request = frozen();
