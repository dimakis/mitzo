+#[test]
+fn frozen_refuses_missing_output_and_unsupported_model_limits() {
+    let mut request = body();
+    request.as_object_mut().unwrap().remove("max_output_tokens");
+    assert!(FrozenResponsesRequest::new(request, /*model_output_limit*/ 16).is_err());
+    for limit in [0, 15, MAX_SAFE_INTEGER + 1, u64::MAX] {
+        assert!(
+            FrozenResponsesRequest::new(body(), limit).is_err(),
+            "{limit}"
+        );
+        let encoded = serde_json::to_vec(&body()).unwrap();
+        assert!(FrozenResponsesRequest::from_encoded(&encoded, limit).is_err());
+    }
+}
+
+#[test]
+fn frozen_requires_explicit_disabled_truncation_on_create_and_restore() {
+    for truncation in [
+        None,
+        Some(json!(null)),
+        Some(json!("auto")),
+        Some(json!(false)),
+    ] {
+        let mut request = body();
+        match truncation {
+            Some(value) => request["truncation"] = value,
+            None => {
+                request.as_object_mut().unwrap().remove("truncation");
+            }
+        }
+        let encoded = serde_json::to_vec(&request).unwrap();
+        assert!(FrozenResponsesRequest::new(request, /*model_output_limit*/ 16).is_err());
+        assert!(FrozenResponsesRequest::from_encoded(&encoded, /*model_output_limit*/ 16).is_err());
+    }
+}
