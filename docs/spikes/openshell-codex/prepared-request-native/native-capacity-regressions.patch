+    // No selected-account context-limit authority exists in this client.
+    assert_eq!(
+        client.count_input_tokens(&request).await.unwrap(),
+        9_007_199_254_740_991
+    );
+    let requests = transport.requests.lock().unwrap();
+    assert_eq!(requests.len(), 1);
+    assert_eq!(
+        requests[0].url,
+        "https://api.openai.com/v1/responses/input_tokens"
+    );
+    assert_eq!(
+        serde_json::from_slice::<Value>(&requests[0].prepare_body_for_send().unwrap().body_bytes())
+            .unwrap(),
+        *request.count_body()
+    );
+}
