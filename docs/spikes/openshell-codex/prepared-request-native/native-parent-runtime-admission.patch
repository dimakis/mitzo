+    /// Same Prompt's already-normalized command only; no raw argv0/cwd receipt or reparse.
+    fn matches_parent_prompt(
+        &self,
+        expected: &InterceptedExecPolicyContext,
+        command: &[String],
+    ) -> bool {
+        !self.context.enable_shell_wrapper_parsing
+            && &self.context == expected
+            && self.commands.len() == 1
+            && self.commands[0].as_slice() == command
+            && self.inherited_default_fallback_is_allow()
+    }
+
     /// Inert classification; actual routing, issuer, physical and lifetime gates are separate.
