+/// Borrows the same actual Prompt packet; no production caller is installed yet.
+/// Its constructors and all custody fields remain private to this owner.
+pub(crate) struct InterceptedParentAdmission<'a> {
+    provider: &'a CoreShellActionProvider,
+    bound: &'a BoundParentApproval,
+    captured: &'a CapturedInterceptedEvaluation,
+    selected: &'a crate::session::InterceptedApprovalSelection,
+}
+
+impl<'a> InterceptedParentAdmission<'a> {
+    fn from_actual_prompt(
+        provider: &'a CoreShellActionProvider,
+        captured: &'a CapturedInterceptedEvaluation,
+        selected: &'a crate::session::InterceptedApprovalSelection,
+    ) -> Option<Self> {
+        let bound = provider.parent_approval.as_ref()?;
+        let (action, context) = selected.approval_request();
+        let ApprovalAction::Execve {
+            id,
+            environment_id,
+            source,
+            command,
+            cwd,
+            additional_permissions,
+            ..
+        } = action
+        else {
+            return None;
+        };
+        let expected_context = InterceptedExecPolicyContext {
+            approval_policy: provider.approval_policy,
+            permission_profile: provider.permission_profile.clone(),
+            windows_sandbox_level: provider.review_context.turn().windows_sandbox_level,
+            sandbox_permissions: provider.approval_sandbox_permissions,
+            enable_shell_wrapper_parsing: ENABLE_INTERCEPTED_EXEC_POLICY_SHELL_WRAPPER_PARSING,
+        };
+        let cwd = PathUri::from_abs_path(&cwd);
+        if id != provider.call_id
+            || context.call_id != provider.call_id
+            || context.tool_name != provider.tool_name
+            || environment_id != provider.environment_id
+            || source != provider.source
+            || provider.sandbox_permissions != SandboxPermissions::RequireEscalated
+            || provider.prompt_permissions.is_some()
+            || additional_permissions.is_some()
+            || !captured.matches_parent_prompt(&expected_context, &command)
+            || !Arc::ptr_eq(&captured.evaluated_policy, &bound.provider_policy)
+            || !Arc::ptr_eq(&provider.parent_exec_policy, &bound.provider_policy)
+            || !bound.candidate.matches_child_context(
+                crate::tools::runtimes::unified_exec::parent_binding::ParentChildContext {
+                    permission_profile: &captured.context.permission_profile,
+                    windows_sandbox_level: captured.context.windows_sandbox_level,
+                    environment_id: &environment_id,
+                    cwd: &cwd,
+                },
+            )
+        {
+            return None;
+        }
+        Some(Self {
+            provider,
+            bound,
+            captured,
+            selected,
+        })
+    }
+
+    pub(crate) async fn try_resolve(
+        &self,
+        selected: &crate::session::InterceptedApprovalSelection,
+        used_config: &Arc<crate::config::Config>,
+        hooks: &crate::hook_runtime::PermissionRequestHookObservation,
+        finish: impl FnOnce() -> Option<crate::tools::ApprovalResolution> + Send,
+    ) -> Option<crate::tools::ApprovalResolution> {
+        if !std::ptr::eq(self.selected, selected) {
+            return None;
+        }
+        let policy = self.provider.policy.read().await;
+        if !Arc::ptr_eq(&policy, &self.captured.evaluated_policy)
+            || !Arc::ptr_eq(&policy, &self.bound.provider_policy)
+        {
+            return None;
+        }
+        // Retain the actual provider read guard across Fresh's held-owner check and finish.
+        self.bound
+            .candidate
+            .with_current_parent_resolution(
+                &self.provider.session,
+                selected,
+                used_config,
+                &policy,
+                hooks,
+                finish,
+            )
+            .await
+    }
+}
