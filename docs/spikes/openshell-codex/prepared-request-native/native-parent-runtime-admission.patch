+    /// Inert until the approval owner supplies its fixed resolution continuation.
+    #[cfg(unix)]
+    pub(super) async fn with_current_parent_resolution(
+        &self,
+        session: &Arc<crate::session::session::Session>,
+        selected: &crate::session::InterceptedApprovalSelection,
+        used_config: &Arc<crate::config::Config>,
+        evaluated_policy: &Arc<codex_execpolicy::Policy>,
+        hooks: &crate::hook_runtime::PermissionRequestHookObservation,
+        finish: impl FnOnce() -> Option<crate::tools::ApprovalResolution> + Send,
+    ) -> Option<crate::tools::ApprovalResolution> {
+        #[cfg(test)]
+        let (action, _) = selected.approval_request();
+        self.approval
+            .with_current_parent_resolution(
+                session,
+                selected,
+                used_config,
+                evaluated_policy,
+                hooks,
+                || {
+                    // Session and both synchronous owners still hold their real guards here.
+                    // This orders local admission with the original guard's Release close only.
+                    let admission = self.initial_active.compare_exchange(
+                        true,
+                        true,
+                        std::sync::atomic::Ordering::AcqRel,
+                        std::sync::atomic::Ordering::Acquire,
+                    );
+                    #[cfg(test)]
+                    if let ApprovalAction::Execve {
+                        id, environment_id, ..
+                    } = action
+                    {
+                        record_parent_binding_phase(
+                            session,
+                            ParentBindingPhase::ParentAdmissionAttempt {
+                                call_id: id,
+                                environment_id,
+                                admitted: admission.is_ok(),
+                            },
+                        );
+                    }
+                    admission.ok()?;
+                    finish()
+                },
+            )
+            .await
+    }
