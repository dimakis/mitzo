+//! Plain mapping and retained evaluation only; never a Candidate, Bound or flag.
+use super::*;
+use crate::tools::runtimes::unified_exec::parent_binding::ParentChildContext;
+use crate::tools::runtimes::unified_exec::parent_binding::same_parent_child_context;
+use codex_protocol::permissions::NetworkSandboxPolicy;
+use pretty_assertions::assert_eq;
+
+#[test]
+fn plain_child_context_matches_all_four_original_facts() -> anyhow::Result<()> {
+    let profile = PermissionProfile::read_only();
+    let cwd = PathUri::from_abs_path(&AbsolutePathBuf::current_dir()?);
+    let original = ParentChildContext {
+        permission_profile: &profile,
+        windows_sandbox_level: WindowsSandboxLevel::Disabled,
+        environment_id: "original-environment",
+        cwd: &cwd,
+    };
+    assert!(same_parent_child_context(original, original));
+    let foreign_cwd = PathUri::from_abs_path(&AbsolutePathBuf::current_dir()?.join("other"));
+    let different_profile = PermissionProfile::from_runtime_permissions(
+        &profile.file_system_sandbox_policy(),
+        NetworkSandboxPolicy::Enabled,
+    );
+    let different_filesystem = PermissionProfile::workspace_write();
+    for child in [
+        ParentChildContext {
+            permission_profile: &different_filesystem,
+            ..original
+        },
+        ParentChildContext {
+            permission_profile: &different_profile,
+            ..original
+        },
+        ParentChildContext {
+            windows_sandbox_level: WindowsSandboxLevel::RestrictedToken,
+            ..original
+        },
+        ParentChildContext {
+            environment_id: "foreign-environment",
+            ..original
+        },
+        ParentChildContext {
+            cwd: &foreign_cwd,
+            ..original
+        },
+    ] {
+        assert!(!same_parent_child_context(original, child));
+    }
+    // This is a comparison of plain inputs, not an original-launch receipt.
+    Ok(())
+}
+
+fn context() -> InterceptedExecPolicyContext {
+    InterceptedExecPolicyContext {
+        approval_policy: AskForApproval::OnRequest,
+        permission_profile: PermissionProfile::read_only(),
+        windows_sandbox_level: WindowsSandboxLevel::Disabled,
+        sandbox_permissions: SandboxPermissions::RequireEscalated,
+        enable_shell_wrapper_parsing: false,
+    }
+}
+fn captured() -> anyhow::Result<CapturedInterceptedEvaluation> {
+    let program = AbsolutePathBuf::current_dir()?.join("q4b-plain-command");
+    Ok(CapturedInterceptedEvaluation::evaluate(
+        Arc::new(Policy::empty()),
+        &program,
+        &["original-argv-zero".into(), "first".into(), "second".into()],
+        context(),
+    ))
+}
+
+#[test]
+fn actual_single_evaluation_matches_its_normalized_command_without_mutation() -> anyhow::Result<()>
+{
+    let captured = captured()?;
+    let original = captured.clone();
+    let command = captured.commands[0].clone();
+    assert_eq!(captured.evaluation.decision, Decision::Prompt);
+    assert!(captured.matches_parent_prompt(&context(), &command));
+    assert_eq!(captured.evaluation, original.evaluation);
+    assert_eq!(captured.commands, original.commands);
+    assert_eq!(captured.context, original.context);
+    assert!(Arc::ptr_eq(
+        &captured.evaluated_policy,
+        &original.evaluated_policy
+    ));
+    // Source custody is the same Prompt/selected packet; this is NOT raw argv0/cwd evidence.
+    Ok(())
+}
+
+#[test]
+fn every_provider_context_input_must_match_the_original_evaluation() -> anyhow::Result<()> {
+    let captured = captured()?;
+    let command = &captured.commands[0];
+    let original = context();
+    let mut expected = original.clone();
+    expected.approval_policy = AskForApproval::Never;
+    assert!(!captured.matches_parent_prompt(&expected, command));
+    expected = original.clone();
+    expected.sandbox_permissions = SandboxPermissions::UseDefault;
+    assert!(!captured.matches_parent_prompt(&expected, command));
+    expected = original.clone();
+    expected.permission_profile = PermissionProfile::from_runtime_permissions(
+        &original.permission_profile.file_system_sandbox_policy(),
+        NetworkSandboxPolicy::Enabled,
+    );
+    assert!(!captured.matches_parent_prompt(&expected, command));
+    expected = original.clone();
+    expected.permission_profile = PermissionProfile::workspace_write();
+    assert!(!captured.matches_parent_prompt(&expected, command));
+    expected = original.clone();
+    expected.windows_sandbox_level = WindowsSandboxLevel::Elevated;
+    assert!(!captured.matches_parent_prompt(&expected, command));
+    expected = original.clone();
+    expected.enable_shell_wrapper_parsing = true;
+    assert!(!captured.matches_parent_prompt(&expected, command));
+    assert!(captured.matches_parent_prompt(&original, command));
+    Ok(())
+}
+
+#[test]
+fn complete_singleton_correspondence_refuses_plain_observation_mutations() -> anyhow::Result<()> {
+    let original = captured()?;
+    let command = original.commands[0].clone();
+    assert!(original.matches_parent_prompt(&context(), &command));
+    for mutation in [
+        "wrapper",
+        "multiple",
+        "empty",
+        "foreign",
+        "reordered",
+        "foreign-match",
+    ] {
+        let mut changed = original.clone();
+        match mutation {
+            "wrapper" => changed.context.enable_shell_wrapper_parsing = true,
+            "multiple" => {
+                changed.commands.push(command.clone());
+                changed
+                    .evaluation
+                    .matched_rules
+                    .push(changed.evaluation.matched_rules[0].clone());
+            }
+            "empty" => changed.commands.clear(),
+            "foreign" => changed.commands[0][0] = "foreign".into(),
+            "reordered" => changed.commands[0].swap(1, 2),
+            "foreign-match" => {
+                let RuleMatch::HeuristicsRuleMatch { command, .. } =
+                    &mut changed.evaluation.matched_rules[0]
+                else {
+                    panic!("actual heuristic fixture")
+                };
+                command[0] = "foreign-match".into();
+            }
+            _ => unreachable!(),
+        }
+        assert!(
+            !changed.matches_parent_prompt(&context(), &command),
+            "{mutation}"
+        );
+    }
+    let mut foreign = command.clone();
+    foreign[1] = "foreign-selected-argument".into();
+    assert!(!original.matches_parent_prompt(&context(), &foreign));
+    assert!(!original.matches_parent_prompt(&context(), &[]));
+    Ok(())
+}
+
+#[test]
+fn actual_wrapper_multiple_commands_and_dangerous_default_do_not_enter_subset() -> anyhow::Result<()>
+{
+    let mut wrapper_context = context();
+    wrapper_context.enable_shell_wrapper_parsing = true;
+    let wrapper = CapturedInterceptedEvaluation::evaluate(
+        Arc::new(Policy::empty()),
+        &AbsolutePathBuf::from_absolute_path("/bin/zsh")?,
+        &["zsh".into(), "-c".into(), "printf first; cat second".into()],
+        wrapper_context.clone(),
+    );
+    assert_eq!(wrapper.commands.len(), 2);
+    assert!(!wrapper.matches_parent_prompt(&wrapper_context, &wrapper.commands[0]));
+    let dangerous = CapturedInterceptedEvaluation::evaluate(
+        Arc::new(Policy::empty()),
+        &AbsolutePathBuf::from_absolute_path("/bin/rm")?,
+        &["rm".into(), "-rf".into(), "/".into()],
+        context(),
+    );
+    assert_eq!(dangerous.evaluation.decision, Decision::Prompt);
+    assert!(!dangerous.matches_parent_prompt(&context(), &dangerous.commands[0]));
+    assert_eq!(
+        dangerous.context.sandbox_permissions,
+        SandboxPermissions::RequireEscalated
+    );
+    Ok(())
+}
