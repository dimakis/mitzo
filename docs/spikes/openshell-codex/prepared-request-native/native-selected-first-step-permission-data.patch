+#[tokio::test]
+async fn permission_context_refuses_foreign_changed_burned_and_keeps_unpaired_baseline()
+-> anyhow::Result<()> {
+    let (_home, options, auth, models, _) = super::super::tests::fixture().await?;
+    let startup =
+        OriginalStartupSelection::capture(&options, &SessionSource::Exec, None, &auth, &models)
+            .await?;
+    let foreign =
+        OriginalStartupSelection::capture(&options, &SessionSource::Exec, None, &auth, &models)
+            .await?;
+    let (_other_home, config, manager) = crate::environment_selection::initial_context::SelectedStartEnvironmentContext::permission_fixture().await;
+    let mut selected = manager
+        .prepare_selected_start(crate::StartThreadOptions::new(config))
+        .await?;
+    manager.capture_selected_start_api_mcp(
+        &mut selected,
+        manager
+            .auth_manager()
+            .capture_cached_api_key_credentials()
+            .unwrap(),
+    )?;
+    let environment =
+        crate::environment_selection::initial_context::SelectedStartEnvironmentContext::observe(
+            selected.mcp_sources().unwrap(),
+        )?;
+    let policy = codex_execpolicy::Policy::empty();
+    let mut candidate = startup.settings_candidate_without_overrides()?;
+    assert!(
+        candidate
+            .render_first_step_permission(&startup, &environment, &policy)?
+            .is_none()
+    );
+    candidate.pair_command(
+        "permissions".into(),
+        codex_protocol::turn_input::TurnInputRequest::user_input(Vec::new()),
+        None,
+        None,
+        None,
+    )?;
+    assert!(
+        candidate
+            .render_first_step_permission(&startup, &environment, &policy)
+            .is_err()
+    );
+    candidate.capture_first_step_model(&startup).await?;
+    assert!(
+        candidate
+            .render_first_step_permission(&foreign, &environment, &policy)
+            .is_err()
+    );
+    assert!(
+        candidate
+            .render_first_step_permission(&startup, &environment, &policy)
+            .is_err()
+    );
+    let step = Arc::clone(&candidate.data.step);
+    candidate.data.step = Arc::new((*step).clone());
+    assert!(
+        candidate
+            .render_first_step_permission(&startup, &environment, &policy)
+            .is_err()
+    );
+    candidate.data.step = step;
+    assert!(candidate.capture_first_step_model(&startup).await.is_err());
+    assert!(
+        candidate
+            .render_first_step_permission(&startup, &environment, &policy)
+            .is_err()
+    );
