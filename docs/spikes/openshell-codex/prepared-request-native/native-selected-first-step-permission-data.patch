+#[tokio::test]
+async fn installed_candidate_permission_projection_uses_private_pipeline_and_keeps_named_root_refusal()
+ {
+    for named in [false, true] {
+        let home = tempfile::tempdir().unwrap();
+        let configs = manager(home.path());
+        let source = configs
+            .load_selected_start_config(
+                None,
+                ConfigOverrides {
+                    cwd: Some(home.path().to_path_buf()),
+                    model: Some("gpt-6-luna".into()),
+                    ..Default::default()
+                },
+            )
+            .await
+            .unwrap();
+        let config = source.config().clone();
+        assert!(config.features.enabled(Feature::Apps));
+        assert!(config.features.enabled(Feature::Plugins));
+        let store = Arc::new(InMemoryThreadStore::default());
+        let (threads, installed, _) =
+            thread_manager_with_models(&config, Arc::clone(&store), |auth| {
+                Arc::new(
+                    codex_models_manager::manager::OpenAiModelsManager::new_without_cache(
+                        Arc::new(NoStartupEndpoint),
+                        Some(Arc::clone(auth)),
+                    ),
+                )
+            });
+        let original = OriginalFirstCommandStart::new(
+            StartThreadOptions::new(config),
+            threads.reserve_thread_start(),
+            installed,
+            crate::request_processors::AppServerClientInfo::capture(None, None),
+        );
+        let mut selected = source
+            .capture_first_command(&threads, original)
+            .await
+            .unwrap();
+        selected.capture_startup(&threads).await.unwrap();
+        selected.capture_startup_api_mcp(&threads).unwrap();
+        let value = if named {
+            serde_json::json!({"input":[],"permissions":"missing-permission-source"})
+        } else {
+            serde_json::json!({"input":[],"approvalPolicy":"never","sandboxPolicy":{"type":"dangerFullAccess"}})
+        };
+        let body = serde_json::from_value(value).unwrap();
+        let paired = selected
+            .capture_command(&threads, "permission-command".into(), body, None)
+            .await;
+        if named {
+            assert!(paired.is_err());
+            assert!(selected.renew(&threads).await.is_err());
+        } else {
+            paired.unwrap();
+            selected.capture_first_step_context(&threads).await.unwrap();
+            let partial = selected.first_step_context.as_ref().unwrap();
+            assert!(partial.unresolved_partitions().contains(
+                &codex_core::UnresolvedInitialContextPartition::FirstCommandPermissionSettings
+            ));
+            assert!(partial.unresolved_partitions().contains(
+                &codex_core::UnresolvedInitialContextPartition::PermissionsAndEnvironmentSnapshot
+            ));
+            selected.renew(&threads).await.unwrap();
+        }
+        assert!(selected.adopt_startup(&threads).await.is_err());
+        assert!(threads.list_thread_ids().await.is_empty());
+        assert_eq!(
+            store.calls().await,
+            codex_thread_store::InMemoryThreadStoreCalls::default()
+        );
+    }
+}
