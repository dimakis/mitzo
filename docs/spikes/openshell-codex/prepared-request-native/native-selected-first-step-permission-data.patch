+#[tokio::test]
+async fn original_local_roots_materialize_proposed_profile_and_refuse_changed_selection_or_cwd() {
+    let (_home, config, manager) = fixture().await;
+    let mut selected = manager
+        .prepare_selected_start(StartThreadOptions::new(config.clone()))
+        .await
+        .unwrap();
+    manager
