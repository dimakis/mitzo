+++ b/codex-rs/core/tests/suite/unified_exec_zsh_fork_persistent_terminal_refusal_tests.rs
@@ -0,0 +1,185 @@
+//! Filesystem changes cannot be approved onto an already-running terminal.
+
+use super::*;
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn persistent_terminal_refuses_changed_denied_reads_before_stdin_or_guardian() -> Result<()> {
+    skip_if_no_network!(Ok(()));
+
+    let approval_policy = AskForApproval::OnRequest;
+    let outside_dir = tempfile::tempdir_in(std::env::current_dir()?)?;
+    let outside_path = outside_dir.path().join("must-not-touch");
+    let initial_denied_path = outside_dir.path().join("original-environment-private");
+    let original_secret = "persistent-terminal-original-policy-secret";
+    fs::write(&initial_denied_path, format!("{original_secret}\n"))?;
+    let rules = r#"prefix_rule(pattern=["touch"], decision="prompt")"#;
+    let Some((server, test)) = build_unified_exec_zsh_fork_test_with_features_or_skip(
+        "unified-exec zsh-fork changed denied-read refusal test",
+        approval_policy,
+        denied_read_permission_profile(&initial_denied_path)?,
+        &[Feature::ExecPermissionApprovals],
+        move |home| {
+            let rules_dir = home.join("rules");
+            fs::create_dir_all(&rules_dir).unwrap();
+            fs::write(rules_dir.join("default.rules"), rules).unwrap();
+        },
+    )
+    .await?
+    else {
+        return Ok(());
+    };
+
+    let next_cwd = test.config.cwd.join("next-turn");
+    fs::create_dir(&next_cwd)?;
+    let next_denied_path = next_cwd.join("next-environment-private");
+    let next_secret = "persistent-terminal-new-policy-secret";
+    fs::write(&next_denied_path, format!("{next_secret}\n"))?;
+    let input_marker = test.config.cwd.join("stdin-must-not-arrive");
+    let read_marker = test.config.cwd.join("newly-denied-read-must-not-arrive");
+    let open_call_id = "uexec-zsh-fork-drift-open";
+    let open_command = "while IFS= read -r command; do eval \"$command\"; done";
+    let open_args = json!({
+        "cmd": open_command,
+        "yield_time_ms": 250,
+        "tty": true,
+        "sandbox_permissions": SandboxPermissions::WithAdditionalPermissions,
+        "additional_permissions": {"file_system": {"write": [outside_dir.path()]}},
+        "justification": "retain a bounded terminal grant before policy changes",
+    });
+    let write_call_id = "uexec-zsh-fork-drift-write";
+    // If input reaches the old shell, its first builtin can write this marker.
+    // The later read is intentionally NOT claimed as a physical-denial test:
+    // current policy must refuse the entire input before any bytes reach it.
+    let write_args = json!({
+        "chars": format!(
+            "printf delivered > {input_marker:?}\nIFS= read -r new_secret < {next_denied_path:?}\nprintf '%s' \"$new_secret\" > {read_marker:?}\ntouch {outside_path:?}\nexit\n"
+        ),
+        "session_id": 1000,
+        "yield_time_ms": 5_000,
+    });
+    let responses = mount_sse_sequence(
+        &server,
+        vec![
+            sse(vec![
+                ev_response_created("resp-drift-open"),
+                ev_function_call(
+                    open_call_id,
+                    "exec_command",
+                    &serde_json::to_string(&open_args)?,
+                ),
+                ev_completed("resp-drift-open"),
+            ]),
+            sse(vec![
+                ev_response_created("resp-drift-first-done"),
+                ev_assistant_message("msg-drift-first-done", "terminal is running"),
+                ev_completed("resp-drift-first-done"),
+            ]),
+            sse(vec![
+                ev_response_created("resp-drift-write"),
+                ev_function_call(
+                    write_call_id,
+                    "write_stdin",
+                    &serde_json::to_string(&write_args)?,
+                ),
+                ev_completed("resp-drift-write"),
+            ]),
+            sse(vec![
+                ev_response_created("resp-drift-second-done"),
+                ev_assistant_message("msg-drift-second-done", "a new terminal is required"),
+                ev_completed("resp-drift-second-done"),
+            ]),
+        ],
+    )
+    .await;
+
+    submit_turn_with_session_permissions(
+        &test,
+        "start a persistent terminal with user approvals",
+        approval_policy,
+        ApprovalsReviewer::User,
+    )
+    .await?;
+    approve_expected_exec(&test, open_command).await?;
+    let first_completion = wait_for_event(&test.codex, |event| {
+        matches!(event, EventMsg::TurnComplete(_))
+    })
+    .await;
+    let EventMsg::TurnComplete(first_completion) = first_completion else {
+        unreachable!("completion wait only returns turn-complete events");
+    };
+
+    let (sandbox_policy, permission_profile) = turn_permission_fields(
+        denied_read_permission_profile(next_denied_path.as_path())?,
+        next_cwd.as_path(),
+    );
+    test.codex
+        .start_or_steer_turn(
+            TurnInputRequest::user_input(vec![UserInput::Text {
+                text: "attempt input after changing the terminal's permission context".into(),
+                text_elements: Vec::new(),
+            }])
+            .with_thread_settings(ThreadSettingsOverrides {
+                environments: Some(local_selections(next_cwd)),
+                approvals_reviewer: Some(ApprovalsReviewer::AutoReview),
+                sandbox_policy: Some(sandbox_policy),
+                permission_profile,
+                ..Default::default()
+            }),
+        )
+        .await?;
+
+    let mut current_turn_id = None;
+    loop {
+        let event = tokio::time::timeout(Duration::from_secs(30), test.codex.next_event())
+            .await
+            .context("timed out waiting for changed-permission terminal refusal")??;
+        match event.msg {
+            EventMsg::TurnStarted(started) => current_turn_id = Some(started.turn_id),
+            EventMsg::GuardianAssessment(assessment) => {
+                panic!("incompatible terminal input reached Guardian: {assessment:?}")
+            }
+            EventMsg::ExecApprovalRequest(_) => {
+                panic!("incompatible terminal input requested manual approval")
+            }
+            EventMsg::TurnComplete(completed) => {
+                assert_eq!(Some(completed.turn_id), current_turn_id);
+                break;
+            }
+            _ => {}
+        }
+    }
+    let current_turn_id = current_turn_id.context("expected the refusal turn to start")?;
+    assert_ne!(current_turn_id, first_completion.turn_id);
+
+    let requests = responses.requests();
+    assert_eq!(requests.len(), 4);
+    assert!(requests.iter().all(|request| {
+        request.body_json()["client_metadata"]["x-openai-subagent"].as_str() != Some("guardian")
+    }));
+    let output = requests.last().unwrap().function_call_output(write_call_id);
+    let result = parse_result(&output);
+    assert_eq!(
+        result.stdout,
+        "write_stdin rejected: this terminal cannot enforce the current denied-read restrictions; start a new terminal"
+    );
+    assert!(
+        !input_marker.exists(),
+        "rejected stdin reached the old shell"
+    );
+    assert!(
+        !read_marker.exists(),
+        "rejected stdin performed its read/output"
+    );
+    assert!(!outside_path.exists(), "rejected stdin executed its child");
+    assert_eq!(
+        fs::read_to_string(&initial_denied_path)?,
+        format!("{original_secret}\n")
+    );
+    assert_eq!(
+        fs::read_to_string(&next_denied_path)?,
+        format!("{next_secret}\n")
+    );
+    assert!(!output.to_string().contains(original_secret));
+    assert!(!output.to_string().contains(next_secret));
+    Ok(())
+}
