@@ -0,0 +1,84 @@
+use super::*;
+use crate::responses_request_format::InternalMetadataPolicy;
+use crate::responses_request_format::RequestCopyNormalization;
+use crate::responses_request_format::ResolvedResponsesRequestContext;
+use crate::responses_request_format::ResponsesGenerationOptions;
+use crate::responses_request_format::format_responses_request;
+use crate::responses_request_format::normalize_request_copy;
+use pretty_assertions::assert_eq;
+
+#[test]
+fn formatter_matches_actual_ordinary_owner_bytes_and_copy_normalization() -> anyhow::Result<()> {
+    let client = test_model_client(SessionSource::Exec);
+    let metadata = test_responses_metadata_for_client(
+        &client,
+        Some("captured-turn"),
+        "captured-window".into(),
+        /*parent_thread_id*/ None,
+        TestCodexResponsesRequestKind::Turn,
+    );
+    let mut model = test_model_info();
+    let prompt = Prompt {
+        input: vec![serde_json::from_value(json!({
+            "type":"message", "id":"legacy", "role":"user",
+            "content":[{"type":"input_text", "text":"ordinary captured input"}]
+        }))?],
+        base_instructions: BaseInstructions {
+            text: "ordinary captured instructions".into(),
+            provenance: None,
+        },
+        ..Default::default()
+    };
+    for use_responses_lite in [false, true] {
+        model.use_responses_lite = use_responses_lite;
+        let mut actual = client.build_responses_request(
+            &prompt,
+            &model,
+            /*effort*/ None,
+            codex_protocol::config_types::ReasoningSummary::Auto,
+            Some("flex".into()),
+            &metadata,
+            /*include_internal*/ false,
+        )?;
+        let captured = ResolvedResponsesRequestContext {
+            thread_id: client.state.thread_id,
+            is_openai: client.state.provider.info().is_openai(),
+            is_amazon_bedrock: client.state.provider.info().is_amazon_bedrock(),
+            namespace_tools: client.state.provider.capabilities().namespace_tools,
+            reasoning_effort_override_enabled: client.reasoning_effort_override_enabled(&model),
+            concurrent_reasoning_summaries_enabled: client
+                .state
+                .concurrent_reasoning_summaries_enabled,
+            model_verbosity: client.state.model_verbosity,
+            prompt_cache_key: client.prompt_cache_key(&metadata),
+            // HashMap iteration order is already nondeterministic across independent ordinary
+            // builds. Retain this owner's resolved map for exact encoding comparison.
+            client_metadata: actual
+                .client_metadata
+                .clone()
+                .expect("ordinary client metadata"),
+            internal_metadata: InternalMetadataPolicy::Omit,
+        };
+        let mut shared = format_responses_request(
+            &prompt,
+            &model,
+            &captured,
+            ResponsesGenerationOptions {
+                effort: None,
+                summary: codex_protocol::config_types::ReasoningSummary::Auto,
+                service_tier: Some("flex".into()),
+            },
+        )?;
+        assert_eq!(serde_json::to_vec(&actual)?, serde_json::to_vec(&shared)?);
+        client.prepare_response_items_for_request(&mut actual.input);
+        normalize_request_copy(
+            &mut shared.input,
+            RequestCopyNormalization {
+                content_item_kinds_enabled: client.state.content_item_kinds_enabled,
+            },
+        );
+        assert_eq!(serde_json::to_vec(&actual)?, serde_json::to_vec(&shared)?);
+        assert_eq!(serde_json::to_value(&prompt.input)?[0]["id"], "legacy");
+    }
+    Ok(())
+}
