+        "auto_compact_token_limit":null, "experimental_supported_tools":[]
+    })).unwrap()
+}
+
+fn context() -> ResolvedResponsesRequestContext {
+    ResolvedResponsesRequestContext {
+        thread_id: ThreadId::from_string("018f9e15-7a6a-7000-8000-000000000001").unwrap(),
+        is_openai: true,
+        is_amazon_bedrock: false,
