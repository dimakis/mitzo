+#[test]
+fn formatter_preserves_independent_provider_flags_and_configuration_filtering() {
+    let mut prompt = prompt();
+    prompt.input.push(
+        serde_json::from_value(
+            json!({"type":"configuration_update", "reasoning":{"effort":"medium"}}),
+        )
+        .unwrap(),
+    );
+    prompt.input.push(serde_json::from_value(json!({"type":"function_call", "call_id":"call", "name":"fixture_tool", "arguments":"{}", "encrypted_function_args":["retained"]})).unwrap());
+    for is_openai in [false, true] {
+        for is_amazon_bedrock in [false, true] {
+            let mut context = context();
+            context.is_openai = is_openai;
+            context.is_amazon_bedrock = is_amazon_bedrock;
+            let request = format_responses_request(&prompt, &model(), &context, options()).unwrap();
+            assert_eq!(request.input.len(), 2);
+            assert_eq!(
+                request.service_tier,
+                (!is_amazon_bedrock).then(|| "flex".to_string())
+            );
+            assert_eq!(request.stream_options.is_some(), is_openai);
+            let wire = serde_json::to_value(request).unwrap();
+            assert_eq!(
+                wire["input"][1].get("encrypted_function_args").cloned(),
+                is_openai.then(|| json!(["retained"]))
+            );
+        }
+    }
+}
