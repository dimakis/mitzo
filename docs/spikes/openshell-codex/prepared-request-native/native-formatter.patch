+#[test]
+fn formatter_normalizes_only_the_supplied_request_copy() {
+    let input: Vec<ResponseItem> = serde_json::from_value(json!([
+        {"type":"message", "id":"legacy", "role":"user", "content":[{"type":"input_text", "text":"captured"}], "internal_chat_message_metadata_passthrough":{"content_item_kinds":["captured-kind"]}},
+        {"type":"message", "id":"msg_retained", "role":"user", "content":[]}
+    ])).unwrap();
+    let mut copy = input.clone();
+    normalize_request_copy(
+        &mut copy,
+        RequestCopyNormalization {
+            content_item_kinds_enabled: false,
+        },
+    );
+    let wire = serde_json::to_value(&copy).unwrap();
+    assert_eq!(wire[0].get("id"), None);
+    assert_eq!(wire[1]["id"], "msg_retained");
+    assert_eq!(
+        wire[0].get("internal_chat_message_metadata_passthrough"),
+        None
+    );
+    assert_eq!(serde_json::to_value(&input).unwrap()[0]["id"], "legacy");
+}
