+#[test]
+fn formatter_preserves_lite_framing_and_deterministic_reserved_identity() {
+    let prompt = prompt();
+    let mut model = model();
+    model.use_responses_lite = true;
+    for namespace_tools in [false, true] {
+        let mut context = context();
+        context.namespace_tools = namespace_tools;
+        let request = format_responses_request(&prompt, &model, &context, options()).unwrap();
+        let again = format_responses_request(&prompt, &model, &context, options()).unwrap();
+        assert_eq!(
+            serde_json::to_vec(&request).unwrap(),
+            serde_json::to_vec(&again).unwrap()
+        );
+        let wire = serde_json::to_value(&request).unwrap();
+        let namespace = Uuid::new_v5(
+            &Uuid::NAMESPACE_OID,
+            context.thread_id.to_string().as_bytes(),
+        );
+        let tools_id = Uuid::new_v5(
+            &namespace,
+            &serde_json::to_vec(&wire["input"][0]["tools"]).unwrap(),
+        );
+        let instructions_id = Uuid::new_v5(&namespace, b"captured instructions");
+        assert_eq!(wire["input"][0]["id"], format!("at_{tools_id}"));
+        assert_eq!(wire["input"][1]["id"], format!("msg_{instructions_id}"));
+        assert_eq!(wire["input"][2]["content"][1].get("detail"), None);
+        assert_eq!(
+            (
+                request.instructions,
+                request.tools,
+                request.parallel_tool_calls
+            ),
+            (String::new(), None, false)
+        );
+    }
+}
