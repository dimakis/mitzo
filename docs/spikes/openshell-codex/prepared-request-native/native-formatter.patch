diff --git a/codex-rs/core/src/responses_request_format.rs b/codex-rs/core/src/responses_request_format.rs
new file mode 100644
index 0000000..4e6bd08
--- /dev/null
+++ b/codex-rs/core/src/responses_request_format.rs
@@ -0,0 +1,211 @@
+//! Pure formatting of a complete, already-resolved ordinary Responses request.
+//!
+//! Callers own coherent source capture, provider/auth resolution and all late request contributors.
+//! This ordinary body retains native metadata and has no output cap or truncation field. It is
+//! deliberately not a public prepared-request adapter; adding a public route requires an explicit
+//! supported body contract, rather than stripping unsupported fields here.
+
+use crate::client_common::Prompt;
+use crate::context::BaseInstructionsFragment;
+use crate::context::ContextualUserFragment;
+use codex_api::Reasoning;
+use codex_api::ReasoningContext;
+use codex_api::ResponsesApiRequest;
+use codex_api::StreamOptions;
+use codex_api::create_text_param_for_request;
+use codex_protocol::ResponseItemId;
+use codex_protocol::ThreadId;
+use codex_protocol::config_types::ReasoningSummary as ReasoningSummaryConfig;
+use codex_protocol::config_types::Verbosity as VerbosityConfig;
+use codex_protocol::error::Result;
+use codex_protocol::models::ResponseItem;
+use codex_protocol::openai_models::ModelInfo;
+use codex_protocol::openai_models::ReasoningEffort as ReasoningEffortConfig;
+use codex_tools::create_tools_json_for_responses_api;
+use codex_tools::create_tools_json_for_responses_lite;
+use codex_tools::create_tools_raw_json_for_responses_api;
+use std::collections::HashMap;
+use uuid::Uuid;
+
+/// Immutable values captured by the existing request owner before pure formatting.
+pub(crate) struct ResolvedResponsesRequestContext {
+    pub(crate) thread_id: ThreadId,
+    pub(crate) is_openai: bool,
+    pub(crate) is_amazon_bedrock: bool,
+    pub(crate) namespace_tools: bool,
+    pub(crate) reasoning_effort_override_enabled: bool,
+    pub(crate) concurrent_reasoning_summaries_enabled: bool,
+    pub(crate) model_verbosity: Option<VerbosityConfig>,
+    pub(crate) prompt_cache_key: String,
+    pub(crate) client_metadata: HashMap<String, String>,
+    pub(crate) internal_metadata: InternalMetadataPolicy,
+}
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+pub(crate) enum InternalMetadataPolicy {
+    Include,
+    Omit,
+}
+
+pub(crate) struct ResponsesGenerationOptions {
+    pub(crate) effort: Option<ReasoningEffortConfig>,
+    pub(crate) summary: ReasoningSummaryConfig,
+    pub(crate) service_tier: Option<String>,
+}
+
+pub(crate) struct RequestCopyNormalization {
+    pub(crate) content_item_kinds_enabled: bool,
+}
+
+pub(crate) fn format_responses_request(
+    prompt: &Prompt,
+    model_info: &ModelInfo,
+    context: &ResolvedResponsesRequestContext,
+    options: ResponsesGenerationOptions,
+) -> Result<ResponsesApiRequest> {
+    let mut input = prompt.get_formatted_input_for_request(model_info);
+    if !context.reasoning_effort_override_enabled {
+        // Unsupported models and disabled overrides must also accept saved history.
+        // Filter only the request copy; persisted history remains unchanged.
+        input.retain(|item| !matches!(item, ResponseItem::ConfigurationUpdate { .. }));
+    }
+    let is_openai = context.is_openai;
+    let (instructions, tools) = if model_info.use_responses_lite {
+        // These prompt-only items are rebuilt on every request. Hash their visible payloads
+        // within the thread so retries and resumed sessions preserve their identity.
+        let prefix_namespace = Uuid::new_v5(
+            &Uuid::NAMESPACE_OID,
+            context.thread_id.to_string().as_bytes(),
+        );
+        let tools = if context.namespace_tools {
+            create_tools_json_for_responses_lite(&prompt.tools)?
+        } else {
+            create_tools_json_for_responses_api(&prompt.tools)?
+        };
+        let mut prefix = vec![ResponseItem::AdditionalTools {
+            id: Some(ResponseItemId::with_suffix(
+                "at",
+                Uuid::new_v5(&prefix_namespace, &serde_json::to_vec(&tools)?),
+            )),
+            role: "developer".to_string(),
+            tools,
+        }];
+        if !prompt.base_instructions.text.is_empty() {
+            let mut instructions = ContextualUserFragment::into(BaseInstructionsFragment(
+                prompt.base_instructions.text.clone(),
+            ));
+            instructions.set_id(Some(ResponseItemId::with_suffix(
+                "msg",
+                Uuid::new_v5(&prefix_namespace, prompt.base_instructions.text.as_bytes()),
+            )));
+            prefix.push(instructions);
+        }
+        input.splice(0..0, prefix);
+        (String::new(), None)
+    } else {
+        (
+            prompt.base_instructions.text.clone(),
+            Some(create_tools_raw_json_for_responses_api(&prompt.tools)?.into()),
+        )
+    };
+    if !is_openai {
+        for item in &mut input {
+            item.clear_internal_chat_message_metadata_passthrough();
+            if let ResponseItem::FunctionCall {
+                encrypted_function_args,
+                ..
+            } = item
+            {
+                *encrypted_function_args = None;
+            }
+        }
+    }
+    let reasoning = build_reasoning(model_info, options.effort, options.summary);
+    let stream_options = (context.concurrent_reasoning_summaries_enabled
+        && is_openai
+        && reasoning.summary.is_some())
+    .then_some(StreamOptions {
+        reasoning_summary_delivery: codex_api::ReasoningSummaryDelivery::SequentialCutoff,
+    });
+    let include = vec!["reasoning.encrypted_content".to_string()];
+    let verbosity = if model_info.support_verbosity {
+        context.model_verbosity.or(model_info.default_verbosity)
+    } else {
+        None
+    };
+    let text = create_text_param_for_request(
+        verbosity,
+        &prompt.output_schema,
+        prompt.output_schema_strict,
+    );
+    let prompt_cache_key = Some(context.prompt_cache_key.clone());
+    let service_tier = if context.is_amazon_bedrock {
+        // Bedrock only supports the implicit default tier, including with custom catalogs.
+        None
+    } else {
+        model_info.service_tier_for_request(options.service_tier)
+    };
+    if context.internal_metadata == InternalMetadataPolicy::Omit {
+        for item in &mut input {
+            item.clear_tool_result_metadata();
+        }
+    }
+    let client_metadata = context.client_metadata.clone();
+    let request = ResponsesApiRequest {
+        model: model_info.slug.clone(),
+        instructions,
+        input,
+        tools,
+        tool_choice: "auto".to_string(),
+        parallel_tool_calls: prompt.parallel_tool_calls && !model_info.use_responses_lite,
+        reasoning: Some(reasoning),
+        store: false,
+        stream: true,
+        stream_options,
+        include,
+        service_tier,
+        prompt_cache_key,
+        text,
+        client_metadata: Some(client_metadata),
+        access_programs: None,
+    };
+    Ok(request)
+}
+
+fn build_reasoning(
+    model_info: &ModelInfo,
+    effort: Option<ReasoningEffortConfig>,
+    summary: ReasoningSummaryConfig,
+) -> Reasoning {
+    Reasoning {
+        effort: effort
+            .or_else(|| model_info.default_reasoning_level.clone())
+            .map(|effort| model_info.resolve_reasoning_effort(effort)),
+        summary: (model_info.supports_reasoning_summary_parameter
+            && summary != ReasoningSummaryConfig::None)
+            .then_some(summary),
+        // When Responses Lite is disabled, omit context so Responses uses the default,
+        // which is currently `current_turn`.
+        context: model_info
+            .use_responses_lite
+            .then_some(ReasoningContext::AllTurns),
+    }
+}
+
+pub(crate) fn normalize_request_copy(
+    input: &mut [ResponseItem],
+    settings: RequestCopyNormalization,
+) {
+    for item in input {
+        if item.id().is_some_and(|id| !id.is_prefixed()) {
+            item.set_id(/*new_id*/ None);
+        }
+        if !settings.content_item_kinds_enabled {
+            item.clear_content_item_kinds();
+        }
+    }
+}
+
+#[cfg(test)]
+#[path = "responses_request_format_tests.rs"]
+mod tests;
