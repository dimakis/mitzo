+#[test]
+fn formatter_ordinary_body_does_not_silently_become_a_public_prepared_body() {
+    let request = format_responses_request(&prompt(), &model(), &context(), options()).unwrap();
+    let mut body = serde_json::to_value(request).unwrap();
+    assert!(FrozenResponsesRequest::new(body.clone(), /*model_output_limit*/ 16).is_err());
+    body["max_output_tokens"] = json!(16);
+    body["truncation"] = json!("disabled");
+    assert!(FrozenResponsesRequest::new(body, /*model_output_limit*/ 16).is_err());
+}
