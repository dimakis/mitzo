+#[tokio::test]
+async fn retained_physical_facts_refuse_independent_request_attempt_and_transformed_drift()
+-> anyhow::Result<()> {
+    let fixture = Fixture::new().await?;
+    let proof = fixture.approve().await?;
+    let policy = fixture.session.services.exec_policy.current();
+    for change in [
+        "selected",
+        "requested",
+        "canonical",
+        "request-command",
+        "request-env",
+        "request-cwd",
+        "request-sandbox-cwd",
+        "platform",
+        "environment",
+        "roots",
+        "sandbox-cwd",
+        "helper",
+        "landlock",
+        "windows-type",
+        "configured-windows",
+        "sandbox-requested",
+        "command",
+        "env",
+        "cwd",
+        "sandbox",
+        "profile",
+        "arg0",
+        "network-id",
+        "windows-cwd",
+        "windows-roots",
+        "windows-level",
+    ] {
+        let original = fixture.request();
+        let mut req = original.clone();
+        let profile = original.turn_environment.permission_profile();
+        let mut attempt = fixture.attempt(&original, profile, profile);
+        let mut exec = fixture.transform(&original, &attempt)?;
+        let facts = InitialParentRestrictedLaunch::capture(&original, &attempt, &exec);
+        let executor = CoreShellCommandExecutor::for_initial_request(
+            &original,
+            &attempt,
+            &fixture.context(),
+            &exec,
+        )
+        .map_err(|error| anyhow::anyhow!("actual executor constructor: {error:?}"))?;
+        let changed = AbsolutePathBuf::current_dir()?.join("different-mapping");
+        let roots = vec![PathUri::from(changed.clone())];
+        let sandbox_cwd = PathUri::from(changed.clone());
+        let helper = changed.to_path_buf();
+        let disabled = PermissionProfile::Disabled;
+        match change {
+            "selected" => {
+                req.turn_environment.config_mut().permission_profile =
+                    PermissionProfileSnapshot::legacy(disabled.clone())
+            }
+            "requested" => attempt.permissions = &disabled,
+            "canonical" => attempt.exec_server_permissions = &disabled,
+            "request-command" => req.command.push("different".into()),
+            "request-env" => {
+                req.env.insert("DIFFERENT".into(), "value".into());
+            }
+            "request-cwd" => req.cwd = changed.clone().into(),
+            "request-sandbox-cwd" => req.sandbox_cwd = changed.clone().into(),
+            "platform" => req.turn_environment.executor_platform_os = Some("different".into()),
+            "environment" => req.turn_environment.selection.environment_id = "different".into(),
+            "roots" => attempt.workspace_roots = &roots,
+            "sandbox-cwd" => attempt.sandbox_cwd = &sandbox_cwd,
+            "helper" => attempt.sandbox_exe = Some(&helper),
+            "landlock" => attempt.use_legacy_landlock = !attempt.use_legacy_landlock,
+            "windows-type" => attempt.windows_sandbox_type = SandboxType::WindowsMxc,
+            "configured-windows" => attempt.windows_sandbox_level = WindowsSandboxLevel::Elevated,
+            "sandbox-requested" => attempt.sandbox_requested = false,
+            "command" => exec.command.push("different".into()),
+            "env" => {
+                exec.env.insert("DIFFERENT".into(), "value".into());
+            }
+            "cwd" => exec.cwd = changed.clone().into(),
+            "sandbox" => exec.sandbox = SandboxType::None,
+            "profile" => exec.permission_profile = disabled,
+            "arg0" => exec.arg0 = Some("different".into()),
+            "network-id" => exec.network_environment_id = Some("different".into()),
+            "windows-cwd" => exec.windows_sandbox_policy_cwd = changed.clone().into(),
+            "windows-roots" => exec.windows_sandbox_workspace_roots.push(changed.clone()),
+            "windows-level" => exec.windows_sandbox_level = WindowsSandboxLevel::Elevated,
+            _ => unreachable!(),
+        }
+        assert!(
+            !facts.matches_executor(
+                &proof,
+                &req,
+                &attempt,
+                &exec,
+                executor.parent_launch_view(),
+                &policy
+            ),
+            "{change}"
+        );
+    }
+    fixture.close().await;
+    Ok(())
+}
