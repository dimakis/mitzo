+#[tokio::test]
+async fn actual_executor_fields_and_unsupported_transform_options_cannot_be_silently_remapped()
+-> anyhow::Result<()> {
+    let fixture = Fixture::new().await?;
+    let proof = fixture.approve().await?;
+    let original = fixture.request();
+    let profile = original.turn_environment.permission_profile();
+    let attempt = fixture.attempt(&original, profile, profile);
+    let policy = fixture.session.services.exec_policy.current();
+    for change in [
+        "command",
+        "env",
+        "cwd",
+        "profile",
+        "sandbox",
+        "arg0",
+        "network-id",
+        "windows-cwd",
+        "windows-roots",
+        "windows-level",
+        "helper",
+        "landlock",
+        "exec-server-env",
+        "request-exec-server-env",
+        "windows-overrides",
+    ] {
+        let mut req = original.clone();
+        let mut exec = fixture.transform(&req, &attempt)?;
+        let facts = InitialParentRestrictedLaunch::capture(&req, &attempt, &exec);
+        let mut executor = CoreShellCommandExecutor::for_initial_request(
+            &req,
+            &attempt,
+            &fixture.context(),
+            &exec,
+        )
+        .map_err(|error| anyhow::anyhow!("actual executor constructor: {error:?}"))?;
+        let changed = AbsolutePathBuf::current_dir()?.join("different-executor");
+        match change {
+            "command" => executor.command.push("different".into()),
+            "env" => {
+                executor.env.insert("DIFFERENT".into(), "value".into());
+            }
+            "cwd" => executor.cwd = changed.clone(),
+            "profile" => executor.permission_profile = PermissionProfile::Disabled,
+            "sandbox" => executor.sandbox = SandboxType::None,
+            "arg0" => executor.arg0 = Some("different".into()),
+            "network-id" => executor.network_environment_id = Some("different".into()),
+            "windows-cwd" => executor.sandbox_policy_cwd = changed.clone(),
+            "windows-roots" => executor
+                .windows_sandbox_workspace_roots
+                .push(changed.clone()),
+            "windows-level" => executor.windows_sandbox_level = WindowsSandboxLevel::Elevated,
+            "helper" => executor.codex_linux_sandbox_exe = Some(changed.to_path_buf()),
+            "landlock" => executor.use_legacy_landlock = !executor.use_legacy_landlock,
+            "exec-server-env" | "request-exec-server-env" => {
+                let config = ExecServerEnvConfig {
+                    policy: codex_exec_server::ExecEnvPolicy {
+                        inherit: req
+                            .turn_environment
+                            .shell_environment_policy()
+                            .inherit
+                            .clone(),
+                        ignore_default_excludes: false,
+                        exclude: Vec::new(),
+                        r#set: HashMap::new(),
+                        include_only: Vec::new(),
+                    },
+                    local_policy_env: HashMap::new(),
+                };
+                if change == "exec-server-env" {
+                    exec.exec_server_env_config = Some(config);
+                } else {
+                    req.exec_server_env_config = Some(config);
+                }
+            }
+            "windows-overrides" => {
+                exec.windows_sandbox_filesystem_overrides =
+                    Some(codex_sandboxing::WindowsSandboxFilesystemOverrides {
+                        read_roots_override: None,
+                        read_roots_include_platform_defaults: false,
+                        write_roots_override: None,
+                        additional_deny_read_paths: Vec::new(),
+                        additional_deny_write_paths: Vec::new(),
+                    })
+            }
+            _ => unreachable!(),
+        }
+        assert!(
+            !facts.matches_executor(
+                &proof,
+                &req,
+                &attempt,
+                &exec,
+                executor.parent_launch_view(),
+                &policy
+            ),
+            "{change}"
+        );
+    }
+    fixture.close().await;
+    Ok(())
+}
