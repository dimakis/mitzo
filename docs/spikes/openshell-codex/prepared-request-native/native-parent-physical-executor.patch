diff --git a/codex-rs/core/src/tools/runtimes/unified_exec/parent_binding.rs b/codex-rs/core/src/tools/runtimes/unified_exec/parent_binding.rs
new file mode 100644
index 0000000..b7481e4
--- /dev/null
+++ b/codex-rs/core/src/tools/runtimes/unified_exec/parent_binding.rs
@@ -0,0 +1,154 @@
+//! Passive launch observations. These comparisons cannot admit an intercepted call.
+use super::UnifiedExecRequest;
+use crate::sandboxing::ExecRequest;
+#[cfg(unix)]
+use crate::tools::approvals::FreshParentApproval;
+use crate::tools::sandboxing::SandboxAttempt;
+use codex_protocol::config_types::WindowsSandboxLevel;
+use codex_protocol::models::PermissionProfile;
+use codex_sandboxing::SandboxType;
+use codex_utils_absolute_path::AbsolutePathBuf;
+use codex_utils_path_uri::PathUri;
+use std::collections::HashMap;
+use std::path::PathBuf;
+
+/// Plain first-attempt facts, not approval evidence or a process lifetime.
+#[derive(PartialEq)]
+pub(in crate::tools::runtimes) struct InitialParentRestrictedLaunch {
+    selected_permissions: PermissionProfile,
+    requested_permissions: PermissionProfile,
+    canonical_permissions: PermissionProfile,
+    permission_profile: PermissionProfile,
+    executor_platform_os: Option<String>,
+    sandbox: SandboxType,
+    cwd: PathUri,
+    sandbox_cwd: PathUri,
+    workspace_roots: Vec<PathUri>,
+    sandbox_exe: Option<PathBuf>,
+    use_legacy_landlock: bool,
+    windows_sandbox_type: SandboxType,
+    windows_sandbox_level: WindowsSandboxLevel,
+    configured_windows_sandbox_level: WindowsSandboxLevel,
+    windows_policy_cwd: PathUri,
+    windows_workspace_roots: Vec<AbsolutePathBuf>,
+    environment_id: String,
+    network_environment_id: Option<String>,
+    command: Vec<String>,
+    env: HashMap<String, String>,
+    arg0: Option<String>,
+    request_command: Vec<String>,
+    request_env: HashMap<String, String>,
+    request_cwd: PathUri,
+    request_sandbox_cwd: PathUri,
+}
+
+/// Borrowed from the actual executor, before its escalation-session environment overlay.
+#[cfg(unix)]
+pub(in crate::tools::runtimes) struct ParentExecutorView<'a> {
+    pub command: &'a [String],
+    pub cwd: &'a AbsolutePathBuf,
+    pub permission_profile: &'a PermissionProfile,
+    pub sandbox: SandboxType,
+    pub env: &'a HashMap<String, String>,
+    pub network: Option<&'a codex_network_proxy::NetworkProxy>,
+    pub network_environment_id: &'a Option<String>,
+    pub windows_sandbox_level: WindowsSandboxLevel,
+    pub arg0: &'a Option<String>,
+    pub sandbox_policy_cwd: &'a AbsolutePathBuf,
+    pub windows_workspace_roots: &'a [AbsolutePathBuf],
+    pub sandbox_exe: Option<&'a PathBuf>,
+    pub use_legacy_landlock: bool,
+}
+
+impl InitialParentRestrictedLaunch {
+    pub(in crate::tools::runtimes) fn capture(
+        req: &UnifiedExecRequest,
+        attempt: &SandboxAttempt<'_>,
+        exec: &ExecRequest,
+    ) -> Self {
+        Self {
+            selected_permissions: req.turn_environment.permission_profile().clone(),
+            requested_permissions: attempt.permissions.clone(),
+            canonical_permissions: attempt.exec_server_permissions.clone(),
+            permission_profile: exec.permission_profile.clone(),
+            executor_platform_os: req.turn_environment.executor_platform_os.clone(),
+            sandbox: exec.sandbox,
+            cwd: exec.cwd.clone(),
+            sandbox_cwd: attempt.sandbox_cwd.clone(),
+            workspace_roots: attempt.workspace_roots.to_vec(),
+            sandbox_exe: attempt.sandbox_exe.cloned(),
+            use_legacy_landlock: attempt.use_legacy_landlock,
+            windows_sandbox_type: attempt.windows_sandbox_type,
+            windows_sandbox_level: exec.windows_sandbox_level,
+            configured_windows_sandbox_level: attempt.windows_sandbox_level,
+            windows_policy_cwd: exec.windows_sandbox_policy_cwd.clone(),
+            windows_workspace_roots: exec.windows_sandbox_workspace_roots.clone(),
+            environment_id: req.turn_environment.selection.environment_id.clone(),
+            network_environment_id: exec.network_environment_id.clone(),
+            command: exec.command.clone(),
+            env: exec.env.clone(),
+            arg0: exec.arg0.clone(),
+            request_command: req.command.clone(),
+            request_env: req.env.clone(),
+            request_cwd: req.cwd.clone(),
+            request_sandbox_cwd: req.sandbox_cwd.clone(),
+        }
+    }
+
+    #[cfg(unix)]
+    pub(in crate::tools::runtimes) fn matches_executor(
+        &self,
+        approval: &FreshParentApproval,
+        req: &UnifiedExecRequest,
+        attempt: &SandboxAttempt<'_>,
+        exec: &ExecRequest,
+        executor: ParentExecutorView<'_>,
+        policy: &std::sync::Arc<codex_execpolicy::Policy>,
+    ) -> bool {
+        approval.matches_original_exec_policy(policy)
+            && self == &Self::capture(req, attempt, exec)
+            && super::restricted_parent_approval_permissions(
+                req.sandbox_permissions,
+                req.turn_environment.permission_profile(),
+                attempt.permissions,
+                attempt.exec_server_permissions,
+                &exec.permission_profile,
+            )
+            && attempt.sandbox_requested
+            && attempt.sandbox != SandboxType::None
+            && exec.sandbox == attempt.sandbox
+            && !req.turn_environment.environment.is_remote()
+            && req.turn_environment.config().exec_policy.is_none()
+            && req.turn_environment.config().network_policy.is_none()
+            && req.exec_server_env_config.is_none()
+            && req.shell_snapshot.is_none()
+            && req.network.is_none()
+            && req.additional_permissions.is_none()
+            && !req.additional_permissions_preapproved
+            && attempt.network_proxy.is_none()
+            && !attempt.enforce_managed_network
+            && attempt.network_denial_cancellation_token.is_none()
+            && exec.exec_server_env_config.is_none()
+            && exec.exec_server_shell_snapshot.is_none()
+            && exec.windows_sandbox_filesystem_overrides.is_none()
+            && exec.network.is_none()
+            && !exec.exec_server_enforce_managed_network
+            && exec.exec_server_managed_network.is_none()
+            && exec.exec_server_network_proxy.is_none()
+            && exec.exec_server_sandbox.is_none()
+            && executor.command == exec.command.as_slice()
+            && PathUri::from_abs_path(executor.cwd) == exec.cwd
+            && executor.permission_profile == &exec.permission_profile
+            && executor.sandbox == exec.sandbox
+            && executor.env == &exec.env
+            && executor.network.is_none()
+            && executor.network_environment_id == &exec.network_environment_id
+            && executor.windows_sandbox_level == exec.windows_sandbox_level
+            && executor.arg0 == &exec.arg0
+            && PathUri::from_abs_path(executor.sandbox_policy_cwd)
+                == exec.windows_sandbox_policy_cwd
+            && executor.windows_workspace_roots == exec.windows_sandbox_workspace_roots.as_slice()
+            && executor.sandbox_exe == attempt.sandbox_exe
+            && executor.use_legacy_landlock == attempt.use_legacy_landlock
+    }
+}
