@@ -0,0 +1,89 @@
+//! Original initial-state/reset DATA and original model-change precedence.
+//! Captured values are not mutable Session currentness, history or admission.
+use crate::session::PreviousTurnSettings;
+use codex_protocol::models::BaseInstructionsProvenance;
+
+// These bodies are the original distinct producer sites, not a New/empty-history
+// inference. Ordinary owners invoke them at their original field/write stages.
+pub(crate) fn constructor_previous_settings() -> Option<PreviousTurnSettings> {
+    None
+}
+pub(crate) fn fresh_history_previous_settings() -> Option<PreviousTurnSettings> {
+    None
+}
+
+pub(crate) struct InitialPreviousSettingsSeed {
+    value: Option<PreviousTurnSettings>,
+}
+pub(crate) struct FreshHistoryPreviousSettingsReset {
+    value: Option<PreviousTurnSettings>,
+}
+impl InitialPreviousSettingsSeed {
+    pub(in crate::session) fn capture() -> Box<Self> {
+        Box::new(Self {
+            value: constructor_previous_settings(),
+        })
+    }
+    pub(crate) fn into_value(self: Box<Self>) -> Option<PreviousTurnSettings> {
+        self.value
+    }
+}
+impl FreshHistoryPreviousSettingsReset {
+    pub(in crate::session) fn capture() -> Box<Self> {
+        Box::new(Self {
+            value: fresh_history_previous_settings(),
+        })
+    }
+    pub(in crate::session) fn snapshot(&self) -> Option<PreviousTurnSettings> {
+        self.value.clone()
+    }
+    pub(in crate::session) fn into_value(self: Box<Self>) -> Option<PreviousTurnSettings> {
+        self.value
+    }
+}
+pub(crate) enum InitialPreviousSettingsInput {
+    Ordinary,
+    Retained(Box<InitialPreviousSettingsSeed>),
+}
+impl InitialPreviousSettingsInput {
+    pub(crate) fn into_value(self) -> Option<PreviousTurnSettings> {
+        match self {
+            Self::Ordinary => constructor_previous_settings(),
+            Self::Retained(seed) => seed.into_value(),
+        }
+    }
+}
+pub(in crate::session) enum FreshPreviousSettingsInput {
+    Ordinary,
+    Retained(Box<FreshHistoryPreviousSettingsReset>),
+}
+impl FreshPreviousSettingsInput {
+    pub(in crate::session) fn into_value(self) -> Option<PreviousTurnSettings> {
+        match self {
+            Self::Ordinary => fresh_history_previous_settings(),
+            Self::Retained(reset) => reset.into_value(),
+        }
+    }
+}
+
+pub(crate) fn previous_model(
+    previous: Option<PreviousTurnSettings>,
+    provenance: &Option<BaseInstructionsProvenance>,
+    base_instructions: &str,
+    model_instructions: &str,
+) -> Option<String> {
+    previous.map(|previous| previous.model).or_else(|| {
+        provenance
+            .as_ref()
+            .and_then(|provenance| match provenance {
+                BaseInstructionsProvenance::Model { model } => Some(model),
+                BaseInstructionsProvenance::Custom => None,
+            })
+            .filter(|_| base_instructions != model_instructions)
+            .cloned()
+    })
+}
+
+#[cfg(test)]
+#[path = "initial_model_state_data_tests.rs"]
+mod tests;
diff --git a/codex-rs/core/src/session/initial_model_state_data_tests.rs b/codex-rs/core/src/session/initial_model_state_data_tests.rs
