+#[tokio::test]
+async fn actual_fresh_capsule_moves_distinct_constructor_and_post_event_reset_once()
+-> anyhow::Result<()> {
+    use crate::session::initial_model_state_data::{
+        constructor_previous_settings, fresh_history_previous_settings,
+    };
+    let (_home, manager, id, options, mut inputs, effective, source) = captured().await?;
+    let mut data = inputs
+        .take_fresh_history(id, &effective, &source, &options.initial_history)?
+        .unwrap();
+    let preview = data.preview_previous_settings(&effective, &source)?;
+    let initial_address = std::ptr::from_ref(data.initial_previous.as_ref().unwrap().as_ref());
+    let reset_address = std::ptr::from_ref(data.fresh_reset.as_ref().unwrap().as_ref());
+    assert_ne!(initial_address.cast::<()>(), reset_address.cast::<()>());
+    data.take_window_ids()?;
+    let _context = data.take_context(&effective, &source, &options.initial_history)?;
+    let initial = data.take_initial_previous(&effective, &source, &options.initial_history)?;
+    assert_eq!(std::ptr::from_ref(initial.as_ref()), initial_address);
+    assert_eq!(initial.into_value(), constructor_previous_settings());
+    let reset = data.take_fresh_reset(&effective, &source, &options.initial_history)?;
+    assert_eq!(std::ptr::from_ref(reset.as_ref()), reset_address);
+    assert_eq!(reset.into_value(), preview);
+    assert_eq!(preview, fresh_history_previous_settings());
+    assert!(
+        data.take_initial_previous(&effective, &source, &options.initial_history)
+            .is_err()
+    );
+    assert!(
+        data.take_fresh_reset(&effective, &source, &options.initial_history)
+            .is_err()
+    );
+    assert!(data.preview_previous_settings(&effective, &source).is_err());
+    assert!(manager.list_thread_ids().await.is_empty());
+    Ok(())
+}
+#[tokio::test]
+async fn original_fresh_previous_stages_refuse_foreign_config_source_history_or_wrong_order()
+-> anyhow::Result<()> {
+    for variant in 0..4 {
+        let (_home, manager, id, options, mut inputs, effective, source) = captured().await?;
+        let mut data = inputs
+            .take_fresh_history(id, &effective, &source, &options.initial_history)?
+            .unwrap();
+        if variant == 3 {
+            assert!(
+                data.take_fresh_reset(&effective, &source, &options.initial_history)
+                    .is_err()
+            );
+        } else {
+            data.take_window_ids()?;
+            let _context = data.take_context(&effective, &source, &options.initial_history)?;
+            let foreign = Arc::new((*effective).clone());
+            let changed_source = SessionSource::VSCode;
+            let history = InitialHistory::Forked(Vec::new());
+            let result = match variant {
+                0 => data.take_initial_previous(&foreign, &source, &options.initial_history),
+                1 => data.take_initial_previous(
+                    &effective,
+                    &changed_source,
+                    &options.initial_history,
+                ),
+                _ => data.take_initial_previous(&effective, &source, &history),
+            };
+            assert!(result.is_err());
+        }
+        assert!(
+            data.take_initial_previous(&effective, &source, &options.initial_history)
+                .is_err()
+        );
+        assert!(
+            data.take_fresh_reset(&effective, &source, &options.initial_history)
+                .is_err()
+        );
+        assert!(manager.list_thread_ids().await.is_empty());
+    }
+    Ok(())
+}
