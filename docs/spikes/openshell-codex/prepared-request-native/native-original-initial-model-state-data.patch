@@ -0,0 +1,66 @@
+use super::*;
+use crate::context::world_state::{
+    ModelInstructionsState, PreviousSectionState, WorldStateSection,
+};
+use crate::context::{ContextualUserFragment, ModelSwitchInstructions};
+use pretty_assertions::assert_eq;
+
+#[test]
+fn original_previous_model_precedence_and_native_fragment_match_actual_model_data()
+-> anyhow::Result<()> {
+    let row = codex_models_manager::bundled_models_response()?
+        .models
+        .into_iter()
+        .find(|row| row.slug == "gpt-6-luna")
+        .unwrap();
+    let instructions = codex_prompts::render_model_instructions(&row);
+    let prior = PreviousTurnSettings {
+        model: "actual-prior-data".into(),
+        cyber_access_program: None,
+        comp_hash: Some("saved".into()),
+        realtime_active: Some(false),
+    };
+    let provenance = Some(BaseInstructionsProvenance::Model {
+        model: "original-startup-data".into(),
+    });
+    for (previous, provenance, base, expected) in [
+        (
+            Some(prior.clone()),
+            provenance.clone(),
+            instructions.clone(),
+            Some(prior.model.clone()),
+        ),
+        (
+            None,
+            provenance.clone(),
+            "different startup base".into(),
+            Some("original-startup-data".into()),
+        ),
+        (None, provenance.clone(), instructions.clone(), None),
+        (
+            None,
+            Some(BaseInstructionsProvenance::Custom),
+            "custom bytes".into(),
+            None,
+        ),
+        (None, None, "unknown inherited bytes".into(), None),
+    ] {
+        let actual = previous_model(previous, &provenance, &base, &instructions);
+        assert_eq!(actual, expected);
+        let section =
+            ModelInstructionsState::new(&row.slug, actual.as_deref(), instructions.clone());
+        assert_eq!(section.snapshot(), row.slug);
+        let rendered = section.render_diff(PreviousSectionState::Absent);
+        if expected.is_some() {
+            let fragment = rendered.expect("different original previous model");
+            assert_eq!(
+                fragment.render_fragment(),
+                ModelSwitchInstructions::new(instructions.clone()).render_fragment()
+            );
+            assert_eq!(fragment.markers(), ModelSwitchInstructions::type_markers());
+        } else {
+            assert!(rendered.is_none());
+        }
+    }
+    Ok(())
+}
