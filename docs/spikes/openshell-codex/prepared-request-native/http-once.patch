@@ -0,0 +1,282 @@
+use crate::*;
+use http::Method;
+use http::StatusCode;
+use pretty_assertions::assert_eq;
+use std::io::Read;
+use std::io::Write;
+use std::net::TcpListener;
+use std::thread;
+use std::time::Duration;
+use std::time::Instant;
+
+#[derive(Debug)]
+struct ChangingPropagator;
+
+impl opentelemetry::propagation::TextMapPropagator for ChangingPropagator {
+    fn inject_context(
+        &self,
+        _: &opentelemetry::Context,
+        injector: &mut dyn opentelemetry::propagation::Injector,
+    ) {
+        injector.set("x-openai-internal-codex-responses-lite", "1".to_string());
+    }
+
+    fn extract_with_context(
+        &self,
+        context: &opentelemetry::Context,
+        _: &dyn opentelemetry::propagation::Extractor,
+    ) -> opentelemetry::Context {
+        context.clone()
+    }
+
+    fn fields(&self) -> opentelemetry::propagation::text_map_propagator::FieldIter<'_> {
+        opentelemetry::propagation::text_map_propagator::FieldIter::new(&[])
+    }
+}
+
+struct UnqualifiedTransport;
+
+fn retained_request(url: impl Into<String>) -> Request {
+    let mut request = Request::new(Method::POST, url.into());
+    request.headers.insert(
+        http::header::ACCEPT,
+        http::HeaderValue::from_static("application/json"),
+    );
+    request
+}
+
+impl HttpTransport for UnqualifiedTransport {
+    async fn execute(&self, _: Request) -> Result<Response, TransportError> {
+        panic!("single-attempt streaming cannot call execute")
+    }
+
+    async fn stream(&self, _: Request) -> Result<StreamResponse, TransportError> {
+        panic!("ordinary streaming is not proof of one attempt")
+    }
+}
+
+#[tokio::test]
+async fn single_attempt_default_refuses_without_calling_ordinary_transport() {
+    let result = UnqualifiedTransport
+        .execute_once(Request::new(
+            Method::POST,
+            "https://example.test/responses/input_tokens".into(),
+        ))
+        .await;
+    assert!(matches!(result, Err(TransportError::Build(_))));
+    let result = UnqualifiedTransport
+        .stream_once(Request::new(
+            Method::POST,
+            "https://example.test/responses".into(),
+        ))
+        .await;
+    assert!(matches!(result, Err(TransportError::Build(_))));
+}
+
+#[tokio::test]
+async fn single_attempt_refuses_opaque_direct_clients_before_connecting() {
+    let transport = ReqwestTransport::new(reqwest::Client::new());
+    let result = transport
+        .stream_once(retained_request("http://127.0.0.1:1/responses"))
+        .await;
+    assert!(matches!(result, Err(TransportError::Build(_))));
+}
+
+#[tokio::test]
+async fn single_attempt_preserves_current_network_authority() {
+    let controller = NetworkPolicyController::default();
+    let transport = ReqwestTransport::from_route_aware_client_pool(RouteAwareClientPool::new(
+        HttpClientFactory::new(OutboundProxyPolicy::ReqwestDefault)
+            .with_network_policy(controller.policy()),
+        ClientRouteClass::Api,
+    ));
+    let result = transport
+        .stream_once(retained_request("https://example.test/responses"))
+        .await;
+    assert!(matches!(
+        result,
+        Err(TransportError::Policy(NetworkPolicyDenied::Unavailable))
+    ));
+}
+
+#[tokio::test]
+async fn single_attempt_refuses_route_fallback_instead_of_reconfiguring_it() {
+    let transport = ReqwestTransport::from_route_aware_client_pool(RouteAwareClientPool::new(
+        HttpClientFactory::new(OutboundProxyPolicy::ReqwestDefault).with_system_proxy_fallback(),
+        ClientRouteClass::Api,
+    ));
+    let result = transport
+        .stream_once(retained_request("https://example.test/responses"))
+        .await;
+    assert!(matches!(result, Err(TransportError::Build(_))));
+}
+
+#[tokio::test]
+async fn single_attempt_refuses_hidden_headers_and_cookie_injection() {
+    let mut defaults = http::HeaderMap::new();
+    defaults.insert(
+        "x-openai-internal-codex-responses-lite",
+        http::HeaderValue::from_static("1"),
+    );
+    for builder in [
+        HttpClientBuilder::new().default_headers(defaults),
+        HttpClientBuilder::new().with_chatgpt_cloudflare_cookie_store(),
+    ] {
+        let transport =
+            ReqwestTransport::from_route_aware_client_pool(RouteAwareClientPool::with_builder(
+                HttpClientFactory::new(OutboundProxyPolicy::ReqwestDefault),
+                ClientRouteClass::Api,
+                builder,
+            ));
+        let result = transport
+            .execute_once(retained_request(
+                "https://example.test/responses/input_tokens",
+            ))
+            .await;
+        assert!(matches!(result, Err(TransportError::Build(_))));
+    }
+}
+
+#[tokio::test]
+async fn single_attempt_redirects_never_reissue_the_retained_request() {
+    // Nextest runs tests in separate processes, as with the existing client
+    // propagator regression. This hook must not rewrite an already frozen send.
+    opentelemetry::global::set_text_map_propagator(ChangingPropagator);
+    for status in [StatusCode::FOUND, StatusCode::TEMPORARY_REDIRECT] {
+        let listener = TcpListener::bind("127.0.0.1:0").unwrap();
+        listener.set_nonblocking(true).unwrap();
+        let address = listener.local_addr().unwrap();
+        let server = thread::spawn(move || {
+            let deadline = Instant::now() + Duration::from_secs(/*secs*/ 2);
+            let mut requests = Vec::new();
+            while Instant::now() < deadline {
+                let (mut socket, _) = match listener.accept() {
+                    Ok(connection) => connection,
+                    Err(error) if error.kind() == std::io::ErrorKind::WouldBlock => {
+                        thread::sleep(Duration::from_millis(/*millis*/ 5));
+                        continue;
+                    }
+                    Err(error) => panic!("fixture accept failed: {error}"),
+                };
+                socket
+                    .set_read_timeout(Some(Duration::from_secs(/*secs*/ 1)))
+                    .unwrap();
+                let mut bytes = Vec::new();
+                let mut chunk = [0_u8; 1024];
+                loop {
+                    let count = socket.read(&mut chunk).unwrap();
+                    assert_ne!(count, 0);
+                    bytes.extend_from_slice(&chunk[..count]);
+                    if let Some(boundary) = bytes.windows(4).position(|part| part == b"\r\n\r\n") {
+                        let headers = String::from_utf8_lossy(&bytes[..boundary]).to_lowercase();
+                        let length = headers
+                            .lines()
+                            .find_map(|line| line.strip_prefix("content-length: "))
+                            .and_then(|value| value.parse::<usize>().ok())
+                            .unwrap_or(0);
+                        if bytes.len() >= boundary + 4 + length {
+                            break;
+                        }
+                    }
+                }
+                requests.push(bytes);
+                write!(socket, "HTTP/1.1 {} fixture\r\nLocation: http://{address}/again\r\nContent-Length: 0\r\nConnection: close\r\n\r\n", status.as_u16()).unwrap();
+                if requests.len() == 3 {
+                    break;
+                }
+            }
+            requests
+        });
+        let controller = NetworkPolicyController::default();
+        let policy = controller.policy();
+        assert!(controller.publish(policy.revision(), DestinationPolicy::Unrestricted));
+        let pool = RouteAwareClientPool::new(
+            HttpClientFactory::new(OutboundProxyPolicy::ReqwestDefault).with_network_policy(policy),
+            ClientRouteClass::Api,
+        )
+        .with_tls_backend_fallback();
+        let transport = ReqwestTransport::from_http_client(pool.into_client());
+        let result = transport
+            .stream_once(
+                retained_request(format!("http://{address}/responses"))
+                    .with_raw_body("retained body"),
+            )
+            .await;
+        assert!(matches!(result, Err(TransportError::Http {status:actual,..}) if actual == status));
+        let requests = server.join().unwrap();
+        assert_eq!(requests.len(), 1);
+        assert!(requests[0].starts_with(b"POST /responses HTTP/1.1\r\n"));
+        assert!(requests[0].ends_with(b"retained body"));
+        assert!(
+            !String::from_utf8_lossy(&requests[0])
+                .contains("x-openai-internal-codex-responses-lite")
+        );
+        assert!(!String::from_utf8_lossy(&requests[0]).contains("accept-encoding:"));
+        assert!(String::from_utf8_lossy(&requests[0]).contains("accept: application/json\r\n"));
+    }
+}
+
+#[tokio::test]
+async fn single_attempt_count_redirect_cannot_change_counter_authority() {
+    let listener = TcpListener::bind("127.0.0.1:0").unwrap();
+    let address = listener.local_addr().unwrap();
+    let server = thread::spawn(move || {
+        let (mut socket, _) = listener.accept().unwrap();
+        socket
+            .set_read_timeout(Some(Duration::from_secs(/*secs*/ 2)))
+            .unwrap();
+        let mut bytes = [0_u8; 4096];
+        assert!(socket.read(&mut bytes).unwrap() > 0);
+        socket.write_all(b"HTTP/1.1 307 fixture\r\nLocation: http://127.0.0.1:1/changed-counter\r\nContent-Length: 0\r\nConnection: close\r\n\r\n").unwrap();
+    });
+    let controller = NetworkPolicyController::default();
+    let policy = controller.policy();
+    assert!(controller.publish(policy.revision(), DestinationPolicy::Unrestricted));
+    let transport = ReqwestTransport::from_route_aware_client_pool(RouteAwareClientPool::new(
+        HttpClientFactory::new(OutboundProxyPolicy::ReqwestDefault).with_network_policy(policy),
+        ClientRouteClass::Api,
+    ));
+    let result = transport
+        .execute_once(
+            retained_request(format!("http://{address}/responses/input_tokens"))
+                .with_raw_body("retained count projection"),
+        )
+        .await;
+    server.join().unwrap();
+    assert!(matches!(
+        result,
+        Err(TransportError::Http {
+            status: StatusCode::TEMPORARY_REDIRECT,
+            ..
+        })
+    ));
+}
+
+#[tokio::test]
+async fn single_attempt_refuses_unretained_default_accept() {
+    let transport = ReqwestTransport::from_route_aware_client_pool(RouteAwareClientPool::new(
+        HttpClientFactory::new(OutboundProxyPolicy::ReqwestDefault),
+        ClientRouteClass::Api,
+    ));
+    let result = transport
+        .execute_once(Request::new(
+            Method::POST,
+            "https://example.test/responses/input_tokens".into(),
+        ))
+        .await;
+    assert!(matches!(result, Err(TransportError::Build(_))));
+}
+
+#[tokio::test]
+async fn single_attempt_refuses_url_credentials_before_late_basic_auth() {
+    let transport = ReqwestTransport::from_route_aware_client_pool(RouteAwareClientPool::new(
+        HttpClientFactory::new(OutboundProxyPolicy::ReqwestDefault),
+        ClientRouteClass::Api,
+    ));
+    let result = transport
+        .execute_once(retained_request(
+            "https://fixture-user:fixture-password@example.test/responses/input_tokens",
+        ))
+        .await;
+    assert!(matches!(result, Err(TransportError::Build(_))));
+}
