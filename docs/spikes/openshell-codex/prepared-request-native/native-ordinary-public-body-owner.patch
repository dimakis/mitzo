diff --git a/codex-rs/core/src/client_format_tests.rs b/codex-rs/core/src/client_format_tests.rs
index 637e5e1..bffbcc1 100644
--- a/codex-rs/core/src/client_format_tests.rs
+++ b/codex-rs/core/src/client_format_tests.rs
@@ -128,3 +128,142 @@ fn capture_uses_actual_ordinary_owner_and_refuses_populated_final_metadata() ->
     assert_eq!(serde_json::to_value(&request)?, retained);
     Ok(())
 }
+
+#[test]
+fn public_body_capture_uses_actual_model_client_state_credentials_and_contributor_inventory()
+-> anyhow::Result<()> {
+    use crate::responses_request_format::ResponsesOutputBudget;
+    use codex_extension_api::ModelRequestContributor;
+    use codex_extension_api::ModelRequestInput;
+    use codex_extension_api::ModelResponseInterceptor;
+    use codex_protocol::config_types::ReasoningSummary as ReasoningSummaryConfig;
+    use std::sync::atomic::AtomicUsize;
+    use std::sync::atomic::Ordering;
+
+    let auth =
+        AuthManager::from_auth_for_testing(CodexAuth::from_api_key("offline-selected-api-key"));
+    let credentials = auth.capture_cached_api_key_credentials().unwrap();
+    let mut client = ModelClient::new(
+        Some(auth),
+        AgentIdentityAuthPolicy::JwtOnly,
+        ThreadId::new(),
+        ModelProviderInfo::create_openai_provider(/*base_url*/ None),
+        SessionSource::Exec,
+        "offline-public-capture".to_string(),
+        /*model_verbosity*/ None,
+        /*content_item_kinds_enabled*/ true,
+        /*reasoning_effort_override_enabled*/ false,
+        /*enable_request_compression*/ false,
+        /*include_timing_metrics*/ false,
+        /*beta_features_header*/ None,
+        /*concurrent_reasoning_summaries_enabled*/ false,
+        /*attestation_provider*/ None,
+        HttpClientFactory::new(OutboundProxyPolicy::ReqwestDefault),
+        codex_model_provider::WorkspaceRoutingContext::new(
+            "https://chatgpt.com/backend-api".into(),
+        ),
+        Vec::new(),
+    );
+    let metadata = test_responses_metadata_for_client(
+        &client,
+        Some("retained-turn"),
+        "retained-window".into(),
+        /*parent_thread_id*/ None,
+        TestCodexResponsesRequestKind::Turn,
+    );
+    let model = test_model_info();
+    let prompt = Prompt {
+        input: vec![serde_json::from_value(
+            json!({"type":"message","id":"legacy-id","role":"user","content":[{"type":"input_text","text":"actual owner capture"}]}),
+        )?],
+        base_instructions: BaseInstructions {
+            text: "actual owner instructions".into(),
+            provenance: None,
+        },
+        ..Default::default()
+    };
+    let generation = || ResponsesGenerationOptions {
+        effort: None,
+        summary: ReasoningSummaryConfig::None,
+        service_tier: None,
+    };
+    let budget = || ResponsesOutputBudget {
+        max_output_tokens: 64,
+        model_output_limit: 128,
+    };
+    let mut ordinary = client.build_responses_request(
+        &prompt,
+        &model,
+        None,
+        ReasoningSummaryConfig::None,
+        None,
+        &metadata,
+        /*include_internal*/ true,
+    )?;
+    client.prepare_response_items_for_request(&mut ordinary.input);
+    let mut expected = serde_json::to_value(&ordinary)?;
+    let fields = expected.as_object_mut().unwrap();
+    fields.remove("client_metadata");
+    fields.insert("max_output_tokens".into(), json!(64));
+    fields.insert("truncation".into(), json!("disabled"));
+    let captured = client.capture_public_api_responses_body(
+        &prompt,
+        &model,
+        metadata.clone(),
+        generation(),
+        budget(),
+        &credentials,
+    )?;
+    assert_eq!(captured.request().body(), &expected);
+    assert_eq!(
+        captured
+            .observations()
+            .client_metadata(/*include_internal*/ true),
+        metadata.client_metadata(/*include_internal*/ true)
+    );
+
+    let foreign =
+        AuthManager::from_auth_for_testing(CodexAuth::from_api_key("offline-selected-api-key"));
+    let foreign_credentials = foreign.capture_cached_api_key_credentials().unwrap();
+    assert!(
+        client
+            .capture_public_api_responses_body(
+                &prompt,
+                &model,
+                metadata.clone(),
+                generation(),
+                budget(),
+                &foreign_credentials
+            )
+            .is_err()
+    );
+    #[derive(Debug)]
+    struct Contributor(Arc<AtomicUsize>);
+    impl ModelRequestContributor for Contributor {
+        fn request(
+            &self,
+            _input: ModelRequestInput<'_>,
+        ) -> Option<Box<dyn ModelResponseInterceptor>> {
+            self.0.fetch_add(1, Ordering::SeqCst);
+            None
+        }
+    }
+    let calls = Arc::new(AtomicUsize::new(0));
+    client
+        .request_contributors
+        .push(Arc::new(Contributor(Arc::clone(&calls))));
+    assert!(
+        client
+            .capture_public_api_responses_body(
+                &prompt,
+                &model,
+                metadata,
+                generation(),
+                budget(),
+                &credentials
+            )
+            .is_err()
+    );
+    assert_eq!(calls.load(Ordering::SeqCst), 0);
+    Ok(())
+}
