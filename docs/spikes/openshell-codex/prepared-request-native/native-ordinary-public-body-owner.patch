+// Associated with the real ordinary ModelClient, rather than accepting caller
+// flags or a fabricated context/empty contributor inventory at the producer seam.
+impl super::ModelClient {
+    /// Captures the body partition from this actual ordinary owner while its
+    /// selected native manager still owns the API credentials. This does not
+    /// resolve/qualify final HTTP headers, network policy, account permissions,
+    /// model/output ceilings or durable count/consume. The completed producer must
+    /// retain the selection and renew all those owners at the native transaction.
+    #[cfg_attr(
+        not(test),
+        allow(dead_code, reason = "Prepared admission is not installed.")
+    )]
+    pub(crate) fn capture_public_api_responses_body(
+        &self,
+        prompt: &Prompt,
+        model: &ModelInfo,
+        metadata: CodexResponsesMetadata,
+        generation: ResponsesGenerationOptions,
+        output: ResponsesOutputBudget,
+        credentials: &codex_login::auth::CapturedApiKeyCredentials,
+    ) -> Result<CapturedPublicApiResponsesRequest, ApiError> {
+        if !matches!(
+            self.state.session_source,
+            codex_protocol::protocol::SessionSource::Cli
+                | codex_protocol::protocol::SessionSource::VSCode
+                | codex_protocol::protocol::SessionSource::Exec
+                | codex_protocol::protocol::SessionSource::Mcp
+                | codex_protocol::protocol::SessionSource::Custom(_)
+        ) {
+            return Err(unsupported("unsupported ordinary native session source"));
+        }
+        let provider = self.state.provider.info();
+        if !provider.is_openai()
+            || !provider.requires_openai_auth
+            || provider.wire_api != codex_model_provider_info::WireApi::Responses
+            || provider.uses_openai_actor_authorization()
+            || provider.env_key.is_some()
+            || provider.experimental_bearer_token.is_some()
+            || provider.auth.is_some()
+            || provider.gateway_oauth.is_some()
+            || provider.aws.is_some()
+            || provider
+                .query_params
+                .as_ref()
+                .is_some_and(|params| !params.is_empty())
+        {
+            return Err(unsupported(
+                "unqualified ordinary provider credential source",
+            ));
+        }
+        // A cached API key selects the ordinary public default when base_url is
+        // absent. Explicit overrides must name the same public HTTP API origin.
+        if let Some(base) = &provider.base_url {
+            let url = url::Url::parse(base).map_err(|_| unsupported("invalid provider URL"))?;
+            if url.scheme() != "https"
+                || url.host_str() != Some("api.openai.com")
+                || url.port().is_some()
+                || !url.username().is_empty()
+                || url.password().is_some()
+                || !matches!(url.path(), "/v1" | "/v1/")
+                || url.query().is_some()
+                || url.fragment().is_some()
+            {
+                return Err(unsupported("unsupported ordinary public API origin"));
+            }
+        }
+        let manager = self
+            .state
+            .provider
+            .auth_manager()
+            .ok_or_else(|| unsupported("missing ordinary credential owner"))?;
+        // Resolve immutable ordinary inputs before entering the credential lock;
+        // no provider trait callback or auth reentry runs inside that closure.
+        let context = self
+            .resolved_responses_request_context(model, &metadata, /*include_internal*/ true);
+        manager
+            .with_current_api_key_credentials(credentials, |_, _| {
+                capture_public_api_responses_request(
+                    prompt,
+                    model,
+                    PublicApiResponsesCaptureInputs {
+                        context,
+                        metadata,
+                        generation,
+                        output,
+                        normalization: RequestCopyNormalization {
+                            content_item_kinds_enabled: self.state.content_item_kinds_enabled,
+                        },
+                    },
+                    &self.request_contributors,
+                )
+            })
+            .ok_or_else(|| unsupported("ordinary cached credential ownership changed"))?
+    }
+}
+
 fn unsupported(detail: &str) -> ApiError {
     ApiError::InvalidRequest {
         message: format!("public Responses capture refuses {detail}"),
