+#[tokio::test]
+async fn prepared_request_attempt_custody_preserves_same_runtime_clones() {
+    let home = unique_temp_dir();
+    let runtime = open(&home).await;
+    let cloned_runtime = runtime.as_ref().clone();
+    let request = request();
+    let prepared = measured(&runtime, "custody-runtime-clone", &request).await;
+    let handle = runtime
+        .consume_prepared_request(&prepared.preparation_id, &request, "witness")
+        .await
+        .unwrap();
+    let attempt = cloned_runtime
+        .commit_prepared_request_attempt(handle)
+        .await
+        .unwrap();
+    assert_eq!(
+        attempt.record().attempt_state,
+        PreparedRequestAttemptState::Committed
+    );
+    assert_eq!(
+        runtime
+            .read_prepared_request("custody-runtime-clone")
+            .await
+            .unwrap()
+            .as_ref(),
+        Some(attempt.record())
+    );
+    runtime.close().await;
+}
