+#[tokio::test]
+async fn prepared_request_attempt_custody_rejects_independently_opened_runtime() {
+    let home = unique_temp_dir();
+    let runtime = open(&home).await;
+    let other = open(&home).await;
+    let request = request();
+    let prepared = measured(&runtime, "custody-other-runtime", &request).await;
+    let handle = runtime
+        .consume_prepared_request(&prepared.preparation_id, &request, "witness")
+        .await
+        .unwrap();
+    let consumed = handle.record().clone();
+    let error = other
+        .commit_prepared_request_attempt(handle)
+        .await
+        .err()
+        .expect("another runtime must not inherit live consumption custody");
+    assert_eq!(
+        error.to_string(),
+        "prepared consumption runtime custody conflicts"
+    );
+    assert_eq!(
+        runtime
+            .read_prepared_request("custody-other-runtime")
+            .await
+            .unwrap(),
+        Some(consumed)
+    );
+    assert!(
+        runtime
+            .consume_prepared_request(&prepared.preparation_id, &request, "witness")
+            .await
+            .is_err()
+    );
+    assert_eq!(
+        other
+            .close_prepared_request(&prepared.preparation_id, &request)
+            .await
+            .unwrap(),
+        PreparedRequestClosure::ClosedWithoutAttempt
+    );
+    other.close().await;
+    runtime.close().await;
+}
+
+#[tokio::test]
+async fn prepared_request_attempt_custody_rejects_copy_after_original_closure() {
+    let home = unique_temp_dir();
+    let copied_home = unique_temp_dir();
+    std::fs::create_dir_all(&copied_home).unwrap();
+    let runtime = open(&home).await;
+    let request = request();
+    let prepared = measured(&runtime, "custody-copied-runtime", &request).await;
+    let handle = runtime
+        .consume_prepared_request(&prepared.preparation_id, &request, "witness")
+        .await
+        .unwrap();
+    let consumed = handle.record().clone();
+    let nonce: String = sqlx::query_scalar(
+        "SELECT consumption_nonce FROM prepared_requests WHERE preparation_id = ?",
+    )
+    .bind(&prepared.preparation_id)
+    .fetch_one(runtime.pool.as_ref())
+    .await
+    .unwrap();
+    let copied_sqlite = crate::SqliteConfig::new_for_testing(copied_home.abs());
+    sqlx::query("VACUUM INTO ?")
+        .bind(copied_sqlite.state_db_path().to_str().unwrap())
+        .execute(runtime.pool.as_ref())
+        .await
+        .unwrap();
+    assert_eq!(
+        runtime
+            .close_prepared_request(&prepared.preparation_id, &request)
+            .await
+            .unwrap(),
+        PreparedRequestClosure::ClosedWithoutAttempt
+    );
+    let copied = open(&copied_home).await;
+    assert_eq!(
+        copied
+            .read_prepared_request("custody-copied-runtime")
+            .await
+            .unwrap(),
+        Some(consumed.clone())
+    );
+    assert_eq!(
+        sqlx::query_scalar::<_, String>(
+            "SELECT consumption_nonce FROM prepared_requests WHERE preparation_id = ?"
+        )
+        .bind(&prepared.preparation_id)
+        .fetch_one(copied.pool.as_ref())
+        .await
+        .unwrap(),
+        nonce
+    );
+    let error = copied
+        .commit_prepared_request_attempt(handle)
+        .await
+        .err()
+        .expect("a copied database must not inherit live consumption custody");
+    assert_eq!(
+        error.to_string(),
+        "prepared consumption runtime custody conflicts"
+    );
+    assert_eq!(
+        copied
+            .read_prepared_request("custody-copied-runtime")
+            .await
+            .unwrap(),
+        Some(consumed.clone())
+    );
+    let mut closed = consumed;
+    closed.attempt_state = PreparedRequestAttemptState::ClosedWithoutAttempt;
+    assert_eq!(
+        runtime
+            .read_prepared_request("custody-copied-runtime")
+            .await
+            .unwrap(),
+        Some(closed)
+    );
+    for owner in [&runtime, &copied] {
+        assert!(
+            owner
+                .consume_prepared_request(&prepared.preparation_id, &request, "witness")
+                .await
+                .is_err()
+        );
+    }
+    copied.close().await;
+    runtime.close().await;
+}
