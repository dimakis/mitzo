+#[test]
+fn route_independent_body_preserves_complete_raw_input_and_null_empty_matrix() {
+    for tier in [None, Some(None), Some(Some("priority".to_string()))] {
+        for environments in [
+            None,
+            Some(Vec::new()),
+            complete_body_params("legacy-selected").environments,
+        ] {
+            let mut expected = complete_body_params("legacy-selected");
+            expected.service_tier = tier.clone();
+            expected.environments = environments;
+            assert_eq!(body_roundtrip(expected.clone()), expected);
+        }
+    }
+    let absent: TurnStartParams =
+        serde_json::from_value(json!({"threadId":"legacy-parsed", "input":[]})).unwrap();
+    let null: TurnStartParams = serde_json::from_value(json!({"threadId":"legacy-parsed", "input":[], "serviceTier":null, "environments":[], "disabledPluginIds":[], "responsesapiClientMetadata":{}})).unwrap();
+    assert_eq!(body_roundtrip(absent.clone()), absent);
+    assert_eq!(body_roundtrip(null.clone()), null);
+}
+
+#[test]
+fn route_independent_body_and_original_legacy_wrapper_preserve_complete_request_data() {
+    for tool_reply in [false, true] {
+        let mut params = complete_body_params("actual-legacy-selector");
+        if tool_reply {
+            params.input.clear();
+            params.tool_output = Some(Box::new(codex_app_server_protocol::TurnToolOutput {
+                name: "exact-original-reply".to_string(),
+                namespace: Some("original-namespace".to_string()),
+                output: FunctionCallOutputBody::Text("reply\nbytes 🦀é".to_string()),
+            }));
+        }
+        let data = OriginalTurnCommandData::new(params.clone());
+        data.validate_tool_output().unwrap();
+        let (route, body) = data.into_body();
+        assert_eq!(route, params.thread_id);
+        let (body_env, body_input) = body.into_environment_stage();
+        let body = body_input.into_core_input().unwrap();
+        let (legacy_env, legacy_input) =
+            OriginalTurnCommandData::new(params.clone()).into_environment_stage();
+        assert_eq!(
+            (body_env.environments, body_env.runtime_workspace_roots),
+            (legacy_env.environments, legacy_env.runtime_workspace_roots)
+        );
+        let legacy = legacy_input.into_core_input().unwrap();
+        let owner_settings = codex_protocol::protocol::ThreadSettingsOverrides {
+            service_tier: Some(None),
+            ..Default::default()
+        };
+        let direct = body.submission.into_request(
+            body.input,
+            owner_settings.clone(),
+            body.additional_context,
+        );
+        let forwarded =
+            legacy
+                .submission
+                .into_request(legacy.input, owner_settings, legacy.additional_context);
+        // TurnInputRequest/TurnStartOptions do not derive PartialEq: exhaustive
+        // projection compares every field; actual caller-owned trace stays None.
+        let project = |request: TurnInputRequest| {
+            let TurnInputRequest {
+                input,
+                thread_settings,
+                start,
+                additional_context,
+                responsesapi_client_metadata,
+                trace,
+            } = request;
+            assert!(trace.is_none());
+            let TurnStartOptions {
+                turn_trigger,
+                final_output_json_schema,
+                service_tier,
+                parent_turn_id,
+                root_turn_id,
+                cyber_access_program,
+            } = start;
+            (
+                input,
+                thread_settings,
+                (
+                    turn_trigger,
+                    final_output_json_schema,
+                    service_tier,
+                    parent_turn_id,
+                    root_turn_id,
+                    cyber_access_program,
+                ),
+                additional_context,
+                responsesapi_client_metadata,
+            )
+        };
+        assert_eq!(project(direct), project(forwarded));
+        assert_eq!(body_roundtrip(params.clone()), params);
+    }
+}
