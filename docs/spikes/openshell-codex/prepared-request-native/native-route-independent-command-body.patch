+// Whole raw-body inverse oracle only; not a production route/command constructor.
+fn body_roundtrip(params: TurnStartParams) -> TurnStartParams {
+    let (route, body) = OriginalTurnCommandData::new(params).into_body();
+    TurnStartParams {
+        thread_id: route,
+        disabled_plugin_ids: body.disabled_plugin_ids,
+        client_user_message_id: body.client_user_message_id,
+        input: body.input,
+        turn_trigger: body.turn_trigger,
+        tool_output: body.tool_output,
+        responsesapi_client_metadata: body.responsesapi_client_metadata,
+        additional_context: body.additional_context,
+        environments: body.environments,
+        cwd: body.cwd,
+        runtime_workspace_roots: body.runtime_workspace_roots,
+        approval_policy: body.approval_policy,
+        approvals_reviewer: body.approvals_reviewer,
+        sandbox_policy: body.sandbox_policy,
+        permissions: body.permissions,
+        model: body.model,
+        service_tier: body.service_tier,
+        service_tier_for_turn: body.service_tier_for_turn,
+        effort: body.effort,
+        summary: body.summary,
+        personality: body.personality,
+        output_schema: body.output_schema,
+        collaboration_mode: body.collaboration_mode,
+        multi_agent_mode: body.multi_agent_mode,
+        cyber_access_program: body.cyber_access_program,
+    }
+}
