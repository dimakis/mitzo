+#[test]
+fn request_failures_classify_tls_wrapped_in_io_errors() {
+    for depth in 1..=3 {
+        let mut source = io::Error::other(rustls::Error::InvalidCertificate(
+            rustls::CertificateError::UnknownIssuer,
+        ));
+        for _ in 1..depth {
+            source = io::Error::other(source);
+        }
+        let error = RouteAwareRequestError::Route(RouteAwareClientPoolError::Resolve(source));
+        assert_eq!(
+            error.failure_class(),
+            Some(RouteFailureClass::TlsError),
+            "typed TLS source must survive {depth} IO wrappers"
+        );
+    }
+    let lookalike = RouteAwareRequestError::Route(RouteAwareClientPoolError::Resolve(
+        io::Error::other("certificate unknown issuer is ordinary error text"),
+    ));
+    assert_eq!(
+        lookalike.failure_class(),
+        Some(RouteFailureClass::ProxyResolutionUnavailable)
+    );
+}
