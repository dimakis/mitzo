+#[tokio::test]
+async fn prepared_request_attempt_cross_process_close_fences_live_commit() {
+    const HOME_KEY: &str = "CODEX_PREPARED_ATTEMPT_TEST_HOME";
+    const RESULT_KEY: &str = "CODEX_PREPARED_ATTEMPT_TEST_RESULT";
+    if let Some(home) = std::env::var_os(HOME_KEY) {
+        let runtime = open(Path::new(&home)).await;
+        let record = runtime
+            .read_prepared_request("process-race")
+            .await
+            .unwrap()
+            .unwrap();
+        let result = runtime
+            .close_prepared_request(&record.preparation_id, &record.request)
+            .await
+            .unwrap();
+        std::fs::write(
+            std::env::var_os(RESULT_KEY).unwrap(),
+            match result {
+                PreparedRequestClosure::ClosedWithoutAttempt => "closed",
+                PreparedRequestClosure::AttemptAlreadyCommitted => "committed",
+                PreparedRequestClosure::PriorAttemptUncertain => {
+                    panic!("new record cannot be legacy")
+                }
+            },
+        )
+        .unwrap();
+        runtime.close().await;
+        return;
+    }
+    let home = unique_temp_dir();
+    let runtime = open(&home).await;
+    let request = request();
+    let record = measured(&runtime, "process-race", &request).await;
+    let handle = runtime
+        .consume_prepared_request(&record.preparation_id, &request, "witness")
+        .await
+        .unwrap();
+    let result_path = home.join("closure-result");
+    let mut child = std::process::Command::new(std::env::current_exe().unwrap())
+        .args(["--exact", "runtime::prepared_requests::tests::attempts::prepared_request_attempt_cross_process_close_fences_live_commit", "--nocapture"])
+        .env(HOME_KEY, &home).env(RESULT_KEY, &result_path).spawn().unwrap();
+    let attempt = runtime.commit_prepared_request_attempt(handle).await;
+    assert!(child.wait().unwrap().success());
+    assert_eq!(
+        attempt.is_ok(),
+        std::fs::read_to_string(result_path).unwrap() == "committed"
+    );
+    let recovered = runtime
+        .read_prepared_request("process-race")
+        .await
+        .unwrap()
+        .unwrap();
+    assert_eq!(
+        recovered.attempt_state,
+        if attempt.is_ok() {
+            PreparedRequestAttemptState::Committed
+        } else {
+            PreparedRequestAttemptState::ClosedWithoutAttempt
+        }
+    );
+    runtime.close().await;
+}
