diff --git a/codex-rs/state/src/runtime/prepared_request_attempts.rs b/codex-rs/state/src/runtime/prepared_request_attempts.rs
new file mode 100644
index 0000000..6eb5758
--- /dev/null
+++ b/codex-rs/state/src/runtime/prepared_request_attempts.rs
@@ -0,0 +1,138 @@
+//! One live handoff after durable consumption; reads never reconstruct send rights.
+
+use super::NewPreparedRequest;
+use super::PreparedRequestRecord;
+use super::StateRuntime;
+use super::record_from_row;
+use super::validate_request;
+use super::validate_text;
+use sqlx::Connection;
+use sqlx::Row;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum PreparedRequestAttemptState {
+    Open,
+    Committed,
+    ClosedWithoutAttempt,
+    /// Pre-migration consumption may already have dispatched; it grants no new handoff.
+    LegacyConsumedUncertain,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum PreparedRequestClosure {
+    ClosedWithoutAttempt,
+    AttemptAlreadyCommitted,
+    PriorAttemptUncertain,
+}
+
+/// Created only by the winning consumption CAS. Dropping this loses the live right.
+/// This is not authority: the trusted native caller must still hold its actual fence.
+pub struct PreparedRequestConsumption {
+    pub(super) record: PreparedRequestRecord,
+    pub(super) nonce: String,
+}
+
+impl PreparedRequestConsumption {
+    pub fn record(&self) -> &PreparedRequestRecord {
+        &self.record
+    }
+}
+
+/// A single live transport handoff. No read, retry, or restart can recreate it.
+/// The marker precedes transport, so a dropped token or crash remains uncertain.
+pub struct PreparedRequestAttempt {
+    record: PreparedRequestRecord,
+}
+
+impl PreparedRequestAttempt {
+    pub fn record(&self) -> &PreparedRequestRecord {
+        &self.record
+    }
+}
+
+impl StateRuntime {
+    /// Commit the first-attempt marker before transport. An error consumes the handle
+    /// too: callers must not recover it or retry an uncertain attempt.
+    pub async fn commit_prepared_request_attempt(
+        &self,
+        consumption: PreparedRequestConsumption,
+    ) -> anyhow::Result<PreparedRequestAttempt> {
+        let PreparedRequestConsumption {
+            record: expected,
+            nonce,
+        } = consumption;
+        validate_text(&expected.preparation_id)?;
+        validate_request(&expected.request)?;
+        let mut connection = self.prepared_request_connection().await?;
+        let mut transaction = connection.begin_with("BEGIN IMMEDIATE").await?;
+        let row = sqlx::query("SELECT * FROM prepared_requests WHERE preparation_id = ?")
+            .bind(&expected.preparation_id)
+            .fetch_one(&mut *transaction)
+            .await?;
+        let mut record = record_from_row(&row)?;
+        anyhow::ensure!(
+            record.request == expected.request && record.operation_id == expected.operation_id,
+            "prepared live claim inputs conflict"
+        );
+        anyhow::ensure!(
+            record.consumed && record.attempt_state == PreparedRequestAttemptState::Open,
+            "prepared request is not open for a first attempt"
+        );
+        anyhow::ensure!(
+            row.try_get::<Option<String>, _>("consumption_nonce")?
+                .as_deref()
+                == Some(nonce.as_str()),
+            "prepared live consumption claim conflicts"
+        );
+        let result = sqlx::query("UPDATE prepared_requests SET attempt_state = 'committed' WHERE preparation_id = ? AND consumed = 1 AND attempt_state = 'open' AND consumption_nonce = ?")
+            .bind(&expected.preparation_id).bind(nonce).execute(&mut *transaction).await?;
+        anyhow::ensure!(
+            result.rows_affected() == 1,
+            "prepared first-attempt commitment lost"
+        );
+        transaction.commit().await?;
+        record.attempt_state = PreparedRequestAttemptState::Committed;
+        Ok(PreparedRequestAttempt { record })
+    }
+
+    /// Durably fence every delayed sender for this exact preparation. A prior
+    /// committed/legacy attempt never produces a claim of no send.
+    pub async fn close_prepared_request(
+        &self,
+        preparation_id: &str,
+        request: &NewPreparedRequest,
+    ) -> anyhow::Result<PreparedRequestClosure> {
+        validate_text(preparation_id)?;
+        validate_request(request)?;
+        let mut connection = self.prepared_request_connection().await?;
+        let mut transaction = connection.begin_with("BEGIN IMMEDIATE").await?;
+        let row = sqlx::query("SELECT * FROM prepared_requests WHERE preparation_id = ?")
+            .bind(preparation_id)
+            .fetch_one(&mut *transaction)
+            .await?;
+        let record = record_from_row(&row)?;
+        anyhow::ensure!(
+            record.request == *request,
+            "prepared closure inputs conflict"
+        );
+        let outcome = match record.attempt_state {
+            PreparedRequestAttemptState::Open => {
+                let result = sqlx::query("UPDATE prepared_requests SET attempt_state = 'closed_without_attempt' WHERE preparation_id = ? AND attempt_state = 'open'")
+                    .bind(preparation_id).execute(&mut *transaction).await?;
+                anyhow::ensure!(result.rows_affected() == 1, "prepared closure lost");
+                PreparedRequestClosure::ClosedWithoutAttempt
+            }
+            PreparedRequestAttemptState::ClosedWithoutAttempt => {
+                PreparedRequestClosure::ClosedWithoutAttempt
+            }
+            PreparedRequestAttemptState::Committed => {
+                PreparedRequestClosure::AttemptAlreadyCommitted
+            }
+            PreparedRequestAttemptState::LegacyConsumedUncertain => {
+                PreparedRequestClosure::PriorAttemptUncertain
+            }
+        };
+        transaction.commit().await?;
+        Ok(outcome)
+    }
+}
diff --git a/codex-rs/state/src/runtime/prepared_request_attempts_tests.rs b/codex-rs/state/src/runtime/prepared_request_attempts_tests.rs
new file mode 100644
index 0000000..b959cf6
--- /dev/null
+++ b/codex-rs/state/src/runtime/prepared_request_attempts_tests.rs
@@ -0,0 +1,684 @@
+use super::*;
+use pretty_assertions::assert_eq;
+
+async fn measured(
+    runtime: &StateRuntime,
+    operation: &str,
+    request: &NewPreparedRequest,
+) -> PreparedRequestRecord {
+    let record = runtime.prepare_request(operation, request).await.unwrap();
+    runtime
+        .measure_prepared_request(&record.preparation_id, request, &measurement())
+        .await
+        .unwrap();
+    runtime
+        .read_prepared_request(operation)
+        .await
+        .unwrap()
+        .unwrap()
+}
+
+#[tokio::test]
+async fn prepared_request_attempt_close_before_consumption_is_retained_without_execution() {
+    let home = unique_temp_dir();
+    let runtime = open(&home).await;
+    let request = request();
+    let prepared = measured(&runtime, "closed", &request).await;
+    assert_eq!(
+        runtime
+            .close_prepared_request(&prepared.preparation_id, &request)
+            .await
+            .unwrap(),
+        PreparedRequestClosure::ClosedWithoutAttempt
+    );
+    assert!(
+        runtime
+            .measure_prepared_request(&prepared.preparation_id, &request, &measurement())
+            .await
+            .is_err()
+    );
+    assert!(
+        runtime
+            .consume_prepared_request(&prepared.preparation_id, &request, "witness")
+            .await
+            .is_err()
+    );
+    let mut unmeasured = request.clone();
+    unmeasured.binding.command_id = Some("unmeasured".into());
+    let empty = runtime
+        .prepare_request("closed-unmeasured", &unmeasured)
+        .await
+        .unwrap();
+    runtime
+        .close_prepared_request(&empty.preparation_id, &unmeasured)
+        .await
+        .unwrap();
+    assert!(
+        runtime
+            .measure_prepared_request(&empty.preparation_id, &unmeasured, &measurement())
+            .await
+            .is_err()
+    );
+    assert!(sqlx::query("UPDATE prepared_requests SET measurement_json='{}' WHERE operation_id='closed-unmeasured'").execute(runtime.pool.as_ref()).await.is_err());
+    let mut expected = prepared;
+    expected.attempt_state = PreparedRequestAttemptState::ClosedWithoutAttempt;
+    assert_eq!(
+        runtime.prepare_request("closed", &request).await.unwrap(),
+        expected
+    );
+    assert_eq!(
+        sqlx::query_scalar::<_, i64>("SELECT count(*) FROM threads")
+            .fetch_one(runtime.pool.as_ref())
+            .await
+            .unwrap(),
+        0
+    );
+    assert!(!runtime.sqlite.thread_history_db_path().exists());
+    let queue = runtime
+        .sqlite
+        .open_queue_db(
+            &crate::migrations::runtime_queue_migrator(),
+            /*telemetry_override*/ None,
+        )
+        .await
+        .unwrap();
+    assert_eq!(
+        sqlx::query_scalar::<_, i64>("SELECT count(*) FROM queued_items")
+            .fetch_one(&queue)
+            .await
+            .unwrap(),
+        0
+    );
+    queue.close().await;
+    runtime.close().await;
+    let reopened = open(&home).await;
+    assert_eq!(
+        reopened.read_prepared_request("closed").await.unwrap(),
+        Some(expected)
+    );
+    reopened.close().await;
+}
+
+#[tokio::test]
+async fn prepared_request_attempt_closure_fences_a_delayed_consumed_handle() {
+    let home = unique_temp_dir();
+    let runtime = open(&home).await;
+    let other = open(&home).await;
+    let request = request();
+    let prepared = measured(&runtime, "delayed", &request).await;
+    let handle = runtime
+        .consume_prepared_request(&prepared.preparation_id, &request, "witness")
+        .await
+        .unwrap();
+    assert!(handle.record().consumed);
+    assert_eq!(
+        other
+            .close_prepared_request(&prepared.preparation_id, &request)
+            .await
+            .unwrap(),
+        PreparedRequestClosure::ClosedWithoutAttempt
+    );
+    assert!(
+        runtime
+            .commit_prepared_request_attempt(handle)
+            .await
+            .is_err()
+    );
+    runtime
+        .acknowledge_prepared_request(
+            &prepared.preparation_id,
+            &PreparedTurnReceipt {
+                thread_id: "thread".into(),
+                turn_id: "turn".into(),
+            },
+        )
+        .await
+        .unwrap();
+    assert!(
+        runtime
+            .record_prepared_provider_receipt(
+                &prepared.preparation_id,
+                &PreparedProviderReceipt {
+                    request_identity: request.request_identity.clone(),
+                    provider_response_id: "provider".into()
+                }
+            )
+            .await
+            .is_err()
+    );
+    let closed = other
+        .read_prepared_request("delayed")
+        .await
+        .unwrap()
+        .unwrap();
+    assert!(closed.consumed);
+    assert_eq!(
+        closed.attempt_state,
+        PreparedRequestAttemptState::ClosedWithoutAttempt
+    );
+    other.close().await;
+    runtime.close().await;
+}
+
+#[tokio::test]
+async fn prepared_request_attempt_winner_cannot_be_closed_or_recovered_as_a_handoff() {
+    let home = unique_temp_dir();
+    let runtime = open(&home).await;
+    let request = request();
+    let prepared = measured(&runtime, "attempted", &request).await;
+    let handle = runtime
+        .consume_prepared_request(&prepared.preparation_id, &request, "witness")
+        .await
+        .unwrap();
+    let attempt = runtime
+        .commit_prepared_request_attempt(handle)
+        .await
+        .unwrap();
+    assert_eq!(
+        attempt.record().attempt_state,
+        PreparedRequestAttemptState::Committed
+    );
+    assert_eq!(
+        runtime
+            .close_prepared_request(&prepared.preparation_id, &request)
+            .await
+            .unwrap(),
+        PreparedRequestClosure::AttemptAlreadyCommitted
+    );
+    let expected = attempt.record().clone();
+    drop(attempt);
+    runtime.close().await;
+    let reopened = open(&home).await;
+    assert_eq!(
+        reopened
+            .prepare_request("attempted", &request)
+            .await
+            .unwrap(),
+        expected
+    );
+    assert!(
+        reopened
+            .consume_prepared_request(&prepared.preparation_id, &request, "witness")
+            .await
+            .is_err()
+    );
+    assert_eq!(
+        reopened
+            .close_prepared_request(&prepared.preparation_id, &request)
+            .await
+            .unwrap(),
+        PreparedRequestClosure::AttemptAlreadyCommitted
+    );
+    reopened.close().await;
+}
+
+#[tokio::test]
+async fn prepared_request_attempt_commit_and_close_have_one_durable_winner() {
+    let home = unique_temp_dir();
+    let runtime = open(&home).await;
+    let other = open(&home).await;
+    for index in 0..12 {
+        let mut request = request();
+        request.binding.command_id = Some(format!("command-{index}"));
+        let operation = format!("race-{index}");
+        let prepared = measured(&runtime, &operation, &request).await;
+        let handle = runtime
+            .consume_prepared_request(&prepared.preparation_id, &request, "witness")
+            .await
+            .unwrap();
+        let (attempt, closure) = tokio::join!(
+            runtime.commit_prepared_request_attempt(handle),
+            other.close_prepared_request(&prepared.preparation_id, &request)
+        );
+        let record = runtime
+            .read_prepared_request(&operation)
+            .await
+            .unwrap()
+            .unwrap();
+        match closure.unwrap() {
+            PreparedRequestClosure::ClosedWithoutAttempt => {
+                assert!(attempt.is_err());
+                assert_eq!(
+                    record.attempt_state,
+                    PreparedRequestAttemptState::ClosedWithoutAttempt
+                );
+            }
+            PreparedRequestClosure::AttemptAlreadyCommitted => {
+                assert_eq!(attempt.unwrap().record(), &record);
+                assert_eq!(record.attempt_state, PreparedRequestAttemptState::Committed);
+            }
+            PreparedRequestClosure::PriorAttemptUncertain => panic!("new record cannot be legacy"),
+        }
+    }
+    other.close().await;
+    runtime.close().await;
+}
+
+#[tokio::test]
+async fn prepared_request_attempt_concurrent_consumers_produce_only_one_live_claim() {
+    let home = unique_temp_dir();
+    let runtime = open(&home).await;
+    let other = open(&home).await;
+    let request = request();
+    let prepared = measured(&runtime, "claims", &request).await;
+    let (first, second) = tokio::join!(
+        runtime.consume_prepared_request(&prepared.preparation_id, &request, "witness"),
+        other.consume_prepared_request(&prepared.preparation_id, &request, "witness")
+    );
+    assert_eq!(usize::from(first.is_ok()) + usize::from(second.is_ok()), 1);
+    let handle = first.or(second).unwrap();
+    assert_eq!(
+        other
+            .commit_prepared_request_attempt(handle)
+            .await
+            .unwrap()
+            .record()
+            .attempt_state,
+        PreparedRequestAttemptState::Committed
+    );
+    other.close().await;
+    runtime.close().await;
+}
+
+#[tokio::test]
+async fn prepared_request_attempt_restart_keeps_unattempted_consumption_unusable() {
+    let home = unique_temp_dir();
+    let runtime = open(&home).await;
+    let request = request();
+    let prepared = measured(&runtime, "lost-handle", &request).await;
+    drop(
+        runtime
+            .consume_prepared_request(&prepared.preparation_id, &request, "witness")
+            .await
+            .unwrap(),
+    );
+    runtime.close().await;
+    let reopened = open(&home).await;
+    let record = reopened
+        .read_prepared_request("lost-handle")
+        .await
+        .unwrap()
+        .unwrap();
+    assert_eq!(
+        (record.consumed, record.attempt_state),
+        (true, PreparedRequestAttemptState::Open)
+    );
+    assert!(
+        reopened
+            .consume_prepared_request(&prepared.preparation_id, &request, "witness")
+            .await
+            .is_err()
+    );
+    assert_eq!(
+        reopened
+            .close_prepared_request(&prepared.preparation_id, &request)
+            .await
+            .unwrap(),
+        PreparedRequestClosure::ClosedWithoutAttempt
+    );
+    reopened.close().await;
+}
+
+#[tokio::test]
+async fn prepared_request_attempt_terminal_sql_guards_and_changed_closure_inputs() {
+    let home = unique_temp_dir();
+    let runtime = open(&home).await;
+    let mut request = request();
+    let prepared = measured(&runtime, "guard-closed", &request).await;
+    request.binding.account_id.push('2');
+    assert!(
+        runtime
+            .close_prepared_request(&prepared.preparation_id, &request)
+            .await
+            .is_err()
+    );
+    request = prepared.request.clone();
+    runtime
+        .close_prepared_request(&prepared.preparation_id, &request)
+        .await
+        .unwrap();
+    for mutation in [
+        "UPDATE prepared_requests SET attempt_state = 'open' WHERE operation_id = 'guard-closed'",
+        "UPDATE prepared_requests SET attempt_state = 'committed' WHERE operation_id = 'guard-closed'",
+        "UPDATE prepared_requests SET consumed = 1 WHERE operation_id = 'guard-closed'",
+        "UPDATE prepared_requests SET measurement_json = NULL WHERE operation_id = 'guard-closed'",
+        "DELETE FROM prepared_requests WHERE operation_id = 'guard-closed'",
+    ] {
+        assert!(
+            sqlx::query(mutation)
+                .execute(runtime.pool.as_ref())
+                .await
+                .is_err(),
+            "{mutation}"
+        );
+    }
+    request.binding.command_id = Some("other-command".into());
+    let prepared = measured(&runtime, "guard-committed", &request).await;
+    assert!(sqlx::query("UPDATE prepared_requests SET attempt_state='committed' WHERE operation_id='guard-committed'").execute(runtime.pool.as_ref()).await.is_err());
+    let handle = runtime
+        .consume_prepared_request(&prepared.preparation_id, &request, "witness")
+        .await
+        .unwrap();
+    assert!(sqlx::query("UPDATE prepared_requests SET provider_response_id='too-early' WHERE operation_id='guard-committed'").execute(runtime.pool.as_ref()).await.is_err());
+    let attempt = runtime
+        .commit_prepared_request_attempt(handle)
+        .await
+        .unwrap();
+    for mutation in [
+        "UPDATE prepared_requests SET attempt_state='closed_without_attempt' WHERE operation_id='guard-committed'",
+        "UPDATE prepared_requests SET attempt_state='open' WHERE operation_id='guard-committed'",
+        "UPDATE prepared_requests SET consumption_nonce=NULL WHERE operation_id='guard-committed'",
+        "DELETE FROM prepared_requests WHERE operation_id='guard-committed'",
+    ] {
+        assert!(
+            sqlx::query(mutation)
+                .execute(runtime.pool.as_ref())
+                .await
+                .is_err(),
+            "{mutation}"
+        );
+    }
+    assert_eq!(
+        runtime
+            .read_prepared_request("guard-committed")
+            .await
+            .unwrap()
+            .as_ref(),
+        Some(attempt.record())
+    );
+    runtime.close().await;
+}
+
+#[tokio::test]
+async fn prepared_request_attempt_receipts_remain_independent_after_attempt_commit() {
+    let home = unique_temp_dir();
+    let runtime = open(&home).await;
+    for provider_first in [false, true] {
+        let mut request = request();
+        request.binding.command_id = Some(format!("receipts-{provider_first}"));
+        let prepared = measured(&runtime, &format!("receipts-{provider_first}"), &request).await;
+        let handle = runtime
+            .consume_prepared_request(&prepared.preparation_id, &request, "witness")
+            .await
+            .unwrap();
+        let turn = PreparedTurnReceipt {
+            thread_id: "thread".into(),
+            turn_id: format!("turn-{provider_first}"),
+        };
+        let provider = PreparedProviderReceipt {
+            request_identity: request.request_identity.clone(),
+            provider_response_id: format!("response-{provider_first}"),
+        };
+        assert!(
+            runtime
+                .record_prepared_provider_receipt(&prepared.preparation_id, &provider)
+                .await
+                .is_err()
+        );
+        if !provider_first {
+            runtime
+                .acknowledge_prepared_request(&prepared.preparation_id, &turn)
+                .await
+                .unwrap();
+        }
+        runtime
+            .commit_prepared_request_attempt(handle)
+            .await
+            .unwrap();
+        runtime
+            .record_prepared_provider_receipt(&prepared.preparation_id, &provider)
+            .await
+            .unwrap();
+        runtime
+            .acknowledge_prepared_request(&prepared.preparation_id, &turn)
+            .await
+            .unwrap();
+        runtime
+            .record_prepared_provider_receipt(&prepared.preparation_id, &provider)
+            .await
+            .unwrap();
+        let record = runtime
+            .read_prepared_request(&format!("receipts-{provider_first}"))
+            .await
+            .unwrap()
+            .unwrap();
+        assert_eq!(
+            (record.exact_turn, record.provider_receipt),
+            (Some(turn), Some(provider))
+        );
+    }
+    runtime.close().await;
+}
