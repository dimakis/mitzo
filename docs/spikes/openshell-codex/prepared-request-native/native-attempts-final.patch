new file mode 100644
index 0000000..15857ca
--- /dev/null
+++ b/codex-rs/state/migrations/0060_prepared_request_attempts.sql
@@ -0,0 +1,61 @@
+-- Existing consumption may already have caused a send. Preserve that uncertainty;
+-- never manufacture a new attempt marker, nonce, timestamp, or handoff on upgrade.
+ALTER TABLE prepared_requests ADD COLUMN attempt_state TEXT NOT NULL DEFAULT 'open'
+CHECK (attempt_state IN ('open', 'committed', 'closed_without_attempt', 'legacy_consumed_uncertain')
+    AND (attempt_state NOT IN ('committed', 'legacy_consumed_uncertain') OR consumed = 1));
+ALTER TABLE prepared_requests ADD COLUMN consumption_nonce TEXT
+CHECK (consumption_nonce IS NULL OR (consumed = 1 AND length(consumption_nonce) = 36));
+UPDATE prepared_requests SET attempt_state = 'legacy_consumed_uncertain' WHERE consumed = 1;
+
+CREATE TRIGGER prepared_requests_initial_attempt_state
+BEFORE INSERT ON prepared_requests
+WHEN NEW.attempt_state != 'open' OR NEW.consumed != 0 OR NEW.consumption_nonce IS NOT NULL
+BEGIN
+    SELECT RAISE(ABORT, 'prepared request must start without consumption or attempt');
+END;
+
+CREATE TRIGGER prepared_requests_terminal_attempt
+BEFORE UPDATE OF attempt_state ON prepared_requests
+WHEN (OLD.attempt_state != 'open' AND NEW.attempt_state != OLD.attempt_state)
+    OR (NEW.attempt_state = 'legacy_consumed_uncertain' AND OLD.attempt_state != NEW.attempt_state)
+BEGIN
+    SELECT RAISE(ABORT, 'prepared attempt decision is irreversible');
+END;
+
+CREATE TRIGGER prepared_requests_live_consumption
+BEFORE UPDATE OF consumed ON prepared_requests
+WHEN OLD.consumed = 0 AND NEW.consumed = 1
+    AND (OLD.attempt_state != 'open' OR NEW.attempt_state != 'open' OR NEW.consumption_nonce IS NULL)
+BEGIN
+    SELECT RAISE(ABORT, 'prepared consumption requires an open live claim');
+END;
+
+CREATE TRIGGER prepared_requests_immutable_consumption_nonce
+BEFORE UPDATE OF consumption_nonce ON prepared_requests
+WHEN (OLD.consumption_nonce IS NOT NULL AND NEW.consumption_nonce IS NOT OLD.consumption_nonce)
+    OR (OLD.consumption_nonce IS NULL AND NEW.consumption_nonce IS NOT NULL
+        AND (OLD.consumed != 0 OR NEW.consumed != 1 OR NEW.attempt_state != 'open'))
+BEGIN
+    SELECT RAISE(ABORT, 'prepared consumption nonce is private and immutable');
+END;
+
+CREATE TRIGGER prepared_requests_closed_measurement
+BEFORE UPDATE OF measurement_json ON prepared_requests
+WHEN OLD.attempt_state = 'closed_without_attempt'
+BEGIN
+    SELECT RAISE(ABORT, 'closed preparation cannot be measured');
+END;
+
+CREATE TRIGGER prepared_requests_retain_closed
+BEFORE DELETE ON prepared_requests WHEN OLD.attempt_state = 'closed_without_attempt'
+BEGIN
+    SELECT RAISE(ABORT, 'closed request tombstone must be retained');
+END;
+
+CREATE TRIGGER prepared_requests_provider_requires_attempt
+BEFORE UPDATE OF provider_response_id ON prepared_requests
+WHEN NEW.provider_response_id IS NOT OLD.provider_response_id
+    AND NEW.attempt_state NOT IN ('committed', 'legacy_consumed_uncertain')
+BEGIN
+    SELECT RAISE(ABORT, 'provider receipt requires a committed or possible legacy attempt');
+END;
