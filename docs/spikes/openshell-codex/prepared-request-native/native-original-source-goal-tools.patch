+use super::*;
+use codex_extension_api::ExtensionRegistry;
+use codex_extension_api::PreSessionToolInventoryError;
+use codex_utils_absolute_path::test_support::PathExt;
+use pretty_assertions::assert_eq;
+
+async fn fixture() -> anyhow::Result<(
+    tempfile::TempDir,
+    Arc<ExtensionRegistry<bool>>,
+    Arc<GoalService>,
+)> {
+    let home = tempfile::tempdir()?;
+    let runtime = codex_state::StateRuntime::init(
+        codex_state::SqliteConfig::new_for_testing(home.path().abs()),
+        "offline-goal-source".to_string(),
+    )
+    .await?;
+    let mut builder = ExtensionRegistryBuilder::<bool>::new();
+    let service = Arc::new(GoalService::new());
+    install_with_backend(
+        &mut builder,
+        runtime,
+        AnalyticsEventsClient::disabled(),
+        None,
+        Weak::new(),
+        Arc::clone(&service),
+        |enabled| GoalExtensionConfig {
+            enabled: *enabled,
+            max_goal_token_budget: Some(123),
+        },
+    );
+    Ok((home, builder.build(), service))
+}
+
+async fn ordinary_oracle(
+    registry: &ExtensionRegistry<bool>,
+    source: &SessionSource,
+    persistent: bool,
+) -> (
+    Vec<Arc<dyn for<'call> ToolExecutor<ToolCall<'call>>>>,
+    ExtensionData,
+) {
+    // Ordinary runtime oracle ONLY, after metadata capture. Preparation itself
+    // constructs no ExtensionData/Session/runtime and invokes no lifecycle/tool.
+    let thread_id = ThreadId::new();
+    let session = ExtensionData::new(thread_id.to_string());
+    let thread = ExtensionData::new(thread_id.to_string());
+    for contributor in registry.thread_lifecycle_contributors() {
+        contributor
+            .on_thread_start(ThreadStartInput {
+                config: &true,
+                session_source: source,
+                persistent_thread_state_available: persistent,
+                environments: &[],
+                mcp_resource_client: None,
+                extension_metrics: None,
+                session_store: &session,
+                thread_store: &thread,
+            })
+            .await;
+    }
+    let tools = registry
+        .tool_contributors()
+        .iter()
+        .flat_map(|contributor| contributor.tools(&session, &thread))
+        .collect();
+    (tools, thread)
+}
+
+#[tokio::test]
+async fn goal_original_ordered_metadata_matches_real_executors_and_refuses_order_or_missing_tools()
+-> anyhow::Result<()> {
+    let (_home, registry, service) = fixture().await?;
+    let unstarted = ThreadId::new();
+    assert!(service.runtime_for_thread(unstarted).is_none());
+    let capture = registry.capture_pre_session_tools_for_source(&true, &SessionSource::Exec)?;
+    assert!(service.runtime_for_thread(unstarted).is_none());
+    assert_eq!(
+        capture
+            .definitions()
+            .iter()
+            .map(|definition| definition.name().name.clone())
+            .collect::<Vec<_>>(),
+        vec![
+            crate::spec::GET_GOAL_TOOL_NAME.to_string(),
+            crate::spec::CREATE_GOAL_TOOL_NAME.to_string(),
+            crate::spec::UPDATE_GOAL_TOOL_NAME.to_string()
+        ]
+    );
+    assert_eq!(
+        registry.associate_pre_session_tools_for_source(&capture, &true, &SessionSource::Exec, &[]),
+        Err(PreSessionToolInventoryError::SelectionChanged)
+    );
+    let (tools, _thread) = ordinary_oracle(&registry, &SessionSource::Exec, true).await;
+    registry.associate_pre_session_tools_for_source(
+        &capture,
+        &true,
+        &SessionSource::Exec,
+        &tools,
+    )?;
+    let mut reversed = tools.clone();
+    reversed.reverse();
+    assert_eq!(
+        registry.associate_pre_session_tools_for_source(
+            &capture,
+            &true,
+            &SessionSource::Exec,
+            &reversed
+        ),
+        Err(PreSessionToolInventoryError::SelectionChanged)
+    );
+    // Whole descriptor matching above includes Direct exposure, generated
+    // ToolSearchInfo::from_tool_spec(spec,None) and parallel=false. No handle ran.
+    assert_eq!(
+        registry.associate_pre_session_tools_for_source(
+            &capture,
+            &false,
+            &SessionSource::Exec,
+            &tools
+        ),
+        Err(PreSessionToolInventoryError::SelectionChanged)
+    );
+    assert_eq!(
+        registry.associate_pre_session_tools_for_source(
+            &capture,
+            &true,
+            &SessionSource::SubAgent(SubAgentSource::Review),
+            &tools
+        ),
+        Err(PreSessionToolInventoryError::SelectionChanged)
+    );
+    let rebuilt = registry.to_builder().build();
+    assert_eq!(
+        rebuilt.renew_pre_session_tools_for_source(&capture, &true, &SessionSource::Exec),
+        Err(PreSessionToolInventoryError::RegistryChanged)
+    );
+    Ok(())
+}
+
+#[tokio::test]
+async fn goal_visibility_and_persistence_keep_original_metadata_and_execution_policy_separate()
+-> anyhow::Result<()> {
+    let (_home, registry, _service) = fixture().await?;
+    // Preserve the existing disabled/config-only contract, without inventing a source.
+    assert!(
+        registry
+            .capture_pre_session_tools_for_config(&false)?
+            .definitions()
+            .is_empty()
+    );
+    assert!(
+        registry
+            .capture_pre_session_tools_for_config(&true)
+            .is_err()
+    );
+    let root = registry.capture_pre_session_tools_for_source(&true, &SessionSource::Exec)?;
+    let review = registry.capture_pre_session_tools_for_source(
+        &true,
+        &SessionSource::SubAgent(SubAgentSource::Review),
+    )?;
+    assert!(review.definitions().is_empty());
+    let (tools, thread) = ordinary_oracle(&registry, &SessionSource::Exec, false).await;
+    registry.associate_pre_session_tools_for_source(&root, &true, &SessionSource::Exec, &tools)?;
+    let runtime = goal_runtime_handle(&thread).unwrap();
+    assert!(runtime.tools_visible());
+    assert!(!runtime.tools_available());
+    let (review_tools, _) = ordinary_oracle(
+        &registry,
+        &SessionSource::SubAgent(SubAgentSource::Review),
+        true,
+    )
+    .await;
+    registry.associate_pre_session_tools_for_source(
+        &review,
+        &true,
+        &SessionSource::SubAgent(SubAgentSource::Review),
+        &review_tools,
+    )?;
+    assert!(review_tools.is_empty());
+    Ok(())
+}
