+use super::*;
+use crate::ExtensionRegistryBuilder;
+use crate::PreSessionToolInventoryError;
+use codex_protocol::protocol::SubAgentSource;
+use pretty_assertions::assert_eq;
+use std::sync::atomic::{AtomicUsize, Ordering};
+
+struct CountingContributor(Arc<AtomicUsize>);
+impl ToolContributor for CountingContributor {
+    fn tools(
+        &self,
+        _session: &ExtensionData,
+        _thread: &ExtensionData,
+    ) -> Vec<Arc<dyn for<'call> ToolExecutor<ToolCall<'call>>>> {
+        self.0.fetch_add(1, Ordering::SeqCst);
+        Vec::new()
+    }
+}
+fn source_plan(calls: Arc<AtomicUsize>) -> SourceToolPreSessionPlan<bool> {
+    Arc::new(move |enabled, source| {
+        calls.fetch_add(1, Ordering::SeqCst);
+        if !*enabled || matches!(source, SessionSource::SubAgent(SubAgentSource::Review)) {
+            SourceToolPreSessionSelection::NoTools
+        } else {
+            SourceToolPreSessionSelection::Unresolved
+        }
+    })
+}
+fn absence() -> ToolPreSessionPlan<bool> {
+    Arc::new(|enabled| {
+        if *enabled {
+            ToolPreSessionSelection::Unresolved
+        } else {
+            ToolPreSessionSelection::NoTools
+        }
+    })
+}
+
+#[test]
+fn source_plan_unknown_first_and_foreign_changed_source_config_refuse_without_tool_calls() {
+    let plans = Arc::new(AtomicUsize::new(0));
+    let tools = Arc::new(AtomicUsize::new(0));
+    let mut builder = ExtensionRegistryBuilder::<bool>::new();
+    builder.tool_contributor_with_source_pre_session_plan(
+        Arc::new(CountingContributor(Arc::clone(&tools))),
+        absence(),
+        source_plan(Arc::clone(&plans)),
+    );
+    let registry = builder.build();
+    let mut unknown = registry.to_builder();
+    unknown.tool_contributor(Arc::new(CountingContributor(Arc::clone(&tools))));
+    assert!(
+        matches!(unknown.build().capture_pre_session_tools_for_source(&false, &SessionSource::Exec), Err(PreSessionToolInventoryError::StateBoundContributors { registration_indexes }) if registration_indexes == vec![1])
+    );
+    assert_eq!(plans.load(Ordering::SeqCst), 0);
+    assert_eq!(tools.load(Ordering::SeqCst), 0);
+    let capture = registry
+        .capture_pre_session_tools_for_source(&false, &SessionSource::Exec)
+        .unwrap();
+    registry
+        .renew_pre_session_tools_for_source(&capture, &false, &SessionSource::Exec)
+        .unwrap();
+    assert_eq!(
+        registry.renew_pre_session_tools_for_config(&capture, &false),
+        Err(PreSessionToolInventoryError::SourceRequired)
+    );
+    assert_eq!(
+        registry.renew_pre_session_tools_for_source(
+            &capture,
+            &false,
+            &SessionSource::SubAgent(SubAgentSource::Review)
+        ),
+        Err(PreSessionToolInventoryError::SelectionChanged)
+    );
+    assert!(
+        registry
+            .renew_pre_session_tools_for_source(&capture, &true, &SessionSource::Exec)
+            .is_err()
+    );
+    assert_eq!(
+        registry
+            .to_builder()
+            .build()
+            .renew_pre_session_tools_for_source(&capture, &false, &SessionSource::Exec),
+        Err(PreSessionToolInventoryError::RegistryChanged)
+    );
+    let legacy = registry
+        .capture_pre_session_tools_for_config(&false)
+        .unwrap();
+    registry
+        .renew_pre_session_tools_for_config(&legacy, &false)
+        .unwrap();
+    assert!(
+        registry
+            .capture_pre_session_tools_for_config(&true)
+            .is_err()
+    );
+    assert_eq!(tools.load(Ordering::SeqCst), 0);
+}
+
+#[tokio::test]
+async fn ordinary_config_renewal_retains_real_thread_start_source_and_legacy_forwarding() {
+    let plans = Arc::new(AtomicUsize::new(0));
+    let tools = Arc::new(AtomicUsize::new(0));
+    let contributor = PlannedToolContributor::new(
+        Arc::new(CountingContributor(Arc::clone(&tools))),
+        RegisteredToolPreSessionPlan::SourceAware(absence(), source_plan(Arc::clone(&plans))),
+    );
+    let session = ExtensionData::new("ordinary-source-oracle");
+    let thread = ExtensionData::new("ordinary-thread-oracle");
+    // Ordinary adapter oracle, never called by capture. No fake tool/executor,
+    // Session or success bit is injected into production preparation.
+    contributor
+        .on_thread_start(ThreadStartInput {
+            config: &false,
+            session_source: &SessionSource::SubAgent(SubAgentSource::Review),
+            persistent_thread_state_available: true,
+            environments: &[],
+            mcp_resource_client: None,
+            extension_metrics: None,
+            session_store: &session,
+            thread_store: &thread,
+        })
+        .await;
+    contributor.on_config_changed(&session, &thread, &false, &true);
+    assert!(contributor.selection(&thread) == SourceToolPreSessionSelection::NoTools);
+    assert_eq!(plans.load(Ordering::SeqCst), 2);
+    assert!(contributor.tools(&session, &thread).is_empty());
+    assert_eq!(tools.load(Ordering::SeqCst), 1);
+    let legacy = PlannedToolContributor::new(
+        Arc::new(CountingContributor(Arc::clone(&tools))),
+        RegisteredToolPreSessionPlan::ConfigOnly(absence()),
+    );
+    legacy.on_config_changed(&session, &thread, &false, &true);
+    assert!(legacy.selection(&thread) == SourceToolPreSessionSelection::Unresolved);
+    legacy.tools(&session, &thread);
+    assert_eq!(tools.load(Ordering::SeqCst), 2);
+}
