+// A data-only comparison of every Config-derived constructor input. This is
+// not eligibility/currentness evidence and does not construct a ModelClient.
+type ConstructorConfigProjection = (
+    codex_model_provider_info::ModelProviderInfo,
+    Option<codex_protocol::config_types::Verbosity>,
+    bool,
+    [bool; 6],
+    Option<String>,
+    codex_http_client::HttpClientFactory,
+);
+
+fn constructor_config_projection(config: &Config) -> ConstructorConfigProjection {
+    (
+        config.model_provider.clone(),
+        config.model_verbosity,
+        config.ephemeral,
+        [
+            Feature::UseAgentIdentity,
+            Feature::ContentItemKinds,
+            Feature::ReasoningEffortOverride,
+            Feature::EnableRequestCompression,
+            Feature::RuntimeMetrics,
+            Feature::ConcurrentReasoningSummaries,
+        ]
+        .map(|feature| config.features.enabled(feature)),
+        Session::build_model_client_beta_features_header(config),
+        config.http_client_factory(),
+    )
+}
+
+async fn configured_startup_fixture() -> anyhow::Result<(tempfile::TempDir, Config)> {
+    let home = tempfile::tempdir()?;
+    std::fs::write(home.path().join("config.toml"), "model = 'gpt-6-luna'\n")?;
+    let config = crate::config::ConfigBuilder::default()
+        .codex_home(home.path().to_path_buf())
+        .loader_overrides(
+            codex_config::LoaderOverrides::with_managed_config_path_for_tests(
+                home.path().join("managed.toml"),
+            ),
+        )
+        .fallback_cwd(Some(home.path().to_path_buf()))
+        .build()
+        .await?;
+    Ok((home, config))
+}
+
+#[tokio::test]
+async fn original_startup_preference_reset_preserves_constructor_factory_and_beta_inputs()
+-> anyhow::Result<()> {
+    let (_home, mut config) = configured_startup_fixture().await?;
+    let configured = config.clone();
+    let expected = constructor_config_projection(&config);
+    // Use the shipped source owner's ACTUAL row. No fabricated ModelInfo or
+    // custom catalog, refresh, account/model access attestation or Session.
+    let model = codex_models_manager::bundled_models_response()?
+        .models
+        .into_iter()
+        .find(|row| Some(row.slug.as_str()) == config.model.as_deref())
+        .ok_or_else(|| anyhow::anyhow!("configured model missing from bundled owner"))?;
+    config.prepare_token_budget_for_startup()?;
+    // Original Config publishers produce inherited activation data; original
+    // startup resets it from its retained configured-preference snapshot.
+    config.features.enable(Feature::TokenBudget)?;
+    config
+        .token_budget
+        .get_or_insert_default()
+        .use_history_notes_extension = true;
+    assert_ne!(config, configured);
+    assert_eq!(constructor_config_projection(&config), expected);
+    config.prepare_token_budget_for_startup()?;
+    let auth = codex_login::CodexAuth::from_api_key("synthetic-startup-projection");
+    super::super::token_budget::apply_experimental_context(&mut config, Some(&auth), &model)?;
+    super::super::token_budget::apply_model_defaults(&mut config, &model);
+    assert_eq!(constructor_config_projection(&config), expected);
+    // Full Config retains a startup snapshot; equality of constructor inputs
+    // never asserts that raw and effective Config are interchangeable.
+    assert_ne!(config, configured);
+    // Factory equality covers configured settings, not live cookies/policy
+    // publication currency, source leases or a transport capability grant.
+    Ok(())
+}
+
+#[tokio::test]
+async fn original_consumed_feature_and_factory_settings_changes_are_observable()
+-> anyhow::Result<()> {
+    let (_home, mut config) = configured_startup_fixture().await?;
+    let before = constructor_config_projection(&config);
+    let previous = config.features.enabled(Feature::ContentItemKinds);
+    config
+        .features
+        .set_enabled(Feature::ContentItemKinds, !previous)?;
+    assert_ne!(constructor_config_projection(&config), before);
+    config
+        .features
+        .set_enabled(Feature::ContentItemKinds, previous)?;
+    assert_eq!(constructor_config_projection(&config), before);
+    // Change an actual factory input, not TokenBudget or permission-only state.
+    config.respect_system_proxy = false;
+    let before_factory = config.http_client_factory();
+    let previous = config.features.enabled(Feature::SystemProxyFallback);
+    config
+        .features
+        .set_enabled(Feature::SystemProxyFallback, !previous)?;
+    assert_ne!(config.http_client_factory(), before_factory);
+    config
+        .features
+        .set_enabled(Feature::SystemProxyFallback, previous)?;
+    assert_eq!(config.http_client_factory(), before_factory);
+    Ok(())
+}
