ARG OPENSHELL_BASE_IMAGE
FROM ${OPENSHELL_BASE_IMAGE}
ARG OPENSHELL_BASE_IMAGE
ARG MITZO_SOURCE_COMMIT
ARG MGMT_SOURCE_COMMIT

LABEL io.mitzo.openshell.base-image="${OPENSHELL_BASE_IMAGE}" \
      io.mitzo.source-commit="${MITZO_SOURCE_COMMIT}" \
      io.mitzo.mgmt-source-commit="${MGMT_SOURCE_COMMIT}"

USER root
RUN npm install --global @openai/codex@0.156.1 \
    && npm install --prefix /usr/lib/googleworkspace-cli @googleworkspace/cli@0.18.1 \
    && ln -s /usr/lib/googleworkspace-cli/node_modules/@googleworkspace/cli/run-gws.js /usr/bin/gws
COPY pyproject.toml uv.lock /opt/mgmt-deps/
RUN cd /opt/mgmt-deps \
    && uv lock \
    && UV_PROJECT_ENVIRONMENT=/opt/mgmt-venv uv sync --frozen --no-dev --no-install-project
COPY jira_process/pyproject.toml jira_process/uv.lock /opt/mgmt-jira-runtime/
RUN cd /opt/mgmt-jira-runtime \
    && UV_PYTHON=/usr/bin/python3 UV_NO_MANAGED_PYTHON=1 UV_PROJECT_ENVIRONMENT=/opt/mgmt-jira-venv uv sync --frozen --no-dev --no-install-project \
    && site_packages="$(find /opt/mgmt-jira-venv/lib -mindepth 2 -maxdepth 2 -type d -name site-packages -print)" \
    && [ "$(printf '%s\n' "$site_packages" | sed '/^$/d' | wc -l | tr -d ' ')" = 1 ] \
    && case "$site_packages" in /opt/mgmt-jira-venv/lib/python*/site-packages) ;; *) exit 1 ;; esac \
    && printf 'MGMT_JIRA_PYTHONPATH=%s\n' "$site_packages" > /etc/mitzo-mgmt-jira.env \
    && chmod 0444 /etc/mitzo-mgmt-jira.env \
    && mkdir -p /usr/local/share/jupyter/kernels/mgmt-jira \
    && printf '%s\n' \
      '{' \
      '  "argv": ["/usr/bin/python3", "-m", "ipykernel_launcher", "-f", "{connection_file}"],' \
      '  "display_name": "Mitzo Jira",' \
      '  "language": "python",' \
      "  \"env\": {\"PYTHONPATH\": \"$site_packages\"}" \
      '}' > /usr/local/share/jupyter/kernels/mgmt-jira/kernel.json \
    && chmod 0444 /usr/local/share/jupyter/kernels/mgmt-jira/kernel.json \
    && PYTHONPATH="$site_packages" /usr/bin/python3 -c 'import sys; import jupyter, nbconvert, ipykernel, numpy, pyarrow; assert sys.executable == "/usr/bin/python3"' \
    && PYTHONPATH="$site_packages" /usr/bin/python3 -c 'import json; spec = json.load(open("/usr/local/share/jupyter/kernels/mgmt-jira/kernel.json")); assert spec["argv"][0] == "/usr/bin/python3" and spec["env"] == {"PYTHONPATH": "'"$site_packages"'"}'
COPY run-mitzo-app-server /sandbox/run-mitzo-app-server
COPY run-mitzo-subscription-app-server /sandbox/run-mitzo-subscription-app-server
COPY initialize-mitzo-workspace /sandbox/initialize-mitzo-workspace
COPY run-mgmt-notebook /sandbox/run-mgmt-notebook
COPY compile-mgmt-context.mjs /sandbox/compile-mgmt-context.mjs
COPY mitzo-checkpoint.py /sandbox/mitzo-checkpoint.py
COPY contexgin /usr/lib/contexgin
RUN chmod 0755 /sandbox/run-mitzo-app-server /sandbox/run-mitzo-subscription-app-server /sandbox/initialize-mitzo-workspace /sandbox/run-mgmt-notebook /sandbox/compile-mgmt-context.mjs /sandbox/mitzo-checkpoint.py \
    && chmod -R a+rX /usr/lib/contexgin \
    && chown sandbox:sandbox /sandbox/run-mitzo-app-server /sandbox/run-mitzo-subscription-app-server
ENV PATH="/opt/mgmt-venv/bin:${PATH}"
USER sandbox
