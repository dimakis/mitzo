# The current upstream OpenShell base image ships codex-cli 0.117.0, which does
# not advertise externalSandbox. This disposable test image pins the host-tested
# CLI release; it contains no authentication material.
FROM ghcr.io/nvidia/openshell-community/sandboxes/base:latest

USER root
RUN npm install --global @openai/codex@0.153.4
COPY app-server-command-probe.mjs /sandbox/app-server-command-probe.mjs
RUN chown sandbox:sandbox /sandbox/app-server-command-probe.mjs
USER sandbox
