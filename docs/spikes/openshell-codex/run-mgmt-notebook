#!/usr/bin/env bash
set -euo pipefail

workspace="${MITZO_MGMT_WORKDIR:-/sandbox/workspaces/mgmt}"
runtime_root="${workspace}/jira_process"
notebook="${1:-}"

if [[ -z "$notebook" || $# -ne 1 ]]; then
  echo 'usage: run-mgmt-notebook <jira_process-relative-notebook.ipynb>' >&2
  exit 2
fi
if [[ "$notebook" = /* || "$notebook" == *'..'* || "$notebook" != *.ipynb ]]; then
  echo 'notebook must be a relative .ipynb path inside jira_process' >&2
  exit 2
fi

path="${runtime_root}/${notebook}"
if [[ ! -f "$path" ]]; then
  echo 'notebook does not exist in the mounted jira_process runtime' >&2
  exit 2
fi

output_root="${MITZO_MGMT_NOTEBOOK_OUTPUT_DIR:-${runtime_root}/reports/notebook-runs}"
case "$output_root" in
  "${runtime_root}/reports/notebook-runs"|"${runtime_root}/reports/notebook-runs"/*) ;;
  *)
    echo 'notebook output must stay inside jira_process/reports/notebook-runs' >&2
    exit 2
    ;;
esac
mkdir -p "$output_root"

run_id="${MITZO_MGMT_NOTEBOOK_RUN_ID:-}"
if [[ -n "$run_id" ]]; then
  if [[ ! "$run_id" =~ ^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$ ]]; then
    echo 'notebook run ID must be a safe identifier' >&2
    exit 2
  fi
  run_dir="${output_root}/${run_id}"
  if ! mkdir "$run_dir"; then
    echo 'notebook run output already exists' >&2
    exit 2
  fi
else
  run_dir="$(mktemp -d "${output_root}/run.XXXXXX")"
fi

transient="$(mktemp -d "${TMPDIR:-/tmp}/mitzo-mgmt-jupyter.XXXXXX")"
cleanup() { rm -rf "$transient"; }
trap cleanup EXIT
export IPYTHONDIR="${transient}/ipython"
export JUPYTER_RUNTIME_DIR="${transient}/runtime"
mkdir -p "$IPYTHONDIR" "$JUPYTER_RUNTIME_DIR"

# Jira credentials remain provider-injected environment placeholders; this
# command never accepts or logs them. The source notebook is input-only: its
# executed copy gets a unique, writable report location.
name="${notebook##*/}"
output_name="${name%.ipynb}.executed.ipynb"
python -m jupyter nbconvert --to notebook --execute --output-dir "$run_dir" --output "$output_name" "$path"
printf '%s\n' "${run_dir}/${output_name}"
