# Disposable local image only. Do not use as the active gateway runtime.
ARG OPENSHELL_BASE_IMAGE
FROM ${OPENSHELL_BASE_IMAGE}
USER root
COPY symposium-seat-landlock.c /tmp/symposium-seat-landlock.c
COPY symposium-attempt-controller.c /tmp/symposium-attempt-controller.c
COPY symposium-subscription-app-server /usr/local/bin/symposium-subscription-app-server
RUN gcc -O2 -Wall -Wextra -Werror /tmp/symposium-seat-landlock.c \
      -o /usr/local/bin/symposium-seat-landlock \
    && gcc -O2 -Wall -Wextra -Werror /tmp/symposium-attempt-controller.c \
      -o /usr/local/bin/symposium-attempt-controller \
    && rm /tmp/symposium-seat-landlock.c /tmp/symposium-attempt-controller.c \
    && install -d -o sandbox -g sandbox -m 0700 /sandbox/.symposium-seats /sandbox/.symposium-control \
    && chmod 0755 /usr/local/bin/symposium-subscription-app-server \
    && test -x /usr/bin/python3
USER sandbox

ENV OPENSHELL_SANDBOX_COMMAND="sleep infinity"
