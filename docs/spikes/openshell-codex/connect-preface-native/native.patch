+    async fn assert_replayed_tunnel_prefix(
+        prefix: &[u8],
+        remainder: &[u8],
+        expected: TunnelProtocol,
+    ) {
+        let (stream, mut peer) = tokio::io::duplex(65536);
+        peer.write_all(remainder).await.unwrap();
+        peer.shutdown().await.unwrap();
+        let stream: BoundaryDuplexStream = Box::new(stream);
+        let client = tokio::io::BufReader::new(stream);
+        let (reader, writer) = tokio::io::split(client);
+        let reader = std::io::Cursor::new(prefix.to_vec()).chain(reader);
+        let stream: BoundaryDuplexStream = Box::new(tokio::io::join(reader, writer));
+        let mut client = tokio::io::BufReader::new(stream);
+        let protocol = tokio::time::timeout(
+            std::time::Duration::from_millis(250),
+            peek_tunnel_protocol(&mut client),
+        )
+        .await
+        .unwrap()
+        .unwrap();
+        let mut actual = Vec::new();
+        client.read_to_end(&mut actual).await.unwrap();
+        assert_eq!(actual, [prefix, remainder].concat());
+        assert_eq!(protocol, Some(expected));
+        client.write_all(b"ack").await.unwrap();
+        let mut acknowledgment = [0; 3];
+        peer.read_exact(&mut acknowledgment).await.unwrap();
+        assert_eq!(&acknowledgment, b"ack");
+    }
+
