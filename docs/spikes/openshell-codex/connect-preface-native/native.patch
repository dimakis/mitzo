+        let upstream = TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let address = upstream.local_addr().unwrap();
+        let (prefix_tx, prefix_rx) = tokio::sync::oneshot::channel();
+        let received = tokio::spawn(async move {
+            let (mut stream, _) = upstream.accept().await.unwrap();
+            let mut bytes = Vec::new();
+            if let Some(length) = deferred_prefix {
+                bytes.resize(length, 0);
+                stream.read_exact(&mut bytes).await.unwrap();
+            }
+            let _ = prefix_tx.send(());
+            stream.read_to_end(&mut bytes).await.unwrap();
+            stream.write_all(&bytes).await.unwrap();
+            stream.shutdown().await.unwrap();
+            bytes
+        });
+        let data = format!(
+            "network_policies:\n  echo:\n    name: echo\n    endpoints:\n      - host: host.openshell.internal\n        port: {}\n        tls: skip\n    binaries: []\n",
+            address.port()
+        );
+        let engine = Arc::new(
