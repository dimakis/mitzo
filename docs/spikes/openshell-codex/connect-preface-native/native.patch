+        } else {
+            virtual_connect_stream(Box::new(workload), authority.clone())
+        };
+        let mut handler = tokio::io::BufReader::new(stream);
+        if !fragmented {
+            let initial_payload = &payload[..deferred_prefix.unwrap_or(payload.len())];
+            peer.write_all(initial_payload).await.unwrap();
+            if deferred_prefix.is_none() {
+                peer.shutdown().await.unwrap();
+            }
+            tokio::task::yield_now().await;
+            let initial = handler.fill_buf().await.unwrap();
+            let end = initial.windows(4).position(|w| w == b"\r\n\r\n").unwrap() + 4;
+            assert_eq!(
+                &initial[end..],
+                initial_payload,
+                "fixture must coalesce the payload"
+            );
+        }
+
+        let (denial_tx, mut denial_rx) = mpsc::unbounded_channel();
+        let task = tokio::spawn(handle_mediated_connection(
