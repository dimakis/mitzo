+            tokio::task::yield_now().await;
+            let mut tail = header.as_bytes()[split..].to_vec();
+            tail.extend_from_slice(payload);
+            peer.write_all(&tail).await.unwrap();
+            peer.shutdown().await.unwrap();
+        }
+        if let Some(length) = deferred_prefix {
+            tokio::time::timeout(std::time::Duration::from_secs(2), prefix_rx)
