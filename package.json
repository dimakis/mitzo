{
  "name": "claude-command-center",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:server": "tsx watch server/index.ts",
    "build": "cd frontend && npm run build",
    "build:mcp": "cd mcp-server && npm run build",
    "setup-mcp": "bash scripts/setup-mcp.sh",
    "start": "node --import tsx server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.87",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.4",
    "express": "^4.21.0",
    "jose": "^5.9.0",
    "nanoid": "^5.0.9",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.2"
  }
}
