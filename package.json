{
  "name": "mitzo",
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "frontend"
  ],
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:server": "tsx watch server/index.ts",
    "build": "cd frontend && npm run build",
    "build:mcp": "cd mcp-server && npm run build",
    "setup-mcp": "bash scripts/setup-mcp.sh",
    "start": "node --import tsx server/index.ts",
    "pm2:start": "npx pm2 start ecosystem.config.cjs",
    "pm2:reload": "npx pm2 reload ecosystem.config.cjs",
    "pm2:stop": "npx pm2 stop ecosystem.config.cjs",
    "lint": "eslint server/ frontend/src/",
    "lint:fix": "eslint server/ frontend/src/ --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.87",
    "@anthropic-ai/sdk": "^0.85.0",
    "@anthropic-ai/vertex-sdk": "^0.15.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.8.0",
    "contexgin": "github:dimakis/contexgin#52fe1c7",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.4",
    "express": "^4.21.0",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "http-proxy-middleware": "^3.0.5",
    "jose": "^5.9.0",
    "nanoid": "^5.0.9",
    "ws": "^8.18.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^9.39.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.5.13",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.1.2"
  }
}
