{
  "name": "mitzo",
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "frontend"
  ],
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:server": "tsx watch server/index.ts",
    "build": "cd frontend && npm run build",
    "build:server": "tsc -b packages/protocol packages/harness packages/client && tsc -p tsconfig.build.json && cp server/ipv4-preload.cjs dist/",
    "build:all": "npm run build:server && npm run build",
    "build:mcp": "cd mcp-server && npm run build",
    "setup-mcp": "bash scripts/setup-mcp.sh",
    "start": "node dist/index.js",
    "start:dev": "node --import tsx server/index.ts",
    "deploy": "bash scripts/deploy.sh",
    "build:ios": "cd frontend && npm run build:ios",
    "open:ios": "cd frontend && npx cap open ios",
    "deploy:ios": "bash scripts/deploy-testflight.sh",
    "bump:ios": "bash scripts/bump-ios-version.sh",
    "lint": "eslint server/ frontend/src/",
    "lint:fix": "eslint server/ frontend/src/ --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "tracing:up": "docker compose up -d jaeger",
    "tracing:down": "docker compose down jaeger",
    "observability:up": "docker compose up -d",
    "observability:down": "docker compose down",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.87",
    "@anthropic-ai/sdk": "^0.85.0",
    "@anthropic-ai/vertex-sdk": "^0.15.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.214.0",
    "@opentelemetry/resources": "^2.6.1",
    "@opentelemetry/sdk-trace-node": "^2.6.1",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@parse/node-apn": "^8.1.0",
    "better-sqlite3": "^12.8.0",
    "contexgin": "github:dimakis/contexgin#52fe1c7",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.4",
    "express": "^4.21.0",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "http-proxy-middleware": "^3.0.5",
    "jose": "^5.9.0",
    "js-yaml": "^4.1.1",
    "nanoid": "^5.0.9",
    "pino": "^10.3.1",
    "pino-loki": "^3.0.0",
    "pino-roll": "^4.0.0",
    "ws": "^8.18.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^9.39.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^5.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.5.13",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "lint-staged": "^16.4.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.1.2"
  }
}
