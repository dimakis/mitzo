# Merge these non-secret values into Mitzo's production .env. Keep the real
# account profile and seed paths outside the repository.
MITZO_OPENSHELL_ENABLED=1
MITZO_OPENSHELL_CLI=/opt/homebrew/bin/openshell
MITZO_OPENSHELL_STACK_MANIFEST=/absolute/path/to/mitzo/infra/openshell/production-stack.lock.json
MITZO_OPENSHELL_IMAGE=localhost/mitzo-mgmt-runtime:release-387c13ed-20260911
MITZO_OPENSHELL_POLICY=/absolute/path/to/mitzo/docs/spikes/openshell-codex/openshell-openai-api-policy.yaml
MITZO_OPENSHELL_SEED=/absolute/path/to/prepared-seed/mgmt
MITZO_OPENSHELL_SERVICE_PROVIDERS=google-workspace,github
MITZO_OPENSHELL_WEB_SEARCH=disabled
MITZO_OPENSHELL_CREATE_DETACHED=1
MITZO_OPENSHELL_SANDBOX_ID_LENGTH=13
OPENSHELL_GATEWAY=openshell
OPENSHELL_WORKSPACE=default

# Required to expose explicitly configured ChatGPT subscription profiles in
# production. The account file must use a complete brokered OpenShell binding.
MITZO_CODEX_ENABLED=1
MITZO_ACCOUNT_PROFILES_FILE=/absolute/path/to/accounts.openshell.json
